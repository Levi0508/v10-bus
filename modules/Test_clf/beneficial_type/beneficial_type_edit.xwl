{
  "title": "KYC01070/edit",
  "icon": "",
  "img": "",
  "tags": "",
  "hideInMenu": "true",
  "text": "module",
  "cls": "Wb.Module",
  "properties": {
    "cid": "module",
    "serverScript": "Wb.sendRows(`update thjs.t_dict_subentry a   \n           set a.comments = {?BENEFICIAL_TYPE_NAME?}, \n               a.remark = {?REMARK?},\n               a.update_user = {?sys.userid?}, \n               a.update_time = sysdate \n         where a.entry_no = 'BENEFICIAL_TYPE'\n           and a.subentry = {?BENEFICIAL_TYPE_CODE?}`);\n"
  },
  "_icon": "module"
}