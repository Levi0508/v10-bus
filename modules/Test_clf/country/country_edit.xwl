  "cls": "Wb.Module",
  "properties": {
    "cid": "module",
    "serverScript": "Wb.sendRows(`update thjs.t_dict_subentry a  \n           set a.comments = {?COUNTRY_NAME?},\n               a.remark = {?REMARK?},\n               a.update_user = {?sys.userid?},\n        a.update_time = sysdate\n        where a.entry_no = '1040'\n           and a.subentry = {?COUNTRY_CODE?}`);\n"
  },
