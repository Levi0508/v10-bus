{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"function main() {\n  switch (event) {\n    case 'open':\n      com.wb.tool.Console.startCapture();\n      break;\n    case 'close':\n      com.wb.tool.Console.stopCapture();\n      break;\n  }\n}\nmain();","remark":"System console socket monitor"},"_icon":"module"}