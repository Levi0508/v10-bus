{"title":"@dbc","icon":"data-provider","img":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","remark":"Database source configuration"},"_icon":"module","_expanded":true,"events":{"initialize":"Wb.define(app,{get$currentName(){return app.listTree.selection.text},onChange(){if(!app.stopChange)app.saveBtn.disabled=false},promptSetDb(e,t,a,i,r){Wb.ajax({url:xpath+\"/set-default&type=get-db\",params:{name:e},success(e){const n=[\"db2\",\"derby\",\"dameng\",\"firebird\",\"h2\",\"hsqldb\",\"informix\",\"kingbase\",\"mariadb\",\"mysql\",\"oracle\",\"pointbase\",\"postgresql\",\"sap\",\"sqlite\",\"sql server\",\"sybase\",\"teradata\"];let c,d;e=e.toLowerCase();c=n.find((t=>e.includes(t)));if(!c){if(e.includes(\"sqlserver\"))c=\"sql server\";else if(e.includes(\"da meng\")||e.includes(\"dm\"))c=\"dameng\"}d=[{text:Str.dbType,cname:\"select\",cid:\"dbType\",required:true,forceSelect:true,data:n,value:c}];if(r)d.push({label:Str.overwriteTables,cname:\"check\",cid:\"overwrite\",showEmptyLabel:true});Wb.prompt({title:t,icon:a},d,i)}})},save(e){if(Wb.verify(app.detailPanel)){Wb.ajax({url:xpath+\"/config&type=save\",params:{oldName:app.editNode.text,name:app.text.value,data:Wb.getValue(app.detailPanel,true)},success(){app.saveBtn.disabled=true;app.editNode.text=app.text.value;e?.call()}})}},loadProperties(e){let t=app.currentName;Wb.ajax({url:xpath+\"/config&type=property\",params:{name:t},json:true,success(t){let a=app.propWin;Wb.setValue(a,t.pool);app.connGrid.data=t.items;e?.()}})}});Wb.make(app,{cname:\"socket\",name:\"sys.dbc\",cid:\"socket1\",events:{message(e,t){if(app.acceptProgress)Wb.progress(Wb.decode(e.data))}}});Wb.make(app,{cname:\"window\",layout:\"form1\",padding:\"1em\",icon:\"property\",width:\"85em\",title:Str.property,modal:true,cid:\"propWin\",height:\"46em\",tbar:{cname:\"toolbar\",items:[{icon:\"security\",text:\"Close\",cid:\"closeItem\",events:{click(e,t){let a=app.currentName,i=app.connGrid.selection,r=i?.data;if(!i){Wb.tipSelect();return}if(r.isClosed){Wb.tipWarn(\"The connection is already closed.\");return}Wb.confirm(`Are you sure to close the connection \"${r.id.intText}\"?`,(e=>{Wb.ajax({url:xpath+\"/config&type=close\",params:{name:a,id:r.id},success(e){app.loadProperties();i.proxy.isClosed=true}})}))}}},{icon:\"brush1\",text:\"Clear\",cid:\"clearItem\",events:{click(e,t){let a=app.currentName;Wb.confirm(\"Are you sure to clear all idle connections?\",(e=>{Wb.ajax({url:xpath+\"/config&type=clear\",params:{name:a},success(e){app.loadProperties()}})}))}}},{cname:\"divider\",cid:\"divider1\"},{icon:\"refresh\",text:\"Refresh\",cid:\"refreshItem\",events:{click(e,t){app.loadProperties()}}}]},items:[{cname:\"container\",layout:\"row\",defaults:{width:\"11em\"},flexWrap:true,gap:true,cid:\"container1\",items:[{cname:\"text\",readonly:true,width:\"8em\",text:\"Max\",cid:\"maxTotal\"},{cname:\"text\",readonly:true,width:\"9em\",text:\"Active\",cid:\"numActive\"},{cname:\"text\",readonly:true,width:\"8em\",text:\"Idle\",cid:\"numIdle\"},{cname:\"text\",readonly:true,width:\"13em\",text:\"Created\",cid:\"createdCount\"},{cname:\"text\",readonly:true,width:\"14em\",text:\"Destroyed\",cid:\"destroyedCount\"},{cname:\"text\",readonly:true,width:\"18em\",text:\"Borrowed\",cid:\"borrowedCount\"},{cname:\"text\",readonly:true,width:\"9em\",text:\"Waiters\",cid:\"numWaiters\"}]},{cname:\"grid\",defaultFields:{createTime:{type:\"date\"},lastBorrowTime:{type:\"date\"},lastReturnTime:{type:\"date\"},lastUsedTime:{type:\"date\"}},flex:1,pagingBar:false,reserveScrollbar:true,cid:\"connGrid\",columns:[{cname:\"column\",rowNum:true,cid:\"rowCol\"},{cname:\"column\",fieldName:\"id\",width:\"11em\",text:\"ID\",render(e,t,a,i){if(!t.isClosed){i.parentNode.setStyle(\"color\",\"#d75a4a\")}return e},cid:\"idCol\"},{cname:\"column\",fieldName:\"borrowedCount\",width:\"13em\",text:\"Borrowed\",cid:\"borrowedCountCol\"},{cname:\"column\",fieldName:\"createTime\",width:\"13em\",text:\"Create Time\",cid:\"createTimeCol\"},{cname:\"column\",fieldName:\"lastBorrowTime\",width:\"13em\",text:\"Last Borrow Time\",cid:\"lastBorrowTimeCol\"},{cname:\"column\",fieldName:\"lastReturnTime\",width:\"13em\",text:\"Last Return Time\",cid:\"lastReturnTimeCol\"},{cname:\"column\",fieldName:\"lastUsedTime\",width:\"13em\",text:\"Last Used Time\",cid:\"lastUsedTimeCol\"}]}]});Wb.make(app,{cname:\"viewport\",layout:\"row\",cid:\"viewport1\",tbar:{cname:\"toolbar\",items:[{keys:\"Ctrl+E\",icon:\"add\",text:Str.add,cid:\"addBtn\",events:{click(e,t){Wb.prompt({title:Str.add,icon:\"add\"},{cid:\"name\",text:Str.name,required:true},((e,t)=>{Wb.ajax({url:xpath+\"/config&type=add\",params:e,success(){let a=app.listTree.addData({text:e.name,_icon:\"database\",_leaf:true});a.select();t.close()}})}))}}},{icon:\"copy\",text:Str.copy,cid:\"copyBtn\",events:{click(e,t){let a=app.listTree.selection,i=a.text;Wb.prompt({title:Str.copy+\" - \"+i,icon:\"copy\"},{cid:\"newName\",text:Str.name,required:true,value:i+\"1\",selectOnInit:true},((e,t)=>{e.name=i;Wb.ajax({url:xpath+\"/config&type=copy\",params:e,success(){a=app.listTree.insertDataAfter({text:e.newName,_icon:\"database\",_leaf:true},a);a.select();t.close()}})}))}}},{keys:\"Ctrl+D\",icon:\"delete\",text:Str.del,cid:\"deleteBtn\",events:{click(e,t){let a=app.currentName;Wb.confirm(Str.deleteConfirm.format(a),(e=>{Wb.ajax({url:xpath+\"/config&type=delete\",params:{name:a},success(){app.saveBtn.disabled=true;app.listTree.delRecords()}})}))}}},{keys:\"Ctrl+S\",icon:\"save\",disabled:true,text:Str.save,cid:\"saveBtn\",events:{click(e,t){app.save()}}},{cname:\"divider\",cid:\"divider1\"},{icon:\"bolt\",text:Str.test,cid:\"testBtn\",events:{click(e,t){let a=app.currentName,testFn=e=>Wb.ajax({url:xpath+\"/config&type=test\",params:{name:a},success(){Wb.tipDone()}});if(app.saveBtn.disabled)testFn();else Wb.confirm(Str.modifiedConfirm.format(a),(e=>{app.save(testFn)}))}}},{icon:\"favorite\",tip:Str.setDefaultDb,disabled:true,text:Str.default,cid:\"defaultBtn\",events:{click(e,t){let a=app.listTree,i=a.selection,r=i.text;app.promptSetDb(r,Str.setDefaultDb+\" - \"+r,\"favorite\",((e,t)=>{let i=e.overwrite,doSetDefault=n=>{app.acceptProgress=true;Wb.ajax({url:xpath+\"/set-default&type=set-default\",params:{overwrite:i,name:r,dbType:e.dbType},mask:{width:\"50vw\",delay:0},callback(){Wb.unmask()},success(){a.cascade((e=>{e.icon=e.text==r?\"favorite\":\"database\"}));app.defaultBtn.disabled=true;app.acceptProgress=false;t.close()}})};if(i)Wb.confirm(Str.doConfirm.format(Str.overwriteTables),doSetDefault);else doSetDefault()}),true)}}},{icon:\"table\",tip:Str.createSysTables,text:Str.createTables,cid:\"createTablesBtn\",events:{click(e,t){app.promptSetDb(null,Str.createSysTables,\"table\",((e,t)=>{Wb.ajax({url:xpath+\"/set-default&type=create\",params:e,success(){t.close()}})}))}}},{cname:\"divider\",cid:\"divider2\"},{icon:\"property\",text:Str.property,cid:\"propertyBtn\",events:{click(e,t){app.loadProperties((e=>{let t=app.propWin;t.subTitle=app.currentName;t.show()}))}}},{icon:\"refresh\",text:Str.refresh,cid:\"refreshBtn\",events:{click(e,t){let a=app.listTree;if(app.saveBtn.disabled)a.loadSelect();else Wb.choose(Str.saveChanges.format(Str.dbc),(e=>{if(e==\"yes\"){app.save((e=>a.loadSelect()))}else if(e==\"no\"){app.saveBtn.disabled=true;a.loadSelect()}}))}}}]},items:[{cname:\"tree\",autoSelect:true,width:\"15em\",url:xpath+\"/config&type=list\",cid:\"listTree\",events:{select(e,t){app.defaultBtn.disabled=e.icon!=\"database\"},beforeselect(e,t){let a=app.detailPanel;if(app.saveBtn.disabled){Wb.ajax({url:xpath+\"/config&type=get\",params:{name:e.text},comps:a,json:true,success(t){app.stopChange=true;app.editNode=e;Wb.setValue(a,t,true);app.stopChange=false}})}else{Wb.choose(Str.saveChanges.format(Str.dbc),(t=>{if(t==\"yes\"){app.save((t=>e.select()))}else if(t==\"no\"){app.saveBtn.disabled=true;e.select()}}));return false}}}},{cname:\"splitter\",cid:\"splitter1\"},{cname:\"panel\",layout:\"grid1\",wideLabel:true,flex:1,tableStyle:true,autoGrid:\"up\",cid:\"detailPanel\",events:{ready(e,t){Wb.setEvents(this,\"change\",app.onChange)}},items:[{cname:\"title\",title:Str.general,cid:\"title1\"},{cname:\"text\",text:Str.name,required:true,cid:\"text\"},{cname:\"text\",text:Str.desc,cid:\"desc\"},{cname:\"select\",data:[\"com.microsoft.sqlserver.jdbc.SQLServerDriver\",\"oracle.jdbc.driver.OracleDriver\",\"com.mysql.cj.jdbc.Driver\",\"org.postgresql.Driver\",\"org.apache.derby.jdbc.EmbeddedDriver\",\"com.ibm.db2.jdbc.app.DB2Driver\",\"com.ibm.db2.jdbc.net.DB2Driver\",\"com.sybase.jdbc.SybDriver\",\"com.teradata.jdbc.TeraDriver\",\"org.h2.Driver\",\"org.sqlite.JDBC\",\"dm.jdbc.driver.DmDriver\",\"com.kingbase.Driver\",\"org.mariadb.jdbc.Driver\",\"org.apache.hive.jdbc.HiveDriver\",\"com.sap.db.jdbc.Driver\"],text:\"driverClassName\",required:true,cid:\"driverClassName\",events:{select(e,t,a,i){let r=app.url,n=r.value;if(!n||n==\"url\")r.valueIndex=t.itemIndex}}},{cname:\"select\",data:[\"jdbc:sqlserver://127.0.0.1:1433;DatabaseName=mydb;encrypt=false;\",\"jdbc:oracle:thin:@127.0.0.1:1521:mydb\",\"jdbc:mysql://127.0.0.1:3306/mydb?autoReconnect=true&allowMultiQueries=true&useUnicode=true&characterEncoding=utf-8&mysqlEncoding=utf8&nullCatalogMeansCurrent=true\",\"jdbc:postgresql://127.0.0.1:5432/mydb\",\"jdbc:derby:$$wb/system/mydb;create=true\",\"jdbc:db2:mydb\",\"jdbc:db2://127.0.0.1:6789/mydb\",\"jdbc:sybase:Tds:127.0.0.1:4100/mydb\",\"jdbc:teradata://127.0.0.1/database=mydb, tmode=ANSI, charset=UTF8\",\"jdbc:h2:$$wb/system/mydb\",\"jdbc:sqlite:$$wb/system/mydb\",\"jdbc:dm://127.0.0.1:12345/mydb\",\"jdbc:kingbase://127.0.0.1:54321/mydb\",\"jdbc:mariadb://127.0.0.1:3306/test\",\"jdbc:hive2://127.0.0.1:10000/hadoop\",\"jdbc:sap://127.0.0.1:30015?reconnect=true\"],text:\"url\",required:true,cid:\"url\"},{cname:\"text\",text:\"username\",cid:\"username\"},{cname:\"text\",password:true,eyeButton:true,text:\"password\",cid:\"password\"},{cname:\"text\",text:\"connectionProperties\",cid:\"connect