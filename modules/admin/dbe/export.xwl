{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","remark":"Export data to the client","serverScript":"Wb.checkDemo();\nfunction main() {\n  let sql, tableName = Params.tableName,\n    writer = new java.io.BufferedWriter(new java.io.OutputStreamWriter(new Classes.GZIPOutputStream(response.getOutputStream()), 'utf-8'));\n\n  Wb.setContentType(tableName + '.wbt', true);\n  sql = Params.data;\n  if (sql)\n    sql = Wb.decodeBase64(sql);\n  else\n    sql = 'select * from ' + tableName;\n  Wb.sql({\n    sql, db: Params.db, blob: 'text', fn(row) {\n      writer.write(Wb.encode(row));\n      writer.write('\\n');\n    }\n  });\n  writer.close();\n}\nmain();"},"_icon":"module"}