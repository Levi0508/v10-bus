{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","remark":"Table select, save and download","serverScript":"function main() {\n  if (Params.download || Params.save)\n    Wb.sync(Params);\n  else {\n    const Util = Wb.load('./util.mjs');\n    let sql = 'select * from ' + Params.tableName;\n    if (Params.where)\n      sql += ' where ' + Wb.decodeBase64(Params.where);\n    sql += Wb.getOrderSql();\n    Wb.sendRowx({ sql, db: Params.db, dateFormat: true, rs: Util.maxRows });\n  }\n}\nmain();"},"_icon":"module"}