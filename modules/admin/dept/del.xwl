{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","remark":"Delete departments","serverScript":"function main() {\n  let items, del = [];\n\n  items = Wb.Builder.getTreeItems(Wb.getAllRows('select sid,parent_id from wb_dept'), Wb.getObject('del').pluck('$sid'));\n  items.forEach(item => del.push({ $sid: item }));\n  Wb.sync({ tableName: 'wb_dept', del });\n}\nmain();"},"_icon":"module"}