{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","remark":"Move departments","serverScript":"function main() {\n  let update = [], parent_id = Params.parentId || '0';\n\n  Wb.getObject('source').forEach(item => {\n    update.push({ $sid: item, parent_id });\n  });\n  Wb.sync({ tableName: 'wb_dept', update });\n}\nmain();"},"_icon":"module"}