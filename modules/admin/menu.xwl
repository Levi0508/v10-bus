{"title":"菜单配置","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","_expanded":true,"properties":{"cid":"module"},"_icon":"module","events":{"initialize":"Wb.apply(app, {\n  /**\n   * Load grid data based on the values in the search panel.\n   */\n  load() {\n    let searchPanel = app.searchPanel;\n    if (!Wb.verify(searchPanel))\n      return;\n    app.resultGrid.load({ comps: searchPanel });\n  }\n});","finalize":"app.load();"},"hasDupCid":0,"items":[{"_icon":"window","text":"editWin","cls":"Wb.Window","_expanded":true,"properties":{"cid":"editWin","layout":"grid3","width":"100em","resetDialog":"true","autoGrid":"true","dialog":"true"},"events":{"beforeshow":"// 生成 UUID v4 版本的函数\nfunction generateUUID() {\n  // UUID v4 的规则：xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx\n  // 其中 4 是版本号固定，y 只能是 8/9/a/b 中的一个\n  return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {\n    const r = Math.random() * 16 | 0; // 生成 0-15 的随机数\n    const v = c === 'x' ? r : (r & 0x3 | 0x8); // 处理 y 位的规则\n    return v.toString(16); // 转 16 进制字符串\n  });\n}\n\nconst uuid = generateUUID();\nconsole.log('生成的 UUID：', uuid);\napp.menu_id.setValue(uuid);"},"items":[{"cls":"Wb.Text","properties":{"cid":"menu_id","required":"true","maxLength":"50","text":"menu_id","visible":"true","readonly":"true"},"text":"menu_id","_expanded":true,"_icon":"text","hasDupCid":0},{"cls":"Wb.Text","properties":{"cid":"system_flag","required":"true","maxLength":"10","text":"系统标识"},"text":"system_flag","_expanded":true,"_icon":"text","hasDupCid":0},{"cls":"Wb.Text","properties":{"cid":"module_id","required":"true","maxLength":"50","text":"模块ID"},"text":"module_id","_expanded":true,"_icon":"text","hasDupCid":0},{"cls":"Wb.Text","properties":{"cid":"module_name","required":"true","maxLength":"50","text":"模块名称"},"text":"module_name","_expanded":true,"_icon":"text","hasDupCid":0},{"cls":"Wb.Number","properties":{"cid":"module_order","required":"true","maxLength":"10","decimalCount":"0","text":"模块序号"},"text":"module_order","_expanded":true,"_icon":"number-edit","hasDupCid":0},{"cls":"Wb.Text","properties":{"cid":"menu_name","required":"true","maxLength":"50","text":"菜单名称"},"text":"menu_name","_expanded":true,"_icon":"text","hasDupCid":0},{"cls":"Wb.Text","properties":{"cid":"menu_name_py","required":"true","maxLength":"50","text":"菜单名拼音"},"text":"menu_name_py","_expanded":true,"_icon":"text","hasDupCid":0},{"cls":"Wb.Text","properties":{"cid":"menu_name_jp","required":"true","maxLength":"20","text":"菜单名简拼"},"text":"menu_name_jp","_expanded":true,"_icon":"text","hasDupCid":0},{"cls":"Wb.Text","properties":{"cid":"menu_type","maxLength":"10","text":"菜单类型"},"text":"menu_type","_expanded":true,"_icon":"text","hasDupCid":0},{"cls":"Wb.Text","properties":{"cid":"menu_link","required":"true","maxLength":"500","text":"菜单链接"},"text":"menu_link","_expanded":true,"_icon":"text","hasDupCid":0},{"cls":"Wb.Number","properties":{"cid":"menu_order","required":"true","maxLength":"10","decimalCount":"0","text":"菜单序号"},"text":"menu_order","_expanded":true,"_icon":"number-edit","hasDupCid":0},{"cls":"Wb.Text","properties":{"cid":"parent_id","maxLength":"50","text":"父级ID"},"text":"parent_id","_expanded":true,"_icon":"text","hasDupCid":0},{"cls":"Wb.Text","properties":{"cid":"create_user","maxLength":"50","text":"create_user","visible":"false"},"text":"create_user","_expanded":true,"_icon":"text","hasDupCid":0},{"cls":"Wb.Text","properties":{"cid":"create_time","maxLength":"50","text":"create_time","visible":"false"},"text":"create_time","_expanded":true,"_icon":"text","hasDupCid":0},{"cls":"Wb.Text","properties":{"cid":"update_user","maxLength":"50","text":"update_user","visible":"false"},"text":"update_user","_expanded":true,"_icon":"text","hasDupCid":0},{"cls":"Wb.Text","properties":{"cid":"update_time","maxLength":"50","text":"update_time","visible":"false"},"text":"update_time","_expanded":true,"_icon":"text","hasDupCid":0},{"cls":"Wb.Text","properties":{"cid":"status","required":"true","maxLength":"10","text":"状态"},"text":"status","_expanded":true,"_icon":"text","hasDupCid":0},{"cls":"Wb.Text","properties":{"cid":"module_flag","maxLength":"2","text":"模块标识","required":"true"},"text":"module_flag","_expanded":true,"_icon":"text","hasDupCid":0},{"cls":"Wb.Text","properties":{"cid":"search_flag","maxLength":"10","text":"搜索标识","required":"true"},"text":"search_flag","_expanded":true,"_icon":"text","hasDupCid":0},{"cls":"Wb.TextArea","properties":{"cid":"menu_path","maxLength":"2000","text":"菜单路径","required":"true"},"text":"menu_path","_expanded":true,"_icon":"textarea"},{"cls":"Wb.TextArea","properties":{"cid":"remark","maxLength":"2000","text":"备注"},"text":"remark","_expanded":true,"_icon":"textarea"}]},{"_icon":"viewport","text":"viewport1","cls":"Wb.Viewport","properties":{"cid":"viewport1","layout":"column"},"_expanded":true,"items":[{"cls":"Wb.Toolbar","properties":{"cid":"tbar","isProperty":"true"},"text":"tbar","_expanded":true,"_icon":"toolbar","hasDupCid":0,"items":[{"_icon":"item","text":"addBtn","cls":"Wb.Item","_expanded":false,"properties":{"cid":"addBtn","text":"@Str.add","icon":"add","keys":"Ctrl+E","bindModule":"./wb_menu/edit.xwl"},"events":{"click":"let win = app.editWin;\nwin.icon = 'add';\nwin.title = Str.add;\nwin.focusControl = null;\nwin.okHandler = (win, values) => {\n  Wb.ajax({\n    url: xpath + '/edit&xaction=add',\n    params: values,\n    json: true,\n    success(resp) {\n      app.resultGrid.appendRecord(Wb.apply(values, resp));\n      win.hide();\n    }\n  });\n};\nwin.show();\nwin.scrollEl.scrollTop = win.scrollEl.scrollLeft = 0;"}},{"_icon":"item","text":"editBtn","cls":"Wb.Item","_expanded":true,"properties":{"cid":"editBtn","text":"@Str.edit","icon":"edit","keys":"Ctrl+J","bindModule":"./wb_menu/edit.xwl"},"events":{"click":"let win = app.editWin, rec = app.resultGrid.selection, data;\n\nif (!rec) {\n  Wb.tipSelect();\n  return;\n}\ndata = rec.data;\nwin.icon = 'edit';\nwin.title = Str.edit;\nwin.focusControl = true;\nWb.setValue(win, data);\nwin.okHandler = (win, values) => {\n  Wb.ajax({\n    url: xpath + '/edit&xaction=edit',\n    params: rec.getDiffer(values),\n    json: true,\n    success(resp) {\n      rec.update(Wb.apply(values, resp));\n      win.hide();\n    }\n  });\n};\nwin.show();"}},{"_icon":"item","text":"delBtn","cls":"Wb.Item","_expanded":true,"properties":{"cid":"delBtn","text":"@Str.del","icon":"delete","keys":"Ctrl+D","bindModule":"./wb_menu/edit.xwl"},"events":{"click":"let grid = app.resultGrid, recs = grid.selections;\nif (!recs.length) {\n  Wb.tipSelect();\n  return;\n}\nWb.confirm(Wb.getActionHint(recs), f => {\n  Wb.ajax({\n    url: xpath + '/edit&xaction=del',\n    params: { del: grid.originData },\n    success() {\n      grid.delRecords();\n    }\n  });\n});"}},{"_icon":"divider","text":"divider1","cls":"Wb.Divider","properties":{"cid":"divider1"}},{"_icon":"combo","text":"moduleSearch","cls":"Wb.Select","properties":{"cid":"moduleSearch","clearButton":"true","flex":"1","maxWidth":"20em","minWidth":"5em","text":"模块名称","placeholder":"请选择","textField":"module_name","valueField":"module_name","url":"m?xwl=admin/menu/selectOption&xaction=getModuleName"},"events":{"select":"app.resultGrid.delayLoad({\n  params: {\n    moduleSearch: app.moduleSearch.value,\n    menuName: app.menuName.value,\n    creator: app.creator.value\n  }\n});","clearclick":"app.resultGrid.delayLoad({\n  params: {\n    menuName: app.menuName.value,\n    creator: app.creator.value\n  }\n});"}},{"_icon":"divider","text":"divider2","cls":"Wb.Divider","properties":{"cid":"divider2"}},{"_icon":"combo","text":"menuName","cls":"Wb.Select","properties":{"cid":"menuName","placeholder":"请选择","clearButton":"true","maxWidth":"20em","minWidth":"5em","flex":"1","text":"菜单名称","url":"m?xwl=admin/menu/selectOption&xaction=getMenuName","textField":"menu_name","valueField":"menu_name"},"events":{"select":"app.resultGrid.delayLoad({\n  params: {\n    moduleSearch: app.moduleSea