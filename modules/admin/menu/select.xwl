{"title":"查询","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","_expanded":true,"properties":{"cid":"module","serverScript":"function main() {\n  let sql;\n\n  sql = `select * from wb_menu m where 1=1`;\n  if (Params.moduleSearch) {\n    sql += ' and m.module_name like {?moduleSearch?} ';\n  }\n  if (Params.menuName) {\n    sql += ' and m.menu_name like {?menuName?}';\n  }\n  if (Params.creator) {\n    sql += ' and m.create_user like {?creator?}';\n  }\n  Wb.sendRows(sql);\n}\nmain();"},"_icon":"module"}