{"title":"查询下拉数据","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"let actions = {\n  getModuleName() {\n    let sql = `\n      select distinct module_name from wb_menu;\n    `\n    Wb.sendRows(sql);\n  },\n  getMenuName() {\n    let sql = `\n      select distinct menu_name from wb_menu;\n    `\n    Wb.sendRows(sql);\n  }\n};\nactions[Params.xaction]();"},"_icon":"module"}