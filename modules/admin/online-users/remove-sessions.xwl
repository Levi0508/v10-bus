{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","remark":"Remove sessions","serverScript":"Wb.checkDemo();\nfunction main() {\n  let del = Wb.getObject('del');\n  del.forEach(item => Sessions.invalidate(item.$userid));\n}\nmain();"},"_icon":"module"}