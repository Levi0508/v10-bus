.set","icon":"role","visible":"true"},"events":{"beforecheckchange":"if (this.subTitle) {\n  app.setPerm(app.moduleTree.selection, node.data.sid, checked, f => {\n    this.suspendEvent();\n    node.checked = checked;\n    this.resumeEvent();\n  });\n  return false;\n} else {\n  Wb.tip('请选择功能')\n  return false;\n}\n","success":"if (app.moduleTree.selection) app.refreshRoles(this);"},"items":[{"cls":"Wb.Toolbar","properties":{"cid":"tbar","isProperty":"true"},"text":"tbar","_expanded":true,"_icon":"toolbar","hasDupCid":0,"items":[{"_icon":"text","text":"search3","cls":"Wb.Text","properties":{"cid":"search3","clearButton":"true","placeholder":"@Str.search","minWidth":"5em","maxWidth":"20em"},"events":{"change":"app.roleTree2.delayLoad({ comps: app.search3 });"},"hasDupCid":0,"_expanded":true}]}]},{"_icon":"tree-view","text":"roleTree3","cls":"Wb.Tree","_expanded":false,"properties":{"cid":"roleTree3","width":"20vw","url":"@xpath + '/select-roles-sj&check=1'","showIcon":"false","leafExpander":"true","title":"@Str.set","icon":"role","visible":"false"},"events":{"beforecheckchange":"if (app.deptTree.selection) {\n  app.setPermSj(app.deptTree.selection, node.data.sid, checked, f => {\n    this.suspendEvent();\n    node.checked = checked;\n    this.resumeEvent();\n  });\n  return false;\n} else {\n  Wb.tip('请选择组织架构')\n  return false;\n}\n","success":"if (app.deptTree.selection) app.refreshRolesSj(this);"},"items":[{"cls":"Wb.Toolbar","properties":{"cid":"tbar","isProperty":"true"},"text":"tbar","_expanded":false,"_icon":"toolbar","hasDupCid":0,"items":[{"_icon":"text","text":"search5","cls":"Wb.Text","properties":{"cid":"search5","clearButton":"true","placeholder":"@Str.search","minWidth":"5em","maxWidth":"20em"},"events":{"change":"app.roleTree3.delayLoad({ comps: app.search5 });"},"hasDupCid":0,"_expanded":true}]}]}]}]}