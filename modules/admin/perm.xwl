{"title":"功能权限管理","icon":"lock","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","remark":"System permission management tool"},"_icon":"module","_expanded":true,"events":{"initialize":"// Wb.define(app, {\n//   /** @property {String} - The currently selected role ID. */\n//   get$roleId() {\n//     return app.roleTree1.selectionData?.sid;\n//   },\n//   /**\n//    * Sets permissions for the specified list of module nodes.\n//    * @param {Wb.TreeItem[]/Wb.TreeItem} nodes List of module nodes.\n//    * @param {String} roleId The role id.\n//    * @param {Boolean} checked True allows, false prohibits.\n//    * @param {Function} [success] Fired after success.\n//    */\n//   setPerm(nodes, roleId, checked, success) {\n//     let len;\n\n//     nodes = Wb.toArray(nodes);\n//     len = nodes.length;\n//     if (len > 1 || !nodes[0].leaf) {\n//       let word = len > 1 ? Str.nItems.format(len) : nodes[0].text;\n//       word = ' \"' + word + '\" ';\n//       Wb.confirm(Str.doConfirm.format(checked ? (Str.permit + word) : (Str.forbid + word)),\n//         f => app.doSetPerm(nodes, roleId, checked, success));\n//     } else\n//       app.doSetPerm(nodes, roleId, checked, success);\n//   },\n//   /**\n//    * Executes Set the permissions that specify the list of module nodes. @priv\n//    * @param {Array} nodes List of module nodes.\n//    * @param {String} roleId The role id.\n//    * @param {Boolean} checked True allows, false prohibits.\n//    * @param {Function} [success] Fired after success.\n//    */\n//   doSetPerm(nodes, roleId, checked, success) {\n//     let modules = [], leafNodes = [], oldRoles;\n\n//     nodes.forEach(node => {\n//       if (node.leaf)\n//         leafNodes.push(node);\n//       else\n//         leafNodes.pushAll(node.downAll(sub => sub.leaf));\n//     });\n//     leafNodes.forEach(node => modules.push(node.data.path));\n//     Wb.ajax({\n//       url: xpath + '/set-permissions',\n//       //Data can upload more data than params\n//       data: { modules, roleId, checked },\n//       success() {\n//         leafNodes.forEach(node => {\n//           if (node.leaf) {\n//             oldRoles = node.data.roles ??= [];\n//             if (checked) {\n//               if (!oldRoles.includes(roleId))\n//                 oldRoles.push(roleId);\n//             } else {\n//               oldRoles.remove(roleId);\n//             }\n//           }\n//         });\n//         app.refreshPerms();\n//         app.refreshRoles();\n//         success?.();\n//       }\n//     });\n//   },\n//   /**\n//    * Updates the check box of the module tree.\n//    */\n//   refreshPerms() {\n//     let tree = app.moduleTree;\n\n//     tree.suspendEvent();\n//     app.scanPerms(app.roleId, tree, true);\n//     tree.resumeEvent();\n//   },\n//   /**\n//    * Updates the check boxes for the role tree.\n//    */\n//   refreshRoles() {\n//     let tree = app.roleTree2, moduleNode = app.moduleTree.selection;\n\n//     tree.suspendEvent();\n//     tree.each(node => {\n//       node.checked = app.scanPerms(node.data.sid, moduleNode);\n//     });\n//     tree.resumeEvent();\n//   },\n//   /**\n//    * Updates the check box of the module tree. @priv\n//    * @param {String} roleId The role id.\n//    * @param {Wb.TreeView/Wb.TreeItem} baseNode Specifies that the node and all its child nodes are set.\n//    * @param {Boolean} [doCheck] Whether to perform check module nodes.\n//    * @return {Boolean} Whether the node and all its child nodes are selected. If both checked and unchecked\n//    * nodes exist, return \"half\".\n//    */\n//   scanPerms(roleId, baseNode, doCheck) {\n//     let hasPerm, checked, allChecked = true, allUnchecked = true;\n\n//     if (baseNode.leaf) {\n//       hasPerm = baseNode.data.roles?.includes(roleId);\n//       if (doCheck)\n//         baseNode.checked = hasPerm;\n//       if (hasPerm)\n//         allUnchecked = false;\n//       else\n//         allChecked = false;\n//     } else {\n//       baseNode.each(node => {\n//         checked = app.scanPerms(roleId, node, doCheck);\n//         if (checked == 'half') {\n//           allChecked = false;\n//           allUnchecked = false;\n//         } else if (checked)\n//           allUnchecked = false;\n//         else\n//           allChecked = false;\n//       });\n//     }\n//     if (allChecked)\n//       checked = true;\n//     else if (allUnchecked)\n//       checked = false;\n//     else\n//       checked = 'half';\n//     if (doCheck && baseNode.isNode)\n//       baseNode.checked = checked;\n//     return checked;\n//   },\n//   /**\n//    * Select the first entry after the tree loads.\n//    * @param {Wb.Tree} tree The tree.\n//    */\n//   selectOnLoad(tree) {\n//     if (tree.loaded)\n//       tree.firstItem?.doSelect(true);\n//     else\n//       tree.on('success', f =>\n//         tree.firstItem?.doSelect(true)\n//         , true, { once: true });\n//   }\n// });\n\n\nWb.define(app, {\n  appMode: parentParams?.appMode,\n  get$roleId() {\n    return app.roleTree1.selectionData?.sid;\n  },\n  setPerm(nodes, roleId, checked, success) {\n    let len;\n    nodes = Wb.toArray(nodes);\n    len = nodes.length;\n    if (len > 1 || !nodes[0].leaf) {\n      let word = len > 1 ? Str.nItems.format(len) : nodes[0].text;\n      word = ' \"' + word + '\" ';\n      Wb.confirm(Str.doConfirm.format(checked ? (Str.permit + word) : (Str.forbid + word)),\n        f => app.doSetPerm(nodes, roleId, checked, success));\n    } else\n      app.doSetPerm(nodes, roleId, checked, success);\n  },\n  doSetPerm(nodes, roleId, checked, success) {\n    let modules = [], leafNodes = [], oldRoles;\n    nodes.forEach(node => {\n      if (node.leaf)\n        leafNodes.push(node);\n      else\n        leafNodes.pushAll(node.downAll(sub => sub.leaf));\n    });\n    leafNodes.forEach(node => modules.push(node.data.path));\n    Wb.ajax({\n      url: xpath + '/set-permissions',\n      //Data can upload more data than params\n      data: { modules, roleId, checked },\n      success() {\n        leafNodes.forEach(node => {\n          if (node.leaf) {\n            oldRoles = node.data.roles ??= [];\n            if (checked) {\n              if (!oldRoles.includes(roleId))\n                oldRoles.push(roleId);\n            } else {\n              oldRoles.remove(roleId);\n            }\n          }\n        });\n        app.refreshPerms();\n        app.refreshRoles();\n        success?.();\n      }\n    });\n  },\n  refreshPerms() {\n    let tree = app.moduleTree;\n    tree.suspendEvent();\n    app.scanPerms(app.roleId, tree, true);\n    tree.resumeEvent();\n  },\n  refreshRoles(nodetree) {\n    let tree = nodetree ? nodetree : app.roleTree2, moduleNode = app.moduleTree.selection;\n    tree.suspendEvent();\n    tree.each(node => {\n      if (!node?.fixed) {\n        node.checked = app.scanPerms(node.data.sid, moduleNode);\n        if (!node._leaf) {\n          app.refreshRoles(node);\n        }\n      }\n      else\n        app.refreshRoles(node);\n    });\n    tree.resumeEvent();\n  },\n  scanPerms(roleId, baseNode, doCheck) {\n    let hasPerm, checked, allChecked = true, allUnchecked = true;\n    if (baseNode.leaf) {\n      hasPerm = baseNode.data.roles?.includes(roleId);\n      if (doCheck)\n        baseNode.checked = hasPerm;\n      if (hasPerm)\n        allUnchecked = false;\n      else\n        allChecked = false;\n    } else {\n      baseNode.each(node => {\n        checked = app.scanPerms(roleId, node, doCheck);\n        if (checked == 'half') {\n          allChecked = false;\n          allUnchecked = false;\n        } else if (checked)\n          allUnchecked = false;\n        else\n          allChecked = false;\n      });\n    }\n    if (allChecked)\n      checked = true;\n    else if (allUnchecked)\n      checked = false;\n    else\n      checked = 'half';\n    if (doCheck && baseNode.isNode)\n      baseNode.checked = checked;\n    return checked;\n  },\n\n\n\n\n  setPermSj(nodes, roleId, checked, success) {\n    let len;\n    nodes = Wb.toArray(nodes);\n    len = nodes.length;\n    if (len > 1 || !nodes[0].leaf) {\n      let word = len > 1 ? Str.nItems.format(len) : nodes[0].text;\n      word = ' \"' + word + '\" ';\n      Wb.confirm(Str.doConfirm.format(checked ? (Str.permit + word) : (Str.forbid + word)),\n        f => app.doSetPermSj(nodes, roleId, checked, success));\n    } else\n      app.doSetPermSj(nodes, roleId, checked, success);\n  },\n  // upNodeAll(node, code) {\n  //   let data = [], parentEs = [];\n  //   if (!node) return data;\n  //   node?.each(sub => {\n  //     if (sub.data?.dept_code != code) {\n  //       parentEs.push(sub);\n  //     }\n  //   })\n  //   if (parentEs.every(item => item.checked && item.checked != 'half')) {\n  //     data.push(node, ...app.upNodeAll(node.upBy(sub => !sub.leaf && sub.data?.dept_code != node.data?.dept_code), node.data?.dept_code));\n  //   }\n  //   return data;\n  // },\n  // doSetPermSj(nodes, roleId, checked, success) {\n  //   let modules = [], leafNodes = [], oldRoles, exNodes = [], exFliterNodes, nodesCode = [];\n  //   if (nodes.length > 1) {\n  //     nodes.forEach(node => {\n  //       nodesCode.push(node.data.dept_code);\n  //       exNodes.push(node.upBy(sub => !sub.leaf && sub.data?.dept_code != node.data?.dept_code));\n  //     })\n  //     exFliterNodes = ([...new Map(exNodes.map(item => [item.data?.dept_code, item])).values()]);\n  //     exFliterNodes.forEach(item => {\n  //       let exNodesCode = [];\n  //       item.each(i => exNodesCode.push(i.data.dept_code));\n  //       if (exNodesCode.every(n=> nodesCode.includes(n)) && exNodesCode.length > 1) leafNodes.push(item.data.dept_code);\n  //     })\n  //   }\n  //   nodes.forEach(node => {\n  //     if (node.leaf) {\n  //       if (node.upBy(sub => !sub.leaf).checked && node.upBy(sub => !sub.leaf).checked != 'half') {\n  //         leafNodes.push(node, node.upBy(sub => !sub.leaf), ...app.upNodeAll(node.upBy(sub => !sub.leaf && sub.data?.dept_code != node.upBy(sub => !sub.leaf).data?.dept_code), node.upBy(sub => !sub.leaf).data?.dept_code));\n  //       } else {\n  //         leafNodes.push(node, ...app.upNodeAll(node.upBy(sub => !sub.leaf), node.data?.dept_code));\n  //       }\n  //     }\n  //     else {\n  //       leafNodes.pushAll(node.downAll());\n  //       leafNodes.push(node, ...app.upNodeAll(node.upBy(sub => !sub.leaf && sub.data?.dept_code != node.data?.dept_code), node.data?.dept_code));\n  //     }\n  //   });\n    \n  //   leafNodes.forEach(node => modules.push(node.data?.dept_code));\n  //   Wb.ajax({\n  //     url: xpath + '/set-permissions-sj',\n  //     //Data can upload more data than params\n  //     data: { modules, roleId, checked },\n  //     success() {\n  //       leafNodes.forEach(node => {\n  //         if (node.leaf) {\n  //           oldRoles = node.data.roles ??= [];\n  //           if (checked) {\n  //             if (!oldRoles.includes(roleId))\n  //               oldRoles.push(roleId);\n  //           } else {\n  //             oldRoles.remove(roleId);\n  //           }\n  //         }\n  //       });\n  //       app.refreshPermsSj(roleId, app.deptTree);\n  //       app.refreshRolesSj(app.roleTree3);\n  //       success?.();\n  //     }\n  //   });\n  // },\n  upNodeAllF(node, code) {\n    let data = [], parentData, parentEs = [];\n    parentData = node.upBy(sub => !sub.leaf && sub.data.dept_code != code);\n    if (!parentData) return data;\n    parentData.each(sub => {\n      if (sub.data.dept_code != code) {\n        parentEs.push(sub);\n      }\n    })\n    if (parentEs.length) {\n      if (parentEs.every(item => item.checked && item.checked != 'half')) {\n        data.push(...app.upNodeAllF(parentData, node.data.dept_code));\n      } else {\n        data.push(node);\n      }\n    } else {\n      data.push(...app.upNodeAllF(parentData, node.data.dept_code));\n    }\n    return data;\n  },\n  upModeAll(node, code) {\n    let data = [], parentData, parentEs = [];\n    if (!node.data.dept_code) return data;\n    parentData = node.upBy(sub => !sub.leaf && sub.data.dept_code != code);\n    parentData.each(sub => {\n      if (sub.data.dept_code != code) {\n        parentEs.push(sub);\n      }\n    })\n    if (parentEs.length) {\n      if (parentEs.every(item => item.checked && item.checked != 'half')) {\n        data.push(parentData, ...app.upModeAll(parentData, parentData.data.dept_code));\n      } \n    } else {\n      data.push(parentData, ...app.upModeAll(parentData, parentData.data.dept_code));\n    }\n    return data;\n  },\n  upNodeAllZ(node, code) {\n    let data = [], parentData, parentEs = [];\n    parentData = node.upBy(sub => !sub.leaf && sub.data.dept_code != code);\n    if (!parentData) return data;\n    parentData.each(sub => {\n      if (sub.data.dept_code != code) {\n        parentEs.push(sub);\n      }\n    })\n    if (parentEs.length) {\n      if (parentEs.every(item => item.checked && item.checked != 'half')) {\n        data.push(...parentEs, ...app.upNodeAllZ(parentData, parentData.data.dept_code));\n      }\n    } else {\n      data.push(...app.upNodeAllZ(parentData, parentData.data.dept_code));\n    }\n    return data;\n  },\n\n  allxx(node) {\n    let xx = [];\n    node.each(sub => {\n      if(sub.checked && sub.checked != 'half') {\n        xx.push(sub);\n      }\n      if(sub.checked == 'half') {\n        xx.push(...app.allxx(sub));\n      } \n    })\n    return xx;\n  },\n\n  doSetPermSj(nodes, roleId, checked, success) {\n    let modules = [], leafNodes = [] ,eXmodules = [], exLeafNodes = [], leafModules = [], oldRoles, exNodes = [], exFliterNodes, nodesCode = [];\n    if (nodes.length > 1) {\n      nodes.forEach(node => {\n        nodesCode.push(node.data.dept_code);\n        exNodes.push(node.upBy(sub => !sub.leaf && sub.data?.dept_code != node.data?.dept_code));\n      })\n      exFliterNodes = ([...new Map(exNodes.map(item => [item.data?.dept_code, item])).values()]);\n      exFliterNodes.forEach(item => {\n        let exNodesCode = [];\n        item.each(i => exNodesCode.push(i.data.dept_code));\n        if (exNodesCode.every(n=> nodesCode.includes(n)) && exNodesCode.length > 1) leafNodes.push(item.data.dept_code);\n      })\n    }\n    nodes.forEach(node => {\n      if (node.leaf) {\n        if (node.upBy(sub => !sub.leaf).checked && node.upBy(sub => !sub.leaf).checked != 'half') {\n          leafNodes.push(...app.upNodeAllF(node.upBy(sub => !sub.leaf), node.data.dept_code));\n          exLeafNodes.push(...app.upNodeAllZ(node.upBy(sub => !sub.leaf), node.data.dept_code));\n          leafModules.push(node, node.upBy(sub => !sub.leaf), ...app.upModeAll(node.upBy(sub => !sub.leaf), node.upBy(sub => !sub.leaf).data.dept_code));\n        } else {\n          let allZ = [];\n          node.upBy(sub => !sub.leaf).each(sub => {\n            if (sub.data.dept_code != node.data.dept_code) {\n              allZ.push(sub);\n            }\n          })\n          if (allZ.length) {\n            if (allZ.every(item => item.checked && item.checked != 'half')) {\n              leafNodes.push(...app.upNodeAllF(node.upBy(sub => !sub.leaf), node.upBy(sub => !sub.leaf).data.dept_code));\n              exLeafNodes.push(...allZ, ...app.upNodeAllZ(node.upBy(sub => !sub.leaf), node.upBy(sub => !sub.leaf).data.dept_code));\n              leafModules.push(node, node.upBy(sub => !sub.leaf), ...app.upModeAll(node.upBy(sub => !sub.leaf), node.upBy(sub => !sub.leaf).data.dept_code));\n            } else {\n              leafNodes.push(node);\n              leafModules.push(node);\n            }\n          } else {\n            leafNodes.push(...app.upNodeAllF(node.upBy(sub => !sub.leaf), node.upBy(sub => !sub.leaf).data.dept_code));\n            exLeafNodes.push(...app.upNodeAllZ(node.upBy(sub => !sub.leaf), node.upBy(sub => !sub.leaf).data.dept_code));\n            leafModules.push(node, node.upBy(sub => !sub.leaf), ...app.upModeAll(node.upBy(sub => !sub.leaf), node.upBy(sub => !sub.leaf).data.dept_code));\n          }\n        }\n      } else {\n        if(node.upBy(sub => !sub.leaf && sub.data?.dept_code != node.data?.dept_code)) {\n          let allZ = [], allZx = [], allZxLen = [];\n\n          \n          // node.each(sub => {\n          //   if(sub.checked && sub.checked != 'half') allZx.push(sub);\n          // });\n          allZx.push(...app.allxx(node));\n\n          node.each(sub => {\n            allZxLen.push(sub);\n          });\n          node.upBy(sub => !sub.leaf && sub.data.dept_code != node.data.dept_code).each(sub => {\n            if (sub.data.dept_code != node.data.dept_code) {\n              allZ.push(sub);\n            }\n          })\n          if (allZ.length) {\n            if (allZ.every(item => item.checked && item.checked != 'half')) {\n              leafNodes.push(...app.upNodeAllF(node.upBy(sub => !sub.leaf && sub.data?.dept_code != node.data?.dept_code), node.upBy(sub => !sub.leaf && sub.data?.dept_code != node.data?.dept_code).data.dept_code));\n              exLeafNodes.push(...allZ, ...app.upNodeAllZ(node.upBy(sub => !sub.leaf && sub.data?.dept_code != node.data?.dept_code), node.upBy(sub => !sub.leaf && sub.data?.dept_code != node.data?.dept_code).data.dept_code));\n              leafModules.pushAll(leafNodes[0].downAll());\n            } else {\n              leafNodes.push(node);\n              leafModules.push(node, ...app.upModeAll(node, node.data.dept_code));\n              if (allZx.length > 1 && allZxLen.length != allZx.length) exLeafNodes.push(...allZx);\n              leafModules.pushAll(node.downAll());\n            }\n          } else {\n            // 单独一个\n            leafNodes.push(...app.upNodeAllF(node.upBy(sub => !sub.leaf && sub.data?.dept_code != node.data?.dept_code), node.upBy(sub => !sub.leaf && sub.data?.dept_code != node.data?.dept_code).data.dept_code));\n            exLeafNodes.push(...app.upNodeAllZ(node.upBy(sub => !sub.leaf && sub.data?.dept_code != node.data?.dept_code), node.upBy(sub => !sub.leaf && sub.data?.dept_code != node.data?.dept_code).data.dept_code));\n            leafModules.pushAll(leafNodes[0].downAll());\n          }\n        } else {\n          leafNodes.push(node)\n          leafModules.pushAll(node.downAll());\n        }\n      }\n    });\n    leafNodes.forEach(node => modules.push(node.data?.dept_code));\n    exLeafNodes.forEach(node => eXmodules.push(node.data?.dept_code));\n    Wb.ajax({\n      url: xpath + '/set-permissions-sj',\n      data: { modules, roleId, checked },\n      success() {\n        leafModules.forEach(node => {\n            oldRoles = node.data.roles ??= [];\n            if (checked) {\n              if (!oldRoles.includes(roleId))\n                oldRoles.push(roleId);\n            } else {\n              oldRoles.remove(roleId);\n            }\n        });\n        app.refreshPermsSj(roleId, app.deptTree);\n        app.refreshRolesSj(app.roleTree3);\n        success?.();\n      }\n    });\n    if (eXmodules.length)\n      Wb.ajax({\n        url: xpath + '/set-permissions-sj',\n        data: { modules: eXmodules, roleId, checked: !checked },\n      });\n  },\n  refreshPermsSj(roleId, tree) {\n    tree.suspendEvent();\n    // app.scanPermsSj(roleId, tree, true);\n    app.scanRolesSj(roleId, tree, true);\n    tree.resumeEvent();\n  },\n  refreshRolesSj(tree) {\n    let deptNode = app.deptTree.selection;\n    tree.suspendEvent();\n    tree.each(node => {\n      if (!node?.fixed) {\n        node.checked = app.scanPermsSj(node.data.sid, deptNode);\n        if (!node._leaf) {\n          app.refreshRolesSj(node);\n        }\n      }\n      else\n        app.refreshRolesSj(node);\n    });\n    tree.resumeEvent();\n  },\n  scanPermsSj(roleId, baseNode, doCheck) {\n    let hasPerm, checked, allChecked = true, allUnchecked = true;\n    if (baseNode.leaf) {\n      hasPerm = baseNode.data.roles?.includes(roleId);\n      if (doCheck)\n        baseNode.checked = hasPerm;\n      if (hasPerm)\n        allUnchecked = false;\n      else\n        allChecked = false;\n    } else {\n      baseNode.each(node => {\n        checked = app.scanPermsSj(roleId, node, doCheck);\n        if (checked == 'half') {\n          allChecked = false;\n          allUnchecked = false;\n        } else if (checked)\n          allUnchecked = false;\n        else\n          allChecked = false;\n      });\n    }\n    if (allChecked)\n      checked = true;\n    else if (allUnchecked)\n      checked = false;\n    else\n      checked = 'half';\n    if (doCheck && baseNode.isNode)\n      baseNode.checked = checked;\n    return checked;\n  },\n\n  subBoolean(nodes, boolean) {\n    nodes.each(sub => {\n      if (!sub.leaf) {\n        app.subBoolean(sub, boolean);\n      }\n      sub.checked = boolean;\n    })\n  },\n  scanRolesSj(roleId, baseNode, doCheck) {\n    let hasPerm, checked, allChecked = true, allUnchecked = true;\n    if (baseNode.leaf) {\n      hasPerm = baseNode.data.roles?.includes(roleId);\n      if (doCheck) {\n        baseNode.checked = hasPerm;\n      }\n      if (hasPerm)\n        allUnchecked = false;\n      else\n        allChecked = false;\n    } else {\n      baseNode.each(node => {\n        checked = app.scanRolesSj(roleId, node, doCheck);\n        if (checked == 'half') {\n          allChecked = false;\n          allUnchecked = false;\n        } else if (checked)\n          allUnchecked = false;\n        else\n          allChecked = false;\n      });\n      hasPerm = baseNode.data.roles?.includes(roleId);\n      if (hasPerm) {\n        baseNode.checked = true;\n        app.subBoolean(baseNode, true);\n        allChecked = true;\n      }\n    }\n    if (allChecked)\n      checked = true;\n    else if (allUnchecked)\n      checked = false;\n    else\n      checked = 'half';\n    if (doCheck && baseNode.isNode)\n      baseNode.checked = checked;\n    return checked;\n  }\n});"},"items":[{"_icon":"viewport","text":"viewport1","cls":"Wb.Viewport","properties":{"cid":"viewport1","layout":"row"},"_expanded":true,"items":[{"_icon":"tree-view","text":"roleTree1","cls":"Wb.Tree","_expanded":false,"properties":{"cid":"roleTree1","width":"20vw","title":"@Str.role","url":"@xpath + '/select-roles'","showIcon":"false","leafExpander":"true","icon":"role"},"events":{"selectionchange":"if(this.selection) {\n  let roleId = this.selection.data.sid\n  if (this.selection.data.role_type) {\n    app.moduleTree.visible = false;\n    app.deptTree.visible = true;\n    app.roleTree2.visible = false;\n    app.roleTree3.visible = true;\n    this.subTitle = this.selection.text;\n    app.refreshPermsSj(roleId, app.deptTree);\n  } else {\n    app.moduleTree.visible = true;\n    app.deptTree.visible = false;\n    app.roleTree2.visible = true;\n    app.roleTree3.visible = false;\n    this.subTitle = this.selection.text;\n    app.refreshPerms();\n  }\n}\nelse \n  this.subTitle = '';","success":"app.moduleTree.load();\napp.roleTree2.load();\n\napp.deptTree.load();\napp.roleTree3.load();"},"items":[{"cls":"Wb.Toolbar","properties":{"cid":"tbar","isProperty":"true"},"text":"tbar","_expanded":false,"_icon":"toolbar","hasDupCid":0,"items":[{"_icon":"text","text":"search1","cls":"Wb.Text","properties":{"cid":"search1","clearButton":"true","placeholder":"@Str.search","minWidth":"5em","maxWidth":"20em","flex":"1"},"events":{"change":"app.roleTree1.delayLoad({ comps: app.search1 });"},"hasDupCid":0}]}]},{"_icon":"splitter","text":"splitter1","cls":"Wb.Splitter","properties":{"cid":"splitter1"}},{"_icon":"tree-view","text":"moduleTree","cls":"Wb.Tree","_expanded":false,"properties":{"cid":"moduleTree","flex":"1","url":"@xpath + '/select-modules'","multiSelect":"true","allowDeselect":"false","minWidth":"10em","itemIcon":"module","visible":"true"},"events":{"selectionchange":"if(this.selection) {\n  app.roleTree2.subTitle = this.selection.text;\n  app.refreshRoles();\n}\nelse \n  app.roleTree2.subTitle = '';","beforecheckchange":"if (app.roleId)\n  app.setPerm(node, app.roleId, checked);\nreturn false;","success":"if (app.roleTree1.selection) app.refreshPerms();","beforeload":"params.appMode = app.appMode;"},"items":[{"cls":"Wb.Toolbar","properties":{"cid":"tbar","isProperty":"true"},"text":"tbar","_expanded":false,"_icon":"toolbar","hasDupCid":0,"items":[{"_icon":"item","text":"permitItem","cls":"Wb.Item","_expanded":false,"properties":{"cid":"permitItem","icon":"ok","text":"@Str.permit","keys":"Ctrl+E"},"events":{"click":"if (app.roleId)\n  app.setPerm(app.moduleTree.topSelections, app.roleId, true);\nelse\n  Wb.tipSelect(Str.role);"},"hasDupCid":1},{"_icon":"item","text":"forbidItem","cls":"Wb.Item","_expanded":false,"properties":{"cid":"forbidItem","icon":"cancel","text":"@Str.forbid","keys":"Ctrl+D"},"events":{"click":"if (app.roleId)\n  app.setPerm(app.moduleTree.topSelections, app.roleId, false);\nelse\n  Wb.tipSelect(Str.role);"},"hasDupCid":1},{"_icon":"divider","text":"divider1","cls":"Wb.Divider","properties":{"cid":"divider1"},"hasDupCid":1},{"_icon":"item","text":"expandAll","cls":"Wb.Item","_expanded":true,"properties":{"cid":"expandAll","text":"@Str.expandAll","icon":"expand"},"events":{"click":"app.moduleTree.expandAll();"},"hasDupCid":1},{"_icon":"item","text":"collapseAll","cls":"Wb.Item","_expanded":false,"properties":{"cid":"collapseAll","text":"@Str.collapseAll","icon":"compress"},"events":{"click":"app.moduleTree.collapseAll();"},"hasDupCid":1},{"_icon":"divider","text":"divider2","cls":"Wb.Divider","properties":{"cid":"divider2"},"hasDupCid":1},{"_icon":"item","text":"clearItem","cls":"Wb.Item","_expanded":true,"properties":{"cid":"clearItem","icon":"recycle","text":"@Str.clear","tip":"@Str.clearInvalidData"},"events":{"click":"Wb.ajax({\n  url: xpath + '/clean-invalid',\n  success() {\n    Wb.tipDone(Str.clear);\n  }\n});"},"hasDupCid":0},{"_icon":"divider","text":"divider3","cls":"Wb.Divider","properties":{"cid":"divider3"},"hasDupCid":0},{"_icon":"text","text":"search2","cls":"Wb.Text","proper