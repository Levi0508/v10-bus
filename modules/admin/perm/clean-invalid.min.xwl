{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","remark":"Clean up invalid permissions","serverScript":"function main(){let e=[];Wb.getRows(\"select module_path from wb_perm\",(l=>{if(!new Wb.File(true,\"wb/modules/\"+l.module_path+\".xwl\").exists)e.push(l)}));Wb.sql({sql:\"delete from wb_perm where module_path={?module_path?}\",params:e})}main();"},"_icon":"module"}