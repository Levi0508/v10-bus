{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","remark":"Edit role","serverScript":"function main() {\n  const Util = Wb.load('./util.mjs');\n  let oldRoleName = Params.$role_name;\n  if (Params.role_name && Util.isReservedRole(oldRoleName))\n    Wb.raise(Str.cannotModify.format(Params.role_name));\n  Params.sid = undefined;\n  Wb.sync({ tableName: 'wb_role', update: Params });\n  if(Params.parent_role_id !=null){\n    Wb.send({load:true})\n  }\n}\nmain();"},"_icon":"module"}