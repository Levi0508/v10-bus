{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"function toNestedTree(flatData) {\n  const data = JSON.parse(JSON.stringify(flatData));\n  const nodeMap = new Map();\n  data.forEach(node => {\n    nodeMap.set(node.role_id, node);\n    node.items = [];\n  });\n  const roleNodes = [];\n  data.forEach(node => {\n    const parentId = node.parent_role_id;\n    if (!parentId) {\n      roleNodes.push(node);\n    } else {\n      const parentNode = nodeMap.get(parentId);\n      if (parentNode) {\n        parentNode.items.push(node);\n      } else {\n        roleNodes.push(node);\n      }\n    }\n  })\n  function cleanLeaf(node) {\n    if (node.items && node.items.length > 0) {\n      delete node._leaf;\n      node._expanded = false;\n      node.items.forEach(child => cleanLeaf(child));\n    } else {\n      delete node.items;\n    }\n  }\n  roleNodes.forEach(node => cleanLeaf(node));\n  return roleNodes;\n}\n\nfunction classifyByRoleClass(data) {\n  const groupMap = {};\n  data.forEach(item => {\n    const key = String(item.role_class); \n    if (!groupMap[key]) {\n      groupMap[key] = [];\n    }\n    groupMap[key].push(item);\n  });\n  const result = Object.entries(groupMap).map(([classKey, items]) => ({\n    role_name: KVBuffer.getValue('roleClass', Number(classKey)) || classKey, \n    _expanded: false, \n    _fixed: true,  \n    items: items \n  }));\n  return result;\n}\n\nfunction main() {\n  let sql, data, allrole, treeData;\n  sql = `select t.*, 'true' as \"_leaf\" from wb_role t where 1=1`\n  treeData = []\n  if (Params.search) {\n    Wb.setLike('search');\n    sql += ' and t.role_name like {?search?} or t.role_id like {?search?}';\n  }\n  if (Params.searchRoleType) {\n    sql += ' and t.role_type = {?searchRoleType?}';\n  }\n  if (Params.searchRoleClass) {\n    sql += ' and t.role_class = {?searchRoleClass?}';\n  }\n  sql += Wb.getOrderSql();\n  data = Wb.getDict({ sql, rs: -1 }, 'wb,');\n  allrole = toNestedTree(data.items);\n\n  if (Params.searchRoleType) {\n    if (Params.searchRoleType == '0') {\n      treeData.push({\"role_name\":\"功能角色\",\"_expanded\":true,\"_fixed\":true,\"items\":[]})\n      treeData[0].items = classifyByRoleClass(allrole.filter(item => !item.role_type))\n    }\n    if (Params.searchRoleType == '1') {\n      treeData.push({\"role_name\":\"数据角色\",\"_expanded\":true,\"_fixed\":true,\"items\":[]})\n      treeData[0].items = classifyByRoleClass(allrole.filter(item => item.role_type))\n    }\n  } else {\n    treeData.push({\"role_name\":\"功能角色\",\"_expanded\":true,\"_fixed\":true,\"items\":[]}, {\"role_name\":\"数据角色\",\"_expanded\":true,\"_fixed\":true,\"items\":[]})\n    treeData[0].items = classifyByRoleClass(allrole.filter(item => !item.role_type))\n    treeData[1].items = classifyByRoleClass(allrole.filter(item => item.role_type))\n  }\n  Wb.send(treeData);\n}\nmain();"},"_icon":"module"}