{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","remark":"Add task","serverScript":"function main(){const b=Wb.load(\"./util.mjs\");let e=Wb.getId(),n={sid:e},t=Wb.getConn();Wb.set(n);Wb.sync({tableName:\"wb_job\",insert:Params,db:t});JobUtil.reloadJob(e,t.connection);Wb.send(Wb.apply(n,b.getFireTime(e)))}main();"},"_icon":"module"}