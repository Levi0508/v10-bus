{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","remark":"Delete tasks","serverScript":"function main(){let b=Wb.getObject(\"del\");b.forEach((b=>JobUtil.stopJob(b.$sid)));Wb.sync({tableName:\"wb_job\",del:b})}main();"},"_icon":"module"}