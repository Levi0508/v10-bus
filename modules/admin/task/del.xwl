{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","remark":"Delete tasks","serverScript":"function main() {\n  let del = Wb.getObject('del');\n\n  del.forEach(item => JobUtil.stopJob(item.$sid));\n  Wb.sync({ tableName: 'wb_job', del });\n}\nmain();"},"_icon":"module"}