{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","remark":"Start or stop tasks","serverScript":"function main(){let t=Wb.getBool(\"status\");if(t)JobUtil.startEngine();else JobUtil.shutdownEngine();Wb.setConfig(\"sys.task.enabled\",t)}main();"},"_icon":"module"}