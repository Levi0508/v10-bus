{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"let sql, sourceRoles;\nif (Params.userId) {\n  sql = `select b.sid, a.role_id, b.role_name as text, a.begin_date, a.end_date, b.remark as subtext, b.role_type from wb_user_role a left join wb_role b on b.role_id = a.role_id where a.user_id={?userId?} order by a.role_id`;\n  sourceRoles = Wb.getAllRows(sql)\n  Wb.send(sourceRoles);\n} else {\n  Wb.send([]);\n}"},"_icon":"module"}