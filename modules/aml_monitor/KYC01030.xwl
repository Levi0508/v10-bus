{"title":"客户填报人维护","icon":"","img":"","tags":"","hideInMenu":"true","text":"module","cls":"Wb.Module","properties":{"cid":"module","links":"[\"wb/custom-made/vue/vue.js\",\"wb/custom-made/vue/element.js\",\"wb/custom-made/vue/element.css\"]"},"_icon":"module","_expanded":true,"items":[{"_icon":"viewport","text":"viewport1","cls":"Wb.Viewport","properties":{"cid":"viewport1"},"_expanded":true,"events":{"keydown":"if (e.keyCode == '13') {\n  app.seekBtn.fireClick()\n}"},"items":[{"_icon":"panel","text":"header","cls":"Wb.Panel","properties":{"cid":"header","html":"<div style=\"font-size:16px;font-weight:bold;padding:20px;\">客户填报人维护</div>","minHeight":"80"},"_expanded":true,"items":[{"cls":"Wb.Container","events":{"ready":"let comp = this;\ncomp.vue = new Vue({\n  el: comp.el.addEl(),\n  template: `\n<div style=\"padding:15px 0 0 20px;\">\n  <el-breadcrumb separator=\"/\">\n  <el-breadcrumb-item>反洗钱系统</el-breadcrumb-item>\n  <el-breadcrumb-item>客户填报人维护</el-breadcrumb-item>\n  </el-breadcrumb>\n</div>\n`,\n  data() {\n    return {\n    }\n  },\n  methods: {\n  }\n});"},"properties":{"cid":"headers","isProperty":"true"},"text":"headers","_expanded":true,"_icon":"container","hasDupCid":0}]},{"_icon":"splitter","text":"splitter1","cls":"Wb.Splitter","properties":{"cid":"splitter1"}},{"_icon":"panel","text":"panel1","cls":"Wb.Panel","properties":{"cid":"panel1","border":"false","layout":"grid4"},"_expanded":true,"hasDupCid":0,"items":[{"_icon":"text","text":"CLIENT_NAME","cls":"Wb.Text","properties":{"cid":"CLIENT_NAME","text":"客户名称","placeholder":"请输入"},"hasDupCid":0},{"_icon":"text","text":"MAINTAINER","cls":"Wb.Text","properties":{"cid":"MAINTAINER","text":"填报人","placeholder":"请输入"},"hasDupCid":0}]},{"_icon":"grid","text":"grid1","cls":"Wb.Grid","properties":{"cid":"grid1","pagingBar":"pageNums","pageSize":"100","full":"true","border":"false","url":"@xpath + '/select'","emptyHint":"true"},"_expanded":true,"hasDupCid":0,"items":[{"_icon":"toolbar","text":"tbar","cls":"Wb.Toolbar","properties":{"cid":"tbar","gap":"true","layout":"form-compact","isProperty":"true","border":"false"},"_expanded":true,"hasDupCid":0,"items":[{"_icon":"button","text":"editBtn","cls":"Wb.Button","properties":{"cid":"editBtn","text":"修改维护人","type":"primary","roundBorder":"true"},"events":{"click":"if(!app.grid1.selection){\n  Wb.info(\"请至少选中 1 条数据\");\n  return;\n}\nconsole.log(app.grid1.selectionData);\nlet rec = app.grid1.selectionData;\napp.I_CLIENT_ID.setValue(rec.client_id)\napp.I_CLIENT_NAME.setValue(rec.client_name);\napp.I_MAINTAINER.setValue(rec.new_maintainer);\napp.editWin.show();"}},{"_icon":"right1","text":"fill1","cls":"Wb.Fill","properties":{"cid":"fill1"}},{"_icon":"button","text":"seekBtn","cls":"Wb.Button","properties":{"cid":"seekBtn","text":"查询","type":"primary","roundBorder":"true"},"events":{"click":"let data = Wb.getValue(app.panel1)\nif(Wb.verify(app.panel1)){\n  app.grid1.load({\n    comps:app.panel1,\n    params:{},\n  })\n}\n"}},{"_icon":"button","text":"resetBtn","cls":"Wb.Button","properties":{"cid":"resetBtn","text":"重置","roundBorder":"true"},"events":{"click":"app.CLIENT_NAME.setValue('');\napp.MAINTAINER.setValue('');\napp.grid1.load()"}}]},{"_icon":"array","text":"columns","cls":"Wb.Array","properties":{"cid":"columns"},"_expanded":true,"hasDupCid":1,"items":[{"_icon":"column","text":"rownum1_Col","cls":"Wb.Column","properties":{"cid":"rownum1_Col","rowNum":"true","width":"60"},"hasDupCid":0},{"_icon":"column","text":"CLIENT_ID_Col","cls":"Wb.Column","properties":{"cid":"CLIENT_ID_Col","text":"客户ID","fieldName":"client_id"}},{"_icon":"column","text":"CLIENT_NAME_Col","cls":"Wb.Column","properties":{"cid":"CLIENT_NAME_Col","text":"客户名称","fieldName":"client_name","minWidth":"250"},"hasDupCid":0},{"_icon":"column","text":"CLIENT_STATUS_Col","cls":"Wb.Column","properties":{"cid":"CLIENT_STATUS_Col","text":"客户状态","fieldName":"client_status","keyValue":"true"},"hasDupCid":0},{"_icon":"column","text":"NEW_MAINTAINER_Col","cls":"Wb.Column","properties":{"cid":"NEW_MAINTAINER_Col","text":"填报人","fieldName":"user_name"},"hasDupCid":0},{"_icon":"column","text":"CREATE_USER_NO_Col","cls":"Wb.Column","properties":{"cid":"CREATE_USER_NO_Col","text":"填报人工号","fieldName":"staff_id"},"hasDupCid":0},{"_icon":"column","text":"CREATE_USER_NAME_Col","cls":"Wb.Column","properties":{"cid":"CREATE_USER_NAME_Col","text":"填报人姓名","fieldName":"display_name"},"hasDupCid":0,"_expanded":true},{"_icon":"column","text":"UPDATE_USER_Col","cls":"Wb.Column","properties":{"cid":"UPDATE_USER_Col","text":"更新人员","fieldName":"update_user_name"}},{"_icon":"column","text":"UPDATE_TIME_Col","cls":"Wb.Column","properties":{"cid":"UPDATE_TIME_Col","text":"更新时间","fieldName":"update_time"}}]}]}]},{"_icon":"window","text":"editWin","cls":"Wb.Window","_expanded":true,"properties":{"cid":"editWin","title":"修改维护人","dialog":"true","width":"450","padding":"20"},"events":{"ok":"Wb.ajax({\n  url:xpath + '/edit',\n  params:{\n    NEW_MAINTAINER:app.I_NEW_MAINTAINER.value,\n    CLIENT_ID:app.I_CLIENT_ID.value\n  },\n  success(resp){\n    app.editWin.hide();\n    Wb.tipSucc(\"修改成功\")\n    app.grid1.reload()\n  }\n});"},"items":[{"_icon":"text","text":"I_CLIENT_ID","cls":"Wb.Text","properties":{"cid":"I_CLIENT_ID","visible":"false","text":"客户号"}},{"_icon":"text","text":"I_CLIENT_NAME","cls":"Wb.Text","properties":{"cid":"I_CLIENT_NAME","text":"客户名称","disabled":"true","padding":"10","labelWidth":"100"}},{"_icon":"text","text":"I_MAINTAINER","cls":"Wb.Text","properties":{"cid":"I_MAINTAINER","text":"原维护人","disabled":"true","padding":"10","labelWidth":"100"},"_expanded":true},{"_icon":"combo","text":"I_NEW_MAINTAINER","cls":"Wb.Select","properties":{"cid":"I_NEW_MAINTAINER","text":"新维护人","labelWidth":"100","padding":"10","required":"true","valueField":"user_id","textField":"textfield","forceSelect":"true","matchMode":"includesIC"},"events":{"click":"app.userSelectWin.show()"}}]},{"_icon":"window","text":"userSelectWin","cls":"Wb.Window","_expanded":true,"properties":{"cid":"userSelectWin","title":"查询负责人","width":"600","height":"600"},"items":[{"_icon":"text","text":"query","cls":"Wb.Text","properties":{"cid":"query","placeholder":"用户ID或用户名"},"events":{"change":"app.grid2.load({params:{query:value}})"},"_expanded":false},{"_icon":"grid","text":"grid2","cls":"Wb.Grid","properties":{"cid":"grid2","url":"@xpath + '/selectUser'","full":"true"},"events":{"itemdblclick":"app.userSelectWin.close();\n// console.log(\"选中行item\",item.data)\napp.I_NEW_MAINTAINER.setValue(item.data.user_name)"},"hasDupCid":0,"_expanded":true,"items":[{"_icon":"array","text":"columns","cls":"Wb.Array","properties":{"cid":"columns"},"hasDupCid":1,"_expanded":true,"items":[{"_icon":"column","text":"rownum_Col","cls":"Wb.Column","properties":{"cid":"rownum_Col","rowNum":"true"},"hasDupCid":0},{"_icon":"column","text":"STAFF_ID_Col","cls":"Wb.Column","properties":{"cid":"STAFF_ID_Col","text":"工号","fieldName":"staff_id"}},{"_icon":"column","text":"USER_NAME_Col","cls":"Wb.Column","properties":{"cid":"USER_NAME_Col","text":"用户名","fieldName":"user_name"}},{"_icon":"column","text":"DISPLAY_NAME_Col","cls":"Wb.Column","properties":{"cid":"DISPLAY_NAME_Col","text":"姓名","fieldName":"display_name"}}]}]}]}]}