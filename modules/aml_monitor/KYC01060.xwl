{"title":"国家或地区维护","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","links":"[\"wb/custom-made/vue/vue.js\",\"wb/custom-made/vue/element.js\",\"wb/custom-made/vue/element.css\"]"},"_icon":"module","_expanded":true,"items":[{"_icon":"viewport","text":"viewport1","cls":"Wb.Viewport","properties":{"cid":"viewport1"},"_expanded":true,"events":{"keydown":"if (e.keyCode == '13') {\n  app.seekBtn.fireClick()\n}"},"items":[{"_icon":"panel","text":"header","cls":"Wb.Panel","properties":{"cid":"header","html":"<div style=\"font-size:16px;font-weight:bold;padding:20px;\">国家或地区维护</div>","maxHeight":"80","style":"display:none"},"_expanded":true,"items":[{"cls":"Wb.Container","events":{"ready":"let comp = this;\ncomp.vue = new Vue({\n  el: comp.el.addEl(),\n  template: `\n<div style=\"padding:15px 0 0 20px;\">\n  <el-breadcrumb separator=\"/\">\n  <el-breadcrumb-item>反洗钱系统</el-breadcrumb-item>\n  <el-breadcrumb-item>国家或地区</el-breadcrumb-item>\n  </el-breadcrumb>\n</div>\n`,\n  data() {\n    return {\n    }\n  },\n  methods: {\n  }\n});"},"properties":{"cid":"headers","isProperty":"true"},"text":"headers","_expanded":true,"_icon":"container","hasDupCid":0}]},{"_icon":"splitter","text":"splitter1","cls":"Wb.Splitter","properties":{"cid":"splitter1"}},{"_icon":"panel","text":"panel1","cls":"Wb.Panel","properties":{"cid":"panel1","border":"false","layout":"grid4"},"_expanded":true,"hasDupCid":0,"items":[{"_icon":"text","text":"COUNTRY_NAME","cls":"Wb.Text","properties":{"cid":"COUNTRY_NAME","text":"国家名称/编号","placeholder":"请输入国家名称或编号","width":"400","labelAlign":"left"}}]},{"_icon":"grid","text":"grid1","cls":"Wb.Grid","properties":{"cid":"grid1","pagingBar":"pageNums","pageSize":"100","full":"true","border":"false","url":"@xpath + '/select'","multiSelect":"true","emptyHint":"true","textSelectable":"true","sorters":"['country_code', 'country_name']","columnsSortable":"true"},"_expanded":true,"items":[{"_icon":"toolbar","text":"tbar","cls":"Wb.Toolbar","properties":{"cid":"tbar","gap":"true","layout":"form-compact","isProperty":"true","border":"false"},"_expanded":true,"hasDupCid":0,"items":[{"_icon":"button","text":"addBtn","cls":"Wb.Button","properties":{"cid":"addBtn","text":"新建","roundBorder":"true","icon":"add","iconColor":"#ffffff","style":"background-color:#5cbc85;color:#fff","height":"30px"},"hasDupCid":0,"events":{"click":"app.I_COUNTRY_CODE.setValue('');\napp.I_COUNTRY_NAME.setValue('');\napp.I_REMARK.setValue('');\napp.addWin.show();"}},{"_icon":"button","text":"editBtn","cls":"Wb.Button","properties":{"cid":"editBtn","text":"修改","roundBorder":"true","icon":"edit","iconColor":"#ffffff","style":"background-color:#f0ad4e;color:#fff","height":"30px"},"events":{"click":"if (app.grid1.selectionsData.length != 1) {\n  Wb.info(\"请选中 1 条数据\");\n  return;\n}\nlet rec = app.grid1.selectionData;\napp.A_COUNTRY_CODE.setValue(rec.country_code);\napp.A_COUNTRY_NAME.setValue(rec.country_name);\napp.A_REMARK.setValue(rec.remark);\napp.editWin.show();"}},{"_icon":"button","text":"deleteBtn","cls":"Wb.Button","properties":{"cid":"deleteBtn","text":"删除","roundBorder":"true","style":"background-color:#d9534f;color:#fff","icon":"delete","iconColor":"#ffffff","height":"30px"},"events":{"click":"if (!app.grid1.selection) {\n  Wb.info(\"请选中 1 条数据\");\n  return;\n}\nlet sel = app.grid1.selectionsData;\n\nWb.confirm(\"是否确认要删除该条数据？\", () => {\n  Wb.ajax({\n    url: xpath + '/del',\n    params: {\n      COUNTRY_CODE: sel.map(item => item.country_code).join(',')\n    },\n    success(resp) {\n      Wb.tipSucc(\"删除成功\");\n      app.grid1.reload()\n    }\n  });\n})\n"}},{"_icon":"right1","text":"fill1","cls":"Wb.Fill","properties":{"cid":"fill1"}},{"_icon":"button","text":"seekBtn","cls":"Wb.Button","properties":{"cid":"seekBtn","text":"查询","type":"primary","roundBorder":"true","enterButton":"true","style":"background-color:#337ab7;color:#fff","icon":"search","iconColor":"#ffffff","height":"30px"},"events":{"click":"if(Wb.verify(app.panel1)){\n  app.grid1.load({\n    comps:app.panel1\n  })\n}"}},{"_icon":"button","text":"resetBtn","cls":"Wb.Button","properties":{"cid":"resetBtn","text":"重置","roundBorder":"true","style":"background-color:#5cbc85;color:#fff","icon":"loading3","iconColor":"#ffffff","height":"30px"},"events":{"click":"app.COUNTRY_NAME.setValue('');\napp.grid1.load()"}}]},{"_icon":"array","text":"columns","cls":"Wb.Array","properties":{"cid":"columns"},"_expanded":true,"items":[{"_icon":"column","text":"rownum_Col","cls":"Wb.Column","properties":{"cid":"rownum_Col","rowNum":"true","width":"75","text":"序号","titleAlign":"left","align":"center"}},{"_icon":"column","text":"COUNTRY_CODE_Col","cls":"Wb.Column","properties":{"cid":"COUNTRY_CODE_Col","text":"国家编号","fieldName":"country_code","sortable":"true","width":"200"},"hasDupCid":0,"_expanded":true},{"_icon":"column","text":"COUNTRY_NAME_Col","cls":"Wb.Column","properties":{"cid":"COUNTRY_NAME_Col","text":"国家名称","fieldName":"country_name","sortable":"true","width":"400"},"hasDupCid":0},{"_icon":"column","text":"REMARK_Col","cls":"Wb.Column","properties":{"cid":"REMARK_Col","text":"备注","fieldName":"remark","width":"200"},"hasDupCid":0}]}]}]},{"_icon":"window","text":"addWin","cls":"Wb.Window","_expanded":false,"properties":{"cid":"addWin","title":"新增","dialog":"true","width":"450","padding":"20"},"events":{"ok":"Wb.ajax({\n  url:xpath + '/add',\n  params:{\n    COUNTRY_CODE:app.I_COUNTRY_CODE.getValue(),\n    COUNTRY_NAME:app.I_COUNTRY_NAME.getValue(),\n    REMARK:app.I_REMARK.getValue()\n  },\n  success(resp){\n    app.grid1.reload();\n    Wb.tipSucc(\"新增成功\");\n    app.addWin.close();\n\n  }\n});"},"items":[{"_icon":"text","text":"I_COUNTRY_CODE","cls":"Wb.Text","properties":{"cid":"I_COUNTRY_CODE","text":"国家编号","labelWidth":"100","padding":"10"},"hasDupCid":0,"_expanded":true},{"_icon":"text","text":"I_COUNTRY_NAME","cls":"Wb.Text","properties":{"cid":"I_COUNTRY_NAME","text":"国家名称","padding":"10","labelWidth":"100"},"hasDupCid":0},{"_icon":"text","text":"I_REMARK","cls":"Wb.Text","properties":{"cid":"I_REMARK","text":"备注","padding":"10","labelWidth":"100"},"_expanded":true,"hasDupCid":0}]},{"_icon":"window","text":"editWin","cls":"Wb.Window","_expanded":false,"properties":{"cid":"editWin","title":"修改","dialog":"true","width":"450","padding":"20"},"events":{"ok":"Wb.ajax({\n  url:xpath + '/edit',\n  params:{\n    COUNTRY_CODE:app.A_COUNTRY_CODE.getValue(),\n    COUNTRY_NAME:app.A_COUNTRY_NAME.getValue(),\n    REMARK:app.A_REMARK.getValue()\n  },\n  success(resp){\n    app.grid1.reload();\n    Wb.tipSucc(\"修改成功\");\n    app.editWin.close();\n  }\n});"},"items":[{"_icon":"text","text":"A_COUNTRY_CODE","cls":"Wb.Text","properties":{"cid":"A_COUNTRY_CODE","text":"国家编号","labelWidth":"100","padding":"10","readonly":"true"},"hasDupCid":0},{"_icon":"text","text":"A_COUNTRY_NAME","cls":"Wb.Text","properties":{"cid":"A_COUNTRY_NAME","text":"国家名称","padding":"10","labelWidth":"100"},"hasDupCid":0},{"_icon":"text","text":"A_REMARK","cls":"Wb.Text","properties":{"cid":"A_REMARK","text":"备注","padding":"10","labelWidth":"100"},"_expanded":true,"hasDupCid":0}]}]}