{"title":"受益所有人类型维护","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","links":"[\"wb/custom-made/vue/vue.js\",\"wb/custom-made/vue/element.js\",\"wb/custom-made/vue/element.css\"]"},"_icon":"module","_expanded":true,"items":[{"_icon":"viewport","text":"viewport1","cls":"Wb.Viewport","properties":{"cid":"viewport1"},"_expanded":true,"events":{"keydown":"if (e.keyCode == '13') {\n  app.seekBtn.fireClick()\n}"},"items":[{"_icon":"panel","text":"header","cls":"Wb.Panel","properties":{"cid":"header","html":"<div style=\"font-size:16px;font-weight:bold;padding:20px;\">受益所有人类型维护</div>","maxHeight":"80","style":"display:none"},"_expanded":true,"items":[{"cls":"Wb.Container","events":{"ready":"let comp = this;\ncomp.vue = new Vue({\n  el: comp.el.addEl(),\n  template: `\n<div style=\"padding:15px 0 0 20px;\">\n  <el-breadcrumb separator=\"/\">\n  <el-breadcrumb-item>反洗钱系统</el-breadcrumb-item>\n  <el-breadcrumb-item>受益所有人类型维护</el-breadcrumb-item>\n  </el-breadcrumb>\n</div>\n`,\n  data() {\n    return {\n    }\n  },\n  methods: {\n  }\n});"},"properties":{"cid":"headers","isProperty":"true"},"text":"headers","_expanded":true,"_icon":"container","hasDupCid":0}]},{"_icon":"splitter","text":"splitter1","cls":"Wb.Splitter","properties":{"cid":"splitter1"}},{"_icon":"panel","text":"panel1","cls":"Wb.Panel","properties":{"cid":"panel1","border":"false","layout":"grid4"},"_expanded":true,"hasDupCid":0,"items":[{"_icon":"text","text":"BENEFICIAL_TYPE_NAME","cls":"Wb.Text","properties":{"cid":"BENEFICIAL_TYPE_NAME","text":"受益所有人类型名称/编号","placeholder":"请输入受益所有人类型名称或编号","width":"400","labelWidth":"200px"}}]},{"_icon":"grid","text":"grid1","cls":"Wb.Grid","properties":{"cid":"grid1","pagingBar":"pageNums","pageSize":"100","full":"true","border":"false","url":"@xpath + '/select'","multiSelect":"true","emptyHint":"true","textSelectable":"true","columnsSortable":"true","sorters":"['beneficial_type_no','beneficial_type_name']"},"_expanded":true,"items":[{"_icon":"toolbar","text":"tbar","cls":"Wb.Toolbar","properties":{"cid":"tbar","gap":"true","layout":"form-compact","isProperty":"true","border":"false"},"_expanded":true,"hasDupCid":0,"items":[{"_icon":"button","text":"addBtn","cls":"Wb.Button","properties":{"cid":"addBtn","text":"新建","roundBorder":"true","style":"background-color:#5cbc85;color:#fff","icon":"add","iconColor":"#ffffff","height":"30px"},"hasDupCid":0,"events":{"click":"app.I_BENEFICIAL_TYPE_NAME.setValue('');\napp.I_BENEFICIAL_TYPE_NO.setValue('');\napp.I_REMARK.setValue('');\napp.addWin.show();"}},{"_icon":"button","text":"editBtn","cls":"Wb.Button","properties":{"cid":"editBtn","text":"修改","roundBorder":"true","iconColor":"#ffffff","icon":"edit","style":"background-color:#f0ad4e;color:#fff","height":"30px"},"events":{"click":"if(app.grid1.selectionsData.length!=1){\n  Wb.info(\"请选中 1 条数据\");\n  return;\n}\nlet rec = app.grid1.selectionData;\napp.A_BENEFICIAL_TYPE_NAME.setValue(rec.beneficial_type_name);\napp.A_BENEFICIAL_TYPE_NO.setValue(rec.beneficial_type_no);\napp.A_REMARK.setValue(rec.remark);\napp.editWin.show();"}},{"_icon":"button","text":"deleteBtn","cls":"Wb.Button","properties":{"cid":"deleteBtn","text":"删除","roundBorder":"true","style":"background-color:#d9534f;color:#fff","icon":"delete","iconColor":"#ffffff","height":"30px"},"events":{"click":"if (!app.grid1.selection) {\n  Wb.info(\"请选中 1 条数据\");\n  return;\n}\nlet sel = app.grid1.selectionsData;\nconsole.log(sel);\n\nWb.confirm(\"是否确认要删除该条数据？\", () => {\n  Wb.ajax({\n    url: xpath + '/del',\n    params: {\n      BENEFICIAL_TYPE_CODE: sel.map(item => item.beneficial_type_no).join(',')\n    },\n    success(resp) {\n      Wb.tipSucc(\"删除成功\");\n      app.grid1.reload()\n    }\n  });\n})\n"}},{"_icon":"right1","text":"fill1","cls":"Wb.Fill","properties":{"cid":"fill1"}},{"_icon":"button","text":"seekBtn","cls":"Wb.Button","properties":{"cid":"seekBtn","text":"查询","type":"primary","roundBorder":"true","style":"background-color:#337ab7;color:#fff","icon":"search","iconColor":"#ffffff","height":"30px"},"events":{"click":"if(Wb.verify(app.panel1)){\n  app.grid1.load({\n    comps:app.panel1\n  })\n}"},"_expanded":true},{"_icon":"button","text":"resetBtn","cls":"Wb.Button","properties":{"cid":"resetBtn","text":"重置","roundBorder":"true","style":"background-color:#5cbc85;color:#fff","icon":"loading3","iconColor":"#ffffff","height":"30px"},"events":{"click":"app.BENEFICIAL_TYPE_NAME.setValue('');\napp.grid1.load();"},"_expanded":false}]},{"_icon":"array","text":"columns","cls":"Wb.Array","properties":{"cid":"columns"},"_expanded":true,"items":[{"_icon":"column","text":"rownum_Col","cls":"Wb.Column","properties":{"cid":"rownum_Col","rowNum":"true","width":"50"}},{"_icon":"column","text":"BENEFICIAL_TYPE_NO_Col","cls":"Wb.Column","properties":{"cid":"BENEFICIAL_TYPE_NO_Col","text":"受益所有人编号","fieldName":"beneficial_type_no","width":"200"},"hasDupCid":0},{"_icon":"column","text":"BENEFICIAL_TYPE_NAME_Col","cls":"Wb.Column","properties":{"cid":"BENEFICIAL_TYPE_NAME_Col","text":"受益所有人名称","fieldName":"beneficial_type_name","width":"400","minWidth":"500"},"hasDupCid":0},{"_icon":"column","text":"REMARK_Col","cls":"Wb.Column","properties":{"cid":"REMARK_Col","text":"备注","fieldName":"remark","width":"400"},"hasDupCid":0}]}]}]},{"_icon":"window","text":"addWin","cls":"Wb.Window","_expanded":true,"properties":{"cid":"addWin","title":"新增","dialog":"true","width":"500","padding":"20"},"events":{"ok":"Wb.ajax({\n  url: xpath + '/add',\n  params: {\n    BENEFICIAL_TYPE_CODE: app.I_BENEFICIAL_TYPE_NO.value,\n    BENEFICIAL_TYPE_NAME: app.I_BENEFICIAL_TYPE_NAME.value,\n    REMARK: app.I_REMARK.value\n  },\n  success(resp) {\n    app.addWin.close();\n    Wb.tipSucc(\"新增成功\")\n    app.grid1.reload()\n  }\n});"},"items":[{"_icon":"text","text":"I_BENEFICIAL_TYPE_NO","cls":"Wb.Text","properties":{"cid":"I_BENEFICIAL_TYPE_NO","text":"受益所有人类型编号","labelWidth":"180","padding":"10"},"hasDupCid":0,"_expanded":true},{"_icon":"text","text":"I_BENEFICIAL_TYPE_NAME","cls":"Wb.Text","properties":{"cid":"I_BENEFICIAL_TYPE_NAME","text":"受益所有人类型名称","padding":"10","labelWidth":"180"},"hasDupCid":0},{"_icon":"text","text":"I_REMARK","cls":"Wb.Text","properties":{"cid":"I_REMARK","text":"备注","padding":"10","labelWidth":"180"},"_expanded":true,"hasDupCid":0}]},{"_icon":"window","text":"editWin","cls":"Wb.Window","_expanded":true,"properties":{"cid":"editWin","title":"修改","dialog":"true","width":"500","padding":"20"},"events":{"ok":"Wb.ajax({\n  url: xpath + '/edit',\n  params: {\n    BENEFICIAL_TYPE_CODE: app.A_BENEFICIAL_TYPE_NO.getValue(),\n    BENEFICIAL_TYPE_NAME: app.A_BENEFICIAL_TYPE_NAME.getValue(),\n    REMARK: app.A_REMARK.getValue()\n  },\n  success(resp) {\n    app.editWin.hide();\n    Wb.tipSucc(\"修改成功\")\n    app.grid1.reload()\n  }\n});"},"items":[{"_icon":"text","text":"A_BENEFICIAL_TYPE_NO","cls":"Wb.Text","properties":{"cid":"A_BENEFICIAL_TYPE_NO","text":"受益所有人类型编号","labelWidth":"180","padding":"10","readonly":"true"},"hasDupCid":0},{"_icon":"text","text":"A_BENEFICIAL_TYPE_NAME","cls":"Wb.Text","properties":{"cid":"A_BENEFICIAL_TYPE_NAME","text":"受益所有人类型名称","padding":"10","labelWidth":"180"},"hasDupCid":0},{"_icon":"text","text":"A_REMARK","cls":"Wb.Text","properties":{"cid":"A_REMARK","text":"备注","padding":"10","labelWidth":"180"},"_expanded":true,"hasDupCid":0}]}]}