{
  "title": "客户信息编辑",
  "icon": "",
  "img": "",
  "tags": "",
  "hideInMenu": "false",
  "text": "module",
  "cls": "Wb.Module",
  "properties": {
    "cid": "module",
    "links": "[\n  \"wb/custom-made/js/prs01.js\",\n  \"wb/libs/exportPdf/html2canvas.js\",\n  \"wb/libs/exportPdf/jspdf.debug.js\"\n]",
    "serverScript": "// var showBomisBtn = Wb.permit('aml_monitor/workflow/prs01/dataSource/bomisBtnShow.xwl');"
  },
  "_icon": "module",
  "_expanded": true,
  "events": {
    "initialize": "let rules = getRules();// 主表单填写规则\nlet rules1 = getRules1();// 关联人弹窗填写规则（因与主表单有同名字段需区分开）\nlet forms = getRuleForm();\nlet directory = getDirConfig();\nlet selectKey = getSelectKey();\n\n// 定义全局变量\nlet data = {\n  rules: rules,// 表单校验规则\n  rules1: rules1,\n  forms: forms,// 表单\n  list: selectKey.list,\n  dict: selectKey.dict,\n  directory: directory,// 附件目录\n  selectList: {},\n  fileDialogVisible: false,\n  // 客户基本信息\n  basicInfo: {},\n  relatedInfo1: [],// 法定代表人\n  relatedInfo2: [],// 控股股东\n  relatedInfo3: [],// 实际控制人\n  relatedInfo4: [],// 授权代表人\n  relatedInfo5: [],// 受益所有人\n\n}\n\nWb.apply(app, {\n  data: data,\n  loadSelectList(item) {\n    if (!Wb.isEmpty(item.KEY_NAME)) {\n      Wb.ajax({\n        url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/select_key',\n        params: {\n          I_KEY_NAME: item.KEY_NAME\n        },\n        success(resp) {\n          let arr = Wb.decode(resp).items;\n          app.data.selectList[item.BIND_DATA + \"_list\"] = arr;\n        }\n      });\n    }\n  },\n  getDictMap(item) {\n    Wb.ajax({\n      url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/select_dict',\n      params: {\n        I_ENTRY_NO: item.ENTRY_NO\n      },\n      success(resp) {\n        let arr = Wb.decode(resp).items;\n        app.data.selectList[item.BIND_DATA + \"_list\"] = arr;\n      }\n    })\n  },\n  // 页面展示数据字典转换\n  formatDictMap(dictType, key) {\n    const dictData = this.selectList[dictType];\n    const item = dictData.find(item => item.k === key);\n    return item ? item.v : '-';\n  },\n  formatMoneyType(dict, key) {\n    const item = dict.find(item => item.k === key);\n    return item ? item.v : '-';\n  },\n  // 省市区键值转换\n  formatAddress(dict, key) {\n    const item = dict.find(item => item.value === key);\n    return item ? item.label : key;\n  },\n  // 查询客户基本信息\n  getBasicInfo(client_id, data_type) {\n    Wb.ajax({\n      url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/select_basic_info',\n      params: {\n        CLIENT_ID: client_id,\n        DATA_TYPE: data_type\n      },\n      success(resp) {\n        let res = Wb.decode(resp).items;\n        if (res[0]) {\n          app.data.basicInfo = res[0];\n        }\n        console.log(\"客户基本信息resp\", res[0]);\n      }\n    });\n  }\n});\n\n"
  },
  "items": [
    {
      "_icon": "viewport",
      "text": "viewport1",
      "cls": "Wb.Viewport",
      "properties": {
        "cid": "viewport1"
      },
      "_expanded": true,
      "events": {
        "ready": "app.data.list.forEach(item => {\n  app.loadSelectList(item);\n});\n\napp.data.dict.forEach(item => {\n  app.getDictMap(item);\n});\n"
      },
      "items": [
        {
          "_icon": "tab",
          "text": "tab1",
          "cls": "Wb.Tab",
          "_expanded": true,
          "properties": {
            "cid": "tab1",
            "full": "true",
            "border": "false",
            "tabPosition": "top",
            "tabSortable": "false",
            "cls": "tabcls",
            "maxWidth": "1920px",
            "margin": "0 auto"
          },
          "items": [
            {
              "_icon": "card",
              "text": "card1",
              "cls": "Wb.Card",
              "properties": {
                "cid": "card1",
                "title": "客户基本信息维护",
                "closable": "null",
                "layout": "column",
                "maxWidth": "1920px",
                "margin": "0 auto"
              },
              "_expanded": true,
              "hasDupCid": 0,
              "items": [
                {
                  "_icon": "toolbar",
                  "text": "tbar",
                  "cls": "Wb.Toolbar",
                  "properties": {
                    "cid": "tbar",
                    "gap": "true",
                    "padding": "0 0 10px 0"
                  },
                  "_expanded": true,
                  "items": [
                    {
                      "_icon": "right1",
                      "text": "fill1",
                      "cls": "Wb.Fill",
                      "properties": {
                        "cid": "fill1"
                      }
                    },
                    {
                      "_icon": "button",
                      "text": "cancelBtn",
                      "cls": "Wb.Button",
                      "properties": {
                        "cid": "cancelBtn",
                        "text": "返回",
                        "visible": "false"
                      },
                      "_expanded": true,
                      "events": {
                        "click": "Wb.open({\n  url: 'm?xwl=aml_monitor/KYC01010/client_preview',\n  params: {\n    CLIENT_ID: '_$client_id$_',\n    ORGAN_FLAG: '_$organ_flag$_',\n    CLIENT_STATUS: '_$client_status$_',\n    CLIENT_NAME: '_$client_name$_',\n    CLIENT_BELONG: '_$client_belong$_',\n    FK_FLAG: '_$fk_flag$_',\n    FLOW_CODE: '1'\n  },\n  title: '客户基本信息预览',\n  success(scope) {\n    //关闭当前预览窗口\n    if (app?.parentApp?.parentContainer) {\n      app.parentApp.parentContainer.close();\n    } else {\n      window.close();\n    }\n  }\n});\n"
                      }
                    },
                    {
                      "_icon": "button",
                      "text": "saveBtn1",
                      "cls": "Wb.Button",
                      "properties": {
                        "cid": "saveBtn1",
                        "text": "保存",
                        "type": "primary"
                      },
                      "hasDupCid": 0,
                      "events": {
                        "click": "// 保存\nconsole.log(\"app.mainContainer.vue.basicInfo\", app.mainContainer.vue.basicInfo);\n\nif (!app.mainContainer.vue.basicInfo.client_name) {\n  Wb.tipError(\"客户名称不能为空！\");\n  return;\n}\n\nlet fileList1 = app.mainContainer.vue.attachmentList.communication;\nlet fileList2 = app.mainContainer.vue.attachmentList.agree;\nlet fileList3 = app.mainContainer.vue.attachmentList.other;\n\n// 个人\nif ('_$organ_flag$_' === '0') {\n  let form1 = app.mainContainer.vue.ruleForm2;\n  let form2 = app.mainContainer.vue.ruleForm3;\n  Wb.ajax({\n    url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/update_client',\n    params: {\n      // ruleForm2\n      CLIENT_ID: '_$client_id$_',\n      CLIENT_NAME: form1.client_name,\n      ORGAN_FLAG: '_$organ_flag$_',\n      ID_TYPE: form1.id_type,\n      ID_NO: form1.id_no,\n      ID_BEGINDATE: form1.id_begindate,\n      ID_ENDDATE: form1.id_enddate,\n      CLIENT_BELONG: '1',//('_$client_belong$_' == '融资端' || '_$client_belong$_' == '1') ? '1' : '2',\n      NATIONALITY: form1.nationality,\n      BIRTHDAY: form1.birthday,\n      INDUSTRY_TYPE: form1.industry_type,\n      INDUSTRY_NAME: form1.industry_name,\n      TEL: form1.tel,\n      IS_OBJECT_REPORT: '工作室主体',//工作室主体/非工作室主体填报（默认为工作室主体）\n      ASSOCIATED_DATE: form1.associated_date,\n      REMARK: form1.remark,\n      CREATE_USER: '_$sys.username$_',\n      CREATE_TIME: '',\n      UPDATE_USER: '_$sys.username$_',\n      UPDATE_TIME: '',\n      WORK_TYPE: '1',// 0创建 1确认 2更新\n      CLIENT_STATUS: app.mainContainer.vue.basicInfo.client_status, //'_$client_status$_',// 0正常 1失效 2强限制 3弱限制\n      DATA_STATUS: '_$data_type$_' || '1',// 0草稿 1正式\n      GENDER: form1.gender,\n      INCOME: form1.income,\n      PROFESSION_CODE: form1.profession_code,// 职业分类\n      ID_ADDRESS: form1.id_address,// 证件地址\n      PROVINCE1: form1.province1 ? app.formatAddress(app.mainContainer.vue.proOptions, form1.province1) : form1.province1,\n      CITY1: form1.city1 ? app.formatAddress(app.mainContainer.vue.cityOptions1, form1.city1) : form1.city1,\n      DISTRICT1: form1.district1 ? app.formatAddress(app.mainContainer.vue.districtOptions1, form1.district1) : form1.district1,\n      ADDRESS: form1.address,// 联系地址\n      PROVINCE2: form1.province2 ? app.formatAddress(app.mainContainer.vue.proOptions, form1.province2) : form1.province2,\n      CITY2: form1.city2 ? app.formatAddress(app.mainContainer.vue.cityOptions2, form1.city2) : form1.city2,\n      DISTRICT2: form1.district2 ? app.formatAddress(app.mainContainer.vue.districtOptions2, form1.district2) : form1.district2,\n      // ruleForm3\n      IS_SPECIAL: form2.is_special,\n      CLIENT_TYPE: form2.client_type ? form2.client_type.join(',') : null,\n      CLIENT_TYPE_OTHER: form2.client_type_other,\n      SPECIAL_MATTERS: form2.special_matters ? form2.special_matters.join(',') : null,\n      MISSING_INFORMATION: form2.missing_information,\n      MISSING_DRAFT: form2.missing_draft,\n      SPECIAL_MATTERS_OTHER: form2.special_matters_other,\n      SPECIAL_REASON: form2.special_reason,\n      COMPLETED_CDD: form2.completed_cdd,\n      LOW_RISK_EXPLANATION: form2.low_risk_explanation,\n      TAKE_MEASURES: form2.take_measures,\n      // 反洗钱特殊情况部分附件object_id\n      COMMUNICATION_RECORDS: (fileList1.length > 0) ? ('_$client_id$_' + 'communication') : '',\n      AGREE_RECORDS: (fileList2.length > 0) ? ('_$client_id$_' + 'agree') : '',\n      OTHER_RECORDS: (fileList3.length > 0) ? ('_$client_id$_' + 'other') : '',\n      CLIENT_BELONG1: '_$client_belong$_',\n      OP_FLAG: 'save'\n    },\n    success(resp) {\n      let res = Wb.decode(resp);\n      if (res.O_RETURN_CODE === '0') {\n        Wb.tipSucc(\"保存成功\");\n      } else {\n        Wb.tipError(res.O_RETURN_MSG);\n      }\n    }\n  });\n} else {\n  // 机构\n  let form1 = app.mainContainer.vue.ruleForm1;\n  let form2 = app.mainContainer.vue.ruleForm3;\n  // // 从数据库中删除需要删除的关联人\n  // let deleteRelatedInfo = app.mainContainer.vue.deleteRelatedInfo;\n  // for(let i = 0;i<deleteRelatedInfo.length;i++){\n  //   // 执行数据库删除\n  //   app.mainContainer.vue.deleteFromDB(deleteRelatedInfo[i]);\n  // }\n  Wb.ajax({\n    url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/update_client',\n    params: {\n      CLIENT_ID: '_$client_id$_',\n      CLIENT_NAME: form1.client_name,\n      ORGAN_FLAG: '_$organ_flag$_',\n      ID_TYPE: form1.id_type,\n      ID_NO: form1.id_no,\n      ID_BEGINDATE: form1.id_begindate,\n      ID_ENDDATE: form1.id_enddate,\n      CLIENT_BELONG: '1',//('_$client_belong$_' == '融资端' || '_$client_belong$_' == '1') ? '1' : '2',\n      OFFICE_ADDRESS: form1.office_address,// 办公地址\n      PROVINCE: form1.province ? app.formatAddress(app.mainContainer.vue.proOptions, form1.province) : form1.province,\n      CITY: form1.city ? app.formatAddress(app.mainContainer.vue.cityOptions, form1.city) : form1.city,\n      DISTRICT: form1.district ? app.formatAddress(app.mainContainer.vue.districtOptions, form1.district) : form1.district,\n      REGISTER_COUNTRY: form1.register_country,\n      REGISTER_MONEY_TYPE: (form1.register_money_type == '-') ? '' : (!isNaN(form1.register_money_type.trim()) ? app.formatMoneyType(app.data.selectList.register_money_type_list, form1.register_money_type) : form1.register_money_type),//form1.register_money_type,\n      REGISTER_FUND: (form1.register_fund && form1.register_fund != 'null') ? String(form1.register_fund).replace(/,/g, '') : form1.register_fund,\n      INDUSTRY_TYPE: form1.industry_type,\n      INDUSTRY_NAME: form1.industry_name,\n      TEL: form1.tel,\n      SETUP_DATE: form1.setup_date,\n      BUSI_SCOPE: form1.busi_scope,\n      IS_OBJECT_REPORT: '工作室主体',// 工作室主体/非主体填报（默认工作室主体）\n      ASSOCIATED_DATE: form1.associated_date,// 建立业务关系日期\n      REMARK: form1.remark,// 备注\n      CREATE_USER: '_$sys.username$_',\n      CREATE_TIME: '',\n      UPDATE_USER: '_$sys.username$_',\n      UPDATE_TIME: '',\n      WORK_TYPE: '1',// 0创建 1更新 2确认\n      CLIENT_STATUS: app.mainContainer.vue.basicInfo.client_status,// 0正常 1失效 2强限制 3弱限制\n      DATA_STATUS: '_$data_type$_' || '1',// 0草稿 1正式\n      // ruleForm3\n      IS_SPECIAL: form2.is_special,\n      CLIENT_TYPE: form2.client_type ? form2.client_type.join(',') : null,\n      CLIENT_TYPE_OTHER: form2.client_type_other,\n      SPECIAL_MATTERS: form2.special_matters ? form2.special_matters.join(',') : null,\n      MISSING_INFORMATION: form2.missing_information,\n      MISSING_DRAFT: form2.missing_draft,\n      SPECIAL_MATTERS_OTHER: form2.special_matters_other,\n      SPECIAL_REASON: form2.special_reason,\n      COMPLETED_CDD: form2.completed_cdd,\n      LOW_RISK_EXPLANATION: form2.low_risk_explanation,\n      TAKE_MEASURES: form2.take_measures,\n      // 反洗钱特殊情况部分附件object_id\n      COMMUNICATION_RECORDS: (fileList1.length > 0) ? ('_$client_id$_' + 'communication') : '',\n      AGREE_RECORDS: (fileList2.length > 0) ? ('_$client_id$_' + 'agree') : '',\n      OTHER_RECORDS: (fileList3.length > 0) ? ('_$client_id$_' + 'other') : '',\n      CLIENT_BELONG1: '_$client_belong$_',\n      OP_FLAG: 'save'\n    },\n    success(resp) {\n      let res = Wb.decode(resp);\n      if (res.O_RETURN_CODE === '0') {\n        Wb.tipSucc(\"保存成功\");\n        app.mainContainer.vue.getBasicInfo('_$client_id$_');\n        app.mainContainer.vue.getRelatedInfo('_$client_id$_', '1');\n        app.mainContainer.vue.getRelatedInfo('_$client_id$_', '2');\n        app.mainContainer.vue.getRelatedInfo('_$client_id$_', '3');\n        app.mainContainer.vue.getRelatedInfo('_$client_id$_', '4');\n        app.mainContainer.vue.getRelatedInfo('_$client_id$_', '5');\n      } else {\n        Wb.tipError(res.O_RETURN_MSG);\n      }\n    }\n  });\n}"
                      },
                      "_expanded": true
                    },
                    {
                      "_icon": "button",
                      "text": "saveBtn",
                      "cls": "Wb.Button",
                      "properties": {
                        "cid": "saveBtn",
                        "text": "提交并关闭页面",
                        "type": "primary"
                      },
                      "hasDupCid": 0,
                      "events": {
                        "click": "// 提交\nconsole.log(\"app.mainContainer.vue.basicInfo\", app.mainContainer.vue.basicInfo);\n\nvar html = '<div class=\"submit-confirm\"><h5>请确认：</h5>' +\n  '<p>打印提交的客户基本信息表请客户签字、盖章以确认无误，并做为底稿留存；</p>' +\n  '<p>项目组的底稿资料还需包含但不限于非自然人客户的注册证书、公司章程、合伙协议等可以验证客户身份信息的文件；</p>' +\n  '<p>底稿资料需包含非自然人客户股东或者董事会成员登记信息，主要包括：董事会、高级管理层和股东名单、各股东持股数量以及持股类型（包括相关的投票权类型）等；</p>' +\n  '<p>底稿资料需包含客户法定代表人、授权代表（如适用）和受益所有人的身份证明文件复印件、授权文件（如适用）；</p>' +\n  '<p>底稿资料需包含登陆全国企业信用信息公示系统、交易所网站等查询获取的公开信息；</p>' +\n  '<p>底稿资料已单独建立子目录留存相关底稿，同时将电子版上传底稿网盘。</p></div>';\n\nconst today = new Date();\nconst year = today.getFullYear();\nconst month = String(today.getMonth() + 1).padStart(2, '0');\nconst day = String(today.getDate()).padStart(2, '0');\n\n// 调用投行数据接口\nfunction call_reback(key, certNo) {\n  Wb.ajax({\n    url: 'm?xwl=interface/customerInfoCheck/call_reback',\n    async: false,\n    params: {\n      i_key: key,\n      i_cert_no: certNo,\n      i_usercode: '_$cur_user$_'\n    },\n    success(resp) {\n      let res = Wb.decode(resp);\n      if (res.code == '200') {\n        Wb.tipSucc(\"工作室状态已更新\");\n      } else {\n        Wb.tipError(\"更新工作室项目状态失败：\" + res.msg)\n      }\n    },\n    failure(resp) {\n      let res = Wb.decode(resp);\n      Wb.tipError(\"更新工作室项目状态失败\")\n    }\n  });\n}\n\nWb.confirm(html, function () {\n  let succ = app.mainContainer.vue.submit();// 先校验\n  let fileList1 = app.mainContainer.vue.attachmentList.communication;\n  let fileList2 = app.mainContainer.vue.attachmentList.agree;\n  let fileList3 = app.mainContainer.vue.attachmentList.other;\n\n  if (succ) {\n    // 个人\n    if ('_$organ_flag$_' === '0') {\n      console.log(\"app.mainContainer.vue.ruleForm2\", app.mainContainer.vue.ruleForm2);\n      console.log(\"app.mainContainer.vue.ruleForm3\", app.mainContainer.vue.ruleForm3);\n      let form1 = app.mainContainer.vue.ruleForm2;\n      let form2 = app.mainContainer.vue.ruleForm3;\n      Wb.ajax({\n        url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/update_client',\n        params: {\n          // ruleForm2\n          CLIENT_ID: '_$client_id$_',\n          CLIENT_NAME: form1.client_name,\n          ORGAN_FLAG: '_$organ_flag$_',\n          ID_TYPE: form1.id_type,\n          ID_NO: form1.id_no,\n          ID_BEGINDATE: form1.id_begindate ? String(form1.id_begindate).replace(/\\s.*$/, '') : '',\n          ID_ENDDATE: form1.id_enddate ? String(form1.id_enddate).replace(/\\s.*$/, '') : '',\n          CLIENT_BELONG: ('_$client_belong$_' == '融资端' || '_$client_belong$_' == '1') ? '1' : '2',\n          NATIONALITY: form1.nationality,\n          BIRTHDAY: form1.birthday,\n          INDUSTRY_TYPE: form1.industry_type,\n          INDUSTRY_NAME: form1.industry_name,\n          TEL: form1.tel,\n          IS_OBJECT_REPORT: '工作室主体',//工作室主体/非工作室主体填报（默认为工作室主体）\n          ASSOCIATED_DATE: form1.data_status === '0' ? `${year}-${month}-${day}` : form1.associated_date,\n          REMARK: form1.remark,\n          CREATE_USER: '_$sys.username$_',\n          CREATE_TIME: '',\n          UPDATE_USER: '_$sys.username$_',\n          UPDATE_TIME: '',\n          WORK_TYPE: '1',// 0创建 1更新 2确认\n          CLIENT_STATUS: app.mainContainer.vue.basicInfo.client_status,// 0正常 1失效 2强限制 3弱限制\n          DATA_STATUS: '1',//'_$data_type$_',// 0草稿 1正式\n          GENDER: form1.gender,\n          INCOME: form1.income,\n          PROFESSION_CODE: form1.profession_code,// 职业分类\n          ID_ADDRESS: form1.id_address,// 证件地址\n          PROVINCE1: app.formatAddress(app.mainContainer.vue.proOptions, form1.province1),\n          CITY1: app.formatAddress(app.mainContainer.vue.cityOptions1, form1.city1),\n          DISTRICT1: app.formatAddress(app.mainContainer.vue.districtOptions1, form1.district1),\n          ADDRESS: form1.address,// 联系地址\n          PROVINCE2: app.formatAddress(app.mainContainer.vue.proOptions, form1.province2),\n          CITY2: app.formatAddress(app.mainContainer.vue.cityOptions2, form1.city2),\n          DISTRICT2: app.formatAddress(app.mainContainer.vue.districtOptions2, form1.district2),\n          // ruleForm3\n          IS_SPECIAL: form2.is_special,\n          CLIENT_TYPE: form2.client_type ? form2.client_type.join(',') : null,\n          CLIENT_TYPE_OTHER: form2.client_type_other,\n          SPECIAL_MATTERS: form2.special_matters ? form2.special_matters.join(',') : null,\n          MISSING_INFORMATION: form2.missing_information,\n          MISSING_DRAFT: form2.missing_draft,\n          SPECIAL_MATTERS_OTHER: form2.special_matters_other,\n          SPECIAL_REASON: form2.special_reason,\n          COMPLETED_CDD: form2.completed_cdd,\n          LOW_RISK_EXPLANATION: form2.low_risk_explanation,\n          TAKE_MEASURES: form2.take_measures,\n          // 反洗钱特殊情况部分附件object_id\n          COMMUNICATION_RECORDS: (fileList1.length > 0) ? ('_$client_id$_' + 'communication') : '',\n          AGREE_RECORDS: (fileList2.length > 0) ? ('_$client_id$_' + 'agree') : '',\n          OTHER_RECORDS: (fileList3.length > 0) ? ('_$client_id$_' + 'other') : '',\n          CLIENT_BELONG1: '_$client_belong$_',\n          OP_FLAG: 'submit',\n          KEY: '_$key$_'\n        },\n        success(resp) {\n          let res = Wb.decode(resp);\n          if (res.O_RETURN_CODE === '0') {\n            Wb.tipSucc(\"保存成功\");\n            // 如果是从工作室打开的填报表单，提交后需要调用工作室接口\n            let key = '_$key$_';\n            if (key) {\n              call_reback('_$key$_', form1.id_no)\n            }\n            if (app?.parentApp?.parentContainer) {\n              app.parentApp.parentContainer.close();\n            } else {\n              window.close();\n            }\n          } else {\n            Wb.tipError(res.O_RETURN_MSG);\n          }\n        }\n      });\n    } else {\n      // 机构\n      console.log(\"app.mainContainer.vue.ruleForm1\", app.mainContainer.vue.ruleForm1);\n      let form1 = app.mainContainer.vue.ruleForm1;\n      let form2 = app.mainContainer.vue.ruleForm3;\n\n      Wb.ajax({\n        url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/update_client',\n        params: {\n          CLIENT_ID: '_$client_id$_',\n          CLIENT_NAME: form1.client_name,\n          ORGAN_FLAG: '_$organ_flag$_',\n          ID_TYPE: form1.id_type,\n          ID_NO: form1.id_no,\n          ID_BEGINDATE: form1.id_begindate ? String(form1.id_begindate).replace(/\\s.*$/, '') : '',\n          ID_ENDDATE: form1.id_enddate ? String(form1.id_enddate).replace(/\\s.*$/, '') : '',\n          CLIENT_BELONG: ('_$client_belong$_' == '融资端' || '_$client_belong$_' == '1') ? '1' : '2',\n          OFFICE_ADDRESS: form1.office_address,// 办公地址\n          PROVINCE: app.formatAddress(app.mainContainer.vue.proOptions, form1.province),\n          CITY: app.formatAddress(app.mainContainer.vue.cityOptions, form1.city),\n          DISTRICT: app.formatAddress(app.mainContainer.vue.districtOptions, form1.district),\n          REGISTER_COUNTRY: form1.register_country,\n          REGISTER_MONEY_TYPE: (form1.register_money_type == '-') ? '' : (!isNaN(form1.register_money_type.trim()) ? app.formatMoneyType(app.data.selectList.register_money_type_list, form1.register_money_type) : form1.register_money_type),//form1.register_money_type,//!isNaN(form1.register_money_type.trim()) ? app.formatMoneyType(app.data.selectList.register_money_type_list,form1.register_money_type) : form1.register_money_type,\n          REGISTER_FUND: (form1.register_fund && form1.register_fund != 'null') ? String(form1.register_fund).replace(/,/g, '') : '',\n          INDUSTRY_TYPE: form1.industry_type,\n          INDUSTRY_NAME: form1.industry_name,\n          TEL: form1.tel,\n          SETUP_DATE: form1.setup_date ? String(form1.setup_date).replace(/\\s.*$/, '') : '',\n          BUSI_SCOPE: form1.busi_scope,\n          IS_OBJECT_REPORT: '工作室主体',// 工作室主体/非主体填报（默认工作室主体）\n          ASSOCIATED_DATE: form1.data_status === '0' ? `${year}-${month}-${day}` : form1.associated_date,// 建立业务关系日期\n          REMARK: form1.remark,// 备注\n          CREATE_USER: '_$sys.username$_',\n          CREATE_TIME: '',\n          UPDATE_USER: '_$sys.username$_',\n          UPDATE_TIME: '',\n          WORK_TYPE: '1',// 0创建 1更新 2确认\n          CLIENT_STATUS: app.mainContainer.vue.basicInfo.client_status,// 0正常 1失效 2强限制 3弱限制\n          DATA_STATUS: '1',//'_$data_type$_',// 0草稿 1正式\n          // ruleForm3\n          IS_SPECIAL: form2.is_special,\n          CLIENT_TYPE: form2.client_type ? form2.client_type.join(',') : null,\n          CLIENT_TYPE_OTHER: form2.client_type_other,\n          SPECIAL_MATTERS: form2.special_matters ? form2.special_matters.join(',') : null,\n          MISSING_INFORMATION: form2.missing_information,\n          MISSING_DRAFT: form2.missing_draft,\n          SPECIAL_MATTERS_OTHER: form2.special_matters_other,\n          SPECIAL_REASON: form2.special_reason,\n          COMPLETED_CDD: form2.completed_cdd,\n          LOW_RISK_EXPLANATION: form2.low_risk_explanation,\n          TAKE_MEASURES: form2.take_measures,\n          // 反洗钱特殊情况部分附件object_id\n          COMMUNICATION_RECORDS: (fileList1.length > 0) ? ('_$client_id$_' + 'communication') : '',\n          AGREE_RECORDS: (fileList2.length > 0) ? ('_$client_id$_' + 'agree') : '',\n          OTHER_RECORDS: (fileList3.length > 0) ? ('_$client_id$_' + 'other') : '',\n          CLIENT_BELONG1: '_$client_belong$_',\n          OP_FLAG: 'submit',\n          KEY: '_$key$_'\n        },\n        success(resp) {\n          let res = Wb.decode(resp);\n          if (res.O_RETURN_CODE === '0') {\n            Wb.tipSucc(\"提交成功\");\n            // 调用工作室接口\n            let key = '_$key$_';\n            if (key) {\n              call_reback('_$key$_', form1.id_no);\n            }\n            if (app?.parentApp?.parentContainer) {\n              app.parentApp.parentContainer.close();\n            } else {\n              window.close();\n            }\n          } else {\n            Wb.tipError(res.O_RETURN_MSG);\n          }\n        }\n      });\n    }\n  }\n}, null, true)\n\n"
                      }
                    },
                    {
                      "_icon": "button",
                      "text": "exportBtn",
                      "cls": "Wb.Button",
                      "properties": {
                        "cid": "exportBtn",
                        "text": "PDF导出"
                      },
                      "_expanded": true,
                      "events": {
                        "click": "app.mainContainer.vue.downloadPdf();\n"
                      }
                    }
                  ]
                },
                {
                  "_icon": "container",
                  "text": "NewBnfDialogPanel",
                  "cls": "Wb.Container",
                  "properties": {
                    "cid": "NewBnfDialogPanel",
                    "visible": "false",
                    "html": "<div class=\"new-bnf-dialog\">\n  <!-- 6 新版受益所有人 带bomis核验功能 -->\n  <el-dialog :title=\"bomisParams.editBomisForm.title\" :visible.sync=\"bomisParams.dialogBomisVisible\" width=\"80%\"\n    :close-on-click-modal=\"false\" @close=\"closeDialog('bomisDialog')\" custom-class=\"benefit-scroll-dialog\">\n    <div>\n      <el-form :model=\"bomisParams.editBomisForm\" ref=\"editBenefitForm\" :rules=\"bomisParams.editBomisFormRules\"\n        label-width=\"280px\" label-position=\"top\"\n        :class=\"['register-form', {'hide-required-mark': shouldHideRequiredMark}]\" :hide-required-asterisk=\"false\"\n        size=\"mini\">\n        <el-row :gutter=\"24\">\n          <el-col :span=\"8\">\n            <el-form-item label=\"受益所有人\" prop=\"bo_type\" class=\"always-show-required\">\n              <el-select clearable v-model=\"bomisParams.editBomisForm.bo_type\" placeholder=\"请选择\" class=\"formitem-full-width formitem-max-width\" @change=\"bomisBoTypeChange\">\n                <el-option v-for=\"item in selectList.benefit_flag_list\" :key=\"item.k\" :label=\"item.v\" :value=\"item.k\">\n                </el-option>\n              </el-select>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <el-form-item label=\"企业性质\" prop=\"company_type\" class=\"always-show-required\">\n              <el-select clearable v-model=\"bomisParams.editBomisForm.company_type\" placeholder=\"请选择\" @change=\"bomisCompanyTypeChange\"\n                class=\"formitem-full-width formitem-max-width\">\n                <el-option v-for=\"item in bomisParams.benefit_company_no_list\" :key=\"item.k\" :label=\"item.v\"\n                  :value=\"item.k\"> </el-option>\n              </el-select>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"24\">\n            <el-form-item label=\"受益所有权类型\" prop=\"bnf_type\" class=\"always-show-required\">\n              <el-select clearable v-model=\"bomisParams.editBomisForm.bnf_type\" placeholder=\"请选择\" multiple\n                class=\"formitem-full-width formitem-24-max-width\" @change=\"bomisBnfTypeChange\">\n                <el-option v-for=\"item in bomisParams.bnf_type_new_list\" :key=\"item.k\" :label=\"item.v\" :value=\"item.k\" \n                :disabled=\"item.disabled === true\">\n                </el-option>\n              </el-select>\n            </el-form-item>\n          </el-col>\n        </el-row>\n        <!-- 持有股权、股份或者合伙权益 -->\n        <el-row :gutter=\"24\">\n          <el-col :span=\"8\" v-show=\"bomisParams.editBomisForm.bnf_type.includes('NA1') || bomisParams.editBomisForm.bnf_type.includes('NB1') ||bomisParams.editBomisForm.bnf_type.includes('ND1') \">\n            <el-form-item label=\"持有股权、股份或者合伙权益的比例（%)\"\n              prop=\"acthdrat\" class=\"always-show-required\">\n              <el-input type=\"number\" v-model=\"bomisParams.editBomisForm.acthdrat\" class=\"formitem-full-width formitem-max-width\">\n              </el-input>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\" v-show=\"bomisParams.editBomisForm.bnf_type.includes('NA1') || bomisParams.editBomisForm.bnf_type.includes('NB1') ||bomisParams.editBomisForm.bnf_type.includes('ND1') \">\n            <div style=\"height:28px;line-height:28px;font-size:14px;color:#606266;\">\n              <span v-show=\"bomisParams.editBomisForm.bnf_type.includes('NA1')\">形成日期(股权、股份) </span>\n              <span v-show=\"bomisParams.editBomisForm.bnf_type.includes('NB1')\">形成日期(合伙权益) </span>\n              <span v-show=\"bomisParams.editBomisForm.bnf_type.includes('ND1')\">形成日期(股权、份额) </span>\n              <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n              <span style=\"color:#F56C6C;font-size:12px;\">如需手动填写，请按照“1990-01-01”的格式填写</span>\n            </div>\n            <el-form-item prop=\"shareratiostartdate\">\n              <el-date-picker v-model=\"bomisParams.editBomisForm.shareratiostartdate\" type=\"date\" placeholder=\"选择日期\"\n                format=\"yyyy-MM-dd\" clearable editable class=\"formitem-full-width formitem-max-width\" />\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\" v-show=\"bomisParams.editBomisForm.bnf_type.includes('NA1') || bomisParams.editBomisForm.bnf_type.includes('NB1') ||bomisParams.editBomisForm.bnf_type.includes('ND1') \">\n            <div style=\"height:28px;line-height:28px;font-size:14px;color:#606266;\">\n              终止日期(股权、股份)\n              <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n              <span style=\"color:#F56C6C;font-size:12px;\">如需手动填写，请按照“1990-01-01”的格式填写</span>\n            </div>\n            <el-form-item prop=\"shareratioenddate\">\n              <el-date-picker v-model=\"bomisParams.editBomisForm.shareratioenddate\" type=\"date\" placeholder=\"选择日期\"\n                format=\"yyyy-MM-dd\" clearable editable class=\"formitem-full-width formitem-max-width\" />\n            </el-form-item>\n          </el-col>\n        </el-row>\n        <el-row :gutter=\"24\">\n        </el-row>\n        <!-- 收益权 -->\n        <el-row :gutter=\"24\">\n          <el-col :span=\"8\" v-show=\"bomisParams.editBomisForm.bnf_type.includes('NA2-1')\">\n            <el-form-item label=\"持有收益权的比例(%)\"\n              prop=\"actownerprofitratio\" class=\"always-show-required\">\n              <el-input type=\"number\" v-model=\"bomisParams.editBomisForm.actownerprofitratio\" class=\"formitem-full-width formitem-max-width\">\n              </el-input>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\" v-show=\"bomisParams.editBomisForm.bnf_type.includes('NA2-1')\">\n            <div style=\"height:28px;line-height:28px;font-size:14px;color:#606266;\">\n              形成日期(收益权)\n              <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n              <span style=\"color:#F56C6C;font-size:12px;\">如需手动填写，请按照“1990-01-01”的格式填写</span>\n            </div>\n            <el-form-item prop=\"profitratiostartdate\">\n              <el-date-picker v-model=\"bomisParams.editBomisForm.profitratiostartdate\" type=\"date\" placeholder=\"选择日期\"\n                format=\"yyyy-MM-dd\" clearable editable class=\"formitem-full-width formitem-max-width\" />\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\" v-show=\"bomisParams.editBomisForm.bnf_type.includes('NA2-1')\">\n            <div style=\"height:28px;line-height:28px;font-size:14px;color:#606266;\">\n              终止日期(收益权)\n              <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n              <span style=\"color:#F56C6C;font-size:12px;\">如需手动填写，请按照“1990-01-01”的格式填写</span>\n            </div>\n            <el-form-item prop=\"profitratioenddate\">\n              <el-date-picker v-model=\"bomisParams.editBomisForm.profitratioenddate\" type=\"date\" placeholder=\"选择日期\"\n                format=\"yyyy-MM-dd\" clearable editable class=\"formitem-full-width formitem-max-width\" />\n            </el-form-item>\n          </el-col>\n        </el-row>\n        <!-- 表决权 -->\n        <el-row :gutter=\"24\">\n          <el-col :span=\"8\" v-show=\"bomisParams.editBomisForm.bnf_type.includes('NA2-2')\">\n            <el-form-item label=\"持有表决权的比例(%)\"\n              prop=\"actownerprofitratiovote\" class=\"always-show-required\">\n              <el-input type=\"number\" v-model=\"bomisParams.editBomisForm.actownerprofitratiovote\"\n                class=\"formitem-full-width formitem-max-width\">\n              </el-input>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\" v-show=\"bomisParams.editBomisForm.bnf_type.includes('NA2-2')\">\n            <div style=\"height:28px;line-height:28px;font-size:14px;color:#606266;\">\n              形成日期(表决权)\n              <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n              <span style=\"color:#F56C6C;font-size:12px;\">如需手动填写，请按照“1990-01-01”的格式填写</span>\n            </div>\n            <el-form-item prop=\"profitratiovotestartdate\">\n              <el-date-picker v-model=\"bomisParams.editBomisForm.profitratiovotestartdate\" type=\"date\"\n                placeholder=\"选择日期\" format=\"yyyy-MM-dd\" clearable editable class=\"formitem-full-width formitem-max-width\" />\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\" v-show=\"bomisParams.editBomisForm.bnf_type.includes('NA2-2')\">\n            <div style=\"height:28px;line-height:28px;font-size:14px;color:#606266;\">\n              终止日期(表决权)\n              <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n              <span style=\"color:#F56C6C;font-size:12px;\">如需手动填写，请按照“1990-01-01”的格式填写</span>\n            </div>\n            <el-form-item prop=\"profitratiovoteenddate\">\n              <el-date-picker v-model=\"bomisParams.editBomisForm.profitratiovoteenddate\" type=\"date\" placeholder=\"选择日期\"\n                format=\"yyyy-MM-dd\" clearable editable class=\"formitem-full-width formitem-max-width\" />\n            </el-form-item>\n          </el-col>\n        </el-row>\n        <!-- 实际实施控制 -->\n        <el-row :gutter=\"24\">\n          <el-col :span=\"24\" v-show=\"bomisParams.editBomisForm.bnf_type.includes('NA3-1') || bomisParams.editBomisForm.bnf_type.includes('NA3-2')\">\n            <el-form-item prop=\"actctrltype\" label=\"实施实际控制的内容/方式\">\n              <el-select v-model=\"bomisParams.editBomisForm.actctrltype\" filterable placeholder=\"请选择\" clearable multiple\n                class=\"formitem-full-width formitem-24-max-width\">\n                <el-option v-for=\"item in selectList.benefit_actctrltype_list\" :key=\"item.k\" :label=\"item.v\"\n                  :value=\"item.k\">\n                </el-option>\n              </el-select>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"24\" v-show=\"bomisParams.editBomisForm.bnf_type.includes('NA3-2')\">\n            <el-form-item prop=\"actotherforms\" label=\"其他形式的具体内容\"\n              class=\"always-show-required\">\n              <el-input v-model=\"bomisParams.editBomisForm.actotherforms\" placeholder=\"请输入\" clearable\n                class=\"formitem-full-width formitem-24-max-width\">\n              </el-input>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\" v-show=\"bomisParams.editBomisForm.bnf_type.includes('NA3-1') || bomisParams.editBomisForm.bnf_type.includes('NA3-2')\">\n            <div style=\"height:28px;line-height:28px;font-size:14px;color:#606266;\">\n              形成日期(实施实际控制)\n              <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n              <span style=\"color:#F56C6C;font-size:12px;\">如需手动填写，请按照“1990-01-01”的格式填写</span>\n            </div>\n            <el-form-item prop=\"obtainactdate\">\n              <el-date-picker v-model=\"bomisParams.editBomisForm.obtainactdate\" type=\"date\" placeholder=\"选择日期\"\n                format=\"yyyy-MM-dd\" clearable editable class=\"formitem-full-width formitem-max-width\" />\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\" v-show=\"bomisParams.editBomisForm.bnf_type.includes('NA3-1') || bomisParams.editBomisForm.bnf_type.includes('NA3-2')\">\n            <div style=\"height:28px;line-height:28px;font-size:14px;color:#606266;\">\n              终止日期(实施实际控制)\n              <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n              <span style=\"color:#F56C6C;font-size:12px;\">如需手动填写，请按照“1990-01-01”的格式填写</span>\n            </div>\n            <el-form-item prop=\"obtainactdate\">\n              <el-date-picker v-model=\"bomisParams.editBomisForm.obtainactdate\" type=\"date\" placeholder=\"选择日期\"\n                format=\"yyyy-MM-dd\" clearable editable class=\"formitem-full-width formitem-max-width\" />\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\" v-show=\"bomisParams.editBomisForm.bnf_type.includes('NA3-1')\">\n            <el-form-item prop=\"actconuppermarket\" label=\"是否存在上一层备案主体\" class=\"always-show-required\">\n              <el-select v-model=\"bomisParams.editBomisForm.actconuppermarket\" filterable placeholder=\"请选择\" clearable\n                class=\"formitem-full-width formitem-max-width\">\n                <el-option v-for=\"item in selectList.benefit_yesno_list\" :key=\"item.k\" :label=\"item.v\" :value=\"item.k\">\n                </el-option>\n              </el-select>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\" v-show=\"bomisParams.editBomisForm.bnf_type.includes('NA3-1') && bomisParams.editBomisForm.actconuppermarket === 'Y'\">\n            <el-form-item prop=\"actconupperentname\" label=\"实际控制备案主体的上一层备案主体名称\" class=\"always-show-required\">\n              <el-input v-model=\"bomisParams.editBomisForm.actconupperentname\" placeholder=\"请输入\" clearable\n                class=\"formitem-full-width formitem-max-width\">\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\" v-show=\"bomisParams.editBomisForm.bnf_type.includes('NA3-1') && bomisParams.editBomisForm.actconuppermarket === 'Y'\">\n            <el-form-item prop=\"actconuniscid\" label=\"实际控制备案主体的统一社会信用代码\" class=\"always-show-required\">\n              <el-input v-model=\"bomisParams.editBomisForm.actconuniscid\" placeholder=\"请输入\" clearable\n                class=\"formitem-full-width formitem-max-width\">\n            </el-form-item>\n          </el-col>\n        </el-row>\n        <!-- 负责日常经营管理 -->\n        <el-row :gutter=\"24\">\n          <el-col :span=\"16\" v-show=\"bomisParams.editBomisForm.bnf_typ