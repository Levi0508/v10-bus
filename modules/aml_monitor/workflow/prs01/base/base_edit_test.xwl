n-download\" @click=\"handleDownload(scope.row)\"></el-button>\n                  </el-tooltip>\n                </div>\n              </template>\n            </el-table-column>\n          </el-table>\n          <!-- 上传按钮 -->\n          <div class=\"upload-add\">\n            <div class=\"upload-demo\">\n              <el-button type=\"text\" icon=\"el-icon-plus\" @click=\"openFileDialog(51)\">添加</el-button>\n            </div>\n          </div>\n        </div>\n      </el-card>\n      <!--受益所有人-->\n      <el-card class=\"box-card\" :name=\"'beneficialOwner'+this._uid\" v-if=\"organ_flag=='1'\">\n        <div slot=\"header\" class=\"clearfix\">\n          <span>客户受益所有人信息</span>\n          <el-button type=\"text\" icon=\"el-icon-plus\" class=\"add-btn\" @click=\"showDialog('1',{},'5')\">添加</el-button>\n          <el-button v-if=\"_$showBomisBtn$_ === true\" type=\"text\" icon=\"el-icon-plus\" class=\"add-btn\" @click=\"showDialog('1',{},'bomis')\">受益所有人核验(新版)\n          </el-button>\n        </div>\n        <div v-if=\"relatedInfo5.length==0\" style=\"color:#8d8b8b;text-align:center\">暂无数据</div>\n        <el-card v-for=\"item in relatedInfo5\" :key=\"item.related_id\" style=\"margin-bottom:10px;\"\n          :class=\"{ 'highlight-border': item.data_status === '0' }\" class=\"relat-card\">\n          <div class=\"client-info\">\n            <div class=\"client-title\">\n              <div>\n                <span>{{item.related_name|| '-'}}</span>\n                <el-tag type=\"success\" effect=\"dark\" size=\"mini\" style=\"margin-left: 10px;\"\n                  v-if=\"item.organ_flag!=='1'\">\n                  自然人</el-tag>\n                <el-tag type=\"\" effect=\"dark\" size=\"mini\" style=\"margin-left: 10px;\" v-if=\"item.organ_flag==='1'\">法人\n                </el-tag>\n              </div>\n              <div>\n                <el-tag type=\"danger\" effect=\"plain\" size=\"mini\" style=\"margin-left: 10px;\"\n                  v-if=\"item.data_status==='0'\">数据已变更 请点击表单“保存”或“提交并关闭页面”按钮保存当前草稿数据\n                </el-tag>\n              </div>\n            </div>\n\n            <el-row :gutter=\"10\" class=\"info-row\">\n              <div class=\"info-row-flex\" v-if=\"item.organ_flag==='1'\"><label>国家或地区</label>\n                <div>{{formatDictMap('nationality_list',item.nationality)|| '-'}}</div>\n              </div>\n              <div class=\"info-row-flex\" v-if=\"item.organ_flag==='0'\"><label>国籍</label>\n                <div>{{formatDictMap('nationality_list',item.nationality)|| '-'}}</div>\n              </div>\n              <div class=\"info-row-flex\"><label>证件类型</label>\n                <div>{{formatDictMap('id_type_list',item.id_type)|| '-'}}</div>\n              </div>\n              <div class=\"info-row-flex\"><label>证件号码</label>\n                <div>{{item.id_no|| '-'}}</div>\n              </div>\n            </el-row>\n\n            <el-row :gutter=\"10\" class=\"info-row\">\n              <div class=\"info-row-flex\"><label>证件有效期起始</label>\n                <div>{{item.id_begindate|| '-'}}</div>\n              </div>\n              <div class=\"info-row-flex\"><label>证件有效期截止</label>\n                <div>{{item.id_enddate|| '-'}}</div>\n              </div>\n              <div class=\"info-row-flex\"><label>出生年月</label>\n                <div>{{item.birthday|| '-'}}</div>\n              </div>\n            </el-row>\n\n            <el-row :gutter=\"10\" class=\"info-row\">\n              <div class=\"info-row-flex\"><label>受益所有人类型</label>\n                <div>{{formatDictMap('beneficiary_list',item.beneficiary)|| '-'}}</div>\n              </div>\n              <div class=\"info-row-flex\"><label>股权/表决权比例</label>\n                <div>{{item.shareholding_ratio?(item.shareholding_ratio+'%'): '-'}}</div>\n              </div>\n              <div class=\"info-row-flex\"><label>联系地址</label>\n                <div>{{item.address|| '-'}}</div>\n              </div>\n            </el-row>\n          </div>\n          <!-- 操作按钮 -->\n          <div class=\"attachment-footer\">\n            <el-button type=\"text\" @click=\"deleteRalated(item)\">删除</el-button>\n            <el-button type=\"text\" @click=\"showDialog('2',item,'5')\">编辑</el-button>\n          </div>\n        </el-card>\n        <!-- 附件信息表 -->\n        <div style=\"padding-top:10px;\">\n          <span>附件信息</span>\n          <el-tooltip class=\"item\" effect=\"dark\" placement=\"right\">\n          </el-tooltip>\n          <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n          <span style=\"color:#F56C6C;font-size:14px;\">请上传受益所有人的身份证明文件的复印件；确认受益所有人的证明文件，包括但不限于股权架构图、公司章程、委托持股协议、一致行动协议、表决权差异安排协议、任命文件等；关于股权/表决权等比例计算的说明（如涉及比例）；在受益所有人信息查询管理系统（BOMIS系统）备案的信息截图（如有）</span>\n          <el-table :data=\"attachmentList.beneficialOwner\" border style=\"width: 100%;margin-top:10px;\"\n            :default-sort=\"{prop: 'date', order: 'descending'}\">\n            <el-table-column prop=\"name\" label=\"附件名称\" sortable>\n              <template slot-scope=\"scope\">\n                <el-button type=\"text\" @click=\"handlePreview(scope.row)\" class=\"attachment-btn\">\n                  {{ scope.row.name }}\n                </el-button>\n              </template>\n            </el-table-column>\n            <el-table-column prop=\"extension\" label=\"附件类型\" width=\"120\" />\n            <el-table-column prop=\"create_time\" label=\"上传时间\" width=\"160\" sortable />\n            <el-table-column prop=\"file_size\" label=\"附件大小\" width=\"120\" sortable>\n              <template slot-scope=\"scope\">\n                {{ formatSize(scope.row.file_size) }}\n              </template>\n            </el-table-column>\n            <el-table-column prop=\"create_by\" label=\"上传人\" width=\"120\" sortable />\n            <el-table-column label=\"操作\" width=\"150\" fixed=\"right\">\n              <template slot-scope=\"scope\">\n                <div class=\"operation-buttons\">\n                  <el-tooltip content=\"预览\">\n                    <el-button type=\"text\" class=\"el-icon-view\" @click=\"handlePreview(scope.row)\"></el-button>\n                  </el-tooltip>\n                  <el-tooltip content=\"下载\">\n                    <el-button type=\"text\" class=\"el-icon-download\" @click=\"handleDownload(scope.row)\"></el-button>\n                  </el-tooltip>\n                </div>\n              </template>\n            </el-table-column>\n          </el-table>\n          <!-- 上传按钮 -->\n          <div class=\"upload-add\">\n            <div class=\"upload-demo\">\n              <el-button type=\"text\" icon=\"el-icon-plus\" @click=\"openFileDialog(61)\">添加</el-button>\n            </div>\n          </div>\n        </div>\n      </el-card>\n      <!--底部声明-->\n      <el-card>\n        <!-- 标题行 -->\n        <div slot=\"header\">\n          <span class=\"card-title\" v-if=\"organ_flag=='1'\">声明：本机构保证所提供资料的真实性、准确性、完整性、有效性，并对其承担责任；\n                如上述内容发生变更时将及时以书面方式通知贵公司，如因为不能及时完成变更由此产生的一切后果将由本机构承担。<br><br>\n            机构盖章：</span>\n          <span class=\"card-title\" v-if=\"organ_flag==='0'\">声明：本人保证前述所填信息以及所提供资料的真实性、准确性、完整性、有效性，并对其承担责任；\n            如上述内容发生变更时将及时以书面方式通知贵公司，如因为不能及时完成变更由此产生的一切后果将由本人承担。<br><br>\n            签名：<br></span>\n        </div>\n        <div>\n          <el-form label-width=\"140px\" v-if=\"organ_flag==='1'\">\n            <el-form-item label=\"建立业务关系日期\" prop=\"associated_date\">\n              <el-date-picker type=\"date\" placeholder=\"选择日期\" v-model=\"ruleForm1.associated_date\" disabled>\n              </el-date-picker><span style=\"color:#F56C6C;\">&nbsp;&nbsp;提交后不可更改，请谨慎填写！</span>\n            </el-form-item>\n            <el-form-item label=\"备注\" prop=\"remark\">\n              <el-input type=\"textarea\" style=\"width:100%\" v-model=\"ruleForm1.remark\"></el-input>\n            </el-form-item>\n          </el-form>\n          <el-form label-width=\"140px\" v-if=\"organ_flag==='0'\">\n            <el-form-item label=\"建立业务关系日期\" prop=\"associated_date\">\n              <el-date-picker type=\"date\" placeholder=\"选择日期\" v-model=\"ruleForm2.associated_date\" disabled>\n              </el-date-picker><span style=\"color:#F56C6C;\">&nbsp;&nbsp;提交后不可更改，请谨慎填写！</span>\n            </el-form-item>\n            <el-form-item label=\"备注\" prop=\"remark\">\n              <el-input type=\"textarea\" style=\"width:100%\" v-model=\"ruleForm2.remark\"></el-input>\n            </el-form-item>\n          </el-form>\n        </div>\n      </el-card>\n      <!--pdf导出 境内外区分-->\n      <el-card v-show=\"false\" class=\"box-card\">\n        <div :id=\"'pdf-container'+this._uid\" style=\"width:100%;font-size:24px;\">\n          <h2 class=\"pdf-section-title\">客户基本信息</h2>\n          <div class=\"info-div\" v-if=\"organ_flag=='1'\">\n            <div class=\"table-row\">\n              <div class=\"cell-label col-3\">客户名称</div>\n              <div class=\"cell-value col-5\">{{basicInfo.client_name || '-'}}</div>\n              <div class=\"cell-label col-3\">办公住所</div>\n              <div class=\"cell-value col-13 long-text\">\n                {{basicInfo.province || ''}}{{basicInfo.city || ''}}{{basicInfo.district ||\n                ''}}{{basicInfo.office_address || '-'}}\n              </div>\n            </div>\n            <div class=\"table-row\">\n              <div class=\"cell-label col-3\">国家或地区</div>\n              <div class=\"cell-value col-5\">{{ basicInfo.register_country ?\n                formatDictMap('nationality_list',basicInfo.register_country) : '-'}}</div>\n              <div class=\"cell-label col-3\">注册资本金币种</div>\n              <div class=\"cell-value col-5\">\n                {{ Number(basicInfo.register_money_type) == basicInfo.register_money_type ?\n                formatDictMap('register_money_type_list', basicInfo.register_money_type) :\n                (basicInfo.register_money_type || '-') }}\n              </div>\n              <div class=\"cell-label col-3\">注册资本金</div>\n              <div class=\"cell-value col-5\">{{basicInfo.register_fund || '-'}}万元</div>\n            </div>\n\n            <!-- 第三行 -->\n            <div class=\"table-row\">\n              <div class=\"cell-label col-3\" v-if=\"basicInfo.industry_type!='26'\">行业分类</div>\n              <div class=\"cell-value col-5\" v-if=\"basicInfo.industry_type!='26'\">\n                {{basicInfo.industry_type?formatDictMap('industry_type_list',basicInfo.industry_type): '-'}}\n              </div>\n              <div class=\"cell-label col-2\" v-if=\"basicInfo.industry_type=='26'\">行业分类</div>\n              <div class=\"cell-value col-2\" v-if=\"basicInfo.industry_type=='26'\">\n                {{basicInfo.industry_type?formatDictMap('industry_type_list',basicInfo.industry_type): '-'}}\n              </div>\n              <div class=\"cell-label col-2\" v-if=\"basicInfo.industry_type=='26'\">请注明</div>\n              <div class=\"cell-value col-2\" v-if=\"basicInfo.industry_type=='26'\">\n                {{basicInfo.industry_name}}\n              </div>\n              <div class=\"cell-label col-3\">成立日期</div>\n              <div class=\"cell-value col-5\">{{basicInfo.setup_date || '-'}}</div>\n              <div class=\"cell-label col-3\">联系电话</div>\n              <div class=\"cell-value col-5\">{{basicInfo.tel || '-'}}</div>\n            </div>\n\n            <!-- 第四行 -->\n            <div class=\"table-row\">\n              <div class=\"cell-label col-3\">证件类型</div>\n              <div class=\"cell-value col-5\">{{basicInfo.id_type?formatDictMap('id_type_list',basicInfo.id_type):'-'}}\n              </div>\n              <div class=\"cell-label col-3\">证件号码</div>\n              <div class=\"cell-value col-5\">{{basicInfo.id_no || '-'}}</div>\n              <div class=\"cell-label col-3\">证件有效期</div>\n              <div class=\"cell-value col-5\">{{basicInfo.id_begindate || '-'}}至{{basicInfo.id_enddate || '-'}}</div>\n            </div>\n            <div class=\"table-row\">\n              <div class=\"cell-label col-3\">经营范围</div>\n              <div class=\"cell-value col-21 long-text\">{{basicInfo.busi_scope || '-'}}</div>\n            </div>\n          </div>\n\n          <div class=\"info-div\" v-if=\"organ_flag=='0'\">\n            <div class=\"table-row\">\n              <div class=\"cell-label col-3\">姓名</div>\n              <div class=\"cell-value col-5\">{{basicInfo.client_name || '-'}}</div>\n              <div class=\"cell-label col-3\">联系地址</div>\n              <div class=\"cell-value col-13\">{{basicInfo.province2 || ''}}{{basicInfo.city2 || ''}}{{basicInfo.district2\n                || ''}}{{basicInfo.address || '-'}}</div>\n            </div>\n            <div class=\"table-row\">\n              <div class=\"cell-label col-3\">国籍</div>\n              <div class=\"cell-value col-5\">\n                {{basicInfo.nationality?formatDictMap('nationality_list',basicInfo.nationality):'-'}}</div>\n              <div class=\"cell-label col-3\">性别</div>\n              <div class=\"cell-value col-5\">{{(basicInfo.gender=='1'?'男':basicInfo.gender=='2'?'女':'未知')|| '-'}}</div>\n              <div class=\"cell-label col-3\">出生年月</div>\n              <div class=\"cell-value col-5\">{{basicInfo.birthday || '-'}}</div>\n            </div>\n\n            <div class=\"table-row\">\n              <div class=\"cell-label col-3\">联系电话</div>\n              <div class=\"cell-value col-5\">{{basicInfo.tel || '-'}}</div>\n              <div class=\"cell-label col-3\">年收入</div>\n              <div class=\"cell-value col-5\">\n                {{basicInfo.income?formatDictMap('year_income_list',String(basicInfo.income)): '-'}}</div>\n              <div class=\"cell-label col-3\">职业分类</div>\n              <div class=\"cell-value col-5\">\n                {{basicInfo.profession_code?formatDictMap('profession_code_list',basicInfo.profession_code):'-'}}</div>\n            </div>\n            <div class=\"table-row\">\n              <div class=\"cell-label col-3\">证件类型</div>\n              <div class=\"cell-value col-5\">{{basicInfo.id_type?formatDictMap('id_type_list',basicInfo.id_type):'-'}}\n              </div>\n              <div class=\"cell-label col-3\">证件号码</div>\n              <div class=\"cell-value col-5\">{{basicInfo.id_no || '-'}}</div>\n              <div class=\"cell-label col-3\">证件有效期</div>\n              <div class=\"cell-value col-5\">{{basicInfo.id_begindate || '-'}}至{{basicInfo.id_enddate || '-'}}</div>\n            </div>\n            <div class=\"table-row\">\n              <div class=\"cell-label col-3\">证件地址</div>\n              <div class=\"cell-value col-13\">{{basicInfo.province1 || ''}}{{basicInfo.city1 || ''}}{{basicInfo.district1\n                || ''}}{{basicInfo.id_address || '-'}}</div>\n            </div>\n          </div>\n\n          <div v-if=\"organ_flag=='1'\">\n            <h2 class=\"pdf-section-sub-title\">法定代表人信息</h2>\n            <div class=\"info-div\">\n              <div v-for=\"(item, index) in relatedInfo1\" :key=\"item.related_id\" :class=\"{'person-divider': index > 0}\">\n                <div class=\"table-row\">\n                  <div class=\"cell-label col-3\">法定代表人姓名</div>\n                  <div class=\"cell-value col-5\">{{item.related_name || '-'}}</div>\n                  <div class=\"cell-label col-3\">出生年月</div>\n                  <div class=\"cell-value col-5\">{{item.birthday || '-'}}</div>\n                  <div class=\"cell-label col-3\">国籍</div>\n                  <div class=\"cell-value col-5\">\n                    {{item.nationality?formatDictMap('nationality_list',item.nationality):'-'}}</div>\n                </div>\n                <div class=\"table-row\">\n                  <div class=\"cell-label col-3\">身份证件类型</div>\n                  <div class=\"cell-value col-5\">{{item.id_type?formatDictMap('id_type_list',item.id_type):'-'}}</div>\n                  <div class=\"cell-label col-3\">身份证件号码</div>\n                  <div class=\"cell-value col-5\">{{item.id_no || '-'}}</div>\n                  <div class=\"cell-label col-3\">证件有效期</div>\n                  <div class=\"cell-value col-5\">{{item.id_begindate || '-'}}至{{item.id_enddate || '-'}}</div>\n                </div>\n                <div class=\"table-row\">\n                  <div class=\"cell-label col-3\">联系方式</div>\n                  <div class=\"cell-value col-5\">{{ item.mobno1 }}</div>\n                  <div class=\"cell-label col-3\"></div>\n                  <div class=\"cell-value col-5\">\n                  </div>\n                  <div class=\"cell-label col-3\"></div>\n                  <div class=\"cell-value col-5\"></div>\n                </div>\n              </div>\n              <div v-if=\"!relatedInfo1 || relatedInfo1.length === 0\" class=\"table-row\">\n                <div class=\"cell-label col-3\">法定代表人信息</div>\n                <div class=\"cell-value col-21 empty-data\">暂无数据</div>\n              </div>\n            </div>\n            <h2 class=\"pdf-section-sub-title\">控股股东信息</h2>\n            <div class=\"info-div\">\n              <div v-for=\"(item, index) in relatedInfo2\" :key=\"item.related_id\" :class=\"{'person-divider': index > 0}\">\n                <div class=\"table-row\">\n                  <div class=\"cell-label col-3\" v-if=\"item.organ_flag=='1'\">控股股东(法人)</div>\n                  <div class=\"cell-label col-3\" v-if=\"item.organ_flag=='0'\">控股股东(自然人)</div>\n                  <div class=\"cell-value col-5\">{{item.related_name || '-'}}</div>\n                  <div class=\"cell-label col-3\" v-if=\"item.organ_flag=='1'\">国家或地区</div>\n                  <div class=\"cell-label col-3\" v-if=\"item.organ_flag=='0'\">国籍</div>\n                  <div class=\"cell-value col-5\">\n                    {{item.nationality?formatDictMap('nationality_list',item.nationality):'-'}}\n                  </div>\n                  <div class=\"cell-label col-3\">证件类型</div>\n                  <div class=\"cell-value col-5\">{{item.id_type?formatDictMap('id_type_list',item.id_type):'-'}}</div>\n                </div>\n                <div class=\"table-row\">\n                  <div class=\"cell-label col-3\">证件号码</div>\n                  <div class=\"cell-value col-5\">{{item.id_no || '-'}}</div>\n                  <div class=\"cell-label col-3\">证件有效期期限</div>\n                  <div class=\"cell-value col-5\">{{item.id_begindate || '-'}}至{{item.id_enddate || '-'}}</div>\n                  <div class=\"cell-label col-3\" v-if=\"item.organ_flag=='1'\">是否政府部门</div>\n                  <div class=\"cell-value col-5\" v-if=\"item.organ_flag=='1'\">{{item.is_government_dept === '1' ? '是' :\n                    (item.is_government_dept === '0' ? '否' : '-')}}</div>\n                </div>\n              </div>\n              <div v-if=\"!relatedInfo2 || relatedInfo2.length === 0\" class=\"table-row\">\n                <div class=\"cell-label col-3\">控股股东信息</div>\n                <div class=\"cell-value col-21 empty-data\">暂无数据</div>\n              </div>\n            </div>\n            <h2 class=\"pdf-section-sub-title\">实际控制人信息</h2>\n            <div class=\"info-div\">\n              <div v-for=\"(item, index) in relatedInfo3\" :key=\"item.related_id\" :class=\"{'person-divider': index > 0}\">\n                <div class=\"table-row\">\n                  <div class=\"cell-label col-3\" v-if=\"item.organ_flag=='1'\">实际控制人(法人)</div>\n                  <div class=\"cell-label col-3\" v-if=\"item.organ_flag=='0'\">实际控制人(自然人)</div>\n                  <div class=\"cell-value col-5\">{{item.related_name || '-'}}</div>\n                  <div class=\"cell-label col-3\" v-if=\"item.organ_flag=='1'\">国家或地区</div>\n                  <div class=\"cell-label col-3\" v-if=\"item.organ_flag=='0'\">国籍</div>\n                  <div class=\"cell-value col-5\">\n                    {{item.nationality?formatDictMap('nationality_list',item.nationality):'-'}}\n                  </div>\n                  <div class=\"cell-label col-3\">证件类型</div>\n                  <div class=\"cell-value col-5\">{{item.id_type?formatDictMap('id_type_list',item.id_type):'-'}}</div>\n                </div>\n                <div class=\"table-row\">\n                  <div class=\"cell-label col-3\">证件号码</div>\n                  <div class=\"cell-value col-5\">{{item.id_no || '-'}}</div>\n                  <div class=\"cell-label col-3\">证件有效期期限</div>\n                  <div class=\"cell-value col-5\">{{item.id_begindate || '-'}}至{{item.id_enddate || '-'}}</div>\n                  <div class=\"cell-label col-3\" v-if=\"item.organ_flag=='1'\">是否政府部门</div>\n                  <div class=\"cell-value col-5\" v-if=\"item.organ_flag=='1'\">{{item.is_government_dept === '1' ? '是' :\n                    (item.is_government_dept === '0' ? '否' : '-')}}</div>\n                  <div class=\"cell-label col-3\" v-if=\"item.organ_flag=='0'\">出生年月</div>\n                  <div class=\"cell-value col-5\" v-if=\"item.organ_flag=='0'\">{{item.birthday || '-'}}</div>\n                </div>\n              </div>\n              <div v-if=\"!relatedInfo3 || relatedInfo3.length === 0\" class=\"table-row\">\n                <div class=\"cell-label col-3\">实际控制人信息</div>\n                <div class=\"cell-value col-21 empty-data\">暂无数据</div>\n              </div>\n            </div>\n            <h2 class=\"pdf-section-sub-title\">授权代表人信息</h2>\n            <div class=\"info-div\">\n              <div v-for=\"(item, index) in relatedInfo4\" :key=\"item.related_id\" :class=\"{'person-divider': index > 0}\">\n                <div class=\"table-row\">\n                  <div class=\"cell-label col-3\">授权代表人姓名</div>\n                  <div class=\"cell-value col-5\">{{item.related_name || '-'}}</div>\n                  <div class=\"cell-label col-3\" v-if=\"item.organ_flag=='1'\">国家或地区</div>\n                  <div class=\"cell-label col-3\" v-if=\"item.organ_flag!='1'\">国籍</div>\n                  <div class=\"cell-value col-5\">\n                    {{item.nationality?formatDictMap('nationality_list',item.nationality):'-'}}\n                  </div>\n                  <div class=\"cell-label col-3\">证件类型</div>\n                  <div class=\"cell-value col-5\">{{item.id_type?formatDictMap('id_type_list',item.id_type):'-'}}</div>\n                </div>\n                <div class=\"table-row\">\n                  <div class=\"cell-label col-3\">证件号码</div>\n                  <div class=\"cell-value col-5\">{{item.id_no || '-'}}</div>\n                  <div class=\"cell-label col-3\">证件有效期</div>\n                  <div class=\"cell-value col-5\">{{item.id_begindate || '-'}}至{{item.id_enddate || '-'}}</div>\n                  <div class=\"cell-label col-3\" v-if=\"item.organ_flag=='1'\">是否政府部门</div>\n                  <div class=\"cell-value col-5\" v-if=\"item.organ_flag=='1'\">{{item.is_government_dept === '1' ? '是' :\n                    (item.is_government_dept === '0' ? '否' : '-')}}</div>\n                  <div class=\"cell-label col-3\" v-if=\"item.organ_flag!='1'\">出生年月</div>\n                  <div class=\"cell-value col-5\" v-if=\"item.organ_flag!='1'\">{{item.birthday || '-'}}</div>\n                </div>\n                <div class=\"table-row\">\n                  <div class=\"cell-label col-3\">联系方式</div>\n                  <div class=\"cell-value col-5\">{{ item.mobno1 }}</div>\n                  <div class=\"cell-label col-3\"></div>\n                  <div class=\"cell-value col-5\">\n                  </div>\n                  <div class=\"cell-label col-3\"></div>\n                  <div class=\"cell-value col-5\"></div>\n                </div>\n              </div>\n              <div v-if=\"!relatedInfo4 || relatedInfo4.length === 0\" class=\"table-row\">\n                <div class=\"cell-label col-3\">授权代表人信息</div>\n                <div class=\"cell-value col-21 empty-data\">暂无数据</div>\n              </div>\n            </div>\n            <h2 class=\"pdf-section-sub-title\">受益所有人信息</h2>\n            <div class=\"info-div\">\n              <div v-for=\"(item, index) in relatedInfo5\" :key=\"item.related_id\" :class=\"{'person-divider': index > 0}\">\n                <div class=\"table-row\">\n                  <div class=\"cell-label col-3\">受益所有人姓名</div>\n                  <div class=\"cell-value col-5\">{{item.related_name || '-'}}</div>\n                  <div class=\"cell-label col-3\" v-if=\"item.organ_flag=='1'\">国家或地区</div>\n                  <div class=\"cell-label col-3\" v-if=\"item.organ_flag!='1'\">国籍</div>\n                  <div class=\"cell-value col-5\">\n                    {{item.nationality?formatDictMap('nationality_list',item.nationality):'-'}}\n                  </div>\n                  <div class=\"cell-label col-3\">证件类型</div>\n                  <div class=\"cell-value col-5\">{{item.id_type?formatDictMap('id_type_list',item.id_type):'-'}}</div>\n                </div>\n                <div class=\"table-row\">\n                  <div class=\"cell-label col-3\">证件号码</div>\n                  <div class=\"cell-value col-5\">{{item.id_no || '-'}}</div>\n                  <div class=\"cell-label col-3\">证件有效期期限</div>\n                  <div class=\"cell-value col-5\">{{item.id_begindate || '-'}}至{{item.id_enddate || '-'}}</div>\n                  <div class=\"cell-label col-3\">出生年月</div>\n                  <div class=\"cell-value col-5\">{{item.birthday || '-'}}</div>\n                </div>\n                <div class=\"table-row\">\n                  <div class=\"cell-label col-3\">股权/表决权比例</div>\n                  <div class=\"cell-value col-5\">{{item.shareholding_ratio ? (item.shareholding_ratio + '%') : '-'}}\n                  </div>\n                  <div class=\"cell-label col-3\">受益所有人类型</div>\n                  <div class=\"cell-value col-5\">{{item.beneficiary?formatDictMap('beneficiary_list',item.beneficiary) :\n                    '-'}}\n                  </div>\n                  <div class=\"cell-label col-3\">联系地址</div>\n                  <div class=\"cell-value col-5\">{{item.address || '-'}}</div>\n                </div>\n              </div>\n              <div v-if=\"!relatedInfo5 || relatedInfo5.length === 0\" class=\"table-row\">\n                <div class=\"cell-label col-3\">受益所有人信息</div>\n                <div class=\"cell-value col-21 empty-data\">暂无数据</div>\n              </div>\n            </div>\n          </div>\n\n          <div class=\"info-div\">\n            <div class=\"table-row\">\n              <div class=\"cell-value\" v-if=\"organ_flag=='1'\">声明：本机构保证所提供资料的真实性、准确性、完整性、有效性，并对其承担责任；\n                如上述内容发生变更时将及时以书面方式通知贵公司，如因为不能及时完成变更由此产生的一切后果将由本机构承担。\n                <br><br>\n              </div>\n              <div class=\"cell-value\" v-if=\"organ_flag=='0'\">声明：本人保证前述所填信息以及所提供资料的真实性、准确性、完整性、有效性，并对其承担责任；\n                如上述内容发生变更时将及时以书面方式通知贵公司，如因为不能及时完成变更由此产生的一切后果将由本人承担。\n                <br><br>\n                <div style=\"font-weight:bold;color:#303133\">签名：</div>\n              </div>\n            </div>\n            <div class=\"table-row\" v-if=\"organ_flag=='1'\">\n              <div class=\"cell-label col-3\" style=\"height:100px;\">机构盖章:</div>\n              <div class=\"cell-value col-21\"></div>\n            </div>\n            <div class=\"table-row\">\n              <div class=\"cell-label col-3\">建立业务关系日期</div>\n              <div class=\"cell-value col-5\">{{basicInfo.associated_date}}</div>\n            </div>\n          </div>\n        </div>\n      </el-card>\n    </div>\n  </div>\n  <!--弹窗-->\n  <el-dialog title=\"附件管理\" :visible.sync=\"fileDialogVisible\" :close-on-click-modal=\"false\" @close=\"closeDialog('3')\">\n    <el-form>\n      <el-form-item label=\"附件类型\">\n        <el-cascader v-model=\"selectedMenu\" :options=\"organ_flag==='0'?directoryConfig2:directoryConfig1\"\n          style=\"width:60%;margin-bottom:20px;\" :disabled=\"fileDialogDisabled\">\n      </el-form-item>\n      <el-form-item label=\"上传附件\">\n        <el-upload class=\"upload-demo\" ref=\"upload\"\n          action=\"m?xwl=aml_monitor/workflow/prs01/dataSource/files/upload_file1\" name=\"file1\"\n          header=\"{content-type:'text/html'}\" :data=\"uploadParams\" :file-list=\"fileList\" :auto-upload=\"false\"\n          :on-change=\"handleChange\" :on-remove=\"handleRemove\" multiple>\n          <el-button slot=\"trigger\" size=\"mini\" icon=\"el-icon-upload2\">上传文件</el-button>\n          <div slot=\"tip\" class=\"el-upload__tip\">支持扩展名 .zip .rar .xlsx .xls .doc .docx .pdf .jpg .jpeg .svg .gif .png\n            .txt .mp3 .mp4</div>\n        </el-upload>\n      </el-form-item>\n    </el-form>\n    <div slot=\"footer\" class=\"dialog-footer\">\n      <el-button @click=\"fileDialogVisible = false\">取消</el-button>\n      <el-button type=\"primary\" @click=\"submitUpload\">提交</el-button>\n    </div>\n  </el-dialog>\n  <!--3实际控制人、2控股股东（可以选择自然人/法人）-->\n  <el-dialog :title=\"editForm.title\" :visible.sync=\"dialogFormVisible\" width=\"60%\" :close-on-click-modal=\"false\">\n    <div>\n      <el-form :model=\"editForm\" ref=\"editForm\" :rules=\"rules1\" label-width=\"120px\" label-position=\"top\"\n        :class=\"['register-form', {'hide-required-mark': shouldHideRequiredMark}]\" :hide-required-asterisk=\"true\">\n        <el-row :gutter=\"20\">\n          <el-col :span=\"8\">\n            <el-form-item :label=\"editForm.title+'类型'\" prop=\"organ_flag\"\n              v-if=\"editForm.related_type=='2'||editForm.related_type=='3'\">\n              <el-radio-group v-model=\"editForm.organ_flag\" :disabled=\"!editForm.new_flag\"\n                @change=\"resetForm(editForm)\">\n                <el-radio label=\"1\">法人</el-radio>\n                <el-radio label=\"0\">自然人</el-radio>\n              </el-radio-group>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <el-form-item prop=\"related_name\" class=\"always-show-required\">\n              <template slot=\"label\">\n                <div style=\"display: flex; align-items: center;\">\n                  <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                    <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\">*</span>{{editForm.organ_flag=='1'?editForm.title+'（法人）':editForm.title+'（自然人）'}}\n                  </div>\n                </div>\n              </template>\n              <el-select clearable v-model=\"editForm.related_name\" allow-create filterable placeholder=\"请选择或手动输入\"\n                @focus=\"selectRelaOptions(editForm.organ_flag)\" :disabled=\"editForm.new_flag ? false : true\"\n                @change=\"setRelaValue(editForm.related_name,'form')\" default-first-option>\n                <el-option v-for=\"item in curRelaOptions\" :key=\"item.related_id\" :label=\"item.related_name\"\n                  :value=\"item.related_name\">\n                </el-option>\n              </el-select>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <el-form-item label=\"\" v-if=\"editForm.organ_flag==='1'\" prop=\"is_government_dept\">\n              <template slot=\"label\">\n                <div style=\"display: flex; align-items: center;\">\n                  <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                    <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>是否政府部门\n                  </div>\n                </div>\n              </template>\n              <el-radio-group v-model=\"editForm.is_government_dept\">\n                <el-radio label=\"1\">是</el-radio>\n                <el-radio label=\"0\">否</el-radio>\n              </el-radio-group>\n            </el-form-item>\n            <el-form-item v-if=\"editForm.organ_flag==='0'\" prop=\"birthday\">\n              <template slot=\"label\">\n                <div style=\"display: flex; align-items: center;\">\n                  <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                    <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>出生年月\n                  </div>\n                  <el-tooltip class=\"item\" effect=\"dark\" content=\"如需手动填写，请按照“1990-01-01”的格式填写\" placement=\"top\">\n                    <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n                  </el-tooltip>\n                  <!--<i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n                  <span style=\"color:#F56C6C;font-size:14px;\">如需手动填写，请按照“1990-01-01”的格式填写</span>-->\n                </div>\n              </template>\n              <el-date-picker v-model=\"editForm.birthday\" type=\"date\" placeholder=\"年-月-日\" style=\"flex:1;\"\n                format=\"yyyy-MM-dd\" clearable>\n            </el-form-item>\n          </el-col>\n        </el-row>\n        <el-row :gutter=\"20\">\n          <el-col :span=\"8\">\n            <el-form-item prop=\"id_type\">\n              <template slot=\"label\">\n                <div style=\"display: flex; align-items: center;\">\n                  <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                    <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"(ruleForm3.is_special==='0'&& (editForm.is_government_dept==='0'||!editForm.is_government_dept)&& editForm.organ_flag==='1')||(ruleForm3.is_special==='0'&& editForm.organ_flag==='0')\">*</span>证照类型\n                  </div>\n                </div>\n              </template>\n              <el-select v-model=\"editForm.id_type\" placeholder=\"请选择\" clearable @change=\"clearIdNoValidate('editForm')\">\n                <el-option\n                  v-for=\"item in (editForm.organ_flag=='1'?selectList.id_type_jg_list:selectList.id_type_gr_list)\"\n                  :key=\"item.k\" :label=\"item.v\" :value=\"item.k\">\n                </el-option>\n              </el-select>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <el-form-item prop=\"id_no\">\n              <template slot=\"label\">\n                <div style=\"display: flex; align-items: center;\">\n                  <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                    <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"(ruleForm3.is_special==='0'&& (editForm.is_government_dept==='0'||!editForm.is_government_dept)&& editForm.organ_flag==='1')||(ruleForm3.is_special==='0'&& editForm.organ_flag==='0')\">*</span>证照号码\n                  </div>\n                </div>\n              </template>\n              <el-input v-model=\"editForm.id_no\" placeholder=\"请输入\"></el-input>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <el-form-item prop=\"nationality\">\n              <template slot=\"label\">\n                <div style=\"display: flex; align-items: center;\">\n                  <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                    <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"(ruleForm3.is_special==='0'&& (editForm.is_government_dept==='0'||!editForm.is_government_dept)&& editForm.organ_flag==='1')||(ruleForm3.is_special==='0'&& editForm.organ_flag==='0')\">*</span>{{editForm.organ_flag=='1'?'国家或地区':'国籍'}}\n                  </div>\n                </div>\n              </template>\n              <el-select v-model=\"editForm.nationality\" filterable placeholder=\"请选择\" clearable>\n                <el-option v-for=\"item in selectList.nationality_list\" :key=\"item.k\" :label=\"item.v\" :value=\"item.k\">\n                </el-option>\n              </el-select>\n            </el-form-item>\n          </el-col>\n        </el-row>\n        <el-row :gutter=\"20\">\n          <el-col :span=\"16\">\n            <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n              <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right:4px;\" v-if=\"(ruleForm3.is_special==='0'&& (editForm.is_government_dept==='0'||!editForm.is_government_dept)&& editForm.organ_flag==='1')||(ruleForm3.is_special==='0'&& editForm.organ_flag==='0')\">*\n              </span>证件有效期\n              <!--<el-tooltip \n                class=\"item\" \n                effect=\"dark\" \n                content=\"如需手动填写，请按照“1990-01-01”的格式填写\" \n                placement=\"top\">\n                <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n              </el-tooltip>-->\n              <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n              <span style=\"color:#F56C6C;font-size:14px;\">如需手动填写，请按照“1990-01-01”的格式填写</span>\n            </div>\n            <div style=\"display:flex;width:100%;gap:8px;\">\n              <el-form-item prop=\"id_begindate\">\n                <el-date-picker v-model=\"editForm.id_begindate\" type=\"date\" placeholder=\"开始日期\" style=\"flex:1;\"\n                  format=\"yyyy-MM-dd\" clearable>\n                </el-date-picker>\n              </el-form-item>\n              <div style=\"height:40px;line-height:40px;\">至</div>\n              <el-form-item prop=\"id_enddate\">\n                <el-date-picker v-model=\"editForm.id_enddate\" type=\"date\" placeholder=\"结束日期\" style=\"flex:1;\"\n                  format=\"yyyy-MM-dd\" align=\"right\" :picker-options=\"pickerOptions\" clearable>\n                </el-date-picker>\n              </el-form-item>\n            </div>\n          </el-col>\n        </el-row>\n      </el-form>\n    </div>\n    <div slot=\"footer\" class=\"dialog-footer\">\n      <el-button @click=\"closeDialog('1')\">取消</el-button>\n      <el-button type=\"primary\" @click=\"saveEditForm('1','1')\"\n        v-if=\"editForm.related_type!=='1'&&editForm.related_type!=='4'\">提交并录入下一条</el-button>\n      <el-button type=\"primary\" @click=\"saveEditForm('2','1')\">提交</el-button>\n    </div>\n  </el-dialog>\n  <!--1法定代表人、4授权代表人、5受益所有人（只能是自然人）-->\n  <el-dialog :title=\"editForm1.title\" :visible.sync=\"dialogFormVisible1\" width=\"60%\" :close-on-click-modal=\"false\"\n    @close=\"closeDialog('2')\">\n    <div>\n      <el-form :model=\"editForm1\" ref=\"editForm1\" :rules=\"rules1\" label-width=\"120px\" label-position=\"top\"\n        :class=\"['register-form', {'hide-required-mark': shouldHideRequiredMark}]\" :hide-required-asterisk=\"true\">\n        <el-row :gutter=\"20\">\n          <el-col :span=\"8\">\n            <el-form-item label=\"姓名\" prop=\"related_name\" class=\"always-show-required\">\n              <el-select clearable v-model=\"editForm1.related_name\" allow-create filterable placeholder=\"请选择或手动输入\"\n                @focus=\"selectRelaOptions('0')\" :disabled=\"editForm1.new_flag ? false : true\"\n                @change=\"setRelaValue(editForm1.related_name,'form1')\" default-first-option>\n                <el-option v-for=\"item in curRelaOptions\" :key=\"item.related_id\" :label=\"item.related_name\"\n                  :value=\"item.related_name\">\n                </el-option>\n              </el-select>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <el-form-item prop=\"birthday\">\n              <template slot=\"label\">\n                <div style=\"display: flex; align-items: center;\">\n                  <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                    <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>出生年月\n                  </div>\n                  <el-tooltip class=\"item\" effect=\"dark\" content=\"如需手动填写，请按照“1990-01-01”的格式填写\" placement=\"top\">\n                    <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n                  </el-tooltip>\n                </div>\n              </template>\n              <el-date-picker v-model=\"editForm1.birthday\" type=\"date\" placeholder=\"年-月-日\" style=\"flex:1;\"\n                format=\"yyyy-MM-dd\" clearable>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <el-form-item prop=\"nationality\">\n              <template slot=\"label\">\n                <div style=\"display: flex; align-items: center;\">\n                  <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                    <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>国籍\n                  </div>\n                </div>\n              </template>\n              <el-select v-model=\"editForm1.nationality\" filterable placeholder=\"请选择\" clearable>\n                <el-option v-for=\"item in selectList.nationality_list\" :key=\"item.k\" :label=\"item.v\" :value=\"item.k\">\n                </el-option>\n              </el-select>\n            </el-form-item>\n          </el-col>\n        </el-row>\n        <el-row :gutter=\"20\">\n          <el-col :span=\"8\">\n            <el-form-item prop=\"id_type\">\n              <template slot=\"label\">\n                <div style=\"display: flex; align-items: center;\">\n                  <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                    <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>证照类型\n                  </div>\n                </div>\n              </template>\n              <el-select v-model=\"editForm1.id_type\" placeholder=\"请选择\" clearable\n                @change=\"clearIdNoValidate('editForm1')\">\n                <el-option v-for=\"item in selectList.id_type_gr_list\" :key=\"item.k\" :label=\"item.v\" :value=\"item.k\">\n                </el-option>\n              </el-select>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <el-form-item prop=\"id_no\">\n              <template slot=\"label\">\n                <div style=\"display: flex; align-items: center;\">\n                  <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                    <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>证照号码\n                  </div>\n                </div>\n              </template>\n              <el-input v-model=\"editForm1.id_no\" placeholder=\"请输入\" clearable></el-input>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\" v-if=\"editForm1.related_type=='1'||editForm1.related_type=='4'\">\n            <el-form-item prop=\"mobno1\">\n              <template slot=\"label\">\n                <div style=\"display: flex; align-items: center;\">\n                  <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                    <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>联系方式\n                  </div>\n                </div>\n              </template>\n              <el-input v-model=\"editForm1.mobno1\" placeholder=\"请输入联系方式\" clearable></el-input>\n            </el-form-item>\n          </el-col>\n        </el-row>\n        <el-row :gutter=\"20\">\n          <el-col :span=\"12\">\n            <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n              <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right:4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>\n              证件有效期\n              <!--<el-tooltip \n                class=\"item\" \n                effect=\"dark\" \n                content=\"如需手动填写，请按照“1990-01-01”的格式填写\" \n                placement=\"top\">\n                <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n              </el-tooltip>-->\n              <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n              <span style=\"color:#F56C6C;font-size:14px;\">如需手动填写，请按照“1990-01-01”的格式填写</span>\n            </div>\n            <div style=\"display:flex;width:100%;gap:8px;\">\n              <el-form-item prop=\"id_begindate\">\n                <el-date-picker v-model=\"editForm1.id_begindate\" type=\"date\" placeholder=\"开始日期\" style=\"flex:1;\"\n                  format=\"yyyy-MM-dd\" clearable>\n                </el-date-picker>\n              </el-form-item>\n              <div style=\"height:40px;line-height:40px;\">至</div>\n              <el-form-item prop=\"id_enddate\">\n                <el-date-picker v-model=\"editForm1.id_enddate\" type=\"date\" placeholder=\"结束日期\" style=\"flex:1;\"\n                  format=\"yyyy-MM-dd\" align=\"right\" :picker-options=\"pickerOptions\" clearable>\n                </el-date-picker>\n              </el-form-item>\n            </div>\n          </el-col>\n          <el-col :span=\"12\" v-if=\"editForm1.related_type=='5'\">\n            <el-form-item prop=\"address\">\n              <template slot=\"label\">\n                <div style=\"display: flex; align-items: center;\">\n                  <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                    <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>联系地址\n                  </div>\n                </div>\n              </template>\n              <el-input v-model=\"editForm1.address\"></el-input>\n            </el-form-item>\n          </el-col>\n        </el-row>\n        <!--受益所有人-->\n        <el-row :gutter=\"20\" v-if=\"editForm1.related_type=='5'\">\n          <el-col :span=\"12\">\n            <el-form-item prop=\"beneficiary\">\n              <template slot=\"label\">\n                <div style=\"display: flex; align-items: center;\">\n                  <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                    <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>受益所有人类型\n                  </div>\n                </div>\n              </template>\n              <el-select v-model=\"editForm1.beneficiary\" filterable placeholder=\"请选择\" clearable style=\"width:100%\"\n                @change=\"clearRatio()\">\n                <el-option v-for=\"item in selectList.beneficiary_list\" :key=\"item.k\" :label=\"item.v\" :value=\"item.k\">\n                </el-option>\n              </el-select>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"12\">\n            <el-form-item prop=\"shareholding_ratio\"\n              v-if=\"editForm1.beneficiary=='A1'||editForm1.beneficiary=='A2'||editForm1.beneficiary=='B1'||editForm1.beneficiary=='D1'\">\n              <template slot=\"label\">\n                <div style=\"display: flex; align-items: center;\">\n                  <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                    <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>股权/表决权比例\n                  </div>\n                </div>\n              </template>\n              <el-input v-model.number=\"editForm1.shareholding_ratio\" type=\"number\" :max=\"100\" :min=\"0\">\n                <template slot=\"append\">%</template>\n              </el-input>\n            </el-form-item>\n          </el-col>\n        </el-row>\n      </el-form>\n    </div>\n    <div slot=\"footer\" class=\"dialog-footer\">\n      <el-button @click=\"closeDialog('2')\">取消</el-button>\n      <el-button type=\"primary\" @click=\"saveEditForm('1','2')\"\n        v-if=\"editForm1.related_type!=='1'&&editForm1.related_type!=='4'\">提交并录入下一条</el-button>\n      <el-button type=\"primary\" @click=\"saveEditForm('2','2')\">提交</el-button>\n    </div>\n  </el-dialog>\n  <!-- 6 新版受益所有人 带bomis核验功能 -->\n  <el-dialog :title=\"bomisParams.editBomisForm.title\" :visible.sync=\"bomisParams.dialogBomisVisible\" width=\"80%\"\n    :close-on-click-modal=\"false\" @close=\"closeDialog('bomisDialog')\" custom-class=\"benefit-scroll-dialog\">\n    <div>\n      <el-form :model=\"bomisParams.editBomisForm\" ref=\"editBenefitForm\" :rules=\"bomisParams.editBomisFormRules\"\n        label-width=\"280px\" label-position=\"top\"\n        :class=\"['register-form', {'hide-required-mark': shouldHideRequiredMark}]\" :hide-required-asterisk=\"false\"\n        size=\"mini\">\n        <el-row :gutter=\"24\">\n          <el-col :span=\"8\">\n            <el-form-item label=\"受益所有人\" prop=\"bo_type\">\n              <el-select clearable v-model=\"bomisParams.editBomisForm.bo_type\" placeholder=\"请选择\"\n                class=\"formitem-full-width formitem-max-width\"\n                @change=\"bomisBoTypeChange(bomisParams.editBomisForm.bo_type, bomisParams.editBomisForm)\">\n                <el-option v-for=\"item in selectList.benefit_flag_list\" :key=\"item.k\" :label=\"item.v\" :value=\"item.k\">\n                </el-option>\n              </el-select>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <el-form-item label=\"企业性质\" prop=\"company_type\">\n              <el-select clearable v-model=\"bomisParams.editBomisForm.company_type\" placeholder=\"请选择\"\n                class=\"formitem-full-width formitem-max-width\"\n                @change=\"bomisCompanyTypeChange(bomisParams.editBomisForm.company_type, bomisParams.editBomisForm)\"\n                @visible-change=\"getBomisCompanyType(bomisParams.editBomisForm)\">\n                <el-option v-for=\"item in bomisParams.benefit_company_no_list\" :key=\"item.k\" :label=\"item.v\"\n                  :value=\"item.k\"> </el-option>\n              </el-select>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"24\">\n            <el-form-item label=\"受益所有权类型\" prop=\"bnf_type\">\n              <el-select clearable v-model=\"bomisParams.editBomisForm.bnf_type\" placeholder=\"请选择\" multiple\n                class=\"formitem-full-width formitem-24-max-width\"\n                @change=\"bomisBnfTypeChange(bomisParams.editBomisForm.bnf_type, bomisParams.editBomisForm)\"\n                @visible-change=\"getBomisBnfType(bomisParams.editBomisForm)\">\n                <el-option v-for=\"item in bomisParams.bnf_type_new_list\" :key=\"item.k\" :label=\"item.v\" :value=\"item.k\"\n                  :disabled=\"item.disabled === true\">\n                </el-option>\n              </el-select>\n            </el-form-item>\n          </el-col>\n        </el-row>\n        <!-- 持有股权、股份或者合伙权益 -->\n        <el-row :gutter=\"24\"\n          v-if=\"bomisParams.editBomisForm.bnf_type.includes('NA1') || bomisParams.editBomisForm.bnf_type.includes('NB1') ||bomisParams.editBomisForm.bnf_type.includes('ND1') \">\n          <el-col :span=\"8\">\n            <el-form-item label=\"持有股权、股份或者合伙权益的比例（%)\" prop=\"acthdrat\">\n              <el-input-number type=\"number\" v-model=\"bomisParams.editBomisForm.acthdrat\" :min=\"25\" :max=\"100\"\n                class=\"formitem-full-width formitem-max-width\" />\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <div style=\"height:28px;line-height:28px;font-size:14px;color:#606266;\">\n              <span v-if=\"bomisParams.editBomisForm.bnf_type.includes('NA1')\">形成日期(股权、股份) </span>\n              <span v-if=\"bomisParams.editBomisForm.bnf_type.includes('NB1')\">形成日期(合伙权益) </span>\n              <span v-if=\"bomisParams.editBomisForm.bnf_type.includes('ND1')\">形成日期(股权、份额) </span>\n              <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n              <span style=\"color:#F56C6C;font-size:12px;\">如需手动填写，请按照“1990-01-01”的格式填写</span>\n            </div>\n            <el-form-item prop=\"shareratiostartdate\">\n              <el-date-picker v-model=\"bomisParams.editBomisForm.shareratiostartdate\" type=\"date\" placeholder=\"选择日期\"\n                format=\"yyyy-MM-dd\" clearable editable class=\"formitem-full-width formitem-max-width\" />\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <div style=\"height:28px;line-height:28px;font-size:14px;color:#606266;\">\n              终止日期(股权、股份)\n              <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n              <span style=\"color:#F56C6C;font-size:12px;\">如需手动填写，请按照“1990-01-01”的格式填写</span>\n            </div>\n            <el-form-item prop=\"shareratioenddate\">\n              <el-date-picker v-model=\"bomisParams.editBomisForm.shareratioenddate\" type=\"date\" placeholder=\"选择日期\"\n                format=\"yyyy-MM-dd\" clearable editable class=\"formitem-full-width formitem-max-width\" />\n            </el-form-item>\n          </el-col>\n        </el-row>\n        <!-- 收益权 -->\n        <el-row :gutter=\"24\"\n          v-if=\"bomisParams.editBomisForm.bnf_type.includes('NA2-1') || bomisParams.editBomisForm.bnf_type.includes('NB2-1') || bomisParams.editBomisForm.bnf_type.includes('ND2-1')\">\n          <el-col :span=\"8\">\n            <el-form-item label=\"持有收益权的比例(%)\" prop=\"actownerprofitratio\">\n              <el-input-number type=\"number\" v-model=\"bomisParams.editBomisForm.actownerprofitratio\"\n                class=\"formitem-full-width formitem-max-width\" />\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <div style=\"height:28px;line-height:28px;font-size:14px;color:#606266;\">\n              形成日期(收益权)\n              <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n              <span style=\"color:#F56C6C;font-size:12px;\">如需手动填写，请按照“1990-01-01”的格式填写</span>\n            </div>\n            <el-form-item prop=\"profitratiostartdate\">\n              <el-date-picker v-model=\"bomisParams.editBomisForm.profitratiostartdate\" type=\"date\" placeholder=\"选择日期\"\n                format=\"yyyy-MM-dd\" clearable editable class=\"formitem-full-width formitem-max-width\" />\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <div style=\"height:28px;line-height:28px;font-size:14px;color:#606266;\">\n              终止日期(收益权)\n              <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n              <span style=\"color:#F56C6C;font-size:12px;\">如需手动填写，请按照“1990-01-01”的格式填写</span>\n            </div>\n            <el-form-item prop=\"profitratioenddate\">\n              <el-date-picker v-model=\"bomisParams.editBomisForm.profitratioenddate\" type=\"date\" placeholder=\"选择日期\"\n                format=\"yyyy-MM-dd\" clearable editable class=\"formitem-full-width formitem-max-width\" />\n            </el-form-item>\n          </el-col>\n        </el-row>\n        <!-- 表决权 -->\n        <el-row :gutter=\"24\"\n          v-if=\"bomisParams.editBomisForm.bnf_type.includes('NA2-2') || bomisParams.editBomisForm.bnf_type.includes('NB2-2') || bomisParams.editBomisForm.bnf_type.includes('ND2-2')\">\n          <el-col :span=\"8\">\n            <el-form-item label=\"持有表决权的比例(%)\" prop=\"actownerprofitratiovote\">\n              <el-input-number type=\"number\" v-model=\"bomisParams.editBomisForm.actownerprofitratiovote\"\n                class=\"formitem-full-width formitem-max-width\" />\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <div style=\"height:28px;line-height:28px;font-size:14px;color:#606266;\">\n              形成日期(表决权)\n              <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n              <span style=\"color:#F56C6C;font-size:12px;\">如需手动填写，请按照“1990-01-01”的格式填写</span>\n            </div>\n            <el-form-item prop=\"profitratiovotestartdate\">\n              <el-date-picker v-model=\"bomisParams.editBomisForm.profitratiovotestartdate\" type=\"date\"\n                placeholder=\"选择日期\" format=\"yyyy-MM-dd\" clearable editable\n                class=\"formitem-full-width formitem-max-width\" />\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <div style=\"height:28px;line-height:28px;font-size:14px;color:#606266;\">\n              终止日期(表决权)\n              <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n              <span style=\"color:#F56C6C;font-size:12px;\">如需手动填写，请按照“1990-01-01”的格式填写</span>\n            </div>\n            <el-form-item prop=\"profitratiovoteenddate\">\n              <el-date-picker v-model=\"bomisParams.editBomisForm.profitratiovoteenddate\" type=\"date\" placeholder=\"选择日期\"\n                format=\"yyyy-MM-dd\" clearable editable class=\"formitem-full-width formitem-max-width\" />\n            </el-form-item>\n          </el-col>\n        </el-row>\n        <!-- 实际实施控制 -->\n        <el-row :gutter=\"24\">\n          <el-col :span=\"24\"\n            v-if=\"bomisParams.editBomisForm.bnf_type.includes('NA3-1') || bomisParams.editBomisForm.bnf_type.includes('NA3-2') || bomisParams.editBomisForm.bnf_type.includes('NB3-1') || bomisParams.editBomisForm.bnf_type.includes('NB3-2') || bomisParams.editBomisForm.bnf_type.includes('ND3')\">\n            <el-form-item prop=\"actctrltype\" label=\"实施实际控制的内容/方式\">\n              <el-select v-model=\"bomisParams.editBomisForm.actctrltype\" filterable placeholder=\"请选择\" clearable multiple\n                class=\"formitem-full-width formitem-24-max-width\">\n                <el-option v-for=\"item in selectList.benefit_actctrltype_list\" :key=\"item.k\" :label=\"item.v\"\n                  :value=\"item.k\">\n                </el-option>\n              </el-select>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"24\"\n            v-if=\"bomisParams.editBomisForm.bnf_type.includes('NA3-2') || bomisParams.editBomisForm.bnf_type.includes('NB3-2') || bomisParams.editBomisForm.bnf_type.includes('ND3')\">\n            <el-form-item prop=\"actotherforms\" label=\"其他形式的具体内容\">\n              <el-input v-model=\"bomisParams.editBomisForm.actotherforms\" placeholder=\"请输入\" clearable\n                class=\"formitem-full-width formitem-24-max-width\">\n              </el-input>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\"\n            v-if=\"bomisParams.editBomisForm.bnf_type.includes('NA3-1') || bomisParams.editBomisForm.bnf_type.includes('NA3-2') || bomisParams.editBomisForm.bnf_type.includes('NB3-1') || bomisParams.editBomisForm.bnf_type.includes('NB3-2') || bomisParams.editBomisForm.bnf_type.includes('ND3')\">\n            <div style=\"height:28px;line-height:28px;font-size:14px;color:#606266;\">\n              形成日期(实施实际控制)\n              <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n              <span style=\"color:#F56C6C;font-size:12px;\">如需手动填写，请按照“1990-01-01”的格式填写</span>\n            </div>\n            <el-form-item prop=\"obtainactdate\">\n              <el-date-picker v-model=\"bomisParams.editBomisForm.obtainactdate\" type=\"date\" placeholder=\"选择日期\"\n                format=\"yyyy-MM-dd\" clearable editable class=\"formitem-full-width formitem-max-width\" />\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\"\n            v-if=\"bomisParams.editBomisForm.bnf_type.includes('NA3-1') || bomisParams.editBomisForm.bnf_type.includes('NA3-2') || bomisParams.editBomisForm.bnf_type.includes('NB3-1') || bomisParams.editBomisForm.bnf_type.includes('NB3-2') || bomisParams.editBomisForm.bnf_type.includes('ND3')\">\n            <div style=\"height:28px;line-height:28px;font-size:14px;color:#606266;\">\n              终止日期(实施实际控制)\n              <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n              <span style=\"color:#F56C6C;font-size:12px;\">如需手动填写，请按照“1990-01-01”的格式填写</span>\n            </div>\n            <el-form-item prop=\"terminationactdate\">\n              <el-date-picker v-model=\"bomisParams.editBomisForm.terminationactdate\" type=\"date\" placeholder=\"选择日期\"\n                format=\"yyyy-MM-dd\" clearable editable class=\"formitem-full-width formitem-max-width\" />\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\"\n            v-if=\"bomisParams.editBomisForm.bnf_type.includes('NA3-1') || bomisParams.editBomisForm.bnf_type.includes('NB3-1') || bomisParams.editBomisForm.bnf_type.includes('ND3')\">\n            <el-form-item prop=\"actconuppermarket\" label=\"是否存在上一层备案主体\">\n              <el-select v-model=\"bomisParams.editBomisForm.actconuppermarket\" filterable placeholder=\"请选择\" clearable\n                class=\"formitem-full-width formitem-max-width\">\n                <el-option v-for=\"item in selectList.benefit_yesno_list\" :key=\"item.k\" :label=\"item.v\" :value=\"item.k\">\n                </el-option>\n              </el-select>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\"\n            v-if=\"(bomisParams.editBomisForm.bnf_type.includes('NA3-1') || bomisParams.editBomisForm.bnf_type.includes('NB3-1') || bomisParams.editBomisForm.bnf_type.includes('ND3')) && bomisParams.editBomisForm.actconuppermarket === 'Y'\">\n            <el-form-item prop=\"actconupperentname\" label=\"实际控制备案主体的上一层备案主体名称\">\n              <el-input v-model=\"bomisParams.editBomisForm.actconupperentname\" placeholder=\"请输入\" clearable\n                class=\"formitem-full-width formitem-max-width\">\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\"\n            v-if=\"(bomisParams.editBomisForm.bnf_type.includes('NA3-1') || bomisParams.editBomisForm.bnf_type.includes('NB3-1') || bomisParams.editBomisForm.bnf_type.includes('ND3')) && bomisParams.editBomisForm.actconuppermarket === 'Y'\">\n            <el-form-item prop=\"actconuniscid\" label=\"实际控制备案主体的统一社会信用代码\">\n              <el-input v-model=\"bomisParams.editBomisForm.actconuniscid\" placeholder=\"请输入\" clearable\n                class=\"formitem-full-width formitem-max-width\">\n            </el-form-item>\n          </el-col>\n        </el-row>\n        <!-- 负责日常经营管理 -->\n        <el-row :gutter=\"24\">\n          <el-col :span=\"16\"\n            v-if=\"bomisParams.editBomisForm.bnf_type.includes('NA4') || bomisParams.editBomisForm.bnf_type.includes('NB4')\">\n            <el-form-item prop=\"seniormgrpos\" label=\"负责日常经营管理的（高级管理）人员职位\">\n              <el-select v-model=\"bomisParams.editBomisForm.seniormgrpos\" filterable placeholder=\"请选择\" clearable\n                multiple class=\"formitem-full-width formitem-16-max-width\">\n                <el-option v-for=\"item in selectList.benefit_seniormgrpos_list\" :key=\"item.k\" :label=\"item.v\"\n                  :value=\"item.k\">\n                </el-option>\n              </el-select>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\"\n            v-if=\"(bomisParams.editBomisForm.bnf_type.includes('NA4') || bomisParams.editBomisForm.bnf_type.includes('NB4')) && bomisParams.editBomisForm.seniormgrpos.includes('15')\">\n            <el-form-item prop=\"actdailymgmtpostother\" label=\"公司章程规定的其他（高级管理）人员的具体职位\">\n              <el-input v-model=\"bomisParams.editBomisForm.actdailymgmtpostother\" placeholder=\"请输入\" clearable\n                class=\"formitem-full-width formitem-max-width\">\n            </el-form-item>\n          </el-col>\n        </el-row>\n        <!-- 在华最高层级的高级管理 -->\n        <el-row :gutter=\"24\">\n          <el-col :span=\"16\" v-if=\"bomisParams.editBomisForm.bnf_type.includes('NA5')\">\n            <el-form-item prop=\"seniormgrposcn\" label=\"在华最高层级的高级管理人员职位\">\n              <el-select v-model=\"bomisParams.editBomisForm.seniormgrposcn\" filterable placeholder=\"请选择\" clearable\n                multiple class=\"formitem-full-width formitem-16-max-width\">\n                <el-option v-for=\"item in selectList.benefit_seniormgrposcn_list\" :key=\"item.k\" :label=\"item.v\"\n                  :value=\"item.k\">\n                </el-option>\n              </el-select>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\"\n            v-if=\"bomisParams.editBomisForm.bnf_type.includes('NA5') && bomisParams.editBomisForm.seniormgrposcn.includes('1')\">\n            <el-form-item prop=\"ownerrightmgmtpostother\" label=\"在华最高层级的高级管理其他职位\">\n              <el-input v-model=\"bomisParams.editBomisForm.ownerrightmgmtpostother\" placeholder=\"请输入\" clearable\n                class=\"formitem-full-width formitem-max-width\">\n            </el-form-item>\n          </el-col>\n        </el-row>\n        <el-row :gutter=\"24\">\n          <el-col :span=\"24\">\n            <!-- label=\"　\" -->\n            <el-form-item prop=\"full_info_flag\">\n              <el-radio-group v-model=\"bomisParams.editBomisForm.full_info_flag\">\n                <el-radio key=\"full_info_flag01\" label=\"01\"\n                  @click.native=\"nativeRadioClick('01', bomisParams.editBomisForm, 'full_info_flag')\" value=\"01\">\n                  透明度较高、信息披露充分的客户（如上市公司、国有企业）</el-radio>\n                <el-radio key=\"full_info_flag02\" label=\"02\"\n                  @click.native=\"nativeRadioClick('02', bomisParams.editBomisForm, 'full_info_flag')\" value=\"02\">\n                  受益人信息不规范</el-radio>\n              </el-radio-group>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <el-form-item label=\"姓名\" prop=\"related_name\">\n              <el-select clearable v-model=\"bomisParams.editBomisForm.related_name\" allow-create filterable\n                placeholder=\"请选择或手动输入\" @focus=\"selectRelaOptions('0')\"\n                :disabled=\"bomisParams.editBomisForm.new_flag ? false : true\"\n                @change=\"setRelaValue(bomisParams.editBomisForm.related_name,'bomisForm')\" default-first-option\n                class=\"formitem-full-width formitem-max-width\">\n                <el-option v-for=\"item in curRelaOptions\" :key=\"item.related_id\" :label=\"item.related_name\"\n                  :value=\"item.related_name\">\n                </el-option>\n              </el-select>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <el-form-item prop=\"id_type\" label=\"证件类型\">\n              <el-select v-model=\"bomisParams.editBomisForm.id_type\" placeholder=\"请选择\" clearable\n                @change=\"clearIdNoValidate('editBomisForm')\" class=\"formitem-full-width formitem-max-width\">\n                <el-option v-for=\"item in selectList.id_type_gr_list\" :key=\"item.k\" :label=\"item.v\" :value=\"item.k\">\n                </el-option>\n              </el-select>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <el-form-item prop=\"id_no\" label=\"证件编号\">\n              <el-input v-model=\"bomisParams.editBomisForm.id_no\" placeholder=\"请输入\" clearable\n                class=\"formitem-full-width formitem-max-width\">\n              </el-input>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <div style=\"height:28px;line-height:28px;font-size:14px;color:#606266;\">\n              证件有效期\n              <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n              <span style=\"color:#F56C6C;font-size:12px;\">如需手动填写，请按照“1990-01-01”的格式填写</span>\n            </div>\n            <div style=\"display:flex;width:100%;gap:8px;\" class=\"formitem-max-width\">\n              <el-form-item prop=\"id_begindate\" style=\"flex:1;\">\n                <el-date-picker v-model=\"bomisParams.editBomisForm.id_begindate\" type=\"date\" placeholder=\"开始日期\"\n                  class=\"formitem-full-width\" format=\"yyyy-MM-dd\" clearable>\n                </el-date-picker>\n              </el-form-item>\n              <div>~</div>\n              <el-form-item prop=\"id_enddate\" style=\"flex:1;\">\n                <el-date-picker v-model=\"bomisParams.editBomisForm.id_enddate\" type=\"date\" placeholder=\"结束日期\"\n                  class=\"formitem-full-width\" format=\"yyyy-MM-dd\" align=\"right\"\n                  :picker-options=\"bomisParams.pickerOptions\" clearable>\n                </el-date-picker>\n              </el-form-item>\n            </div>\n          </el-col>\n          <el-col :span=\"8\">\n            <el-form-item prop=\"gender\" label=\"性别\">\n              <el-select v-model=\"bomisParams.editBomisForm.gender\" placeholder=\"请选择\"\n                class=\"formitem-full-width formitem-max-width\">\n                <el-option v-for=\"item in selectList.benefit_gender_list\" :key=\"item.k\" :label=\"item.v\" :value=\"item.k\">\n                </el-option>\n              </el-select>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <el-form-item prop=\"nationality\" label=\"国籍\">\n              <el-select v-model=\"bomisParams.editBomisForm.nationality\" filterable placeholder=\"请选择\" clearable\n                class=\"formitem-full-width formitem-max-width\">\n                <el-option v-for=\"item in selectList.nationality_list\" :key=\"item.k\" :label=\"item.v\" :value=\"item.k\">\n                </el-option>\n              </el-select>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <div style=\"height:28px;line-height:28px;font-size:14px;color:#606266;\">\n              出生年月\n              <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n              <span style=\"color:#F56C6C;font-size:12px;\">请按照“1990-01-01”的格式填写</span>\n            </div>\n            <el-form-item prop=\"birthday\">\n              <el-input v-model=\"bomisParams.editBomisForm.birthday\" placeholder=\"\" clearable\n                class=\"formitem-full-width formitem-max-width\" />\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <el-form-item prop=\"mobno1\" label=\"联系方式（手机）\">\n              <el-input v-model=\"bomisParams.editBomisForm.mobno1\" placeholder=\"请输入\" clearable\n                class=\"formitem-full-width formitem-max-width\"></el-input>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <el-form-item prop=\"mobno2\" label=\"联系方式（固话）\">\n              <el-input v-model=\"bomisParams.editBomisForm.mobno2\" placeholder=\"请输入\" clearable\n                class=\"formitem-full-width formitem-max-width\"></el-input>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <el-form-item label=\"联系地址\" prop=\"address\">\n              <el-input v-model=\"bomisParams.editBomisForm.address\" placeholder=\"联系地址\"\n                class=\"formitem-full-width formitem-max-width\"></el-input>\n            </el-form-item>\n          </el-col>\n        </el-row>\n\n      </el-form>\n      <div v-show=\"false\"\n        style=\"border-width: 1px; border-style: solid; border-color: #2463eb #d1d6db #d1d6db;border-radius: 2px;\">\n      </div>\n      <div style=\"display: flex;justify-content: center;margin: 1em 0 0;\">\n        <el-button type=\"warning\" size=\"mini\" @click=\"addBomisBnfInfo\">添加</el-button>\n      </div>\n      <!-- 待核验的受益所有人数据 -->\n      <el-table :data=\"bomisParams.bomisSourceTableData\" border style=\"width: 100%;margin: 1em 0 0;\"\n        :header-cell-style=\"{ background: '#EDF3FE' }\" size=\"mini\">\n        <el-table-column prop=\"related_name\" label=\"姓名\" width=\"120\"></el-table-column>\n        <el-table-column prop=\"gender\" label=\"性别\" width=\"70\"><template slot-scope=\"scope\">{{\n            formatMultipleDictMap('benefit_gender_list',scope.row.gender) }}</template></el-table-column>\n        <el-table-column prop=\"nationality_name\" label=\"国籍\" width=\"160\"><template slot-scope=\"scope\">{{\n            formatMultipleDictMap('nationality_list',scope.row.nationality) }}</template></el-table-column>\n        <el-table-column prop=\"birthday\" label=\"出生日期\" width=\"160\"></el-table-column>\n        <el-table-column prop=\"id_type\" label=\"证件类型\" width=\"220\"><template slot-scope=\"scope\">{{\n            formatMultipleDictMap('id_type_gr_list',scope.row.id_type) }}</template></el-table-column>\n        <el-table-column prop=\"id_no\" label=\"证件号码\" width=\"260\"></el-table-column>\n        <el-table-column prop=\"id_range\" label=\"证件有效期\" width=\"260\"><template slot-scope=\"scope\">{{\n            scope.row.id_begindate + '~' + scope.row.id_enddate }}</template></el-table-column>\n        <el-table-column prop=\"address\" label=\"联系地址\" width=\"300\"></el-table-column>\n        <!-- <el-table-column prop=\"company_name\" label=\"企业性质\" width=\"300\"></el-table-column> -->\n        <el-table-column prop=\"bnf_type\" label=\"受益所有权关系类型\" width=\"300\"><template slot-scope=\"scope\">{{\n            formatMultipleDictMap('bnf_type_new_list',scope.row.bnf_type_str) }}</template></el-table-column>\n\n        <el-table-column prop=\"acthdrat\" label=\"持有股权、股份或者合伙权益的比例（%)\" width=\"160\"></el-table-column>\n        <el-table-column prop=\"shareratiostartdate\" label=\"形成日期(股权、股份或者合伙权益)\" width=\"160\"></el-table-column>\n        <el-table-column prop=\"shareratioenddate\" label=\"终止日期(股权、股份或者合伙权益)\" width=\"160\"></el-table-column>\n\n        <el-table-column prop=\"actownerprofitratio\" label=\"持有收益权的比例(%)\" width=\"160\"></el-table-column>\n        <el-table-column prop=\"profitratiostartdate\" label=\"形成日期(收益权)\" width=\"160\"></el-table-column>\n        <el-table-column prop=\"profitratioenddate\" label=\"终止日期(收益权)\" width=\"160\"></el-table-column>\n\n        <el-table-column prop=\"actownerprofitratiovote\" label=\"持有表决权的比例(%)\" width=\"160\"></el-table-column>\n        <el-table-column prop=\"profitratiovotestartdate\" label=\"形成日期(表决权)\" width=\"160\"></el-table-column>\n        <el-table-column prop=\"profitratiovoteenddate\" label=\"终止日期(表决权)\" width=\"160\"></el-table-column>\n\n        <el-table-column prop=\"actctrltype\" label=\"实施实际控制的内容/方式\" width=\"300\"><template slot-scope=\"scope\">{{formatMultipleDictMap('benefit_actctrltype_list',scope.row.actctrltype_str) }}</template></el-table-column>\n        <el-table-column prop=\"actotherforms\" label=\"其他形式的具体内容\" width=\"160\"></el-table-column>\n        <el-table-column prop=\"obtainactdate\" label=\"形成日期(实施实际控制)\" width=\"160\"></el-table-column>\n        <el-table-column prop=\"terminationactdate\" label=\"终止日期(实施实际控制)\" width=\"160\"></el-table-column>\n        <el-table-column prop=\"actconuppermarket\" label=\"是否存在上一层备案主体\" width=\"150\"><template slot-scope=\"scope\">{{formatMultipleDictMap('benefit_yesno_list',scope.row.actconuppermarket) }}</template></el-table-column>\n        <el-table-column prop=\"actconupperentname\" label=\"实际控制备案主体的上一层备案主体名称\" width=\"240\"></el-table-column>\n        <el-table-column prop=\"actconuniscid\" label=\"实际控制备案主体的统一社会信用代码\" width=\"200\"></el-table-column>\n\n        <el-table-column prop=\"seniormgrpos\" label=\"负责日常经营管理的（高级管理）人员职位\" width=\"240\"><template slot-scope=\"scope\">{{formatMultipleDictMap('benefit_seniormgrpos_list',scope.row.seniormgrpos_str) }}</template></el-table-column>\n        <el-table-column prop=\"actdailymgmtpostother\" label=\"公司章程规定的其他（高级管理）人员的具体职位\" width=\"240\"></el-table-column>\n        <el-table-column prop=\"seniormgrposcn\" label=\"在华最高层级的高级管理人员职位\" width=\"240\"><template slot-scope=\"scope\">{{formatMultipleDictMap('benefit_seniormgrposcn_list',scope.row.seniormgrposcn_str) }}</template></el-table-column>\n        <el-table-column prop=\"ownerrightmgmtpostother\" label=\"在华最高层级的高级管理其他职位\" width=\"240\"></el-table-column>\n        <el-table-column label=\"操作\" width=\"100\" fixed=\"right\">\n          <template slot-scope=\"scope\">\n            <el-button @click=\"showBenefitEditDialog(scope.row)\" type=\"text\" size=\"small\">修改</el-button>\n            <el-button @click=\"delBomisBnfInfo(scope.row)\" type=\"text\" size=\"small\">删除</el-button>\n          </template>\n        </el-table-column>\n      </el-table>\n      <div style=\"display: flex;justify-content: center;margin: 1em 0 0;\">\n        <el-button @click=\"onlineBomisCheck\" type=\"warning\" size=\"mini\"\n          :disabled=\"bomisParams.onlineBomisCheckBtnDisable\">受益所有人信息核验</el-button>\n      </div>\n      <div v-show=\"bomisParams.bomisLastCheckResult.RETURN_MSG !== ''\"\n        style=\"border-width: 1px; border-style: solid; border-color: #d1d6db;border-radius: 2px;margin: 1em 0 0;padding: 10px 20px;line-height: 32px;\">\n        <el-row :gutter=\"24\">\n          <el-col :span=\"24\">\n            核验结果：{{ bomisParams.bomisLastCheckResult.RETURN_MSG }}\n          </el-col>\n          <el-col :span=\"24\">\n            核验时间：{{ bomisParams.bomisLastCheckResult.op_time }}\n          </el-col>\n          <el-col :span=\"24\">\n            比对受益所有权结果： {{ bomisParams.bomisLastCheckResult.COMPARE_REMARK }}\n          </el-col>\n        </el-row>\n      </div>\n      <div style=\"margin: 1em 0 0;\" v-show=\"bomisParams.bomisLastCheckResult.RETURN_MSG !== ''\">\n        <div style=\"font-weight: bold;\">核验明细：</div>\n        <el-table :data=\"bomisParams.bomisLastCheckResultList\" border style=\"width: 100%;margin: 0.5em 0 0;\"\n          :header-cell-style=\"{ background: '#EDF3FE' }\" size=\"mini\">\n          <el-table-column prop=\"check_type_name\" label=\"差异类型\" width=\"150\" fixed=\"left\"></el-table-column>\n          <el-table-column prop=\"name\" label=\"姓名\" width=\"120\"></el-table-column>\n          <el-table-column prop=\"gender\" label=\"性别\" width=\"70\"><template slot-scope=\"scope\">{{\n              formatMultipleDictMap('benefit_gender_list',scope.row.gender) }}</template></el-table-column>\n          <el-table-column prop=\"ntlty\" label=\"国籍\" width=\"160\"><template slot-scope=\"scope\">{{\n              formatMultipleDictMap('bomis_nationality_list',scope.row.ntlty) }}</template></el-table-column>\n          <el-table-column prop=\"birthdt\" label=\"出生日期\" width=\"160\"></el-table-column>\n          <el-table-column prop=\"idtp\" label=\"证件类型\" width=\"220\"><template slot-scope=\"scope\">{{\n              formatMultipleDictMap('benefit_id_type_list',scope.row.idtp) }}</template></el-table-column>\n          <el-table-column prop=\"idnb\" label=\"证件号码\" width=\"260\"></el-table-column>\n          <el-table-column prop=\"iddate\" label=\"证件有效期\" width=\"260\"></el-table-column>\n          <el-table-column prop=\"addr\" label=\"联系地址\" width=\"300\"></el-table-column>\n          <el-table-column prop=\"mobno1\" label=\"联系电话(手机)\" width=\"300\"></el-table-column>\n          <el-table-column prop=\"mobno2\" label=\"联系电话(固定电话)\" width=\"300\"></el-table-column>\n\n          <el-table-column prop=\"acthdrat\" label=\"持有股权、股份或者合伙权益的比例（%)\" width=\"160\"></el-table-column>\n          <el-table-column prop=\"shareratiostartdate\" label=\"形成日期(股权、股份或者合伙权益)\" width=\"160\"></el-table-column>\n          <el-table-column prop=\"shareratioenddate\" label=\"终止日期(股权、股份或者合伙权益)\" width=\"160\"></el-table-column>\n\n          <el-table-column prop=\"actownerprofitratio\" label=\"持有收益权的比例(%)\" width=\"160\"></el-table-column>\n          <el-table-column prop=\"profitratiostartdate\" label=\"形成日期(收益权)\" width=\"160\"></el-table-column>\n          <el-table-column prop=\"profitratioenddate\" label=\"终止日期(收益权)\" width=\"160\"></el-table-column>\n\n          <el-table-column prop=\"actownerprofitratiovote\" label=\"持有表决权的比例(%)\" width=\"160\"></el-table-column>\n          <el-table-column prop=\"profitratiovotestartdate\" label=\"形成日期(表决权)\" width=\"160\"></el-table-column>\n          <el-table-column prop=\"profitratiovoteenddate\" label=\"终止日期(表决权)\" width=\"160\"></el-table-column>\n\n          <el-table-column prop=\"actctrltype\" label=\"实施实际控制的内容/方式\" width=\"300\"><template slot-scope=\"scope\">{{formatMultipleDictMap('benefit_actctrltype_list',scope.row.actctrltype) }}</template></el-table-column>\n          <el-table-column prop=\"actotherforms\" label=\"其他形式的具体内容\" width=\"160\"></el-table-column>\n          <el-table-column prop=\"obtainactdate\" label=\"形成日期(实施实际控制)\" width=\"160\"></el-table-column>\n          <el-table-column prop=\"terminationactdate\" label=\"终止日期(实施实际控制)\" width=\"160\"></el-table-column>\n          <el-table-column prop=\"actconuppermarket\" label=\"是否存在上一层备案主体\" width=\"150\"><template slot-scope=\"scope\">{{formatMultipleDictMap('benefit_yesno_list',scope.row.actconuppermarket) }}</template></el-table-column>\n          <el-table-column prop=\"actconupperentname\" label=\"实际控制备案主体的上一层备案主体名称\" width=\"240\"></el-table-column>\n          <el-table-column prop=\"actconuniscid\" label=\"实际控制备案主体的统一社会信用代码\" width=\"200\"></el-table-column>\n\n          <el-table-column prop=\"seniormgrpos\" label=\"负责日常经营管理的（高级管理）人员职位\" width=\"240\"><template slot-scope=\"scope\">{{formatMultipleDictMap('benefit_seniormgrpos_list',scope.row.seniormgrpos) }}</template></el-table-column>\n          <el-table-column prop=\"actdailymgmtpostother\" label=\"公司章程规定的其他（高级管理）人员的具体职位\" width=\"240\"></el-table-column>\n          <el-table-column prop=\"seniormgrposcn\" label=\"在华最高层级的高级管理人员职位\" width=\"240\"><template slot-scope=\"scope\">{{formatMultipleDictMap('benefit_seniormgrposcn_list',scope.row.seniormgrposcn) }}</template></el-table-column>\n          <el-table-column prop=\"ownerrightmgmtpostother\" label=\"在华最高层级的高级管理其他职位\" width=\"240\"></el-table-column>\n        </el-table>\n      </div>\n    </div>\n    <div slot=\"footer\" class=\"dialog-footer\">\n      <!-- <el-button type=\"primary\">保存受益人信息</el-button> -->\n      <el-button @click=\"closeDialog('bomisDialog')\">取消</el-button>\n      <!-- <el-button type=\"primary\" @click=\"saveEditForm('1','2')\"\n        v-if=\"editForm1.related_type!=='1'&&editForm1.related_type!=='4'\">提交并录入下一条</el-button>\n      <el-button type=\"primary\" @click=\"saveEditForm('2','2')\">提交</el-button> -->\n    </div>\n  </el-dialog>\n  <!-- 6 新版受益所有人 对单个受益所有人编辑 -->\n  <el-dialog title=\"受益人信息修改\" :visible.sync=\"bomisParams.benefitEditDialogVisible\" width=\"80%\"\n    :close-on-click-modal=\"false\" @close=\"closeDialog('bomisBenefitDialog')\" custom-class=\"benefit-scroll-dialog\">\n    <div>\n      <el-form :model=\"bomisParams.editOneBenefitForm\" ref=\"editOneBenefitForm\"\n        :rules=\"bomisParams.editOneBenefitFormRules\" label-width=\"280px\" label-position=\"top\"\n        :class=\"['register-form', {'hide-required-mark': shouldHideRequiredMark}]\" :hide-required-asterisk=\"false\"\n        size=\"mini\">\n        <el-row :gutter=\"24\">\n          <el-col :span=\"8\">\n            <el-form-item label=\"受益所有人\" prop=\"bo_type\">\n              <el-select clearable v-model=\"bomisParams.editOneBenefitForm.bo_type\" placeholder=\"请选择\"\n                class=\"formitem-full-width formitem-max-width\"\n                @change=\"bomisBoTypeChange(bomisParams.editOneBenefitForm.bo_type, bomisParams.editOneBenefitForm)\">\n                <el-option v-for=\"item in selectList.benefit_flag_list\" :key=\"item.k\" :label=\"item.v\" :value=\"item.k\">\n                </el-option>\n              </el-select>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <el-form-item label=\"企业性质\" prop=\"company_type\">\n              <el-select clearable v-model=\"bomisParams.editOneBenefitForm.company_type\" placeholder=\"请选择\"\n                @change=\"bomisCompanyTypeChange(bomisParams.editOneBenefitForm.company_type, bomisParams.editOneBenefitForm)\"\n                @visible-change=\"getBomisCompanyType(bomisParams.editOneBenefitForm)\"\n                class=\"formitem-full-width formitem-max-width\">\n                <el-option v-for=\"item in bomisParams.benefit_company_no_list\" :key=\"item.k\" :label=\"item.v\"\n                  :value=\"item.k\"> </el-option>\n              </el-select>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"24\">\n            <el-form-item label=\"受益所有权类型\" prop=\"bnf_type\">\n              <el-select clearable v-model=\"bomisParams.editOneBenefitForm.bnf_type\" placeholder=\"请选择\" multiple\n                class=\"formitem-full-width formitem-24-max-width\"\n                @change=\"bomisBnfTypeChange(bomisParams.editOneBenefitForm.bnf_type, bomisParams.editOneBenefitForm)\"\n                @visible-change=\"getBomisBnfType(bomisParams.editOneBenefitForm)\">\n                <el-option v-for=\"item in bomisParams.bnf_type_new_list\" :key=\"item.k\" :label=\"item.v\" :value=\"item.k\"\n                  :disabled=\"item.disabled === true\">\n                </el-option>\n              </el-select>\n            </el-form-item>\n          </el-col>\n        </el-row>\n        <!-- 持有股权、股份或者合伙权益 -->\n        <el-row :gutter=\"24\"\n          v-if=\"bomisParams.editOneBenefitForm.bnf_type.includes('NA1') || bomisParams.editOneBenefitForm.bnf_type.includes('NB1') ||bomisParams.editOneBenefitForm.bnf_type.includes('ND1') \">\n          <el-col :span=\"8\">\n            <el-form-item label=\"持有股权、股份或者合伙权益的比例（%)\" prop=\"acthdrat\">\n              <el-input-number type=\"number\" v-model=\"bomisParams.editOneBenefitForm.acthdrat\" :min=\"25\" :max=\"100\"\n                class=\"formitem-full-width formitem-max-width\" />\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <div style=\"height:28px;line-height:28px;font-size:14px;color:#606266;\">\n              <span v-if=\"bomisParams.editOneBenefitForm.bnf_type.includes('NA1')\">形成日期(股权、股份) </span>\n              <span v-if=\"bomisParams.editOneBenefitForm.bnf_type.includes('NB1')\">形成日期(合伙权益) </span>\n              <span v-if=\"bomisParams.editOneBenefitForm.bnf_type.includes('ND1')\">形成日期(股权、份额) </span>\n              <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n              <span style=\"color:#F56C6C;font-size:12px;\">如需手动填写，请按照“1990-01-01”的格式填写</span>\n            </div>\n            <el-form-item prop=\"shareratiostartdate\">\n              <el-date-picker v-model=\"bomisParams.editOneBenefitForm.shareratiostartdate\" type=\"date\"\n                placeholder=\"选择日期\" format=\"yyyy-MM-dd\" clearable editable\n                class=\"formitem-full-width formitem-max-width\" />\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <div style=\"height:28px;line-height:28px;font-size:14px;color:#606266;\">\n              终止日期(股权、股份)\n              <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n              <span style=\"color:#F56C6C;font-size:12px;\">如需手动填写，请按照“1990-01-01”的格式填写</span>\n            </div>\n            <el-form-item prop=\"shareratioenddate\">\n              <el-date-picker v-model=\"bomisParams.editOneBenefitForm.shareratioenddate\" type=\"date\" placeholder=\"选择日期\"\n                format=\"yyyy-MM-dd\" clearable editable class=\"formitem-full-width formitem-max-width\" />\n            </el-form-item>\n          </el-col>\n        </el-row>\n        <!-- 收益权 -->\n        <el-row :gutter=\"24\"\n          v-if=\"bomisParams.editOneBenefitForm.bnf_type.includes('NA2-1') || bomisParams.editOneBenefitForm.bnf_type.includes('NB2-1') || bomisParams.editOneBenefitForm.bnf_type.includes('ND2-1')\">\n          <el-col :span=\"8\">\n            <el-form-item label=\"持有收益权的比例(%)\" prop=\"actownerprofitratio\">\n              <el-input-number type=\"number\" v-model=\"bomisParams.editOneBenefitForm.actownerprofitratio\"\n                class=\"formitem-full-width formitem-max-width\" />\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <div style=\"height:28px;line-height:28px;font-size:14px;color:#606266;\">\n              形成日期(收益权)\n              <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n              <span style=\"color:#F56C6C;font-size:12px;\">如需手动填写，请按照“1990-01-01”的格式填写</span>\n            </div>\n            <el-form-item prop=\"profitratiostartdate\">\n              <el-date-picker v-model=\"bomisParams.editOneBenefitForm.profitratiostartdate\" type=\"date\"\n                placeholder=\"选择日期\" format=\"yyyy-MM-dd\" clearable editable\n                class=\"formitem-full-width formitem-max-width\" />\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <div style=\"height:28px;line-height:28px;font-size:14px;color:#606266;\">\n              终止日期(收益权)\n              <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n              <span style=\"color:#F56C6C;font-size:12px;\">如需手动填写，请按照“1990-01-01”的格式填写</span>\n            </div>\n            <el-form-item prop=\"profitratioenddate\">\n              <el-date-picker v-model=\"bomisParams.editOneBenefitForm.profitratioenddate\" type=\"date\" placeholder=\"选择日期\"\n                format=\"yyyy-MM-dd\" clearable editable class=\"formitem-full-width formitem-max-width\" />\n            </el-form-item>\n          </el-col>\n        </el-row>\n        <!-- 表决权 -->\n        <el-row :gutter=\"24\"\n          v-if=\"bomisParams.editOneBenefitForm.bnf_type.includes('NA2-2') || bomisParams.editOneBenefitForm.bnf_type.includes('NB2-2') || bomisParams.editOneBenefitForm.bnf_type.includes('ND2-2')\">\n          <el-col :span=\"8\">\n            <el-form-item label=\"持有表决权的比例(%)\" prop=\"actownerprofitratiovote\">\n              <el-input-number type=\"number\" v-model=\"bomisParams.editOneBenefitForm.actownerprofitratiovote\"\n                class=\"formitem-full-width formitem-max-width\" />\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <div style=\"height:28px;line-height:28px;font-size:14px;color:#606266;\">\n              形成日期(表决权)\n              <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n              <span style=\"color:#F56C6C;font-size:12px;\">如需手动填写，请按照“1990-01-01”的格式填写</span>\n            </div>\n            <el-form-item prop=\"profitratiovotestartdate\">\n              <el-date-picker v-model=\"bomisParams.editOneBenefitForm.profitratiovotestartdate\" type=\"date\"\n                placeholder=\"选择日期\" format=\"yyyy-MM-dd\" clearable editable\n                class=\"formitem-full-width formitem-max-width\" />\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <div style=\"height:28px;line-height:28px;font-size:14px;color:#606266;\">\n              终止日期(表决权)\n              <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n              <span style=\"color:#F56C6C;font-size:12px;\">如需手动填写，请按照“1990-01-01”的格式填写</span>\n            </div>\n            <el-form-item prop=\"profitratiovoteenddate\">\n              <el-date-picker v-model=\"bomisParams.editOneBenefitForm.profitratiovoteenddate\" type=\"date\"\n                placeholder=\"选择日期\" format=\"yyyy-MM-dd\" clearable editable\n                class=\"formitem-full-width formitem-max-width\" />\n            </el-form-item>\n          </el-col>\n        </el-row>\n        <!-- 实际实施控制 -->\n        <el-row :gutter=\"24\">\n          <el-col :span=\"24\"\n            v-if=\"bomisParams.editOneBenefitForm.bnf_type.includes('NA3-1') || bomisParams.editOneBenefitForm.bnf_type.includes('NA3-2') || bomisParams.editOneBenefitForm.bnf_type.includes('NB3-1') || bomisParams.editOneBenefitForm.bnf_type.includes('NB3-2') || bomisParams.editOneBenefitForm.bnf_type.includes('ND3')\">\n            <el-form-item prop=\"actctrltype\" label=\"实施实际控制的内容/方式\">\n              <el-select v-model=\"bomisParams.editOneBenefitForm.actctrltype\" filterable placeholder=\"请选择\" clearable\n                multiple class=\"formitem-full-width formitem-24-max-width\">\n                <el-option v-for=\"item in selectList.benefit_actctrltype_list\" :key=\"item.k\" :label=\"item.v\"\n                  :value=\"item.k\">\n                </el-option>\n              </el-select>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"24\"\n            v-if=\"bomisParams.editOneBenefitForm.bnf_type.includes('NA3-2') || bomisParams.editOneBenefitForm.bnf_type.includes('NB3-2') || bomisParams.editOneBenefitForm.bnf_type.includes('ND3')\">\n            <el-form-item prop=\"actotherforms\" label=\"其他形式的具体内容\">\n              <el-input v-model=\"bomisParams.editOneBenefitForm.actotherforms\" placeholder=\"请输入\" clearable\n                class=\"formitem-full-width formitem-24-max-width\">\n              </el-input>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\"\n            v-if=\"bomisParams.editOneBenefitForm.bnf_type.includes('NA3-1') || bomisParams.editOneBenefitForm.bnf_type.includes('NA3-2') || bomisParams.editOneBenefitForm.bnf_type.includes('NB3-1') || bomisParams.editOneBenefitForm.bnf_type.includes('NB3-2') || bomisParams.editOneBenefitForm.bnf_type.includes('ND3')\">\n            <div style=\"height:28px;line-height:28px;font-size:14px;color:#606266;\">\n              形成日期(实施实际控制)\n              <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n              <span style=\"color:#F56C6C;font-size:12px;\">如需手动填写，请按照“1990-01-01”的格式填写</span>\n            </div>\n            <el-form-item prop=\"obtainactdate\">\n              <el-date-picker v-model=\"bomisParams.editOneBenefitForm.obtainactdate\" type=\"date\" placeholder=\"选择日期\"\n                format=\"yyyy-MM-dd\" clearable editable class=\"formitem-full-width formitem-max-width\" />\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\"\n            v-if=\"bomisParams.editOneBenefitForm.bnf_type.includes('NA3-1') || bomisParams.editOneBenefitForm.bnf_type.includes('NA3-2') || bomisParams.editOneBenefitForm.bnf_type.includes('NB3-1') || bomisParams.editOneBenefitForm.bnf_type.includes('NB3-2') || bomisParams.editOneBenefitForm.bnf_type.includes('ND3')\">\n            <div style=\"height:28px;line-height:28px;font-size:14px;color:#606266;\">\n              终止日期(实施实际控制)\n              <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n              <span style=\"color:#F56C6C;font-size:12px;\">如需手动填写，请按照“1990-01-01”的格式填写</span>\n            </div>\n            <el-form-item prop=\"terminationactdate\">\n              <el-date-picker v-model=\"bomisParams.editOneBenefitForm.terminationactdate\" type=\"date\" placeholder=\"选择日期\"\n                format=\"yyyy-MM-dd\" clearable editable class=\"formitem-full-width formitem-max-width\" />\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\"\n            v-if=\"bomisParams.editOneBenefitForm.bnf_type.includes('NA3-1') || bomisParams.editOneBenefitForm.bnf_type.includes('NB3-1') || bomisParams.editOneBenefitForm.bnf_type.includes('ND3')\">\n            <el-form-item prop=\"actconuppermarket\" label=\"是否存在上一层备案主体\">\n              <el-select v-model=\"bomisParams.editOneBenefitForm.actconuppermarket\" filterable placeholder=\"请选择\"\n                clearable class=\"formitem-full-width formitem-max-width\">\n                <el-option v-for=\"item in selectList.benefit_yesno_list\" :key=\"item.k\" :label=\"item.v\" :value=\"item.k\">\n                </el-option>\n              </el-select>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\"\n            v-if=\"(bomisParams.editOneBenefitForm.bnf_type.includes('NA3-1') || bomisParams.editOneBenefitForm.bnf_type.includes('NB3-1') || bomisParams.editOneBenefitForm.bnf_type.includes('ND3')) && bomisParams.editOneBenefitForm.actconuppermarket === 'Y'\">\n            <el-form-item prop=\"actconupperentname\" label=\"实际控制备案主体的上一层备案主体名称\">\n              <el-input v-model=\"bomisParams.editOneBenefitForm.actconupperentname\" placeholder=\"请输入\" clearable\n                class=\"formitem-full-width formitem-max-width\">\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\"\n            v-if=\"(bomisParams.editOneBenefitForm.bnf_type.includes('NA3-1') || bomisParams.editOneBenefitForm.bnf_type.includes('NB3-1') || bomisParams.editOneBenefitForm.bnf_type.includes('ND3')) && bomisParams.editOneBenefitForm.actconuppermarket === 'Y'\">\n            <el-form-item prop=\"actconuniscid\" label=\"实际控制备案主体的统一社会信用代码\">\n              <el-input v-model=\"bomisParams.editOneBenefitForm.actconuniscid\" placeholder=\"请输入\" clearable\n                class=\"formitem-full-width formitem-max-width\">\n            </el-form-item>\n          </el-col>\n        </el-row>\n        <!-- 负责日常经营管理 -->\n        <el-row :gutter=\"24\">\n          <el-col :span=\"16\"\n            v-if=\"bomisParams.editOneBenefitForm.bnf_type.includes('NA4') || bomisParams.editOneBenefitForm.bnf_type.includes('NB4')\">\n            <el-form-item prop=\"seniormgrpos\" label=\"负责日常经营管理的（高级管理）人员职位\">\n              <el-select v-model=\"bomisParams.editOneBenefitForm.seniormgrpos\" filterable placeholder=\"请选择\" clearable\n                multiple class=\"formitem-full-width formitem-16-max-width\">\n                <el-option v-for=\"item in selectList.benefit_seniormgrpos_list\" :key=\"item.k\" :label=\"item.v\"\n                  :value=\"item.k\">\n                </el-option>\n              </el-select>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\"\n            v-if=\"(bomisParams.editOneBenefitForm.bnf_type.includes('NA4') || bomisParams.editOneBenefitForm.bnf_type.includes('NB4')) && bomisParams.editOneBenefitForm.seniormgrpos.includes('15')\">\n            <el-form-item prop=\"actdailymgmtpostother\" label=\"公司章程规定的其他（高级管理）人员的具体职位\">\n              <el-input v-model=\"bomisParams.editOneBenefitForm.actdailymgmtpostother\" placeholder=\"请输入\" clearable\n                class=\"formitem-full-width formitem-max-width\">\n            </el-form-item>\n          </el-col>\n        </el-row>\n        <!-- 在华最高层级的高级管理 -->\n        <el-row :gutter=\"24\">\n          <el-col :span=\"16\" v-if=\"bomisParams.editOneBenefitForm.bnf_type.includes('NA5')\">\n            <el-form-item prop=\"seniormgrposcn\" label=\"在华最高层级的高级管理人员职位\">\n              <el-select v-model=\"bomisParams.editOneBenefitForm.seniormgrposcn\" filterable placeholder=\"请选择\" clearable\n                multiple class=\"formitem-full-width formitem-16-max-width\">\n                <el-option v-for=\"item in selectList.benefit_seniormgrposcn_list\" :key=\"item.k\" :label=\"item.v\"\n                  :value=\"item.k\">\n                </el-option>\n              </el-select>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\"\n            v-if=\"bomisParams.editOneBenefitForm.bnf_type.includes('NA5') && bomisParams.editOneBenefitForm.seniormgrposcn.includes('1')\">\n            <el-form-item prop=\"ownerrightmgmtpostother\" label=\"在华最高层级的高级管理其他职位\">\n              <el-input v-model=\"bomisParams.editOneBenefitForm.ownerrightmgmtpostother\" placeholder=\"请输入\" clearable\n                class=\"formitem-full-width formitem-max-width\">\n            </el-form-item>\n          </el-col>\n        </el-row>\n        <el-row :gutter=\"24\">\n          <el-col :span=\"24\">\n            <!-- label=\"　\" -->\n            <el-form-item prop=\"full_info_flag\">\n              <el-radio-group v-model=\"bomisParams.editOneBenefitForm.full_info_flag\">\n                <el-radio key=\"full_info_flag01\" label=\"01\"\n                  @click.native=\"nativeRadioClick('01', bomisParams.editOneBenefitForm, 'full_info_flag')\" value=\"01\">\n                  透明度较高、信息披露充分的客户（如上市公司、国有企业）</el-radio>\n                <el-radio key=\"full_info_flag02\" label=\"02\"\n                  @click.native=\"nativeRadioClick('02', bomisParams.editOneBenefitForm, 'full_info_flag')\" value=\"02\">\n                  受益人信息不规范</el-radio>\n              </el-radio-group>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <el-form-item label=\"姓名\" prop=\"related_name\">\n              <el-select clearable v-model=\"bomisParams.editOneBenefitForm.related_name\" allow-create filterable\n                placeholder=\"请选择或手动输入\" @focus=\"selectRelaOptions('0')\"\n                :disabled=\"bomisParams.editOneBenefitForm.new_flag ? false : true\"\n                @change=\"setRelaValue(bomisParams.editOneBenefitForm.related_name,'bomisForm')\" default-first-option\n                class=\"formitem-full-width formitem-max-width\">\n                <el-option v-for=\"item in curRelaOptions\" :key=\"item.related_id\" :label=\"item.related_name\"\n                  :value=\"item.related_name\">\n                </el-option>\n              </el-select>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <el-form-item prop=\"id_type\" label=\"证件类型\">\n              <el-select v-model=\"bomisParams.editOneBenefitForm.id_type\" placeholder=\"请选择\" clearable\n                @change=\"clearIdNoValidate('editOneBenefitForm')\" class=\"formitem-full-width formitem-max-width\">\n                <el-option v-for=\"item in selectList.id_type_gr_list\" :key=\"item.k\" :label=\"item.v\" :value=\"item.k\">\n                </el-option>\n              </el-select>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <el-form-item prop=\"id_no\" label=\"证件编号\">\n              <el-input v-model=\"bomisParams.editOneBenefitForm.id_no\" placeholder=\"请输入\" clearable\n                class=\"formitem-full-width formitem-max-width\">\n              </el-input>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <div style=\"height:28px;line-height:28px;font-size:14px;color:#606266;\">\n              证件有效期\n              <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n              <span style=\"color:#F56C6C;font-size:12px;\">如需手动填写，请按照“1990-01-01”的格式填写</span>\n            </div>\n            <div style=\"display:flex;width:100%;gap:8px;\" class=\"formitem-max-width\">\n              <el-form-item prop=\"id_begindate\" style=\"flex:1;\">\n                <el-date-picker v-model=\"bomisParams.editOneBenefitForm.id_begindate\" type=\"date\" placeholder=\"开始日期\"\n                  class=\"formitem-full-width\" format=\"yyyy-MM-dd\" clearable>\n                </el-date-picker>\n              </el-form-item>\n              <div>~</div>\n              <el-form-item prop=\"id_enddate\" style=\"flex:1;\">\n                <el-date-picker v-model=\"bomisParams.editOneBenefitForm.id_enddate\" type=\"date\" placeholder=\"结束日期\"\n                  class=\"formitem-full-width\" format=\"yyyy-MM-dd\" align=\"right\"\n                  :picker-options=\"bomisParams.pickerOptions\" clearable>\n                </el-date-picker>\n              </el-form-item>\n            </div>\n          </el-col>\n          <el-col :span=\"8\">\n            <el-form-item prop=\"gender\" label=\"性别\">\n              <el-select v-model=\"bomisParams.editOneBenefitForm.gender\" placeholder=\"请选择\"\n                class=\"formitem-full-width formitem-max-width\">\n                <el-option v-for=\"item in selectList.benefit_gender_list\" :key=\"item.k\" :label=\"item.v\" :value=\"item.k\">\n                </el-option>\n              </el-select>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <el-form-item prop=\"nationality\" label=\"国籍\">\n              <el-select v-model=\"bomisParams.editOneBenefitForm.nationality\" filterable placeholder=\"请选择\" clearable\n                class=\"formitem-full-width formitem-max-width\">\n                <el-option v-for=\"item in selectList.nationality_list\" :key=\"item.k\" :label=\"item.v\" :value=\"item.k\">\n                </el-option>\n              </el-select>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <div style=\"height:28px;line-height:28px;font-size:14px;color:#606266;\">\n              出生年月\n              <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n              <span style=\"color:#F56C6C;font-size:12px;\">请按照“1990-01-01”的格式填写</span>\n            </div>\n            <el-form-item prop=\"birthday\">\n              <el-input v-model=\"bomisParams.editOneBenefitForm.birthday\" placeholder=\"\" clearable\n                class=\"formitem-full-width formitem-max-width\" />\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <el-form-item prop=\"mobno1\" label=\"联系方式（手机）\">\n              <el-input v-model=\"bomisParams.editOneBenefitForm.mobno1\" placeholder=\"请输入\" clearable\n                class=\"formitem-full-width formitem-max-width\"></el-input>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <el-form-item prop=\"mobno2\" label=\"联系方式（固话）\">\n              <el-input v-model=\"bomisParams.editOneBenefitForm.mobno2\" placeholder=\"请输入\" clearable\n                class=\"formitem-full-width formitem-max-width\"></el-input>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <el-form-item label=\"联系地址\" prop=\"address\">\n              <el-input v-model=\"bomisParams.editOneBenefitForm.address\" placeholder=\"联系地址\"\n                class=\"formitem-full-width formitem-max-width\"></el-input>\n            </el-form-item>\n          </el-col>\n        </el-row>\n\n      </el-form>\n    </div>\n    <div slot=\"footer\" class=\"dialog-footer\">\n      <el-button @click=\"closeDialog('bomisBenefitDialog')\">取消</el-button>\n      <el-button type=\"primary\" @click=\"editBomisBnfInfo\">保存</el-button>\n      <!-- <el-button type=\"primary\" @click=\"saveEditForm('1','2')\"\n        v-if=\"editForm1.related_type!=='1'&&editForm1.related_type!=='4'\">提交并录入下一条</el-button>\n      <el-button type=\"primary\" @click=\"saveEditForm('2','2')\">提交</el-button> -->\n    </div>\n  </el-dialog>\n</div>"
                  },
                  "_expanded": true,
                  "hasDupCid": 0,
                  "events": {
                    "ready": "let comp = this;\ncomp.vue = new Vue({\n  el: this.bodyEl.query('#app'),\n  // el: comp.el.addEl(),\n  //   template: `\n  // `,\n  data() {\n    return {\n      organ_flag: '_$organ_flag$_',\n      client_id: '_$client_id$_',\n      client_belong: '_$client_belong$_',// 客户归属\n      data_type: '_$data_type$_',\n      selectList: app.data.selectList,\n      isScroll: true,\n      fileDialogDisabled: false,\n      navList: [\n        {\n          label: '客户基本信息',\n          value: 'basicInfo',\n          name: '#basicInfo'\n        }, {\n          label: '反洗钱特殊情况',\n          value: 'fxqSpecial',\n          name: '#fxqSpecial'\n        }, {\n          label: '法定代表人',\n          value: 'LegalRep',\n          name: '#LegalRep'\n        }, {\n          label: '控股股东',\n          value: 'controllingShareholder',\n          name: '#controllingShareholder'\n        }, {\n          label: '实际控制人',\n          value: 'actualController',\n          name: '#actualController'\n        }, {\n          label: '授权代表人',\n          value: 'authorizedRep',\n          name: '#authorizedRep'\n        }, {\n          label: '受益所有人',\n          value: 'beneficialOwner',\n          name: '#beneficialOwner'\n        },\n      ],\n      attachmentList: {\n        'basicInfo': [],\n        'LegalRep': [],\n        'controllingShareholder': [],\n        'actualController': [],\n        'authorizedRep': [],\n        'beneficialOwner': [],\n        'communication': [],// 与客户沟通记录\n        'agree': [],// 二级部门负责人同意的记录\n        'other': [] // 其他底稿\n      },\n      activeNav: 'basicInfo',\n      basicInfo: app.data.basicInfo,\n      relatedInfo1: app.data.relatedInfo1,// 法定代表人\n      relatedInfo2: app.data.relatedInfo2,// 控股股东\n      relatedInfo3: app.data.relatedInfo3,// 实际控制人\n      relatedInfo4: app.data.relatedInfo4,// 授权代表人\n      relatedInfo5: app.data.relatedInfo5,// 受益所有人\n      ruleForm1: {},\n      ruleForm2: {},\n      ruleForm3: {\n        is_special: '0',\n        client_type: [],\n        client_type_other: '',\n        special_matters: [],\n        missing_information: '',\n        missing_draft: '',\n        special_matters_other: '',\n        special_reason: '',\n        completed_cdd: '',\n        low_risk_explanation: '',\n        take_measures: ''\n      },\n      editForm: {\n        related_name: '',\n        organ_flag: '0',\n        nationality: '',\n        id_type: '',\n        id_no: '',\n        id_begindate: '',\n        id_enddate: '',\n        birthday: '',\n        is_government_dept: '',\n        beneficiary: '',\n        shareholding_ratio: '',\n        address: '',\n        related_type: '',\n        title: '',\n        new_flag: null,\n      },\n      editForm1: {\n        related_name: '',\n        organ_flag: '0',\n        nationality: '',\n        id_type: '',\n        id_no: '',\n        id_begindate: '',\n        id_enddate: '',\n        birthday: '',\n        is_government_dept: '',\n        related_type: '',\n        title: '',\n        beneficiary: '',\n        shareholding_ratio: '',\n        address: '',\n        mobno1: '',\n        new_flag: null,\n      },\n      bomisParams: {\n        dialogBomisVisible: false, // bomis受益人核验窗口\n        benefitEditDialogVisible: false, // bomis受益人核验窗口中编辑单个受益人信息\n        onlineBomisCheckBtnDisable: true,\n        benefit_company_no_list: [], // 需要对this.selectList.benefit_company_no_list结合受益人类型进行过滤\n        bnf_type_new_list: [], // 需要对this.selectList.bnf_type_new_list结合企业性质进行过滤\n        cityOptions: [], // 地址\n        districtOptions: [], // 地址\n        editBomisForm: {\n          bo_type: '', // 受益人类型\n          company_type: '', // 企业性质\n          bnf_type: [],\n          common_rate: '',\n          full_info_flag: '',\n\n          actctrltype: [],\n          seniormgrpos: [],\n          seniormgrposcn: [],\n\n          related_name: '',\n          organ_flag: '0',\n          nationality: '',\n          id_type: '',\n          id_no: '',\n          id_begindate: '',\n          id_enddate: '',\n          birthday: '',\n          is_government_dept: '',\n          related_type: '',\n          title: '',\n          beneficiary: '',\n          shareholding_ratio: '',\n\n          province: '',\n          city: '',\n          district: '',\n          address: '',\n\n          mobno1: '',\n          new_flag: true,\n        },\n        editBomisFormRules: {\n          bo_type: [{ required: true, message: '请选择是否识别受益所有人', trigger: 'change' }],\n          company_type: [{ required: true, message: '请选择企业性质', trigger: 'change' }],\n          full_info_flag: [{ required: true, message: '请选择', trigger: 'change' }],\n          acthdrat: [{ required: true, message: '请填写', trigger: 'change' }],\n          shareratiostartdate: [{ required: true, message: '请选择', trigger: 'change' }],\n          shareratioenddate: [{ required: true, message: '请选择', trigger: 'change' }],\n          actownerprofitratio: [{ required: true, message: '请填写', trigger: 'change' }],\n          profitratiostartdate: [{ required: true, message: '请选择', trigger: 'change' }],\n          profitratioenddate: [{ required: true, message: '请选择', trigger: 'change' }],\n          actownerprofitratiovote: [{ required: true, message: '请填写', trigger: 'change' }],\n          profitratiovotestartdate: [{ required: true, message: '请选择', trigger: 'change' }],\n          profitratiovoteenddate: [{ required: true, message: '请选择', trigger: 'change' }],\n          actctrltype: [{ required: true, message: '请选择', trigger: 'change' }],\n          actotherforms: [{ required: true, message: '请填写', trigger: 'change' }],\n          obtainactdate: [{ required: true, message: '请选择', trigger: 'change' }],\n          terminationactdate: [{ required: true, message: '请选择', trigger: 'change' }],\n          actconuppermarket: [{ required: true, message: '请选择', trigger: 'change' }],\n          actconupperentname: [{ required: true, message: '请填写', trigger: 'change' }],\n          actconuniscid: [{ required: true, message: '请填写', trigger: 'change' }],\n          seniormgrpos: [{ required: true, message: '请选择', trigger: 'change' }],\n          actdailymgmtpostother: [{ required: true, message: '请填写', trigger: 'change' }],\n          seniormgrposcn: [{ required: true, message: '请选择', trigger: 'change' }],\n          ownerrightmgmtpostother: [{ required: true, message: '请填写', trigger: 'change' }],\n\n          related_name: [{ required: true, message: '请填写', trigger: 'change' }],\n          gender: [{ required: true, message: '请填写', trigger: 'change' }],\n          nationality: [{ required: true, message: '请填写', trigger: 'change' }],\n          birthday: [{ required: true, message: '请填写', trigger: 'change' }],\n        },\n        pickerOptions: {\n          shortcuts: [{\n            text: '长期',\n            onClick(picker) {\n              picker.$emit('pick', '9999-12-31')\n            }\n          }]\n        },\n        bomisSourceTableData: [], // 待发送核验的受益人数据\n        bomisLastCheckResult: {\n          \"RETURN_CODE\": \"\",\n          \"RETURN_MSG\": \"\",\n          \"NoDiffList\": [],\n          \"COMPARE_REMARK\": \"\"\n        },\n        bomisLastCheckResultList: [], // 核验后返回的受益人数据\n        editOneBenefitForm: {\n          bo_type: '', // 受益人类型\n          company_type: '', // 企业性质\n          bnf_type: [],\n          common_rate: '',\n          full_info_flag: '',\n\n          actctrltype: [],\n          seniormgrpos: [],\n          seniormgrposcn: [],\n\n          related_name: '',\n          organ_flag: '0',\n          nationality: '',\n          id_type: '',\n          id_no: '',\n          id_begindate: '',\n          id_enddate: '',\n          birthday: '',\n          is_government_dept: '',\n          related_type: '',\n          title: '',\n          beneficiary: '',\n          shareholding_ratio: '',\n\n          province: '',\n          city: '',\n          district: '',\n          address: '',\n\n          mobno1: '',\n          new_flag: false,\n        },\n        editOneBenefitFormRules: {\n          bo_type: [{ required: true, message: '请选择是否识别受益所有人', trigger: 'change' }],\n          company_type: [{ required: true, message: '请选择企业性质', trigger: 'change' }],\n          full_info_flag: [{ required: true, message: '请选择', trigger: 'change' }],\n          acthdrat: [{ required: true, message: '请填写', trigger: 'change' }],\n          shareratiostartdate: [{ required: true, message: '请选择', trigger: 'change' }],\n          shareratioenddate: [{ required: true, message: '请选择', trigger: 'change' }],\n          actownerprofitratio: [{ required: true, message: '请填写', trigger: 'change' }],\n          profitratiostartdate: [{ required: true, message: '请选择', trigger: 'change' }],\n          profitratioenddate: [{ required: true, message: '请选择', trigger: 'change' }],\n          actownerprofitratiovote: [{ required: true, message: '请填写', trigger: 'change' }],\n          profitratiovotestartdate: [{ required: true, message: '请选择', trigger: 'change' }],\n          profitratiovoteenddate: [{ required: true, message: '请选择', trigger: 'change' }],\n          actctrltype: [{ required: true, message: '请选择', trigger: 'change' }],\n          actotherforms: [{ required: true, message: '请填写', trigger: 'change' }],\n          obtainactdate: [{ required: true, message: '请选择', trigger: 'change' }],\n          terminationactdate: [{ required: true, message: '请选择', trigger: 'change' }],\n          actconuppermarket: [{ required: true, message: '请选择', trigger: 'change' }],\n          actconupperentname: [{ required: true, message: '请填写', trigger: 'change' }],\n          actconuniscid: [{ required: true, message: '请填写', trigger: 'change' }],\n          seniormgrpos: [{ required: true, message: '请选择', trigger: 'change' }],\n          actdailymgmtpostother: [{ required: true, message: '请填写', trigger: 'change' }],\n          seniormgrposcn: [{ required: true, message: '请选择', trigger: 'change' }],\n          ownerrightmgmtpostother: [{ required: true, message: '请填写', trigger: 'change' }],\n\n          related_name: [{ required: true, message: '请填写', trigger: 'change' }],\n          gender: [{ required: true, message: '请填写', trigger: 'change' }],\n          nationality: [{ required: true, message: '请填写', trigger: 'change' }],\n          birthday: [{ required: true, message: '请填写', trigger: 'change' }],\n        },\n      },\n      curRelaOptions: [],//当前关联人弹窗能选择的关联人\n      rules: app.data.rules,\n      rules1: app.data.rules1,\n      associated_date: '',//建立业务关系日期\n      remark: '',//备注\n      // 省市区\n      proOptions: [], // 省\n      cityOptions: [],// 办公地址市\n      districtOptions: [],// 办公地址区\n      cityOptions1: [],// 证件地址市\n      districtOptions1: [],// 证件地址区\n      cityOptions2: [],// 联系地址市\n      districtOptions2: [],// 联系地址区\n\n      attachments: [],\n      // 非自然人附件目录\n      directoryConfig1: app.data.directory.directoryConfig1,\n      // 自然人附件目录\n      directoryConfig2: app.data.directory.directoryConfig2,\n      fileList: [],\n      fileDialogVisible: false,\n      dialogFormVisible: false,//关联主体登记弹窗\n      dialogFormVisible1: false,\n      selectedMenu: 1,//选中的目录\n      uploadParams: {\n        objectId: Wb.getId(),\n        client_id: '_$client_id$_'\n      },\n      uploadParams1: {\n        objectId: '_$client_id$_' + 'communication',\n        client_id: '_$client_id$_'\n      },\n      uploadParams2: {\n        objectId: '_$client_id$_' + 'agree',\n        client_id: '_$client_id$_'\n      },\n      uploadParams3: {\n        objectId: '_$client_id$_' + 'other',\n        client_id: '_$client_id$_'\n      },\n      previewUrl: '',\n      pickerOptions: {\n        shortcuts: [{\n          text: '长期',\n          onClick(picker) {\n            picker.$emit('pick', '2100-12-31')\n          }\n        }]\n      },\n      loading: true\n    };\n  },\n  computed: {\n    // 是否隐藏表单项必填标记（*号）\n    shouldHideRequiredMark() {\n      return (this.ruleForm3 && this.ruleForm3.is_special === '1') || (this.editForm.is_government_dept === '1');\n    }\n  },\n  methods: {\n    beforeRemove(file, fileList) {\n      // 直接返回 false，阻止删除\n      return false;\n\n      // 如果你希望给用户一个提示，可以这样写：\n      // this.$message.warning('当前附件不允许删除');\n      // return false;\n    },\n    // 清空证件号码的校验提示（当证件类型改变时）\n    clearIdNoValidate(formType) {\n      // 根据表单类型获取对应的表单引用\n      let formRef;\n      if (formType === 'ruleForm1') {\n        formRef = this.$refs.ruleForm1;\n      } else if (formType === 'ruleForm2') {\n        formRef = this.$refs.ruleForm2;\n      } else if (formType === 'editForm') {\n        formRef = this.$refs.editForm;\n      } else if (formType === 'editForm1') {\n        formRef = this.$refs.editForm1;\n      } else if (formType === 'editBomisForm') {\n        formRef = this.$refs.editBomisForm;\n      }\n\n      // 清空证件号码字段的校验提示\n      if (formRef) {\n        formRef.clearValidate('id_no');\n      }\n    },\n    // 校验身份证格式\n    validateIdCard(rule, value, callback) {\n      if (!value) {\n        callback();\n        return;\n      }\n      // 15位或18位身份证号码正则\n      const reg = /^[1-9]\\d{5}(18|19|([23]\\d))\\d{2}((0[1-9])|(10|11|12))(([0-2][1-9])|10|20|30|31)\\d{3}[0-9Xx]$/;\n      if (reg.test(value)) {\n        callback();\n      } else {\n        callback(new Error('请输入正确的身份证号码格式'));\n      }\n    },\n    // 校验营业执照格式（统一社会信用代码）\n    validateBusinessLicense(rule, value, callback) {\n      if (!value) {\n        callback();\n        return;\n      }\n      // 统一社会信用代码为18位，由数字和大写字母组成\n      const reg = /^[0-9A-HJ-NPQRTUWXY]{2}\\d{6}[0-9A-HJ-NPQRTUWXY]{10}$/;\n      if (reg.test(value)) {\n        callback();\n      } else {\n        callback(new Error('请输入正确的统一社会信用代码格式'));\n      }\n    },\n    // 校验证件号码（客户基本信息表单 - 机构户/个人户）\n    validateIdNoForBasicInfo() {\n      return (rule, value, callback) => {\n        if (!value) {\n          callback(new Error('请输入\"证件号码\"'));\n          return;\n        }\n        // 根据主体类型判断是机构户还是个人户\n        const idType = this.organ_flag === '1' ? this.ruleForm1.id_type : this.ruleForm2.id_type;\n\n        // 根据证件类型进行格式校验\n        if (idType === '1') {\n          // 身份证\n          const reg = /^[1-9]\\d{5}(18|19|([23]\\d))\\d{2}((0[1-9])|(10|11|12))(([0-2][1-9])|10|20|30|31)\\d{3}[0-9Xx]$/;\n          if (reg.test(value)) {\n            callback();\n          } else {\n            callback(new Error('请输入正确的身份证号码格式'));\n          }\n        } else if (idType === '3') {\n          // 营业执照（统一社会信用代码）\n          const reg = /^[0-9A-HJ-NPQRTUWXY]{2}\\d{6}[0-9A-HJ-NPQRTUWXY]{10}$/;\n          if (reg.test(value)) {\n            callback();\n          } else {\n            callback(new Error('请输入正确的统一社会信用代码格式'));\n          }\n        } else {\n          callback();\n        }\n      };\n    },\n    // 校验证件号码（关联人弹窗）\n    validateIdNoForRelated() {\n      return (rule, value, callback) => {\n        if (!value) {\n          callback(new Error('请输入\"证件号码\"'));\n          return;\n        }\n        // 判断当前是哪个弹窗（editForm 或 editForm1）\n        const currentForm = this.dialogFormVisible ? this.editForm : this.editForm1;\n        const idType = currentForm.id_type;\n\n        // 根据证件类型进行格式校验\n        if (idType === '1') {\n          // 身份证\n          const reg = /^[1-9]\\d{5}(18|19|([23]\\d))\\d{2}((0[1-9])|(10|11|12))(([0-2][1-9])|10|20|30|31)\\d{3}[0-9Xx]$/;\n          if (reg.test(value)) {\n            callback();\n          } else {\n            callback(new Error('请输入正确的身份证号码格式'));\n          }\n        } else if (idType === '3') {\n          // 营业执照（统一社会信用代码）\n          const reg = /^[0-9A-HJ-NPQRTUWXY]{2}\\d{6}[0-9A-HJ-NPQRTUWXY]{10}$/;\n          if (reg.test(value)) {\n            callback();\n          } else {\n            callback(new Error('请输入正确的统一社会信用代码格式'));\n          }\n        } else {\n          callback();\n        }\n      };\n    },\n    // 校验时的提示（需换行）\n    showMessage(msg, time, type) {\n      this.$message({\n        showClose: true,\n        dangerouslyUseHTMLString: true,\n        message: msg,\n        duration: time ? time : 0,\n        type: type ? type : 'success'\n      })\n    },\n    handleClick(tab, event) {\n      this.isScroll = false;\n      let that = this;\n      let element = document.getElementsByName(tab.name)[0];\n      element.scrollIntoView({\n        behavior: 'smooth',\n        block: 'start'\n      });\n      setTimeout(() => {\n        that.isScroll = true;\n      }, 500);\n      console.log(\"滚动监听中...\");\n    },\n    // 滚动监听\n    onScroll(e) {\n      if (!this.isScroll) return;\n      var scrollItems = [];\n      this.navList.forEach(ele => {\n        var element = document.getElementsByName(ele.value)[0];\n        scrollItems.push(element);\n      });\n      var scrollTop = e.target.scrollTop;\n      var foundIndex = -1;\n      for (var i = 0; i < scrollItems.length; i++) {\n        var item = scrollItems[i];\n        var threshold = item.offsetTop - scrollItems[0].offsetTop;\n        if (scrollTop >= threshold) {\n          foundIndex = i;\n        } else {\n          break;\n        }\n      }\n      if (foundIndex !== -1) {\n        this.activeNav = this.navList[foundIndex.toString()].value;\n      }\n    },\n    // 页面展示数据字典转换\n    formatDictMap(dictType, key) {\n      const dictData = this.selectList[dictType];\n      const item = dictData?.find(item => item.k === key);\n      return item ? item.v : '-';\n    },\n    formatMoney(s, n) {\n      if (!s && s !== 0) return '';\n      let str = String(s);\n      let cleaned = str.replace(/[^\\d\\.]/g, \"\") // 移除所有非数字、非小数点的字符\n        .replace(/\\.{2,}/g, '.') // 多个小数点合并为一个\n        .replace(/^\\./, \"\"); // 移除开头的小数点\n\n      if (!cleaned) return \"\";\n      let num = parseFloat(cleaned);\n      if (isNaN(num)) return \"\";\n      let fixedNum = num.toFixed(n);\n      let [integerPart, decimalPart] = fixedNum.split('.');\n      let integerWithComma = integerPart.replace(/(?=(\\B)(\\d{3})+$)/g, ',');\n      return decimalPart ? `${integerWithComma}.${decimalPart}` : integerWithComma;\n    },\n    // 格式化附件大小\n    formatSize(bytes) {\n      if (!bytes && bytes !== 0) {\n        return '';\n      } else if (bytes === 0) {\n        return '0 B'\n      };\n\n      const k = 1024;\n      const sizes = ['B', 'KB', 'MB', 'GB', 'TB'];\n      const i = Math.floor(Math.log(bytes) / Math.log(k));\n\n      return (bytes / Math.pow(k, i)).toFixed(2) + ' ' + sizes[i];\n    },\n    // 查询省\n    getProvince() {\n      let that = this;\n      Wb.ajax({\n        url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/select_province',\n        success: function (resp) {\n          let rec = Wb.decode(resp).items;\n          that.proOptions = rec.map(item => ({\n            label: item.pro_name,\n            value: item.pro_code\n          }));\n        }\n      });\n    },\n    handleProvinceChg(val) {\n      if (val == '0') {\n        this.ruleForm1.city = '';\n        this.ruleForm1.district = '';\n        this.ruleForm1.office_address = '';\n      } else if (val == '1') {\n        this.ruleForm2.city1 = '';\n        this.ruleForm2.district1 = '';\n        this.ruleForm2.id_address = '';\n      } else if (val == '2') {\n        this.ruleForm2.city2 = '';\n        this.ruleForm2.district2 = '';\n        this.ruleForm2.address = '';\n      } else if (val == 'bomis') {\n        this.bomisParams.editBomisForm.city = '';\n        this.bomisParams.editBomisForm.district = '';\n        this.bomisParams.editBomisForm.address = '';\n      }\n      this.getCity(val);\n    },\n    // 查询市\n    getCity(val) {\n      let that = this;\n      let province;\n      if (val == '0') {\n        province = this.ruleForm1.province;\n      } else if (val == '1') {\n        province = this.ruleForm2.province1;\n      } else if (val == '2') {\n        province = this.ruleForm2.province2;\n      } else if (val == 'bomis') {\n        province = this.bomisParams.editBomisForm.province;\n      }\n      if (province) {\n        Wb.ajax({\n          url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/select_city',\n          params: {\n            I_PRO_CODE: province\n          },\n          success: function (resp) {\n            let rec = Wb.decode(resp).items;\n            console.log(\"市\", rec);\n            if (val == '0') {\n              that.cityOptions = rec.map(item => ({\n                label: item.area_name,\n                value: item.area_code\n              }));\n            } else if (val == '1') {\n              that.cityOptions1 = rec.map(item => ({\n                label: item.area_name,\n                value: item.area_code\n              }));\n            } else if (val == '2') {\n              that.cityOptions2 = rec.map(item => ({\n                label: item.area_name,\n                value: item.area_code\n              }));\n            } else if (val == 'bomis') {\n              that.bomisParams.cityOptions = rec.map(item => ({\n                label: item.area_name,\n                value: item.area_code\n              }));\n            }\n          }\n        });\n      }\n    },\n    handleCityChg(val) {\n      if (val == '0') {\n        this.ruleForm1.district = '';\n        this.ruleForm1.office_address = '';\n      } else if (val == '1') {\n        this.ruleForm2.district1 = '';\n        this.ruleForm2.id_address = '';\n      } else if (val == '2') {\n        this.ruleForm2.district2 = '';\n        this.ruleForm2.address = '';\n      } else if (val == 'bomis') {\n        this.bomisParams.editBomisForm.district = '';\n        this.bomisParams.editBomisForm.address = '';\n      }\n      this.getDistrict(val);\n    },\n    // 查询区\n    getDistrict(val) {\n      let that = this;\n      let province, city;\n      if (val == '0') {\n        province = this.ruleForm1.province;\n        city = this.ruleForm1.city;\n      } else if (val == '1') {\n        province = this.ruleForm2.province1;\n        city = this.ruleForm2.city1;\n      } else if (val == '2') {\n        province = this.ruleForm2.province2;\n        city = this.ruleForm2.city2;\n      } else if (val == 'bomis') {\n        debugger\n        province = this.bomisParams.editBomisForm.province;\n        city = this.bomisParams.editBomisForm.city;\n      }\n      Wb.ajax({\n        url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/select_district',\n        params: {\n          I_PRO_CODE: province,\n          I_AREA_CODE: city ? city.substring(0, 4) : ''\n        },\n        success: function (resp) {\n          let rec = Wb.decode(resp).items;\n          console.log(\"区\", rec);\n          if (val == '0') {\n            that.districtOptions = rec.map(item => ({\n              label: item.area_name,\n              value: item.area_code\n            }));\n          } else if (val == '1') {\n            that.districtOptions1 = rec.map(item => ({\n              label: item.area_name,\n              value: item.area_code\n            }));\n          } else if (val == '2') {\n            that.districtOptions2 = rec.map(item => ({\n              label: item.area_name,\n              value: item.area_code\n            }));\n          } else if (val == 'bomis') {\n            that.bomisParams.districtOptions = rec.map(item => ({\n              label: item.area_name,\n              value: item.area_code\n            }));\n          }\n\n        }\n      });\n    },\n    // 关联人弹窗 自然人/法人切换时重置弹窗数据\n    resetForm(form) {\n      this.editForm.birthday = '';\n      this.editForm.is_government_dept = '';\n      this.editForm.id_type = '';\n      this.editForm.id_no = '';\n    },\n    // 查询所有关联主体附件信息\n    selectFile() {\n      console.log(\"执行了selectFile\")\n      let that = this;\n      // 机构户附件\n      let fileType1 = {\n        'basicInfo': '1,2,21,22',\n        'LegalRep': '23',\n        'controllingShareholder': '3,31,32',\n        'actualController': '4,41,42',\n        'authorizedRep': '5,51,52',\n        'beneficialOwner': '6,61,62,63,64',\n      }\n      // 个人户附件\n      let fileType2 = {\n        'basicInfo': '1,2'\n      }\n      if (this.organ_flag == '1') {\n        for (const key in fileType1) {\n          Wb.ajax({\n            url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/files/select_file',\n            params: {\n              I_CLIENT_ID: '_$client_id$_',\n              I_FILE_TYPE_NO: fileType1[key]\n            },\n            success(resp) {\n              let rows = Wb.decode(resp).items\n              that.attachmentList[key] = rows;\n            }\n          })\n        }\n      } else {\n        for (const key in fileType2) {\n          Wb.ajax({\n            url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/files/select_file',\n            params: {\n              I_CLIENT_ID: '_$client_id$_',\n              I_FILE_TYPE_NO: fileType2[key]\n            },\n            success(resp) {\n              let rows = Wb.decode(resp).items\n              that.attachmentList[key] = rows;\n              console.log(\"that.attachmentList.\" + key, that.attachmentList[key])\n            }\n          })\n        }\n      }\n      // 反洗钱特殊情况 对文件细致分类过的回显时单独用object_id查询\n      const fxq_special_arr = ['communication', 'agree', 'other']\n      fxq_special_arr.forEach(item => {\n        Wb.ajax({\n          url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/files/select_file',\n          params: {\n            I_CLIENT_ID: '_$client_id$_',\n            I_OBJECT_ID: '_$client_id$_' + item\n          },\n          success(resp) {\n            let rows = Wb.decode(resp).items\n            that.attachmentList[item] = rows;\n          }\n        })\n      })\n    },\n    // 查询所有维护过的自然人/机构主体名称\n    selectRelaOptions(organ_flag) {\n      let that = this;\n      Wb.ajax({\n        url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/select_organ_entity',\n        params: {\n          CLIENT_ID: '_$client_id$_',\n          ORGAN_FLAG: organ_flag\n        },\n        success(resp) {\n          let res = Wb.decode(resp).items;\n          if (res && res.length > 0) {\n            const uniqueMap = new Map();\n            res.forEach(item => {\n              const key = item.related_name + '_' + item.id_no + '_' + item.id_type;\n              if (!uniqueMap.has(key)) {\n                uniqueMap.set(key, item);\n              }\n            });\n            that.curRelaOptions = Array.from(uniqueMap.values());\n          } else {\n            that.curRelaOptions = [];\n          }\n        }\n      })\n    },\n    setRelaValue(related_name, form) {\n      const exist = this.curRelaOptions.find(item => item.related_name === related_name);\n      if (exist && form == 'form') {\n        const selectedRela = this.curRelaOptions.find(item => item.related_name === this.editForm.related_name);\n        this.editForm.birthday = selectedRela.birthday;\n        this.editForm.is_government_dept = selectedRela.is_government_dept;\n        this.editForm.id_type = selectedRela.id_type;\n        this.editForm.id_no = selectedRela.id_no;\n        this.editForm.id_begindate = selectedRela.id_begindate;\n        this.editForm.id_enddate = selectedRela.id_enddate;\n        this.editForm.nationality = selectedRela.nationality;\n      } else if (exist && form == 'form1') {\n        const selectedRela = this.curRelaOptions.find(item => item.related_name === this.editForm1.related_name);\n        this.editForm1.birthday = selectedRela.birthday;\n        this.editForm1.is_government_dept = selectedRela.is_government_dept;\n        this.editForm1.id_type = selectedRela.id_type;\n        this.editForm1.id_no = selectedRela.id_no;\n        this.editForm1.id_begindate = selectedRela.id_begindate;\n        this.editForm1.id_enddate = selectedRela.id_enddate;\n        this.editForm1.nationality = selectedRela.nationality;\n        if ((this.editForm1.related_type == '1' || this.editForm1.related_type == '4') && selectedRela.mobno1) {\n          this.editForm1.mobno1 = selectedRela.mobno1;\n        }\n      } else if (exist && form === 'bomisForm') {\n        // TODO\n        var that = this;\n        const selectedRela = this.curRelaOptions.find(item => item.related_name === that.bomisParams.editBomisForm.related_name);\n        that.bomisParams.editBomisForm.birthday = selectedRela.birthday;\n        that.bomisParams.editBomisForm.is_government_dept = selectedRela.is_government_dept;\n        that.bomisParams.editBomisForm.id_type = selectedRela.id_type;\n        that.bomisParams.editBomisForm.id_no = selectedRela.id_no;\n        that.bomisParams.editBomisForm.id_begindate = selectedRela.id_begindate;\n        that.bomisParams.editBomisForm.id_enddate = selectedRela.id_enddate;\n        that.bomisParams.editBomisForm.nationality = selectedRela.nationality;\n        that.bomisParams.editBomisForm.mobno1 = selectedRela.mobno1;\n        that.bomisParams.editBomisForm.mobno2 = selectedRela.mobno2;\n        that.bomisParams.editBomisForm.address = selectedRela.address;\n      }\n    },\n    // 删除关联人\n    deleteRalated(item) {\n      console.log(\"点击了删除item\", item);\n      let that = this;\n      Wb.confirm(\"关联人删除会直接删除该数据，是否确认删除？\", () => {\n        Wb.ajax({\n          url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/delete_single_entity',\n          params: {\n            CLIENT_ID: '_$client_id$_',\n            ORGAN_FLAG: item.organ_flag,\n            RELATED_TYPE: item.related_type,\n            RELATED_ID: item.related_id,\n            RELATED_NAME: item.related_name,\n            DATA_STATUS: item.data_status\n          },\n          success(resp) {\n            Wb.tipSucc(\"删除成功\");\n            that.getRelatedInfo('_$client_id$_', item.related_type);\n          }\n        });\n      });\n    },\n    downloadPdf() {\n      console.log(\"uid\", this._uid);\n      const htmlContent = document.getElementById('pdf-container' + this._uid);\n      const clone = htmlContent.cloneNode(true);\n      clone.style.backgroundColor = '#ffffff'; // 确保背景白色\n      clone.style.padding = '20px';\n      clone.style.width = '1800px';\n      clone.style.maxWidth = 'none';\n\n      document.body.appendChild(clone);\n\n      setTimeout(() => {\n        html2canvas(clone, {\n          scale: window.devicePixelRatio,//2,\n          useCORS: true,\n          allowTaint: false,\n          backgroundColor: \"#ffffff\",\n          fontSize: '24px',\n          boxSizing: 'border-box',\n          // scrollX: 0,\n          // scrollY: -window.scrollY\n        }).then(canvas => {\n          const contentWidth = canvas.width;\n          const contentHeight = canvas.height;\n\n          const pageWidth = 595.28; // A4 pt 宽度\n          const pageHeight = 841.89; // A4 pt 高度\n          const imgWidth = pageWidth - 40; // 两边各留 20pt 边距\n          const imgHeight = (imgWidth / contentWidth) * contentHeight;\n\n          const pageData = canvas.toDataURL('image/jpeg', 1.0);\n          console.log(\"pageData.length\", pageData.length / (1024 * 1024) + \"MB\");\n          const pdf = new jsPDF('', 'pt', 'a4');\n\n          let leftHeight = imgHeight;\n          let position = 0;\n\n          if (leftHeight < pageHeight) {\n            pdf.addImage(pageData, 'JPEG', 20, 0, imgWidth, imgHeight);\n          } else {\n            while (leftHeight > 0) {\n              pdf.addImage(pageData, 'JPEG', 20, position, imgWidth, imgHeight);\n              leftHeight -= pageHeight;\n              position -= pageHeight;\n\n              if (leftHeight > 0) {\n                pdf.addPage();\n              }\n            }\n          }\n          pdf.save(\"客户基本信息表-【\" + ('_$organ_flag$_' === '1' ? this.ruleForm1.client_name : this.ruleForm2.client_name) + '(' + '_$client_id$_' + ')' + \"】\" + \".pdf\");\n          document.body.removeChild(clone);\n        }).catch(err => {\n          console.error('PDF导出失败', err);\n          document.body.removeChild(clone);\n        });\n      }, 500);\n    },\n    openFileDialog(menu) {\n      if (menu == 23) {\n        console.log(\"111\");\n        this.fileDialogDisabled = true;\n      } else {\n        this.fileDialogDisabled = false;\n      }\n      this.fileList = [];\n      this.selectedMenu = menu;\n      let curMenu = Number(String(menu)[0]);\n      let directoryConfig = this.organ_flag == '1' ? this.directoryConfig1 : this.directoryConfig2;\n      directoryConfig.forEach(item => {\n        item.disabled = true;\n      });\n      let targetItem = directoryConfig.find(item => item.value === curMenu);\n      if (targetItem) {\n        targetItem.disabled = false;\n      }\n      this.fileDialogVisible = true;\n    },\n    handleChange(file, fileList) {\n      this.fileList = fileList\n    },\n    handleChange1(file, fileList) {\n      this.attachmentList.communication = fileList\n    },\n    handleChange2(file, fileList) {\n      this.attachmentList.agree = fileList\n    },\n    handleChange3(file, fileList) {\n      this.attachmentList.other = fileList\n    },\n    handleDelete(index) {\n\n    },\n    handleSuccess(file, fileList) {\n      this.selectFile();\n    },\n    // 下载附件\n    handleDownload(row) {\n      Wb.download({\n        url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/files/download_file',\n        params: {\n          id: row.id,\n          full_name: row.name + '.' + row.extension\n        }\n      })\n    },\n    uploadFile(file) {\n      let that = this;\n      return new Promise((resolve) => {\n        Wb.ajax({\n          url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/files/upload_file1',\n          params: this.uploadParams,\n          success(resp) {\n            that.$message.success('上传成功');;\n            resolve(); // 上传完成时resolve\n          },\n          error() {\n            resolve(); // 即使出错也要resolve，确保计数器能继续\n          }\n        });\n      });\n    },\n    submitUpload() {\n      if (this.fileList.length === 0) {\n        this.$message.warning(\"请至少选择一个文件\");\n        return;\n      }\n      if (this.selectedMenu.length === 0) {\n        this.$message.warning(\"请选择附件类型\");\n        return;\n      }\n\n      this.uploadParams.file_type_no = Array.isArray(this.selectedMenu) ? this.selectedMenu[this.selectedMenu.length - 1] : this.selectedMenu;\n\n      // 使用计数器跟踪上传完成情况\n      let completedCount = 0;\n      const totalFiles = this.fileList.length;\n\n      const checkAllCompleted = () => {\n        completedCount++;\n        if (completedCount === totalFiles) {\n          // 所有文件都上传完成后，设置弹窗不可见\n          this.selectFile();\n          this.fileDialogVisible = false;\n        }\n      };\n\n      for (const file of this.fileList) {\n        this.uploadParams.file1 = file.raw;\n        this.uploadFile(file).then(() => {\n          // 使用setTimeout确保异步执行，避免阻塞\n          setTimeout(checkAllCompleted, 0);\n        });\n      }\n    },\n    closeDialog(form) {\n      if (form == '1') {\n        // 清除校验提示\n        this.$refs.editForm.clearValidate();\n        // 关闭弹窗\n        this.dialogFormVisible = false;\n      } else if (form == '2') {\n        // 清除校验提示\n        this.$refs.editForm1.clearValidate();\n        // 关闭弹窗\n        this.dialogFormVisible1 = false;\n      } else if (form == '3') {\n        this.fileDialogVisible = false;\n      } else if (form === 'bomisDialog') {\n        this.bomisParams.dialogBomisVisible = false;\n      } else if (form === 'bomisBenefitDialog') {\n        this.bomisParams.benefitEditDialogVisible = false;\n      }\n\n    },\n    // 显示弹窗\n    showDialog(op_flag, item, related_type) {\n      let title = this.formatDictMap('related_type_list', related_type);\n\n      let initFormCommon = (formObj, newItem, isNew) => {\n        formObj.related_name = newItem ? newItem.related_name : '';\n        formObj.organ_flag = newItem ? newItem.organ_flag : '0';\n        formObj.nationality = newItem ? newItem.nationality : '';\n        formObj.id_type = newItem ? newItem.id_type : '';\n        formObj.id_no = newItem ? newItem.id_no : '';\n        formObj.id_begindate = newItem ? newItem.id_begindate : '';\n        formObj.id_enddate = newItem ? newItem.id_enddate : '';\n        formObj.is_government_dept = newItem ? newItem.is_government_dept : '';\n        formObj.birthday = newItem ? newItem.birthday : '';\n        formObj.related_type = related_type; // 当前操作的类型\n        formObj.data_status = newItem ? newItem.data_status : '0';\n        formObj.title = title;\n        formObj.new_flag = isNew;\n        formObj.beneficiary = (related_type == '5' && newItem) ? newItem.beneficiary : '';\n        formObj.shareholding_ratio = (related_type == '5' && newItem) ? newItem.shareholding_ratio : '';\n        formObj.address = (related_type == '5' && newItem) ? newItem.address : '';\n        formObj.mobno1 = ((related_type == '1' || related_type == '4') && newItem) ? (newItem.mobno1 || '') : '';\n        formObj._tempBatchList = [];\n      };\n\n      // 1. 控股股东 (2) 和 实控人 (3) - 使用 editForm\n      if ((related_type == '2' || related_type == '3')) {\n        if (op_flag == '1') {\n          initFormCommon(this.editForm, null, true);\n\n          this.dialogFormVisible = true;\n        } else if (op_flag == '2') {\n          let that = this;\n          Wb.ajax({\n            url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/select_organ_entity',\n            params: {\n              CLIENT_ID: '_$client_id$_',\n              ORGAN_FLAG: item.organ_flag,\n              RELATED_NAME: item.related_name\n            },\n            success: function (resp) {\n              let res = Wb.decode(resp).items || [];\n              let batchList = [];\n\n              for (let i = 0; i < res.length; i++) {\n                let pItem = res[i];\n                let dataObj = {\n                  CLIENT_ID: '_$client_id$_',\n                  RELATED_TYPE: String(pItem.related_type),\n                  RELATED_NAME: pItem.related_name,\n                  ORGAN_FLAG: pItem.organ_flag,\n                  ID_TYPE: pItem.id_type,\n                  ID_NO: pItem.id_no,\n                  ID_BEGINDATE: pItem.id_begindate,\n                  ID_ENDDATE: pItem.id_enddate,\n                  NATIONALITY: pItem.nationality,\n                  BIRTHDAY: pItem.birthday,\n                  IS_GOVERNMENT_DEPT: pItem.is_government_dept,\n                  DATA_STATUS: pItem.data_status,\n                  OBJECT_ID: '',\n                  BENEFICIARY: pItem.beneficiary || '',\n                  SHAREHOLDING_RATIO: pItem.shareholding_ratio || '',\n                  ADDRESS: pItem.address || ''\n                };\n                batchList.push(dataObj);\n              }\n\n              initFormCommon(that.editForm, item, false);\n              that.editForm._tempBatchList = batchList;\n              that.editForm.related_id = item.related_id;\n\n              console.log(\"编辑初始化完成，batchList:\", batchList);\n              that.dialogFormVisible = true;\n            }\n          });\n          return;\n        }\n      }\n      // 2. 法定代表人 (1)、授权代表人 (4)、受益所有人 (5) - 使用 editForm1\n      else if (related_type == '1' || related_type == '4' || related_type == '5') {\n        if (op_flag == '1') {\n          console.log(\"新增 - 法人/授权/受益人\");\n          if (related_type === '1' && this.relatedInfo1?.length > 0) {\n            let that = this;\n            Wb.confirm(\"该客户已有法定联系人，是否确认替换法定联系人？\", () => {\n              const item = that.relatedInfo1[0]\n              Wb.ajax({\n                url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/delete_single_entity',\n                params: {\n                  CLIENT_ID: '_$client_id$_',\n                  ORGAN_FLAG: item.organ_flag,\n                  RELATED_TYPE: item.related_type,\n                  RELATED_ID: item.related_id,\n                  RELATED_NAME: item.related_name,\n                  DATA_STATUS: item.data_status\n                },\n                success(resp) {\n                  that.getRelatedInfo('_$client_id$_', item.related_type);\n                  initFormCommon(that.editForm1, null, true);\n                  that.dialogFormVisible1 = true;\n                }\n              });\n            });\n          } else {\n            initFormCommon(this.editForm1, null, true);\n            this.dialogFormVisible1 = true;\n          }\n          // Object.assign(this.editForm1, {\n          //   related_name: '',\n          //   organ_flag: '0',\n          //   nationality: '',\n          //   id_type: '',\n          //   id_no: '',\n          //   id_begindate: '',\n          //   id_enddate: '',\n          //   birthday: '',\n          //   related_type: related_type,\n          //   data_status: '0',\n          //   title: title,\n          //   new_flag: true,\n          //   _tempBatchList: [],\n          //   beneficiary: '',\n          //   shareholding_ratio: '',\n          //   address: ''\n          // });\n          // this.editForm1.beneficiary = '';\n          // this.editForm1.shareholding_ratio = '';\n          // this.editForm1.address = '';\n        } else if (op_flag == '2') {\n          console.log(\"编辑 - 法人/授权/受益人，正在查询全量类型...\");\n          let that = this;\n          Wb.ajax({\n            url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/select_organ_entity',\n            params: {\n              CLIENT_ID: '_$client_id$_',\n              ORGAN_FLAG: item.organ_flag,\n              RELATED_NAME: item.related_name\n            },\n            success: function (resp) {\n              let res = Wb.decode(resp).items || [];\n              let batchList = [];\n\n              for (let i = 0; i < res.length; i++) {\n                let pItem = res[i];\n                let dataObj = {\n                  CLIENT_ID: '_$client_id$_',\n                  RELATED_TYPE: String(pItem.related_type),\n                  RELATED_NAME: pItem.related_name,\n                  ORGAN_FLAG: pItem.organ_flag,\n                  ID_TYPE: pItem.id_type,\n                  ID_NO: pItem.id_no,\n                  ID_BEGINDATE: pItem.id_begindate,\n                  ID_ENDDATE: pItem.id_enddate,\n                  NATIONALITY: pItem.nationality,\n                  BIRTHDAY: pItem.birthday,\n                  IS_GOVERNMENT_DEPT: pItem.is_government_dept,\n                  DATA_STATUS: pItem.data_status,\n                  OBJECT_ID: pItem.related_id || '',\n                  BENEFICIARY: pItem.beneficiary || '',\n                  SHAREHOLDING_RATIO: pItem.shareholding_ratio || '',\n                  ADDRESS: pItem.address || ''\n                };\n                batchList.push(dataObj);\n              }\n\n              that.$set(that.editForm1, 'related_name', item.related_name);\n              that.$set(that.editForm1, 'organ_flag', item.organ_flag || '0');\n              that.$set(that.editForm1, 'nationality', item.nationality || '');\n              that.$set(that.editForm1, 'id_type', item.id_type || '');\n              that.$set(that.editForm1, 'id_no', item.id_no || '');\n              that.$set(that.editForm1, 'id_begindate', item.id_begindate || '');\n              that.$set(that.editForm1, 'id_enddate', item.id_enddate || '');\n              that.$set(that.editForm1, 'birthday', item.birthday || '');\n              that.$set(that.editForm1, 'is_government_dept', item.is_government_dept || '');\n              that.$set(that.editForm1, 'related_type', related_type); // 确保是当前的 type\n              that.$set(that.editForm1, 'data_status', item.data_status || '0');\n              that.$set(that.editForm1, 'title', title);\n              that.$set(that.editForm1, 'new_flag', false);\n              that.$set(that.editForm1, 'related_id', item.related_id);\n              that.$set(that.editForm1, '_tempBatchList', batchList);\n\n              // 受益所有人特有字段\n              if (String(item.related_type) === '5') {\n                that.$set(that.editForm1, 'beneficiary', item.beneficiary || '');\n                that.$set(that.editForm1, 'shareholding_ratio', item.shareholding_ratio || null);\n                that.$set(that.editForm1, 'address', item.address || '');\n\n              }\n\n              // 法定代表人/授权代表人联系方式\n              if (String(item.related_type) === '1' || String(item.related_type) === '4') {\n                that.$set(that.editForm1, 'mobno1', item.mobno1 || '');\n              }\n\n              console.log(\"编辑初始化完成，batchList:\", batchList);\n              that.dialogFormVisible1 = true;\n            }\n          });\n          return;\n        }\n      }\n      // 新版受益所有人（6） 包含受益人核验 使用 \n      else if (related_type == 'bomis') {\n        if (op_flag == '1') {\n          initFormCommon(this.bomisParams.editBomisForm, null, true);\n          this.bomisParams.editBomisForm.title = '受益所有人';\n          this.bomisParams.dialogBomisVisible = true;\n          this.getBomisSourceTableData();\n          this.getLastOnlineBomisCheckRs();\n        } else if (op_flag == '2') {\n          // TODO\n        }\n      }\n    },\n\n    // 提交关联主体弹窗\n    saveEditForm(op_flag, form) {\n      let that = this;\n\n      // 1. 表单校验\n      let validSucc = this.submitForm(form);\n      if (!validSucc) {\n        return;\n      }\n\n      let currentForm = (form == '1') ? this.editForm : this.editForm1;\n      let dialogVisibleProp = (form == '1') ? 'dialogFormVisible' : 'dialogFormVisible1';\n      let currentRelatedType = String(currentForm.related_type);\n\n      // 公共字段\n      let baseParams = {\n        CLIENT_ID: '_$client_id$_',\n        RELATED_NAME: currentForm.related_name,\n        ORGAN_FLAG: currentForm.organ_flag,\n        ID_TYPE: currentForm.id_type,\n        ID_NO: currentForm.id_no,\n        ID_BEGINDATE: currentForm.id_begindate,\n        ID_ENDDATE: currentForm.id_enddate,\n        NATIONALITY: currentForm.nationality,\n        BIRTHDAY: currentForm.birthday,\n        IS_GOVERNMENT_DEPT: currentForm.is_government_dept,\n        DATA_STATUS: currentForm.data_status || '0'\n      };\n\n      // 受益人特有参数 (仅当当前正在编辑受益人弹窗时才取新值，否则留空待处理)\n      let newBeneficiaryParams = {};\n      console.log(\"currentRelatedType\", currentRelatedType)\n      if (currentRelatedType === '5') {\n        newBeneficiaryParams.BENEFICIARY = currentForm.beneficiary || '';\n        newBeneficiaryParams.SHAREHOLDING_RATIO = currentForm.shareholding_ratio || '';\n        newBeneficiaryParams.ADDRESS = currentForm.address || '';\n      }\n\n      let newMobno1Params = {};\n      if (currentRelatedType === '1' || currentRelatedType === '4') {\n        newMobno1Params.MOBNO1 = currentForm.mobno1 || '';\n      }\n\n      // 2. 新增\n      if (currentForm.new_flag) {\n        let targetRelatedType = currentForm.related_type;\n        let targetTitle = that.formatDictMap('related_type_list', targetRelatedType);\n\n        Wb.ajax({\n          url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/select_organ_entity',\n          params: {\n            CLIENT_ID: '_$client_id$_',\n            ORGAN_FLAG: baseParams.ORGAN_FLAG,\n            RELATED_NAME: baseParams.RELATED_NAME\n          },\n          success: function (resp) {\n            let res = Wb.decode(resp).items || [];\n            let hasDuplicate = false;\n\n            for (let i = 0; i < res.length; i++) {\n              if (String(res[i].related_name) === String(baseParams.RELATED_NAME) &&\n                String(res[i].related_type) === String(targetRelatedType)) {\n                hasDuplicate = true;\n                break;\n              }\n            }\n\n            if (hasDuplicate) {\n              Wb.error(\"已存在主体名称为“\" + baseParams.RELATED_NAME + \"”的【\" + targetTitle + \"】信息，请勿重复添加！\");\n              return;\n            }\n\n            let saveData = {};\n            for (let key in baseParams) { saveData[key] = baseParams[key]; }\n            saveData.RELATED_TYPE = targetRelatedType;\n            saveData.OBJECT_ID = '';\n            saveData.CREATE_USER = '_$sys.username$_';\n            saveData.UPDATE_USER = '_$sys.username$_';\n\n            // 如果是新增受益人，加上特有字段\n            if (String(targetRelatedType) === '5') {\n              saveData.BENEFICIARY = newBeneficiaryParams.BENEFICIARY;\n              saveData.SHAREHOLDING_RATIO = newBeneficiaryParams.SHAREHOLDING_RATIO;\n              saveData.ADDRESS = newBeneficiaryParams.ADDRESS;\n            }\n\n            if (String(targetRelatedType) === '1' || String(targetRelatedType) === '4') {\n              saveData.MOBNO1 = newMobno1Params.MOBNO1;\n            }\n\n            let batchList = [saveData];\n\n            Wb.ajax({\n              url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/save_organ_entity',\n              params: { batchList: batchList },\n              success: function (saveResp) {\n                Wb.tipSucc(\"添加成功\");\n                that.getRelatedInfo('_$client_id$_', targetRelatedType);\n\n                if (op_flag == '2') {\n                  that[dialogVisibleProp] = false;\n                }\n\n                let relaType = currentForm.related_type;\n                if (form == '1') {\n                  that.editForm = {\n                    related_name: '', organ_flag: '0', nationality: '', id_type: '', id_no: '',\n                    id_begindate: '', id_enddate: '', is_government_dept: '', birthday: '',\n                    related_type: relaType, data_status: '0', title: that.formatDictMap('related_type_list', relaType),\n                    new_flag: true, _tempBatchList: []\n                  };\n                  if (that.$refs.editForm) that.$refs.editForm.clearValidate();\n                } else {\n                  that.editForm1 = {\n                    related_name: '', organ_flag: '0', nationality: '', id_type: '', id_no: '',\n                    id_begindate: '', id_enddate: '', is_government_dept: '', birthday: '',\n                    beneficiary: '', shareholding_ratio: '', address: '', mobno1: '',\n                    related_type: relaType, data_status: '0', title: that.formatDictMap('related_type_list', relaType),\n                    new_flag: true, _tempBatchList: []\n                  };\n                }\n              }\n            });\n          }\n        });\n\n      }\n      // 3. 编辑\n      else {\n        let batchList = currentForm._tempBatchList || [];\n\n        if (batchList.length === 0) {\n          Wb.error(\"编辑数据异常，未找到关联信息，请重新打开弹窗。\");\n          return;\n        }\n\n        // 更新 batchList\n        for (let i = 0; i < batchList.length; i++) {\n          let item = batchList[i];\n          console.log(\"batchList[i]\", batchList[i])\n          let itemType = String(item.RELATED_TYPE);\n\n          // 1. 更新公共字段\n          item.RELATED_NAME = baseParams.RELATED_NAME;\n          item.ORGAN_FLAG = baseParams.ORGAN_FLAG;\n          item.ID_TYPE = baseParams.ID_TYPE;\n          item.ID_NO = baseParams.ID_NO;\n          item.ID_BEGINDATE = baseParams.ID_BEGINDATE;\n          item.ID_ENDDATE = baseParams.ID_ENDDATE;\n          item.NATIONALITY = baseParams.NATIONALITY;\n          item.BIRTHDAY = baseParams.BIRTHDAY;\n          item.IS_GOVERNMENT_DEPT = baseParams.IS_GOVERNMENT_DEPT;\n          item.DATA_STATUS = baseParams.DATA_STATUS;\n\n          // 2. 受益所有人特有字段\n          if (itemType === '5') {\n            // 判断：只有当当前正在编辑的弹窗也是“受益所有人”(type 5) 时，才更新这三个字段\n            // 如果当前是在编辑其他类型则保留 item 中原有的值，不要用空值覆盖\n            if (currentRelatedType === '5') {\n              item.BENEFICIARY = newBeneficiaryParams.BENEFICIARY;\n              item.SHAREHOLDING_RATIO = newBeneficiaryParams.SHAREHOLDING_RATIO;\n              item.ADDRESS = newBeneficiaryParams.ADDRESS;\n            }\n          }\n\n          if (itemType === '1' || itemType === '4') {\n            if (currentRelatedType === '1' || currentRelatedType === '4') {\n              item.MOBNO1 = newMobno1Params.MOBNO1;\n            }\n          }\n        }\n\n        Wb.ajax({\n          url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/update_organ_entity',\n          params: {\n            batchList: batchList\n          },\n          success: function (resp) {\n            let rs = Wb.decode(resp);\n            if (rs.O_RETURN_CODE == '0') {\n              Wb.tipSucc(\"修改成功\");\n              that.getRelatedInfo('_$client_id$_', '1');\n              that.getRelatedInfo('_$client_id$_', '2');\n              that.getRelatedInfo('_$client_id$_', '3');\n              that.getRelatedInfo('_$client_id$_', '4');\n              that.getRelatedInfo('_$client_id$_', '5');\n\n              if (op_flag == '2') {\n                that[dialogVisibleProp] = false;\n              }\n\n              let relaType = currentForm.related_type;\n              if (form == '1') {\n                that.editForm = {\n                  related_name: '', organ_flag: '0', nationality: '', id_type: '', id_no: '',\n                  id_begindate: '', id_enddate: '', is_government_dept: '', birthday: '',\n                  related_type: relaType, data_status: '0', title: that.formatDictMap('related_type_list', relaType),\n                  new_flag: true, _tempBatchList: []\n                };\n                if (that.$refs.editForm) that.$refs.editForm.clearValidate();\n              } else {\n                that.editForm1 = {\n                  related_name: '', organ_flag: '0', nationality: '', id_type: '', id_no: '',\n                  id_begindate: '', id_enddate: '', is_government_dept: '', birthday: '',\n                  beneficiary: '', shareholding_ratio: '', address: '', mobno1: '',\n                  related_type: relaType, data_status: '0', title: that.formatDictMap('related_type_list', relaType),\n                  new_flag: true, _tempBatchList: []\n                };\n              }\n            } else {\n              Wb.tipError(rs.O_RETURN_MSG);\n            }\n          }\n        });\n      }\n    },\n\n    // 校验关联主体弹窗\n    submitForm(form) {\n      let props = [];\n      let bool = true;\n      let msg = '';\n\n      // 获取当前表单对象\n      let currentFormObj = (form == '1') ? this.editForm : this.editForm1;\n      let refName = (form == '1') ? 'editForm' : 'editForm1';\n\n      // 如果是反洗钱特殊情况选择了“是”，关联人只校验1法定代表人、4授权代表人和 5受益所有人的姓名（如果打开了实际控制人、控股股东的弹窗则名称还是必填）。\n      if (this.ruleForm3 && this.ruleForm3.is_special == '1') {\n        // if (currentFormObj.related_type == '1' || currentFormObj.related_type == '4' || currentFormObj.related_type == '5') {\n        props = ['related_name'];\n        this.$refs[refName].validateField(props, function (valid) {\n          if (valid) {\n            bool = false;\n            msg += valid + '<br>';\n          }\n        });\n        // }\n      } else {\n        // 如果是反洗钱特殊情况选择了“否”，1法定代表人、4授权代表人和 5受益所有人所有表单项必填 （控股股东和实控人可以为无）\n        if (form == '2' && (currentFormObj.related_type == '1' || currentFormObj.related_type == '4' || currentFormObj.related_type == '5')) {\n          props = ['related_name', 'nationality', 'id_begindate', 'id_enddate', 'id_type', 'id_no'];\n          if (currentFormObj.organ_flag == '1') {\n            props.push('is_government_dept');\n          } else if (currentFormObj.organ_flag == '0') {\n            props.push('birthday');\n          }\n          if (currentFormObj.related_type == '5') {\n            props.push('beneficiary');\n            props.push('address');\n            if (currentFormObj.beneficiary == 'A1' || currentFormObj.beneficiary == 'A2' || currentFormObj.beneficiary == 'B1' || currentFormObj.beneficiary == 'D1') {\n              props.push('shareholding_ratio');\n            }\n          }\n          if (currentFormObj.related_type == '1' || currentFormObj.related_type == '4') {\n            props.push('mobno1');\n          }\n          this.$refs[refName].validateField(props, function (valid) {\n            if (valid) { bool = false; msg += valid + '<br>'; }\n          });\n        }\n\n        if (form == '1' && (currentFormObj.related_type == '2' || currentFormObj.related_type == '3')) {\n          props = ['related_name'];\n          if (currentFormObj.organ_flag == '0') {\n            props.push('birthday', 'id_type', 'id_no', 'id_begindate', 'id_enddate', 'nationality');\n          } else if (currentFormObj.organ_flag == '1' && currentFormObj.is_government_dept == '0') {\n            props.push('id_type', 'id_no', 'id_begindate', 'id_enddate', 'nationality');\n          }\n          this.$refs[refName].validateField(props, function (valid) {\n            if (valid) { bool = false; msg += valid + '<br>'; }\n          });\n        }\n      }\n\n      if (!bool && msg) {\n        this.showMessage(msg, 5000, 'error');\n      }\n      return bool;\n    },\n    // 客户基本信息查询\n    getBasicInfo(client_id, data_type) {\n      let that = this;\n      Wb.ajax({\n        url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/select_basic_info',\n        params: {\n          CLIENT_ID: client_id,\n          DATA_TYPE: data_type\n        },\n        async: false,\n        success(resp) {\n          let res = Wb.decode(resp).items;\n          console.log(\"getBasicInfo===\", res[0])\n          if (res[0]) {\n            that.basicInfo = res[0];\n            if ('_$organ_flag$_' == '1') {\n              that.ruleForm1 = { ...that.basicInfo };//机构户基本信息数据回显\n              if (that.ruleForm1.register_fund) {\n                that.ruleForm1.register_fund = that.formatMoney(that.ruleForm1.register_fund, '4');\n              }\n              that.uploadParams1.file_type_no = 72;// 与客户沟通记录\n              that.uploadParams2.file_type_no = 72;// 二级部门负责人同意的记录\n              that.uploadParams3.file_type_no = 72;// 其他底稿\n              console.log(\"that.ruleForm1\", that.ruleForm1);\n            } else {\n              that.ruleForm2 = { ...that.basicInfo };//个人户基本信息数据回显\n              that.uploadParams1.file_type_no = 3;// 与客户沟通记录\n              that.uploadParams2.file_type_no = 3;// 二级部门负责人同意的记录\n              that.uploadParams3.file_type_no = 3;// 其他底稿\n              console.log(\"that.ruleForm2\", that.ruleForm2);\n            }\n            that.ruleForm3 = {\n              is_special: that.basicInfo.is_special ? that.basicInfo.is_special : '0',\n              client_type: that.basicInfo.client_type ? that.basicInfo.client_type.split(',') : [],\n              client_type_other: that.basicInfo.client_type_other ? that.basicInfo.client_type_other : '',\n              special_matters: that.basicInfo.special_matters ? that.basicInfo.special_matters.split(',') : [],\n              missing_information: that.basicInfo.missing_information ? that.basicInfo.missing_information : '',\n              missing_draft: that.basicInfo.missing_draft ? that.basicInfo.missing_draft : '',\n              special_matters_other: that.basicInfo.special_matters_other ? that.basicInfo.special_matters_other : '',\n              special_reason: that.basicInfo.special_reason ? that.basicInfo.special_reason : '',\n              completed_cdd: that.basicInfo.completed_cdd ? that.basicInfo.completed_cdd : '',\n              low_risk_explanation: that.basicInfo.low_risk_explanation ? that.basicInfo.low_risk_explanation : '',\n              take_measures: that.basicInfo.take_measures ? that.basicInfo.take_measures : ''\n            };\n          }\n        }\n      });\n    },\n    // 关联主体查询\n    getRelatedInfo(client_id, rela_type) {\n      let that = this;\n      Wb.ajax({\n        url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/select_related_info',\n        params: {\n          CLIENT_ID: client_id,\n          RELATED_TYPE: rela_type,\n          // DATA_TYPE: '_$data_type$_'\n        },\n        async: false,\n        success(resp) {\n          let res = Wb.decode(resp).items;\n          if (rela_type == '1') {\n            that.relatedInfo1 = res;\n            console.log(\"法定代表人信息\", res);\n          } else if (rela_type == '2') {\n            that.relatedInfo2 = res;\n            console.log(\"控股股东信息\", res);\n          } else if (rela_type == '3') {\n            that.relatedInfo3 = res;\n            console.log(\"实际控制人信息\", res);\n          } else if (rela_type == '4') {\n            that.relatedInfo4 = res;\n            console.log(\"授权代表人信息\", res);\n          } else if (rela_type == '5') {\n            that.relatedInfo5 = res;\n            console.log(\"受益所有人信息\", res);\n          }\n        }\n      });\n    },\n    handleRemove(file, fileList) {\n      let that = this;\n      Wb.ajax({\n        url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/files/delete_file',\n        params: {\n          file_pk_id: file.response\n        },\n        success() {\n          that.fileList = fileList;\n        }\n      })\n    },\n    handleRemove1(file, fileList) {\n      let that = this;\n      Wb.ajax({\n        url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/files/delete_file',\n        params: {\n          file_pk_id: file.id\n        },\n        success() {\n          that.attachmentList.communication = fileList;\n        }\n      })\n    },\n    handleRemove2(file, fileList) {\n      let that = this;\n      Wb.ajax({\n        url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/files/delete_file',\n        params: {\n          file_pk_id: file.id\n        },\n        success() {\n          that.attachmentList.agree = fileList;\n        }\n      })\n    },\n    handleRemove3(file, fileList) {\n      let that = this;\n      Wb.ajax({\n        url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/files/delete_file',\n        params: {\n          file_pk_id: file.id\n        },\n        success() {\n          that.attachmentList.other = fileList;\n        }\n      })\n    },\n    handlePreview(file) {\n      let that = this;\n      let params_file = {\n        'id': file.id,\n        'clientId': file.client_id,\n        'fileTypeNo': this.organ_flag == '1' ? '1,2,21,22' : '1,2',\n        'fileName': file.name + '.' + file.extension,\n        'extension': file.extension\n      };\n      Wb.ajax({\n        url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/files/preview_file',\n        params: {\n          id: file.id,\n          clientId: file.client_id,\n          fileTypeNo: this.organ_flag == '1' ? '1,2,21,22' : '1,2',\n          fileName: file.name + '.' + file.extension,\n          extension: file.extension\n        },\n        success(resp) {\n          console.log(\"resp\", resp);\n          let res = Wb.decode(resp);\n          let serverIp = '10.116.131.13';\n          if (res.code == '200') {\n            let previewUrl = res.data.previewUrl;\n            if (previewUrl.indexOf(serverIp) != -1) {\n              previewUrl = res.data.previewUrl.replace(/10\\.116\\.131\\.13:8090/g, '10.181.135.22:8080/ibcm_flow')\n            }\n            window.open(previewUrl, '_blank', 'width=800,height=600')\n          } else {\n            that.$message.error(\"当前文件类型不支持预览\")\n          }\n        }\n      });\n    },\n    handleResizeMouseDown() { },\n    uploadSuccess() {\n      Wb.tipSucc(\"上传成功\");\n      this.fileDialogVisible = false;\n    },\n    uploadError() {\n      app.uploadError();\n    },\n    // 校验主表单\n    submit() {\n      console.log(\"进入了submit方法--------必填校验\");\n      let props = [];\n      let bool = true;\n      let msg = '';\n      // 1.如果是反洗钱特殊情况选择了“是”，则客户基本信息中的字段非必填，只校验ruleForm3反洗钱特殊情况模块，关联人只校验法定代表人、受益所有人和授权代表人的姓名。\n      if (this.ruleForm3.is_special == '1') {\n        console.log(\"this.attachmentList.communication\", this.attachmentList.communication);\n        console.log(\"this.attachmentList.agree\", this.attachmentList.agree);\n        // 1-1 关联人信息 只有机构类型客户（organ_flag='1'）需要维护关联人信息，自然人客户（organ_flag='0'）没有关联人信息\n        const emptyItem1 = this.relatedInfo1.find(item => {\n          return !item || item.related_name === null || item.related_name === undefined || item.related_name === '';\n        });\n        const emptyItem2 = this.relatedInfo4.find(item => {\n          return !item || item.related_name === null || item.related_name === undefined || item.related_name === '';\n        });\n        const emptyItem3 = this.relatedInfo5.find(item => {\n          return !item || item.related_name === null || item.related_name === undefined || item.related_name === '';\n        });\n        if ((emptyItem1 || this.relatedInfo1.length == 0) && this.organ_flag == '1') {\n          this.showMessage(\"请填写法定代表人姓名！\", 3000, 'error');\n          return;\n        }\n        if ((emptyItem2 || this.relatedInfo4.length == 0) && this.organ_flag == '1') {\n          this.showMessage(\"请填写授权代表人姓名！\", 3000, 'error');\n          return;\n        }\n        if ((emptyItem3 || this.relatedInfo5.length == 0) && this.organ_flag == '1') {\n          this.showMessage(\"请填写受益所有人姓名！\", 3000, 'error');\n          return;\n        }\n        // 1-2 附件信息\n        if (this.attachmentList.communication.length == 0) {\n          this.showMessage(\"请上传“与客户沟通记录”文件\", 3000, 'error');\n          return;\n        }\n        if (this.attachmentList.agree.length == 0) {\n          this.showMessage(\"请上传“二级部门负责人同意的记录”文件\", 3000, 'error');\n          return;\n        }\n        // 1-3 特殊情况表单信息\n        props = ['client_type', 'special_matters', 'special_reason', 'completed_cdd', 'low_risk_explanation', 'take_measures', 'communication_records', 'agree_records']\n        if (this.ruleForm3.client_type.indexOf('99') !== -1) {\n          props.push('client_type_other')\n        }\n        if (this.ruleForm3.special_matters.indexOf('1') !== -1) {\n          props.push('missing_information')\n        }\n        if (this.ruleForm3.special_matters.indexOf('2') !== -1) {\n          props.push('missing_draft')\n        }\n        if (this.ruleForm3.special_matters.indexOf('99') !== -1) {\n          props.push('special_matters_other')\n        }\n        this.$refs['ruleForm3'].validateField(props, function (valid) {\n          if (valid) {\n            bool = false;\n            msg += valid + '<br>';\n          } else {\n          }\n        });\n\n      } else {\n        const keys = Object.keys(this.ruleForm3);\n        for (const key of keys) {\n          if (key !== 'is_special') {\n            this.ruleForm3[key] = ''; // 除了is_special字段外，所有字段都清空为空字符串\n          }\n        }\n        // 2.若选择了“否”，则所有表单必填，控股股东与实控人表单允许为无\n        //   只有机构类型客户（organ_flag='1'）需要维护关联人信息，自然人客户（organ_flag='0'）没有关联人信息\n        if (this.relatedInfo1.length == 0 && this.organ_flag == '1') {\n          this.showMessage(\"请添加法定代表人信息！\", 3000, 'error');\n          return;\n        }\n        if (this.relatedInfo4.length == 0 && this.organ_flag == '1') {\n          this.showMessage(\"请添加授权代表人信息！\", 3000, 'error');\n          return;\n        }\n        if (this.relatedInfo5.length == 0 && this.organ_flag == '1') {\n          this.showMessage(\"请添加受益所有人信息！\", 3000, 'error');\n          return;\n        }\n        // if ((this.organ_flag === '1' && !this.ruleForm1.associated_date) ||\n        //   (this.organ_flag === '0' && !this.ruleForm2.associated_date)) {\n        //   this.showMessage(\"请填写“建立业务关系日期”\", 3000, 'error');\n        //   return;\n        // }\n        if (this.organ_flag == '1') {\n          // formNameArr = ['ruleForm1']; - 机构客户基本表单\n          props = ['client_name', 'office_address', 'register_country', 'register_money_type', 'register_fund',\n            'industry_type', 'tel', 'setup_date', 'id_type', 'id_no', 'id_begindate', 'id_enddate', 'busi_scope', 'associated_date'];\n          if (this.ruleForm1.register_country == '00CN') { //只有境内地区要校验省市区\n            props.push('province');\n            props.push('city');\n            props.push('district');\n          }\n          if (this.ruleForm1.industry_type == '26') {\n            props.push('industry_name');\n          }\n          this.$refs['ruleForm1'].validateField(props, function (valid) {\n            if (valid) {\n              bool = false;\n              msg += valid + '<br>';\n            } else {\n            }\n          });\n          // 关联人必填校验\n          const validateRelatedPerson = (infoArray, typeName) => {\n            const isEmpty = (val) => val === null || val === undefined || String(val).trim() === '';\n            const beneficiaryTypesNeedRatio = ['A1', 'A2', 'B1', 'D1'];\n\n            for (let i = 0; i < infoArray.length; i++) {\n              const item = infoArray[i];\n              const index = i + 1;\n\n              // 如果是政府部门，只校验姓名和是否政府部门字段\n              if (item.is_government_dept === '1') {\n                if (isEmpty(item.related_name)) {\n                  bool = false;\n                  msg += `${typeName}的姓名不能为空<br>`;\n                }\n                continue;\n              }\n\n              // 普通必填字段校验\n              if (isEmpty(item.related_name)) {\n                bool = false;\n                msg += `${typeName}的姓名不能为空<br>`;\n              }\n              if (isEmpty(item.nationality)) {\n                bool = false;\n                msg += `${typeName}${item.related_name}的国籍不能为空<br>`;\n              }\n              if (isEmpty(item.id_type)) {\n                bool = false;\n                msg += `${typeName}${item.related_name}的证件类型不能为空<br>`;\n              }\n              if (isEmpty(item.id_no)) {\n                bool = false;\n                msg += `${typeName}${item.related_name}的证件号码不能为空<br>`;\n              }\n              if (isEmpty(item.id_begindate)) {\n                bool = false;\n                msg += `${typeName}${item.related_name}的证件开始日期不能为空<br>`;\n              }\n              if (isEmpty(item.id_enddate)) {\n                bool = false;\n                msg += `${typeName}${item.related_name}的证件结束日期不能为空<br>`;\n              }\n\n              // 如果是机构（organ_flag='1'），校验是否政府部门字段\n              if (item.organ_flag === '1') {\n                if (item.is_government_dept !== '0' && item.is_government_dept !== '1') {\n                  bool = false;\n                  msg += `${typeName}${item.related_name}的是否政府部门不能为空<br>`;\n                }\n              }\n\n              // 如果是个人（organ_flag='0'），校验出生日期字段\n              if (item.organ_flag === '0') {\n                if (isEmpty(item.birthday)) {\n                  bool = false;\n                  msg += `${typeName}${item.related_name}的出生日期不能为空<br>`;\n                }\n              }\n\n              // 受益所有人特殊校验（related_type='5'）\n              if (item.related_type === '5') {\n                if (isEmpty(item.beneficiary)) {\n                  bool = false;\n                  msg += `${typeName}${item.related_name}的受益所有人类型不能为空<br>`;\n                }\n                if (isEmpty(item.address)) {\n                  bool = false;\n                  msg += `${typeName}${item.related_name}的地址不能为空<br>`;\n                }\n                // 如果受益所有人类型是A1/A2/B1/D1，校验股权比例\n                if (beneficiaryTypesNeedRatio.includes(item.beneficiary)) {\n                  if (isEmpty(item.shareholding_ratio)) {\n                    bool = false;\n                    msg += `${typeName}${item.related_name}的股权/表决权比例不能为空<br>`;\n                  }\n                }\n              }\n              // 法定代表人和授权代表人特殊校验（related_type='1' ||related_type='4'）\n              if (item.related_type === '1' || item.related_type === '4') {\n                if (isEmpty(item.mobno1)) {\n                  bool = false;\n                  msg += `${typeName}${item.related_name}的联系方式不能为空<br>`;\n                }\n              }\n            }\n          };\n\n          // 校验五种类型的关联人数据\n          validateRelatedPerson(this.relatedInfo1, '法定代表人');\n          validateRelatedPerson(this.relatedInfo2, '控股股东');\n          validateRelatedPerson(this.relatedInfo3, '实际控制人');\n          validateRelatedPerson(this.relatedInfo4, '授权代表人');\n          validateRelatedPerson(this.relatedInfo5, '受益所有人');\n        } else {\n          // formNameArr = ['ruleForm2']; - 自然人客户基本表单\n          props = ['client_name', 'birthday', 'id_address', 'address', 'nationality', 'gender', 'income',\n            'profession_code', 'id_type', 'id_no', 'id_begindate', 'id_enddate', 'associated_date'];\n          if (this.ruleForm2.nationality == '00CN') {\n            props.push('province1');\n            props.push('city1');\n            props.push('district1');\n            props.push('province2');\n            props.push('city2');\n            props.push('district2');\n          }\n          this.$refs['ruleForm2'].validateField(props, function (valid) {\n            if (valid) {\n              bool = false;\n              msg += valid + '<br>';\n            } else {\n\n            }\n          });\n        }\n      }\n      if (!bool && msg) {\n        this.showMessage(msg, 5000, 'error')\n      }\n      return bool;\n    },\n    loadSelectList(item) {\n      let that = this;\n      if (!Wb.isEmpty(item.KEY_NAME)) {\n        Wb.ajax({\n          url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/select_key',\n          params: {\n            I_KEY_NAME: item.KEY_NAME\n          },\n          success(resp) {\n            let arr = Wb.decode(resp).items;\n            that.selectList[item.BIND_DATA + \"_list\"] = arr;\n            console.log(that.selectList, '===that.selectList===');\n          }\n        });\n      }\n    },\n    getDictMap(item) {\n      let that = this;\n      Wb.ajax({\n        url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/select_dict',\n        params: {\n          I_ENTRY_NO: item.ENTRY_NO\n        },\n        success(resp) {\n          let arr = Wb.decode(resp).items;\n          that.selectList[item.BIND_DATA + \"_list\"] = arr;\n          console.log(that.selectList, '===that.selectList===');\n        }\n      })\n    },\n    clearRatio() {\n      if (this.editForm1.beneficiary != 'A1' && this.editForm1.beneficiary != 'A2' && this.editForm1.beneficiary != 'B1' && this.editForm1.beneficiary != 'D1') {\n        this.editForm1.shareholding_ratio = null;\n      }\n    },\n\n    // huangyuanyuan start\n    // 页面展示数据字典转换 多选\n    formatMultipleDictMap(dictType, key) {\n      var c_key = key || '';\n      if (c_key === '') { return ' '; }\n      const keyList = c_key.split(',');\n      const dictData = this.selectList[dictType];\n      const item = [];\n      for (let index = 0; index < keyList.length; index++) {\n        item.push(dictData?.find(item => item.k === keyList[index]));\n      }\n      return item.length && !!item[0] ? item.map(i => i.v).join('；') : '-';\n    },\n    nativeRadioClick: function (val, obj, key) {\n      if (obj[key] === val) {\n        setTimeout(() => {\n          this.$set(obj, key, '')\n        }, 200)\n      }\n    },\n    bomisBoTypeChange: function (newValue, form) {\n      if (newValue === '1') {\n        form.company_type = '';\n        form.bnf_type = '';\n      } else if (newValue === '2') {\n        form.company_type = '';\n        form.bnf_type = '';\n      } else if (newValue === '') {\n        form.company_type = '';\n        form.bnf_type = '';\n      }\n    },\n    getBomisCompanyType: function (form) {\n      if (form.bo_type === '1') {\n        this.bomisParams.benefit_company_no_list = this.selectList.benefit_company_no_list.filter(i => {\n          return i.k.startsWith('1') || i.k.startsWith('2') || i.k.startsWith('3') || i.k.startsWith('4') || i.k.startsWith('5') || i.k.startsWith('6')\n        });\n      } else if (form.bo_type === '2') {\n        this.bomisParams.benefit_company_no_list = this.selectList.benefit_company_no_list.filter(i => {\n          return !(i.k.startsWith('1') || i.k.startsWith('2') || i.k.startsWith('3') || i.k.startsWith('4') || i.k.startsWith('5') || i.k.startsWith('6'))\n        });\n      } else {\n        this.bomisParams.benefit_company_no_list = [];\n      }\n    },\n    bomisCompanyTypeChange: function (newValue, form) {\n      if (newValue !== '') {\n        form.bnf_type = '';\n      } else if (newValue === '') {\n        form.bnf_type = '';\n      }\n    },\n    getBomisBnfType: function (form) {\n      var firstChar = form.company_type[0] || '';\n      if (form.company_type !== '') {\n        this.bomisParams.bnf_type_new_list = this.selectList.bnf_type_new_list.filter(i => i.k.startsWith('N' + firstChar));\n      } else if (form.company_type === '') {\n        this.bomisParams.bnf_type_new_list = [];\n      }\n    },\n    bomisBnfTypeChange: function (newVal, form) {\n      var result = newVal;\n      if (newVal.length > 1) {\n        if (newVal.includes('NA1') && ['NA2-1', 'NA2-2', 'NA3-1', 'NA3-2', 'NA4'].includes(newVal.lastItem)) {\n          result.pop();\n        }\n        if (newVal.includes('NA4') && ['NA2-1', 'NA2-2', 'NA3-1', 'NA3-2', 'NA1'].includes(newVal.lastItem)) {\n          result.pop();\n        }\n        if ((newVal.includes('NA2-1') || newVal.includes('NA2-2'))) {\n          if (newVal.includes('NA3-1') && ['NA4', 'NA3-2', 'NA1'].includes(newVal.lastItem)) { result.pop(); }\n          if (newVal.includes('NA3-2') && ['NA4', 'NA3-1', 'NA1'].includes(newVal.lastItem)) { result.pop(); }\n          if (['NA4', 'NA1'].includes(newVal.lastItem)) { result.pop(); }\n        }\n        if (newVal.includes('NA3-1') && ['NA4', 'NA3-2', 'NA1'].includes(newVal.lastItem)) { result.pop(); }\n        if (newVal.includes('NA3-2') && ['NA4', 'NA3-1', 'NA1'].includes(newVal.lastItem)) { result.pop(); }\n\n        if (newVal.includes('NB1') && ['NB2-1', 'NB2-2', 'NB3-1', 'NB3-2', 'NB4'].includes(newVal.lastItem)) {\n          result.pop();\n        }\n        if (newVal.includes('NB4') && ['NB2-1', 'NB2-2', 'NB3-1', 'NB3-2', 'NB1'].includes(newVal.lastItem)) {\n          result.pop();\n        }\n        if ((newVal.includes('NB2-1') || newVal.includes('NB2-2'))) {\n          if (newVal.includes('NB3-1') && ['NB4', 'NB3-2', 'NB1'].includes(newVal.lastItem)) { result.pop(); }\n          if (newVal.includes('NB3-2') && ['NB4', 'NB3-1', 'NB1'].includes(newVal.lastItem)) { result.pop(); }\n          if (['NB4', 'NB1'].includes(newVal.lastItem)) { result.pop(); }\n        }\n        if (newVal.includes('NB3-1') && ['NB4', 'NB3-2', 'NB1'].includes(newVal.lastItem)) { result.pop(); }\n        if (newVal.includes('NB3-2') && ['NB4', 'NB3-1', 'NB1'].includes(newVal.lastItem)) { result.pop(); }\n\n\n\n        if (newVal.includes('ND1') && ['ND2-1', 'ND2-2', 'ND3', 'ND4'].includes(newVal.lastItem)) {\n          result.pop();\n        }\n        if ((newVal.includes('ND2-1') || newVal.includes('ND2-2'))) {\n          if (newVal.includes('ND3') && ['ND4', 'ND1'].includes(newVal.lastItem)) { result.pop(); }\n          if (['ND4', 'ND1'].includes(newVal.lastItem)) { result.pop(); }\n        }\n        if (newVal.includes('ND3') && ['ND4', 'ND1'].includes(newVal.lastItem)) { result.pop(); }\n\n        if (newVal.includes('NE1') && ['NE2'].includes(newVal.lastItem)) {\n          result.pop();\n        }\n        if (newVal.includes('NE2') && ['NE1'].includes(newVal.lastItem)) {\n          result.pop();\n        }\n\n        // this.bomisParams.editBomisForm.bnf_type = result;\n        form.bnf_type = result;\n      }\n    },\n    addBomisBnfInfo: function () {\n      var that = this;\n      that.$refs.editBenefitForm.validate((valid) => {\n        if (valid) {\n          Wb.ajax({\n            url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/add_bomis_benefit_scinfo',\n            params: { client_id: '_$client_id$_', benefit_scinfo: that.bomisParams.editBomisForm },\n            json: true,\n            success(resp) {\n              if (resp.O_RETURN_CODE !== -1) {\n                Wb.tipSucc('添加成功');\n                that.getRelatedInfo('_$client_id$_', '5');\n                that.getBomisSourceTableData();\n              } else {\n                Wb.error(resp.O_RETURN_MSG);\n              }\n            }\n          });\n        } else {\n          console.log('error submit!!');\n          return false;\n        }\n      });\n    },\n    editBomisBnfInfo: function () {\n      var that = this;\n      that.$refs.editOneBenefitForm.validate((valid) => {\n        if (valid) {\n          Wb.ajax({\n            url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/edit_bomis_benefit_scinfo',\n            params: { client_id: '_$client_id$_', benefit_scinfo: that.bomisParams.editOneBenefitForm },\n            json: true,\n            success(resp) {\n              if (resp.O_RETURN_CODE !== -1) {\n                Wb.tipSucc('添加成功');\n                that.getRelatedInfo('_$client_id$_', '5');\n                that.bomisParams.benefitEditDialogVisible = false;\n                that.getBomisSourceTableData();\n              } else {\n                Wb.error(resp.O_RETURN_MSG);\n              }\n            }\n          });\n        } else {\n          console.log('error submit!!');\n          return false;\n        }\n      });\n    },\n    showBenefitEditDialog: function (row) {\n      var that = this;\n      this.bomisParams.editOneBenefitForm = row;\n      // 编辑单个受益人信息的时候，需要先预加载下拉框的内容\n      if (that.bomisParams.editOneBenefitForm.bo_type === '1') {\n        this.bomisParams.benefit_company_no_list = this.selectList.benefit_company_no_list.filter(i => {\n          return i.k.startsWith('1') || i.k.startsWith('2') || i.k.startsWith('3') || i.k.startsWith('4') || i.k.startsWith('5') || i.k.startsWith('6')\n        });\n        this.bomisParams.editOneBenefitForm.company_type = '';\n        this.bomisParams.editOneBenefitForm.bnf_type = ''; // 1 是无需识别受益所有人\n      } else if (that.bomisParams.editOneBenefitForm.bo_type === '2') {\n        this.bomisParams.benefit_company_no_list = this.selectList.benefit_company_no_list.filter(i => {\n          return !(i.k.startsWith('1') || i.k.startsWith('2') || i.k.startsWith('3') || i.k.startsWith('4') || i.k.startsWith('5') || i.k.startsWith('6'))\n        });\n      } else if (that.bomisParams.editOneBenefitForm.bo_type === '') {\n        this.bomisParams.benefit_company_no_list = [];\n      }\n      var firstChar = (this.bomisParams.editOneBenefitForm.company_type !== '' && this.bomisParams.editOneBenefitForm.company_type !== null) ? this.bomisParams.editOneBenefitForm.company_type[0] : '';\n      if (this.bomisParams.editOneBenefitForm.bo_type !== '') {\n        this.bomisParams.bnf_type_new_list = this.selectList.bnf_type_new_list.filter(i => i.k.startsWith('N' + firstChar));\n      } else if (this.bomisParams.editOneBenefitForm.bo_type === '') {\n        this.bomisParams.bnf_type_new_list = [];\n      }\n      this.bomisParams.benefitEditDialogVisible = true;\n    },\n    delBomisBnfInfo: function (row) {\n      var that = this;\n      that.$confirm('确认删除当前受益人信息？', '确认', {\n        distinguishCancelAndClose: true,\n        confirmButtonText: '确认',\n        cancelButtonText: '取消'\n      }).then(() => {\n        Wb.ajax({\n          url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/del_bomis_benefit_scinfo',\n          params: { client_id: '_$client_id$_', benefit_scinfo: row },\n          json: true,\n          success(resp) {\n            if (resp.O_RETURN_CODE !== -1) {\n              Wb.tipSucc('删除成功');\n              that.getRelatedInfo('_$client_id$_', '5');\n              that.getBomisSourceTableData();\n            } else {\n              Wb.error(resp.O_RETURN_MSG);\n            }\n          }\n        });\n      });\n    },\n    getBomisSourceTableData: function () {\n      var that = this;\n      Wb.ajax({\n        url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/select_bomis_benefit_scinfo',\n        params: { client_id: '_$client_id$_' },\n        json: true,\n        success(resp) {\n          that.bomisParams.bomisSourceTableData = resp.items;\n\n          if (that.bomisParams.bomisSourceTableData.filter(i => {\n\n            var item = i.company_type || '';\n            return item.startsWith('A') || item.startsWith('B') || item.startsWith('I');\n          }\n          ).length) {\n            that.bomisParams.onlineBomisCheckBtnDisable = false;\n          } else {\n            that.bomisParams.onlineBomisCheckBtnDisable = true;\n          }\n        }\n      });\n    },\n    getLastOnlineBomisCheckRs: function () {\n      var that = this;\n      var params = {\n        client_id: '_$client_id$_'\n      };\n      Wb.ajax({\n        url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/select_his_bomis_response',\n        params: params,\n        json: true,\n        success(resp) {\n          if (resp.total > 0) {\n            if (!resp.items[0].response_info) { return; }\n            var response_info = JSON.parse(JSON.parse(resp.items[0].response_info));\n            that.bomisParams.bomisLastCheckResult = response_info;\n            that.bomisParams.bomisLastCheckResult.op_time = resp.items[0].op_time;\n            // JSON.parse(resp.items[0].response_info)\n            that.bomisParams.bomisLastCheckResultList = [];\n            if (response_info.NoDiffList[0].CONS_COUNT > 0) {\n              var tmpList = response_info.NoDiffList[0].ConsList.map(item => {\n                const newItem = {};\n                for (const key in item) {\n                  newItem[key.toLowerCase()] = item[key];\n                }\n                return newItem;\n              });\n              tmpList.forEach(function (i) { i.check_type_code = 'cons'; i.check_type_name = '核验一致'; });\n              that.bomisParams.bomisLastCheckResultList = that.bomisParams.bomisLastCheckResultList.concat(tmpList);\n\n            }\n            if (response_info.NoDiffList[0].LACK_COUNT > 0) {\n              // var tmpList = structuredClone(response_info.NoDiffList[0].LackList);\n              var tmpList = response_info.NoDiffList[0].LackList.map(item => {\n                const newItem = {};\n                for (const key in item) {\n                  newItem[key.toLowerCase()] = item[key];\n                }\n                return newItem;\n              });\n              tmpList.forEach(function (i) { i.check_type_code = 'lack'; i.check_type_name = '受益人缺失'; });\n              that.bomisParams.bomisLastCheckResultList = that.bomisParams.bomisLastCheckResultList.concat(tmpList);\n            }\n            if (response_info.NoDiffList[0].MORE_COUNT > 0) {\n              // var tmpList = structuredClone(response_info.NoDiffList[0].MoreList);\n              var tmpList = response_info.NoDiffList[0].MoreList.map(item => {\n                const newItem = {};\n                for (const key in item) {\n                  newItem[key.toLowerCase()] = item[key];\n                }\n                return newItem;\n              });\n              tmpList.forEach(function (i) { i.check_type_code = 'more'; i.check_type_name = '受益人多出'; });\n              that.bomisParams.bomisLastCheckResultList = that.bomisParams.bomisLastCheckResultList.concat(tmpList);\n            }\n            if (response_info.NoDiffList[0].ELMT_COUNT > 0) {\n              // var tmpList = structuredClone(response_info.NoDiffList[0].ElmtList);\n              var tmpList = response_info.NoDiffList[0].ElmtList.map(item => {\n                const newItem = {};\n                for (const key in item) {\n                  newItem[key.toLowerCase()] = item[key];\n                }\n                return newItem;\n              });\n              tmpList.forEach(function (i) { i.check_type_code = 'elmt'; i.check_type_name = '个人信息要素项不一致'; });\n              that.bomisParams.bomisLastCheckResultList = that.bomisParams.bomisLastCheckResultList.concat(tmpList);\n            }\n            if (response_info.NoDiffList[0].PERP_COUNT > 0) {\n              // var tmpList = structuredClone(response_info.NoDiffList[0].PerpList);\n              var tmpList = response_info.NoDiffList[0].PerpList.map(item => {\n                const newItem = {};\n                for (const key in item) {\n                  newItem[key.toLowerCase()] = item[key];\n                }\n                return newItem;\n              });\n              tmpList.forEach(function (i) { i.check_type_code = 'perp'; i.check_type_name = '备案主体填报类型为承诺免报'; });\n              that.bomisParams.bomisLastCheckResultList = that.bomisParams.bomisLastCheckResultList.concat(tmpList);\n            }\n            if (response_info.NoDiffList[0].SCEC_COUNT > 0) {\n              var tmpList = response_info.NoDiffList[0].ScecList.map(item => {\n                const newItem = {};\n                for (const key in item) {\n                  newItem[key.toLowerCase()] = item[key];\n                }\n                return newItem;\n              });\n              // var tmpList = structuredClone(response_info.NoDiffList[0].ScecList);\n              tmpList.forEach(function (i) { i.check_type_code = 'scec'; i.check_type_name = '备案主体填报类型为国有公司'; });\n              that.bomisParams.bomisLastCheckResultList = that.bomisParams.bomisLastCheckResultList.concat(tmpList);\n            }\n          }\n        }\n      });\n    },\n    onlineBomisCheck: function () {\n      // 收益所有人实时核验\n      var that = this;\n      var params = {\n        client_id: '_$client_id$_',\n        uscc: that.ruleForm1.id_no, // 统一社会信用代码\n        orgNm: that.ruleForm1.client_name, // 主体名称\n        branchCode: \"E1005431000011\",\n        branchName: \"国泰海通证券股份有限公司\",\n        benefitData: that.bomisParams.bomisSourceTableData,\n        orgTp: \"1\" // 1-公司  2-合伙企业 3-外国公司分支机构 4-豁免主体\n      };\n      that.$confirm('确定进行受益人信息核验？', '确认', {\n        distinguishCancelAndClose: true,\n        confirmButtonText: '确认',\n        cancelButtonText: '取消'\n      }).then(() => {\n\n        Wb.ajax({\n          url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/online_bomis_check',\n          params: params,\n          json: true,\n          success(resp) {\n            that.getLastOnlineBomisCheckRs();\n          }\n        });\n      })\n    }\n  },\n  watch: {\n    'bomisParams.editBomisForm': {\n      handler(newVal, oldVal) {\n        var that = this;\n        if (that.bomisParams.bnf_type_new_list.length) {\n          that.$set(that.bomisParams.editBomisFormRules, 'bnf_type', [\n            { required: true, message: '请选择受益所有权类型', trigger: 'change' }\n          ]);\n        } else {\n          that.$delete(that.bomisParams.editBomisFormRules, 'bnf_type')\n          that.$nextTick(() => {\n            that.$refs.editBenefitForm.clearValidate('bnf_type')\n          })\n        }\n        if (newVal.bnf_type !== oldVal.bnf_type) {\n          // actCtrlCpny 2:协议约定形式，3:其他形式\n          if (that.bomisParams.editBomisForm.bnf_type.length && (that.bomisParams.editBomisForm.bnf_type.includes('NA3-1') || that.bomisParams.editBomisForm.bnf_type.includes('NB3-1'))) {\n            that.bomisParams.editBomisForm.actctrlcpny = '2';\n          }\n          if (that.bomisParams.editBomisForm.bnf_type.length && that.bomisParams.editBomisForm.bnf_type.includes('NA3-2')) {\n            that.bomisParams.editBomisForm.actctrlcpny = '3';\n          }\n        }\n      },\n      deep: true\n    },\n    'bomisParams.editOneBenefitForm': {\n      handler(newVal, oldVal) {\n        var that = this;\n        if (that.bomisParams.bnf_type_new_list.length) {\n          that.$set(that.bomisParams.editOneBenefitFormRules, 'bnf_type', [\n            { required: true, message: '请选择受益所有权类型', trigger: 'change' }\n          ]);\n        } else {\n          that.$delete(that.bomisParams.editOneBenefitFormRules, 'bnf_type')\n          that.$nextTick(() => {\n            that.$refs.editOneBenefitForm.clearValidate('bnf_type')\n          })\n        }\n        if (newVal.bnf_type !== oldVal.bnf_type) {\n          // actCtrlCpny 2:协议约定形式，3:其他形式\n          if (that.bomisParams.editOneBenefitForm.bnf_type.length && that.bomisParams.editOneBenefitForm.bnf_type.includes('NA3-1')) { that.bomisParams.editOneBenefitForm.actctrlcpny = '2'; }\n          if (that.bomisParams.editOneBenefitForm.bnf_type.length && that.bomisParams.editOneBenefitForm.bnf_type.includes('NA3-2')) { that.bomisParams.editOneBenefitForm.actctrlcpny = '3'; }\n        }\n      },\n      deep: true\n    },\n  },\n  created: async function () {\n    let that = this;\n    this.activeNav += this._uid;\n    let navList_jg = [\n      {\n        label: '客户基本信息',\n        value: 'basicInfo',\n        name: '#basicInfo'\n      }, {\n        label: '反洗钱特殊情况',\n        value: 'fxqSpecial',\n        name: '#fxqSpecial'\n      }, {\n        label: '法定代表人',\n        value: 'LegalRep',\n        name: '#LegalRep'\n      }, {\n        label: '控股股东',\n        value: 'controllingShareholder',\n        name: '#controllingShareholder'\n      }, {\n        label: '实际控制人',\n        value: 'actualController',\n        name: '#actualController'\n      }, {\n        label: '授权代表人',\n        value: 'authorizedRep',\n        name: '#authorizedRep'\n      }, {\n        label: '受益所有人',\n        value: 'beneficialOwner',\n        name: '#beneficialOwner'\n      },\n    ];\n    let navList_gr = [\n      {\n        label: '客户基本信息',\n        value: 'basicInfo',\n        name: '#basicInfo'\n      }, {\n        label: '反洗钱特殊情况',\n        value: 'fxqSpecial',\n        name: '#fxqSpecial'\n      }\n    ];\n    this.navList = '_$organ_flag$_' === '1' ? navList_jg : navList_gr;\n    this.navList.forEach(ele => {\n      ele.value += that._uid;\n    });\n    // app.data.list.forEach(async item => {\n    //   await this.loadSelectList(item);\n    // });\n\n    // app.data.dict.forEach(async item => {\n    //   await this.getDictMap(item);\n    // });\n    this.getProvince();\n    // 查询客户基本信息\n    await this.getBasicInfo('_$client_id$_', '_$data_type$_');\n    // 获取法定代表人信息\n    await this.getRelatedInfo('_$client_id$_', '1');\n    // 获取控股股东信息\n    await this.getRelatedInfo('_$client_id$_', '2');\n    // 获取实际控制人信息\n    await this.getRelatedInfo('_$client_id$_', '3');\n    // 获取授权代表人信息\n    await this.getRelatedInfo('_$client_id$_', '4');\n    // 获取受益所有人信息\n    await this.getRelatedInfo('_$client_id$_', '5');\n    await this.selectFile();\n\n    // 从全局获取数据\n    console.log('====app.data.dict====', app.data.selectList);\n    console.log('====key====', '_$key$_');\n    console.log('====cur_user====', '_$cur_user$_');\n\n    // this.selectList = { ...app.data.selectList }\n    this.rules = app.data.rules;\n    this.rules1 = app.data.rules1;\n\n    // 为客户基本信息表单添加证件号码格式校验\n    // 需要复制一份 rules，避免影响其他表单\n    this.rules = JSON.parse(JSON.stringify(app.data.rules));\n    if (this.rules.id_no) {\n      this.rules.id_no.push({\n        validator: this.validateIdNoForBasicInfo(),\n        trigger: 'change'\n      });\n    }\n\n    // 为关联人弹窗添加证件号码格式校验\n    this.rules1 = JSON.parse(JSON.stringify(app.data.rules1));\n    if (this.rules1.id_no) {\n      this.rules1.id_no.push({\n        validator: this.validateIdNoForRelated(),\n        trigger: 'change'\n      });\n    }\n    this.loading = false;\n  },\n  mounted: function () {\n  },\n});"
                  }
                }
              ]
            },
            {
              "_icon": "card",
              "text": "card2",
              "cls": "Wb.Card",
              "properties": {
                "cid": "card2",
                "title": "附件导入",
                "closable": "null",
                "layout": "fit",
                "maxWidth": "1920px",
                "margin": "0 auto"
              },
              "_expanded": false,
              "items": [
                {
                  "_icon": "container",
                  "text": "fileManage",
                  "cls": "Wb.Container",
                  "properties": {
                    "cid": "fileManage"
                  },
                  "events": {
                    "ready": "let comp = this;\ncomp.vue = new Vue({\n  el: comp.el.addEl(),\n  template: `\n<div class=\"file-container\">\n  <!-- 左侧目录树 -->\n  <div class=\"left-panel\" ref=\"leftPanel\">\n    <div class=\"panel-title\">附件类型目录</div>\n    <div class=\"search-box\">\n      <el-input placeholder=\"输入关键字进行过滤\" v-model.trim=\"filterText\" clearable>\n        <i slot=\"prefix\" class=\"el-input__icon el-icon-search\"></i>\n      </el-input>\n    </div>\n\n    <el-tree class=\"filter-tree\" ref=\"tree\" :data=\"organ_flag==='0'?directoryConfig2:directoryConfig1\"\n      :props=\"defaultProps\" default-expand-all :filter-node-method=\"filterNode\" :expand-on-click-node=\"false\"\n      @node-click=\"handleNodeClick\" highlight-current>\n      <span class=\"custom-tree-node\" slot-scope=\"{ node, data }\"\n          :data-node-key=\"data.value\"\n          @dragenter=\"handleTreeDragEnter($event, node, data)\"\n          @dragover=\"handleTreeDragOver($event, node, data)\"\n          @drop=\"handleTreeDrop($event, node, data)\">\n            <span>{{ node.label }}</span>\n      </span>\n    </el-tree>\n  </div>\n\n  <!-- 右侧附件列表 -->\n  <div class=\"right-panel\" style=\"overflow-y:auto\">\n    <!--<div style=\"color:#F56C6C;padding-left:0 0 40px 0;\">【*附件上传后即为保存，将不允许修改和删除，如有错误可用新的同名文件更新替换】</div>-->\n    <div v-if=\"!selectedMenu\" style=\"display: flex; justify-content: center; align-items: center; height: 100%; color: #909399; font-size: 14px;\">请先从左侧选择目录</div>\n    <div v-else>\n      <div class=\"panel-title\">附件清单 - {{ selectedMenu.label }}</div>\n      <el-table :data=\"attachmentList\" stripe border class=\"attachment-table\" v-loading=\"loading\" :default-sort = \"{prop: 'date', order: 'descending'}\">\n        <el-table-column prop=\"name\" label=\"附件名称\" min-width=\"180\" sortable>\n          <template slot-scope=\"scope\">\n            <el-button type=\"text\" @click=\"handleDownload(scope.row)\" class=\"attachment-btn\" draggable=\"true\"\n              native-type=\"button\" @dragstart.native=\"handleDragStart(scope.row)\">\n              {{ scope.row.name }}\n            </el-button>\n          </template>\n        </el-table-column>\n        <el-table-column prop=\"extension\" label=\"附件类型\" width=\"120\"></el-table-column>\n        <el-table-column prop=\"create_time\" label=\"上传时间\" width=\"160\" sortable></el-table-column>\n        <el-table-column prop=\"file_size\" label=\"附件大小\" width=\"120\">\n          <template slot-scope=\"scope\">\n            {{ formatSize(scope.row.file_size) }}\n          </template>\n        </el-table-column>\n        <el-table-column prop=\"create_by\" label=\"上传人\" width=\"120\" sortable></el-table-column>\n        <el-table-column label=\"操作\" width=\"150\" fixed=\"right\">\n          <template slot-scope=\"scope\">\n            <div class=\"operation-buttons\">\n              <el-tooltip content=\"预览\">\n                <el-button type=\"text\" class=\"el-icon-view\" @click=\"handlePreview(scope.row)\"></el-button>\n              </el-tooltip>\n              <el-tooltip content=\"下载\">\n                <el-button type=\"text\" class=\"el-icon-download\" @click=\"handleDownload(scope.row)\"></el-button>\n              </el-tooltip>\n              <!--<el-tooltip content=\"删除\">\n                <el-button type=\"text\" class=\"el-icon-delete\" @click=\"handleDelete(scope.row)\"></el-button>\n              </el-tooltip>-->\n            </div>\n          </template>\n        </el-table-column>\n      </el-table>\n      <div style=\"display:flex;width:100%\" v-if=\"this.selectedMenu.label!='全部'\">\n        <el-upload class=\"upload-demo-drag\" ref=\"upload\" drag\n          action=\"m?xwl=aml_monitor/workflow/prs01/dataSource/files/upload_file1\" name=\"file1\"\n          header=\"{content-type:'text/html'}\" :data=\"uploadParams\" :auto-upload=\"true\" :on-change=\"handleChange\"\n          :on-remove=\"handleRemove\" :on-success=\"handleSuccess\" :show-file-list=\"false\" multiple style=\"flex:1\">\n          <i class=\"el-icon-upload\"></i>\n          <div class=\"el-upload__text\">将文件拖到此处，或<em>点击上传</em></div>\n        </el-upload>\n      </div>\n    </div>\n  </div>\n</div>\n`,\n  data() {\n    return {\n      filterText: '',\n      organ_flag: '_$organ_flag$_',\n      // 非自然人附件目录\n      directoryConfig1: app.data.directory.directoryConfig1,\n      // 自然人附件目录\n      directoryConfig2: app.data.directory.directoryConfig2,\n      defaultProps: {\n        children: 'children',\n        label: 'label'\n      },\n      uploadParams: {\n        objectId: Wb.getId(),\n        client_id: '_$client_id$_'\n      },\n      selectedMenu: null,\n      attachmentList: [],\n      loading: false,\n      fileList: [],\n      dropTargetNode: null, // 接收拖拽的树节点\n      draggingFile: null, // 当前拖拽的文件\n    };\n  },\n  // 新增 watch：监听 filterText 变化并触发 tree 过滤\n  watch: {\n    filterText(val) {\n      // 必须等 DOM 更新后才能调用 $refs.tree\n      this.$nextTick(() => {\n        if (this.$refs.tree) {\n          this.$refs.tree.filter(val);\n        }\n      });\n    }\n  },\n  methods: {\n    // 过滤方法\n    filterNode(value, data) {\n      if (!value) return true;\n      // 支持模糊搜索（不区分大小写）\n      return data.label.toLowerCase().includes(value.toLowerCase());\n    },\n\n    // 处理节点点击\n    handleNodeClick(data) {\n      this.selectedMenu = data;\n      console.log(\"selectedMenu\", this.selectedMenu);\n      this.uploadParams.file_type_no = this.selectedMenu.value;\n      this.loadAttachments(this.selectedMenu.value);\n    },\n    // 格式化附件大小\n    formatSize(bytes) {\n      if (!bytes && bytes !== 0) {\n        return '';\n      } else if (bytes === 0) {\n        return '0 B'\n      };\n\n      const k = 1024;\n      const sizes = ['B', 'KB', 'MB', 'GB', 'TB'];\n      const i = Math.floor(Math.log(bytes) / Math.log(k));\n\n      return (bytes / Math.pow(k, i)).toFixed(2) + ' ' + sizes[i];\n    },\n    // 加载附件列表\n    loadAttachments(directoryId) {\n      let that = this;\n      Wb.ajax({\n        url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/files/select_file',\n        params: {\n          I_CLIENT_ID: '_$client_id$_',\n          I_FILE_TYPE_NO: String(directoryId)\n        },\n        success(resp) {\n          let res = Wb.decode(resp).items;\n          that.attachmentList = res;\n        }\n      });\n    },\n    // 下载附件\n    handleDownload(row) {\n      console.log(\"当前文件row\", row);\n      if (row.file_size!==0) {\n        Wb.download({\n          url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/files/download_file',\n          params: {\n            id: row.id,\n            full_name: row.name + '.' + row.extension\n          }\n        })\n      } else {\n        this.$message.error('当前文件为空！请确认上传是否无误');\n      }\n    },\n    handleChange(file, fileList) {\n      this.fileList = fileList\n      app.mainContainer.vue.selectFile();\n    },\n    // 删除附件\n    handleDelete(row) {\n      this.$confirm(`确定要删除\"${row.name}\"吗?`, '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(() => {\n        console.log(row)\n        let that = this;\n        Wb.ajax({\n          url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/files/delete_file',\n          params: {\n            file_pk_id: row.id\n          },\n          success() {\n            that.$message.success('删除成功');\n            that.loadAttachments(that.selectedMenu.value);\n            app.mainContainer.vue.selectFile();\n            console.log(\"app.basicInfo.vue\", app.basicInfo.vue);\n          }\n        })\n      }).catch(() => { });\n    },\n    handleSuccess() {\n      Wb.tipSucc(\"上传成功\");\n      this.loadAttachments(this.selectedMenu.value);\n    },\n    // 上传相关方法\n    handleRemove(file, fileList) {\n      console.log(file, fileList);\n    },\n    handlePreview(file) {\n      let that = this;\n      params_file = {\n        'id': file.id,\n        'clientId': file.client_id,\n        'fileTypeNo': this.organ_flag == '1' ? '1,2,21,22' : '1,2',\n        'fileName': file.name + '.' + file.extension,\n        'extension': file.extension\n      },\n        Wb.ajax({\n          url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/files/preview_file',\n          params: {\n            id: file.id,\n            clientId: file.client_id,\n            fileTypeNo: this.organ_flag == '1' ? '1,2,21,22' : '1,2',\n            fileName: file.name + '.' + file.extension,\n            extension: file.extension\n          },\n          success(resp) {\n            console.log(\"resp\", resp);\n            let res = Wb.decode(resp);\n            let serverIp = '10.116.131.13';\n            if (res.code == '200') {\n              let previewUrl = res.data.previewUrl;\n              if (previewUrl.indexOf(serverIp) != -1) {\n                previewUrl = res.data.previewUrl.replace(/10\\.116\\.131\\.13:8090/g, '10.181.135.22:8080/ibcm_flow')\n              }\n              window.open(previewUrl, '_blank', 'width=800,height=600')\n            } else {\n              that.$message.error(\"当前文件类型不支持预览\")\n            }\n          }\n        });\n    },\n    handleExceed(files, fileList) {\n      this.$message.warning(`当前限制选择 3 个文件，本次选择了 ${files.length} 个文件，共选择了 ${files.length + fileList.length} 个文件`);\n    },\n    beforeRemove(file, fileList) {\n      return this.$confirm(`确定移除 ${file.name}？`);\n    },\n\n    // 文件拖拽开始\n    handleDragStart(file) {\n      this.draggingFile = file;\n      console.log(\"dragfile:\", this.draggingFile);\n    },\n\n    // 树节点拖拽进入\n    handleTreeDragEnter(event, node, data) {\n      event.preventDefault();\n      this.dropTargetNode = node;\n    },\n    // 树节点经过\n    handleTreeDragOver(event, node, data) {\n      console.log(\"handleTreeDragOver\", node.data);\n      event.preventDefault(); // 必须，否则 drop 不生效\n      this.dropTargetNode = node;\n    },\n    // 树节点 drop 事件\n    handleTreeDrop(event) {\n      let that = this;\n      console.log(\"handleTreeDrop\");\n      event.preventDefault();\n      event.stopPropagation();\n\n      if (!this.draggingFile || !this.dropTargetNode) return;\n\n      const file = this.draggingFile;\n      const targetNode = this.dropTargetNode;\n\n      let tip = '确定要把 “' + file.name + '” 移动到 “' + targetNode.label + '” 目录下吗？'\n      Wb.confirm(tip, function () {\n        Wb.ajax({\n          url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/files/update_file_dir',\n          params: {\n            I_FILE_TYPE_NO: targetNode.data.value,\n            I_ID: file.id\n          },\n          success(resp) {\n            that.loadAttachments(that.selectedMenu.value);\n            that.$message.success(\"操作成功\");\n            app.mainContainer.vue.selectFile();\n          }\n        })\n      });\n      // 清理数据\n      this.draggingFile = null;\n      this.dropTargetNode = null;\n    },\n  },\n  mounted: function () {\n    // 实现左侧面板宽度可调节\n    const leftPanel = this.$refs.leftPanel;\n    let isResizing = false;\n    leftPanel.addEventListener('mouseenter', (e) => {\n      if (e.offsetX > leftPanel.offsetWidth - 5) {\n        document.body.style.cursor = 'col-resize';\n      }\n    });\n    leftPanel.addEventListener('mouseleave', (e) => {\n      if (e.offsetX > leftPanel.offsetWidth - 10) {\n        document.body.style.cursor = 'auto';\n      }\n    });\n    leftPanel.addEventListener('mousedown', (e) => {\n      if (e.offsetX > leftPanel.offsetWidth - 10) {\n        isResizing = true;\n        document.body.style.cursor = 'col-resize';\n        document.body.style.userSelect = 'none';\n      }\n    });\n\n    document.addEventListener('mousemove', (e) => {\n      if (!isResizing) return;\n\n      const newWidth = e.clientX - leftPanel.getBoundingClientRect().left;\n      if (newWidth >= 250 && newWidth <= 600) {\n        leftPanel.style.width = newWidth + 'px';\n      }\n    });\n\n    document.addEventListener('mouseup', () => {\n      isResizing = false;\n      document.body.style.cursor = '';\n      document.body.style.userSelect = '';\n    });\n  }\n});"
                  },
                  "hasDupCid": 0
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}