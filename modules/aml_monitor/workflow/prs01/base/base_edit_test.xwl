idate('editBomisForm')\" class=\"formitem-full-width formitem-max-width\">\n                <el-option v-for=\"item in selectList.id_type_gr_list\" :key=\"item.k\" :label=\"item.v\" :value=\"item.k\">\n                </el-option>\n              </el-select>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <el-form-item prop=\"id_no\" label=\"证件编号\" class=\"always-show-required\">\n              <el-input v-model=\"bomisParams.editBomisForm.id_no\" placeholder=\"请输入\" clearable style=\"max-width: 325px;\">\n              </el-input>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <div style=\"height:28px;line-height:28px;font-size:14px;color:#606266;\">\n              证件有效期\n            </div>\n            <div style=\"display:flex;width:100%;gap:8px;\">\n              <el-form-item prop=\"id_begindate\">\n                <el-date-picker v-model=\"bomisParams.editBomisForm.id_begindate\" type=\"date\" placeholder=\"开始日期\"\n                  style=\"flex:1;\" format=\"yyyy-MM-dd\" clearable>\n                </el-date-picker>\n              </el-form-item>\n              <div>~</div>\n              <el-form-item prop=\"id_enddate\">\n                <el-date-picker v-model=\"bomisParams.editBomisForm.id_enddate\" type=\"date\" placeholder=\"结束日期\"\n                  style=\"flex:1;\" format=\"yyyy-MM-dd\" align=\"right\" :picker-options=\"bomisParams.pickerOptions\"\n                  clearable>\n                </el-date-picker>\n              </el-form-item>\n            </div>\n            <!-- <div style=\"color:#F56C6C;font-size:12px;margin-top: -16px;\">如需手动填写，请按照“1990-01-01”的格式填写</div> -->\n          </el-col>\n          <el-col :span=\"8\">\n            <el-form-item prop=\"gender\" label=\"性别\" class=\"always-show-required\">\n              <el-select v-model=\"bomisParams.editBomisForm.gender\" placeholder=\"请选择\"\n                class=\"formitem-full-width formitem-max-width\">\n                <el-option label=\"男\" value=\"1\" />\n                <el-option label=\"女\" value=\"2\" />\n                <el-option label=\"未知\" value=\"3\" />\n              </el-select>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <el-form-item prop=\"nationality\" label=\"国籍\">\n              <el-select v-model=\"bomisParams.editBomisForm.nationality\" filterable placeholder=\"请选择\" clearable\n                class=\"formitem-full-width formitem-max-width\">\n                <el-option v-for=\"item in selectList.nationality_list\" :key=\"item.k\" :label=\"item.v\" :value=\"item.k\">\n                </el-option>\n              </el-select>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <div style=\"height:28px;line-height:28px;font-size:14px;color:#606266;\">\n              出生年月\n            </div>\n            <el-form-item prop=\"birthday\">\n              <el-date-picker v-model=\"bomisParams.editBomisForm.birthday\" type=\"date\" placeholder=\"选择日期\"\n                format=\"yyyy-MM-dd\" clearable editable class=\"formitem-full-width formitem-max-width\" />\n            </el-form-item>\n            <!-- <div style=\"color:#F56C6C;font-size:12px;margin-top: -16px;\">如需手动填写，请按照“1990-01-01”的格式填写</div> -->\n          </el-col>\n          <el-col :span=\"8\">\n            <el-form-item prop=\"mobno1\" label=\"联系方式（手机）\" class=\"always-show-required\">\n              <el-input v-model=\"bomisParams.editBomisForm.mobno1\" placeholder=\"请输入\" clearable\n                style=\"max-width: 325px;\"></el-input>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <el-form-item prop=\"mobno2\" label=\"联系方式（固话）\" class=\"always-show-required\">\n              <el-input v-model=\"bomisParams.editBomisForm.mobno2\" placeholder=\"请输入\" clearable\n                style=\"max-width: 325px;\"></el-input>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <div style=\"height:28px;line-height:28px;font-size:14px;color:#606266;\">\n              形成时间\n            </div>\n            <el-form-item prop=\"birthday\">\n              <el-date-picker v-model=\"bomisParams.editBomisForm.birthday\" type=\"date\" placeholder=\"选择日期\"\n                format=\"yyyy-MM-dd\" clearable editable class=\"formitem-full-width formitem-max-width\" />\n            </el-form-item>\n            <!-- <div style=\"color:#F56C6C;font-size:12px;margin-top: -16px;\">如需手动填写，请按照“1990-01-01”的格式填写</div> -->\n          </el-col>\n          <el-col :span=\"8\">\n            <div style=\"height:28px;line-height:28px;font-size:14px;color:#606266;\">\n              终止时间\n            </div>\n            <el-form-item prop=\"birthday\">\n              <el-date-picker v-model=\"bomisParams.editBomisForm.birthday\" type=\"date\" placeholder=\"选择日期\"\n                format=\"yyyy-MM-dd\" clearable editable class=\"formitem-full-width formitem-max-width\" />\n            </el-form-item>\n            <!-- <div style=\"color:#F56C6C;font-size:12px;margin-top: -16px;\">如需手动填写，请按照“1990-01-01”的格式填写</div> -->\n          </el-col>\n          <el-col :span=\"16\">\n            <el-form-item label=\"联系地址\" prop=\"address\">\n              <template slot=\"label\">\n                <div style=\"display: flex; align-items: center;\">\n                  <div style=\"height:28px;line-height:28px;font-size:14px;color:#606266;\">\n                    <span style=\"color:#F56C6C;height:28px;line-height:40px;margin-right: 4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>联系地址\n                  </div>\n                </div>\n              </template>\n              <div style=\"display:flex;width:100%;gap:8px;\">\n                <div style=\"flex:3;display:flex;gap:8px;\">\n                  <el-select v-model=\"bomisParams.editBomisForm.province2\" placeholder=\"省\" style=\"flex:1;\"\n                    @change=\"handleProvinceChg('2')\" clearable>\n                    <el-option v-for=\"item in proOptions\" :key=\"item.value\" :label=\"item.label\" :value=\"item.value\">\n                    </el-option>\n                  </el-select>\n                  <el-select v-model=\"bomisParams.editBomisForm.city2\" placeholder=\"市\" style=\"flex:1;\"\n                    @change=\"handleCityChg('2')\" clearable>\n                    <el-option v-for=\"item in cityOptions2\" :key=\"item.value\" :label=\"item.label\" :value=\"item.value\">\n                    </el-option>\n                  </el-select>\n                  <el-select v-model=\"bomisParams.editBomisForm.district2\" placeholder=\"区\" style=\"flex:1;\" clearable>\n                    <el-option v-for=\"item in districtOptions2\" :key=\"item.value\" :label=\"item.label\"\n                      :value=\"item.value\">\n                    </el-option>\n                  </el-select>\n                </div>\n                <el-input v-model=\"bomisParams.editBomisForm.address\" placeholder=\"详细地址\" style=\"flex:2;\"></el-input>\n              </div>\n            </el-form-item>\n          </el-col>\n        </el-row>\n      </el-form>\n    </div>\n    <div slot=\"footer\" class=\"dialog-footer\">\n      <el-button @click=\"closeDialog('bomisBenefitDialog')\">取消</el-button>\n      <!-- <el-button type=\"primary\" @click=\"saveEditForm('1','2')\"\n        v-if=\"editForm1.related_type!=='1'&&editForm1.related_type!=='4'\">提交并录入下一条</el-button>\n      <el-button type=\"primary\" @click=\"saveEditForm('2','2')\">提交</el-button> -->\n    </div>\n  </el-dialog>\n</div>"
                  },
                  "events": {
                    "ready": "/**\n * app.components.NewBnfDialog - 受益所有人核验组件\n *\n * 功能： todo\n *\n * @props\n *   client_id  {String}  当前客户号\n *\n * @events\n *   size-change     - 切换每页条数时触发，参数：新条数\n *   current-change  - 切换页码时触发，参数：新页码\n *   detail          - 点击详情按钮时触发，参数：当前行数据\n *   edit            - 点击编辑按钮时触发，参数：当前行数据\n *   delete          - 点击删除按钮时触发，参数：当前行数据\n *\n * @refs\n *   table          - el-table 实例，可调用 doLayout() 强制刷新布局\n *   paginationWrap - 分页栏容器 DOM，用于计算表格高度\n */\nif (!app.components) { app.components = {}; }\napp.components.NewBnfDialog = {\n  template: this.app.NewBnfDialogPanel.bodyEl.query('#new-bnf-dialog'),\n  props: {\n    // 表格数据\n    client_id: {\n      type: String,\n      default: ''\n    }\n  },\n  data: function () {\n    return {\n      bomisParams: {\n        dialogBomisVisible: false, // bomis受益人核验窗口\n        benefitEditDialogVisible: false,\n        benefit_company_no_list: [], // 需要对this.selectList.benefit_company_no_list结合受益人类型进行过滤\n        bnf_type_new_list: [], // 需要对this.selectList.bnf_type_new_list结合企业性质进行过滤\n        editBomisForm: {\n          bo_type: '', // 受益人类型\n          company_type: '', // 企业性质\n          bnf_type: [],\n          common_rate: '',\n          full_info_flag: '',\n\n          related_name: '',\n          organ_flag: '0',\n          nationality: '',\n          id_type: '',\n          id_no: '',\n          id_begindate: '',\n          id_enddate: '',\n          birthday: '',\n          is_government_dept: '',\n          related_type: '',\n          title: '',\n          beneficiary: '',\n          shareholding_ratio: '',\n          address: '',\n          mobno1: '',\n          new_flag: null,\n        },\n        editBomisFormRules: {},\n        pickerOptions: {\n          shortcuts: [{\n            text: '长期',\n            onClick(picker) {\n              picker.$emit('pick', '9999-12-31')\n            }\n          }]\n        },\n        bomisSourceTableData: [\n          { related_name: '11' }, { related_name: '22' }\n        ],\n        bomisLastCheckResult: { \"RETURN_CODE\": \"inco\", \"RETURN_MSG\": \"综合比对不一致（bomis核验不一致，系统比对不一致）\", \"NoDiffList\": [{ \"LACK_COUNT\": 9, \"LackList\": [{ \"DIFFCODE\": \"lack\", \"NAME\": \"张三\", \"NTLTY\": \"156\", \"IDTP\": null, \"IDNB\": null, \"GENDER\": \"MALE\", \"BIRTHDT\": \"1983-01-17\", \"ADDR\": null, \"IDDATE\": null, \"MOBNO1\": null, \"MOBNO2\": null, \"SEQNO\": 1, \"ACTCTRL\": \"Y\", \"ACTHDRAT\": 34, \"SHARERATIOSTARTDATE\": \"2026-05-31\", \"SHARERATIOENDDATE\": null, \"ACTCTRLCPNY\": null, \"ACTCTRLTYPE\": null, \"OBTAINACTDATE\": null, \"TERMINATIONACTDATE\": null, \"ACTOTHERFORMS\": null, \"ACTCONUPPERMARKET\": null, \"ACTCONUPPERENTNAME\": null, \"ACTCONUNISCID\": null, \"PRIBENFIT\": \"N\", \"ACTOWNERPROFITRATIO\": null, \"PROFITRATIOSTARTDATE\": null, \"PROFITRATIOENDDATE\": null, \"ACTOWNERPROFITRATIOVOTE\": null, \"PROFITRATIOVOTESTARTDATE\": null, \"PROFITRATIOVOTEENDDATE\": null, \"SENIORMGR\": \"N\", \"SENIORMGRPOS\": null, \"ACTDAILYMGMTPOSTOTHER\": null, \"SENIORMGRCN\": \"N\", \"SENIORMGRPOSCN\": null, \"OWNERRIGHTMGMTPOSTOTHER\": null }, { \"DIFFCODE\": \"lack\", \"NAME\": \"张三\", \"NTLTY\": \"156\", \"IDTP\": null, \"IDNB\": null, \"GENDER\": \"MALE\", \"BIRTHDT\": \"1983-01-17\", \"ADDR\": null, \"IDDATE\": null, \"MOBNO1\": null, \"MOBNO2\": null, \"SEQNO\": 2, \"ACTCTRL\": \"Y\", \"ACTHDRAT\": 33, \"SHARERATIOSTARTDATE\": \"2026-05-28\", \"SHARERATIOENDDATE\": null, \"ACTCTRLCPNY\": null, \"ACTCTRLTYPE\": null, \"OBTAINACTDATE\": null, \"TERMINATIONACTDATE\": null, \"ACTOTHERFORMS\": null, \"ACTCONUPPERMARKET\": null, \"ACTCONUPPERENTNAME\": null, \"ACTCONUNISCID\": null, \"PRIBENFIT\": \"N\", \"ACTOWNERPROFITRATIO\": null, \"PROFITRATIOSTARTDATE\": null, \"PROFITRATIOENDDATE\": null, \"ACTOWNERPROFITRATIOVOTE\": null, \"PROFITRATIOVOTESTARTDATE\": null, \"PROFITRATIOVOTEENDDATE\": null, \"SENIORMGR\": \"N\", \"SENIORMGRPOS\": null, \"ACTDAILYMGMTPOSTOTHER\": null, \"SENIORMGRCN\": \"N\", \"S