": \"孙钊\", \"NTLTY\": \"156\", \"IDTP\": null, \"IDNB\": null, \"GENDER\": \"MALE\", \"BIRTHDT\": \"1991-11-05\", \"ADDR\": null, \"IDDATE\": null, \"MOBNO1\": null, \"MOBNO2\": null, \"SEQNO\": 5, \"ACTCTRL\": \"Y\", \"ACTHDRAT\": 36, \"SHARERATIOSTARTDATE\": \"2026-07-06\", \"SHARERATIOENDDATE\": \"2026-07-31\", \"ACTCTRLCPNY\": null, \"ACTCTRLTYPE\": null, \"OBTAINACTDATE\": null, \"TERMINATIONACTDATE\": null, \"ACTOTHERFORMS\": null, \"ACTCONUPPERMARKET\": null, \"ACTCONUPPERENTNAME\": null, \"ACTCONUNISCID\": null, \"PRIBENFIT\": \"N\", \"ACTOWNERPROFITRATIO\": null, \"PROFITRATIOSTARTDATE\": null, \"PROFITRATIOENDDATE\": null, \"ACTOWNERPROFITRATIOVOTE\": null, \"PROFITRATIOVOTESTARTDATE\": null, \"PROFITRATIOVOTEENDDATE\": null, \"SENIORMGR\": \"N\", \"SENIORMGRPOS\": null, \"ACTDAILYMGMTPOSTOTHER\": null, \"SENIORMGRCN\": \"Y\", \"SENIORMGRPOSCN\": \"0\", \"OWNERRIGHTMGMTPOSTOTHER\": null }, { \"DIFFCODE\": \"lack\", \"NAME\": \"国七出\", \"NTLTY\": \"012\", \"IDTP\": null, \"IDNB\": null, \"GENDER\": \"FMLE\", \"BIRTHDT\": \"1996-05-24\", \"ADDR\": null, \"IDDATE\": null, \"MOBNO1\": null, \"MOBNO2\": null, \"SEQNO\": 6, \"ACTCTRL\": \"Y\", \"ACTHDRAT\": 67, \"SHARERATIOSTARTDATE\": \"2026-07-24\", \"SHARERATIOENDDATE\": \"9999-12-31\", \"ACTCTRLCPNY\": null, \"ACTCTRLTYPE\": null, \"OBTAINACTDATE\": null, \"TERMINATIONACTDATE\": null, \"ACTOTHERFORMS\": null, \"ACTCONUPPERMARKET\": null, \"ACTCONUPPERENTNAME\": null, \"ACTCONUNISCID\": null, \"PRIBENFIT\": \"N\", \"ACTOWNERPROFITRATIO\": null, \"PROFITRATIOSTARTDATE\": null, \"PROFITRATIOENDDATE\": null, \"ACTOWNERPROFITRATIOVOTE\": null, \"PROFITRATIOVOTESTARTDATE\": null, \"PROFITRATIOVOTEENDDATE\": null, \"SENIORMGR\": \"N\", \"SENIORMGRPOS\": null, \"ACTDAILYMGMTPOSTOTHER\": null, \"SENIORMGRCN\": \"Y\", \"SENIORMGRPOSCN\": \"0\", \"OWNERRIGHTMGMTPOSTOTHER\": null }, { \"DIFFCODE\": \"lack\", \"NAME\": \"吴昊天\", \"NTLTY\": \"156\", \"IDTP\": null, \"IDNB\": null, \"GENDER\": \"MALE\", \"BIRTHDT\": \"1988-05-21\", \"ADDR\": null, \"IDDATE\": null, \"MOBNO1\": null, \"MOBNO2\": null, \"SEQNO\": 7, \"ACTCTRL\": \"Y\", \"ACTHDRAT\": 25, \"SHARERATIOSTARTDATE\": \"2026-08-10\", \"SHARERATIOENDDATE\": null, \"ACTCTRLCPNY\": null, \"ACTCTRLTYPE\": null, \"OBTAINACTDATE\": null, \"TERMINATIONACTDATE\": null, \"ACTOTHERFORMS\": null, \"ACTCONUPPERMARKET\": null, \"ACTCONUPPERENTNAME\": null, \"ACTCONUNISCID\": null, \"PRIBENFIT\": \"N\", \"ACTOWNERPROFITRATIO\": null, \"PROFITRATIOSTARTDATE\": null, \"PROFITRATIOENDDATE\": null, \"ACTOWNERPROFITRATIOVOTE\": null, \"PROFITRATIOVOTESTARTDATE\": null, \"PROFITRATIOVOTEENDDATE\": null, \"SENIORMGR\": \"N\", \"SENIORMGRPOS\": null, \"ACTDAILYMGMTPOSTOTHER\": null, \"SENIORMGRCN\": \"N\", \"SENIORMGRPOSCN\": null, \"OWNERRIGHTMGMTPOSTOTHER\": null }, { \"DIFFCODE\": \"lack\", \"NAME\": \"暗搓搓\", \"NTLTY\": \"156\", \"IDTP\": null, \"IDNB\": null, \"GENDER\": \"FMLE\", \"BIRTHDT\": \"1964-09-19\", \"ADDR\": null, \"IDDATE\": null, \"MOBNO1\": null, \"MOBNO2\": null, \"SEQNO\": 8, \"ACTCTRL\": \"N\", \"ACTHDRAT\": null, \"SHARERATIOSTARTDATE\": null, \"SHARERATIOENDDATE\": null, \"ACTCTRLCPNY\": \"2\", \"ACTCTRLTYPE\": \"1\", \"OBTAINACTDATE\": \"2020-01-01\", \"TERMINATIONACTDATE\": null, \"ACTOTHERFORMS\": null, \"ACTCONUPPERMARKET\": \"N\", \"ACTCONUPPERENTNAME\": null, \"ACTCONUNISCID\": null, \"PRIBENFIT\": \"Y\", \"ACTOWNERPROFITRATIO\": 30, \"PROFITRATIOSTARTDATE\": \"2020-01-01\", \"PROFITRATIOENDDATE\": null, \"ACTOWNERPROFITRATIOVOTE\": 30, \"PROFITRATIOVOTESTARTDATE\": \"2020-01-01\", \"PROFITRATIOVOTEENDDATE\": null, \"SENIORMGR\": \"N\", \"SENIORMGRPOS\": null, \"ACTDAILYMGMTPOSTOTHER\": null, \"SENIORMGRCN\": \"N\", \"SENIORMGRPOSCN\": null, \"OWNERRIGHTMGMTPOSTOTHER\": null }, { \"DIFFCODE\": \"lack\", \"NAME\": \"吴昊\", \"NTLTY\": \"156\", \"IDTP\": null, \"IDNB\": null, \"GENDER\": \"MALE\", \"BIRTHDT\": \"1988-05-21\", \"ADDR\": null, \"IDDATE\": null, \"MOBNO1\": null, \"MOBNO2\": null, \"SEQNO\": 9, \"ACTCTRL\": \"N\", \"ACTHDRAT\": null, \"SHARERATIOSTARTDATE\": null, \"SHARERATIOENDDATE\": null, \"ACTCTRLCPNY\": null, \"ACTCTRLTYPE\": null, \"OBTAINACTDATE\": null, \"TERMINATIONACTDATE\": null, \"ACTOTHERFORMS\": null, \"ACTCONUPPERMARKET\": null, \"ACTCONUPPERENTNAME\": null, \"ACTCONUNISCID\": null, \"PRIBENFIT\": \"N\", \"ACTOWNERPROFITRATIO\": null, \"PROFITRATIOSTARTDATE\": null, \"PROFITRATIOENDDATE\": null, \"ACTOWNERPROFITRATIOVOTE\": null, \"PROFITRATIOVOTESTARTDATE\": null, \"PROFITRATIOVOTEENDDATE\": null, \"SENIORMGR\": \"N\", \"SENIORMGRPOS\": null, \"ACTDAILYMGMTPOSTOTHER\": null, \"SENIORMGRCN\": \"Y\", \"SENIORMGRPOSCN\": \"0\", \"OWNERRIGHTMGMTPOSTOTHER\": null }], \"MORE_COUNT\": 1, \"MoreList\": [{ \"DIFFCODE\": \"more\", \"NAME\": \"柏一辰\", \"NTLTY\": \"156\", \"IDTP\": \"10\", \"IDNB\": \"310116195108141211\", \"GENDER\": \"MALE\", \"BIRTHDT\": \"1951-08-14\", \"ADDR\": null, \"IDDATE\": null, \"MOBNO1\": null, \"MOBNO2\": null, \"SEQNO\": 1, \"ACTCTRL\": null, \"ACTHDRAT\": null, \"SHARERATIOSTARTDATE\": null, \"SHARERATIOENDDATE\": null, \"ACTCTRLCPNY\": null, \"ACTCTRLTYPE\": null, \"OBTAINACTDATE\": null, \"TERMINATIONACTDATE\": null, \"ACTOTHERFORMS\": null, \"ACTCONUPPERMARKET\": null, \"ACTCONUPPERENTNAME\": null, \"ACTCONUNISCID\": null, \"PRIBENFIT\": null, \"ACTOWNERPROFITRATIO\": null, \"PROFITRATIOSTARTDATE\": null, \"PROFITRATIOENDDATE\": null, \"ACTOWNERPROFITRATIOVOTE\": null, \"PROFITRATIOVOTESTARTDATE\": null, \"PROFITRATIOVOTEENDDATE\": null, \"SENIORMGR\": \"Y\", \"SENIORMGRPOS\": null, \"ACTDAILYMGMTPOSTOTHER\": \"人员\", \"SENIORMGRCN\": \"Y\", \"SENIORMGRPOSCN\": null, \"OWNERRIGHTMGMTPOSTOTHER\": \"高层级高层级\" }], \"ELMT_COUNT\": 0, \"ElmtList\": [], \"PERP_COUNT\": 0, \"PerpList\": [], \"SCEC_COUNT\": 0, \"ScecList\": [], \"CONS_COUNT\": 0, \"ConsList\": [] }], \"RETURN_MSG_ID\": \"202609150000001381111000000\", \"COMPARE_CODE\": \"1\", \"COMPARE_REMARK\": \"缺失9人：张三、张三、张三、天天、孙钊、国七出、吴昊天、暗搓搓、吴昊，多出1人：柏一辰\", \"OUT_ID\": \"FXQ20260915\", \"BRANCH_NO\": \"E1005431000011\", \"BRANCH_NAME\": \"国泰海通证券股份有限公司\", \"USCC\": \"91310113MACME32P0L\", \"ORG_NAME\": \"上海星海骑兵科技有限公司\", \"CLIENT_ID\": \"\", \"CLIENT_NAME\": \"上海测试科技有限公司\" },\n        bomisCheckResultTableData: [\n          { related_name: '11' }, { related_name: '22' }\n        ],\n        editOneBenefitForm: {\n          bo_type: '', // 受益人类型\n          company_type: '', // 企业性质\n          bnf_type: '', // 受益权类型\n          full_info_flag: '',\n\n          acthdrat: '',\n\n          related_name: '',\n          organ_flag: '0',\n          nationality: '',\n          id_type: '',\n          id_no: '',\n          id_begindate: '',\n          id_enddate: '',\n          birthday: '',\n          is_government_dept: '',\n          related_type: '',\n          title: '',\n          beneficiary: '',\n          shareholding_ratio: '',\n          address: '',\n          mobno1: '',\n          new_flag: null,\n        }\n      }\n    };\n  },\n  mounted() {\n    var that = this;\n    \n  },\n  methods: {\n    showBenefitEditDialog: function () {\n      this.bomisParams.benefitEditDialogVisible = true;\n    },\n    nativeRadioClick: function (val, obj, key) {\n      if (obj[key] === val) {\n        setTimeout(() => {\n          this.$set(obj, key, '')\n        }, 200)\n      }\n    },\n    bomisBoTypeChange: function (newValue) {\n      // bomisParams.editBomisForm.bo_type 的改变 需要影响 bomisParams.editBomisForm.company_type的取值范围\n      if (newValue === '1') {\n        this.bomisParams.benefit_company_no_list = this.selectList.benefit_company_no_list.filter(i => {\n          return i.k.startsWith('1') || i.k.startsWith('2') || i.k.startsWith('3') || i.k.startsWith('4') || i.k.startsWith('5') || i.k.startsWith('6')\n        });\n        this.bomisParams.editBomisForm.company_type = '';\n        this.bomisParams.editBomisForm.bnf_type = ''; // 1 是无需识别受益所有人\n      } else if (newValue === '2') {\n        this.bomisParams.benefit_company_no_list = this.selectList.benefit_company_no_list.filter(i => {\n          return !(i.k.startsWith('1') || i.k.startsWith('2') || i.k.startsWith('3') || i.k.startsWith('4') || i.k.startsWith('5') || i.k.startsWith('6'))\n        });\n        this.bomisParams.editBomisForm.company_type = '';\n        this.bomisParams.editBomisForm.bnf_type = '';\n      } else if (newValue === '') {\n        this.bomisParams.benefit_company_no_list = [];\n        this.bomisParams.editBomisForm.company_type = '';\n        this.bomisParams.editBomisForm.bnf_type = '';\n      }\n    },\n    bomisCompanyTypeChange: function (newValue) {\n      // bomisParams.editBomisForm.company_type 的改变 需要影响 bomisParams.editBomisForm.bnf_type的取值范围\n      var firstChar = newValue[0] || '';\n      if (newValue !== '') {\n        this.bomisParams.bnf_type_new_list = this.selectList.bnf_type_new_list.filter(i => i.k.startsWith('N' + firstChar));\n        this.bomisParams.editBomisForm.bnf_type = '';\n      } else if (newValue === '') {\n        this.bomisParams.bnf_type_new_list = [];\n        this.bomisParams.editBomisForm.bnf_type = '';\n      }\n    },\n    bomisBnfTypeChange: function (newVal) {\n      var result = newVal;\n      if(newVal.length > 1) {\n        if(newVal.includes('NA1') && ['NA2-1', 'NA2-2', 'NA3-1', 'NA3-2', 'NA4'].includes(newVal.lastItem)) {\n          result.pop();\n        } \n        if(newVal.includes('NA4') && ['NA2-1', 'NA2-2', 'NA3-1', 'NA3-2', 'NA1'].includes(newVal.lastItem)) {\n          result.pop();\n        }\n        if((newVal.includes('NA2-1') || newVal.includes('NA2-2'))) {\n          if(newVal.includes('NA3-1') && ['NA4', 'NA3-2', 'NA1'].includes(newVal.lastItem)) { result.pop(); }\n          if(newVal.includes('NA3-2') && ['NA4', 'NA3-1', 'NA1'].includes(newVal.lastItem)) { result.pop(); }\n          if(['NA4', 'NA1'].includes(newVal.lastItem)) { result.pop(); }\n        }\n        if(newVal.includes('NA3-1') && ['NA4', 'NA3-2', 'NA1'].includes(newVal.lastItem)) { result.pop(); }\n        if(newVal.includes('NA3-2') && ['NA4', 'NA3-1', 'NA1'].includes(newVal.lastItem)) { result.pop(); }\n\n        if(newVal.includes('NB1') && ['NB2-1', 'NB2-2', 'NB3-1', 'NB3-2', 'NB4'].includes(newVal.lastItem)) {\n          result.pop();\n        } \n        if(newVal.includes('NB4') && ['NB2-1', 'NB2-2', 'NB3-1', 'NB3-2', 'NB1'].includes(newVal.lastItem)) {\n          result.pop();\n        }\n        if((newVal.includes('NB2-1') || newVal.includes('NB2-2'))) {\n          if(newVal.includes('NB3-1') && ['NB4', 'NB3-2', 'NB1'].includes(newVal.lastItem)) { result.pop(); }\n          if(newVal.includes('NB3-2') && ['NB4', 'NB3-1', 'NB1'].includes(newVal.lastItem)) { result.pop(); }\n          if(['NB4', 'NB1'].includes(newVal.lastItem)) { result.pop(); }\n        }\n        if(newVal.includes('NB3-1') && ['NB4', 'NB3-2', 'NB1'].includes(newVal.lastItem)) { result.pop(); }\n        if(newVal.includes('NB3-2') && ['NB4', 'NB3-1', 'NB1'].includes(newVal.lastItem)) { result.pop(); }\n\n\n\n        if(newVal.includes('ND1') && ['ND2-1', 'ND2-2', 'ND3', 'ND4'].includes(newVal.lastItem)) {\n          result.pop();\n        } \n        if((newVal.includes('ND2-1') || newVal.includes('ND2-2'))) {\n          if(newVal.includes('ND3') && ['ND4', 'ND1'].includes(newVal.lastItem)) { result.pop(); }\n          if(['ND4', 'ND1'].includes(newVal.lastItem)) { result.pop(); }\n        }\n        if(newVal.includes('ND3') && ['ND4', 'ND1'].includes(newVal.lastItem)) { result.pop(); }\n\n        if(newVal.includes('NE1') && ['NE2'].includes(newVal.lastItem)) {\n          result.pop();\n        }\n        if(newVal.includes('NE2') && ['NE1'].includes(newVal.lastItem)) {\n          result.pop();\n        }\n\n        this.bomisParams.editBomisForm.bnf_type = result;\n      }\n      \n      // this.bomisParams.editBomisForm.bnf_type = result;\n\n      // this.bomisParams.editBomisForm.bnf_type = result;\n    },\n    setRelaValue: function(related_name, form) {\n\n    },\n    clearIdNoValidate(formType) {\n      // 根据表单类型获取对应的表单引用\n      var formRef;\n      if (formType === 'editBomisForm') {\n        formRef = this.$refs.editBomisForm;\n      }\n      // 清空证件号码字段的校验提示\n      if (formRef) {\n        formRef.clearValidate('id_no');\n      }\n    },\n    addBomisBnfInfo: function () {\n\n    }\n  }\n};\n"
                  }
                },
                {
                  "_icon": "container",
                  "text": "mainContainer",
                  "cls": "Wb.Container",
                  "properties": {
                    "cid": "mainContainer",
                    "autoScroll": "true",
                    "layout": "fit",
                    "html": "<div id=\"app\" style=\"height:100%;max-width:1920px;margin:0 auto;\">\n  <div class=\"main-container\" style=\"display:flex\">\n    <div class=\"left-panel\">\n      <el-tabs v-model=\"activeNav\" @tab-click=\"handleClick\" tab-position=\"left\">\n        <el-tab-pane v-for=\"(item, index) in navList\" :label=\"item.label\" :name=\"item.value\"></el-tab-pane>\n      </el-tabs>\n    </div>\n    <div v-if=\"loading\" class=\"right-panel\">\n      <el-loading v-loading=\"loading\" element-loading-text=\"页面加载中，若长时间无响应，请关闭后重试\"\n        element-loading-spinner=\"el-icon-loading\" style=\"display:inline-block;height:100%;width:100%\"></el-loading>\n    </div>\n    <div v-else class=\"right-panel\" @scroll=\"onScroll\" style=\"overflow-y:scroll;\">\n      <p style=\"color:#F56C6C;padding-left:20px;\">\n        注1：证照、身份证等有效期如果为“长期”、“永久”等，请在证照/身份证有效期截止选择“2100-12-31”。<br/> 注2：如果没有相关信息需要填写，请留白，不需要填写“不适用”、“无”等字段。\n        <br/> 注3：附件上传后即为保存，将不允许修改和删除，如有错误可用新的同名文件更新替换。\n      </p>\n      <!--客户基本信息-->\n      <el-card class=\"box-card\" :name=\"'basicInfo'+this._uid\">\n        <div slot=\"header\" class=\"clearfix\">\n          <span>客户基本信息</span>\n        </div>\n        <div>\n          <!--个人-->\n          <el-form v-if=\"organ_flag==='0'\" :model=\"ruleForm2\" :rules=\"rules\" ref=\"ruleForm2\" label-position=\"top\"\n            style=\"padding:20px;\" :class=\"{'hide-required-mark': shouldHideRequiredMark}\"\n            :hide-required-asterisk=\"true\">\n            <el-row :gutter=\"20\">\n              <el-col :span=\"8\">\n                <el-form-item prop=\"client_name\" label-position=\"top\">\n                  <template slot=\"label\">\n                    <div style=\"display: flex; align-items: center;\">\n                      <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                        <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>姓名\n                      </div>\n                    </div>\n                  </template>\n                  <el-input size=\"medium\" v-model=\"ruleForm2.client_name\" placeholder=\"请输入客户名称\" readonly />\n                </el-form-item>\n              </el-col>\n              <el-col :span=\"16\">\n                <el-form-item label=\"联系地址\" prop=\"address\">\n                  <template slot=\"label\">\n                    <div style=\"display: flex; align-items: center;\">\n                      <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                        <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>联系地址\n                      </div>\n                    </div>\n                  </template>\n                  <div style=\"display:flex;width:100%;gap:8px;\">\n                    <div style=\"flex:3;display:flex;gap:8px;\">\n                      <el-select size=\"medium\" v-model=\"ruleForm2.province2\" placeholder=\"省\" style=\"flex:1;\"\n                        @change=\"handleProvinceChg('2')\" clearable>\n                        <el-option v-for=\"item in proOptions\" :key=\"item.value\" :label=\"item.label\" :value=\"item.value\">\n                        </el-option>\n                      </el-select>\n                      <el-select size=\"medium\" v-model=\"ruleForm2.city2\" placeholder=\"市\" style=\"flex:1;\"\n                        @change=\"handleCityChg('2')\" clearable>\n                        <el-option v-for=\"item in cityOptions2\" :key=\"item.value\" :label=\"item.label\"\n                          :value=\"item.value\">\n                        </el-option>\n                      </el-select>\n                      <el-select size=\"medium\" v-model=\"ruleForm2.district2\" placeholder=\"区\" style=\"flex:1;\" clearable>\n                        <el-option v-for=\"item in districtOptions2\" :key=\"item.value\" :label=\"item.label\"\n                          :value=\"item.value\">\n                        </el-option>\n                      </el-select>\n                    </div>\n                    <el-input size=\"medium\" v-model=\"ruleForm2.address\" placeholder=\"详细地址\" style=\"flex:2;\"></el-input>\n                  </div>\n                </el-form-item>\n              </el-col>\n            </el-row>\n            <el-row :gutter=\"20\">\n              <el-col :span=\"8\">\n                <el-form-item prop=\"nationality\">\n                  <template slot=\"label\">\n                    <div style=\"display: flex; align-items: center;\">\n                      <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                        <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>国籍\n                      </div>\n                    </div>\n                  </template>\n                  <el-select size=\"medium\" v-model=\"ruleForm2.nationality\" placeholder=\"请选择\">\n                    <el-option v-for=\"item in selectList.nationality_list\" :key=\"item.k\" :label=\"item.v\"\n                      :value=\"item.k\">\n                    </el-option>\n                  </el-select>\n                </el-form-item>\n              </el-col>\n              <el-col :span=\"8\">\n                <el-form-item prop=\"gender\">\n                  <template slot=\"label\">\n                    <div style=\"display: flex; align-items: center;\">\n                      <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                        <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>性别\n                      </div>\n                    </div>\n                  </template>\n                  <el-select size=\"medium\" v-model=\"ruleForm2.gender\" placeholder=\"请选择\">\n                    <el-option label=\"男\" value=\"1\" />\n                    <el-option label=\"女\" value=\"2\" />\n                    <el-option label=\"未知\" value=\"3\" />\n                  </el-select>\n                </el-form-item>\n              </el-col>\n              <el-col :span=\"8\">\n                <el-form-item prop=\"birthday\">\n                  <template slot=\"label\">\n                    <div style=\"display: flex; align-items: center;\">\n                      <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                        <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>出生年月\n                      </div>\n                      <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n                      <span style=\"color:#F56C6C;font-size:14px;\">如需手动填写，请按照“1990-01-01”的格式填写</span>\n                    </div>\n                  </template>\n                  <el-date-picker v-model=\"ruleForm2.birthday\" type=\"date\" placeholder=\"选择日期\" style=\"width: 100%;\"\n                    format=\"yyyy-MM-dd\" clearable editable />\n                </el-form-item>\n              </el-col>\n            </el-row>\n            <el-row :gutter=\"20\">\n              <el-col :span=\"8\">\n                <el-form-item prop=\"tel\">\n                  <template slot=\"label\">\n                    <div style=\"display: flex; align-items: center;\">\n                      <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                        <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>联系电话\n                      </div>\n                    </div>\n                  </template>\n                  <el-input size=\"medium\" v-model=\"ruleForm2.tel\" placeholder=\"请输入联系电话\" />\n                </el-form-item>\n              </el-col>\n              <el-col :span=\"8\">\n                <el-form-item prop=\"income\" label-width=\"auto\">\n                  <template slot=\"label\">\n                    <div style=\"display: flex; align-items: center;\">\n                      <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                        <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>年收入（单位：人民币）\n                      </div>\n                    </div>\n                  </template>\n                  <el-select size=\"medium\" v-model=\"ruleForm2.income\" placeholder=\"请选择\">\n                    <el-option v-for=\"item in selectList.year_income_list\" :key=\"item.k\" :label=\"item.v\"\n                      :value=\"item.k\">\n                    </el-option>\n                  </el-select>\n                </el-form-item>\n              </el-col>\n              <el-col :span=\"8\">\n                <el-form-item prop=\"profession_code\">\n                  <template slot=\"label\">\n                    <div style=\"display: flex; align-items: center;\">\n                      <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                        <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>职业分类\n                      </div>\n                    </div>\n                  </template>\n                  <el-select size=\"medium\" v-model=\"ruleForm2.profession_code\" placeholder=\"请选择\">\n                    <el-option v-for=\"item in selectList.profession_code_list\" :key=\"item.k\" :label=\"item.v\"\n                      :value=\"item.k\">\n                    </el-option>\n                  </el-select>\n                </el-form-item>\n              </el-col>\n            </el-row>\n            <el-row :gutter=\"20\">\n              <el-col :span=\"8\">\n                <el-form-item prop=\"id_type\">\n                  <template slot=\"label\">\n                    <div style=\"display: flex; align-items: center;\">\n                      <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                        <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>身份证件类型\n                      </div>\n                    </div>\n                  </template>\n                  <el-select size=\"medium\" v-model=\"ruleForm2.id_type\" placeholder=\"请选择\"\n                    @change=\"clearIdNoValidate('ruleForm2')\">\n                    <el-option v-for=\"item in selectList.id_type_gr_list\" :key=\"item.k\" :label=\"item.v\" :value=\"item.k\">\n                    </el-option>\n                  </el-select>\n                </el-form-item>\n              </el-col>\n              <el-col :span=\"8\">\n                <el-form-item prop=\"id_no\">\n                  <template slot=\"label\">\n                    <div style=\"display: flex; align-items: center;\">\n                      <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                        <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>证件号码\n                      </div>\n                    </div>\n                  </template>\n                  <el-input size=\"medium\" v-model=\"ruleForm2.id_no\" placeholder=\"请输入证件号码\" />\n                </el-form-item>\n              </el-col>\n            </el-row>\n            <el-row :gutter=\"20\">\n              <el-col :span=\"16\">\n                <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                  <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right:4px\" v-if=\"ruleForm3.is_special==='0'\">*</span>证件有效期\n                  <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n                  <span style=\"color:#F56C6C;font-size:14px;\">如需手动填写，请按照“1990-01-01”的格式填写</span>\n                </div>\n                <div style=\"display:flex;width:100%;gap:8px;\">\n                  <el-form-item prop=\"id_begindate\">\n                    <el-date-picker v-model=\"ruleForm2.id_begindate\" type=\"date\" placeholder=\"开始日期\" style=\"flex:1;\"\n                      format=\"yyyy-MM-dd\" clearable>\n                    </el-date-picker>\n                  </el-form-item>\n                  <div style=\"height:40px;line-height:40px;\">至</div>\n                  <el-form-item prop=\"id_enddate\">\n                    <el-date-picker v-model=\"ruleForm2.id_enddate\" type=\"date\" placeholder=\"结束日期\" style=\"flex:1;\"\n                      format=\"yyyy-MM-dd\" align=\"right\" :picker-options=\"pickerOptions\" clearable>\n                    </el-date-picker>\n                  </el-form-item>\n                </div>\n              </el-col>\n            </el-row>\n            <el-row :gutter=\"20\">\n              <el-col :span=\"16\">\n                <el-form-item prop=\"id_address\">\n                  <template slot=\"label\">\n                    <div style=\"display: flex; align-items: center;\">\n                      <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                        <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>证件地址\n                      </div>\n                    </div>\n                  </template>\n                  <div style=\"display:flex;width:100%;gap:8px;\">\n                    <div style=\"flex:3;display:flex;gap:8px;\">\n                      <el-select size=\"medium\" v-model=\"ruleForm2.province1\" placeholder=\"省\" style=\"flex:1;\"\n                        @change=\"handleProvinceChg('1')\" clearable>\n                        <el-option v-for=\"item in proOptions\" :key=\"item.value\" :label=\"item.label\" :value=\"item.value\">\n                        </el-option>\n                      </el-select>\n                      <el-select size=\"medium\" v-model=\"ruleForm2.city1\" placeholder=\"市\" style=\"flex:1;\"\n                        @change=\"handleCityChg('1')\" clearable>\n                        <el-option v-for=\"item in cityOptions1\" :key=\"item.value\" :label=\"item.label\"\n                          :value=\"item.value\">\n                        </el-option>\n                      </el-select>\n                      <el-select size=\"medium\" v-model=\"ruleForm2.district1\" placeholder=\"区\" style=\"flex:1;\" clearable>\n                        <el-option v-for=\"item in districtOptions1\" :key=\"item.value\" :label=\"item.label\"\n                          :value=\"item.value\">\n                        </el-option>\n                      </el-select>\n                    </div>\n                    <el-input size=\"medium\" v-model=\"ruleForm2.id_address\" placeholder=\"详细地址\" style=\"flex:2;\">\n                    </el-input>\n                  </div>\n                </el-form-item>\n              </el-col>\n            </el-row>\n          </el-form>\n          <!--机构-->\n          <el-form v-else :model=\"ruleForm1\" :rules=\"rules\" ref=\"ruleForm1\" label-position=\"top\" style=\"padding:20px;\"\n            :class=\"{'hide-required-mark': shouldHideRequiredMark}\" :hide-required-asterisk=\"true\">\n            <el-row :gutter=\"20\">\n              <el-col :span=\"8\">\n                <el-form-item prop=\"client_name\">\n                  <template slot=\"label\">\n                    <div style=\"display: flex; align-items: center;\">\n                      <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                        <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>客户名称\n                      </div>\n                    </div>\n                  </template>\n                  <el-input size=\"medium\" v-model=\"ruleForm1.client_name\" placeholder=\"请输入客户名称\" />\n                </el-form-item>\n              </el-col>\n              <el-col :span=\"16\">\n                <el-form-item prop=\"office_address\">\n                  <template slot=\"label\">\n                    <div style=\"display: flex; align-items: center;\">\n                      <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                        <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>办公住所\n                      </div>\n                    </div>\n                  </template>\n                  <div style=\"display:flex;width:100%;gap:8px;\">\n                    <div style=\"flex:3;display:flex;gap:8px;\">\n                      <el-select size=\"medium\" v-model=\"ruleForm1.province\" placeholder=\"省\" style=\"flex:1;\"\n                        @change=\"handleProvinceChg('0')\" clearable>\n                        <el-option v-for=\"item in proOptions\" :key=\"item.value\" :label=\"item.label\" :value=\"item.value\">\n                        </el-option>\n                      </el-select>\n                      <el-select size=\"medium\" v-model=\"ruleForm1.city\" placeholder=\"市\" style=\"flex:1;\"\n                        @change=\"handleCityChg('0')\" clearable>\n                        <el-option v-for=\"item in cityOptions\" :key=\"item.value\" :label=\"item.label\"\n                          :value=\"item.value\">\n                        </el-option>\n                      </el-select>\n                      <el-select size=\"medium\" v-model=\"ruleForm1.district\" placeholder=\"区\" style=\"flex:1;\" clearable>\n                        <el-option v-for=\"item in districtOptions\" :key=\"item.value\" :label=\"item.label\"\n                          :value=\"item.value\">\n                        </el-option>\n                      </el-select>\n                    </div>\n                    <el-input size=\"medium\" v-model=\"ruleForm1.office_address\" placeholder=\"详细地址\" style=\"flex:2;\">\n                    </el-input>\n                  </div>\n                </el-form-item>\n              </el-col>\n            </el-row>\n            <el-row :gutter=\"20\">\n              <el-col :span=\"8\">\n                <el-form-item prop=\"register_country\">\n                  <template slot=\"label\">\n                    <div style=\"display: flex; align-items: center;\">\n                      <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                        <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>注册国家地区\n                      </div>\n                    </div>\n                  </template>\n                  <el-select filterable size=\"medium\" v-model=\"ruleForm1.register_country\" placeholder=\"请选择\" clearable>\n                    <el-option v-for=\"item in selectList.nationality_list\" :key=\"item.k\" :label=\"item.v\"\n                      :value=\"item.k\">\n                    </el-option>\n                  </el-select>\n                </el-form-item>\n              </el-col>\n              <el-col :span=\"8\">\n                <el-form-item prop=\"register_fund\">\n                  <template slot=\"label\">\n                    <div style=\"display: flex; align-items: center;\">\n                      <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                        <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>注册资本金（单位：万元）\n                      </div>\n                    </div>\n                  </template>\n                  <el-input size=\"medium\" v-model=\"ruleForm1.register_fund\" placeholder=\"万元\"\n                    @blur=\"ruleForm1.register_fund = formatMoney(ruleForm1.register_fund,'4')\" />\n                </el-form-item>\n              </el-col>\n              <el-col :span=\"8\">\n                <el-form-item prop=\"register_money_type\">\n                  <template slot=\"label\">\n                    <div style=\"display: flex; align-items: center;\">\n                      <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                        <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>注册资本币种\n                      </div>\n                    </div>\n                  </template>\n                  <el-select size=\"medium\" v-model=\"ruleForm1.register_money_type\" placeholder=\"请选择\" clearable>\n                    <el-option v-for=\"item in selectList.register_money_type_list\" :key=\"item.k\" :label=\"item.v\"\n                      :value=\"item.k\">\n                    </el-option>\n                  </el-select>\n                </el-form-item>\n              </el-col>\n            </el-row>\n            <el-row :gutter=\"20\">\n              <el-col :span=\"8\">\n                <el-form-item prop=\"industry_type\">\n                  <template slot=\"label\">\n                    <div style=\"display: flex; align-items: center;\">\n                      <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                        <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>行业分类\n                      </div>\n                    </div>\n                  </template>\n                  <el-select size=\"medium\" v-model=\"ruleForm1.industry_type\" placeholder=\"请选择\" clearable>\n                    <el-option v-for=\"item in selectList.industry_type_list\" :key=\"item.k\" :label=\"item.v\"\n                      :value=\"item.k\">\n                    </el-option>\n                  </el-select>\n                </el-form-item>\n              </el-col>\n              <el-col :span=\"8\" v-show=\"ruleForm1.industry_type=='26'\">\n                <el-form-item prop=\"industry_name\">\n                  <template slot=\"label\">\n                    <div style=\"display: flex; align-items: center;\">\n                      <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                        <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"ruleForm3.is_special==='0'&&ruleForm1.industry_type=='26'\">*</span>行业注明\n                      </div>\n                    </div>\n                  </template>\n                  <el-input size=\"medium\" v-model=\"ruleForm1.industry_name\" placeholder=\"请输入行业注明\" />\n                </el-form-item>\n              </el-col>\n              <el-col :span=\"8\">\n                <el-form-item prop=\"tel\">\n                  <template slot=\"label\">\n                    <div style=\"display: flex; align-items: center;\">\n                      <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                        <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>联系电话\n                      </div>\n                    </div>\n                  </template>\n                  <el-input size=\"medium\" v-model=\"ruleForm1.tel\" placeholder=\"请输入联系电话\" />\n                </el-form-item>\n              </el-col>\n              <el-col :span=\"8\">\n                <el-form-item prop=\"setup_date\">\n                  <template slot=\"label\">\n                    <div style=\"display: flex; align-items: center;\">\n                      <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                        <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>成立日期\n                        <el-tooltip class=\"item\" effect=\"dark\" content=\"如需手动填写，请按照“1990-01-01”的格式填写\" placement=\"top\">\n                          <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n                        </el-tooltip>\n                      </div>\n                    </div>\n                  </template>\n                  <el-date-picker v-model=\"ruleForm1.setup_date\" type=\"date\" placeholder=\"选择日期\" style=\"width: 100%;\"\n                    format=\"yyyy-MM-dd\" clearable editable />\n                </el-form-item>\n              </el-col>\n            </el-row>\n            <el-row :gutter=\"20\">\n              <el-col :span=\"8\">\n                <el-form-item prop=\"id_type\">\n                  <template slot=\"label\">\n                    <div style=\"display: flex; align-items: center;\">\n                      <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                        <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>证照类型\n                      </div>\n                    </div>\n                  </template>\n                  <el-select size=\"medium\" v-model=\"ruleForm1.id_type\" placeholder=\"请选择\" clearable\n                    @change=\"clearIdNoValidate('ruleForm1')\">\n                    <el-option v-for=\"item in selectList.id_type_jg_list\" :key=\"item.k\" :label=\"item.v\" :value=\"item.k\">\n                    </el-option>\n                  </el-select>\n                </el-form-item>\n              </el-col>\n              <el-col :span=\"8\">\n                <el-form-item prop=\"id_no\">\n                  <template slot=\"label\">\n                    <div style=\"display: flex; align-items: center;\">\n                      <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                        <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>证照号码\n                      </div>\n                    </div>\n                  </template>\n                  <el-input size=\"medium\" v-model=\"ruleForm1.id_no\" placeholder=\"请输入证照号码\" />\n                </el-form-item>\n              </el-col>\n            </el-row>\n            <el-row :gutter=\"20\">\n              <el-col :span=\"16\">\n                <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                  <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right:4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>证件有效期\n                  <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n                  <span style=\"color:#F56C6C;font-size:14px;\">如需手动填写，请按照“1990-01-01”的格式填写</span>\n                </div>\n                <div style=\"display:flex;width:100%;gap:8px;\">\n                  <div>\n                    <el-form-item prop=\"id_begindate\">\n                      <el-date-picker v-model=\"ruleForm1.id_begindate\" type=\"date\" placeholder=\"开始日期\" style=\"flex:1;\"\n                        format=\"yyyy-MM-dd\" clearable>\n                      </el-date-picker>\n                    </el-form-item>\n                    <div style=\"color:#F56C6C;margin-top:-20px;font-size:12px;\">请输入“最新的发证日期”</div>\n                  </div>\n                  <div style=\"height:40px;line-height:40px;\">至</div>\n                  <el-form-item prop=\"id_enddate\">\n                    <el-date-picker v-model=\"ruleForm1.id_enddate\" type=\"date\" placeholder=\"结束日期\" style=\"flex:1;\"\n                      format=\"yyyy-MM-dd\" align=\"right\" :picker-options=\"pickerOptions\" clearable>\n                    </el-date-picker>\n                  </el-form-item>\n                </div>\n              </el-col>\n            </el-row>\n            <el-row>\n              <el-col :span=\"24\">\n                <el-form-item prop=\"busi_scope\">\n                  <template slot=\"label\">\n                    <div style=\"display: flex; align-items: center;\">\n                      <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                        <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>经营范围\n                      </div>\n                    </div>\n                  </template>\n                  <el-input size=\"medium\" v-model=\"ruleForm1.busi_scope\" type=\"textarea\" :rows=\"3\"\n                    placeholder=\"请输入经营范围\" />\n                </el-form-item>\n              </el-col>\n            </el-row>\n          </el-form>\n        </div>\n        <div class=\"attachment-section\">\n          <span>附件信息</span>\n          <!--<el-tooltip \n            class=\"item\" \n            effect=\"dark\" \n            content=\"\" \n            placement=\"right\">\n          </el-tooltip>-->\n          <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n          <span style=\"color:#F56C6C;font-size:14px;\">请上传基本信息表签章版、客户营业执照复印件、客户公司章程复印件、在工商外部数据库（如“企查查”）查验的报告。</span>\n          <el-table :data=\"attachmentList.basicInfo\" border style=\"width: 100%; margin-top: 10px;\"\n            :default-sort=\"{prop: 'date', order: 'descending'}\">\n            <el-table-column prop=\"name\" label=\"附件名称\" sortable>\n              <template slot-scope=\"scope\">\n                <el-button type=\"text\" @click=\"handlePreview(scope.row)\" class=\"attachment-btn\">\n                  {{ scope.row.name }}\n                </el-button>\n              </template>\n            </el-table-column>\n            <el-table-column prop=\"extension\" label=\"附件类型\" width=\"120\"></el-table-column>\n            <el-table-column prop=\"create_time\" label=\"上传时间\" width=\"160\" sortable></el-table-column>\n            <el-table-column prop=\"file_size\" label=\"附件大小\" width=\"120\" sortable>\n              <template slot-scope=\"scope\">\n                {{ formatSize(scope.row.file_size) }}\n              </template>\n            </el-table-column>\n            <el-table-column prop=\"create_by\" label=\"上传人\" width=\"120\" sortable></el-table-column>\n            <el-table-column prop=\"create_time\" label=\"操作\" width=\"150\">\n              <template slot-scope=\"scope\">\n                <div class=\"operation-buttons\">\n                  <el-tooltip content=\"预览\">\n                    <el-button type=\"text\" class=\"el-icon-view\" @click=\"handlePreview(scope.row)\"></el-button>\n                  </el-tooltip>\n                  <el-tooltip content=\"下载\">\n                    <el-button type=\"text\" class=\"el-icon-download\" @click=\"handleDownload(scope.row)\"></el-button>\n                  </el-tooltip>\n                </div>\n              </template>\n            </el-table-column>\n          </el-table>\n          <!-- 上传按钮 -->\n          <div class=\"upload-add\">\n            <div class=\"upload-demo\">\n              <el-button type=\"text\" icon=\"el-icon-plus\" @click=\"openFileDialog(1)\">添加</el-button>\n            </div>\n          </div>\n        </div>\n      </el-card>\n      <!--反洗钱特殊情况申请-->\n      <el-card class=\"box-card\" :name=\"'fxqSpecial'+this._uid\">\n        <div slot=\"header\" class=\"clearfix\">\n          <span>反洗钱特殊情况</span>\n        </div>\n        <el-form :model=\"ruleForm3\" :rules=\"rules\" ref=\"ruleForm3\" style=\"padding:20px;\" label-position=\"top\">\n          <el-form-item label=\"是否存在反洗钱特殊情况申请\" prop=\"is_special\" label-width=\"200\">\n            <el-radio-group v-model=\"ruleForm3.is_special\">\n              <el-radio label=\"1\">是</el-radio>\n              <el-radio label=\"0\">否</el-radio>\n            </el-radio-group>\n            <div style=\"color:#f56c6c;\">如目前存在未获取的反洗钱信息或底稿材料，请选择“是”</div>\n          </el-form-item>\n          <!--表单内容-->\n          <div v-if=\"ruleForm3.is_special=='1'\">\n            <el-row :gutter=\"20\">\n              <el-col :span=\"12\">\n                <!--<el-form-item label=\"客户类型\" prop=\"client_type\">\n                  <el-select size=\"medium\" v-model=\"ruleForm3.client_type\" multiple placeholder=\"请选择\">\n                    <el-option v-for=\"item in selectList.client_type_list\" :key=\"item.k\" :label=\"item.v\"\n                      :value=\"item.k\">\n                    </el-option>\n                  </el-select>\n                </el-form-item>-->\n                <el-form-item label=\"客户类型\" prop=\"client_type\">\n                  <el-checkbox-group v-model=\"ruleForm3.client_type\">\n                    <el-checkbox v-for=\"item in selectList.client_type_list\" :key=\"item.k\" :label=\"item.k\">\n                      {{ item.v }}\n                    </el-checkbox>\n                  </el-checkbox-group>\n                </el-form-item>\n              </el-col>\n              <el-col :span=\"12\">\n                <el-form-item label=\"具体说明\" prop=\"client_type_other\" v-if=\"ruleForm3.client_type.indexOf('99')!==-1\">\n                  <el-input size=\"medium\" v-model=\"ruleForm3.client_type_other\">\n                  </el-input>\n                </el-form-item>\n              </el-col>\n            </el-row>\n            <el-row :gutter=\"20\">\n              <el-col :span=\"12\">\n                <!--<el-form-item label=\"特殊事项\" prop=\"special_matters\">\n                  <el-select size=\"medium\" v-model=\"ruleForm3.special_matters\" multiple placeholder=\"请选择\">\n                    <el-option v-for=\"item in selectList.special_matters_list\" :key=\"item.k\" :label=\"item.v\"\n                      :value=\"item.k\">\n                    </el-option>\n                  </el-select>\n                </el-form-item>-->\n                <el-form-item label=\"特殊事项\" prop=\"special_matters\">\n                  <el-checkbox-group v-model=\"ruleForm3.special_matters\">\n                    <el-checkbox v-for=\"item in selectList.special_matters_list\" :key=\"item.k\" :label=\"item.k\">\n                      {{ item.v }}\n                    </el-checkbox>\n                  </el-checkbox-group>\n                </el-form-item>\n              </el-col>\n              <el-col :span=\"12\">\n              </el-col>\n            </el-row>\n            <el-form-item label=\"具体说明缺失的信息\" prop=\"missing_information\"\n              v-if=\"ruleForm3.special_matters.indexOf('1')!==-1\">\n              <el-input size=\"medium\" v-model=\"ruleForm3.missing_information\">\n              </el-input>\n            </el-form-item>\n            <el-form-item label=\"具体说明缺失的底稿\" prop=\"missing_draft\" v-if=\"ruleForm3.special_matters.indexOf('2')!==-1\">\n              <el-input size=\"medium\" v-model=\"ruleForm3.missing_draft\">\n              </el-input>\n            </el-form-item>\n            <el-form-item label=\"具体说明\" prop=\"special_matters_other\" v-if=\"ruleForm3.special_matters.indexOf('99')!==-1\">\n              <el-input size=\"medium\" v-model=\"ruleForm3.special_matters_other\">\n              </el-input>\n            </el-form-item>\n            <el-form-item label=\"特殊事项原因\" prop=\"special_reason\">\n              <el-input size=\"medium\" type=\"textarea\" v-model=\"ruleForm3.special_reason\">\n              </el-input>\n            </el-form-item>\n            <el-form-item label=\"已开展的反洗钱尽职调查工作\" prop=\"completed_cdd\">\n              <el-input size=\"medium\" type=\"textarea\" v-model=\"ruleForm3.completed_cdd\">\n              </el-input>\n            </el-form-item>\n            <el-form-item label=\"客户洗钱风险较低的评估说明\" prop=\"low_risk_explanation\">\n              <el-input size=\"medium\" type=\"textarea\" :autosize=\"{minRows:1, maxRows:30}\"\n                v-model=\"ruleForm3.low_risk_explanation\">\n              </el-input>\n            </el-form-item>\n            <el-form-item label=\"后续措施\" prop=\"take_measures\">\n              <el-input size=\"medium\" type=\"textarea\" v-model=\"ruleForm3.take_measures\">\n              </el-input>\n            </el-form-item>\n          </div>\n          <!--附件内容-->\n          <div v-if=\"ruleForm3.is_special=='1'\" class=\"fxqSpecial\">\n            <div style=\"font-weight:blod;font-size:15px;padding-bottom:20px;\">附件</div>\n            <el-row :gutter=\"20\" style=\"padding-bottom:20px;\">\n              <el-col :span=\"8\">\n                <font color=\"#F56C6C\">*&nbsp;</font>与客户沟通记录\n              </el-col>\n              <el-col :span=\"16\">\n                <el-upload class=\"upload-demo\" ref=\"upload\"\n                  action=\"m?xwl=aml_monitor/workflow/prs01/dataSource/files/upload_file1\" name=\"file1\"\n                  header=\"{content-type:'text/html'}\" :data=\"uploadParams1\" :file-list=\"attachmentList.communication\"\n                  :on-success=\"handleSuccess\" :auto-upload=\"true\" :on-change=\"handleChange1\" :on-remove=\"handleRemove1\"\n                  multiple :before-remove=\"beforeRemove\">\n                  <el-button slot=\"trigger\" size=\"mini\" icon=\"el-icon-upload2\">上传文件</el-button>\n                  <div slot=\"tip\" class=\"el-upload__tip\">支持扩展名 .zip .rar .xlsx .xls .doc .docx .pdf .jpg .jpeg .svg .gif\n                    .png .txt .mp3 .mp4</div>\n                </el-upload>\n              </el-col>\n            </el-row>\n            <el-row :gutter=\"20\" style=\"padding-bottom:20px;\">\n              <el-col :span=\"8\">\n                <font color=\"#F56C6C\">*&nbsp;</font>二级部门负责人同意的记录\n              </el-col>\n              <el-col :span=\"16\">\n                <el-upload class=\"upload-demo\" ref=\"upload\"\n                  action=\"m?xwl=aml_monitor/workflow/prs01/dataSource/files/upload_file1\" name=\"file1\"\n                  header=\"{content-type:'text/html'}\" :data=\"uploadParams2\" :file-list=\"attachmentList.agree\"\n                  :on-success=\"handleSuccess\" :auto-upload=\"true\" :on-change=\"handleChange2\" :on-remove=\"handleRemove2\"\n                  multiple :before-remove=\"beforeRemove\">\n                  <el-button slot=\"trigger\" size=\"mini\" icon=\"el-icon-upload2\">上传文件</el-button>\n                  <div slot=\"tip\" class=\"el-upload__tip\">支持扩展名 .zip .rar .xlsx .xls .doc .docx .pdf .jpg .jpeg .svg .gif\n                    .png .txt .mp3 .mp4</div>\n                </el-upload>\n              </el-col>\n            </el-row>\n            <el-row :gutter=\"20\" style=\"padding-bottom:20px;\">\n              <el-col :span=\"8\">\n                <font>&nbsp;&nbsp;</font>其他底稿\n              </el-col>\n              <el-col :span=\"16\">\n                <el-upload class=\"upload-demo\" ref=\"upload\"\n                  action=\"m?xwl=aml_monitor/workflow/prs01/dataSource/files/upload_file1\" name=\"file1\"\n                  header=\"{content-type:'text/html'}\" :data=\"uploadParams3\" :file-list=\"attachmentList.other\"\n                  :on-success=\"handleSuccess\" :auto-upload=\"true\" :on-change=\"handleChange3\" :on-remove=\"handleRemove3\"\n                  multiple :before-remove=\"beforeRemove\">\n                  <el-button slot=\"trigger\" size=\"mini\" icon=\"el-icon-upload2\">上传文件</el-button>\n                  <div slot=\"tip\" class=\"el-upload__tip\">支持扩展名 .zip .rar .xlsx .xls .doc .docx .pdf .jpg .jpeg .svg .gif\n                    .png .txt .mp3 .mp4</div>\n                </el-upload>\n              </el-col>\n            </el-row>\n          </div>\n        </el-form>\n      </el-card>\n      <!--法定代表人-->\n      <el-card class=\"box-card\" :name=\"'LegalRep'+this._uid\" v-if=\"organ_flag=='1'\">\n        <div slot=\"header\" class=\"clearfix\">\n          <span>法定代表人相关信息</span>\n          <el-button type=\"text\" icon=\"el-icon-plus\" class=\"add-btn\" @click=\"showDialog('1',{},'1')\">添加</el-button>\n        </div>\n        <div v-if=\"relatedInfo1.length==0\" style=\"color:#8d8b8b;text-align:center\">暂无数据</div>\n        <el-card v-for=\"item in relatedInfo1\" :key=\"item.related_id\" style=\"margin-bottom:10px;\"\n          :class=\"{ 'highlight-border': item.data_status === '0' }\" class=\"relat-card\">\n          <div class=\"client-info\">\n            <div class=\"client-title\">\n              <div>\n                <span>{{item.related_name}}</span>\n                <el-tag type=\"success\" effect=\"dark\" size=\"mini\" style=\"margin-left: 10px;\"\n                  v-if=\"item.organ_flag==='0'\">\n                  自然人</el-tag>\n                <el-tag type=\"\" effect=\"dark\" size=\"mini\" style=\"margin-left: 10px;\" v-if=\"item.organ_flag==='1'\">法人\n                </el-tag>\n              </div>\n              <div>\n                <el-tag type=\"danger\" effect=\"plain\" size=\"mini\" style=\"margin-left: 10px;\"\n                  v-if=\"item.data_status==='0'\">数据已变更 请点击表单“保存”或“提交并关闭页面”按钮保存当前草稿数据\n                </el-tag>\n              </div>\n            </div>\n\n            <el-row :gutter=\"10\" class=\"info-row\">\n              <div class=\"info-row-flex\" v-if=\"item.organ_flag==='1'\"><label>国家或地区</label>\n                <div>{{formatDictMap('nationality_list',item.nationality)|| '-'}}</div>\n              </div>\n              <div class=\"info-row-flex\" v-if=\"item.organ_flag==='0'\"><label>国籍</label>\n                <div>{{formatDictMap('nationality_list',item.nationality)|| '-'}}</div>\n              </div>\n              <div class=\"info-row-flex\"><label>证件类型</label>\n                <div>{{formatDictMap('id_type_list',item.id_type)|| '-'}}</div>\n              </div>\n              <div class=\"info-row-flex\"><label>证件号码</label>\n                <div>{{item.id_no|| '-'}}</div>\n              </div>\n            </el-row>\n\n            <el-row :gutter=\"10\" class=\"info-row\">\n              <div class=\"info-row-flex\"><label>证件有效期</label>\n                <div>{{item.id_begindate|| '-'}}至{{item.id_enddate|| '-'}}</div>\n              </div>\n              <div class=\"info-row-flex\"><label>出生年月</label>\n                <div>{{item.birthday|| '-'}}</div>\n              </div>\n              <div class=\"info-row-flex\"><label>联系方式</label>\n                <div>{{item.mobno1|| '-'}}</div>\n              </div>\n            </el-row>\n          </div>\n          <!-- 操作按钮 -->\n          <div class=\"attachment-footer\">\n            <el-button type=\"text\" @click=\"deleteRalated(item)\">删除</el-button>\n            <el-button type=\"text\" @click=\"showDialog('2',item,'1')\">编辑</el-button>\n          </div>\n        </el-card>\n        <!-- 附件信息表 -->\n        <div style=\"padding-top:10px;\">\n          <span>附件信息</span>\n          <!--<el-tooltip \n            class=\"item\" \n            effect=\"dark\" \n            content=\"\" \n            placement=\"right\">\n          </el-tooltip>-->\n          <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i><span style=\"color:#F56C6C;font-size:14px;\">请上传法定代表人身份证明文件的复印件</span>\n          <el-table :data=\"attachmentList.LegalRep\" border style=\"width: 100%;margin-top:10px;\"\n            :default-sort=\"{prop: 'date', order: 'descending'}\">\n            <el-table-column prop=\"name\" label=\"附件名称\" sortable>\n              <template slot-scope=\"scope\">\n                <el-button type=\"text\" @click=\"handlePreview(scope.row)\" class=\"attachment-btn\">\n                  {{ scope.row.name }}\n                </el-button>\n              </template>\n            </el-table-column>\n            <el-table-column prop=\"extension\" label=\"附件类型\" width=\"120\" />\n            <el-table-column prop=\"create_time\" label=\"上传时间\" width=\"160\" sortable />\n            <el-table-column prop=\"file_size\" label=\"附件大小\" width=\"120\" sortable>\n              <template slot-scope=\"scope\">\n                {{ formatSize(scope.row.file_size) }}\n              </template>\n            </el-table-column>\n            <el-table-column prop=\"create_by\" label=\"上传人\" width=\"120\" sortable />\n            <el-table-column label=\"操作\" width=\"150\" fixed=\"right\">\n              <template slot-scope=\"scope\">\n                <div class=\"operation-buttons\">\n                  <el-tooltip content=\"预览\">\n                    <el-button type=\"text\" class=\"el-icon-view\" @click=\"handlePreview(scope.row)\"></el-button>\n                  </el-tooltip>\n                  <el-tooltip content=\"下载\">\n                    <el-button type=\"text\" class=\"el-icon-download\" @click=\"handleDownload(scope.row)\"></el-button>\n                  </el-tooltip>\n                </div>\n              </template>\n            </el-table-column>\n          </el-table>\n          <!-- 上传按钮 -->\n          <div class=\"upload-add\">\n            <div class=\"upload-demo\">\n              <el-button type=\"text\" icon=\"el-icon-plus\" @click=\"openFileDialog(23)\">添加</el-button>\n            </div>\n          </div>\n        </div>\n      </el-card>\n      <!--控股股东-->\n      <el-card class=\"box-card\" :name=\"'controllingShareholder'+this._uid\" v-if=\"organ_flag=='1'\">\n        <div slot=\"header\" class=\"clearfix\">\n          <span>控股股东相关信息</span>\n          <el-button type=\"text\" icon=\"el-icon-plus\" class=\"add-btn\" @click=\"showDialog('1',{},'2')\">添加</el-button>\n        </div>\n        <div v-if=\"relatedInfo2.length==0\" style=\"color:#8d8b8b;text-align:center\">暂无数据</div>\n        <el-card v-for=\"item in relatedInfo2\" :key=\"item.related_id\" style=\"margin-bottom:10px;\"\n          :class=\"{ 'highlight-border': item.data_status === '0' }\" class=\"relat-card\">\n          <div class=\"client-info\">\n            <div cl