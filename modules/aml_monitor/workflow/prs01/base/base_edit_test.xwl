t v-model=\"bomisParams.editBomisForm.id_type\" placeholder=\"请选择\" clearable\n                  @change=\"clearIdNoValidate('editBomisForm')\" class=\"formitem-full-width formitem-max-width\">\n                  <el-option v-for=\"item in selectList.id_type_gr_list\" :key=\"item.k\" :label=\"item.v\" :value=\"item.k\">\n                  </el-option>\n                </el-select>\n              </el-form-item>\n            </el-col>\n            <el-col :span=\"8\">\n              <el-form-item prop=\"id_no\" label=\"证件编号\" class=\"always-show-required\">\n                <el-input v-model=\"bomisParams.editBomisForm.id_no\" placeholder=\"请输入\" clearable\n                  style=\"max-width: 325px;\"></el-input>\n              </el-form-item>\n            </el-col>\n            <el-col :span=\"8\">\n              <div style=\"height:28px;line-height:28px;font-size:14px;color:#606266;\">\n                证件有效期\n              </div>\n              <div style=\"display:flex;width:100%;gap:8px;\">\n                <el-form-item prop=\"id_begindate\">\n                  <el-date-picker v-model=\"bomisParams.editBomisForm.id_begindate\" type=\"date\" placeholder=\"开始日期\"\n                    style=\"flex:1;\" format=\"yyyy-MM-dd\" clearable>\n                  </el-date-picker>\n                </el-form-item>\n                <div>~</div>\n                <el-form-item prop=\"id_enddate\">\n                  <el-date-picker v-model=\"bomisParams.editBomisForm.id_enddate\" type=\"date\" placeholder=\"结束日期\"\n                    style=\"flex:1;\" format=\"yyyy-MM-dd\" align=\"right\" :picker-options=\"bomisParams.pickerOptions\"\n                    clearable>\n                  </el-date-picker>\n                </el-form-item>\n              </div>\n              <!-- <div style=\"color:#F56C6C;font-size:12px;margin-top: -16px;\">如需手动填写，请按照“1990-01-01”的格式填写</div> -->\n            </el-col>\n            <el-col :span=\"8\">\n              <el-form-item prop=\"gender\" label=\"性别\" class=\"always-show-required\">\n                <el-select v-model=\"bomisParams.editBomisForm.gender\" placeholder=\"请选择\"\n                  class=\"formitem-full-width formitem-max-width\">\n                  <el-option label=\"男\" value=\"1\" />\n                  <el-option label=\"女\" value=\"2\" />\n                  <el-option label=\"未知\" value=\"3\" />\n                </el-select>\n              </el-form-item>\n            </el-col>\n            <el-col :span=\"8\">\n              <el-form-item prop=\"nationality\" label=\"国籍\">\n                <el-select v-model=\"bomisParams.editBomisForm.nationality\" filterable placeholder=\"请选择\" clearable\n                  class=\"formitem-full-width formitem-max-width\">\n                  <el-option v-for=\"item in selectList.nationality_list\" :key=\"item.k\" :label=\"item.v\" :value=\"item.k\">\n                  </el-option>\n                </el-select>\n              </el-form-item>\n            </el-col>\n            <el-col :span=\"8\">\n              <div style=\"height:28px;line-height:28px;font-size:14px;color:#606266;\">\n                出生年月\n              </div>\n              <el-form-item prop=\"birthday\">\n                <el-date-picker v-model=\"bomisParams.editBomisForm.birthday\" type=\"date\" placeholder=\"选择日期\"\n                  format=\"yyyy-MM-dd\" clearable editable class=\"formitem-full-width formitem-max-width\" />\n              </el-form-item>\n              <!-- <div style=\"color:#F56C6C;font-size:12px;margin-top: -16px;\">如需手动填写，请按照“1990-01-01”的格式填写</div> -->\n            </el-col>\n            <el-col :span=\"8\">\n              <el-form-item prop=\"mobno1\" label=\"联系方式（手机）\" class=\"always-show-required\">\n                <el-input v-model=\"bomisParams.editBomisForm.mobno1\" placeholder=\"请输入\" clearable\n                  style=\"max-width: 325px;\"></el-input>\n              </el-form-item>\n            </el-col>\n            <el-col :span=\"8\">\n              <el-form-item prop=\"mobno2\" label=\"联系方式（固话）\" class=\"always-show-required\">\n                <el-input v-model=\"bomisParams.editBomisForm.mobno2\" placeholder=\"请输入\" clearable\n                  style=\"max-width: 325px;\"></el-input>\n              </el-form-item>\n            </el-col>\n            <el-col :span=\"8\">\n              <div style=\"height:28px;line-height:28px;font-size:14px;color:#606266;\">\n                形成时间\n              </div>\n              <el-form-item prop=\"birthday\">\n                <el-date-picker v-model=\"bomisParams.editBomisForm.birthday\" type=\"date\" placeholder=\"选择日期\"\n                  format=\"yyyy-MM-dd\" clearable editable class=\"formitem-full-width formitem-max-width\" />\n              </el-form-item>\n              <!-- <div style=\"color:#F56C6C;font-size:12px;margin-top: -16px;\">如需手动填写，请按照“1990-01-01”的格式填写</div> -->\n            </el-col>\n            <el-col :span=\"8\">\n              <div style=\"height:28px;line-height:28px;font-size:14px;color:#606266;\">\n                终止时间\n              </div>\n              <el-form-item prop=\"birthday\">\n                <el-date-picker v-model=\"bomisParams.editBomisForm.birthday\" type=\"date\" placeholder=\"选择日期\"\n                  format=\"yyyy-MM-dd\" clearable editable class=\"formitem-full-width formitem-max-width\" />\n              </el-form-item>\n              <!-- <div style=\"color:#F56C6C;font-size:12px;margin-top: -16px;\">如需手动填写，请按照“1990-01-01”的格式填写</div> -->\n            </el-col>\n            <el-col :span=\"18\">\n              <el-form-item label=\"联系地址\" prop=\"address\">\n                <template slot=\"label\">\n                  <div style=\"display: flex; align-items: center;\">\n                    <div style=\"height:28px;line-height:28px;font-size:14px;color:#606266;\">\n                      <span style=\"color:#F56C6C;height:28px;line-height:40px;margin-right: 4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>联系地址\n                    </div>\n                  </div>\n                </template>\n                <div style=\"display:flex;width:100%;gap:8px;\">\n                  <div style=\"flex:3;display:flex;gap:8px;\">\n                    <el-select v-model=\"bomisParams.editBomisForm.province2\" placeholder=\"省\" style=\"flex:1;\"\n                      @change=\"handleProvinceChg('2')\" clearable>\n                      <el-option v-for=\"item in proOptions\" :key=\"item.value\" :label=\"item.label\" :value=\"item.value\">\n                      </el-option>\n                    </el-select>\n                    <el-select v-model=\"bomisParams.editBomisForm.city2\" placeholder=\"市\" style=\"flex:1;\"\n                      @change=\"handleCityChg('2')\" clearable>\n                      <el-option v-for=\"item in cityOptions2\" :key=\"item.value\" :label=\"item.label\" :value=\"item.value\">\n                      </el-option>\n                    </el-select>\n                    <el-select v-model=\"bomisParams.editBomisForm.district2\" placeholder=\"区\" style=\"flex:1;\" clearable>\n                      <el-option v-for=\"item in districtOptions2\" :key=\"item.value\" :label=\"item.label\"\n                        :value=\"item.value\">\n                      </el-option>\n                    </el-select>\n                  </div>\n                  <el-input v-model=\"bomisParams.editBomisForm.address\" placeholder=\"详细地址\" style=\"flex:2;\"></el-input>\n                </div>\n              </el-form-item>\n            </el-col>\n            <el-col :span=\"8\">\n              <el-button type=\"warning\" size=\"mini\">受益所有人身份信息核查</el-button>\n            </el-col>\n          </el-row>\n        </el-form>\n      </div>\n      <div style=\"display: flex;justify-content: center;margin: 1em 0 0;\">\n        <el-button type=\"warning\" size=\"mini\" @click=\"addBomisBnfInfo\">添加</el-button>\n      </div>\n      <el-table :data=\"bomisParams.bomisSourceTableData\" border style=\"width: 100%;margin: 1em 0 0;\"\n        :header-cell-style=\"{ background: '#EDF3FE' }\" size=\"mini\">\n        <el-table-column prop=\"related_name\" label=\"姓名\" width=\"120\"></el-table-column>\n        <el-table-column prop=\"address\" label=\"证件类型\" width=\"220\"></el-table-column>\n        <el-table-column prop=\"address\" label=\"证件号码\" width=\"260\"></el-table-column>\n        <el-table-column prop=\"address\" label=\"证件有效期\" width=\"260\"></el-table-column>\n        <el-table-column prop=\"address\" label=\"性别\" width=\"70\"></el-table-column>\n        <el-table-column prop=\"address\" label=\"国籍\" width=\"160\"></el-table-column>\n        <el-table-column prop=\"address\" label=\"出生日期\" width=\"160\"></el-table-column>\n        <el-table-column prop=\"address\" label=\"联系方式（手机）\" width=\"160\"></el-table-column>\n        <el-table-column prop=\"address\" label=\"联系方式（固话）\" width=\"160\"></el-table-column>\n        <el-table-column prop=\"address\" label=\"形成时间\" width=\"160\"></el-table-column>\n        <el-table-column prop=\"address\" label=\"终止时间\" width=\"160\"></el-table-column>\n        <el-table-column prop=\"address\" label=\"住址\" width=\"160\"></el-table-column>\n        <el-table-column label=\"操作\" width=\"100\" fixed=\"right\">\n          <template slot-scope=\"scope\">\n            <el-button @click=\"showBenefitEditDialog(scope.row)\" type=\"text\" size=\"small\">修改</el-button>\n            <el-button type=\"text\" size=\"small\">删除</el-button>\n          </template>\n        </el-table-column>\n      </el-table>\n      <div style=\"display: flex;justify-content: center;margin: 1em 0 0;\">\n        <el-button type=\"warning\" size=\"mini\">受益所有人信息核验</el-button>\n      </div>\n      <div v-show=\"bomisParams.bomisLastCheckResult !== null\"\n        style=\"border-width: 1px; border-style: solid; border-color: #d1d6db;border-radius: 2px;margin: 1em 0 0;padding: 10px 20px;line-height: 32px;\">\n        <el-row :gutter=\"24\">\n          <el-col :span=\"8\">\n            核验结果：\n          </el-col>\n          <el-col :span=\"8\">\n            核验时间：\n          </el-col>\n          <el-col :span=\"8\">\n            比对受益所有权结果：\n          </el-col>\n          <el-col :span=\"8\">\n            不一致情形：\n          </el-col>\n        </el-row>\n      </div>\n      <div style=\"margin: 1em 0 0;\">\n        <div style=\"font-weight: bold;\">核验明细：</div>\n        <el-table :data=\"bomisParams.bomisCheckResultTableData\" border style=\"width: 100%;margin: 0.5em 0 0;\"\n          :header-cell-style=\"{ background: '#EDF3FE' }\" size=\"mini\">\n          <el-table-column prop=\"address\" label=\"差异类型\" width=\"120\"></el-table-column>\n          <el-table-column prop=\"related_name\" label=\"姓名\" width=\"120\"></el-table-column>\n          <el-table-column prop=\"address\" label=\"证件类型\" width=\"220\"></el-table-column>\n          <el-table-column prop=\"address\" label=\"证件号码\" width=\"260\"></el-table-column>\n          <el-table-column prop=\"address\" label=\"证件有效期\" width=\"260\"></el-table-column>\n          <el-table-column prop=\"address\" label=\"性别\" width=\"70\"></el-table-column>\n          <el-table-column prop=\"address\" label=\"国籍\" width=\"160\"></el-table-column>\n          <el-table-column prop=\"address\" label=\"出生日期\" width=\"160\"></el-table-column>\n          <el-table-column prop=\"address\" label=\"联系方式（手机）\" width=\"160\"></el-table-column>\n          <el-table-column prop=\"address\" label=\"联系方式（固话）\" width=\"160\"></el-table-column>\n          <el-table-column prop=\"address\" label=\"形成时间\" width=\"160\"></el-table-column>\n          <el-table-column prop=\"address\" label=\"终止时间\" width=\"160\"></el-table-column>\n          <el-table-column prop=\"address\" label=\"住址\" width=\"160\"></el-table-column>\n        </el-table>\n      </div>\n    </div>\n    <div slot=\"footer\" class=\"dialog-footer\">\n      <el-button @click=\"closeDialog('bomisDialog')\">取消</el-button>\n      <!-- <el-bu