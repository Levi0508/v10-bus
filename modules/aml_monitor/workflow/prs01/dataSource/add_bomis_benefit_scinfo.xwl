{
  "title": "增加bomis受益人信息",
  "icon": "",
  "img": "",
  "tags": "",
  "hideInMenu": "false",
  "text": "module",
  "cls": "Wb.Module",
  "properties": {
    "cid": "module",
    "serverScript": "var benefit_scinfo = Wb.getObject('benefit_scinfo') || [];\nvar client_id = Wb.get('client_id') || '';\nlet conn;\n\nvar rs = {\n  O_RETURN_CODE: 0,\n  O_RETURN_MSG: ''\n};\n\nif (benefit_scinfo === {}) {\n  rs.O_RETURN_CODE = -1;\n  rs.O_RETURN_MSG = '受益人数据不能为空，请重填';\n}\nif (client_id === '') {\n  rs.O_RETURN_CODE = -1;\n  rs.O_RETURN_MSG = '客户号不能为空，请重填';\n}\n// 对重复的related_name进行校验\nvar checkSql1 = `select related_name from thjs.T_TH_RELAT_INFO where client_id = {?client_id?} and related_name = {?related_name?}`;\nvar checkRs1 = Wb.getRowx({ sql: checkSql1, params: { client_id: client_id, related_name: benefit_scinfo.related_name } });\n\nif (checkRs1.total > 0) {\n  rs.O_RETURN_CODE = -1;\n  rs.O_RETURN_MSG = '已存在主体名称为“' + benefit_scinfo.related_name + '”的【受益所有人】信息，请勿重复添加！';\n}\n\nif (rs.O_RETURN_CODE === -1) { Wb.send(rs); } // 校验失败，提前返回错误信息\n\nvar insertSqlData = [];\ninsertSqlData.push(benefit_scinfo);\ninsertSqlData.forEach(function (item) {\n  item.client_id = client_id;\n  function joinMulti(val) {\n    if (val === '' || val == null) {\n      return '';\n    }\n    if (Array.isArray(val)) {\n      return val.join(',');\n    }\n    return String(val);\n  }\n  item.bnf_type = joinMulti(item.bnf_type);\n  item.actctrltype = joinMulti(item.actctrltype);\n  item.seniormgrpos = joinMulti(item.seniormgrpos);\n  item.seniormgrposcn = joinMulti(item.seniormgrposcn);\n  if (item.bnf_type.indexOf('NI') >= 0) {\n    item.seniormgrpos = '10'; // 法定代表人\n  }\n});\n\n\nvar insertSql = `\ninsert into thjs.T_TH_RELAT_INFO_tmp(client_id, related_type, organ_flag, related_name, nationality, id_type, id_no, id_begindate, id_enddate, birthday, shareholding_ratio, beneficiary, address, is_government_dept, object_id, create_user, create_time, update_user, update_time, related_key, data_status, gender, mobno1, mobno2, actctrl, acthdrat, shareratiostartdate, shareratioenddate, actctrlcpny, actctrltype, obtainactdate, terminationactdate, actotherforms, actconuppermarket, actconupperentname, actconuniscid, pribenfit, actownerprofitratio, profitratiostartdate, profitratioenddate, actownerprofitratiovote, profitratiovotestartdate, profitratiovoteenddate, seniormgr, seniormgrpos, actdailymgmtpostother, seniormgrcn, seniormgrposcn, ownerrightmgmtpostother, bnf_type, bo_type, company_type, full_info_flag)\nvalues({?client_id?}, '5', {?organ_flag?}, {?related_name?}, {?nationality?}, {?id_type?}, {?id_no?}, {?id_begindate?}, {?id_enddate?}, {?birthday?}, {?shareholding_ratio?}, {?beneficiary?}, {?address?}, {?is_government_dept?}, {?object_id?}, {?create_user?}, {?create_time?}, {?update_user?}, {?update_time?}, {?related_key?}, {?data_status?}, {?gender?}, {?mobno1?}, {?mobno2?}, {?actctrl?}, {?acthdrat?}, {?shareratiostartdate?}, {?shareratioenddate?}, {?actctrlcpny?}, {?actctrltype?}, {?obtainactdate?}, {?terminationactdate?}, {?actotherforms?}, {?actconuppermarket?}, {?actconupperentname?}, {?actconuniscid?}, {?pribenfit?}, {?actownerprofitratio?}, {?profitratiostartdate?}, {?profitratioenddate?}, {?actownerprofitratiovote?}, {?profitratiovotestartdate?}, {?profitratiovoteenddate?}, {?seniormgr?}, {?seniormgrpos?}, {?actdailymgmtpostother?}, {?seniormgrcn?}, {?seniormgrposcn?}, {?ownerrightmgmtpostother?}, {?bnf_type?}, {?bo_type?}, {?company_type?}, {?full_info_flag?})\n`;\n\ntry {\n  conn = Wb.getConn();\n\n  Wb.sql({\n    sql: insertSql,\n    params: insertSqlData,\n    trans: true,\n    commit: false\n  });\n\n\n  conn.commit();\n  rs.O_RETURN_CODE = 0;\n  rs.O_RETURN_MSG = \"执行成功\";\n} catch (e) {\n  rs.O_RETURN_CODE = -1;\n  rs.O_RETURN_MSG = \"保存失败：\" + e;\n  conn.rollback();\n} finally {\n  conn.close();\n  Wb.send(rs);\n\n}\n"
  },
  "_icon": "module"
}