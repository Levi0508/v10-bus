{
  "title": "绑定BOMIS核验记录与审核流程",
  "icon": "",
  "img": "",
  "tags": "",
  "hideInMenu": "false",
  "text": "module",
  "cls": "Wb.Module",
  "properties": {
    "cid": "module",
    "serverScript": "var client_id = Wb.get('client_id');\nvar audit_id = Wb.get('audit_id');\nvar rs = { O_RETURN_CODE: 0, O_RETURN_MSG: '执行成功' };\n\nif (Wb.isEmpty(client_id) || Wb.isEmpty(audit_id)) {\n  rs.O_RETURN_CODE = -1;\n  rs.O_RETURN_MSG = '缺少 client_id 或 audit_id';\n  Wb.send(rs);\n}\n\n// 将未归属流程的核验记录挂到本次审核批次（需表字段 piid / audit_id）\nvar sql = `\n  update thjs.th_bomis_response t\n  set t.audit_id = {?audit_id?}\n  where t.client_id = {?client_id?}\n    and (t.piid is null or trim(t.piid) = '')\n    and (t.audit_id is null or trim(t.audit_id) = '')\n`;\n\ntry {\n  Wb.sql({ sql: sql, trans: true, commit: true });\n} catch (e) {\n  // 表结构未就绪时不阻断审核提交\n  Wb.log('bind_bomis_piid skip: ' + e);\n}\n\nWb.send(rs);"
  },
  "_icon": "module"
}
