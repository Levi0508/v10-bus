{"title":"编辑页面删除关联主体","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"// 在编辑页面对关联人删除时，一个删除只会对应一条数据，需与填报页面的删除区分开\nlet data_status = Wb.get('DATA_STATUS');\n\nlet client_id = Wb.get('CLIENT_ID');\nlet related_name = Wb.get('RELATED_NAME');\nlet related_type = Wb.get('RELATED_TYPE');\nlet username = Wb.get('sys.username');\nlet params = '客户号client_id：' + client_id + ',关联类型related_type:' + related_type + ',关联人名称related_name：' + related_name;\n\n// 1.删除正式数据\nif (data_status == '1') {\n  // 1.1 记录日志\n  let log = Wb.sql({ sql: `insert into thjs.t_tmp_exec_log(opt_user,opt_url,opt_params,opt_response)values({?opt_user?},{?opt_url?},{?opt_params?},{?opt_response?})`, contextParams: false, params: { opt_user: username, opt_url: 'delete_single_entity', opt_params: params, opt_response: '备注：在客户信息编辑页面执行了删除关联人操作，删除了正式表数据' } });\n  // 1.2 存入tmp表\n//   Wb.sql({\n//     sql: `INSERT INTO thjs.t_th_relat_info_tmp select * from thjs.t_th_relat_info where client_id = {?CLIENT_ID?} \n// and (organ_flag = {?ORGAN_FLAG?} or {?ORGAN_FLAG?} is null)\n// and (related_type = {?RELATED_TYPE?} or {?RELATED_TYPE?} is null)\n// and (related_id = {?RELATED_ID?});`});\n//   // 1.3 更新tmp表的data_status为0\n//   Wb.sql({\n//     sql: `update thjs.t_th_relat_info_tmp set data_status = '0' where client_id = {?CLIENT_ID?} \n// and (organ_flag = {?ORGAN_FLAG?} or {?ORGAN_FLAG?} is null)\n// and (related_type = {?RELATED_TYPE?} or {?RELATED_TYPE?} is null)\n// and (related_id = {?RELATED_ID?});`});\n  // 1.4 删除正式表\n  Wb.sendRowx(`delete from thjs.t_th_relat_info \nwhere client_id = {?CLIENT_ID?} \nand (organ_flag = {?ORGAN_FLAG?} or {?ORGAN_FLAG?} is null)\nand (related_type = {?RELATED_TYPE?} or {?RELATED_TYPE?} is null)\nand (related_id = {?RELATED_ID?});`\n  );\n} else {\n  // 2.删除临时数据\n  // 2.1 记录日志\n  let log = Wb.sql({ sql: `insert into thjs.t_tmp_exec_log(opt_user,opt_url,opt_params,opt_response)values({?opt_user?},{?opt_url?},{?opt_params?},{?opt_response?})`, contextParams: false, params: { opt_user: username, opt_url: 'delete_single_entity', opt_params: params, opt_response: '备注：在客户信息编辑页面执行了删除关联人操作，删除了临时表数据' } });\n  // 2.2 直接删除临时数据\n  Wb.sendRowx(`delete from thjs.t_th_relat_info_tmp\nwhere client_id = {?CLIENT_ID?} \nand (organ_flag = {?ORGAN_FLAG?} or {?ORGAN_FLAG?} is null)\nand (related_type = {?RELATED_TYPE?} or {?RELATED_TYPE?} is null)\nand (related_id = {?RELATED_ID?});`\n  );\n}"},"_icon":"module"}