{"title":"查询附件","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"// Wb.sendRowx(`SELECT * FROM\n// thjs.t_th_client_file\n// WHERE client_id = {?I_CLIENT_ID?} \n// AND (INSTR(','||{?I_FILE_TYPE_NO?}||',', ',' || file_type_no || ',') > 0 OR {?I_FILE_TYPE_NO?} IS NULL)\n// AND (object_id = {?I_OBJECT_ID?} OR {?I_OBJECT_ID?} IS NULL)`);\n\nWb.sendRowx(`SELECT a.client_id,\na.file_type_no,\na.id,\na.name,\na.file_size,\na.extension,\ncoalesce(b.display_name,b1.display_name,a.create_by) as create_by,\na.create_time,\na.file_path,\na.status,\na.object_id from (\n    SELECT \n        t.*,\n        ROW_NUMBER() OVER (\n            PARTITION BY client_id, name, file_type_no, extension, file_path \n            ORDER BY create_time DESC\n        ) as rn\n    FROM \n        thjs.t_th_client_file t\n        \n    WHERE \n        client_id = {?I_CLIENT_ID?} \n        AND (INSTR(','||{?I_FILE_TYPE_NO?}||',', ',' || file_type_no || ',') > 0 OR {?I_FILE_TYPE_NO?} IS NULL)\n        AND (object_id = {?I_OBJECT_ID?} OR {?I_OBJECT_ID?} IS NULL)\n)a\nleft join basic_thjs.wb_user b on a.create_by = b.user_name\nleft join basic_thjs.wb_user_hg b1 on a.create_by = b1.user_name\nWHERE rn = 1 order by a.create_time desc`);"},"_icon":"module"}