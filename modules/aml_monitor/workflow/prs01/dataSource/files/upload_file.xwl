{"title":"附件上传（数据库）","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"let file1 = Wb.get('file1'),\n  fileTypeNo = Wb.get('file_type_no'),\n  clientId = Wb.get('client_id'),\n  objectId = Wb.get('objectId')\nlet result = saveFile2Db(clientId, fileTypeNo, file1);\n// 返回\nWb.send(result);\nfunction saveFile2Db(clientId, fileTypeNo, file1) {\n  var userName = Wb.get('sys.username');\n  var id = SysUtil.getId();\n  var fileInfoSql = `insert into thjs.t_th_client_file(client_id, file_type_no, id, name, file_size, extension, create_by, create_time, object_id)\n  values(?,?,?,?,?,?,?,?,?)`;\n  var sql = `insert into thjs.t_th_client_file_content(id,content)values(?,?)`;\n  var conn = DataSource.getConnection(), pstmt;\n  var content = file1.stream;\n  try {\n    pstmt = conn.prepareStatement(fileInfoSql);\n    pstmt.setString(1, clientId);\n    pstmt.setString(2, fileTypeNo);\n    pstmt.setString(3, id);\n    pstmt.setString(4, FileUtil.removeExtension(file1.name));\n    pstmt.setDouble(5, file1.size);\n    pstmt.setString(6, FileUtil.getFileExt(file1.name));\n    pstmt.setString(7, userName);\n    pstmt.setTimestamp(8, new java.sql.Timestamp(new java.util.Date().getTime()));\n    pstmt.setString(9, objectId);\n    pstmt.executeUpdate();\n\n    pstmt = conn.prepareStatement(sql);\n    pstmt.setString(1, id);\n    Wb.info(\"content\");\n    Wb.info(content);\n    pstmt.setBinaryStream(2, content, file1.size);\n    pstmt.executeUpdate();\n  } catch (e) {\n    conn.rollback();\n    throw e;\n  } finally {\n    conn.commit();\n    conn.close();\n  }\n  return id;\n}"},"_icon":"module"}