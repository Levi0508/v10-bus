{
  "title": "bomis实时核验接口对接",
  "icon": "",
  "img": "",
  "tags": "",
  "hideInMenu": "false",
  "text": "module",
  "cls": "Wb.Module",
  "properties": {
    "cid": "module",
    "serverScript": "var env = 'prod'; // dev-开发 prod-生产\n\nvar client_id = Wb.get('client_id') || '';\nvar uscc = Wb.get('uscc') || ''; // 统一社会信用代码\nvar orgNm = Wb.get('orgNm') || ''; // 主体名称\nvar branchCode = Wb.get('branchCode') || '';\nvar branchName = Wb.get('branchName') || '';\nvar orgTp = Wb.get('orgTp') || '1'; // 1-公司  2-合伙企业 3-外国公司分支机构 4-豁免主体\nvar benefitData = Wb.getObject('benefitData') || [];\nif (benefitData.length === 0) { Wb.send({}); }\nbenefitData.forEach(function (item) {\n  // 受益所有人数据 按照实时核验接口进行转换\n  // TODO 国籍\n  // 证件类型\n  item.name = item.related_name;\n  item.ntlty = item.ntlty; // 国籍转换 在select的时候就已经转换\n  item.birthDt = item.birthday;\n  item.idNb = item.id_no;\n  item.idTp = transIdTp(item.id_type); // 证件类型转换\n  if (item.bnf_type.includes('NA1') || item.bnf_type.includes('NB1')) {\n    item.actCtrl = 'Y';\n    item.actHdRat = item.acthdrat;\n    item.shareRatioStartDate = item.shareratiostartdate;\n    item.shareRatioEndDate = item.shareratioenddate;\n  } else {\n    item.actCtrl = 'N';\n  }\n  if (item.bnf_type.includes('NA3-1') || item.bnf_type.includes('NB3-1')) {\n    item.actCtrlCpny = '2'; // 协议形式\n    item.obtainActDate = item.obtainactdate;\n    item.terminationActDate = item.terminationactdate;\n    item.actConUpperMarket = item.actconuppermarket;\n    if (item.actconuppermarket === 'Y') {\n      item.actConUpperEntName = item.actconupperentname;\n      item.actConUniScid = item.actconuniscid;\n    }\n  } else if (item.bnf_type.includes('NA3-2') || item.bnf_type.includes('NB3-2')) {\n    item.actCtrlCpny = '3'; // 其他形式\n    item.obtainActDate = item.obtainactdate;\n    item.terminationActDate = item.terminationactdate;\n    item.actOtherForms = item.actotherforms;\n  }\n\n  // 收益权 表决权 \n  if (item.bnf_type.includes('NA2-1') || item.bnf_type.includes('NB2-1') || item.bnf_type.includes('NA2-2') || item.bnf_type.includes('NB2-2')) {\n    item.priBenfit = 'Y';\n    if (item.bnf_type.includes('NA2-1') || item.bnf_type.includes('NB2-1')) {\n      item.actOwnerProfitRatio = item.actownerprofitratio;\n      item.profitRatioStartDate = item.profitratiostartdate;\n      item.profitRatioEndDate = item.profitratioenddate;\n    }\n    if (item.bnf_type.includes('NA2-2') || item.bnf_type.includes('NB2-2')) {\n      item.actOwnerProfitRatioVote = item.actownerprofitratiovote;\n      item.profitRatioVoteStartDate = item.profitratiovotestartdate;\n      item.profitRatioVoteEndDate = item.profitratiovoteenddate;\n    }\n  } else {\n    item.priBenfit = 'N';\n  }\n\n  if (item.bnf_type.includes('NA4') || item.bnf_type.includes('NB4')) {\n    item.seniorMgr = 'Y';\n    item.seniorMgrPos = item.seniormgrpos.join(',');\n    if (item.seniormgrpos.includes('15')) {\n      item.actDailyMgmtPostOther = item.actdailymgmtpostother;\n    }\n  } else {\n    item.seniorMgr = 'N';\n  }\n\n  if (item.bnf_type.includes('NA5')) {\n    item.seniorMgrCN = 'Y';\n    item.seniorMgrPosCN = item.seniormgrposcn.join(',');\n    if (item.seniormgrposcn.includes('1')) {\n      item.ownerRightMgmtPostOther = item.ownerrightmgmtpostother;\n    }\n  } else {\n    item.seniorMgrCN = 'N';\n  }\n\n  if (item.bnf_type.includes('NI')) {\n    item.seniorMgr = 'Y';\n    item.seniorMgrPos = '10'; // 法定代表人\n  }\n});\n\nvar bomisRes = {};\n\n// 开始核验\nvar url = \"http://aml.gtht.com.cn:8080/ks/m?xwl=bomis/bo_onboarding_verify\";\n\nvar method = \"POST\";\nvar headers = new java.util.HashMap();\n\nvar token = \"YGTTEST20260302ADYTEXUXTUIRUT09\";\nvar key = \"ADYTEXUXTUIRUT09\";\nvar batchId = 'TH' + java.util.UUID.randomUUID().toString().replaceAll(\"-\", \"\");\n\nvar boicsBody = {\n  \"branchCode\": branchCode,\n  \"orgTp\": orgTp,\n  \"orgNm\": orgNm,\n  \"bolist\": benefitData,\n  \"uscc\": uscc,\n  \"branchName\": branchName\n};\nvar body = {\n  \"branch_no\": \"0040\", \"_token\": token, \"client_type\": \"1\", \"batchId\": batchId, \"uscc\": uscc,\n  \"body\": getBody(boicsBody, key),\n  \"client_name\": orgNm, \"client_id\": \"\"\n};\nvar encodeBody = Wb.encode(body);\n\nif (env === 'prod') {\n  var HttpUtil = Packages.cn.hutool.http.HttpUtil;\n  var Method = Packages.cn.hutool.http.Method;\n\n  var customRequest = HttpUtil.createRequest(Method.valueOf(method), url).addHeaders(headers).charset(\"UTF-8\").contentType(\"application/json\").body(encodeBody);\n  var customResponse = customRequest.execute().charset(\"UTF-8\");\n  bomisRes.request_info = {\n    \"branch_no\": \"\", \"_token\": token, \"client_type\": \"1\", \"batchId\": batchId,\n    \"body\": boicsBody,\n    \"client_name\": orgNm, \"client_id\": \"\"\n  };\n  bomisRes.response_info = customResponse.body();\n}\n\n// 核验结束\n\n\n// var now = new java.util.Date();\n// var sdf = new java.text.SimpleDateFormat(\"yyyy-MM-dd HH:mm:ss\");\n// var formatted = sdf.format(now);\n// bomisRes.response_info.op_time = formatted;\n\n\n// 将每次的核验结果存入 thjs.th_bomis_response\nvar sql = `\ninsert into thjs.th_bomis_response(op_user, client_id, client_name, request_info, response_info)\nvalues({?op_user?}, {?client_id?}, {?client_name?}, {?request_info?}, {?response_info?})\n`;\nvar sqlData = {\n  op_user: Wb.get('sys.username'),\n  client_id: client_id,\n  client_name: orgNm,\n  request_info: JSON.stringify(bomisRes.request_info),\n  response_info: JSON.stringify(bomisRes.response_info)\n};\nvar conn;\nvar rs;\ntry {\n  conn = Wb.getConn();\n\n  Wb.sql({\n    sql: sql,\n    params: sqlData,\n    trans: true,\n    commit: true\n  });\n\n\n  conn.commit();\n  // rs.O_RETURN_CODE = 0;\n  // rs.O_RETURN_MSG = \"执行成功\";\n} catch (e) {\n  // rs.O_RETURN_CODE = -1;\n  // rs.O_RETURN_MSG = \"保存失败：\" + e;\n  conn.rollback();\n} finally {\n  conn.close();\n  // Wb.send(bomisRes.response_info);\n}\n\nfunction transIdTp(th_key) {\n  var bomis_key = '';\n  if(th_key === '1') { bomis_key = '10'; }\n  if(th_key === '13') { bomis_key = '63'; }\n  if(th_key === '11') { bomis_key = '54'; }\n  if(th_key === '9') { bomis_key = '52'; }\n  if(th_key === '5') { bomis_key = '55'; }\n  if(th_key === '6') { bomis_key = '57'; }\n  if(th_key === '16') { bomis_key = '56'; }\n  if(th_key === '4') { bomis_key = '20'; }\n  if(th_key === '7') { bomis_key = '61'; }\n  if(th_key === '10') { bomis_key = '90'; }\n  if(th_key === '17') { bomis_key = '30'; }\n  if(th_key === '2') { bomis_key = '40'; }\n  if(th_key === '18') { bomis_key = '51'; }\n  if(th_key === '19') { bomis_key = '53'; }\n  if(th_key === '20') { bomis_key = '58'; }\n  if(th_key === '21') { bomis_key = '60'; }\n  if(th_key === '22') { bomis_key = '61'; }\n  if(th_key === '23') { bomis_key = '62'; }\n  return bomis_key;\n}\n\n//加密body参数\nfunction getBody(body1, key) {\n  var encrytData = encrypt(Wb.encode(body1), key);\n  return java.util.Base64.getEncoder().encodeToString(encrytData.getBytes(\"UTF-8\"));\n}\nfunction encrypt(content, key) {\n  if (Wb.isEmpty(key)) {\n    throw \"key不能为空\";\n  }\n  var raw = key.getBytes(\"utf-8\");\n  var skeySpec = new javax.crypto.spec.SecretKeySpec(raw, \"AES\");\n  var cipher = javax.crypto.Cipher.getInstance(\"AES/ECB/PKCS5Padding\");\n  cipher.init(javax.crypto.Cipher.ENCRYPT_MODE, skeySpec);\n  var encrypted = cipher.doFinal(content.getBytes(\"utf-8\"));\n  return new java.lang.String(java.util.Base64.getEncoder().encode(encrypted));\n}"
  },
  "_icon": "module"
}