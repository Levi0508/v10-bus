{"title":"保存审核详情","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"let batchList = Wb.decode(Wb.get('batchList'));\n\nlet insertSql = `insert into thjs.t_th_appr_detail\n(client_id,\naudit_id,\naudit_seq,\naudit_desc,\ndispose_desc,\ncreate_user,\ncreate_time\n)values(\n  {?CLIENT_ID?},\n  {?AUDIT_ID?},\n  {?AUDIT_SEQ?},\n  {?AUDIT_DESC?},\n  {?DISPOSE_DESC?},\n  {?CREATE_USER?},\n  sysdate)`;\n\nfor (let i = 0; i < batchList.length; i++) {\n  Wb.sql({\n    sql: insertSql,\n    contextParams: false,\n    params: {\n      CLIENT_ID: batchList[i].CLIENT_ID,\n      AUDIT_ID: batchList[i].AUDIT_ID,\n      AUDIT_SEQ: batchList[i].AUDIT_SEQ,\n      AUDIT_DESC: batchList[i].AUDIT_DESC,\n      DISPOSE_DESC: batchList[i].DISPOSE_DESC,\n      CREATE_USER: batchList[i].CREATE_USER,\n    }\n  })\n}"},"_icon":"module"}