{"title":"机构/自然人主体登记提交","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"let batchList = Wb.decode(Wb.get('batchList'));\n\n// 新增关联人统一插入临时表 当保存客户信息时才会存入到关联人正式表\nlet insertSql = `\nINSERT INTO thjs.t_th_relat_info_tmp (CLIENT_ID, RELATED_TYPE, RELATED_NAME, ORGAN_FLAG, ID_TYPE, ID_NO, ID_BEGINDATE, ID_ENDDATE,\n  NATIONALITY, BIRTHDAY, IS_GOVERNMENT_DEPT, BENEFICIARY, SHAREHOLDING_RATIO, ADDRESS, MOBNO1, OBJECT_ID, CREATE_USER, CREATE_TIME, UPDATE_USER, UPDATE_TIME, DATA_STATUS\n) VALUES (\n  {?CLIENT_ID?}, {?RELATED_TYPE?}, {?RELATED_NAME?}, {?ORGAN_FLAG?}, {?ID_TYPE?}, {?ID_NO?}, {?ID_BEGINDATE?}, {?ID_ENDDATE?}, \n  {?NATIONALITY?}, {?BIRTHDAY?}, {?IS_GOVERNMENT_DEPT?}, {?BENEFICIARY?}, {?SHAREHOLDING_RATIO?}, {?ADDRESS?}, {?MOBNO1?}, {?OBJECT_ID?}, {?CREATE_USER?}, sysdate, {?UPDATE_USER?}, sysdate, '0'\n);\n`;\nfor (let i = 0; i < batchList.length; i++) {\n  Wb.sql({\n    sql: insertSql,\n    contextParams: false,\n    params: {\n      CLIENT_ID: batchList[i].CLIENT_ID,\n      RELATED_TYPE: batchList[i].RELATED_TYPE,\n      RELATED_NAME: batchList[i].RELATED_NAME,\n      ORGAN_FLAG: batchList[i].ORGAN_FLAG,\n      ID_TYPE: batchList[i].ID_TYPE,\n      ID_NO: batchList[i].ID_NO,\n      ID_BEGINDATE: batchList[i].ID_BEGINDATE,\n      ID_ENDDATE: batchList[i].ID_ENDDATE,\n      NATIONALITY: batchList[i].NATIONALITY,\n      BIRTHDAY: batchList[i].BIRTHDAY,\n      IS_GOVERNMENT_DEPT: batchList[i].IS_GOVERNMENT_DEPT,\n      BENEFICIARY: batchList[i].BENEFICIARY,\n      SHAREHOLDING_RATIO: batchList[i].SHAREHOLDING_RATIO,\n      ADDRESS: batchList[i].ADDRESS,\n      MOBNO1: batchList[i].MOBNO1,\n      OBJECT_ID: batchList[i].OBJECT_ID,\n      CREATE_USER: batchList[i].CREATE_USER,\n      UPDATE_USER: batchList[i].UPDATE_USER\n    }\n  })\n}"},"_icon":"module"}