tput","autoScroll":"true","layout":"column","flex":"1","border":"1","roundBorder":"true"},"_expanded":true,"hasDupCid":1,"items":[{"_icon":"panel","text":"panelOutputMain","cls":"Wb.Panel","properties":{"cid":"panelOutputMain","autoScroll":"true","height":"40vh","border":"1","layout":"row","flex":"1"},"_expanded":true,"hasDupCid":1,"items":[{"_icon":"grid","text":"gridMain","cls":"Wb.Grid","properties":{"cid":"gridMain","url":"@xpath + '/actions&xaction=selectTableColumn'","columnsSortable":"true","multiSelect":"true","flex":"1","border":"false","autoLoad":"false","pageSize":"-1","textSelectable":"true","editable":"true"},"_expanded":true,"events":{"headerclick":"//排序执行2\ntd = e.target.closest('td') ;\ncolItem = td?.colItem;\nname = colItem?.fieldName;\napp.gridSort(this,colItem, td, e,name,'local');","beforeload":"let grid = this, saveBtn = app.btnSaveTable,cancelBtn=app.btnCancelTable;\n//saveBtn is null before initialized\nif (!cancelBtn.disabled && saveBtn && !saveBtn.disabled) {\n  Wb.choose(Str.modifiedConfirm.format(Str.list), btn => {\n    if (btn == 'yes')\n      app.saveTable(f => grid.reload());\n    else if (btn == 'no') {\n      saveBtn.disabled = true;\n      cancelBtn.disabled = true;\n      grid.reload();\n    }\n  });\n  return false;\n}","itemchange":"app.onTableChange();","editing":"app.onTableChange();\n","beforeedit":"if (this.selectionData.if_locked=='1' )\n{\n  return false;\n}"},"hasDupCid":0,"items":[{"_icon":"toolbar","text":"tbar","cls":"Wb.Toolbar","properties":{"cid":"tbar","isProperty":"true","layout":"row","justify":"start"},"hasDupCid":0,"_expanded":true,"items":[{"_icon":"item","text":"btnColumnRefresh","cls":"Wb.Item","_expanded":false,"properties":{"cid":"btnColumnRefresh","icon":"loading3","text":"刷新"},"events":{"click":"Wb.ajax({\n  url: xpath + '/actions&xaction=refreshColumns',\n  json: true,\n  success() {\n    Wb.tip('字段库刷新成功');\n  },\n  failure(resp) { \n    Wb.error(resp);\n  }\n});"},"hasDupCid":0},{"_icon":"item","text":"btnAddColumn","cls":"Wb.Item","_expanded":false,"properties":{"cid":"btnAddColumn","text":"@Str.add","icon":"add"},"events":{"click":"let grid = app.gridMain;\n//表格选中的记录,是个数组\nlet recs = grid.selections;\n//没有选择记录,需进行提示\nif (!recs.length) {\n  Wb.tipSelect();\n  return;\n}\nif (grid.selectionData.if_locked=='1')\n{\n  Wb.warn('当前记录已锁,无法编辑');\n}else{\n  \n  app.onTableChange();\n  app.gridMain.addRecord({\n    \"owner\":recs[0].data.owner,\n    \"table_name\":recs[0].data.table_name,\n    \"table_comments\":recs[0].data.table_comments,\n  });\n}\n\n\n"},"hasDupCid":0},{"_icon":"item","text":"btnDelColumn","cls":"Wb.Item","_expanded":true,"properties":{"cid":"btnDelColumn","text":"@Str.del","icon":"delete","keys":"Ctrl+D"},"events":{"click":"let grid = app.gridMain;\n//表格选中的记录,是个数组\nlet recs = grid.selections;\n//没有选择记录,需进行提示\nif (recs.length!=1) {\n  Wb.warn('请选择一条记录');\n  return;\n}\nif (grid.selectionData.if_locked=='1')\n{\n  Wb.warn('当前记录已锁,无法编辑');\n}else{\n  if (grid.selectionData.table_type=='VIEW'){\n    Wb.warn(\"视图不支持删除字段\");\n    return;\n  }\n  grid.delRecords();\n}"},"hasDupCid":0},{"_icon":"item","text":"btnSaveTable","cls":"Wb.Item","_expanded":false,"properties":{"cid":"btnSaveTable","icon":"save","text":"@Str.save","keys":"Ctrl+S","disabled":"true"},"events":{"click":"app.saveTable(f => app.btnQ.fireClick());\n"},"hasDupCid":0},{"_icon":"item","text":"btnCancelTable","cls":"Wb.Item","_expanded":false,"properties":{"cid":"btnCancelTable","text":"@Str.cancel","icon":"cancel","disabled":"true"},"events":{"click":"app.btnCancelTable.disabled = true;\napp.btnSaveTable.disabled=true;\napp.btnQ.fireClick();\n"},"hasDupCid":0},{"_icon":"divider","text":"divider1","cls":"Wb.Divider","properties":{"cid":"divider1"},"hasDupCid":0},{"_icon":"split","text":"columnItem","cls":"Wb.SplitButton","properties":{"cid":"columnItem","icon":"column","text":"字段操作"},"_expanded":true,"items":[{"cls":"Wb.Menu","properties":{"cid":"menu","isProperty":"true"},"text":"menu","_expanded":true,"_icon":"menu2","hasDupCid":0,"items":[{"_icon":"item","text":"btnColumnDuplicateData","cls":"Wb.Item","_expanded":true,"properties":{"cid":"btnColumnDuplicateData","icon":"search","text":"多字段查重"},"events":{"click":"let grid = app.gridMain;\n//表格选中的记录,是个数组\nlet recs = grid.selections;\n//没有选择记录,需进行提示\nif (!recs.length) {\n  Wb.tipSelect();\n  return;\n}\n\nlet columnList =[];\nlet tableList =[];\nrecs.each((item, index) => { \n  \n  if (!columnList.includes(item.data.column_name)){\n    columnList.push(item.data.column_name);\n  }\n  if (!tableList.includes(item.data.owner+'.'+item.data.table_name)){\n    tableList.push(item.data.owner+'.'+item.data.table_name);\n  }  \n  \n});\nif (tableList.length>1){\n  Wb.warn('只能单表查询');\n  return false;\n}\n\nlet win = app.winColumnQ;\n\nwin.title='表字段：'+tableList.join(',')+'.'+columnList.join(',')+' 查询';\napp.i_query_table.value=tableList.join(',');\napp.i_query_column.value=columnList.join(',');\n\nif (recs[0].data.date_column){\n  app.i_date_column.value=recs[0].data.date_column;\n  app.i_date_column.show();\n  app.i_query_date.show();\n  app.i_date_column.required=true;\n  app.i_query_date.required=true;\n}else{\n  app.i_date_column.hide();\n  app.i_date_column.value='';\n  app.i_query_date.hide();\n  app.i_query_date.value='';\n  app.i_date_column.required=false;\n  app.i_query_date.required=false;\n}\napp.i_query_type.value={k:'3',v:'字段查重'};\n\n\nwin.focusControl = true;\n//模态窗口\nwin.modal=true;\napp.gridColumnQ.setData(null);\nwin.show();\nwin.scrollEl.scrollTop = win.scrollEl.scrollLeft = 0;\n"},"hasDupCid":0},{"_icon":"item","text":"btnColumnComments","cls":"Wb.Item","_expanded":false,"properties":{"cid":"btnColumnComments","icon":"edit","text":"批量改注释"},"events":{"click":"let grid = app.gridMain;\n//表格选中的记录,是个数组\nlet recs = grid.selections;\n//没有选择记录,需进行提示\nif (!recs.length) {\n  Wb.tipSelect();\n  return;\n}\n\nlet win = app.winEditColumn;\nlet columnList =[];\nlet tableList =[];\nrecs.each((item, index) => { \n  \n  if (!columnList.includes(item.data.column_name) && item.data.if_locked=='0'){\n    columnList.push(item.data.column_name);\n  }\n  if (!tableList.includes(item.data.owner+'.'+item.data.table_name) && item.data.if_locked=='0'){\n    tableList.push(item.data.owner+'.'+item.data.table_name);\n  }  \n  \n});\n\nif (tableList.length==0){\n  Wb.warn('所有表已锁，不可操作');\n  return false;\n}\napp.checkToUpgrade.hide();\napp.I_DICT_CODE.hide();\napp.I_COLUMN_DATA_DEFAULT.hide();\napp.I_COLUMN_DATA_TYPE.hide();\napp.I_COLUMN_COMMENTS.show();\napp.O_ColumnSQL.hide();\napp.I_EDIT_TYPE.value='COLUMN_COMMENTS'\napp.I_COLUMN_NAME.value=columnList.join(',');\napp.I_TABLE_LIST.value=tableList.join('\\n');\napp.I_COLUMN_COMMENTS.value=recs[0].data.column_comments;\n\nwin.icon = 'edit';\nwin.title = Str.edit;\nwin.focusControl = null;\nwin.okHandler = (win, values) => {\n  Wb.ajax({\n    url: xpath + '/actions&xaction=editColumn',\n    params: values,\n    json: true,\n    success(resp) {\n      if (resp.o_return_code=='0'){\n          Wb.tip('执行成功');\n          win.hide();\n          app.btnQ.fireClick();\n      }else{\n        Wb.error(resp.o_return_msg);\n      }\n    },\n    failure(resp) { \n      Wb.error(resp);\n    }\n  });\n};\nwin.show();\nwin.scrollEl.scrollTop = win.scrollEl.scrollLeft = 0;\n"},"hasDupCid":0},{"_icon":"item","text":"btnColumnDataType","cls":"Wb.Item","_expanded":false,"properties":{"cid":"btnColumnDataType","icon":"edit","text":"批量改类型"},"events":{"click":"let grid = app.gridMain;\n//表格选中的记录,是个数组\nlet recs = grid.selections;\n//没有选择记录,需进行提示\nif (!recs.length) {\n  Wb.tipSelect();\n  return;\n}\n\nlet win = app.winEditColumn;\nlet columnList =[];\nlet tableList =[];\nrecs.each((item, index) => { \n  \n  if (!columnList.includes(item.data.column_name) && item.data.if_locked=='0'){\n    columnList.push(item.data.column_name);\n  }\n  if (!tableList.includes(item.data.owner+'.'+item.data.table_name) && item.data.if_locked=='0'){\n    tableList.push(item.data.owner+'.'+item.data.table_name);\n  }  \n  \n});\n\nif (tableList.length==0){\n  Wb.warn('所有表已锁，不可操作');\n  return false;\n}\n\napp.checkToUpgrade.show();\napp.I_DICT_CODE.hide();\napp.I_COLUMN_DATA_DEFAULT.hide();\napp.I_COLUMN_DATA_TYPE.show();\napp.I_COLUMN_COMMENTS.hide();\napp.O_ColumnSQL.show();\napp.I_EDIT_TYPE.value='COLUMN_DATA_TYPE'\napp.I_COLUMN_NAME.value=columnList.join(',');\napp.I_TABLE_LIST.value=tableList.join('\\n');\napp.I_COLUMN_DATA_TYPE.value=recs[0].data.data_type;\n\nwin.icon = 'edit';\nwin.title = Str.edit;\nwin.focusControl = null;\nwin.okHandler = (win, values) => {\n  Wb.ajax({\n    url: xpath + '/actions&xaction=editColumn',\n    params: values,\n    json: true,\n    success(resp) {\n      if (resp.o_return_code=='0'){\n        if (app.checkToUpgrade.value==true){\n          Wb.tip('执行成功');\n          win.hide();\n          app.btnQ.fireClick();\n        }else{\n          app.O_ColumnSQL.value=resp.o_return_msg;\n        }\n        \n      }else{\n        Wb.error(resp.o_return_msg);\n      }\n    },\n    failure(resp) { \n      Wb.error(resp);\n    }\n  });\n};\nwin.show();\nwin.scrollEl.scrollTop = win.scrollEl.scrollLeft = 0;\n"},"hasDupCid":0},{"_icon":"item","text":"btnColumnDataDefault","cls":"Wb.Item","_expanded":true,"properties":{"cid":"btnColumnDataDefault","icon":"edit","text":"批量改默认值"},"events":{"click":"let grid = app.gridMain;\n//表格选中的记录,是个数组\nlet recs = grid.selections;\n//没有选择记录,需进行提示\nif (!recs.length) {\n  Wb.tipSelect();\n  return;\n}\n\nlet win = app.winEditColumn;\nlet columnList =[];\nlet tableList =[];\nrecs.each((item, index) => { \n  \n  if (!columnList.includes(item.data.column_name) && item.data.if_locked=='0'){\n    columnList.push(item.data.column_name);\n  }\n  if (!tableList.includes(item.data.owner+'.'+item.data.table_name) && item.data.if_locked=='0'){\n    tableList.push(item.data.owner+'.'+item.data.table_name);\n  }  \n  \n});\n\nif (tableList.length==0){\n  Wb.warn('所有表已锁，不可操作');\n  return false;\n}