eAll(`;\n`,`';\n`);\nsql=sql.replaceAll('create table ',\"execute immediate 'create table \");\nsql=sql.replaceAll('comment on ',\"execute immediate 'comment on \");\nsql=sql+`execute immediate 'insert into APP.TB_COLUMNS(OWNER, TABLE_NAME, TABLE_FULL_NAME,TABLE_COMMENTS, COLUMN_NAME, COLUMN_COMMENTS, DATA_TYPE, DATA_PRECISION, DATA_SCALE, COLUMN_ID, TABLE_TYPE, DATA_DEFAULT, DICT_ENTRY, IF_LOCKED, NOT_NULL, PRIMARY_KEY, DATA_SOURCE, SYNONYM_TABLE, IF_HIS, DATE_COLUMN, MODIFY_HISTORY) \n            select OWNER, TABLE_NAME,OWNER||''.''||TABLE_NAME, TABLE_COMMENTS, COLUMN_NAME, COLUMN_COMMENTS, DATA_TYPE, DATA_PRECISION, DATA_SCALE, COLUMN_ID, TABLE_TYPE, DATA_DEFAULT, DICT_ENTRY, IF_LOCKED, NOT_NULL, PRIMARY_KEY, DATA_SOURCE, SYNONYM_TABLE, IF_HIS, DATE_COLUMN, MODIFY_HISTORY\n            from   app.vw_columns\n            where  OWNER||''.''||TABLE_NAME=''`+tableName+`''';`;\nsql=`begin\n`+sql+`\nend;`;\nWb.open({\n    url:'dbe',\n    container:true,\n    success(scope){\n      scope.addSql(sql,'dm8',true);\n    }\n  });"}},{"_icon":"button","text":"btnSetTable","cls":"Wb.Button","_expanded":true,"properties":{"cid":"btnSetTable","justifySelf":"end","text":"设置属性","type":"primary","width":"100","border":"true","alignSelf":"end","margin":"true"},"events":{"click":"let win = app.winTableProps;\nlet table_name =app.textCreateCode.value.toUpperCase().getPart('CREATE TABLE ', '(');\nif (!table_name.firstItem('.') || !table_name.afterItem('.')) {\n  Wb.warn('无效表名');\n  return false;\n}\napp.i_owner_P.value=table_name.firstItem('.');\napp.i_table_name_P.value=table_name.afterItem('.');\napp.i_data_source_P.value='';\napp.i_date_column_P.value='';\napp.i_if_his_P.value='';\nwin.focusControl = true;\n//模态窗口\nwin.modal=true;\nwin.okHandler = (win, values) => {\n  Wb.ajax({\n    url: xpath + '/actions&xaction=editTableProps',\n    params: values,\n    json: true,\n    success() {\n      Wb.tip('操作成功');\n      win.hide();\n      Wb.ajax({\n        url: xpath + '/actions&xaction