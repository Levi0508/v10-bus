{"title":"表字段管理","icon":"item","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"// serverScript是页面初始化的时候就执行的代码\n// 这里的Params.queryObject是跳转页面点击跳转地址传递过来的 查询表名参数\nlet queryObject = Params.queryObject;\n//Wb.log(\"你好\");\n//Wb.log(queryObject);\n// Wb.set()方法将参数传递给了initialize方法中\nif(queryObject) {\n  Wb.set({ queryObject: Wb.encode(queryObject) });\n} else {\n  Wb.set({ queryObject: Wb.encode('') });\n}"},"_icon":"module","_expanded":true,"events":{"initialize":"Wb.apply(app, {\n  queryObject: _$queryObject$_,\n  onCreateChange() {\n    app.btnSaveCreate.disabled = false;\n    app.btnCancelCreate.disabled = false;\n  },\n  onTableChange() {\n    app.btnSaveTable.disabled = false;\n    app.btnCancelTable.disabled=false;\n  },\n  onDataSourceChange() {\n    app.btnSave.disabled = false;\n    app.btnCancel.disabled=false;\n  },\n  saveCreate(callback) {\n    app.gridCreateTable.sync({\n      url: xpath + '/actions&xaction=saveCreate',\n      success() {\n        app.btnSaveCreate.disabled = true;\n        app.btnCancelCreate.disabled = true;\n        callback?.();\n      },\n      failure(resp) {\n        if (resp?.toLowerCase().includes('tb_temp_table_create'))\n          Wb.error(Str.duplicate.format(Str.code));\n      }\n    });\n  },\n  saveTable(callback) {\n    app.gridMain.sync({\n      url: xpath + '/actions&xaction=saveTable',\n      success(resp) {\n        \n        app.btnSaveTable.disabled = true;\n        app.btnCancelTable.disabled=true;\n        callback?.();\n      },\n      failure(resp) {\n          Wb.error(resp);\n      }\n    });\n  },\n  saveDataSource(callback) {\n    app.gridDataSource.sync({\n      url: xpath + '/actions&xaction=saveDataSource',\n      success(resp) {\n        \n        app.btnSave.disabled = true;\n        app.btnCancel.disabled=true;\n        callback?.();\n      },\n      failure(resp) {\n          Wb.error(resp);\n      }\n    });\n  },\n  gridSort(me,colItem, td, e, name, sortType){\n    //排序执行3\n    if (name && me.columnsSortable && colItem.sortable) {\n      let sorter;\n      if (me.clickHeaderRipple)\n        td.rippleEffect(e.x, e.y);\n       sorter = me.sorterList?.find(item => item.name == name);\n      me.sorters = { name, desc: sorter?(!sorter.desc):false };\n      Wb.log('排序方式:'+sortType+',排序列:'+name);\n      if (sortType=='local'){\n        if (me.fireEvent('beforesort', me.data, me.sorters) !== false) {\n          let keys = [], desc = [];\n          keys.push(me.sorters.name);\n          desc.push(me.sorters.desc);\n          me.data = me.data.mixSort(keys, desc);\n        }\n      }else{\n        if (me.fireEvent('beforesort', me.data, me.sorters) !== false){\n          me.reload();\n        }\n      }\n    }\n  },\n});\nWb.Grid.prototype.onHeaderClick = function(e) {\n  //排序执行1\n  let me = this, td = e.target.closest('td'), colItem = td?.colItem, name = colItem?.fieldName;\n  me.fireEvent('headerclick', colItem, td, e, name);\n}\n","beforeunload":"if (!app.btnSaveTable.disabled||!app.btnSaveCreate.disabled||!app.btnSave.disabled)\n  return false;","finalize":"if (app.queryObject!=''){\n  app.i_table_search.value=app.queryObject;\n  app.btnQ.fireClick();\n}"},"items":[{"_icon":"viewport","text":"viewport1","cls":"Wb.Viewport","properties":{"cid":"viewport1","padding":".7em","gap":".7em","background":"true"},"_expanded":true,"items":[{"_icon":"label","text":"label1","cls":"Wb.Label","_expanded":true,"properties":{"cid":"label1","text":"表字段管理","titleType":"title3"},"hasDupCid":0},{"_icon":"panel","text":"panelInput","cls":"Wb.Panel","properties":{"cid":"panelInput","layout":"column","roundBorder":"true","padding":"true","gap":"true","shrink":"true"},"_expanded":true,"hasDupCid":1,"items":[{"_icon":"container","text":"container1","cls":"Wb.Container","properties":{"cid":"container1","layout":"row","gap":"true"},"hasDupCid":1,"_expanded":true,"items":[{"_icon":"combo","text":"i_data_source","cls":"Wb.Select","properties":{"cid":"i_data_source","url":"@xpath + '/../DictMapManage/actions&xaction=selectSourceList'","textField":"source_name","valueField":"source_code","noWrap":"true","text":"源系统","labelWidth":"80","clearButton":"true","width":"300"},"events":{"select":"app.i_project_id.clear();\napp.i_table_search.clear();\napp.i_column_search.clear();\napp.btnQ.fireClick();\n","clearclick":"app.btnQ.fireClick();"},"hasDupCid":0,"_expanded":true,"items":[{"cls":"Wb.Item","events":{"click":"let win = app.winEditDataSource;\napp.i_data_source_D.value=[this.parent.value,this.parent.lastInputValue];\nwin.focusControl = true;\nwin.title='数据源管理'\n//模态窗口\nwin.modal=true;\nwin.show();\napp.btnDSQ.fireClick();\nwin.scrollEl.scrollTop = win.scrollEl.scrollLeft = 0;"},"properties":{"cid":"triggers","icon":"data-provider","tip":"数据源管理"},"text":"triggers","_expanded":true,"_icon":"item","hasDupCid":0}]},{"_icon":"combo","text":"i_data_topic","cls":"Wb.Select","properties":{"cid":"i_data_topic","noWrap":"true","text":"主题","labelWidth":"60","clearButton":"true","width":"200","loadOnce":"true","keyName":"DATA_TOPIC"},"events":{"select":"app.btnQ.fireClick();\n","clearclick":"app.btnQ.fireClick();"},"hasDupCid":0},{"_icon":"combo","text":"i_table_search","cls":"Wb.Select","properties":{"cid":"i_table_search","url":"@xpath + '/actions&xaction=selectTableList'","textField":"table_comments","valueField":"table_name","noWrap":"true","text":"表","labelWidth":"60","clearButton":"true","loadOnce":"false","flex":"1"},"events":{"select":"Wb.ajax({\n  url: xpath + '/actions&xaction=refreshColumns',\n  params:{\n    i_table_name:app.i_table_search.value.afterItem('.'),\n  },\n  json: true,\n  success() {\n    app.btnQ.fireClick();\n  },\n  failure(resp) { \n    Wb.error(resp);\n    app.btnQ.fireClick();\n  }\n});\n\n","clearclick":"app.btnQ.fireClick();","beforeload":"params.i_project_id=app.i_project_id.value;\nparams.i_data_source=app.i_data_source.value;"},"hasDupCid":0,"_expanded":true},{"_icon":