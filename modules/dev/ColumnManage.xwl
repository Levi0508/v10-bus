.save","keys":"Ctrl+S","disabled":"true"},"events":{"click":"app.saveCreate(f => app.btnCQ.fireClick());"},"hasDupCid":0},{"_icon":"item","text":"btnCancelCreate","cls":"Wb.Item","_expanded":false,"properties":{"cid":"btnCancelCreate","text":"@Str.cancel","icon":"cancel","disabled":"true"},"events":{"click":"app.btnCancelCreate.disabled = true;\napp.btnSaveCreate.disabled=true;\napp.btnCQ.fireClick();\n"},"hasDupCid":0},{"_icon":"container","text":"container1","cls":"Wb.Container","_expanded":true,"properties":{"cid":"container1","justify":"end","flex":"1"},"hasDupCid":1,"items":[{"_icon":"button","text":"btnCQ","cls":"Wb.Button","properties":{"cid":"btnCQ","text":"查询","visible":"false","type":"primary","shrinkSelf":"false","icon":"search","alignSelf":"end","margin":"false","justifySelf":"end"},"events":{"click":"let selectedItem=app.gridCreateTable.selectionData?.pk_id;\n\napp.gridCreateTable.load({\n  params: {\n    I_TABLE_CREATE: app.I_TABLE_CREATE.value,\n  }, \n  success(){\n    app.gridCreateTable.data.forEach((item,index) => {\n      if (item.pk_id==selectedItem){\n        app.gridCreateTable.items[index].selected=true;\n      }\n    });\n  },\n});\nWb.ajax({\n  url: xpath + '/actions&xaction=selectCreateTableSql',\n  //传参数\n  params: { \n    I_TABLE_CREATE: app.I_TABLE_CREATE.value.toUpperCase(),\n    I_DATABASE_TYPE: app.I_DATABASE_TYPE.value,\n  },\n  json: true,\n  success(resp) {\n    if (resp.o_return_code=='0'){\n      app.textCreateCode.setValue(resp.o_return_msg);\n    }else{\n      Wb.error(resp.o_return_msg);\n    }\n  },\n  failure(resp) { \n    Wb.error(resp);\n  }  \n});\n"},"_expanded":false,"hasDupCid":0}]}]},{"_icon":"array","text":"columns","cls":"Wb.Array","properties":{"cid":"columns"},"_expanded":true,"hasDupCid":1,"items":[{"cls":"Wb.Column","properties":{"cid":"rowNumCol","rowNum":"true"},"text":"rowNumCol","_expanded":true,"_icon":"column","hasDupCid":1},{"_icon":"column","text":"OWNERCol","cls":"Wb.Column","properties":{"cid":"OWNERC