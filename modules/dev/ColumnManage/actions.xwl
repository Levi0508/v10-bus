{"title":"","icon":"","img":"","tags":"","hideInMenu":"true","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"let actions = {\n  //查询表字段\n  selectTableColumn() {\n    let result=Wb.sql({\n      sql: `select sql_str from app.vw_call_sp_sql_str where sp_name='APP.PR_TABLE_COLUMN_Q'`, \n      db: 'dm8' \n    });\n    result = Wb.sql({\n      sql: result.items[0].sql_str, \n      params: {\n        i_if_modified_recently: Params.i_if_modified_recently,\n        i_table_search: Params.i_table_search,\n        i_column_search: Params.i_column_search,\n        i_project_id: Params.i_project_id,\n        i_data_source: Params.i_data_source,\n        i_table_type: Params.i_table_type,\n      }, \n      db: 'dm8', \n      //paging: true,\n      //rs:200\n    })\n    if (result.o_return_code==0){\n      Wb.send(result.rt_cursor);\n    }else{\n      Wb.send({\n        o_return_code:result.o_return_code,\n        o_return_msg:result.o_return_msg\n      });\n    }\n  },\n  //查询待创建表字段\n  selectCreateTableColumn() {\n    let result=Wb.sql({\n      sql: `select sql_str from app.vw_call_sp_sql_str where sp_name='APP.PR_TABLE_CREATE_Q'`, \n      db: 'dm8' \n    });\n    result = Wb.sql({\n      sql: result.items[0].sql_str, \n      params: {\n        i_table_create: Params.I_TABLE_CREATE,\n        \n      }, \n      db: 'dm8' \n    })\n    if (result.o_return_code==0){\n      Wb.send(result.rt_cursor);\n    }else{\n      Wb.send({\n        o_return_code:result.o_return_code,\n        o_return_msg:result.o_return_msg\n      });\n    }\n  },\n  //查询待创建表脚本\n  selectCreateTableSql() {\n    let result=Wb.sql({\n      sql: `select sql_str from app.vw_call_sp_sql_str where sp_name='APP.PR_TABLE_CREATE_SQL_Q'`, \n      db: 'dm8' \n    });\n    result = Wb.sql({\n      sql: result.items[0].sql_str, \n        params: {\n          i_table_create: Params.I_TABLE_CREATE,\n          i_database_type: Params.I_DATABASE_TYPE,\n        },  \n        db: 'dm8' \n      });\n      Wb.send({\n        o_return_code:result.o_return_code,\n        o_return_msg:result.o_return_msg\n      });\n  },\n  //查询字典码值\n  selectDictValue() {\n    if (Params.I_DICT_CODE.contains('.')){\n      Wb.sendRows({\n        sql: `select data_source||'.'||source_dict as dict_code,dict_name,source_key as K,source_value as V \n                from app.vw_source_dict \n               where data_source||'.'||source_dict={?I_DICT_CODE?} or {?I_DICT_CODE?} is null`, \n          params: {\n            I_DICT_CODE: Params.I_DICT_CODE,\n            \n          },  \n          db: 'dm8' \n      });\n    }else{\n      Wb.sendRows({\n        sql: 'select * from app.VW_DICT where DICT_CODE={?I_DICT_CODE?} or {?I_DICT_CODE?} is null', \n          params: {\n            I_DICT_CODE: Params.I_DICT_CODE,\n            \n          },  \n          db: 'dm8' \n      });\n    }\n    \n  },\n  //查询表清单\n  selectTableList() {\n    Wb.sendRows({\n      sql:`select distinct table_name, table_full_name||'-'||table_comments as table_comments,table_full_name as table_name_full from app.tb_columns a \n           where ((exists(select 1 from app.tb_project_tab_view_list b where b.project_id={?i_project_id?} and b.tab_view_name=a.table_full_name) or {?i_project_id?} is null) )\n           and   (a.data_source={?i_data_source?} or {?i_data_source?} is null)\n           and   (instr(upper(a.table_full_name||'-'||a.table_comments),upper({?query?}))>0 or instr(upper(a.SYNONYM_TABLE||'-'||table_comments),upper({?query?}))>0 or {?query?} is null) \n           order by table_comments\n          `,\n      db:'dm8'\n    });\n  },\n  //查询待创建表清单\n  selectCreateTableList() {\n    Wb.sendRows({\n      sql:\"select distinct owner||'.'||table_name as table_name, owner||'.'||table_name||'-'||table_comments as table_comments from app.tb_temp_table_create order by table_comments\",\n      db:'dm8'\n    });\n  },\n  //查询字段清单\n  selectColumnList() {\n    Wb.sendRows({\n      sql:`select column_name, case when a.data_source='FLHGDB' then '★' end||column_name||'-'||column_comments||' '||data_type as column_comments,count(1) as cnt from app.tb_columns a\n           where (exists(select 1 from app.tb_project_tab_view_list b where b.project_id={?i_project_id?} and b.tab_view_name=a.table_full_name) or {?i_project_id?} is null)\n           and   (a.data_source={?i_data_source?} or {?i_data_source?} is null)\n           and   (column_name={?i_column_name?} or {?i_column_name?} is null)\n           and   (instr(upper(case when a.data_source='FLHGDB' then '★' end||column_name||'-'||column_comments||' '||data_type),upper({?query?}))>0 or {?query?} is null) \n           and   (table_name={?i_table_name?} or {?i_table_name?} is null)\n           and   a.table_type='TABLE'\n           and   a.table_name not like 'TMP%'\n           group by column_name, case when a.data_source='FLHGDB' then '★' end||column_name||'-'||column_comments||' '||data_type\n           order by column_name,cnt desc\n          `,\n      db:'dm8'\n    });\n  },\n  //查询字典清单\n  selectDictList() {\n    Wb.sendRows({\n      sql:`select distinct dict_code, dict_code||'-'||dict_name||'('||key_name||')' as dict_name \n             from app.tb_dict \n            where (instr(upper(dict_code||'-'||dict_name||'('||key_name||')'),upper({?i_dict?}))>0 or {?i_dict?} is null)\n            union all\n            select distinct data_source||'.'||source_dict,source_dict||'-'||dict_name from app.vw_source_dict\n            where data_source={?i_data_source?}\n            and   (instr(upper(source_dict||'-'||dict_name),upper({?i_dict?}))>0 or {?i_dict?} is null)\n            order by dict_code`,\n      params: {\n          i_dict: Params.i_dict,\n          i_data_source: Params.i_data_source,\n        },  \n      db:'dm8'\n    });\n  },\n  //查询字段枚举值\n  selectColumnData() {\n    let result=Wb.sql({\n      sql: `select sql_str from app.vw_call_sp_sql_str where sp_name='APP.PR_COLUMN_DATA_Q'`, \n      db: 'dm8' \n    });\n    result = Wb.sql({\n      sql: result.items[0].sql_str, \n        params: {\n          i_query_type: Params.i_query_type,\n          i_query_table: Params.i_query_table,\n          i_query_column: Params.i_query_column,\n          i_date_column: Params.i_date_column,\n          i_query_date: Params.i_query_date,\n          i_query_sql: Params.i_query_sql,\n        },  \n        db: 'dm8' \n      });\n      if (result.o_return_code==0){\n        Wb.send(result.rt_cursor);\n      }else{\n        Wb.send({\n          o_return_code:result.o_return_code,\n          o_return_msg:result.o_return_msg\n        });\n      }\n  },\n  //保存数据源设置\n  saveDataSource() {\n    Params.update?.forEach(function(row){\n\n      Wb.sql({\n        sql: `update app.tb_data_source a \n              set a.source_name={?i_source_name?},\n                  a.remark={?i_remark?}\n              where a.source_code={?i_source_code?} ` ,\n        params: {\n          i_source_code: row.$source_code,\n          i_source_name: \"source_name_original\" in row?row.source_name_original:row.$source_name_original,\n          i_remark: \"remark\" in row?row.remark:row.$remark,\n        }, \n        db: 'dm8' \n      });\n    });\n\n    Params.insert?.forEach(function(row){\n\n      Wb.sql({\n        sql: 'insert into app.tb_data_source (source_code,source_name,remark) values({?i_source_code?},{?i_source_name?},{?i_remark?})', \n        params: {\n          i_source_code: row.source_code,\n          i_source_name: row.source_name_original,\n          i_remark: row.remark\n        }, \n        db: 'dm8' \n      });\n    });\n\n  },\n  //保存待创建表字段设置\n  saveCreate() {\n    Params.del?.forEach(function(row){\n\n      Wb.sql({\n        sql: `delete from app.tb_temp_table_create a where a.pk_id={?i_pk_id?} `, \n        params: {\n          i_pk_id: row.$pk_id\n        }, \n        db: 'dm8' \n      });\n    });\n\n    Params.update?.forEach(function(row){\n\n      Wb.sql({\n        sql: `update app.tb_temp_table_create a `+\n             `set a.column_name=upper({?i_column_name?}),\n                  a.column_comments={?i_column_comments?},\n                  a.data_type=upper({?i_data_type?}),\n                  a.not_null={?i_not_null?},\n                  a.primary_key={?i_primary_key?},\n                  a.data_default={?i_data_default?},\n                  a.column_id={?i_column_id?} `+\n             `where a.pk_id={?i_pk_id?} ` ,\n        params: {\n          i_pk_id: row.$pk_id,\n          i_column_id: \"column_id\" in row?row.column_id:row.$column_id,\n          i_column_name: \"column_name\" in row?row.column_name:row.$column_name,\n          i_column_comments: \"column_comments\" in row?row.column_comments:row.$column_comments,\n          i_data_type: \"data_type\" in row?row.data_type:row.$data_type,\n          i_not_null: \"not_null\" in row?row.not_null:row.$not_null,\n          i_primary_key: \"primary_key\" in row?row.primary_key:row.$primary_key,\n          i_data_default: \"data_default\" in row?row.data_default:row.$data_default,\n          i_table_comments: \"table_comments\" in row?row.table_comments:row.$table_comments,\n        }, \n        db: 'dm8' \n      });\n      Wb.sql({\n        sql: `update app.tb_temp_table_create a `+\n             `set a.table_comments={?i_table_comments?} `+\n             `where a.table_name= {?i_table_name?}\n              and   a.owner={?i_owner?}\n              and   ({?i_table_comments?} is not null)` ,\n        params: {\n          i_owner: row.$owner,\n          i_table_name: row.$table_name,\n          i_table_comments: \"table_comments\" in row?row.table_comments:row.$table_comments,\n        }, \n        db: 'dm8' \n      });\n    });\n\n    Params.insert?.forEach(function(row){\n\n      let result=Wb.sql({\n        sql: `select sql_str from app.vw_call_sp_sql_str where sp_name='APP.PR_CREATE_TABLE_COLUMN'`, \n        db: 'dm8' \n      });\n      result = Wb.sql({\n        sql: result.items[0].sql_str, \n        params: {\n          i_table_name: row.owner+'.'+row.table_name,\n          i_table_comments: row.table_comments,\n          i_column_name: row.column_name,\n          i_column_comments: row.column_comments,\n          i_data_type: row.data_type,\n          i_not_null:row.not_null,\n          i_primary_key:row.primary_key,\n          i_data_default:row.data_default\n        }, \n        db: 'dm8' \n      });\n      Wb.send({\n        o_return_code:result.o_return_code,\n        o_return_msg:result.o_return_msg\n      });\n    });\n\n  },\n  //保存表和字段注释,字段字典配置的修改\n  saveTable() {\n    let result=Wb.sql({\n      sql: `select sql_str from app.vw_call_sp_sql_str where sp_name='APP.PR_TABLE_COLUMN_EDIT'`, \n      db: 'dm8' \n    });\n    let sqlStr=result.items[0].sql_str;\n\n    Params.del?.forEach(function(row){\n\n      result = Wb.sql({\n        sql: sqlStr, \n        params: {\n          i_edit_type: 'COLUMN_DROP',\n          i_column_list: row.$column_name,\n          i_table_list: row.$owner+'.'+row.$table_name,\n        }, \n        db: 'dm8' \n      });\n      Wb.send({\n        o_return_code:result.o_return_code,\n        o_return_msg:result.o_return_msg\n      });\n    });\n    \n    Params.update?.forEach(function(row){\n      if (\"table_comments\" in row){\n        \n        result = Wb.sql({\n          sql: sqlStr, \n          params: {\n            i_edit_type: 'TABLE_COMMENTS',\n            i_table_list: row.$owner+'.'+row.$table_name,\n            i_table_comments: row.table_comments,\n          }, \n          db: 'dm8' \n        });\n        Wb.send({\n          o_return_code:result.o_return_code,\n          o_return_msg:result.o_return_msg\n        });\n      }\n      if (\"column_name\" in row){\n        \n        result = Wb.sql({\n          sql: sqlStr, \n          params: {\n            i_edit_type: 'COLUMN_NAME_RENAME',\n            i_column_list: row.column_name+'|'+row.$column_name,\n            i_table_list: row.$owner+'.'+row.$table_name,\n          }, \n          db: 'dm8' \n        });\n        Wb.send({\n          o_return_code:result.o_return_code,\n          o_return_msg:result.o_return_msg\n        });\n      }\n      if (\"column_comments\" in row || \"column_name\" in row){\n\n        result = Wb.sql({\n          sql: sqlStr, \n          params: {\n            i_edit_type: 'COLUMN_COMMENTS',\n            i_column_list: \"column_name\" in row?row.column_name:row.$column_name,\n            i_table_list: row.$owner+'.'+row.$table_name,\n            i_column_comments: \"column_comments\" in row?row.column_comments:row.$column_comments,\n          }, \n          db: 'dm8' \n        });\n        Wb.send({\n          o_return_code:result.o_return_code,\n          o_return_msg:result.o_return_msg\n        });\n      }\n      if (\"data_type\" in row || \"column_name\" in row){\n\n        result = Wb.sql({\n          sql: sqlStr, \n          params: {\n            i_edit_type: 'COLUMN_DATA_TYPE_UPGRADE',\n            i_column_list: \"column_name\" in row?row.column_name:row.$column_name,\n            i_table_list: row.$owner+'.'+row.$table_name,\n            i_column_data_type: \"data_type\" in row?row.data_type:row.$data_type,\n          }, \n          db: 'dm8' \n        });\n        Wb.send({\n          o_return_code:result.o_return_code,\n          o_return_msg:result.o_return_msg\n        });\n      }\n      if (\"data_default\" in row){\n        \n        result = Wb.sql({\n          sql: sqlStr, \n          params: {\n            i_edit_type: 'COLUMN_DATA_DEFAULT_UPGRADE',\n            i_column_list: \"column_name\" in row?row.column_name:row.$column_name,\n            i_table_list: row.$owner+'.'+row.$table_name,\n            i_column_data_default: \"data_default\" in row?row.data_default:row.$data_default,\n          }, \n          db: 'dm8' \n        });\n        Wb.send({\n          o_return_code:result.o_return_code,\n          o_return_msg:result.o_return_msg\n        });\n      }\n      if (\"dict_entry\" in row){\n\n        result = Wb.sql({\n          sql: sqlStr, \n          params: {\n            i_edit_type: 'COLUMN_DICT_CODE',\n            i_column_list: \"column_name\" in row?row.column_name:row.$column_name,\n            i_table_list: row.$owner+'.'+row.$table_name,\n            i_dict_code: \"dict_entry\" in row?row.dict_entry:row.$dict_entry,\n          }, \n          db: 'dm8' \n        });\n        Wb.send({\n          o_return_code:result.o_return_code,\n          o_return_msg:result.o_return_msg\n        });\n      }\n\n    });\n    Params.insert?.forEach(function(row){\n\n      result = Wb.sql({\n        sql: sqlStr, \n        params: {\n          i_edit_type: 'COLUMN_ADD',\n          i_table_list: \"table_name\" in row?row.owner+'.'+row.table_name:row.$owner+'.'+row.$table_name,\n          i_column_list: row.column_name,\n          i_table_comments: row.table_comments,\n          i_column_comments: row.column_comments,\n          i_column_data_type:row.data_type,\n          i_column_data_default:row.data_default,\n          i_dict_code:row.dict_entry\n        }, \n        db: 'dm8' \n      });\n      Wb.send({\n        o_return_code:result.o_return_code,\n        o_return_msg:result.o_return_msg\n      });\n    });\n  },\n  //批量修改模块表视图\n  editTable() {\n    let result=Wb.sql({\n        sql: `select sql_str from app.vw_call_sp_sql_str where sp_name='APP.PR_TABLE_COLUMN_EDIT'`, \n        db: 'dm8' \n      });\n      result = Wb.sql({\n        sql: result.items[0].sql_str, \n        params: {\n          i_edit_type: 'TABLE_COMMENTS',\n          i_table_list: Params.I_TABLE_NAME,\n          i_table_comments: Params.I_TABLE_COMMENTS,\n        }, \n        db: 'dm8' \n      });\n      Wb.send({\n        o_return_code:result.o_return_code,\n        o_return_msg:result.o_return_msg\n      });\n  },\n  lockSet() {\n\n    Wb.sql({\n        sql: Params.i_if_lock=='lock'?`insert into app.tb_table_lock(owner,table_name,column_name) values({?i_owner?},{?i_table_name?},'*')`:`delete from app.tb_table_lock where owner={?i_owner?} and table_name={?i_table_name?}`, \n        params: {\n          i_owner: Params.i_owner,\n          i_table_name: Params.i_table_name,\n        }, \n        db: 'dm8' \n      });\n  },\n  editTableProps() {\n    Wb.sql({\n      sql: 'update app.TB_TABLE_PROPS a set a.data_source={?i_data_source?},a.if_his={?i_if_his?},a.date_column={?i_date_column?} where a.owner={?i_owner?} and a.table_name={?i_table_name?}', \n      params: {\n        i_data_source: Params.i_data_source_P,\n        i_if_his: Params.i_if_his_P,\n        i_date_column: Params.i_date_column_P,\n        i_owner: Params.i_owner_P,\n        i_table_name: Params.i_table_name_P,\n      }, \n      db: 'dm8' \n    });\n    Wb.sql({\n      sql: `insert into app.TB_TABLE_PROPS(owner,table_name,data_source,if_his,date_column) \n            select {?i_owner?},{?i_table_name?},{?i_data_source?},{?i_if_his?},{?i_date_column?} from dual\n            where not exists(select 1 from app.TB_TABLE_PROPS where owner={?i_owner?} and table_name={?i_table_name?})`, \n      params: {\n        i_data_source: Params.i_data_source_P,\n        i_if_his: Params.i_if_his_P,\n        i_date_column: Params.i_date_column_P,\n        i_owner: Params.i_owner_P,\n        i_table_name: Params.i_table_name_P,\n      }, \n      db: 'dm8' \n    });\n\n  },\n  editColumn() {\n    let result=Wb.sql({\n      sql: `select sql_str from app.vw_call_sp_sql_str where sp_name='APP.PR_TABLE_COLUMN_EDIT'`, \n      db: 'dm8' \n    });\n    result = Wb.sql({\n      sql: result.items[0].sql_str, \n      params: {\n        i_edit_type: Params.checkToUpgrade=='true'?Params.I_EDIT_TYPE+'_UPGRADE':Params.I_EDIT_TYPE,\n        i_column_list: Params.I_COLUMN_NAME,\n        i_table_list: Params.I_TABLE_LIST,\n        i_column_comments: Params.I_COLUMN_COMMENTS,\n        i_column_data_type: Params.I_COLUMN_DATA_TYPE,\n        i_column_data_default: Params.I_COLUMN_DATA_DEFAULT,\n        i_dict_code: Params.I_DICT_CODE,\n      }, \n      db: 'dm8' \n    });\n    Wb.send({\n      o_return_code:result.o_return_code,\n      o_return_msg:result.o_return_msg\n    });\n  },\n  //添加字段到待创建表\n  addCreateColumn() {\n    let result=Wb.sql({\n      sql: `select sql_str from app.vw_call_sp_sql_str where sp_name='APP.PR_CREATE_TABLE_COLUMN'`, \n      db: 'dm8' \n    });\n    result = Wb.sql({\n      sql: result.items[0].sql_str, \n      params: {\n        i_table_name: Params.i_table_name,\n        i_table_comments: Params.i_table_comments,\n        i_column_name: Params.i_column_name,\n        i_column_comments: Params.i_column_comments,\n        i_data_type: Params.i_data_type,\n      }, \n      db: 'dm8' \n    });\n    Wb.send({\n      o_return_code:result.o_return_code,\n      o_return_msg:result.o_return_msg\n    });\n  },\n  updateColumnId() {\n    Wb.sql({\n      sql: `update app.tb_temp_table_create a\n            set a.column_id={?i_column_id?}\n            where a.pk_id={?i_pk_id?}`,\n      params: {\n        i_column_id: Params.i_column_id,\n        i_pk_id: Params.i_pk_id,\n      }, \n      db: 'dm8' \n    });\n  },\n  refreshColumns() {\n    Wb.sql({\n      sql: `delete from app.tb_columns a\n             where (a.table_name={?i_table_name?} or {?i_table_name?} is null)\n             and   (a.last_ddl_time is null or exists(select 1 from all_objects b where b.object_type in ('TABLE','VIEW') and a.owner=b.owner and a.table_name=b.object_name and a.last_ddl_time<b.last_ddl_time))`,\n      params: {\n        i_table_name: Params.i_table_name,\n      }, \n      db: 'dm8' \n    });\n    Wb.sql({\n      sql: `insert into APP.TB_COLUMNS(OWNER, TABLE_NAME, TABLE_FULL_NAME,TABLE_COMMENTS, COLUMN_NAME, COLUMN_COMMENTS, DATA_TYPE, DATA_PRECISION, DATA_SCALE, COLUMN_ID, TABLE_TYPE, DATA_DEFAULT, DICT_ENTRY, IF_LOCKED, NOT_NULL, PRIMARY_KEY, DATA_SOURCE, SYNONYM_TABLE, IF_HIS, DATE_COLUMN, MODIFY_HISTORY,last_ddl_time) \n            select OWNER, TABLE_NAME,OWNER||'.'||TABLE_NAME, TABLE_COMMENTS, COLUMN_NAME, COLUMN_COMMENTS, DATA_TYPE, DATA_PRECISION, DATA_SCALE, COLUMN_ID, TABLE_TYPE, DATA_DEFAULT, DICT_ENTRY, IF_LOCKED, NOT_NULL, PRIMARY_KEY, DATA_SOURCE, SYNONYM_TABLE, IF_HIS, DATE_COLUMN, MODIFY_HISTORY,last_ddl_time\n            from   app.vw_columns a\n            where  (a.table_name={?i_table_name?} or {?i_table_name?} is null)\n            and    (a.owner,a.table_name) in (select a.owner,a.table_name \n                                                from all_tables a\n                                                left join app.tb_columns b on a.owner=b.owner and a.table_name=b.table_name\n                                               where a.owner not in ('SYS','SYSDBA') and b.table_name is null\n                                               union all\n                                              select a.owner,a.view_name \n                                                from all_views a\n                                                left join app.tb_columns b on a.owner=b.owner and a.view_name=b.table_name\n                                               where a.owner not in ('SYS','SYSDBA') and b.table_name is null)\n            `,\n      params: {\n        i_table_name: Params.i_table_name,\n      }, \n      db: 'dm8' \n    });\n  },\n  \n};\nactions[Params.xaction]();"},"_icon":"module"}