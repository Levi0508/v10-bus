{"title":"转换字典管理","icon":"dict","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module"},"_icon":"module","_expanded":true,"events":{"initialize":"Wb.apply(app, {\n  onChangeDictMap() {\n    app.btnSaveDictMap.disabled = false;\n    app.btnCancelDictMap.disabled=false;\n  },\n  onChangeDict() {\n    app.gridKeyValue.editable=false;\n    app.btnAddKeyValue.disabled=true;\n    app.btnDeleteKeyValue.disabled=true;\n    app.btnSaveDict.disabled = false;\n    app.btnCancelDict.disabled=false;\n  },\n  onChangeKeyValue() {\n    app.gridDict.editable=false;\n    app.btnAddDict.disabled=true;\n    app.btnSaveKeyValue.disabled = false;\n    app.btnCancelKeyValue.disabled=false;\n  },\n  onChangeSourceKey() {\n    app.btnSaveSourceKey.disabled = false;\n    app.btnCancelSourceKey.disabled=false;\n  },\n  saveDictMap(callback) {\n    app.gridMain.sync({\n      url: xpath + '/actions&xaction=saveDictMap',\n      success() {\n        app.btnSaveDictMap.disabled = true;\n        app.btnCancelDictMap.disabled=true;\n        callback?.();\n      },\n      failure(resp) {\n          Wb.error(resp);\n      }\n    });\n  },\n  saveDict(callback) {\n    app.gridDict.sync({\n      url: xpath + '/actions&xaction=saveDict',\n      success() {\n        app.gridKeyValue.editable=true;\n        app.btnAddKeyValue.disabled=false;\n        app.btnDeleteKeyValue.disabled=false;\n        app.btnSaveDict.disabled = true;\n        app.btnCancelDict.disabled=true;\n        callback?.();\n      },\n      failure(resp) {\n          Wb.error(resp);\n      }\n    });\n  },\n  saveKeyValue(callback) {\n    app.gridKeyValue.sync({\n      url: xpath + '/actions&xaction=saveKeyValue',\n      success() {\n        app.gridDict.editable=true;\n        app.btnAddDict.disabled=false;\n        app.btnSaveKeyValue.disabled = true;\n        app.btnCancelKeyValue.disabled=true;\n        callback?.();\n      },\n      failure(resp) {\n          Wb.error(resp);\n      }\n    });\n  },\n  saveSourceKey(callback) {\n    app.gridSourceKeyValue.sync({\n      url: xpath + '/actions&xaction=saveSourceKey',\n      success() {\n        app.btnSaveSourceKey.disabled = true;\n        app.btnCancelSourceKey.disabled=true;\n        callback?.();\n      },\n      failure(resp) {\n          Wb.error(resp);\n      }\n    });\n  },\n  gridSort(me,colItem, td, e, name, sortType){\n    //排序执行3\n    if (name && me.columnsSortable && colItem.sortable) {\n      let sorter;\n      if (me.clickHeaderRipple)\n        td.rippleEffect(e.x, e.y);\n       sorter = me.sorterList?.find(item => item.name == name);\n      me.sorters = { name, desc: sorter?(!sorter.desc):false };\n      Wb.log('排序方式:'+sortType+',排序列:'+name);\n      if (sortType=='local'){\n        if (me.fireEvent('beforesort', me.data, me.sorters) !== false) {\n          let keys = [], desc = [];\n          keys.push(me.sorters.name);\n          desc.push(me.sorters.desc);\n          me.data = me.data.mixSort(keys, desc);\n        }\n      }else{\n        if (me.fireEvent('beforesort', me.data, me.sorters) !== false){\n          me.reload();\n        }\n      }\n    }\n  },\n});\nWb.Grid.prototype.onHeaderClick = function(e) {\n  //排序执行1\n  let me = this, td = e.target.closest('td'), colItem = td?.colItem, name = colItem?.fieldName;\n  me.fireEvent('headerclick', colItem, td, e, name);\n}","beforeunload":"if (!app.btnSaveDictMap.disabled || !app.btnSaveDict.disabled || !app.btnSaveKeyValue.disabled)\n  return false;"},"items":[{"_icon":"viewport","text":"viewport1","cls":"Wb.Viewport","properties":{"cid":"viewport1","padding":".7em","gap":".7em","background":"true"},"_expanded":true,"items":[{"_icon":"label","text":"label1","cls":"Wb.Label","_expanded":true,"properties":{"cid":"label1","text":"转换字典管理","titleType":"title3"},"hasDupCid":0},{"_icon":"panel","text":"panelInput","cls":"Wb.Panel","properties":{"cid":"panelInput","layout":"row","roundBorder":"true","padding":"true","gap":"true","shrink":"true"},"_expanded":true,"hasDupCid":1,"items":[{"_icon":"combo","text":"i_dict_code","cls":"Wb.Select","properties":{"cid":"i_dict_code","url":"@xpath + '/actions&xaction=selectDictList'","textField":"dict_name","valueField":"dict_code","noWrap":"true","text":"字典","labelWidth":"80","clearButton":"true","width":"400"},"events":{"select":"app.btnQ.fireClick();\n","clearclick":"app.btnQ.fireClick();"},"hasDupCid":0,"_expanded":true,"items":[{"cls":"Wb.Item","events":{"click":"let win = app.winEditDict;\napp.i_dict_code_D.value=[this.parent.value,this.parent.lastInputValue];\nwin.focusControl = true;\n//模态窗口\nwin.modal=true;\nwin.show();\napp.btnDictQ.fireClick();\nwin.scrollEl.scrollTop = win.scrollEl.scrollLeft = 0;"},"properties":{"cid":"triggers","icon":"data-provider","tip":"字典管理"},"text":"triggers","_expanded":true,"_icon":"item","hasDupCid":1}]},{"_icon":"combo","text":"i_data_source","cls":"Wb.Select","properties":{"cid":"i_data_source","url":"@xpath + '/actions&xaction=selectSourceList'","textField":"source_name","valueField":"source_code","noWrap":"true","text":"数据源","labelWidth":"80","clearButton":"true","width":"400"},"events":{"select":"app.btnQ.fireClick();\n","clearclick":"app.btnQ.fireClick();"},"hasDupCid":0,"_expanded":true,"items":[{"cls":"Wb.Item","events":{"click":"let win = app.winSourceDict;\napp.i_data_source_SD.value=this.parent.value;\napp.i_source_dict_SD.value=null;\napp.gridSourceDict.setData(null);\napp.gridSourceKeyValue.setData(null);\nwin.focusControl = true;\n//模态窗口\nwin.modal=true;\nwin.show();\napp.btnSourceDictQ.fireClick();\nwin.scrollEl.scrollTop = win.scrollEl.scrollLeft = 0;"},"properties":{"cid":"triggers","icon":"data-provider","tip":"源字典查询"},"text":"triggers","_expanded":true,"_icon":"item","hasDupCid":1}]}]},{"_icon":"panel","text":"panelOutput","cls":"Wb.Panel","properties":{"cid":"panelOutput","autoScroll":"true","layout":"column","flex":"1","border":"1","roundBorder":"true"},"_expanded":true,"hasDupCid":0,"items":[{"_ico