= true;\napp.btnSaveDictMap.disabled=true;\napp.btnQ.fireClick();\n"},"hasDupCid":0},{"_icon":"divider","text":"divider1","cls":"Wb.Divider","properties":{"cid":"divider1"},"hasDupCid":1},{"_icon":"item","text":"btnAddDictMap","cls":"Wb.Item","_expanded":false,"properties":{"cid":"btnAddDictMap","text":"添加映射","icon":"connect"},"events":{"click":"let win = app.winAddDictMap;\nwin.focusControl = null;\nwin.okHandler = (win, values) => {\n  Wb.ajax({\n    url: xpath + '/actions&xaction=addDictMap',\n    params: values,\n    json: true,\n    success(resp) {\n      if (resp.o_return_code=='0'){\n        Wb.tip('执行成功');\n        win.hide();\n        app.i_dict_code.setValue(app.i_dict_code_DM.value);\n        app.i_data_source.value=app.i_data_source_DM.value;\n        app.btnQ.fireClick();\n      }else{\n        Wb.error(resp.o_return_msg);\n      }\n    },\n    failure(resp) { \n      Wb.error(resp);\n    }\n  });\n};\nwin.show();\nwin.scrollEl.scrollTop = win.scrollEl.scrollLeft = 0;"},"hasDupCid":0},{"_icon":"container","text":"container1","cls":"Wb.Container","_expanded":true,"properties":{"cid":"container1","justify":"end","flex":"1"},"hasDupCid":1,"items":[{"_icon":"button","text":"btnQ","cls":"Wb.Button","properties":{"cid":"btnQ","text":"查询","visible":"true","type":"primary","shrinkSelf":"false","icon":"search","alignSelf":"end","margin":"false","justifySelf":"end"},"events":{"click":"let selectedItem=app.gridMain.selectionData?.dict_code+app.gridMain.selectionData?.data_source+app.gridMain.selectionData?.source_key;\n\napp.gridMain.load({\n  params: {\n    i_dict_code: app.i_dict_code.value,\n    i_data_source: app.i_data_source.value,\n  }, \n  success(){\n    app.gridMain.data.forEach((item,index) => {\n      if (item.dict_code+item.data_source+item.source_key==selectedItem){\n        app.gridMain.items[index].selected=true;\n      }\n    });\n  },\n});\n"},"_expanded":false,"hasDupCid":0}]}]},{"_icon":"array","text":"columns","cls":"Wb.Array","properties":{"c