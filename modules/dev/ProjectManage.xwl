{"title":"模块管理","icon":"model","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module"},"_icon":"module","_expanded":true,"events":{"initialize":"Wb.apply(app, {\n  gridSort(me,colItem, td, e, name, sortType){\n    if (name && me.columnsSortable && colItem.sortable) {\n      let sorter;\n      if (me.clickHeaderRipple)\n        td.rippleEffect(e.x, e.y);\n        sorter = me.sorterList?.find(item => item.name == name);\n        me.sorters = { name, desc: sorter?(!sorter.desc):false };\n        Wb.log('排序方式:'+sortType+',排序列:'+name);\n      if (sortType=='local'){\n        if (me.fireEvent('beforesort', me.data, me.sorters) !== false) {\n          let keys = [], desc = [];\n          keys.push(me.sorters.name);\n          desc.push(me.sorters.desc);\n          me.data = me.data.mixSort(keys, desc);\n        }\n      }else{\n        if (me.fireEvent('beforesort', me.data, me.sorters) !== false){\n          me.reload();\n        }\n      }\n    }\n  },\n  exportData(tableName) {\n    let params = { db: 'dm8' };\n    let sql = 'select * from '+tableName;\n    params.data = Wb.encodeBase64(sql);\n    params.tableName = tableName;\n    Wb.download(xpath + '/export', params);\n  },\n  importTable(tableName) {\n    Wb.selectFile(file => {\n      Wb.ajax({\n        url: xpath + '/import',\n        params: { db: 'dm8', tableName, file,if_delete:'1' },\n        uploadProgress: Str.import + ' - ' + tableName + '...',\n        success() {\n          Wb.tip('导入成功');\n        }\n      });\n    }, '.wbt, .xls, .xlsx, .csv, .txt');\n  },\n});\n\nWb.Grid.prototype.onHeaderClick = function(e) {\n  let me = this, td = e.target.closest('td'), colItem = td?.colItem, name = colItem?.fieldName;\n  me.fireEvent('headerclick', colItem, td, e, name);\n}"},"items":[{"_icon":"viewport","text":"viewport1","cls":"Wb.Viewport","properties":{"cid":"viewport1","background":"true","gap":".7em","padding":".7em"},"_expanded":true,"items":[{"_icon":"label","