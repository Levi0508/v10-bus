ue"},"hasDupCid":0,"_expanded":true,"items":[{"_icon":"item","text":"btnAdd","cls":"Wb.Item","_expanded":true,"properties":{"cid":"btnAdd","icon":"add","text":"添加"},"events":{"click":"let win = app.winEditProject;\napp.i_project_id_P.visible=true;\napp.i_project_id_P.readonly=false;\napp.i_project_id_P.required=true;\napp.i_project_version_P.visible=false;\napp.i_project_version_P.readonly=false;\napp.i_project_version_P.required=false;\napp.i_project_name_P.visible=true;\napp.i_project_name_P.readonly=false;\napp.i_project_name_P.required=true;\napp.i_version_summary_P.visible=true;\napp.i_version_summary_P.readonly=false;\napp.i_version_summary_P.required=false;\n\nwin.icon = 'add';\nwin.title = Str.add;\nwin.focusControl = null;\nwin.okHandler = (win, values) => {\n  Wb.ajax({\n    url: xpath + '/actions&xaction=addProject',\n    params: values,\n    json: true,\n    success(resp) {\n      if (resp.o_return_code && resp.o_return_code=='0'){\n        Wb.tip('添加成功');\n        win.hide();\n        app.treeProject.reload();\n      }else{\n        Wb.error(resp.o_return_msg);\n      }\n    },\n    failure(resp) { \n      Wb.error(resp);\n    }\n  });\n};\nwin.show();\nwin.scrollEl.scrollTop = win.scrollEl.scrollLeft = 0;\n"},"hasDupCid":0},{"_icon":"divider","text":"divider1","cls":"Wb.Divider","properties":{"cid":"divider1"},"hasDupCid":1},{"_icon":"combo","text":"i_project_id","cls":"Wb.Select","properties":{"cid":"i_project_id","url":"@xpath + '/actions&xaction=selectProjectList'","textField":"project_name","valueField":"project_id","isProperty":"false","clearButton":"true","placeholder":"搜索","width":"300"},"events":{"clearclick":"app.panelOutputMain.height = 400;\napp.btnQ.fireClick();\n","select":"app.panelOutputMain.height=110;\napp.btnQ.fireClick();\n"},"hasDupCid":0},{"_icon":"container","text":"container1","cls":"Wb.Container","_expanded":true,"properties":{"cid":"container1","justify":"end","flex":"1"},"hasDupCid":1,"items":[{"_icon":"button","text":"btnQ","