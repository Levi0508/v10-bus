{"title":"","icon":"","img":"","tags":"","hideInMenu":"true","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"let actions = {\n  //查询模块\n  selectProject() {\n    let result=Wb.sql({\n      sql: `select sql_str from app.vw_call_sp_sql_str where sp_name='APP.P40000'`, \n      db: 'dm8' \n    });\n    result = Wb.sql({\n      sql: result.items[0].sql_str, \n      params: {\n        i_project_pk: Params.sid,\n        i_project_id: Params.i_project_id,\n        \n      }, \n      db: 'dm8' \n    });\n    Wb.send(result.rt_cursor);\n  },\n  //查询模块表视图\n  selectTableView() {\n    let result=Wb.sql({\n      sql: `select sql_str from app.vw_call_sp_sql_str where sp_name='APP.P40001'`, \n      db: 'dm8' \n    });\n    result = Wb.sql({\n      sql: result.items[0].sql_str, \n      params: {\n        i_project_id: Params.i_project_id,\n        i_project_version: Params.i_project_version,\n        i_tab_view_name: Params.i_tab_view_name\n      }, \n      db: 'dm8' \n    });\n    Wb.send(result.rt_cursor);\n  },\n  //查询模块程序\n  selectProcedure() {\n    let result=Wb.sql({\n      sql: `select sql_str from app.vw_call_sp_sql_str where sp_name='APP.P40002'`, \n      db: 'dm8' \n    });\n    result = Wb.sql({\n      sql: result.items[0].sql_str, \n      params: {\n        i_project_id: Params.i_project_id,\n        i_project_version: Params.i_project_version,\n        i_sp_func_name: Params.i_sp_func_name,\n        i_if_check_change: Params.i_if_check_change\n      }, \n      db: 'dm8' \n    });\n    Wb.send(result.rt_cursor);\n  },\n  //查询升级脚本\n  selectUpgradeCode() {\n    let result=Wb.sql({\n      sql: `select sql_str from app.vw_call_sp_sql_str where sp_name='APP.P40003'`, \n      db: 'dm8' \n    });\n    result = Wb.sql({\n      sql: result.items[0].sql_str, \n      params: {\n        i_project_id: Params.i_project_id,\n        i_project_version: Params.i_project_version,\n        \n      }, \n      db: 'dm8' \n    });\n    Wb.send({\n      o_return_code:result.o_return_code,\n      o_return_msg:result.o_return_msg\n    }); \n  },\n  //下载升级脚本\n  downloadUpgradeCode() {\n    let date=new Date();\n    let file = new Wb.File(true, 'wb/forDownload/'+Params.i_project_id+'_'+Params.i_project_version+'_'+date.format('yyyyMMdd')+'.sql');\n    let result=Wb.sql({\n      sql: `select sql_str from app.vw_call_sp_sql_str where sp_name='APP.P40003'`, \n      db: 'dm8' \n    });\n    result = Wb.sql({\n      sql: result.items[0].sql_str, \n      params: {\n        i_project_id: Params.i_project_id,\n        i_project_version: Params.i_project_version,\n      }, \n      db: 'dm8' \n    });\n    file.text=result.o_return_msg;\n    Wb.exportData(file);\n  },\n  //下载数据导出脚本,insert语句\n  downloadExportCode() {\n    let date=new Date();\n    let file = new Wb.File(true, 'wb/forDownload/'+Params.i_table_name+'_'+date.format('yyyyMMdd')+'.sql');\n    let result=Wb.sql({\n      sql: `select sql_str from app.vw_call_sp_sql_str where sp_name='APP.PR_TABLE_DATA_EXPORT'`, \n      db: 'dm8' \n    });\n    result = Wb.sql({\n      sql: result.items[0].sql_str, \n      params: {\n        i_table_name: Params.i_table_name,\n      }, \n      db: 'dm8' \n    });\n    file.text=result.o_return_msg;\n    Wb.exportData(file);\n  },\n  //查询模块列表\n  selectProjectList() {\n    let sqlstr = \"select distinct project_id,project_id||'-'||project_name as project_name from app.tb_project where (project_id={?i_project_id?} or {?i_project_id?} is null) and (instr(upper(project_id||'-'||project_name) , upper({?query?}))>0 or {?query?} is null) order by project_id\";\n    Wb.sendRows({\n      sql:sqlstr,\n      params: {\n        i_project_id: Params.i_project_id,\n        query:Params.query,\n      },\n      db:'dm8'\n    });\n  },\n  //查询表视图列表\n  selectTableViewList() {\n    Wb.sendRows({\n      sql:`select a.tab_view_name,a.tab_view_name||'-'||b.comments as tab_view_comments from app.tb_project_tab_view_list a inner join all_tab_comments b on a.tab_view_name=b.owner||'.'||b.table_name \n           where a.project_id={?i_project_id?} and a.project_version={?i_project_version?} \n           and   (tab_view_name={?i_tab_view_name?} or {?i_tab_view_name?} is null) and (instr(upper(a.tab_view_name||'-'||b.comments) , upper({?query?}))>0 or {?query?} is null) order by a.tab_view_name`,\n      params: {\n        i_project_id: Params.i_project_id,\n        i_project_version: Params.i_project_version,\n        i_tab_view_name: Params.i_tab_view_name,\n        query:Params.query,\n      },\n      db:'dm8'\n    });\n  },\n  //查询程序列表\n  selectProcedureList() {\n    Wb.sendRows({\n      sql:`select distinct a.sp_func_name,a.sp_func_name||'-'||b.summary as sp_func_summary from app.tb_project_sp_func_list a left join app.tb_etl_sp b on upper(a.sp_func_name)=b.etl_sp_name \n           where a.project_id={?i_project_id?} and a.project_version={?i_project_version?} \n           and   (sp_func_name={?i_sp_func_name?} or {?i_sp_func_name?} is null) and (instr(upper(a.sp_func_name||'-'||b.summary) , upper({?query?}))>0 or {?query?} is null) order by a.sp_func_name`,\n      params: {\n        i_project_id: Params.i_project_id,\n        i_project_version: Params.i_project_version,\n        i_sp_func_name: Params.i_sp_func_name,\n        query:Params.query,\n      },\n      db:'dm8'\n    });\n  },\n  //查询程序版本列表\n  selectProcedureUp() {\n    Wb.sendRows({\n      sql:\"select version_id as k,version_id||'-'||upgrade_summary as v from APP.tb_etl_sp where etl_sp_name={?i_sp_func_name?} order by k desc \",\n      params: {\n        i_sp_func_name: Params.i_sp_func_name\n      },\n      db:'dm8'\n    });\n  },\n  //添加模块\n  addProject() {\n    let result=Wb.sql({\n      sql: `select sql_str from app.vw_call_sp_sql_str where sp_name='APP.PR_PROJECT_CREATE'`, \n      db: 'dm8' \n    });\n    result = Wb.sql({\n      sql: result.items[0].sql_str, \n      params: {\n        i_project_id: Params.i_project_id_P,\n        i_project_name: Params.i_project_name_P,\n        i_version_summary: Params.i_version_summary_P,\n        i_user_code: Wb.username\n      }, \n      db: 'dm8' \n    });\n    Wb.send({\n      o_return_code:result.o_return_code,\n      o_return_msg:result.o_return_msg\n    });\n  },\n  //添加模块表视图\n  addProjectTableView() {\n    let result=Wb.sql({\n      sql: `select sql_str from app.vw_call_sp_sql_str where sp_name='APP.PR_PROJECT_TAB_VIEW_ADD'`, \n      db: 'dm8' \n    });\n    result = Wb.sql({\n      sql: result.items[0].sql_str, \n      params: {\n        i_project_id: Params.i_project_id_t,\n        i_project_version: Params.i_project_version_t,\n        i_tab_or_view: Params.i_tab_or_view_t,\n        i_tab_view_name: Params.i_tab_view_name_t,\n        i_create_sql: Params.i_create_sql_t,\n        i_user_code: Wb.username\n      }, \n      db: 'dm8' \n    });\n    Wb.send({\n      o_return_code:result.o_return_code,\n      o_return_msg:result.o_return_msg\n    });\n  },\n  //添加模块程序\n  addProjectProcedure() {\n    let result=Wb.sql({\n      sql: `select sql_str from app.vw_call_sp_sql_str where sp_name='APP.PR_PROJECT_SP_FUNC_ADD'`, \n      db: 'dm8' \n    });\n    result = Wb.sql({\n      sql: result.items[0].sql_str, \n      params: {\n        i_project_id: Params.i_project_id_p,\n        i_project_version: Params.i_project_version_p,\n        i_sp_func_name: Params.i_sp_func_name_p,\n        i_user_code: Wb.username\n      }, \n      db: 'dm8' \n    });\n    Wb.send({\n      o_return_code:result.o_return_code,\n      o_return_msg:result.o_return_msg\n    });\n  },\n  //修改模块\n  editProject() {\n    let result=Wb.sql({\n      sql: `select sql_str from app.vw_call_sp_sql_str where sp_name='APP.PR_PROJECT_UPDATE'`, \n      db: 'dm8' \n    });\n    result = Wb.sql({\n      sql: result.items[0].sql_str, \n      params: {\n        i_project_id: Params.i_project_id_P,\n        i_project_version: Params.i_project_version_P,\n        i_project_name: Params.i_project_name_P,\n        i_version_summary: Params.i_version_summary_P,\n        i_user_code: Wb.username\n      }, \n      db: 'dm8' \n    });\n    Wb.send({\n      o_return_code:result.o_return_code,\n      o_return_msg:result.o_return_msg\n    });\n  },\n  //修改模块表视图\n  editProjectTableView() {\n    let result=Wb.sql({\n      sql: `select sql_str from app.vw_call_sp_sql_str where sp_name='APP.PR_PROJECT_TAB_VIEW_MOD'`, \n      db: 'dm8' \n    });\n    result = Wb.sql({\n      sql: result.items[0].sql_str, \n      params: {\n        i_project_id: Params.i_project_id_t,\n        i_project_version: Params.i_project_version_t,\n        i_tab_view_name: Params.i_tab_view_name_t,\n        i_modify_sql: Params.i_modify_sql_t,\n        i_modify_summary: Params.i_modify_summary_t,\n        i_user_code: Wb.username\n      }, \n      db: 'dm8' \n    });\n    Wb.send({\n      o_return_code:result.o_return_code,\n      o_return_msg:result.o_return_msg\n    });\n    if (Params.i_tab_or_view_t=='TABLE'){\n      Wb.sql({\n        sql: `update app.tb_project_tab_view set update_user={?i_user_code?},update_time=sysdate,table_type= {?i_table_type_t?}\n              where  tab_view_name={?i_tab_view_name?} `, \n        params: {\n          i_tab_view_name: Params.i_tab_view_name_t,\n          i_table_type: Params.i_table_type_t,\n          i_user_code: Wb.username\n        }, \n        db: 'dm8' \n      });\n    }\n    \n  },\n  //修改模块程序\n  editProjectProcedure() {\n    let result=Wb.sql({\n      sql: `select sql_str from app.vw_call_sp_sql_str where sp_name='APP.PR_PROJECT_SP_FUNC_MOD'`, \n      db: 'dm8' \n    });\n    result = Wb.sql({\n      sql: result.items[0].sql_str, \n      params: {\n        i_project_id: Params.i_project_id_p,\n        i_project_version: Params.i_project_version_p,\n        i_sp_func_name: Params.i_sp_func_name_p,\n        i_etl_sp_version_up: Params.i_etl_sp_version_up_p,\n        i_user_code: Wb.username\n      }, \n      db: 'dm8' \n    });\n    Wb.send({\n      o_return_code:result.o_return_code,\n      o_return_msg:result.o_return_msg\n    });\n  },\n  //删除模块\n  delProject() {\n    let result=Wb.sql({\n      sql: `select sql_str from app.vw_call_sp_sql_str where sp_name='APP.PR_PROJECT_DELETE'`, \n      db: 'dm8' \n    });\n    result = Wb.sql({\n      sql: result.items[0].sql_str, \n      params: {\n        i_project_id: Params.i_project_id,\n        i_project_version: Params.i_project_version,\n        i_user_code: Wb.username\n      }, \n      db: 'dm8' \n    });\n    Wb.send({\n      o_return_code:result.o_return_code,\n      o_return_msg:result.o_return_msg\n    }); \n  },\n  //删除模块表视图\n  delProjectTableView() {\n    let result=Wb.sql({\n      sql: `select sql_str from app.vw_call_sp_sql_str where sp_name='APP.PR_PROJECT_TAB_VIEW_DEL'`, \n      db: 'dm8' \n    });\n    result = Wb.sql({\n      sql: result.items[0].sql_str, \n      params: {\n        i_project_id: Params.i_project_id,\n        i_project_version: Params.i_project_version,\n        i_tab_view_name: Params.i_tab_view_name,\n        i_user_code: Wb.username\n      }, \n      db: 'dm8' \n    });\n    Wb.send({\n      o_return_code:result.o_return_code,\n      o_return_msg:result.o_return_msg\n    }); \n  },\n  //删除模块程序\n  delProjectProcedure() {\n    let result=Wb.sql({\n      sql: `select sql_str from app.vw_call_sp_sql_str where sp_name='APP.PR_PROJECT_SP_FUNC_DEL'`, \n      db: 'dm8' \n    });\n    result = Wb.sql({\n      sql: result.items[0].sql_str, \n      params: {\n        i_project_id: Params.i_project_id,\n        i_project_version: Params.i_project_version,\n        i_sp_func_name: Params.i_sp_func_name,\n        i_user_code: Wb.username\n      }, \n      db: 'dm8' \n    });\n    Wb.send({\n      o_return_code:result.o_return_code,\n      o_return_msg:result.o_return_msg\n    }); \n  },\n  //模块升级\n  upgradeProject() {\n    let result=Wb.sql({\n      sql: `select sql_str from app.vw_call_sp_sql_str where sp_name='APP.PR_PROJECT_UPGRADE'`, \n      db: 'dm8' \n    });\n    result = Wb.sql({\n      sql: result.items[0].sql_str, \n      params: {\n        i_project_id: Params.i_project_id_P,\n        i_project_version: Params.i_project_version_P,\n        i_user_code: Wb.username\n      }, \n      db: 'dm8' \n    });\n    Wb.send({\n      o_return_code:result.o_return_code,\n      o_return_msg:result.o_return_msg\n    }); \n  },\n  //复制表视图ddl作为升级脚本\n  copyCreateSql() {\n    Wb.sql({\n      sql: `update app.tb_project_tab_view_list set update_user={?i_user_code?},update_time=sysdate,modify_sql='use ddl',modify_summary=case when modify_summary is null then '新建表' else modify_summary end \n            where project_id={?i_project_id?} and project_version={?i_project_version?} and tab_view_name={?i_tab_view_name?} `, \n      params: {\n        i_project_id: Params.i_project_id,\n        i_project_version: Params.i_project_version,\n        i_tab_view_name: Params.i_tab_view_name,\n        i_user_code: Wb.username\n      }, \n      db: 'dm8' \n    });\n  },\n\n};\nactions[Params.xaction]();"},"_icon":"module"}