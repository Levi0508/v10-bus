{"title":"表转换管理","icon":"devtool","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module"},"_icon":"module","_expanded":true,"events":{"initialize":"Wb.apply(app, {\n  onChange() {\n    app.btnSave.disabled = false;\n    app.btnCancel.disabled=false;\n  },\n  save(callback) {\n    app.gridETLTable.sync({\n      url: xpath + '/actions&xaction=save',\n      success() {\n        app.btnSave.disabled = true;\n        app.btnCancel.disabled=true;\n        callback?.();\n      },\n      failure(resp) {\n          Wb.error(resp);\n      }\n    });\n  },\n  gridSort(me,colItem, td, e, name, sortType){\n    //排序执行3\n    if (name && me.columnsSortable && colItem.sortable) {\n      let sorter;\n      if (me.clickHeaderRipple)\n        td.rippleEffect(e.x, e.y);\n       sorter = me.sorterList?.find(item => item.name == name);\n      me.sorters = { name, desc: sorter?(!sorter.desc):false };\n      Wb.log('排序方式:'+sortType+',排序列:'+name);\n      if (sortType=='local'){\n        if (me.fireEvent('beforesort', me.data, me.sorters) !== false) {\n          let keys = [], desc = [];\n          keys.push(me.sorters.name);\n          desc.push(me.sorters.desc);\n          me.data = me.data.mixSort(keys, desc);\n        }\n      }else{\n        if (me.fireEvent('beforesort', me.data, me.sorters) !== false){\n          me.reload();\n        }\n      }\n    }\n  },\n});\nWb.Grid.prototype.onHeaderClick = function(e) {\n  //排序执行1\n  let me = this, td = e.target.closest('td'), colItem = td?.colItem, name = colItem?.fieldName;\n  me.fireEvent('headerclick', colItem, td, e, name);\n}","beforeunload":"if (!app.btnSave.disabled)\n  return false;"},"items":[{"_icon":"viewport","text":"viewport1","cls":"Wb.Viewport","properties":{"cid":"viewport1","padding":".7em","gap":".7em","background":"true"},"_expanded":true,"items":[{"_icon":"label","text":"label1","cls":"Wb.Label","_expanded":true,"properties":{"cid":"label1","text":"转换表管理","titleType":"title3"}