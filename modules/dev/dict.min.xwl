{"title":"@dictConfig","icon":"dict","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","links":"[\"wb/js/monaco.js\"]","remark":"Dictionary configuration utility"},"_icon":"module","_expanded":true,"events":{"initialize":"Wb.apply(app,{load(){app.grid1.delayLoad({comps:app.viewport1.tbar})}});Wb.make(app,{cname:\"viewport\",layout:\"fit\",autoContextMenu:true,cid:\"viewport1\",tbar:{cname:\"toolbar\",items:[{keys:\"Ctrl+E\",icon:\"add\",text:Str.add,cid:\"addBtn\",events:{click(e,t){app.grid1.dictAdd(xpath+\"/add\",Str.dictConfig)}}},{keys:\"Ctrl+J\",icon:\"edit\",text:Str.edit,cid:\"editBtn\",events:{click(e,t){let a=app.grid1.selection?.data;app.grid1.dictEdit(xpath+\"/edit\",\"name\",{oldName:a?.name,oldGroup:a?.group_name})}}},{keys:\"Ctrl+D\",icon:\"delete\",text:Str.del,cid:\"delBtn\",events:{click(e,t){app.grid1.removeRecords(xpath+\"/del\",\"name\")}}},{cname:\"divider\",cid:\"divider1\"},{cname:\"text\",clearButton:true,flex:1,minWidth:\"5em\",placeholder:Str.name,cid:\"search\",maxWidth:\"20em\",events:{change(e,t,a){app.load()}}},{cname:\"text\",clearButton:true,flex:1,minWidth:\"5em\",placeholder:Str.groupName,cid:\"searchGroup\",maxWidth:\"20em\",events:{change(e,t,a){app.load()}}},{cname:\"text\",clearButton:true,flex:1,minWidth:\"5em\",placeholder:Str.content,cid:\"searchContent\",maxWidth:\"20em\",events:{change(e,t,a){app.load()}}}]},items:[{cname:\"grid\",keyWalking:\"name\",columnsSortable:true,keyFields:\"sid\",sorters:\"name\",url:xpath+\"/select\",cid:\"grid1\",multiSelect:true,events:{itemdblclick(e,t,a){app.editBtn.fireEvent(\"click\")}}}]});"}}