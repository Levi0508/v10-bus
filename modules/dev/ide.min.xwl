{"text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"function main(){Wb.load(\"./ide/ide-ss.js\");const e=Wb.ide.Util,s=\"wb/modules/dev/ide/\";Wb.set(\"args\",Wb.encode({path:Base.pathText,devTools:Wb.getConfig(\"sys.ss.devTools\"),osCharset:Base.osCharset?.toUpperCase(),charset:System.getProperty(\"file.encoding\")?.toUpperCase(),fileCharset:Wb.getConfig(\"sys.file.charset\")?.toUpperCase(),filenameCharset:Wb.getConfig(\"sys.locale.filenameCharset\")?.toUpperCase(),sysFilenameCharset:SysUtil.filenameCharset?.name()?.toUpperCase(),createWbCss:new Wb.File(true,s+\"create-wb-css.xwl\").exists,createDocs:new Wb.File(true,s+\"create-docs.xwl\").exists,createRelease:new Wb.File(true,s+\"create-release.xwl\").exists,compressScript:new Wb.File(true,s+\"compress.xwl\").exists,releasePath:Wb.getConfig(\"sys.app.releasePath\"),version:Wb.getConfig(\"sys.app.version\"),heartbeat:Wb.getConfig(\"sys.session.heartbeatInterval\"),httpHeartbeat:Wb.getConfig(\"sys.session.httpHeartbeatInterval\"),username:Wb.username,openExample:Params.openExample,openModule:Params.openModule,imgs:e.getImgs(),icons:e.getIcons(),globalsList:e.getGlobalsList()}))}main();","links":"[\"wb/js/monaco.js\",\"wb/docs/data.js\",\"wb/docs/groups.js\",\"wb/js/ide.js\"]","remark":"Integrated development environment"},"events":{"initialize":"let obj=new Wb.ide.IDE(parentContainer,_$args$_);if(parentContainer)app.app=obj;else globalThis.app=obj;"},"_icon":"module","title":"@ide","icon":"devtool","img":"","hideInMenu":"false","_expanded":true,"tags":"{url: 'ide', newWin: true}"}