{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","remark":"IDE server side common actions","serverScript":"Wb.load('./ide-ss.js');\nlet actions = {\n  /**\n   * Create query modules.\n   */\n  createQuery() {\n    let generator = new Wb.ide.Generator(Params);\n\n    generator.buildQuery();\n  },\n  /**\n   * Create crud modules.\n   */\n  createCRUD() {\n    let generator = new Wb.ide.Generator(Params);\n\n    generator.buildCRUD();\n  },\n  /**\n   * Create source data.\n   */\n  createSource() {\n    let generator = new Wb.ide.Generator(Params), modulePath = Params.modulePath, params = Params.params;\n\n    if (modulePath) {\n      params &&= Wb.parse(params);\n      Wb.invoke(new Wb.File(modulePath).modulePath, params);\n    } else {\n      Wb.send(generator.getSourceData());\n    }\n  },\n  /**\n   * Provide JS completion.\n   */\n  jsProvider() {\n    const predefinedCls = ['com', 'edu', 'java', 'javax', 'javafx', 'org', 'jakarta'];\n    let result, searcher, isPack;\n\n    try {\n      let cls = Params.cls;\n      if ((cls + '.').startsWith('Packages.')) {\n        cls = cls.substr(9);\n        isPack = true;\n      } else if (cls.startsWith('Classes.'))\n        cls = Classes[cls.substr(8)].class.getName();\n      else if (!cls.includes('.') && Java.isJavaObject(globalThis[cls]))\n        cls = globalThis[cls].class.getName()\n      searcher = new Wb.ide.ClassSearcher(cls);\n      if (!Java.isJavaObject(Wb.getNS(cls)) && !isPack && !predefinedCls.includes(cls.firstItem('.')))\n        result = searcher.getJSMembers(cls)\n      else\n        result = searcher.getJavaMembers(cls) || searcher.getClassMembers(cls + '.');\n    } catch (e) {\n      result = [];\n    }\n    Wb.send(result);\n  },\n  syncFile() {\n    let insert = [], module, urlBuffer = UrlBuffer.getBuffer(), path, oldData, oldItem;\n    oldData = Wb.getAllRows('select sid,path,create_user,create_date,data_role,func_class from wb_file');\n    Wb.File.moduleFolder.cascade(file => {\n      if (file.isModuleFile && !file.isMinFile || file.isFolder) {\n        path = file.modulePath;\n        if (file.isFolder) {\n          let indexFile = new Wb.File(file, 'index.json');\n          if (indexFile.exists)\n            module = indexFile.object;\n          else\n            module = null;\n        } else {\n          module = Xwl.get(path);\n        }\n        oldItem = oldData.find(item => item.path == path);\n        insert.push({\n          sid: oldItem?.sid || Wb.getId(),\n          path,\n          is_folder: file.isFolder,\n          title: module?.title,\n          url: urlBuffer.find((k, v) => v == path)?.[0] ?? null,\n          params: module?.tags,\n          hidden: Wb.parseBool(module?.hideInMenu) ? 1 : 0,\n          create_user: oldItem?.create_user || Wb.userid,\n          create_date: oldItem?.create_date || new Date(),\n          data_role: oldItem?.data_role,\n          func_class: oldItem?.func_class,\n          xwl: file.isFile ? file.text : null\n        });\n      }\n    });\n    Wb.startTrans();\n    Wb.sql('delete from wb_file');\n    Wb.sync({ tableName: 'wb_file', insert });\n  }\n};\nactions[Params.xaction]();"},"_icon":"module"}