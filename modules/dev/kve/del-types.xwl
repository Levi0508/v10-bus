{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","remark":"Delete key types","serverScript":"function main() {\n  let del = Wb.getObject('del');\n\n  Wb.sync({ tableName: 'wb_key_type', del });\n  Wb.sql({ sql: 'delete from wb_key where rid={?$sid?}', params: del });\n  del.forEach(item => { KVBuffer.buffer.remove(item.$key_name) });\n}\nmain();"},"_icon":"module"}