{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","remark":"Edit key type","serverScript":"function main() {\n  const Util = Wb.load('./util.mjs');\n  let oldKeyName = Params.$key_name;\n\n  Wb.sync({ tableName: 'wb_key_type', update: Params });\n  KVBuffer.buffer.remove(oldKeyName);\n  Util.loadKey(Params.key_name || oldKeyName);\n}\nmain();"},"_icon":"module"}