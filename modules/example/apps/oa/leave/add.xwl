{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"function main() {\n  let flow, rec;\n\n  flow = new Wb.Workflow({ file: 'example/leave.flw', title: Params.title });\n  flow.start();\n  rec = { sid: Wb.getId(), flow_id: flow.flowId, user_id: Wb.userid };\n  Wb.set(rec);\n  Wb.sync({ tableName: 'wb_leave', insert: Params });\n  Wb.send(rec);\n}\nmain();"},"_icon":"module"}