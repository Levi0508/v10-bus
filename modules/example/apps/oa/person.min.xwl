{"title":"Person Management","icon":"user3","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module"},"_icon":"module","_expanded":true,"events":{"initialize":"Wb.make(app,{cname:\"window\",layout:\"column\",resetDialog:true,padding:true,gap:true,width:\"60em\",autoScroll:true,cid:\"editWin\",items:[{cname:\"fieldset\",layout:\"grid2\",icon:\"address-book\",title:\"General Information\",collapsible:true,autoGrid:true,cid:\"generalFieldSet\",items:[{cname:\"text\",text:\"Code\",required:true,maxLength:5,cid:\"code\"},{cname:\"fileInput\",browseMode:true,gridRow:\"span 3\",text:\"Photo\",browseHeight:\"8em\",cid:\"photo\",accept:\".png\"},{cname:\"text\",text:\"Full name\",required:true,cid:\"full_name\"},{cname:\"select\",bindField:\"user_id\",forceSelect:true,text:\"Username\",valueField:\"sid\",url:\"m?xwl=sys/dialog/user-selector/select\",required:true,cid:\"user_name\",textField:\"user_name\",subtextField:\"display_name\"},{cname:\"select\",clearButton:true,gridColumn:\"span 2\",valueMap:{sid:\"dept_id\",dept_name:\"dept_name\",dept_code:\"dept_code\"},treePicker:true,text:\"Dept name\",valueField:\"sid\",url:\"m?xwl=sys/dialog/dept-selector/select\",required:true,cid:\"dept_name\",textField:\"dept_name\",subtextField:\"dept_code\"},{cname:\"date\",text:\"Birth date\",cid:\"birth_date\"},{cname:\"select\",keyName:\"gender\",text:\"Gender\",cid:\"gender\"},{cname:\"number\",minValue:0,maxValue:999,text:\"Height\",decimalCount:0,cid:\"height\"},{cname:\"text\",valueType:\"email\",text:\"Email\",cid:\"email\"},{cname:\"number\",text:\"Salary\",decimalCount:2,cid:\"salary\"}]},{cname:\"fieldset\",layout:\"fit\",flex:1,icon:\"text1\",title:\"Personal Resume\",collapsible:true,cid:\"resumeFieldSet\",items:[{cname:\"textArea\",minHeight:\"10em\",cid:\"cv\"}]}]});Wb.make(app,{cname:\"viewport\",layout:\"row\",autoContextMenu:true,cid:\"viewport1\",tbar:{cname:\"toolbar\",items:[{keys:\"Ctrl+E\",icon:\"add\",text:Str.add,cid:\