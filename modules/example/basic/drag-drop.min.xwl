{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module"},"_icon":"module","_expanded":true,"events":{"initialize":"Wb.make(app,{cname:\"viewport\",layout:\"grid1\",cid:\"viewport1\",items:[{cname:\"label\",text:\"Drag and Drop\",cls:\"w-title3\",cid:\"mainLabel\"},{cname:\"title\",title:\"Items sortable\",cid:\"sortableTitle\"},{cname:\"container\",layout:\"grid1\",cid:\"sortableCt\",frame:true,items:[{cname:\"label\",text:\"Please drag a button to adjust it's position\",cid:\"sortableLabel\"},{cname:\"container\",layout:\"form\",itemsSortable:true,cid:\"itemsSortableCt\",items:[{cname:\"button\",text:\"Button1\",cid:\"button1\"},{cname:\"button\",text:\"Button2\",cid:\"button2\"},{cname:\"button\",text:\"Button3\",cid:\"button3\"},{cname:\"button\",text:\"Button4\",cid:\"button4\"},{cname:\"button\",text:\"Button5\",cid:\"button5\"},{cname:\"button\",text:\"Button6\",cid:\"button6\"},{cname:\"button\",text:\"Button7\",cid:\"button7\"},{cname:\"button\",text:\"Button8\",cid:\"button8\"},{cname:\"button\",text:\"Button9\",cid:\"button9\"}]}]},{cname:\"title\",title:\"Grid row drag and drop\",cid:\"gridRowDragDropTitle\"},{cname:\"grid\",droppable:true,draggable:true,url:\"demo-source?xaction=staffAllDict\",cid:\"commonRemoteGrid\",height:\"15em\"},{cname:\"title\",title:\"Dual drag and drop\",cid:\"dualDragDropTitle\"},{cname:\"container\",layout:\"row\",gap:true,cid:\"dualDragDropCt\",height:\"15em\",items:[{cname:\"grid\",droppable:\"dualGroup\",draggable:true,flex:1,title:\"Source Grid\",url:\"demo-source?xaction=staffAllDict\",cid:\"grid1\",multiSelect:true,columns:[{cname:\"column\",rowNum:true,cid:\"column1\"},{cname:\"column\",fieldName:\"code\",width:\"6em\",text:\"code\",cid:\"column2\"},{cname:\"column\",fieldName:\"full_name\",width:-1,text:\"Full name\",cid:\"column3\"}]},{cname:\"grid\",droppable:\"dualGroup\",draggable:true,flex:1,title:\"Drag source to here\",cid:\"grid2\",multiSelect:true,columns:[{cname:\"column\",rowNum:true,cid:\"column1\"},{cname:\"column\",fieldName:\"code\",width:\"6em\",text:\"code\",cid:\"column2\"},{cname:\"column\",fieldName:\"full_name\",width:-1,text:\"Full name\",cid:\"column3\"}]}]},{cname:\"title\",title:\"Drag grid to panel\",cid:\"dragGridToPanelTitle\"},{cname:\"container\",layout:\"row\",gap:true,cid:\"dragGridToPanelCt\",height:\"15em\",items:[{cname:\"grid\",dropGroup:\"panelGroup\",draggable:true,flex:1,title:\"Source Grid\",url:\"demo-source?xaction=staffAllDict\",cid:\"grid1\",multiSelect:true,columns:[{cname:\"column\",rowNum:true,cid:\"column1\"},{cname:\"column\",fieldName:\"code\",width:\"6em\",text:\"code\",cid:\"column2\"},{cname:\"column\",fieldName:\"full_name\",width:-1,text:\"Full name\",cid:\"column3\"}],events:{itemdrag(e,t,a){e.allowDrop=e.source.every((e=>parseInt(e.data.code)%2));e.mode=\"append\";e.autoDrop=false},itemdrop(e,t,a){let o=[];e.source.forEach((e=>{o.push({cname:\"text\",text:e.data.full_name})}));o=app.dropPanel.add(o);o[0].intoView();o.each((e=>e.highlight()));Wb.destroy(e.source)}}},{cname:\"panel\",droppable:\"panelGroup\",layout:\"grid1\",flex:1,title:\"Drag odd code rows to here\",cid:\"dropPanel\"}]},{cname:\"title\",title:\"Asynchronous drag and drop\",cid:\"asyncDragDropTitle\"},{cname:\"grid\",droppable:\"asyncGroup\",draggable:{autoDrop:false},url:\"demo-source?xaction=staffAllDict\",cid:\"asyncDragDropGrid\",height:\"15em\",columns:[{cname:\"column\",rowNum:true,cid:\"column1\"},{cname:\"column\",fieldName:\"code\",width:\"6em\",text:\"code\",cid:\"column2\"},{cname:\"column\",fieldName:\"full_name\",width:-1,text:\"Full name\",cid:\"column3\"}],events:{itemdrop(e,t,a){Wb.ajax({url:\"demo-source?xaction=staffDict\",params:{code:e.source[0].data.code},success(t){if(t.length)e.acceptDrop();else Wb.tipWarn(\"Only allow dragging odd code row.\")}})}}}]});"}}