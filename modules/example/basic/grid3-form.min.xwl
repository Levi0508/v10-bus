{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module"},"_icon":"module","_expanded":true,"events":{"initialize":"Wb.make(app,{cname:\"viewport\",layout:\"grid3\",cid:\"viewport1\",items:[{cname:\"label\",text:\"Employee onboarding\",cls:\"w-title3\",cid:\"titleLabel\"},{cname:\"title\",title:\"Basic information\",cid:\"basicInfoTitle\"},{cname:\"text\",text:\"Name\",required:true,cid:\"name\"},{cname:\"select\",keyName:\"gender\",text:\"Gender\",required:true,cid:\"gender\"},{cname:\"date\",text:\"Birthdate\",required:true,cid:\"birthdate\"},{cname:\"title\",title:\"Education\",cid:\"eduInfoTitle\"},{cname:\"text\",text:\"Degree\",cid:\"degree\"},{cname:\"text\",text:\"University\",cid:\"university\"},{cname:\"text\",text:\"Major\",cid:\"major\"},{cname:\"title\",title:\"Department\",cid:\"deptTitle\"},{cname:\"text\",gridColumn:\"span 2\",text:\"Department\",cid:\"department\"},{cname:\"text\",text:\"Duty\",cid:\"duty\"},{cname:\"text\",gridColumn:\"span 2\",text:\"Probation period\",cid:\"period\"},{cname:\"date\",text:\"Entry Date\",cid:\"entryDate\"},{cname:\"text\",gridColumn:\"span 2\",text:\"Project\",cid:\"project\"},{cname:\"number\",minValue:1e3,prefix:\"$\",text:\"Salary\",cid:\"salary\"},{cname:\"text\",gridColumn:\"span 3\",text:\"Address\",cid:\"address\"},{cname:\"title\",title:\"Comments\",cid:\"commentTitle\"},{cname:\"textArea\",gridColumn:\"span 3\",text:\"Office\",cid:\"office\",height:\"5em\"},{cname:\"textArea\",gridColumn:\"span 3\",text:\"Manager\",cid:\"manager\",height:\"5em\"},{cname:\"textArea\",gridColumn:\"span 3\",text:\"CEO\",cid:\"ceo\",height:\"5em\"},{cname:\"button\",icon:\"save\",gridColumn:\"span 3\",text:\"Save Form\",type:\"primary\",cid:\"button1\",events:{click(e,t){Wb.ajax({url:xpath,comps:app.viewport1,success(){Wb.tipDone()}})}}}]});"}}