{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"Wb.set({delDisabled:!Wb.permit(\"example/crud/dict-edit-dialog/del\")});"},"_icon":"module","_expanded":true,"events":{"initialize":"Wb.make(app,{cname:\"viewport\",padding:true,html:'<div>This example demonstrates how a component\\'s \"visible\" property bind to a specified module. If the module\\n  is accessible, it is visible, otherwise it is hidden.</div>\\n<ul>\\n  <li>addBtn is binded to example/crud/dict-edit-dialog/add.xwl</li>\\n  <li>editBtn is binded to example/crud/dict-edit-dialog/edit.xwl</li>\\n  <li>delBtn \"disabled\" property is binded to \"delDisabled\" which set in serverScript.</li>\\n</ul>',cid:\"viewport1\",tbar:{cname:\"toolbar\",items:[{keys:\"Ctrl+E\",visible:_$004RJWJ8ZC642$_,bindModule:\"example/crud/dict-edit-dialog/add.xwl\",icon:\"add\",text:Str.add,cid:\"addBtn\"},{keys:\"Ctrl+J\",visible:_$004RJWJ8ZC643$_,bindModule:\"example/crud/dict-edit-dialog/edit.xwl\",icon:\"edit\",text:Str.edit,cid:\"editBtn\"},{keys:\"Ctrl+D\",icon:\"delete\",disabled:_$delDisabled$_,text:Str.del,cid:\"delBtn\"}]}});"},"moduleMap":{"example/crud/dict-edit-dialog/add.xwl":"004RJWJ8ZC642","example/crud/dict-edit-dialog/edit.xwl":"004RJWJ8ZC643"}}