{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module"},"_icon":"module","_expanded":true,"events":{"initialize":"Wb.make(app,{cname:\"viewport\",layout:\"grid1\",cid:\"viewport1\",items:[{cname:\"label\",text:\"Scrollbar\",cls:\"w-title3\",cid:\"mainLabel\"},{cname:\"title\",title:\"Overflow visible by default\",cid:\"defaultTitle\"},{cname:\"component\",padding:true,margin:\"0 0 1em 0\",html:\"No scrollbar by default<br>\\nand overflow content will be displayed<br>\\n(overflow content)\",cid:\"defaultComp\",height:\"3em\",frame:true},{cname:\"title\",title:\"Overflow hidden\",cid:\"overflowHiddenTitle\"},{cname:\"component\",padding:true,html:\"No scrollbar<br>\\nand overflow content will be hidden<br>\\n(overflow content)\",autoScroll:false,cid:\"overflowHiddenComp\",height:\"3em\",frame:true},{cname:\"title\",title:\"Overflow scroll\",cid:\"overflowScrollTitle\"},{cname:\"component\",padding:true,html:\"Enable scrollbar<br>\\nscrollbar is auto<br>\\n(overflow content)\",autoScroll:true,cid:\"overflowScrollComp\",height:\"3em\",frame:true},{cname:\"title\",title:\"Overflow scroll with auto show scrollbar\",cid:\"overflowScrollAutoTitle\"},{cname:\"component\",padding:true,html:\"Enable scrollbar<br>\\ndisplay scrollbars only when hovering<br>\\n(overflow content)\",autoScroll:\"auto\",cid:\"overflowScrollAutoComp\",height:\"3em\",frame:true},{cname:\"title\",title:\"Overflow scroll without show scrollbar\",cid:\"overflowScrollNoBarTitle\"},{cname:\"component\",padding:true,html:\"Enable scrollbar<br>\\nalways hide scroll bars<br>\\n(overflow content)\",autoScroll:\"hide\",cid:\"overflowScrollNoBarComp\",height:\"3em\",frame:true}]});"}}