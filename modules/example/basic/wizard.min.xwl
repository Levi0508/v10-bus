{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module"},"_icon":"module","events":{"initialize":"Wb.apply(app,{setButtons(){let t=app.cardCt1,e=t.activeIndex;app.prevBtn.disabled=e==0;app.nextBtn.disabled=e>=t.items.length-1}});Wb.make(app,{cname:\"viewport\",layout:\"middle\",background:\"true\",autoScroll:true,cid:\"viewport1\",items:[{cname:\"cardCt\",padding:true,buttonAlign:\"center\",minButtonWidth:\"8em\",width:\"40em\",icon:\"database\",cls:\"w-limit-width\",title:\"Application wizard\",cid:\"cardCt1\",height:\"20em\",frame:true,buttons:[{cname:\"button\",icon:\"left4\",text:\"Previous\",cid:\"prevBtn\",events:{click(t,e){app.cardCt1.activeIndex--;app.setButtons()}}},{cname:\"button\",icon:\"right4\",iconAlign:\"right\",text:\"Next\",cid:\"nextBtn\",events:{click(t,e){app.cardCt1.activeIndex++;app.setButtons()}}}],events:{ready(t,e){app.setButtons()}},items:[{cname:\"container\",text:\"Step1\",cid:\"container1\"},{cname:\"container\",text:\"Step2\",cid:\"container2\"},{cname:\"container\",text:\"Step3\",cid:\"container3\"},{cname:\"container\",text:\"Step4\",cid:\"container4\"}]}]});"},"_expanded":true}