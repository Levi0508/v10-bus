{"title":"","icon":"calendar","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module"},"_icon":"module","_expanded":true,"events":{"initialize":"Wb.make(app,{cname:\"viewport\",layout:\"grid1\",cid:\"viewport1\",items:[{cname:\"label\",text:\"Date and Time\",cls:\"w-title3\",cid:\"mainLabel\"},{cname:\"title\",title:\"Date\",cid:\"dateTitle\"},{cname:\"container\",layout:\"form\",cid:\"dateCt\",frame:true,items:[{cname:\"date\",text:\"Common\",cid:\"commonDate\"},{cname:\"date\",minValue:(new Date).addDay(-7),maxValue:(new Date).addDay(7),text:\"Constraint Value\",cid:\"constraintDate\"},{cname:\"controlCt\",layout:\"row\",gap:\"1em\",text:\"Date Range\",cid:\"dateRangeControlCt\",items:[{cname:\"date\",cid:\"fromDate\"},{cname:\"label\",text:\"to\",cid:\"toLabel\"},{cname:\"date\",beginDate:\"fromDate\",rangeOffset:3,cid:\"toDate\"}]}]},{cname:\"title\",title:\"Time\",cid:\"timeTitle\"},{cname:\"container\",layout:\"form\",cid:\"timeCt\",frame:true,items:[{cname:\"time\",text:\"Common\",cid:\"commonTime\"},{cname:\"time\",localFormat:\"timeText12\",clearButton:true,width:\"22em\",text:\"Local Format\",cid:\"localFormatTime\"}]},{cname:\"title\",title:\"Datetime\",cid:\"dateTimeTitle\"},{cname:\"container\",layout:\"form\",cid:\"datetimeCt\",frame:true,items:[{cname:\"datetime\",text:\"Common\",cid:\"commonDateTime\"}]},{cname:\"title\",title:\"Others\",cid:\"othersTitle\"},{cname:\"container\",layout:\"form\",cid:\"othersCt\",frame:true,items:[{cname:\"yearMonth\",text:\"Year Month\",cid:\"yearMonth1\"}]},{cname:\"title\",title:\"Display date/time prompt window through methods\",cid:\"promptTitle\"},{cname:\"label\",text:\"There are different dialog representations on the desktop and touch mode.\",cid:\"tipLabel\"},{cname:\"container\",layout:\"form\",cid:\"promptCt\",frame:true,items:[{cname:\"button\",text:\"Prompt Date auto\",cid:\"dateAutoBtn\",events:{click(t,e){Wb.promptDate((t=>Wb.tip(t.dateText)),new Date,\"Select Date\")}}},{cname:\"button\",text:\"Prompt Date Drawer\",cid:\"dateDrawerBtn\",events:{click(t,e){Wb.promptDate((t=>Wb.tip(t.dateText)),new Date,\"Select Date\",true)}}},{cname:\"button\",text:\"Prompt Date Dialog\",cid:\"dateDialogBtn\",events:{click(t,e){Wb.promptDate((t=>Wb.tip(t.dateText)),new Date,\"Select Date\",false)}}},{cname:\"button\",text:\"Prompt Time Drawer\",cid:\"timeDrawerBtn\",events:{click(t,e){Wb.promptTime((t=>Wb.tip(t.timeText)),null,null,true)}}},{cname:\"button\",text:\"Prompt Time Dialog\",cid:\"timeDialogBtn\",events:{click(t,e){Wb.promptTime((t=>Wb.tip(t.timeText)),null,null,false)}}},{cname:\"button\",text:\"Prompt Datetime Drawer\",cid:\"dateTimeDrawerBtn\",events:{click(t,e){Wb.promptDateTime((t=>Wb.tip(t.dateTimeText)),null,null,true)}}},{cname:\"button\",text:\"Prompt Datetime Dialog\",cid:\"dateTimeDialogBtn\",events:{click(t,e){Wb.promptDateTime((t=>Wb.tip(t.dateTimeText)),null,null,false)}}},{cname:\"button\",text:\"Prompt Month Drawer\",cid:\"monthDrawerBtn\",events:{click(t,e){Wb.promptMonth((t=>Wb.tip(t.format(\"y-M\"))),null,null,true)}}},{cname:\"button\",text:\"Prompt Month Dialog\",cid:\"monthDialogBtn\",events:{click(t,e){Wb.promptMonth((t=>Wb.tip(t.format(\"y-M\"))),null,null,false)}}},{cname:\"button\",text:\"Prevent Close\",cid:\"preventCloseBtn\",events:{click(t,e){Wb.promptDate((t=>{Wb.tip(\"Close prevented\");return false}))}}}]}]});"}}