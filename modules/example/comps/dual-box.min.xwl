{"title":"","icon":"dual-box","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module"},"_icon":"module","_expanded":true,"events":{"initialize":"Wb.make(app,{cname:\"viewport\",layout:\"grid1\",cid:\"viewport1\",items:[{cname:\"label\",text:\"DualBox\",cls:\"w-title3\",cid:\"mainLabel\"},{cname:\"title\",title:\"Local data\",cid:\"localDataTitle\"},{cname:\"label\",text:\"Use local data to select\",cid:\"localDataLabel\"},{cname:\"dualBox\",destData:[{code:\"10007\",full_name:\"Ovidiu Cracium\"},{code:\"10008\",full_name:\"Janice Galvin\"},{code:\"10009\",full_name:\"Thierry D'Hers\"}],sourceData:[{code:\"10001\",full_name:\"Terri Duffy\"},{code:\"10002\",full_name:\"Roberto Tamburello\"},{code:\"10003\",full_name:\"Michael Sullivan\"},{code:\"10004\",full_name:\"Sharon Salavaria\"},{code:\"10005\",full_name:\"Gail Erickson\"},{code:\"10006\",full_name:\"Jossef Goldberg\"}],cid:\"localDataDualBox\",height:\"15em\",textField:\"full_name\",subtextField:\"code\"},{cname:\"button\",justifySelf:\"start\",text:\"Get Selected Data\",cid:\"getSelectedDataBtn\",events:{click(e,a){Wb.tip(\"Selected: \"+Wb.encode(app.localDataDualBox.destData))}}},{cname:\"title\",title:\"Remote data\",cid:\"remoteDataTitle\"},{cname:\"label\",text:\"Use remote data to select and sync selections in database\",cid:\"remoteDataLabel\"},{cname:\"dualBox\",sourceUrl:\"demo-source?xaction=selectNoneAdminStaff\",searchBar:true,autoLoad:false,destUrl:\"demo-source?xaction=selectAdminStaff\",cid:\"remoteDataDualBox\",height:\"15em\",sourceGridConfigs:{cname:\"grid\",title:\"User List\"},destGridConfigs:{cname:\"grid\",title:\"Admin Users\"},events:{beforemove(e,a,t){Wb.ajax({url:xpath+\"/sync-select\",params:{items:e,include:a},success:e=>{this.acceptMove()}});return false},ready(e,a){let t=this;t.sourceGrid.pageSize=10;t.sourceGrid.load();t.destGrid.pageSize=10;t.destGrid.load()}}},{cname:\"title\",title:\"Customize Columns\",cid:\"customizeColsTitle\"},{cname:\"label\",text:\"Customize grid columns\",cid:\"customizeColsLabel\"},{cname:\"dualBox\",sourceUrl:\"demo-source?xaction=staffDict\",gridHeader:true,cid:\"customizeColsDualBox\",height:\"15em\",columns:[{cname:\"column\",rowNum:true,cid:\"rowNumCol\"},{cname:\"column\",fieldName:\"code\",text:\"Code\",cid:\"codeCol\"},{cname:\"column\",fieldName:\"full_name\",width:-1,text:\"Full name\",cid:\"fullNameCol\"}],sourceGridConfigs:{cname:\"grid\",pagingBar:false}}]});"}}