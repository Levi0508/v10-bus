{"title":"","icon":"options","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module"},"_icon":"module","_expanded":true,"events":{"initialize":"Wb.make(app,{cname:\"viewport\",layout:\"grid1\",autoScroll:true,cid:\"viewport1\",items:[{cname:\"label\",text:\"Option\",cls:\"w-title3\",cid:\"mainLabel\"},{cname:\"title\",title:\"Common Options\",cid:\"commonTitle\"},{cname:\"container\",cid:\"optionCt\",frame:true,items:[{cname:\"option\",border:\"bottom\",valueText:\"Value text\",text:\"Common options, click show dialog\",cid:\"commonOption\",events:{click(e,t){app.dialog1??=new Wb.Dialog({title:\"New dialog\",border:0,defaults:{cname:\"option\"},items:[{cname:\"label\",text:\"Group1\",indent:true,titleType:\"title5\"},{text:\"Option1\",handler(){Wb.tip(\"Option1 clicked\")}},{text:\"Option2\",handler(){Wb.tip(\"Option2 clicked\")}},\"-\",{cname:\"label\",text:\"Group2\",indent:true,titleType:\"title5\"},{text:\"Option3\",editor:{cname:\"toggle\"}},{text:\"Option4\",editor:{cname:\"toggle\"}}]});app.dialog1.show()}}},{cname:\"option\",border:\"bottom\",optionsTitle:\"Select Browser\",options:[{text:\"Chrome\",value:1,_icon:\"chrome\"},{text:\"Edge\",value:2,_icon:\"edge\",_selected:true},{text:\"Firefox\",value:3,_icon:\"firefox\"},{text:\"Safari\",value:4,_icon:\"safari\"}],description:\"The default browser to be used\",text:\"Web browser\",value:2,cid:\"checkedItemsOption\"},{cname:\"option\",border:\"bottom\",text:\"Option with toggle\",cid:\"toggleOption\",editor:{cname:\"toggle\"}},{cname:\"option\",border:\"bottom\",allowClick:false,text:\"Option with toggle, only allow click on the toggle component\",cid:\"toggleClickOnToggleOption\",editor:{cname:\"toggle\"}},{cname:\"option\",border:\"bottom\",icon:\"calendar\",flagIcon:\"menu\",text:\"Option with icon\",cid:\"iconOption\",events:{click(e,t){Wb.tip(\"clicked\")}}},{cname:\"option\",border:\"bottom\",valueText:\"Some value\",icon:\"message\",flagIcon:\"share1\",text:\"Custom option\",cid:\"customOption\",events:{ready(e,t){let o=this.el.insertElBefore(\"w-unselect\",\"img\",this.flagEl);o.src=\"wb/images/order.png\";o.draggable=false},click(e,t){Wb.tip(\"clicked\")}}},{cname:\"option\",disabled:true,text:\"Disabled option\",cid:\"disabledOption\"}]},{cname:\"title\",title:\"Editor Options\",cid:\"editorTitle\"},{cname:\"container\",layout:\"grid1\",background:\"true\",cid:\"editorCt\",items:[{cname:\"line\",title:\"Option style\",cid:\"line1\"},{cname:\"container\",roundBorder:true,defaults:{labelWidth:\"8em\"},background:\"false\",cid:\"optionCt1\",items:[{cname:\"option\",border:\"bottom\",text:\"Name\",cid:\"nameOption\",editor:{cname:\"text\",flex:1,flat:true,placeholder:\"Your name\"}},{cname:\"option\",border:\"bottom\",text:\"Height (cm)\",cid:\"heightOption\",editor:{cname:\"number\",flex:1,flat:true,placeholder:\"Your height\"}},{cname:\"option\",border:\"bottom\",optionsTitle:\"Select Gender\",options:[\"Male\",\"Female\"],text:\"Gender\",cid:\"genderOption\"},{cname:\"option\",text:\"Status\",cid:\"statusOption\",editor:{cname:\"toggle\"}}]},{cname:\"line\",title:\"Form style\",cid:\"line2\"},{cname:\"container\",roundBorder:true,background:\"false\",tableStyle:\"simple\",cid:\"optionCt2\",defaults:{cname:\"text\",labelSeparator:false,labelWidth:\"8em\"},items:[{cname:\"text\",text:\"Name\",placeholder:\"Your name\",cid:\"name\"},{cname:\"number\",text:\"Height (cm)\",placeholder:\"Your height\",cid:\"height\"},{cname:\"select\",data:[\"Male\",\"Female\"],text:\"Gender\",placeholder:\"Male / Female\",cid:\"gender\"},{cname:\"option\",border:\"bottom\",optionsTitle:\"Select Gender\",options:[\"Male\",\"Female\"],text:\"Gender Option\",cid:\"genderOption\"},{cname:\"toggle\",text:\"Status\",cid:\"status\"}]}]}]});"}}