{"title":"","icon":"list-view","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","links":"[\"wb/css/demo.css\"]","description":"demo-source=example/common/demo-source.xwl"},"_icon":"module","_expanded":true,"events":{"initialize":"Wb.apply(app,{viewData:[{icon:\"user\",text:\"User Management\"},{icon:\"support\",text:\"Support Service\"},{icon:\"list\",text:\"Consumption List\"},{icon:\"preview\",text:\"Disabled Item\",_disabled:true,_tip:\"This item is disabled\"},{icon:\"gear\",text:\"System Settings\"},{icon:\"truck\",text:\"The text content of this item is too long and maybe overflowed\"},{icon:\"database\",text:\"Database Management\"},{icon:\"flow1\",text:\"WorkFlow Design\"}]});Wb.make(app,{cname:\"viewport\",layout:\"grid1\",cid:\"viewport1\",items:[{cname:\"label\",text:\"View\",cls:\"w-title3\",cid:\"mainLabel\"},{cname:\"title\",title:\"Common view\",cid:\"commonViewTitle\"},{cname:\"label\",text:\"Define the content of ViewItem by defining itemTpl.\",cid:\"commonItemTplViewLabel\"},{cname:\"view\",layout:\"column\",data:app.viewData,cid:\"commonItemTplView\",itemTpl:'<div class=\"w-row w-align-center w-gapd5 w-padding\">\\n  <div class=\"w-icon icon-{icon}\"></div>\\n  <div class=\"w-name\">{text}</div>\\n</div>',height:\"15em\"},{cname:\"label\",text:\"Define the content of ViewItem by defining itemTplFn.\",cid:\"commonItemTplFnViewLabel\"},{cname:\"view\",layout:\"column\",data:app.viewData,itemTplFn(e,t){return`<div class=\"w-row w-align-center w-gapd5 w-padding\">\\n  <div class=\"w-icon icon-${Wb.toHTML(e.icon)}\"></div>\\n  <div class=\"w-name\">${Wb.toHTML(e.text)}</div>\\n</div>`},cid:\"commonItemTplFnView\",height:\"15em\",frame:true},{cname:\"title\",title:\"Customized item itself\",cid:\"customItemViewTitle\"},{cname:\"label\",text:'Define ViewItem itself by identifying the \"w-item\" class in itemTpl.',cid:\"customItemViewLabel\"},{cname:\"label\",text:\"Fixed 4 columns\",cid:\"fixed4ColumnsLabel\"},{cname:\"view\",data:app.viewData,resizable:true,bodyCls:\"w-grid4 w-padding w-gapd5\",cid:\"fixed4ColumnsView\",itemTpl:'<div class=\"w-item w-column w-align-center w-padding w-gapd5\">\\n  <div class=\"w-size2 w-icon icon-{icon}\"></div>\\n  <div class=\"w-label w-ta-center\">{text}</div>\\n</div>',frame:true},{cname:\"label\",text:\"Auto wrap items with fixed item width\",cid:\"autoWrapItemsLabel\"},{cname:\"view\",data:app.viewData,resizable:true,bodyCls:\"w-form w-padding w-gapd5\",cid:\"autoWrapView\",itemTpl:'<div class=\"w-item w-column w-align-center w-padding w-gapd5\" style=\"width:10em\">\\n  <div class=\"w-size2 w-icon icon-{icon}\"></div>\\n  <div class=\"w-name w-ta-center w-aligns-stretch\">{text}</div>\\n</div>',frame:true},{cname:\"label\",text:\"No wrap items with fixed item width and stick selection\",cid:\"noWrapItemsLabel\"},{cname:\"view\",data:app.viewData,stickSelect:true,resizable:true,bodyCls:\"w-row w-padding w-gapd5 w-visible-all\",cid:\"noWrapView\",itemTpl:'<div class=\"w-item w-column w-align-center w-padding w-gapd5 w-no-shrink\" style=\"width:10em\">\\n  <div class=\"w-size2 w-icon icon-{icon}\"></div>\\n  <div class=\"w-name w-ta-center w-aligns-stretch\">{text}</div>\\n</div>',multiSelect:true,frame:true},{cname:\"title\",title:\"Various template syntax\",cid:\"variousTemplateSyntaxTitle\"},{cname:\"label\",text:\"Use itemTpl\",cid:\"useItemTplLabel\"},{cname:\"view\",layout:\"column\",data:[{num:1,money:581234.56,date:new Date,array:[\"item1\",\"item2\",\"item3\"]},{num:2,money:324549.7,date:new Date,array:[\"item4\",\"item5\",\"item6\"]},{num:3,money:53543.28,date:new Date,array:[\"item7\",\"item8\",\"item9\"]}],resizable:true,cid:\"variousItemTplSyntaxView\",itemTpl:'\\x3c!-- Tip: For complex templates, it is recommended to use itemTplFn to define custom function --\\x3e\\n<div class=\"w-item w-border\" style=\"display:grid;grid-template-columns:2em 8em 16em 1fr;padding:1em;gap:.5em\">\\n  <div>{num}</div>\\n  <div>{[data.money.usd]}</div>\\n  <div>{[data.date.dateTimeText12]}</div>\\n  <div>{for data.array}{if index > 0}<span>, </span>{/if}<span>{[index + 1]}: </span><span>{[value]}</span>{/for}</div>\\n</div>',frame:true},{cname:\"label\",text:\"Use itemTplFn with fixed header\",cid:\"useItemTplFnLabel\"},{cname:\"view\",layout:\"column\",data:[{num:1,money:581234.56,date:new Date,array:[\"item1\",\"item2\",\"item3\"]},{num:2,money:324549.7,date:new Date,array:[\"item4\",\"item5\",\"item6\"]},{num:3,money:53543.28,date:new Date,array:[\"item7\",\"item8\",\"item9\"]}],resizable:true,itemTplFn(e,t){let i=\"\";e.array.forEach(((e,t)=>{if(t>0)i+=\"<span>, </span>\";i+=\"<span>\"+(t+1)+\": </span><span>\"+Wb.toHTML(e)+\"</span>\"}));return`<div class=\"w-item w-border\" style=\"display:grid;grid-template-columns:2em 8em 16em 1fr;padding:1em;gap:.5em\">\\n  <div>${Wb.toHTML(e.num)}</div>\\n  <div>${Wb.toHTML(e.money.usd)}</div>\\n  <div>${Wb.toHTML(e.date.dateTimeText12)}</div>\\n  <div>${i}</div>\\n</div>`},html:'<div class=\"w-fixed-bgcolor\" style=\"display:grid;grid-template-columns:2em 8em 16em 1fr;padding:1em;gap:.5em\">\\n  <div></div>\\n  <div>Money</div>\\n  <div>Date</div>\\n  <div>Content</div>\\n</div>\\n<div class=\"w-items w-flex\">\\n</div>',cid:\"useItemTplFnView\",frame:true,height:\"12em\"},{cname:\"title\",title:\"Name list with remote data\",cid:\"nameListTitle\"},{cname:\"label\",text:\"A common way to display a list of names with remote data and remote pagination.\",cid:\"nameListLabel\"},{cname:\"view\",resizable:true,pagingBar:true,pageSize:10,url:\"demo-source?xaction=staffDict\",cid:\"nameListView\",itemTpl:'<div class=\"w-item w-border w-row w-padding w-align-center w-gapd5\">\\n  <div class=\"w-icon icon-user2 w-size2\"></div>\\n  <div class=\"w-column w-gapd2\">\\n    <div class=\"w-name\">{full_name}</div>\\n    <div class=\"w-name w-sub-color w-sized8\">{code}</div>\\n  </div>\\n  <div class=\"w-flex\"></div>\\n  <div class=\"w-column w-sized8 w-gapd2\">\\n    <div class=\"w-name\">{[new Date().format(\\'HH:mm\\')]}</div>\\n    <div class=\"w-icon icon-flag4 w-sub-color w-aligns-end\"></div>\\n  </div>\\n</div>',frame:true,height:\"20em\"},{cname:\"title\",title:\"Tag style list\",cid:\"tagListTitle\"},{cname:\"label\",text:\"Display a list of tags with customized css and closed button.\",cid:\"tagListLabel\"},{cname:\"view\",resizable:true,captureClass:\".w-close-btn\",cls:\"d-tag\",bodyCls:\"w-form w-padding w-gapd5\",url:\"demo-source?xaction=staffDict\",cid:\"tagListView\",itemTpl:'<div class=\"w-item w-row w-padding w-align-center w-gapd5\">\\n  <div class=\"w-icon icon-tag\"></div>\\n  <div class=\"w-name\">{full_name}</div>\\n  <div class=\"w-btn w-close-btn w-btn-light\">\\n    <div class=\"w-icon icon-close\"></div>\\n  </div>\\n</div>',frame:true,height:\"15em\",multiSelect:true,rectSelect:true,events:{captureclick(e,t){e.destroy()}}},{cname:\"title\",title:\"Pagination display\",cid:\"pagingTitle\"},{cname:\"label\",text:\"Remote data pagination\",cid:\"remoteDataPagingLabel\"},{cname:\"view\",resizable:true,pagingBar:\"pageNums\",pageSize:10,url:\"demo-source?xaction=staffDict\",cid:\"remotePagingView\",itemTpl:'<div class=\"w-padding\">{code} - {full_name}</div>',frame:true,height:\"20em\"},{cname:\"label\",text:\"Caching remote data and paging locally.\",cid:\"cachedPagingLabel\"},{cname:\"view\",resizable:true,cached:true,pagingBar:\"pageNums\",pageSize:10,url:\"demo-source?xaction=staffDict\",cid:\"cachedPagingView\",itemTpl:'<div class=\"w-padding\">{code} - {full_name}</div>',frame:true,height:\"20em\"},{cname:\"label\",text:\"Local data pagination\",cid:\"localDataPagingLabel\"},{cname:\"view\",layout:\"column\",resizable:true,localData:[{text:\"item1\"},{text:\"item2\"},{text:\"item3\"},{text:\"item4\"},{text:\"item5\"},{text:\"item6\"},{text:\"item7\"},{text:\"item8\"},{text:\"item9\"},{text:\"item10\"},{text:\"item11\"},{text:\"item12\"},{text:\"item13\"},{text:\"item14\"},{text:\"item15\"},{text:\"item16\"},{text:\"item17\"},{text:\"item18\"},{text:\"item19\"}],pagingBar:true,pageSize:10,cid:\"localDataPagingView\",height:\"15em\",frame:true,itemTpl:'<div class=\"w-padding\">{text}</div>'},{cname:\"label\",text:\"Auto load next page when scroll to the bottom\",cid:\"bottomNextPageLabel\"},{cname:\"view\",resizable:true,pageSize:10,autoPaging:true,url:\"demo-source?xaction=staffDict\",cid:\"bottomNextPageView\",itemTpl:'<div class=\"w-item w-padding1\">{code} - {full_name}</div>',frame:true,height:\"20em\"},{cname:\"label\",text:\"Auto load next page when scroll to the top\",cid:\"topNextPageLabel\"},{cname:\"view\",autoToBottom:true,resizable:true,pageSize:10,autoPaging:false,reverseData:true,url:\"demo-source?xaction=staffDictDesc\",cid:\"topNextPageView\",itemTpl:'<div class=\"w-item w-padding1\">{code} - {full_name}</div>',frame:true,height:\"20em\"},{cname:\"title\",title:\"Miscillaneous view\",cid:\"miscViewTitle\"},{cname:\"view\",padding:\"2em\",data:app.viewData,resizable:true,bodyCls:\"w-grid4\",layout:\"grid4\",droppable:\"demo.miscView\",keyWalking:true,draggable:true,gap:\"2em\",reserveScrollbar:true,cid:\"miscView\",itemTpl:'<div class=\"w-item w-column w-align-center w-padding w-gapd5\">\\n  <div class=\"w-size2 w-icon icon-{icon}\"></div>\\n  <div class=\"w-label w-ta-center\">{text}</div>\\n</div>',multiSelect:true,rectSelect:true,frame:true,tbar:{cname:\"toolbar\",gap:\".5em\",items:[{text:\"Select\",cid:\"selectItem\",events:{click(e,t){let i=app.miscView;i.selection=[i.items[0],i.items[1]]}}},{text:\"Deselect\",cid:\"deselectItem\",events:{click(e,t){app.miscView.deselectAll()}}},{text:\"Add\",cid:\"addItem\",events:{click(e,t){let i=app.miscView.addData({text:\"New Item\",icon:\"earth\"});i.selected=true;i.highlight()}}},{text:\"Insert\",cid:\"insertItem\",events:{click(e,t){let i=app.miscView.insertData(1,{text:\"Insert Item\",icon:\"record\"});i.selected=true;i.highlight()}}},{text:\"Delete\",cid:\"deleteItem\",events:{click(e,t){app.miscView.firstItem?.destroy()}}},{text:\"Delete selections\",cid:\"deleteSelectionsItem\",events:{click(e,t){let i=app.miscView;if(!i.selections.length){Wb.tipSelect();return}i.destroySelections()}}},{text:\"Update\",cid:\"updateItem\",events:{click(e,t){let i=app.miscView.items[0];if(i){i.set(\"text\",\"Updated\");i.set(\"icon\",\"flower\");i.focus();i.highlight()}}}}]},events:{itemdrop(e,t,i){Wb.tip(\"Drop items: \"+e.dropItems.length+\"\\nDest: \"+e.dest.data.text+\"\\nMode: \"+e.mode)}}},{cname:\"component\",textSelectable:false,html:\"<div>Feature List:</div>\\n<ul>\\n  <li>Drag to draw a rectangle to select items.</li>\\n  <li>Press key to enter name in the view can navigate to the specified item.</li>\\n  <li>Maintain scrollbar position after reloading data.</li>\\n  <li>Intelligent navigate to specified item based on arrow key direction.</li>\\n  <li>Drag-and-Drop support.</li>\\n</ul>\",cid:\"miscDescComp\"},{cname:\"title\",title:\"List view\",cid:\"listViewTitle\"},{cname:\"label\",text:\"List items in the specified pattern\",cid:\"listViewLabel\"},{cname:\"listView\",defaultFields:{_icon:{value:\"user2\"},badge:{value:8},iconvalue:{value:\"bell-off\"},datevalue:{value:new Date}},resizable:true,url:\"demo-source?xaction=staffDict\",cid:\"listView\",height:\"20em\",textField:\"full_name\",subtextField:\"code\",tbar:{cname:\"toolbar\",gap:true,events:{buttonclick(e,t,i){app.listView.viewType=e.cid}},items:[{groupName:\"viewType\",active:true,text:\"Small List\",cid:\"smallList\"},{groupName:\"viewType\",active:true,text:\"List\",cid:\"list\"},{groupName:\"viewType\",text:\"Small Icon\",cid:\"smallIcon\"},{groupName:\"viewType\",text:\"Medium Icon\",cid:\"mediumIcon\"},{groupName:\"viewType\",text:\"Big Icon\",cid:\"bigIcon\"}]}},{cname:\"title\",title:\"Icon view\",cid:\"iconViewTitle\"},{cname:\"label\",text:'Display items with a big icon and text label, set layout to \"grid4\" to display 4 fixed columns, set \"padding\" and \"gap\" to adjust space.',cid:\"iconViewLabel\"},{cname:\"iconView\",defaultFields:{badge:{value:99}},layout:\"grid4\",padding:\".5em\",data:app.viewData,resizable:true,gap:\"1em\",iconField:\"icon\",selectColor:\"active\",cid:\"iconView\",events:{itemclick(e,t,i){Wb.tip(e.data.text+\" clicked\")}}},{cname:\"title\",title:\"Check view\",cid:\"checkViewTitle\"},{cname:\"label\",text:\"Display items for single or multiple check\",cid:\"checkViewLabel1\"},{cname:\"checkView\",data:[{text:\"Chrome\",value:1,_icon:\"chrome\"},{text:\"Edge\",value:2,_icon:\"edge\",_selected:true},{text:\"Firefox\",value:3,_icon:\"firefox\"},{text:\"Safari\",value:4,_icon:\"safari\"},{text:\"Image icon\",value:5,_img:\"wb/images/chart.png\"}],cid:\"checkView1\",multiSelect:true,maxWidth:\"15em\",tbar:{cname:\"toolbar\",gap:\".5em\",items:[{text:\"Set Value\",cid:\"setValueItem\",events:{click(e,t){app.checkView1.value=[2,3]}}},{text:\"Get Value\",cid:\"getValueItem\",events:{click(e,t){Wb.tip(\"The value is: \"+Wb.encode(app.checkView1.value))}}}]}}]});"}}