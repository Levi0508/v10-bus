{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module"},"_icon":"module","_expanded":true,"events":{"initialize":"Wb.make(app,{cname:\"viewport\",layout:\"grid1\",cid:\"viewport1\",items:[{cname:\"label\",text:\"Client load module, js, mjs and css\",cls:\"w-title3\",cid:\"mainLabel\"},{cname:\"title\",title:\"Open module\",cid:\"openModuleTitle\"},{cname:\"label\",text:'Open module in \"main tab\" or new window.',cid:\"openModuleLabel\"},{cname:\"button\",text:\"Open module\",type:\"primary\",cid:\"openModuleBtn\",events:{click(e,t){Wb.open(\"m?xwl=admin/role\")}}},{cname:\"title\",title:'Open module as \"normal type\"',cid:\"openNormalModuleTitle\"},{cname:\"label\",text:'Open module in \"main tab\" or new window, and allow the page to reload/refresh.',cid:\"openNormalModuleLabel\"},{cname:\"button\",text:'Open module as \"normal type\"',type:\"primary\",cid:\"openNormalModuleBtn\",events:{click(e,t){Wb.openNormal(\"m?xwl=admin/perm\")}}},{cname:\"title\",title:\"Run module and get panel\",cid:\"runModulePanelTitle\"},{cname:\"label\",text:\"Run module and get it's content to the container.\",cid:\"runModulePanelLabel\"},{cname:\"button\",text:\"Run module\",type:\"primary\",cid:\"runModulePanelBtn\",events:{click(e,t){let n=app.runModulePanelCt;n.destroyAll();Wb.run({url:xpath+\"/panel\",success(e){n.add(e.main)}})}}},{cname:\"container\",minHeight:\"10em\",cid:\"runModulePanelCt\",frame:true},{cname:\"title\",title:\"Run module and get tab card\",cid:\"runModuleCardTitle\"},{cname:\"label\",text:\"Run module and get it's content to the new tab card.\",cid:\"runModuleCardLabel\"},{cname:\"button\",text:\"Run module\",type:\"primary\",cid:\"runModuleCardBtn\",events:{click(e,t){let n;app.cardIndex??=1;n=app.runModuleCardTab.add({title:\"Card \"+app.cardIndex++,icon:\"card\",layout:\"fit\"}).show();Wb.run({url:xpath+\"/card\",app:app,owner:n,cached:true,success(e){n.add(e.panel1);e.init()}})}}},{cname:\"tab\",minHeight:\"10em\",cid:\"runModuleCardTab\",frame:true},{cname:\"title\",title:\"Invoke window\",cid:\"invokeWindowTitle\"},{cname:\"label\",text:\"Invoke a common window and pass callback function as parameter.\",cid:\"invokeWindowLabel\"},{cname:\"button\",text:\"Invoke window\",type:\"primary\",cid:\"invokeWindowBtn\",events:{click(e,t){Wb.run({url:xpath+\"/common-window\",owner:\"window1\",success(e){e.add(3,5,((e,t)=>{Wb.tip(\"Total value is: \"+e);t.close()}))}})}}},{cname:\"title\",title:\"Invoke single module\",cid:\"invokeSingleModuleTitle\"},{cname:\"label\",text:\"Invoke a single module and pass callback function as parameter.\",cid:\"invokeSingleModuleLabel\"},{cname:\"button\",text:\"Invoke single module\",type:\"primary\",cid:\"invokeSingleBtn\",events:{click(e,t){Wb.run({url:xpath+\"/single-window\",single:true,success(e){e.add(3,5,((e,t)=>{Wb.tip(\"Total value is: \"+e);t.close()}))}})}}},{cname:\"title\",title:\"Dynamic load js/css\",cid:\"dynamicLoadJsCssTitle\"},{cname:\"label\",text:\"Use [Wb.load] method to dynamic load js/css resources. Set the [links] property of the module node to static load js/mjs/css resources, you can drag js/mjs/css files to the [links] property directly.\",cid:\"dynamicLoadJsCssLabel\"},{cname:\"button\",text:\"Dynamic load JS/CSS\",type:\"primary\",cid:\"dynamicLoadJsCssBtn\",events:{click(e,t){Wb.load([\"wb/css/demo.css\",{url:\"wb/libs/echarts.js\",async:true}],(e=>Wb.tipSucc(\"The js/css resources has been successfully loaded.\")))}}},{cname:\"label\",text:\"Dynamic import Javascript module.\",cid:\"importMJSLabel\"},{cname:\"button\",text:\"Dynamic import mjs\",type:\"primary\",cid:\"importMJSBtn\",events:{click(e,t){Wb.loadModule(xpath+\"/demo$\",(e=>Wb.tip(\"The result is: \"+e.Demo.add(3,4))))}}}]});"}}