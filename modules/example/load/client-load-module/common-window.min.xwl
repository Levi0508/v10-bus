{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module"},"_icon":"module","events":{"initialize":"Wb.apply(app,{add(e,a,i){app.number1.value=e;app.number2.value=a;app.callback=i;app.window1.show()}});Wb.make(app,{cname:\"window\",layout:\"grid1\",resetDialog:true,visible:true,closeAction:\"destroy\",title:\"Perform add\",cid:\"window1\",events:{ok(e){app.callback(app.number1.value+app.number2.value,this)}},items:[{cname:\"label\",text:\"This window from common-window.xwl\",cid:\"label1\"},{cname:\"number\",text:\"Value1\",required:true,cid:\"number1\"},{cname:\"number\",text:\"Value2\",required:true,cid:\"number2\"}]});Wb.make(app,{cname:\"window\",cid:\"thisWinAutoDestroyedAfterWindow1Destroyed\"});"},"_expanded":true}