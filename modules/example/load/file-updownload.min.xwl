{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module"},"_icon":"module","_expanded":true,"events":{"initialize":"Wb.make(app,{cname:\"viewport\",layout:\"grid1\",cid:\"viewport1\",items:[{cname:\"label\",text:\"File upload & download\",cls:\"w-title3\",cid:\"mainLabel\"},{cname:\"title\",title:\"Upload files\",cid:\"uploadTitle\"},{cname:\"container\",layout:\"grid1\",labelUp:true,cid:\"uploadCt\",frame:true,items:[{cname:\"fileInput\",text:\"Please select a file\",cid:\"singleFileInput\"},{cname:\"fileInput\",browseMode:true,multiple:true,text:\"Please select multiple files\",browseHeight:\"6em\",cid:\"multiFileInput\",accept:\"image/*\"},{cname:\"text\",text:\"Other control\",cid:\"text1\"},{cname:\"button\",text:\"Upload all\",type:\"primary\",cid:\"uploadButton\",events:{click(t,e){Wb.ajax({url:xpath+\"/actions&xaction=upload\",comps:app.uploadCt,params:{foo:\"bar\"},success(t){Wb.tipSucc('All files have been saved to \"'+t+'\".')}})}}}]},{cname:\"title\",title:\"Download files\",cid:\"downloadTitle\"},{cname:\"container\",layout:\"grid1\",cid:\"downloadCt\",frame:true,items:[{cname:\"button\",text:\"Common download wb.js\",type:\"primary\",cid:\"commonDownloadWbJsButton\",events:{click(t,e){Wb.download(xpath+\"/actions&xaction=downloadWbJs\",{foo:\"bar\"})}}},{cname:\"button\",text:\"Ajax download wb.js\",type:\"primary\",cid:\"ajaxDownloadWbJsButton\",events:{click(t,e){Wb.ajax({url:xpath+\"/actions&xaction=downloadWbJs\",download:true,params:{foo:\"bar\"},onDownload(t){Wb.progress(t)}})}}},{cname:\"button\",text:\"Download blob\",type:\"primary\",cid:\"downloadBlobButton\",events:{click(t,e){Wb.download(xpath+\"/actions&xaction=downloadBlob\")}}},{cname:\"button\",text:\"Download zip\",type:\"primary\",cid:\"downloadZipButton\",events:{click(t,e){Wb.download(xpath+\"/actions&xaction=downloadZip\")}}},{cname:\"button\",text:\"Download base64/blob\",type:\"primary\",cid:\"downloadBase64BlobButton\",events:{click(t,e){let o=\"\";Wb.downloadBase64(o,\"insert.png\")}}}]},{cname:\"title\",title:\"Download after uploading\",cid:\"downloadAfterUploadingTitle\"},{cname:\"container\",layout:\"grid1\",labelUp:true,cid:\"downloadAfterUploadingCt\",frame:true,items:[{cname:\"fileInput\",browseMode:true,multiple:true,text:\"Please select multiple files\",browseHeight:\"6em\",cid:\"multiFileInput\",accept:\"image/*\"},{cname:\"text\",text:\"Other control\",cid:\"text1\"},{cname:\"button\",text:\"Download after upload\",type:\"primary\",cid:\"downloadAfterUploadButton\",events:{click(t,e){const o=\"Uploading now, please wait...\";const a=\"Downloading now, please wait...\";Wb.ajax({url:xpath+\"/actions&xaction=downloadAfterUpload\",comps:app.downloadAfterUploadingCt,download:true,params:{foo:\"bar\"},mask:o,onUpload(t){Wb.progress(t,o)},onDownload(t){Wb.progress(t,a)},callback(){Wb.unmask(a)}})}}}]}]});"}}