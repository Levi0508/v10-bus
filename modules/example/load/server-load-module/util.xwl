{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"Wb.apply(app, {\n  /**\n   * Perform add.\n   * @param {Number} value1 Value 1\n   * @param {Number} value2 Value 2\n   * @return {Number} The result\n   */\n  add(value1, value2) {\n    return value1 + value2;\n  }\n});\nWb.log('Util.xwl runs every time.');"},"_icon":"module"}