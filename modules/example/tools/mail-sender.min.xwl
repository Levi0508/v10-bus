{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module"},"_icon":"module","_expanded":true,"events":{"initialize":"Wb.make(app,{cname:\"viewport\",layout:\"grid1\",cid:\"viewport1\",items:[{cname:\"title\",title:\"Email Sender\",cid:\"titleComp\"},{cname:\"text\",text:\"Smtp\",value:\"smtp.xxx.com\",required:true,cid:\"smtp\"},{cname:\"text\",text:\"Username\",value:\"name@xxx.com\",required:true,cid:\"username\"},{cname:\"text\",text:\"Password\",value:\"password\",required:true,cid:\"password\"},{cname:\"text\",text:\"Auth username\",value:\"name@xxx.com\",cid:\"authUsername\"},{cname:\"text\",text:\"Auth password\",value:\"someAuthNumber\",cid:\"authPassword\"},{cname:\"text\",text:\"From\",value:\"name@xxx.com\",required:true,cid:\"from\"},{cname:\"text\",text:\"To\",value:\"to@xxx.com\",required:true,cid:\"to\"},{cname:\"text\",text:\"CC\",cid:\"cc\"},{cname:\"text\",text:\"Title\",cid:\"title\"},{cname:\"textArea\",text:\"Mail Content\",value:\"Hello world\",cid:\"content\"},{cname:\"fileInput\",multiple:true,text:\"Attach Files\",cid:\"attachFiles\"},{cname:\"button\",icon:\"paper-plane\",text:\"Send\",type:\"primary\",cid:\"Send\",events:{click(e,t){if(!Wb.verify(app.viewport1))return;Wb.ajax({url:xpath+\"/send\",comps:app.viewport1,success(){Wb.tipSucc(\"The email has been successfully sent.\")}})}}}]});"}}