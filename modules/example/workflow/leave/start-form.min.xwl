{"title":"","icon":"","img":"","tags":"{container: false}","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"Wb.apply(app,{afterAction(a,e){if(e.restarting){Params.$flow_id=e.flowId;Wb.sync({tableName:\"wb_leave\",update:Params,whereFields:\"flow_id\"})}else{Wb.apply(Params,{sid:Wb.getId(),flow_id:e.flowId,user_id:e.handleUser});Wb.sync({tableName:\"wb_leave\",insert:Params})}}});"},"_icon":"module","_expanded":true,"events":{"initialize":"Wb.apply(app,{autoShow:false,init(e,a,t){if(e){Wb.ajax({url:xpath+\"/../actions&xaction=selectLeave\",params:{flowId:e},json:true,success(e){Wb.setValue(app.main,e);app.main.show()}})}else{app.main.show()}}});Wb.make(app,{cname:\"window\",layout:\"grid1\",visible:true,icon:\"paper-plane\",title:\"Leave application\",autoScroll:true,cid:\"main\",items:[{cname:\"text\",text:\"Title\",required:true,cid:\"flowTitle\"},{cname:\"date\",text:\"Begin Date\",required:true,cid:\"begin_date\"},{cname:\"date\",text:\"End Date\",required:true,cid:\"end_date\"},{cname:\"number\",minValue:0,text:\"Leave days\",decimalCount:0,required:true,maxLength:5,cid:\"leave_days\"},{cname:\"text\",text:\"Reason\",required:true,cid:\"leave_reason\"}]});"}}