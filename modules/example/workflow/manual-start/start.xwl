{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"function main() {\n  let flow, now = new Date();\n\n  flow = new Wb.Workflow({ file: 'example/leave.flw', title: 'My leave application' });\n  flow.start();\n  Wb.sync({\n    tableName: 'wb_leave', insert: {\n      sid: Wb.getId(), begin_date: now.addDay(2), end_date: now.addDay(5),\n      flow_id: flow.flowId, user_id: Wb.userid, leave_days: 8, leave_reason: 'Go on vacation'\n    }\n  });\n}\nmain();"},"_icon":"module"}