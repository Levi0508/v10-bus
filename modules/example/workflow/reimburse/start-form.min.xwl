{"title":"","icon":"","img":"","tags":"{container: false}","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"Wb.apply(app,{beforeAction(e,b){},afterAction(e,b){let a=b.flowId,t=Wb.userid,d=Wb.getObject(\"data\");a=b.flowId;d.insert?.forEach((e=>{Wb.apply(e,{sid:Wb.getId(),flow_id:a,user_id:t})}));Wb.sync(Wb.apply({tableName:\"wb_reimburse\"},d))}});"},"_icon":"module","_expanded":true,"events":{"initialize":"Wb.apply(app,{autoShow:false,init(e,t,a){if(e){app.grid1.load({params:{flowId:e},success(e,t,a){app.flowTitle.value=a.flowTitle;app.main.show()}})}else{app.main.show()}},beforeAction(e,t){let a=app.grid1;if(!a.hasChild){Wb.tipWarn(\"Please input at least one item\");a.startEdit(a.addData({}),1);return false}return{data:app.grid1.modifiedData}},afterAction(e,t,a){Wb.log(\"action: \"+e+\", node name: \"+a.data.node_name)}});Wb.make(app,{cname:\"window\",layout:\"column\",padding:true,visible:true,gap:true,width:\"60em\",icon:\"money\",title:\"Start reimbursement workflow\",autoScroll:true,cid:\"main\",height:\"30em\",items:[{cname:\"text\",text:\"Title\",required:true,cid:\"flowTitle\"},{cname:\"grid\",minHeight:\"8em\",editable:true,flex:1,pagingBar:false,autoLoad:false,pageSize:-1,url:xpath+\"/../actions&xaction=selectStartData\",cid:\"grid1\",tbar:{cname:\"toolbar\",items:[{keys:\"Ctrl+E\",icon:\"add\",text:Str.add,cid:\"addBtn\",events:{click(e,t){app.grid1.addRecord()}}},{keys:\"Ctrl+D\",icon:\"delete\",text:Str.del,cid:\"delBtn\",events:{click(e,t){app.grid1.delRecords()}}}]},columns:[{cname:\"column\",rowNum:true,cid:\"rowCol\"},{cname:\"column\",fieldName:\"exp_date\",text:\"Date\",cid:\"dateCol\",editor:{cname:\"date\",required:true}},{cname:\"column\",fieldName:\"item_name\",width:-1,text:\"Item name\",cid:\"itemNameCol\",editor:{cname:\"text\",required:true}},{cname:\"column\",fieldName:\"amount\",width:\"10em\",text:\"Amount\",cid:\"amountCol\",editor:{cname:\"number\",decimalCount:2,required:true}}]}]});"}}