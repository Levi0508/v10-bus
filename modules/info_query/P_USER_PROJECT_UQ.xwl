      "events": {
        "keydown": "if (e.keyCode == '13') {\n  app.seekBtn.fireClick()\n}"
      },
      "items": [
        {
          "_icon": "panel",
          "text": "panel1",
          "cls": "Wb.Panel",
          "properties": {
            "cid": "panel1",
            "border": "false",
            "layout": "grid3"
          },
          "_expanded": true,
          "hasDupCid": 0,
          "items": [
            {
              "_icon": "text",
              "text": "I_USERNAME",
              "cls": "Wb.Text",
              "properties": {
                "cid": "I_USERNAME",
                "text": "客户名称",
                "placeholder": "请输入",
                "value": "_$sys.username$_",
