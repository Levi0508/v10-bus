    {
      "_icon": "window",
      "text": "addWin",
      "cls": "Wb.Window",
      "_expanded": true,
      "properties": {
        "cid": "addWin",
        "autoScroll": "true",
        "width": "560",
        "height": "160",
        "title": "附件补充",
        "layout": "form"
      },
      "items": [
        {
          "_icon": "text",
          "text": "saveFileData",
          "cls": "Wb.Text",
          "properties": {
            "cid": "saveFileData",
            "visible": "false",
            "text": "存放当前选中行数据"
          }
        },
        {
          "_icon": "text",
          "text": "xmfzrInfo",
          "cls": "Wb.Text",
          "properties": {
            "cid": "xmfzrInfo",
            "text": "查询出的项目负责人信息",
            "visible": "false"
          }
        },
        {
          "_icon": "label",
          "text": "label1",
          "cls": "Wb.Label",
          "properties": {
            "cid": "label1",
            "text": "文件：",
            "width": "60"
          },
          "_expanded": true
        },
        {
          "_icon": "search-file",
          "text": "file1",
          "cls": "Wb.FileInput",
          "properties": {
            "cid": "file1",
            "width": "300"
          }
        },
        {
          "_icon": "button",
          "text": "uploadBtn",
          "cls": "Wb.Button",
          "properties": {
            "cid": "uploadBtn",
            "type": "primary",
            "text": "上 传",
            "width": "100"
          },
          "events": {
            "click": "var fileRecord = JSON.parse(app.saveFileData.value);\nvar xmfzrInfo = JSON.parse(app.xmfzrInfo.value);\nvar fileData = app.file1.getValue();\nvar nowDate = Wb.format(new Date(), 'yMMdd');\n\nif (fileData && fileData !== \"\") {\n  Wb.ajax({\n    // form: app.form1,\n    uploadProgress: true,\n    url: 'm?xwl=info_query/projlist_data/upload',\n    params: {\n      user: '_$sys.username$_',\n      projId: fileRecord.projid,\n      date: nowDate,\n      file1: fileData\n    },\n    success(resp) {\n      var v = Wb.decode(resp);\n      var filePath = v.path;\n      saveFile(fileRecord, filePath);\n    }\n  });\n} else {\n  Wb.info('请选择文件！');\n  return;\n}\n\n\nfunction saveFile(fileRecord, filePath) {\n  Wb.ajax({\n    url: 'm?xwl=info_query/projlist/P_PROJLIST_FILE_Q/p_projlist_file_s',\n    params: {\n      i_projid: fileRecord.projid,\n      i_batch_id: fileRecord.batch_id,\n      i_inout_id: fileRecord.inout_id,\n      i_filepath: filePath,\n      i_usercode: '_$sys.username$_'\n    },\n    success(resp) {\n      app.grid1.reload();\n      app.addWin.close();\n      app.file1.reset();\n      // Wb.toast({\n      //   html: '上传成功!',\n      //   position: 'bc',\n      //   autoCloseDelay: 2000\n      // });\n      Wb.tipSucc(\"上传成功！\");\n      const now = new Date();\n      // 获取各项时间并补零\n      const year = now.getFullYear();\n      const month = String(now.getMonth() + 1).padStart(2, '0'); // 月份从 0 开始，需要 +1\n      const day = String(now.getDate()).padStart(2, '0');\n      const hours = String(now.getHours()).padStart(2, '0');\n      const minutes = String(now.getMinutes()).padStart(2, '0');\n      const seconds = String(now.getSeconds()).padStart(2, '0');\n\n      const nowTime = `${year}/${month}/${day} ${hours}:${minutes}:${seconds}`;\n\n      let formData = {\n        PROJ_ID: fileRecord.projid,\n        BATCH_ID: fileRecord.batch_id,\n        DEPTMANANAME: '何川',// xmfzrInfo[0]?.deptmananame || '' ,\n        KHNAME: '_$custname$_',\n        PROJCODE: '_$projcode$_',\n        STOCKCODE: '', // 证券代码（实际未用到）\n        STOCKNAME: '', // 股票简称（实际未用到）\n        STAFF_ID: '120578', // xmfzrInfo[0]?.staff_id || '', // 清单变更触发，项目负责人阅知节点候选人\n        DEPTNAME: xmfzrInfo[0]?.deptname || '',\n        PROJLIST_STATUS: '_$projlist_status$_',\n        OP_CONTENT: `${fileRecord.batch_desc}清单附件变更-${fileRecord.inout_desc}`,\n        OP_TIME: nowTime,\n        CHECK_RESULT: '',\n        CHECK_TIME: '',\n        PROJNAME: '_$projname$_',\n        IS_MANAUL: '0',// 1-合规人员主动触发 0-项目组变更清单内容触发\n        PROJTYPE: '_$projtype$_',\n        DEPT_USER_ID: '038622' //'_$sys.userid$_'\n      };\n\n      Wb.ajax({\n        url: 'm?xwl=th_projlist/ADMIN_PROJLIST/operation/flow_request_deal',\n        params: {\n          'x-flow-systemId': 'IBCM',//当前发送全连接流程类型\n          'x-userId': '_$sys.userid$_',//当前登录人id\n          'x-userName': '_$sys.username$_',//encodeURI('_$sys.username$_'),//当前登录人name\n          'url': 'http://10.116.131.13:8094/auto/submit',\n          'formDatas': formData,\n          \"todoTitle\": '_$projname$_' + '项目清单审核意见反馈',// 工作台待办名称\n          \"sysGuid\": \"IBCM\",\n          \"flowCode\": \"IBCM003\",\n          \"templateName\": '_$projname$_' + '项目清单审核意见反馈',// 待办表单打开后标题\n          \"flowVer\": \"1\",\n          \"nodeCode\": \"draft\",\n          \"applyTable\": \"T_PROJ_CHANGE_FLOW\",\n          \"candidates\": '038622',// xmfzrInfo[0]?.candidates || '',// 项目负责人user_id // TODO\n        },\n        success(resp) {\n          let res = Wb.decode(resp)\n          if (res.code == '0') {\n            Wb.tipSucc(\"清单附件变更，已下发【隔离墙操作变动流程】\")\n          } else {\n            Wb.tipError(\"【隔离墙操作变动流程】下发失败\")\n          }\n        }\n      });\n    }\n  });\n}\n\n"
          },
          "hasDupCid": 0
        }
      ]
    }
  ]
}