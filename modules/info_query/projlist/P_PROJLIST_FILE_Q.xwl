  "properties": {
    "cid": "module",
    "links": "[\"wb/custom-made/vue/vue.js\",\"wb/custom-made/vue/element.js\",\"wb/custom-made/vue/element.css\"]"
  },
  "_icon": "module",
  "_expanded": true,
  "items": [
    {
      "_icon": "viewport",
      "text": "viewport1",
      "cls": "Wb.Viewport",
      "properties": {
        "cid": "viewport1"
      },
      "_expanded": true,
      "events": {
        "ready": "setTimeout(()=>{app.seekBtn.fireClick()},500);"
      },
      "items": [
        {
          "_icon": "button",
          "text": "button1",
          "cls": "Wb.Button",
          "properties": {
            "cid": "button1",
            "text": "附件上传",
            "type": "primary",
            "icon": "upload",
            "width": "150"
          },
          "events": {
            "click": "var record = app.grid1.selection;\n\nif (!record) {\n  Wb.info('请选中一条数据 !');\n  return;\n} else {\n  var data = record.data;\n  Wb.ajax({\n    url: xpath + '/select_xmfzr_info',\n    params: {\n      i_projid: '_$projId$_'\n    },\n    success(resp) {\n      let res = Wb.decode(resp);\n      if (res.items) {\n        Wb.ajax({\n          url: 'm?xwl=th_projlist/my_projlist/operation/select_candidates_hg',\n          params: {\n            i_staff_id: res.items[0]?.staff_id,\n            i_projid: '_$projId$_'\n          },\n          success(resp) {\n            let res1 = Wb.decode(resp);\n            app.addWin.show();\n            if (res.items[0] && res1.items[0]) {\n              res.items[0].candidates = res1.items[0].manager_user_id\n            }\n            app.xmfzrInfo.setValue(JSON.stringify(res.items))\n          }\n        });\n      };\n      app.saveFileData.setValue(JSON.stringify(data));\n    }\n  })\n}\n\n"
          },
          "hasDupCid": 0
        },
        {
          "_icon": "panel",
          "text": "panel1",
          "cls": "Wb.Panel",
          "properties": {
            "cid": "panel1",
            "border": "false",
            "layout": "fit",
            "html": "<div style='padding:4px 12px;color:#e74c3c;font-weight: bold'> \n  附件上传注意事项:<br/>\n  &nbsp;&nbsp;1、系统可以多次上传附件，但后一次上传附件会覆盖前一次上传附件。<br/>\n  &nbsp;&nbsp;2、一次上传附件有两个或多个文件，必须做成压缩包上传，否则有覆盖现象。<br/>\n  &nbsp;&nbsp;3、上传附件有先后，先上传一个文件，后期补充上传另一个文件。必须将前一个文件下载后与后一个文件压缩后再上传。\n</div>"
          },
          "_expanded": true,
          "hasDupCid": 0,
          "items": [
            {
              "_icon": "text",
              "text": "I_PROJID",
              "cls": "Wb.Text",
              "properties": {
                "cid": "I_PROJID",
                "value": "_$projId$_"
              }
            }
          ]
        },
        {
          "_icon": "grid",
          "text": "grid1",
          "cls": "Wb.Grid",
          "properties": {
            "cid": "grid1",
            "pagingBar": "pageNums",
            "pageSize": "100",
            "full": "true",
            "border": "false",
            "url": "@xpath + '/select'",
            "emptyHint": "true"
          },
          "_expanded": true,
          "hasDupCid": 0,
          "events": {
            "click": "let preview = e.target.closest('.my-preview');\nif (preview) {\n  let row = this.findItemByEl(preview);\n  if (!row || !row.data.filepath) {\n    Wb.info('暂无附件');\n    return;\n  }\n  Wb.ajax({\n    url: xpath + '/preview_file',\n    params: {\n      filepath: row.data.filepath\n    },\n    success(resp) {\n      let res = Wb.decode(resp);\n      let serverIp = '10.116.131.13';\n      if (res.code == '200') {\n        let previewUrl = res.data && res.data.previewUrl;\n        if (!previewUrl) {\n          Wb.info('当前文件类型不支持预览');\n          return;\n        }\n        if (previewUrl.indexOf(serverIp) != -1) {\n          previewUrl = previewUrl.replace(/10\\.116\\.131\\.13:8090/g, '10.181.135.22:8080/ibcm_flow');\n        }\n        window.open(previewUrl, '_blank', 'width=800,height=600');\n      } else {\n        Wb.info('当前文件类型不支持预览');\n      }\n    }\n  });\n  return;\n}\nlet link = e.target.closest('.my-link');\nif (link) {\n  let row = this.findItemByEl(link);\n  console.log(\"=====row\", row)\n  Wb.download({\n    url: xpath + '/download_file',\n    params: {\n      disk_url: row.data.filepath\n    }\n  })\n}"
          },
          "items": [
            {
