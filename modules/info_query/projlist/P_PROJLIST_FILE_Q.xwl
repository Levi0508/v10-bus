                  "properties": {
                    "cid": "downloadCol",
                    "fieldName": "rl_inout_reason",
                    "keyValue": "true",
                    "text": "操作",
                    "render": "// return `<a href=`+data.filepath+` target=\"_blank\" download>下载</a>`;\n// console.log(\"el----\",el)\n// // this.el = `<td class=\"w-text\">下载</td>`\n// let html = `<a>111</a>`\n// return html;\n\nlet preview = el.addEl('my-preview', 'a');\npreview.textContent = '预览';\npreview.style.marginRight = '8px';\nlet a = el.addEl('my-link', 'a');\nel.cls = 'w-ta-center';\na.textContent = '下载';",
                    "width": "120"
                  }
                }
