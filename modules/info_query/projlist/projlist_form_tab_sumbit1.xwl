{
  "title": "清单填报备份",
  "icon": "",
  "img": "",
  "tags": "",
  "hideInMenu": "false",
  "text": "module",
  "cls": "Wb.Module",
  "properties": {
    "cid": "module",
    "links": "[\"wb/custom-made/vue/vue.js\",\"wb/custom-made/vue/element.js\",\"wb/custom-made/vue/element.css\",\"wb/custom-made/css/projlist_form.css\"]",
    "serverScript": "Wb.set({\n  projid: Wb.get('projid'),\n  i_op_flag: Wb.get('i_op_flag'),         // 1 - 只有从关联信息修改入口进来时传递1\n  state: Wb.get('state'),                 // info，只有双击查看时显示这个参数\n  piid1: Wb.get('piid1'),                 // 流程1参数 - 清单自查流程 流程id\n  check_batch_id:Wb.get('checkBatchId'),  // 流程1参数 - 清单自查流程 自查批次编号\n  piid2:Wb.get('piid2'),                  // 流程2参数 - 隔离墙操作变动审核流程 流程id\n  nodeCode:Wb.get('nodeCode'),            // 流程2参数 - 隔离墙操作变动审核流程 当前流程节点\n  staff_id:Wb.get('staff_id'),            // 流程2参数 - 隔离墙操作变动审核流程 项目组节点流程接收人\n  deptmananame:Wb.get('depemananame'),    // 流程2参数 - 隔离墙操作变动审核流程 项目组节点流程接收人中文名\n  deptname:Wb.get('deptname')             // 流程2参数 - 隔离墙操作变动审核流程 项目组节点流程接收人所在部门\n});\n\nWb.info(Wb.get());\n"
  },
  "_icon": "module",
  "_expanded": true,
  "events": {
    "initialize": "let data = {\n  roList: ['1、签订保密协议', '2、项目立项', '3、进场开展工作', '4、实际获知敏感信息'],\n  coList: ['1、价格确定', '2、项目终止', '3、转限制清单', '4、转静默期', '5、见备注说明'], // 出观察\n  rlList: ['1、项目信息已公告', '2、项目公告后进场'],\n  clList: ['1、价格/利率确定', '2、股东大会审议通过', '3、项目终止', '4、收购交易完成并公告', '5、挂牌并公开转让之日', '6、交易所同意转板的意见之日', '7、见备注说明'], // 出限制\n  rqList: ['1、敏感信息已公告'],\n  cqList: ['1、静默期结束'],\n  projType: '',\n  // projTypeList : ['IPO','非公开','公司债（非公开）','公司债（公开）','配股','公募增发','优先股','可转债']\n  projId: '_$projid$_',\n  projStatus: '_$projlist_status$_',\n  userCode: '_$sys.username$_',\n  dispName: '_$sys.dispname$_',\n  custName: '_$custname$_',\n  nowDate: Wb.format(new Date(), 'yMMdd'),\n  op_flag: '_$i_op_flag$_',\n  state: '_$state$_',\n  nodeCode: '_$nodeCode$_',\n  BATCH_ID: '',\n  // 我管理的清单列表 清单修正\n  adminProjlist: '_$open_projlist$_' * 1,\n  revise: '_$revise$_' * 1,\n  reviseId: '_$reviseId$_',\n  reviseList: []\n}\nWb.apply(app, {\n  data: data,\n})\n\n// Wb.apply(app, {\n//   stkCode: '_$stkcode$_',\n//   matchingStk($tr) {\n//     // Wb.ajax({\n//     //   url: 'm?xwl=info_query/projlist_data/stk_q',\n//     //   params: {\n//     //     i_comp_name: row.comp_name,\n//     //     i_stk_code: row.stk_code,\n//     //     i_stk_name: row.stk_name\n//     //   },\n//     //   success(resp){\n//     //     let resp = Wb.decode(resp).items[0];\n//     //     if(!resp){\n//     //       return\n//     //     }\n//     //     if(app.stkCode.split('.')[0]===resp.s_info_code){\n//     //       Wb.info('关联公司与客户相同，无需填写');\n\n//     //     }\n//     //   }\n//     // })\n//     $.when(app.dataReq('stk_q', {\n//       i_comp_name: $tr.find('.comp_name').val(),\n//       i_stk_code: $tr.find('.stk_code').val(),\n//       i_stk_name: $tr.find('.stk_name').val()\n//     })).done(function (resp) {\n//       resp = Wb.decode(resp.responseText).rows[0];\n//       if (isNil(resp)) return;\n//       // 如果匹配到的证券代码与项目本身的证券代码相同，提示并清空\n//       if (equals(app.stkCode.split('.')[0], resp.S_INFO_CODE)) {\n//         Wb.info('关联公司与客户相同，无需填写');\n//         $tr.find('input').val('');\n//         return;\n//       }\n//       // 将匹配返回的'上市公司名称'、'股票简称'、'股票代码'填充至页面对应文本框中\n//       $tr.find('.comp_name').val(resp.S_INFO_COMPNAME).end().find('.stk_code').val(resp.S_INFO_CODE).end().find('.stk_name').val(resp.S_INFO_NAME);\n//       let cust_name = $('.cust_name').val(); // 本身客户名称\n//       // 如果填写的证券代码匹配返回的客户名称与项目本身客户名称一致，自动将关联性质设置为'1-客户其他代码'，不允许修改\n//       if (equals(cust_name, resp.S_INFO_COMPNAME)) {\n//         $tr.next().find('.related_property').val('1');\n//         $tr.next().find('.related_property').attr('disabled', 'disabled');\n//       } else {\n//         $tr.next().find('.related_property').attr('disabled', false);\n//       }\n//     });\n//   },\n//   //-----------modify by YLT 20201120---------------\n//   addDate(date, days) {\n//     //       days = Maybe.Just(days).getOrElse(1);\n//     date = new Date(date);\n//     date.setDate(date.getDate() + days * 1);\n//     return date.getFullYear() + '-' + (date.getMonth() + 1).toString().padStart(2, '0') + '-' + date.getDate().toString().padStart(2, '0');\n//   },\n//   op(p, cn, ln) {\n//     // 在选项数组前面添加\"请选择\"\n//     ln.unshift('请选择');\n//     // 遍历数组，为每个选项创建option元素\n//     for (let i = 0; i < ln.length; i++) {\n//       p.find('select.' + cn).append('<option value=\"' + i + '\">' + ln[i] + '&emsp;</option>');\n//     }\n//   },\n//   req(t, p, c) {\n//     Wb.request({\n//       async: false,\n//       url: 'm?xwl=info_query/projlist_data/' + t + '_s',\n//       params: p,\n//       success(r) {\n//         c(r.status === 200);\n//       }\n//     });\n//   },\n//   uploadFile(form, name, params) {\n//     let defer = $.Deferred();\n//     Wb.upload({\n//       form: form,\n//       url: 'm?xwl=info_query/projlist_data/' + name,\n//       params: params,\n//       success(form, action, value) {\n//         defer.resolve(Wb.decode(value));\n//       }\n//     });\n//     return defer.promise();\n//   },\n//  