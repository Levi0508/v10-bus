  "items": [
    {
      "_icon": "viewport",
      "text": "viewport1",
      "cls": "Wb.Viewport",
      "properties": {
        "cid": "viewport1",
        "autoScroll": "true"
      },
      "_expanded": true,
      "events": {
        "ready": "console.log(\"111\")\nconsole.log('_$i_op_flag$_')\nconsole.log(\"222\")\nconsole.log('_$projId$_')"
      },
      "items": [
        {
          "_icon": "container",
          "text": "customerContainer",
          "cls": "Wb.Container",
          "properties": {
            "cid": "customerContainer",
            "width": "1200px",
            "alignSelf": "center"
          },
          "_expanded": true,
          "items": [
            {
              "_icon": "container",
              "text": "customerForm",
              "cls": "Wb.Container",
              "properties": {
                "cid": "customerForm"
              },
              "events": {
                "ready": "let comp = this;\ncomp.vue = new Vue({\n  el: comp.el.addEl(),\n  template: `\n<div id=\"projlist-app\">\n  <div class=\"projlist-form-input\">\n    <div style=\"font-size:24px;text-align:center;padding:20px 0 20px 0\">{{ op_flag == '1' ? '清单填报（关联信息修改）' : '清单填报' }}\n    </div>\n\n    <!-- 基本信息 -->\n    <el-card shadow=\"never\" class=\"projlist-card\">\n      <div class=\"info-div-basic\">\n        <div class=\"table-row\">\n          <div class=\"cell-label-basic col-4\">客户名称</div>\n          <div class=\"cell-value-basic col-8\">{{basicForm.custname || '-'}}</div>\n          <div class=\"cell-label-basic col-4\">项目编号</div>\n          <div class=\"cell-value-basic col-8\">{{basicForm.projcode || '-'}}</div>\n        </div>\n        <div class=\"table-row\">\n          <div class=\"cell-label-basic col-4\">业务类型</div>\n          <div class=\"cell-value-basic col-8\">{{ basicForm.projtype || '-'}}</div>\n          <div class=\"cell-label-basic col-4\">我司角色</div>\n          <div class=\"cell-value-basic col-8\">{{basicForm.role||'-'}} </div>\n        </div>\n        <div class=\"table-row\">\n          <div class=\"cell-label-basic col-4\">证券代码</div>\n          <div class=\"cell-value-basic col-8\">{{basicForm.stkcode|| '-'}}</div>\n          <div class=\"cell-label-basic col-4\">股票简称</div>\n          <div class=\"cell-value-basic col-8\">{{basicForm.stkname || '-'}}</div>\n        </div>\n      </div>\n    </el-card>\n\n    <!-- 添加多公司按钮 -->\n    <div v-if=\"projlist_status!=='0'&&state!='info'&&nodeCode!=='hgrysh'\" style=\"margin-bottom: 10px\">\n      <div class=\"control-buttons\" v-if=\"!isEditing\">\n        <el-button type=\"primary\" size=\"small\" @click=\"startEdit\">编辑</el-button>\n      </div>\n      <div class=\"control-buttons\" v-else>\n        <el-button type=\"primary\" size=\"small\" @click=\"saveData()\">保存</el-button>\n        <el-button size=\"small\" @click=\"cancelEdit\">取消</el-button>\n      </div>\n    </div>\n    <div @click=\"addCompany\" style=\"display: flex; align-items: center; cursor: pointer;\" v-if=\"isEditing && state!='info'&&nodeCode!=='hgrysh'\">\n      <div class=\"company-add-btn\">\n        <i class=\"el-icon-circle-plus-outline\"></i>\n      </div>\n      <div style=\"font-size:14px;\">如一个项目关联多个上市公司或证券代码，请点击此处添加<span style=\"color: #e74c3c\">（无需添加自身）</span></div>\n    </div>\n\n    <!-- 关联公司列表 -->\n    <div v-for=\"(item, index) in companyList\" :key=\"index\" class=\"company-table-wrapper\">\n      <div class=\"company-delete-btn\" @click=\"removeCompany(index)\" v-show=\"isEditing && state!='info' && nodeCode!=='hgrysh'\">\n        <i class=\"el-icon-remove-outline\"></i>\n      </div>\n      <div class=\"company-table\">\n        <!-- 第一行 -->\n        <div class=\"company-row\">\n          <div class=\"company-label\">上市公司名称</div>\n          <div class=\"company-cell\">\n            <el-input v-model=\"item.compName\" size=\"small\" placeholder=\"请输入\" :disabled=\"!isEditing || state=='info'||nodeCode=='hgrysh'\"></el-input>\n          </div>\n          <div class=\"company-label\">股票简称</div>\n          <div class=\"company-cell\">\n            <el-input v-model=\"item.stkName\" size=\"small\" placeholder=\"请输入\" :disabled=\"!isEditing || state=='info'||nodeCode=='hgrysh'\"></el-input>\n          </div>\n          <div class=\"company-label\">证券代码</div>\n          <div class=\"company-cell\">\n            <el-input v-model=\"item.stkCode\" size=\"small\" placeholder=\"请输入\"\n              @input=\"item.stkCode = item.stkCode.replace(/[\\W_]/g, '')\" @blur=\"() => matchCompany(item)\" :disabled=\"!isEditing || state=='info'||nodeCode=='hgrysh'\"></el-input>\n          </div>\n          <div class=\"company-match-btn\">\n            <el-button type=\"primary\" size=\"small\" plain :disabled=\"!isEditing || state=='info'||nodeCode=='hgrysh'\">匹配\n            </el-button>\n          </div>\n        </div>\n        <!-- 第二行 -->\n        <div class=\"company-row\">\n          <div class=\"company-label\">关联性质</div>\n          <div class=\"company-cell\">\n            <el-select v-model=\"item.relatedProperty\" size=\"small\" placeholder=\"请选择\" style=\"100%\"\n              :disabled=\"!isEditing || state=='info' || item.disabled||nodeCode=='hgrysh'\">\n              <el-option label=\"客户其他代码\" value=\"1\"></el-option>\n              <el-option label=\"交易对手方\" value=\"2\"></el-option>\n              <el-option label=\"交易标的\" value=\"3\"></el-option>\n              <el-option label=\"其他（请填备注）\" value=\"4\"></el-option>\n            </el-select>\n          </div>\n          <div class=\"company-label\">备注</div>\n          <div class=\"company-cell\" style=\"flex: 3;border-right:none;\">\n            <el-input v-model=\"item.remark\" size=\"small\" placeholder=\"请输入\" :disabled=\"!isEditing || state=='info'||nodeCode=='hgrysh'\"></el-input>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <!-- 附件上传注意事项 -->\n    <el-card shadow=\"never\" class=\"projlist-card\" v-if=\"basicForm.batch_count>0\">\n      <div class=\"projlist-file-tips\">\n        <p>附件上传注意事项（在我的清单列表页面补充附件）:</p>\n        <p>1、系统可以多次上传附件，但后一次上传附件会覆盖前一次上传附件</p>\n        <p>2、一次上传附件有两个或多个文件，必须做成压缩包上传，否则有覆盖现象</p>\n        <p>3、上传附件有先后，先上传一个文件，后期补充上传另一个文件。必须将前一个文件下载后与后一个文件压缩后再上传</p>\n      </div>\n    </el-card>\n\n    <!-- 添加批次按钮 -->\n    <!-- 1.关联信息修改/2.未入单/3.信息查看/4.ibcm003合规人员审核节点 均不展示添加批次按钮 -->\n    <div v-if=\"op_flag!='1' && projlist_status!='0' && state!='info'&& nodeCode!='hgrysh' \">\n      <div slot=\"append\" class=\"projlist-tab-add\" @click=\"addNewBatchTab\"\n        :title=\"isAddBatchDisabled ? '首次入单或未出单项目不允许添加新的批次！' : ''\"\n        :style=\"{ cursor: isAddBatchDisabled ? 'not-allowed' : 'pointer' }\">\n        <i class=\"el-icon-circle-plus-outline\"></i>添加\n      </div>\n      <div class=\"projlist-tab-add\" @click=\"removeNewBatch\" style=\"cursor: pointer;\" v-if=\"showNewTable\">\n        <i class=\"el-icon-remove-outline\"></i>删除\n      </div>\n    </div>\n\n    <el-tabs v-model=\"activeTab\" @tab-click=\"handleTabChange\">\n      <!-- 新增批次tab -->\n      <el-tab-pane label=\"new\" name=\"new\" v-if=\"showNewTable\">\n        <div class=\"bill-table new\">\n          <div class=\"bill-header\">\n            <div class=\"bill-cell bill-type-header\">清单类型</div>\n            <div class=\"bill-cell bill-reason-header\">入/出单事由</div>\n            <div class=\"bill-cell bill-date-header\">入/出单事由发生日期</div>\n            <div class=\"bill-cell bill-date-header\">入/出单事由填报日期</div>\n            <div class=\"bill-cell bill-remark-header\">备注说明</div>\n            <div class=\"bill-cell bill-file-header\">附件上传</div>\n          </div>\n          <div v-for=\"(item, index) in billList\" :key=\"index\"\n            :class=\"['bill-row', item.rowClass, item.selected ? 'selected' : '']\">\n            <div class=\"bill-cell bill-type-cell\" @click=\"toggleRowSelection(item)\">\n              <label class=\"type-label\">\n                <span>{{ item.typeLabel }}</span>\n                <span v-if=\"item.selected && !item.disabled\" class=\"type-hint\">发生日期为{{ item.typeLabel.replace('入 ','').replace('出 ','') }}<br>入/出单事由的实际发生日期</span>\n              </label>\n            </div>\n            <div :class=\"['bill-cell', 'bill-reason-cell', { 'field-required': item.selected && !item.disabled }]\">\n              <el-select v-model=\"item.inoutReason\" size=\"small\" placeholder=\"请选择\" :disabled=\"item.disabled\"\n                @change=\"handleReasonChange(item)\" clearable>\n                <el-option v-for=\"opt in getReasonOptions(item.listType)\" :key=\"opt.value\" :label=\"opt.label\"\n                  :value=\"opt.value\"></el-option>\n              </el-select>\n            </div>\n            <div :class=\"['bill-cell', 'bill-date-cell', { 'field-required': item.selected && !item.disabled }]\">\n              <el-date-picker v-model=\"item.inoutDate\" type=\"date\" size=\"small\" placeholder=\"选择日期\"\n                value-format=\"yyyy-MM-dd\" :disabled=\"item.disabled\" @change=\"handleDateChange(item)\" clearable>\n              </el-date-picker>\n            </div>\n            <div class=\"bill-cell bill-date-cell\">\n              <el-date-picker v-model=\"item.reportDate\" type=\"date\" size=\"small\" placeholder=\"选择日期\"\n                value-format=\"yyyy-MM-dd\" :disabled=\"item.reportDisabled\" clearable></el-date-picker>\n            </div>\n            <div\n              :class=\"['bill-cell', 'bill-remark-cell', { 'remark-required': item.remarkRequired && item.selected }]\">\n              <el-input v-model=\"item.remark\" size=\"small\" placeholder=\"请输入\" :disabled=\"item.disabled\" type=\"textarea\" autosize clearable>\n              </el-input>\n            </div>\n            <div :class=\"['bill-cell', 'bill-file-cell', { 'field-required': item.selected && !item.disabled }]\">\n              <div class=\"file-upload-wrapper\">\n                <el-input v-model=\"item.fileName\" size=\"small\" readonly placeholder=\"\"\n                  class=\"file-name-input full-text-select\" :disabled=\"item.disabled\"></el-input>\n                <div style=\"display:flex;\">\n                  <el-upload action=\"m?xwl=info_query/projlist_data/upload&type=1\" :data=\"uploadParams\" name=\"file1\"\n                    :on-success=\"(res) => handleUploadSuccess(res, item)\" :show-file-list=\"false\"\n                    class=\"file-upload-btn\" :disabled=\"!canUploadFile(item)\">\n                    <el-button size=\"small\" :disabled=\"!canUploadFile(item)\">浏览</el-button>\n                  </el-upload>\n                  <el-button size=\"small\" @click=\"downloadFile(item,'proj')\" style=\"cursor:pointer\"\n                    class=\"download-btn\">\n                    下载\n                  </el-button>\n                </div>\n                <!--<template v-if=\"!item.filepath || !item.disabled\">\n                  <el-input v-model=\"item.fileName\" size=\"small\" readonly placeholder=\"\" class=\"file-name-input\"\n                    :disabled=\"item.disabled\"></el-input>\n                  <el-upload action=\"m?xwl=info_query/projlist_data/upload&type=1\" :data=\"uploadParams\" name=\"file1\"\n                    :on-success=\"(res) => handleUploadSuccess(res, item)\" :show-file-list=\"false\"\n                    class=\"file-upload-btn\" :disabled=\"item.disabled\">\n                    <el-button size=\"small\" type=\"primary\" plain :disabled=\"item.disabled\">浏览</el-button>\n                  </el-upload>\n                </template>\n                <template v-else>\n                  <el-input v-model=\"item.fileName\" size=\"small\" readonly class=\"file-name-input\"\n                    :disabled=\"item.disabled\"></el-input>\n                  <el-button @click=\"downloadFile(item,'proj')\" style=\"cursor:pointer\">下载</el-button>\n                </template>-->\n              </div>\n            </div>\n          </div>\n        </div>\n      </el-tab-pane>\n\n      <!-- 历史批次tabs -->\n      <el-tab-pane v-for=\"(batch, index) in batchList\" :key=\"index\" :label=\"'批次' + batch.batchNum\"\n        :name=\"batch.batchNum.toString()\">\n        <div class=\"bill-table his\">\n          <!-- 表头 -->\n          <div class=\"bill-header\">\n            <div class=\"bill-cell bill-type-header\" style=\"text-align:center;\">清单类型</div>\n            <div class=\"bill-cell bill-reason-header\" style=\"text-align:center;\">入/出单事由</div>\n            <div class=\"bill-cell bill-date-header\" style=\"text-align:center;\">入/出单事由发生日期</div>\n            <div class=\"bill-cell bill-date-header\" style=\"text-align:center;\">入/出单事由填报日期</div>\n            <div class=\"bill-cell bill-remark-header\" style=\"text-align:center;\">备注说明</div>\n            <div class=\"bill-cell bill-file-header\" style=\"text-align:center;\">附件上传</div>\n          </div>\n          <!-- 数据行 与 审核记录区域（每种清单类型一组） -->\n          <template v-for=\"(item, idx) in billListHis\">\n            <!-- 清单数据 -->\n            <div :key=\"'data-'+idx\" :class=\"['bill-row', item.rowClass, item.selected ? 'selected' : '']\">\n              <!--清单类型-->\n              <div class=\"bill-cell bill-type-cell\" @click=\"toggleRowSelectionHis(item)\">\n                <label class=\"type-label\">\n                  <span>{{ item.typeLabel }}</span>\n                  <span v-if=\"item.selected && !item.disabled\" class=\"type-hint\">发生日期为{{ item.typeLabel.replace('入 ','').replace('出 ','') }}<br>入/出单事由的实际发生日期</span>\n                </label>\n              </div>\n              <!--入/出单事由-->\n              <div :class=\"['bill-cell', 'bill-reason-cell', { 'field-required': item.selected && !item.disabled }]\">\n                <el-tooltip :content=\"getSelectedReasonLabel(item.listType, item.inoutReason)\"\n                  :disabled=\"!item.inoutReason\" placement=\"top\" effect=\"light\" popper-class=\"bill-reason-tooltip\"\n                  :open-delay=\"300\">\n                  <div style=\"width: 100%;\">\n                    <el-select v-model=\"item.inoutReason\" size=\"small\" placeholder=\"请选择\" :disabled=\"item.disabled\"\n                      @change=\"handleReasonChangeHis(item)\" clearable>\n                      <el-option v-for=\"opt in getReasonOptions(item.listType)\" :key=\"opt.value\" :label=\"opt.label\"\n                        :value=\"opt.value\"></el-option>\n                    </el-select>\n                  </div>\n                </el-tooltip>\n              </div>\n              <!--入/出单事由发生日期-->\n              <div :class=\"['bill-cell', 'bill-date-cell', { 'field-required': item.selected && !item.disabled }]\">\n                <el-date-picker v-model=\"item.inoutDate\" type=\"date\" size=\"small\" placeholder=\"选择日期\"\n                  value-format=\"yyyy-MM-dd\" :disabled=\"item.disabled\" @change=\"handleDateChange(item)\">\n                </el-date-picker>\n              </div>\n              <!--入/出单事由填报日期-->\n              <div class=\"bill-cell bill-date-cell\">\n                <el-date-picker v-model=\"item.reportDate\" type=\"date\" size=\"small\" placeholder=\"选择日期\"\n                  value-format=\"yyyy-MM-dd\" :disabled=\"item.reportDisabled\">\n                </el-date-picker>\n              </div>\n              <!--备注说明-->\n              <div\n                :class=\"['bill-cell', 'bill-remark-cell', { 'remark-required': item.remarkRequired && item.selected }]\">\n                <el-input v-model=\"item.remark\" size=\"small\" placeholder=\"请输入\" :disabled=\"item.disabled\" type=\"textarea\"\n                  autosize></el-input>\n              </div>\n              <!--附件上传-->\n              <div :class=\"['bill-cell', 'bill-file-cell', { 'field-required': item.selected && !item.disabled }]\">\n                <div class=\"file-upload-wrapper\">\n                  <el-input v-model=\"item.fileName\" size=\"small\" readonly placeholder=\"\"\n                    class=\"file-name-input full-text-select\" :disabled=\"item.disabled\"></el-input>\n                  <div style=\"display:flex;\">\n                    <el-upload action=\"m?xwl=info_query/projlist_data/upload&type=1\" :data=\"uploadParams\" name=\"file1\"\n                      :on-success=\"(res) => handleUploadSuccess(res, item)\" :show-file-list=\"false\"\n                      class=\"file-upload-btn\" :disabled=\"!canUploadFile(item)\">\n                      <el-button size=\"small\" :disabled=\"!canUploadFile(item)\">浏览</el-button>\n                    </el-upload>\n                    <el-button size=\"small\" @click=\"downloadFile(item,'proj')\" style=\"cursor:pointer\"\n                      class=\"download-btn\">\n                      下载\n                    </el-button>\n                  </div>\n                </div>\n              </div>\n            </div>\n            <!-- 审核意见表格 -->\n            <div :key=\"'audit-'+idx\" class=\"audit-wrapper\">\n              <!-- 添加审核按钮 -->\n              <div @click=\"addAuditRecord(item)\" class=\"audit-add-btn\" title=\"添加审核记录\" v-if=\"piid2&&nodeCode=='hgrysh'\">\n                <i class=\"el-icon-circle-plus-outline\"></i>\n              </div>\n              <!-- 审核记录表格容器 -->\n              <div class=\"audit-table\" v-if=\"item.checkTableData.length>0\">\n                <template>\n                  <!-- 表头 -->\n                  <div class=\"bill-header audit-header\">\n                    <div class=\"bill-cell bill-type-header\" style=\"text-align:center;\">审核结果</div>\n                    <div class=\"bill-cell bill-reason-header\" style=\"text-align:center;\">审核记录</div>\n                    <div class=\"bill-cell bill-date-header\" style=\"text-align:center;\">审核日期</div>\n                    <div class=\"bill-cell bill-audit-remark-header\" style=\"text-align:center;width:320px;\">备注说明</div>\n                    <div class=\"bill-cell bill-file-header\" style=\"text-align:center;\">附件上传</div>\n                  </div>\n                  <div class=\"audit-collapse-btn\" @click=\"toggleAuditExpanded(item)\" title=\"展开/折叠审核意见\"\n                    v-if=\"item.checkDate&&item.checkTableData.length>1\">\n                    <i :class=\"[item.auditExpanded ? 'el-icon-arrow-down' : 'el-icon-arrow-right']\"></i>\n                  </div>\n\n                  <!--默认展示最新审核记录-->\n                  <div class=\"audit-row-wrapper\" v-show=\"!item.auditExpanded\">\n                    <div v-if=\"!item.checkDate\"\n                      style=\"height:56px;width:100%;text-align:center;line-height:56px;color:#C0C4CC;font-size:14px;\">\n                      暂未添加审核记录</div>\n                    <div v-else class=\"bill-row audit-row\">\n                      <!--审核结果-->\n                      <div class=\"bill-cell bill-type-cell audit-type-cell\">\n                        <el-select v-model=\"item.checkResult\" size=\"small\" placeholder=\"请选择\" disabled>\n                          <el-option label=\"准确\" value=\"0\"></el-option>\n                          <el-option label=\"不准确\" value=\"1\"></el-option>\n                        </el-select>\n                      </div>\n                      <!--审核记录-->\n                      <div class=\"bill-cell bill-reason-cell\">\n                        <el-select v-model=\"item.checkRecord\" size=\"small\" placeholder=\"请选择\" disabled>\n                          <el-option label=\"事由审核\" value=\"事由审核\"></el-option>\n                          <el-option label=\"日期审核\" value=\"日期审核\"></el-option>\n                          <el-option label=\"附件审核\" value=\"附件审核\"></el-option>\n                          <el-option label=\"其他\" value=\"其他\"></el-option>\n                        </el-select>\n                      </div>\n                      <!--审核日期-->\n                      <div class=\"bill-cell bill-date-cell\">\n                        <el-date-picker v-model=\"item.checkDate\" type=\"date\" size=\"small\" placeholder=\"选择日期\"\n                          value-format=\"yyyy-MM-dd\" disabled></el-date-picker>\n                      </div>\n                      <!--备注说明-->\n                      <div class=\"bill-cell bill-audit-remark-cell\" style=\"width:320px;\">\n                        <el-input v-model=\"item.checkRemark\" size=\"small\" placeholder=\"备注说明\" type=\"textarea\" autosize\n                          disabled>\n                        </el-input>\n                      </div>\n                      <!--附件上传-->\n                      <div class=\"bill-cell bill-file-cell\">\n                        <div class=\"file-upload-wrapper\">\n                          <el-input v-model=\"item.checkFileName\" size=\"small\" readonly class=\"file-name-input\" disabled\n                            :title=\"item.checkFileName\"></el-input>\n                          <div style=\"display:flex;\">\n                            <el-upload class=\"file-upload-btn\">\n                              <el-button size=\"small\" disabled>浏览</el-button>\n                            </el-upload>\n                            <el-button size=\"small\" @click=\"downloadFile(item,'comment1')\" style=\"cursor:pointer\"\n                              class=\"download-btn\">\n                              下载\n                            </el-button>\n                          </div>\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                  <!--折叠历史审核记录 完整审核记录-->\n                  <div v-if=\"item.checkTableData.length===0&&item.auditExpanded\"\n                    style=\"height:56px;width:100%;text-align:center;line-height:56px;color:#C0C4CC;font-size:14px;\">\n                    暂未添加审核记录</div>\n                  <div v-else v-for=\"(record, rIdx) in item.checkTableData\" :key=\"'rec-'+idx+'-'+rIdx\"\n                    class=\"audit-row-wrapper\" v-show=\"item.auditExpanded\">\n                    <div class=\"audit-delete-btn\" @click=\"removeAuditRecord(item, rIdx)\" title=\"删除该条审核记录\"\n                      v-if=\"record.isDeleteShow\">\n                      <i class=\"el-icon-remove-outline\"></i>\n                    </div>\n\n                    <div class=\"bill-row audit-row\">\n                      <div class=\"bill-cell bill-type-cell audit-type-cell\">\n                        <el-select v-model=\"record.check_result\" size=\"small\" placeholder=\"请选择\"\n                          :disabled=\"record.isDisabled\">\n                          <el-option label=\"准确\" value=\"0\"></el-option>\n                          <el-option label=\"不准确\" value=\"1\"></el-option>\n                        </el-select>\n                      </div>\n                      <div class=\"bill-cell bill-reason-cell\">\n                        <el-select v-model=\"record.check_record\" size=\"small\" placeholder=\"请选择\"\n                          :disabled=\"record.isDisabled\">\n                          <el-option label=\"事由审核\" value=\"事由审核\"></el-option>\n                          <el-option label=\"日期审核\" value=\"日期审核\"></el-option>\n                          <el-option label=\"附件审核\" value=\"附件审核\"></el-option>\n                          <el-option label=\"其他\" value=\"其他\"></el-option>\n                        </el-select>\n                      </div>\n                      <div class=\"bill-cell bill-date-cell\">\n                        <el-date-picker v-model=\"record.create_time\" type=\"date\" size=\"small\" placeholder=\"选择日期\"\n                          value-format=\"yyyy-MM-dd\" disabled></el-date-picker>\n                      </div>\n                      <div class=\"bill-cell bill-audit-remark-cell\" style=\"width:320px;\">\n                        <el-input v-model=\"record.remark\" size=\"small\" placeholder=\"备注说明\" type=\"textarea\" autosize\n                          :disabled=\"record.isDisabled\" maxlength=\"500\" show-word-limit>\n                        </el-input>\n                      </div>\n                      <div class=\"bill-cell bill-file-cell\">\n                        <div class=\"file-upload-wrapper\">\n                          <el-input v-model=\"record.fileName\" size=\"small\" readonly placeholder=\"\"\n                            class=\"file-name-input\" :disabled=\"record.isDisabled\"></el-input>\n                          <div style=\"display:flex;\">\n                            <el-upload action=\"m?xwl=info_query/projlist_data/upload&type=1\" :data=\"uploadParams\"\n                              name=\"file1\" :on-success=\"(res) => handleUploadSuccess(res, record)\"\n                              :show-file-list=\"false\" class=\"file-upload-btn\">\n                              <el-button size=\"small\" :disabled=\"record.isDisabled\">浏览</el-button>\n                            </el-upload>\n                            <el-button size=\"small\" @click=\"downloadFile(record,'comment2')\" style=\"cursor:pointer\"\n                              class=\"download-btn\">\n                              下载\n                            </el-button>\n                          </div>\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                </template>\n              </div>\n            </div>\n          </template>\n        </div>\n      </el-tab-pane>\n    </el-tabs>\n\n    <!--清单填报 首次新增-->\n    <div class=\"bill-table his\" v-if=\"batchList.length === 0&&projlist_status==='0'\">\n      <!-- 表头 -->\n      <div class=\"bill-header\">\n        <div class=\"bill-cell bill-type-header\" style=\"text-align:center;\">清单类型</div>\n        <div class=\"bill-cell bill-reason-header\" style=\"text-align:center;\">入/出单事由</div>\n        <div class=\"bill-cell bill-date-header\" style=\"text-align:center;\">入/出单事由发生日期</div>\n        <div class=\"bill-cell bill-date-header\" style=\"text-align:center;\">入/出单事由填报日期</div>\n        <div class=\"bill-cell bill-remark-header\" style=\"text-align:center;\">备注说明</div>\n        <div class=\"bill-cell bill-file-header\" style=\"text-align:center;\">附件上传</div>\n      </div>\n      <!-- 数据行 -->\n      <template v-for=\"(item, idx) in billList\">\n        <!-- 清单数据行 -->\n        <div :key=\"'first-data-'+idx\" :class=\"['bill-row', item.rowClass, item.selected ? 'selected' : '']\">\n          <div class=\"bill-cell bill-type-cell\" @click=\"toggleRowSelection(item)\">\n            <label class=\"type-label\">\n              <span>{{ item.typeLabel }}</span>\n              <span v-if=\"item.selected && !item.disabled\" class=\"type-hint\">发生日期为{{ item.typeLabel.replace('入 ','').replace('出 ','') }}<br>入/出单事由的实际发生日期</span>\n            </label>\n          </div>\n          <div :class=\"['bill-cell', 'bill-reason-cell', { 'field-required': item.selected && !item.disabled }]\">\n            <el-select v-model=\"item.inoutReason\" size=\"small\" placeholder=\"请选择\" :disabled=\"item.disabled\"\n              @change=\"handleReasonChange(item)\" clearable>\n              <el-option v-for=\"opt in getReasonOptions(item.listType)\" :key=\"opt.value\" :label=\"opt.label\"\n                :value=\"opt.value\">\n              </el-option>\n            </el-select>\n          </div>\n          <div :class=\"['bill-cell', 'bill-date-cell', { 'field-required': item.selected && !item.disabled }]\">\n            <el-date-picker v-model=\"item.inoutDate\" type=\"date\" size=\"small\" placeholder=\"选择日期\"\n              value-format=\"yyyy-MM-dd\" @change=\"handleDateChange(item)\" :disabled=\"item.disabled\" clearable></el-date-picker>\n          </div>\n          <div class=\"bill-cell bill-date-cell\">\n            <el-date-picker v-model=\"item.reportDate\" type=\"date\" size=\"small\" placeholder=\"选择日期\"\n              value-format=\"yyyy-MM-dd\" :disabled=\"item.reportDisabled\" clearable></el-date-picker>\n          </div>\n          <div :class=\"['bill-cell', 'bill-remark-cell', { 'remark-required': item.remarkRequired && item.selected }]\">\n            <el-input v-model=\"item.remark\" size=\"small\" placeholder=\"请输入\" :disabled=\"item.disabled\" type=\"textarea\" :rows=\"1\" autosize clearable></el-input>\n          </div>\n          <div :class=\"['bill-cell', 'bill-file-cell', { 'field-required': item.selected && !item.disabled }]\">\n            <div class=\"file-upload-wrapper\">\n              <!-- 无文件时：显示上传按钮 -->\n              <template v-if=\"!item.filepath || !item.disabled\">\n                <el-input v-model=\"item.fileName\" size=\"small\" readonly placeholder=\"\" class=\"file-name-input\"\n                  :disabled=\"item.disabled\"></el-input>\n                <el-upload action=\"m?xwl=info_query/projlist_data/upload&type=1\" :data=\"uploadParams\" name=\"file1\"\n                  :on-success=\"(res) => handleUploadSuccess(res, item)\" :show-file-list=\"false\" class=\"file-upload-btn\"\n                  :disabled=\"!canUploadFile(item)\">\n                  <el-button size=\"small\" :disabled=\"!canUploadFile(item)\" plain>浏览</el-button>\n                </el-upload>\n              </template>\n              <el-button size=\"small\" @click=\"downloadFile(item,'proj')\" style=\"cursor:pointer\">下载</el-button>\n            </div>\n          </div>\n        </div>\n      </template>\n    </div>\n\n    <!-- 清单自查表格 仅当从流程进来时展示-->\n    <div style=\"display:flex;justify-content:space-between;width:100%;padding:30px 0 10px 0;\" v-if=\"piid1\">\n      <span>清单自查情况</span>\n      <!--<el-button type=\"primary\" size=\"mini\" @click=\"addCheckRow\" :disabled=\"state === 'info'\">+添加行</el-button>-->\n    </div>\n    <el-table :data=\"tableData\" stripe style=\"width: 100%\" border v-if=\"piid1\">\n      <el-table-column label=\"自查日期\" width=\"245\">\n        <template slot-scope=\"scope\">\n          <el-date-picker v-model=\"scope.row.check_date\" type=\"date\" format=\"yyyy-MM-dd\" placeholder=\"选择日期\" size=\"small\"\n            disabled></el-date-picker>\n        </template>\n      </el-table-column>\n      <el-table-column label=\"自查结果\" width=\"180\">\n        <template slot-scope=\"scope\">\n          <el-select v-model=\"scope.row.check_result\" placeholder=\"请选择自查结果\" size=\"small\">\n            <el-option label=\"准确\" value=\"0\"></el-option>\n            <el-option label=\"已更正\" value=\"1\"></el-option>\n          </el-select>\n        </template>\n      </el-table-column>\n      <el-table-column label=\"备注说明\">\n        <template slot-scope=\"scope\">\n          <el-input type=\"textarea\" v-model=\"scope.row.remark\" :autosize=\"{ minRows: 1, maxRows: 4}\"\n            placeholder=\"请输入备注说明\" size=\"small\" :required=\"scope.row.check_result === '1'\"\n            :class=\"{ 'required-field': scope.row.check_result === '1' }\"></el-input>\n          <span v-if=\"scope.row.check_result === '1' && !scope.row.remark\" style=\"color: #f56c6c; font-size: 12px;\">*</span>\n        </template>\n      </el-table-column>\n      <el-table-column label=\"附件上传\" width=\"310\">\n        <template slot-scope=\"scope\">\n          <div class=\"file-upload-wrapper\">\n            <template>\n              <el-input v-model=\"scope.row.fileName\" size=\"small\" readonly placeholder=\"\" class=\"file-name-input\">\n              </el-input>\n              <el-upload action=\"m?xwl=info_query/projlist_data/upload&type=1\" :data=\"uploadParams\" name=\"file1\"\n                :on-success=\"(res) => handleUploadSuccess(res, scope.row)\" :show-file-list=\"false\"\n                class=\"file-upload-btn\">\n                <el-button size=\"small\" type=\"primary\" plain :disabled=\"state === 'info'\">浏览</el-button>\n              </el-upload>\n            </template>\n          </div>\n        </template>\n      </el-table-column>\n      <!--<el-table-column label=\"操作\" width=\"80\" header-align=\"center\" align=\"center\">\n        <template slot-scope=\"scope\">\n          <el-button size=\"mini\" type=\"text\" @click=\"removeCheckRow(scope.$index)\"\n            :disabled=\"state === 'info' || tableData.length <= 1\" style=\"color:#f56c6c;\">移除</el-button>\n        </template>\n      </el-table-column>-->\n    </el-table>\n\n    <!-- 历史清单自查表格 -->\n    <div style=\"color:#4b4b4b;padding:20px 0 10px 0;display:flex;\" @click=\"showCheckLogs=!showCheckLogs\">\n      <div style=\"width:140px;\">历史清单自查情况</div>\n      <div style=\"border-bottom:1px solid #e1e0e0;height:12px;flex:1\"></div>\n      <div style=\"width:20px;padding-left:10px;\">\n        <span v-if=\"showCheckLogs\"><i class=\"el-icon-arrow-down\" style=\"color:#e1e0e0\"></i></span>\n        <span v-else><i class=\"el-icon-arrow-up\" style=\"color:#e1e0e0\"></i></span>\n      </div>\n    </div>\n    <el-table :data=\"tableDataHis\" stripe style=\"width: 100%\" v-show=\"showCheckLogs\" border>\n      <el-table-column prop=\"create_time\" label=\"自查日期\" width=\"180\"></el-table-column>\n      <el-table-column prop=\"check_result$\" label=\"自查结果\" width=\"180\"></el-table-column>\n      <el-table-column prop=\"display_name\" label=\"自查人员\"></el-table-column>\n      <el-table-column prop=\"remark\" label=\"备注说明\"></el-table-column>\n      <el-table-column prop=\"filename\" label=\"附件\">\n        <template slot-scope=\"scope\">\n          <el-button type=\"text\" @click=\"downloadFile(scope.row,'selfcheck')\" class=\"attachment-btn\">\n            {{ scope.row.filename }}\n          </el-button>\n        </template>\n      </el-table-column>\n    </el-table>\n    <!-- 操作按钮 -->\n    <div class=\"projlist-btns\">\n      <el-button type=\"success\" @click=\"handleSubmit(1)\" :disabled=\"submitButtonDisabled\" v-if=\"state!='info'\">提交\n      </el-button>\n      <el-button type=\"success\" @click=\"handleSubmit(2)\" v-if=\"showReviseBtn\" :disabled=\"submitButtonDisabled\">修正\n      </el-button>\n    </div>\n  </div>\n</div>\n  `,\n  data() {\n    return {\n      // 基本信息\n      basicForm: {\n        custname: '',\n        projcode: '',\n        projtype: '',\n        role: '',\n        stkcode: '',\n        stkname: '',\n        batch_count: 0,\n      },\n      op_flag: '_$i_op_flag$_',// 从【关联信息修改】按钮进页面时为1\n      projid: '_$projid$_',\n      projlist_status: '_$projlist_status$_',\n      state: '_$state$_',\n      piid1: '_$piid1$_',// 清单自查流程流程id\n      check_batch_id: '_$check_batch_id$_',\n      piid2: '_$piid2$_',// 隔离墙操作变动流程流程id\n      nodeCode: '_$nodeCode$_',\n      projname: '_$projname$_',\n      candidates: '',// 隔离墙操作变动流程 流程候选人user_id\n      deptname: '', // 部门名称\n      uploadParams: {\n        user: '_$sys.username$_',\n        projId: '_$projid$_',\n        date: Wb.format(new Date(), 'yMMdd'),\n        type: '1'\n      },\n      isEditing: false,\n      // 多公司列表\n      companyList: [\n        {\n          compName: '',\n          stkName: '',\n          stkCode: '',\n          writeDate: '',\n          relatedProperty: '1',\n          remark: '',\n          dataFlag: false\n        }\n      ],\n      // 清单表格数据 - 新增批次\n      billList: [\n        { listType: 'ro', typeLabel: '入 观察清单', inoutReason: '', inoutDate: '', reportDate: '', remark: '', remarkRequired: false, fileName: '', filepath: '', selected: false, disabled: false, rowClass: '', reportDisabled: true },\n        { listType: 'co', typeLabel: '出 观察清单', inoutReason: '', inoutDate: '', reportDate: '', remark: '', remarkRequired: false, fileName: '', filepath: '', selected: false, disabled: true, rowClass: 'disabled-row', reportDisabled: true },\n        { listType: 'rl', typeLabel: '入 限制清单', inoutReason: '', inoutDate: '', reportDate: '', remark: '', remarkRequired: false, fileName: '', filepath: '', selected: false, disabled: false, rowClass: '', reportDisabled: true },\n        { listType: 'cl', typeLabel: '出 限制清单', inoutReason: '', inoutDate: '', reportDate: '', remark: '', remarkRequired: false, fileName: '', filepath: '', selected: false, disabled: true, rowClass: 'disabled-row', reportDisabled: true },\n        { listType: 'rq', typeLabel: '入 静默期', inoutReason: '', inoutDate: '', reportDate: '', remark: '', remarkRequired: false, fileName: '', filepath: '', selected: false, disabled: false, rowClass: '', reportDisabled: true },\n        { listType: 'cq', typeLabel: '出 静默期', inoutReason: '', inoutDate: '', reportDate: '', remark: '', remarkRequired: false, fileName: '', filepath: '', selected: false, disabled: true, rowClass: 'disabled-row', reportDisabled: true }\n      ],\n      // 清单表格数据 - 已有批次\n      billListHis: [\n        {\n          listType: 'ro',\n          typeLabel: '入 观察清单',\n          inoutReason: '',\n          inoutDate: '',\n          reportDate: '',\n          remark: '',\n          remarkRequired: false,\n          fileName: '',\n          filepath: '',\n          selected: false,\n          disabled: false,       // 控制整行是否可编辑\n          rowClass: '',\n          reportDisabled: true, // 控制入/出单事由填报日期是否可编辑\n          auditExpanded: false,  // 控制历史审核记录是否展开\n          batchId: '',\n          linkSelected: false,  // 联动选中\n          dataFlag: false,       // 是否非本次填报前已有的数据,true-是已有数据 false-不是已有数据\n          // 最新一条审核记录\n          checkResult: '',\n          checkRecord: '',\n          checkDate: '',\n          checkRemark: '',\n          checkFilepath: '',\n          checkFileName: '',\n          checkTableData: []     // 历史审核记录表格\n        },\n        {\n          listType: 'co',\n          typeLabel: '出 观察清单',\n          inoutReason: '',\n          inoutDate: '',\n          reportDate: '',\n          remark: '',\n          remarkRequired: false,\n          fileName: '',\n          filepath: '',\n          selected: false,\n          disabled: false,\n          rowClass: '',\n          reportDisabled: true,\n          auditExpanded: false,\n          batchId: '',\n          linkSelected: false,\n          dataFlag: false,       // 是否非本次填报前已有的数据\n          // 最新一条审核记录\n          checkResult: '',\n          checkRecord: '',\n          checkDate: '',\n          checkRemark: '',\n          checkFilepath: '',\n          checkFileName: '',\n          checkTableData: []\n        },\n        {\n          listType: 'rl',\n          typeLabel: '入 限制清单',\n          inoutReason: '',\n          inoutDate: '',\n          reportDate: '',\n          remark: '',\n          remarkRequired: false,\n          fileName: '',\n          filepath: '',\n          selected: false,\n          disabled: false,\n          rowClass: '',\n          reportDisabled: true,\n          auditExpanded: false,\n          batchId: '',\n          linkSelected: false,\n          dataFlag: false,       // 是否非本次填报前已有的数据\n          // 最新一条审核记录\n          checkResult: '',\n          checkRecord: '',\n          checkDate: '',\n          checkRemark: '',\n          checkFilepath: '',\n          checkFileName: '',\n          checkTableData: []\n        },\n        {\n          listType: 'cl',\n          typeLabel: '出 限制清单',\n          inoutReason: '',\n          inoutDate: '',\n          reportDate: '',\n          remark: '',\n          remarkRequired: false,\n          fileName: '',\n          filepath: '',\n          selected: false,\n          disabled: false,\n          rowClass: '',\n          reportDisabled: true,\n          auditExpanded: false,\n          batchId: '',\n          linkSelected: false,\n          dataFlag: false,       // 是否非本次填报前已有的数据\n          // 最新一条审核记录\n          checkResult: '',\n          checkRecord: '',\n          checkDate: '',\n          checkRemark: '',\n          checkFilepath: '',\n          checkFileName: '',\n          checkTableData: []\n        },\n        {\n          listType: 'rq',\n          typeLabel: '入 静默期',\n          inoutReason: '',\n          inoutDate: '',\n          reportDate: '',\n          remark: '',\n          remarkRequired: false,\n          fileName: '',\n          filepath: '',\n          selected: false,\n          disabled: false,\n          rowClass: '',\n          reportDisabled: true,\n          auditExpanded: false,\n          batchId: '',\n          linkSelected: false,\n          dataFlag: false,       // 是否非本次填报前已有的数据\n          // 最新一条审核记录\n          checkResult: '',\n          checkRecord: '',\n          checkDate: '',\n          checkRemark: '',\n          checkFilepath: '',\n          checkFileName: '',\n          checkTableData: []\n        },\n        {\n          listType: 'cq',\n          typeLabel: '出 静默期',\n          inoutReason: '',\n          inoutDate: '',\n          reportDate: '',\n          remark: '',\n          remarkRequired: false,\n          fileName: '',\n          filepath: '',\n          selected: false,\n          disabled: false,\n          rowClass: '',\n          reportDisabled: true,\n          auditExpanded: false,\n          batchId: '',\n          linkSelected: false,\n          dataFlag: false,       // 是否非本次填报前已有的数据\n          // 最新一条审核记录\n          checkResult: '',\n          checkRecord: '',\n          checkDate: '',\n          checkRemark: '',\n          checkFilepath: '',\n          checkFileName: '',\n          checkTableData: []\n        }\n      ],\n      // 是否显示新增表格\n      showNewTable: false,\n      // 展开清单自查情况\n      showCheckLogs: true,\n      // 缓存每个批次的审核意见\n      cacheAuditData: {},\n      // 批次列表\n      batchList: [],\n      // 当前选中的批次索引\n      currentBatchIndex: 0,\n      // 当前激活的标签页\n      activeTab: '',\n      // 选中的清单行\n      selectedBillRows: [],\n      // 历史记录\n      historyList: [],\n      // 本次清单自查结果表格\n      tableData: [{\n        check_date: Wb.format(new Date(), 'yyyy-MM-dd'),\n        check_result: '',\n        user_name: '_$sys.username$_',\n        remark: '',\n        fileName: '',\n        filepath: ''\n      }],\n      // 历史清单自查结果表格\n      tableDataHis: [],\n      // 是否显示修正按钮\n      showReviseBtn: false,\n      // 是否禁用新增批次按钮\n      isAddBatchDisabled: false,\n      // 是否禁用提交按钮\n      submitButtonDisabled: false,\n      // 事由选项\n      reasonOptions: {\n        ro: [\n          { label: '1、签订保密协议', value: '1' },\n          { label: '2、项目立项', value: '2' },\n          { label: '3、进场开展工作', value: '3' },\n          { label: '4、实际获知敏感信息', value: '4' }\n        ],\n        co: [\n          { label: '1、价格确定', value: '1' },\n          { label: '2、项目终止', value: '2' },\n          { label: '3、转限制清单', value: '3' },\n          { label: '4、转静默期', value: '4' },\n          { label: '5、见备注说明', value: '5' }\n        ],\n        rl: [\n          { label: '1、项目信息已公告', value: '1' },\n          { label: '2、项目公告后进场', value: '2' }\n        ],\n        cl: [\n          { label: '1、价格/利率确定', value: '1' },\n          { label: '2、股东大会审议通过', value: '2' },\n          { label: '3、项目终止', value: '3' },\n          { label: '4、收购交易完成并公告', value: '4' },\n          { label: '5、挂牌并公开转让之日', value: '5' },\n          { label: '6、交易所同意转板的意见之日', value: '6' },\n          { label: '7、见备注说明', value: '7' }\n        ],\n        rq: [\n          { label: '1、敏感信息已公告', value: '1' }\n        ],\n        cq: [\n          { label: '1、静默期结束', value: '1' }\n        ]\n      }\n    };\n  },\n  methods: {\n    showMessage(msg, time, type) {\n      this.$message({\n        showClose: true,\n        dangerouslyUseHTMLString: true,\n        message: msg,\n        duration: time ? time : 0,\n        type: type ? type : 'success'\n      })\n    },\n    // 清单填报页查询\n    inoutReq(projid) {\n      let that = this;\n      Wb.ajax({\n        url: 'm?xwl=info_query/projlist_data/inout_q',\n        params: {\n          i_projid: projid\n        },\n        success(resp) {\n          resp = Wb.decode(resp).items[0];\n          let batch_id = resp.batch_id;\n          console.log(\"inoutReq---resp\", resp);\n          that.basicForm = { ...resp };\n          that.projlist_status = resp.projlist_status;\n          that.isEditing = that.projlist_status === '0' ? true : false;\n\n          // 处理批次信息\n          if (resp.batch_count) {\n            // 生成批次列表\n            that.batchList = [];\n            for (let i = 0; i < resp.batch_count; i++) {\n              that.batchList.push({\n                batchId: resp.batch_id, // 批次编码\n                batchNum: resp.batch_count - i,// 批次顺序\n                batchName: `批次${resp.batch_count - i}`\n              });\n            }\n            // 设置默认激活的标签页为第一个批次\n            if (that.batchList.length > 0) {\n              that.activeTab = that.batchList[0].batchNum.toString();\n              that.switchBatch(0);\n            }\n          } else {\n            // 没有批次时，显示历史批次表格\n            that.activeTab = '1';\n          }\n\n          // // 填充历史批次表格数据\n          // const listTypes = ['ro', 'co', 'rl', 'cl', 'rq', 'cq'];\n          // listTypes.forEach(listType => {\n          //   const row = that.billListHis.find(item => item.listType === listType);\n          //   if (row) {\n          //     row.inoutReason = resp[`${listType}_inout_reason`] || '';\n          //     row.inoutDate = resp[`${listType}_inout_date`] || '';\n          //     row.reportDate = resp[`${listType}_report_date`] || '';\n          //     row.remark = resp[`${listType}_inout_remark`] || '';\n          //     row.filepath = resp[`${listType}_filepath`] || '';\n          //     row.batchId = batch_id || '';\n          //     row.remarkRequired = (listType === 'co' && row.inoutReason === '5') || (listType === 'cl' && row.inoutReason === '7');\n          //     if (row.inoutReason && row.inoutDate && row.reportDate) {\n          //       row.dataFlag = true;\n          //     }\n          //     // if (row.reportDate) { row.disabled = true; }\n          //     // 最新一条审核记录\n          //     row.checkResult = resp[`${listType}_check_result`] || '';\n          //     row.checkRecord = resp[`${listType}_check_record`] || '';\n          //     row.checkDate = resp[`${listType}_create_time`] || '';\n          //     row.checkRemark = resp[`${listType}_remark`] || '';\n          //     row.checkFilepath = resp[`${listType}_check_filepath`] || '';\n\n          //     // 提取文件名\n          //     if (row.filepath) {\n          //       const parts = row.filepath.split('/');\n          //       row.fileName = parts[parts.length - 1] || '';\n          //     } else {\n          //       row.fileName = '';\n          //     }\n          //     // 提取审核文件名\n          //     if (row.checkFilepath) {\n          //       const parts = row.checkFilepath.split('/');\n          //       row.checkFileName = parts[parts.length - 1] || '';\n          //     } else {\n          //       row.checkFileName = '';\n          //     }\n          //     let listTypeMap = {\n          //       'ro': 'io',\n          //       'co': 'oo',\n          //       'rl': 'il',\n          //       'cl': 'ol',\n          //       'rq': 'iq',\n          //       'cq': 'oq'\n          //     };\n          //     let records = [],\n          //       inout_type = listTypeMap[listType][1],\n          //       inout_direct = listTypeMap[listType][0];\n\n          //     Wb.ajax({\n          //       url: 'm?xwl=info_query/projlist_data/comment_q',\n          //       params: {\n          //         i_projid: '_$projid$_',\n          //         i_batchid: batch_id,\n          //         i_inout_type: inout_type,\n          //         i_inout_direct: inout_direct\n          //       },\n          //       success(resp) {\n          //         let res = Wb.decode(resp).items || [];\n          //         // 为查询出来的审核记录添加控制字段\n          //         records = res.map(item => ({\n          //           ...item,\n          //           fileName: item.filepath ? item.filepath.split('/')[item.filepath.split('/').length - 1] : '',\n          //           isDisabled: true,    // 已有记录不可编辑\n          //           isDeleteShow: false  // 已有记录不显示删除按钮\n          //         }));\n          //         row.checkTableData = records;\n          //         console.log(\"------row\", row);\n          //       }\n          //     });\n          //   }\n          // });\n        }\n      });\n    },\n    // 关联信息查询\n    multistkReq(projid) {\n      let that = this;\n      Wb.ajax({\n        url: 'm?xwl=info_query/projlist_data/multistk_q',\n        params: {\n          i_projid: projid\n        },\n        success(resp) {\n          let res = Wb.decode(resp).items;\n          console.log(\"multistkReq---resp\", res);\n          // 填充关联公司数据\n          if (res.length > 0) {\n            that.companyList = res.map(item => ({\n              ...item,\n              relatedProperty: item.related_property || '',\n              compName: item.comp_name || '',\n              stkCode: item.stk_code || '',\n              stkName: item.stk_name || '',\n              remark: item.ralated_ramark || '',\n              writeDate: item.write_date || '',\n              dataFlag: true //已存在的关联公司信息dataFlag为true 不可编辑不可删除\n            }));\n            // 关联信息修改 已有数据行设为只读，新增行可编辑\n            // if (that.op_flag == '1') {\n            //   that.companyList.forEach(item => {\n            //     if (item.dataFlag === 1) {\n            //       item.disabled = true;\n            //     }\n            //   });\n            // }\n            // console.log(\"companyList\", that.companyList)\n          } else {\n            that.companyList = [{\n              compName: '',\n              stkName: '',\n              stkCode: '',\n              writeDate: '',\n              relatedProperty: '1',\n              remark: '',\n              dataFlag: false\n            }]\n          }\n        }\n      });\n    },\n    // 清单自查表格查询\n    selfcheckReq(projid) {\n      let that = this;\n      Wb.ajax({\n        url: 'm?xwl=info_query/projlist_data/selfcheck_q',\n        params: {\n          i_projid: projid\n        },\n        success(resp) {\n          resp = Wb.decode(resp).items;\n          if (resp.length > 0) {\n            that.tableDataHis = resp.map(item => ({\n              ...item,\n              filename: item.file_path ? item.file_path.split('/').pop() : ''\n            }));\n          }\n          console.log(\"tableDataHis\", resp);\n          // that.tableDataHis = [...resp];\n        }\n      })\n    },\n    getCandidates(staff_id, projid) {\n      let that = this;\n      let url = that.nodeCode == 'hgrysh' ?\n        'm?xwl=th_projlist/ADMIN_PROJLIST/operation/select_candidates_xmfzr' :\n        'm?xwl=th_projlist/my_projlist/operation/select_candidates_hg'\n      Wb.ajax({\n        url: url,\n        params: {\n          i_staff_id: staff_id,\n          i_projid: projid\n        },\n        success(resp) {\n          let res = Wb.decode(resp);\n          console.log(\"getCandidates--res\", res);\n          if (res.items[0]) {\n            that.candidates = that.nodeCode == 'hgrysh' ? res.items[0].user_id : res.items[0].manager_user_id\n            that.deptname = res.items[0].deptname // 项目负责人部门名称\n          }\n        }\n      });\n    },\n    // 添加关联公司\n    addCompany() {\n      this.companyList.push({\n        compName: '',\n        stkName: '',\n        stkCode: '',\n        writeDate: '',\n        relatedProperty: '1',\n        remark: '',\n        dataFlag: false,// true表示已有的关联信息 false表示新增的关联信息\n        disabled: false\n      });\n    },\n    // 删除关联公司\n    removeCompany(index) {\n      // 关联信息修改 已有数据行不可删除\n      // if (this.companyList[index].dataFlag === '1' && this.op_flag == '1') {\n      //   return;\n      // }\n      if (this.companyList.length <= 1) {\n        Wb.info('至少需保留一行关联公司数据');\n        return;\n      }\n      Wb.confirm('确认删除该行？', () => {\n        this.companyList.splice(index, 1);\n      });\n    },\n    // 匹配关联公司\n    matchCompany(item) {\n      // 1. 如果证券代码没有填写，则不进行匹配\n      if (!item.stkCode || item.stkCode.trim() === '') {\n        this.$message.warning('请先填写证券代码');\n        return;\n      }\n\n      // 2. 如果公司名称输入框禁用，则不进行匹配\n      // 注意：需要在companyList数据结构中添加disabled字段\n      // 或通过其他条件判断是否禁用\n      if (item.disabled) {\n        return;\n      }\n\n      // 3. 调用匹配方法\n      this.matchingStk(item);\n    },\n    // 匹配证券\n    matchingStk(item) {\n      let that = this;\n      Wb.ajax({\n        url: 'm?xwl=info_query/projlist_data/stk_q', // 需要确认实际接口地址\n        params: {\n          i_comp_name: item.compName,\n          i_stk_name: item.stkName,\n          i_stk_code: item.stkCode\n        },\n        success: (resp) => {\n          resp = Wb.decode(resp);\n          // 假设返回的数据包含公司名称和股票简称\n          if (resp.items && resp.items.length > 0) {\n            const data = resp.items[0];\n            // const data = {\n            //   s_info_windcode: \"874567.NQ\",\n            //   s_info_compname: \"上海辛帕智能科技股份有限公司\",\n            //   s_info_code: \"874567\",\n            //   s_info_name: \"辛帕智能\"\n            // }\n\n            // 检查是否与项目本身的证券代码相同\n            if (that.basicForm.stkcode && data.s_info_windcode && that.basicForm.stkcode.split('.')[0] === data.s_info_windcode.split('.')[0]) {\n              Wb.info('关联公司与客户相同，无需填写');\n              item.compName = '';\n              item.stkName = '';\n              item.stkCode = '';\n              return;\n            }\n\n            item.compName = data.s_info_compname || item.compName;\n            item.stkName = data.s_info_name || item.stkName;\n            item.stkCode = data.s_info_code || item.stkCode;\n\n            // 如果匹配返回的客户名称与项目本身客户名称一致，自动将关联性质设置为'1-客户其他代码'，不允许修改\n            if (that.basicForm.custname && data.s_info_compname && that.basicForm.custname === data.s_info_compname) {\n              item.relatedProperty = '1';\n              item.disabled = true; // 禁用关联性质选择\n            } else {\n              item.disabled = false; // 启用关联性质选择\n            }\n            console.log(\"匹配成功------\", data)\n            that.$message.success('匹配成功');\n          } else {\n            that.$message.warning('未找到匹配的公司信息');\n          }\n        },\n        failure: () => {\n          that.$message.error('匹配失败，请稍后重试');\n        }\n      });\n    },\n    /**\n     * 开始编辑关联公司：启用编辑状态\n     */\n    startEdit() {\n      this.isEditing = true;\n    },\n\n    /**\n     * 保存关联公司数据：验证并提交\n     */\n    saveData(onlySave = false) {\n      // 保存数据，退出编辑状态\n      let that = this;\n      if (!that.validateCompanyData()) {\n        console.log(\"关联公司校验\")\n        return;\n      }\n      const today = new Date();\n      const todayStr = `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, '0')}-${String(today.getDate()).padStart(2, '0')}`;\n      let successCount = 0;\n      let totalCount = 0;\n      const fillId = Wb.getId(); // 生成唯一填充ID，同批次所有行共享\n\n      totalCount = that.companyList.length;\n\n      // 逐行提交\n      that.companyList?.forEach((item, index) => {\n        // 构建单行提交数据\n        let rowData = {\n          i_projid: '_$projid$_',\n          i_projlist_status: '_$projlist_status$_' || that.projlist_status,\n          i_usercode: '_$sys.username$_',\n          i_submit_status: 1,\n          i_fill_id: fillId,\n          i_comp_name: item.compName || '',\n          i_stk_name: item.stkName || '',\n          i_stk_code: item.stkCode || '',\n          i_related_property: item.relatedProperty || '',\n          i_ralated_ramark: item.remark || '',\n          i_write_date: item.writeDate || todayStr,\n          // i_data_flag: item.dataFlag ? '1' : '' （未用到）\n        };\n\n        Wb.ajax({\n          url: 'm?xwl=info_query/projlist_data/multistk_s',\n          params: rowData,\n          success(resp) {\n            let res = Wb.decode(resp);\n            if (res.O_RETURN_CODE === '0') {\n              successCount++;\n              // 所有行提交成功\n              if (successCount === totalCount && !onlySave) {\n                that.multistkReq('_$projid$_');\n                that.showMessage('提交成功！', 2000, 'success');\n                that.isEditing = false;\n              }\n            } else {\n              that.showMessage('第' + (index + 1) + '行提交失败：' + res.O_RETURN_MSG, 2000, 'error');\n            }\n          },\n          failure() {\n            that.showMessage('第' + (index + 1) + '行提交失败，请稍后重试', 2000, 'error');\n          }\n        });\n      });\n\n    },\n\n    /**\n     * 取消编辑关联公司：退出编辑状态\n     */\n    cancelEdit: async function () {\n      await this.multistkReq('_$projid$_');\n      this.isEditing = false;\n    },\n\n    // 添加新批次tab页\n    addNewBatchTab() {\n      // console.log(\"batchList\",this.batchList);\n      const projlist_status = '_$projlist_status$_' || this.projlist_status;\n      const op_flag = '_$i_op_flag$_';\n      const state = '_$state$_';\n      const adminProjlist = '_$open_projlist$_' * 1;\n      const revise = '_$revise$_' * 1;\n\n      // 首次入单或未出单项目不允许添加新的批次\n      if (projlist_status == '0' || projlist_status == 'ro' || projlist_status == 'rl' || projlist_status == 'rq') {\n        Wb.info('首次入单或未出单项目不允许添加新的批次！');\n        return;\n      }\n\n      // 查看模式或关联信息修改模式：不允许添加新批次\n      if (state == 'info' || op_flag == '1') {\n        Wb.info('当前模式不允许添加新批次！');\n        return;\n      }\n\n      // 清单类型分组\n      const outList = ['co', 'cl', 'cq']; // 出单类型\n      const inList = ['ro', 'rl', 'rq'];  // 入单类型\n\n      // 清空新增表格数据\n      const today = new Date().toISOString().split('T')[0];\n\n      // 根据权限状态初始化批次表格\n      let newBillList = [\n        { listType: 'ro', typeLabel: '入 观察清单', inoutReason: '', inoutDate: '', reportDate: today, remark: '', fileName: '', filepath: '', selected: false, disabled: false, rowClass: '', reportDisabled: true },\n        { listType: 'co', typeLabel: '出 观察清单', inoutReason: '', inoutDate: '', reportDate: '', remark: '', fileName: '', filepath: '', selected: false, disabled: true, rowClass: 'disabled-row', reportDisabled: true },\n        { listType: 'rl', typeLabel: '入 限制清单', inoutReason: '', inoutDate: '', reportDate: today, remark: '', fileName: '', filepath: '', selected: false, disabled: false, rowClass: '', reportDisabled: true },\n        { listType: 'cl', typeLabel: '出 限制清单', inoutReason: '', inoutDate: '', reportDate: '', remark: '', fileName: '', filepath: '', selected: false, disabled: true, rowClass: 'disabled-row', reportDisabled: true },\n        { listType: 'rq', typeLabel: '入 静默期', inoutReason: '', inoutDate: '', reportDate: today, remark: '', fileName: '', filepath: '', selected: false, disabled: false, rowClass: '', reportDisabled: true },\n        { listType: 'cq', typeLabel: '出 静默期', inoutReason: '', inoutDate: '', reportDate: '', remark: '', fileName: '', filepath: '', selected: false, disabled: true, rowClass: 'disabled-row', reportDisabled: true }\n      ];\n\n\n      // 管理员模式：所有行可编辑\n      if (adminProjlist > 0) {\n        newBillList.forEach(item => {\n          item.disabled = false;\n          item.rowClass = '';\n        });\n      }\n\n      // 修正模式：只启用有数据的行（新增批次没有历史数据，所以保持默认）\n      if (revise === 1) {\n        newBillList.forEach(item => {\n          item.disabled = true;\n          item.rowClass = 'disabled-row';\n        });\n      }\n\n      this.billList = newBillList;\n\n      this.showNewTable = true;\n      this.currentBatchIndex = -1; // -1表示新增批次tab页\n      // 设置激活的标签页为new\n      this.activeTab = 'new';\n      // 禁用添加批次按钮，防止重复添加\n      this.isAddBatchDisabled = true;\n    },\n    // 处理 tab 切换事件\n    handleTabChange(tab) {\n      console.log(\"handleTabChange\", tab);\n      const tabName = tab.name;\n\n      if (this.nodeCode === 'hgrysh') {\n        this.cacheCurrentBatchAuid()\n      }\n\n      // 如果是新增批次 tab，不需要重新加载数据\n      if (tabName === 'new') {\n        this.currentBatchIndex = -1;\n        return;\n      }\n\n      // 查找对应的批次索引\n      const index = this.batchList.findIndex(batch => batch.batchNum.toString() === tabName);\n      if (index !== -1 && index !== this.currentBatchIndex) {\n        this.switchBatch(index);\n      }\n    },\n    // 缓存当前正在编辑的审核意见\n    cacheCurrentBatchAuid() {\n      const currentBatchKey = this.currentBatchIndex >= 0 && this.batchList[this.currentBatchIndex] ? this.batchList[this.currentBatchIndex].batchNum.toString() : null\n      const hasData = this.billListHis && this.billListHis?.some(item => item.listType)\n      if (currentBatchKey && hasData) {\n        const curBatch = this.batchList[this.currentBatchIndex];\n        const listTypes = {}\n        this.billListHis?.forEach(item => {\n          listTypes[item.listType] = {\n            checkResult: item.checkResult || '',\n            checkRecord: item.checkRecord || '',\n            checkDate: item.checkDate || '',\n            checkRemark: item.checkRemark || '',\n            checkFilepath: item.checkFilepath || '',\n            checkFileName: item.checkFileName || '',\n            checkTableData: JSON.parse(JSON.stringify(item.checkTableData || []))\n          }\n        })\n        this.cacheAuditData[currentBatchKey] = {\n          batchId: curBatch.batchId || '',\n          batchName: curBatch.batchName,\n          batchNum: curBatch.batchNum,\n          listTypes: listTypes\n        }\n        console.log(`当前批次${currentBatchKey}审核意见已缓存`)\n        console.log(this.cacheAuditData)\n      }\n    },\n    // 删除新批次\n    removeNewBatch() {\n      this.showNewTable = false;\n      // 重置新增批次的数据\n      this.billList = [];\n      // 重新启用添加批次按钮\n      const projlist_status = '_$projlist_status$_' || this.projlist_status;\n      this.isAddBatchDisabled = (projlist_status == '0' || projlist_status == 'ro' || projlist_status == 'rl' || projlist_status == 'rq');\n      // 如果当前激活的标签页是new，切换到第一个历史批次\n      console.log(\"this.activeTab\", this.activeTab);\n      if (this.activeTab === 'new') {\n        console.log(\"this.batchList\", this.batchList);\n        if (this.batchList.length > 0) {\n          this.activeTab = this.batchList[0].batchNum.toString();\n          this.currentBatchIndex = 0;\n          this.switchBatch(0);\n        } else {\n          this.activeTab = '';\n          this.currentBatchIndex = 0;\n        }\n      }\n    },\n    // 切换到历史批次表格\n    switchToHisTable() {\n      this.showNewTable = false;\n    },\n    // 切换批次\n    switchBatch(index, tab, event) {\n      console.log(\"switchBatch\");\n      console.log(tab);\n      console.log(event);\n      let that = this;\n      this.currentBatchIndex = index;\n      // this.showNewTable = false; // 隐藏新增批次表格\n\n      // 获取选中的批次\n      let selectedBatch = this.batchList[index];\n      if (!selectedBatch) {\n        return;\n      }\n\n      // 更新激活的标签页\n      this.activeTab = selectedBatch.batchNum.toString();\n      // 目标批次的key\n      const targetBatchKey = selectedBatch.batchNum.toString();\n\n      // 调用接口获取批次数据\n      Wb.ajax({\n        url: 'm?xwl=info_query/projlist_data/inout_batch_q', // 需要确认实际接口地址\n        params: {\n          i_projid: '_$projid$_',\n          i_batch_num: selectedBatch.batchNum\n        },\n        success(resp) {\n          resp = Wb.decode(resp);\n          console.log(\"resp\", resp)\n          if (resp.items && resp.items.length > 0) {\n            let batchData = resp.items[0];\n            let batch_id = resp.items[0].batch_id;\n            if (that.batchList[index]) {\n              that.batchList[index].batchId = batch_id\n            }\n            console.log(\"batchData\", batchData);\n            // 更新历史批次表格数据\n            that.billListHis.forEach(item => {\n              // 从扁平化的数据结构中获取对应的数据\n              item.inoutReason = batchData[`${item.listType}_inout_reason`] || '';\n              item.inoutDate = batchData[`${item.listType}_inout_date`] || '';\n              item.reportDate = batchData[`${item.listType}_report_date`] || '';\n              item.remark = batchData[`${item.listType}_inout_remark`] || '';\n              item.filepath = batchData[`${item.listType}_filepath`] || '';\n              item.batchId = batch_id || '';\n              item.remarkRequired = (item.listType === 'co' && item.inoutReason === '5') || (item.listType === 'cl' && item.inoutReason === '7');\n              if (item.inoutReason && item.inoutDate && item.reportDate) {\n                item.dataFlag = true;\n              } else {\n                item.dataFlag = false;\n              }\n              item.oldBatch = false\n              item.linkSelected = false\n              // // 最新一条审核记录\n              // item.checkResult = batchData[`${item.listType}_check_result`] || '';\n              // item.checkRecord = batchData[`${item.listType}_check_record`] || '';\n              // item.checkDate = batchData[`${item.listType}_create_time`] || '';\n              // item.checkRemark = batchData[`${item.listType}_remark`] || '';\n              // item.checkFilepath = batchData[`${item.listType}_check_filepath`] || '';\n\n              // // item.checkTableData = that.getAuditRecord('_$projId$_', batch_id, 'oo');\n\n              // // 提取文件名\n              // if (item.filepath) {\n              //   const parts = item.filepath.split('/');\n              //   item.fileName = parts[parts.length - 1] || '';\n              // } else {\n              //   item.fileName = '';\n              // }\n              // // 提取审核文件名\n              // if (item.checkFilepath) {\n              //   const parts = item.checkFilepath.split('/');\n              //   item.checkFileName = parts[parts.length - 1] || '';\n              // } else {\n              //   item.checkFileName = '';\n              // }\n              // 设置选中状态\n              item.selected = !!item.inoutReason;\n            });\n            // 填充历史批次表格数据\n            const listTypes = ['ro', 'co', 'rl', 'cl', 'rq', 'cq'];\n            listTypes.forEach(listType => {\n              const row = that.billListHis.find(item => item.listType === listType);\n              if (row) {\n                // 提取文件名\n                if (row.filepath) {\n                  const parts = row.filepath.split('/');\n                  row.fileName = parts[parts.length - 1] || '';\n                } else {\n                  row.fileName = '';\n                }\n\n                if (that.nodeCode === 'hgrysh' && that.cacheAuditData?.[targetBatchKey]?.listTypes?.[listType]) {\n                  const cached = that.cacheAuditData[targetBatchKey].listTypes[listType];\n                  row.checkResult = cached.checkResult || '';\n                  row.checkRecord = cached.checkRecord || '';\n                  row.checkDate = cached.checkDate || '';\n                  row.checkRemark = cached.checkRemark || '';\n                  row.checkFilepath = cached.checkFilepath || '';\n                  row.checkFileName = cached.checkFileName || '';\n                  row.checkTableData = cached.checkTableData || []\n                  // console.log(`批次${targetBatchKey} ${listType}审核意见从缓存获取`)\n                } else {\n                  // 最新一条审核记录\n                  row.checkResult = batchData[`${listType}_check_result`] || '';\n                  row.checkRecord = batchData[`${listType}_check_record`] || '';\n                  row.checkDate = batchData[`${listType}_create_time`] || '';\n                  row.checkRemark = batchData[`${listType}_remark`] || '';\n                  row.checkFilepath = batchData[`${listType}_check_filepath`] || '';\n                  // 提取审核文件名\n                  if (row.checkFilepath) {\n                    const parts = row.checkFilepath.split('/');\n                    row.checkFileName = parts[parts.length - 1] || '';\n                  } else {\n                    row.checkFileName = '';\n                  }\n                  let listTypeMap = {\n                    'ro': 'io',\n                    'co': 'oo',\n                    'rl': 'il',\n                    'cl': 'ol',\n                    'rq': 'iq',\n                    'cq': 'oq'\n                  };\n                  let records = [],\n                    inout_type = listTypeMap[listType][1],\n                    inout_direct = listTypeMap[listType][0];\n\n                  Wb.ajax({\n                    url: 'm?xwl=info_query/projlist_data/comment_q',\n                    params: {\n                      i_projid: '_$projid$_',\n                      i_batchid: batch_id,\n                      i_inout_type: inout_type,\n                      i_inout_direct: inout_direct\n                    },\n                    success(resp) {\n                      let res = Wb.decode(resp).items || [];\n                      // 为查询出来的审核记录添加控制字段\n                      records = res.map(item => ({\n                        ...item,\n                        fileName: item.filepath ? item.filepath.split('/')[item.filepath.split('/').length - 1] : '',\n                        isDisabled: true,    // 已有记录不可编辑\n                        isDeleteShow: false  // 已有记录不显示删除按钮\n                      }));\n                      row.checkTableData = records;\n                      // console.log(\"------row\", row);\n                    }\n                  });\n                }\n              }\n            });\n            // 判断是否是最新批次（索引0为最新批次）\n            if (index === 0) {\n              // \n              that.initHisTableStatus();\n              console.log(\"最新批次：根据当前状态决定哪些行可编辑\")\n            } else {\n              // 非最新批次：所有行都不可编辑（与老代码一致）\n              that.billListHis.forEach(item => {\n                item.disabled = true;\n                item.selected = false;\n                item.rowClass = 'disabled-row disabled-except-first';\n                item.reportDisabled = true;\n                item.oldBatch = true\n              });\n            }\n          }\n        },\n        failure() {\n          Wb.info('加载批次数据失败，请稍后重试');\n        }\n      });\n    },\n    // 初始化历史批次表格的状态\n    initHisTableStatus() {\n      const projlist_status = '_$projlist_status$_' || this.projlist_status;\n      const outList = ['0', 'co', 'cl', 'cq'];\n      const inList = ['ro', 'rl', 'rq'];\n      const op_flag = '_$i_op_flag$_';\n      const state = '_$state$_';\n      const adminProjlist = '_$open_projlist$_' * 1;\n      const revise = '_$revise$_' * 1;\n      const piid2 = this.piid2;\n      console.log(\"state---\", state)\n\n      if (op_flag == 1 || state == 'info' || this.nodeCode == 'hgrysh') {\n        console.log(\"关联信息进入或查看模式：所有行禁用\")\n        this.billListHis.forEach(item => {\n          item.disabled = true;\n          item.selected = false;\n          item.rowClass = 'disabled-row';\n          item.reportDisabled = true;\n        });\n        console.log(\"billListHis---------\", this.billListHis);\n        return;\n      }\n\n      if (adminProjlist > 0) {\n        // 移除所有禁用和选中状态\n        this.billListHis.forEach(item => {\n          item.disabled = false;\n          item.selected = false;\n          item.rowClass = '';\n          item.reportDisabled = true;\n        });\n        return;\n      }\n\n      // 出静默期状态(cq)：所有行禁用（流程已结束，不允许编辑）\n      if (projlist_status === 'cq') {\n        console.log(\"出静默期状态(cq)：所有行禁用\");\n        this.billListHis.forEach(item => {\n          item.disabled = true;\n          item.selected = false;\n          item.rowClass = !item.dataFlag ? 'disabled-row' : 'disabled-except-first';\n          item.reportDisabled = true;\n        });\n        return;\n      }\n\n      if (revise === 1) {\n        this.billListHis.forEach(item => {\n          if (item.inoutReason) {\n            item.disabled = false;\n            item.selected = true;\n            item.rowClass = '';\n            item.reportDisabled = true;\n          } else {\n            item.disabled = true;\n            item.selected = false;\n            item.rowClass = 'disabled-row';\n            item.reportDisabled = true;\n          }\n        });\n        return;\n      }\n\n      // 根据projlist_status设置默认选中状态\n      const statusIndexMap = {\n        'ro': 0, 'co': 1, 'rl': 2, 'cl': 3, 'rq': 4, 'cq': 5\n      };\n      const currentIndex = statusIndexMap[projlist_status];\n\n      if (outList.includes(projlist_status)) {\n        // 出单状态：当前行及之前的所有行禁用\n        this.billListHis.forEach((item, index) => {\n          if ((index <= currentIndex || outList.includes(item.listType)) && !item.inoutDate) {\n            item.disabled = true;\n            item.selected = false;\n            item.rowClass = 'disabled-row';\n            item.reportDisabled = true;\n          } else if ((index <= currentIndex || outList.includes(item.listType)) && item.inoutDate) {\n            item.disabled = true;\n            item.selected = false;\n            item.rowClass = 'disabled-except-first';\n            item.reportDisabled = true;\n          } else {\n            item.disabled = false;\n            item.selected = false;\n            item.rowClass = '';\n            item.reportDisabled = true;\n          }\n        });\n      } else if (inList.includes(projlist_status)) {\n        // 入单状态：对应的出单行选中，其他行禁用\n        const outIndexMap = { 'ro': 1, 'rl': 3, 'rq': 5 }; // 入对应出的索引\n\n        this.billListHis.forEach((item, index) => {\n          if (index === outIndexMap[projlist_status]) {\n            // 对应的出单行选中（自查流程默认不选中）\n            item.disabled = false;\n            item.selected = !this.piid1;\n            item.rowClass = '';\n            item.reportDisabled = true;\n            item.reportDate = new Date().toISOString().split('T')[0];\n          } else if ((index !== outIndexMap[projlist_status]) && item.inoutDate) {\n            // 其他行禁用\n            item.disabled = true;\n            item.selected = false;\n            item.rowClass = 'disabled-except-first';\n            item.reportDisabled = true;\n          } else {\n            // 其他行禁用\n            item.disabled = true;\n            item.selected = false;\n            item.rowClass = 'disabled-row';\n            item.reportDisabled = true;\n          }\n        });\n\n        // 特殊处理：rq状态时cq行额外处理\n        if (projlist_status === 'rq') {\n          // this.billListHis[5].rowClass = 'disabled-except-first disabled-row';\n          this.billListHis[5].rowClass = 'disabled-except-first';\n          this.billListHis[5].disabled = true;\n        }\n      }\n    },\n    // 切换行选中状态\n    toggleRowSelection(item) {\n      if (item.disabled) return;\n      // 如果当前行未被选中，才进行切换（与老代码一致，不可取消选中）\n      if (!item.selected && !item.disabled) {\n        this.billList.forEach(row => {\n          if (row !== item) {\n            row.selected = false;\n            if (row.disabled) {\n              row.rowClass = 'disabled-row'\n            }\n          }\n        });\n        if (!this.piid1) {\n          item.selected = true;\n        } else {\n          item.selected = !item.selected\n        }\n        if (item.inoutReason) {\n          this.handleReasonChange(item, false);\n        }\n      } else if (item.selected && !item.disabled && this.piid1) {\n        item.selected = !item.selected\n        item.inoutReason = '';\n        item.inoutDate = '';\n        item.remark = '';\n        item.filepath = '';\n        item.fileName = '';\n        this.clearLinkedEffects(this.billList, item);\n      }\n    },\n    // 切换历史批次行选中状态\n    toggleRowSelectionHis(item) {\n      // if (this.billListHis?.every(item => item.disabled === true)) {\n      //   return;\n      // }\n      // 非最新批次：所有行都不可编辑（与老代码一致）\n      if (item.oldBatch || this.showNewTable) return\n      if (!this.piid1 && item.listType === 'cq' && this.projlist_status === 'rq') return\n      if ((item.disabled && !item.dataFlag) || this.nodeCode === 'hgrysh' || this.state === 'info') return;\n      // 选中 如果当前行未被选中，可进行切换\n      if (!item.selected && !item.disabled) {\n        this.billListHis.forEach(row => {\n          if (row !== item && !row.dataFlag) {\n            row.selected = false;\n            if (row.disabled && !row.dataFlag) {\n              row.rowClass = 'disabled-row'\n            }\n          }\n        });\n\n        if (!this.piid1) {\n          item.selected = true;\n        } else {\n          item.selected = !item.selected\n        }\n        if (item.inoutReason) {\n          this.handleReasonChangeHis(item, false);\n        }\n        // 取消 仅自查可取消\n      } else if (item.selected && !item.disabled && this.piid1) {\n        item.selected = !item.selected\n        item.inoutReason = '';\n        item.inoutDate = '';\n        item.remark = '';\n        item.filepath = '';\n        item.fileName = '';\n        this.clearLinkedEffects(this.billListHis, item);\n      }\n      // 2.点击已填报的、未被选中的禁用行，变为选中且设置disabled-except-first\n      // 3.点击已填报的、被选中的禁用行，取消选中状态且设置disabled-except-first\n      if (!item.selected && item.disabled && item.dataFlag) {\n        console.log(\"2\");\n        item.selected = true;\n        item.rowClass = 'disabled-except-first'\n      } else if (item.selected && item.disabled && !item.linkSelected && item.dataFlag) {\n        console.log(\"3\");\n        item.selected = false;\n        item.rowClass = 'disabled-except-first'\n      }\n    },\n    // 下载文件\n    downloadFile(item, type) {\n      console.log(\"downloadFile\", item);\n      let filepath;\n      if (type == 'proj') {// 清单附件\n        filepath = item.filepath\n      } else if (type == 'comment1') { // 隔离墙操作变动 - 最新审核附件\n        filepath = item.checkFilepath\n      } else if (type == 'comment2') { // 隔离墙操作变动 - 完整表格审核附件\n        filepath = item.filepath\n      } else if (type == 'selfcheck') { // 清单自查附件\n        filepath = item.file_path\n      }\n      if (filepath) {\n        Wb.download({\n          url: 'm?xwl=info_query/PTY_CLEAR_INFO/operation/download_file',\n          params: {\n            disk_url: filepath\n          }\n        })\n      }\n    },\n    // 处理事由变化\n    handleReasonChange(item, isReset = true) {\n      if (!item.selected && !item.disabled) {\n        this.billList.forEach(row => {\n          if (row !== item) {\n            row.selected = false;\n          }\n        });\n        if (!this.piid1) {\n          item.selected = true;\n        } else {\n          item.selected = !item.selected\n        }\n      }\n      // 1. 重置相关字段\n      if (isReset) {\n        item.remark = '';\n      }\n\n      // 2. 根据事由类型处理特殊逻辑\n      item.remarkRequired = (item.listType === 'co' && item.inoutReason === '5') ||\n        (item.listType === 'cl' && item.inoutReason === '7');\n\n      // 3. rq原因变化时的特殊处理\n      if (item.listType === 'rq') {\n        const projType = this.basicForm.projtype;\n        const thisDate = item.inoutDate;\n\n        if (item.inoutReason) {\n          // rq有值：cq行启用，设为 disabled-except-first 状态，事由同步为rq的事由\n          const cqRow = this.billList.find(row => row.listType === 'cq');\n          if (cqRow) {\n            cqRow.linkSelected = true;\n            cqRow.disabled = true;\n            cqRow.selected = true;\n            cqRow.rowClass = 'disabled-except-first';\n            cqRow.inoutReason = item.inoutReason;\n          }\n          // rq行设为 disabled-except-first 状态\n          item.selected = true;\n          // item.rowClass = 'disabled-except-first disabled-row';\n\n          if (thisDate) {\n            // 计算静默期结束日期\n            this.calculateCQDate(this.billList, thisDate, projType);\n          }\n        } else {\n          // rq无值：cq行恢复禁用状态\n          const cqRow = this.billList.find(row => row.listType === 'cq');\n          if (cqRow) {\n            cqRow.linkSelected = false\n            cqRow.disabled = true;\n            cqRow.selected = false;\n            cqRow.rowClass = 'disabled-row';\n            cqRow.inoutReason = '';\n            cqRow.inoutDate = '';\n          }\n          // rq行恢复正常状态\n          // item.selected = false;\n          item.rowClass = '';\n        }\n        // rq变化不触发状态转换逻辑，直接返回\n        return;\n      }\n\n      // 4. 清除其他事由联动\n      this.clearLinkedEffects(this.billList, item);\n\n      // 5. 状态转换逻辑\n      this.handleStatusTransition(item, this.billList);\n    },\n    // 处理历史批次事由变化\n    handleReasonChangeHis(item, isReset = true) {\n      // 如果当前行未被选中，可进行切换\n      if (!item.selected && !item.disabled) {\n        this.billListHis.forEach(row => {\n          if (row !== item && !row.dataFlag) {\n            row.selected = false;\n          }\n        });\n        if (!this.piid1) {\n          item.selected = true;\n        } else {\n          item.selected = !item.selected\n        }\n      }\n\n      // 1. 重置相关字段\n      if (isReset) {\n        item.remark = '';\n      }\n\n      // 2. 根据事由类型处理特殊逻辑\n      item.remarkRequired = (item.listType === 'co' && item.inoutReason === '5') ||\n        (item.listType === 'cl' && item.inoutReason === '7');\n\n      // 3. rq原因变化时的特殊处理\n      if (item.listType === 'rq') {\n        const projType = this.basicForm.projtype;\n        const thisDate = item.inoutDate;\n\n        if (item.inoutReason) {\n          // rq有值：cq行启用，设为 disabled-except-first 状态，事由同步为rq的事由\n          const cqRow = this.billListHis.find(row => row.listType === 'cq');\n          if (cqRow) {\n            cqRow.linkSelected = true\n            cqRow.disabled = true;\n            cqRow.selected = true;\n            cqRow.rowClass = 'disabled-except-first';\n            cqRow.inoutReason = item.inoutReason;\n          }\n          item.selected = true;\n\n          if (thisDate) {\n            // 计算静默期结束日期\n            this.calculateCQDate(this.billListHis, thisDate, projType);\n          }\n        } else {\n          // rq无值：cq行恢复禁用状态\n          const cqRow = this.billListHis.find(row => row.listType === 'cq');\n          if (cqRow) {\n            cqRow.linkSelected = false\n            cqRow.disabled = true;\n            cqRow.selected = false;\n            cqRow.rowClass = 'disabled-row';\n            cqRow.inoutReason = '';\n            cqRow.inoutDate = '';\n          }\n          // rq行恢复正常状态\n          // item.selected = false;\n          item.rowClass = '';\n        }\n        // rq变化不触发状态转换逻辑，直接返回\n        return;\n      }\n\n      // 4. 清除其他的事由联动\n      this.clearLinkedEffects(this.billListHis, item);\n\n      // 5. 处理相关事由联动\n      if (item.inoutReason) {\n        this.handleStatusTransition(item, this.billListHis);\n      }\n    },\n    // 处理日期变化\n    handleDateChange(item) {\n      let projlist_status = '_$projlist_status$_' || this.projlist_status;\n      const billList = (this.showNewTable || (projlist_status == '0' && this.batchList?.length === 0)) ? this.billList : this.billListHis;\n      const joinStr = item.listType + item.inoutReason;\n      const projType = this.basicForm.projtype;\n      const thisDate = item.inoutDate;\n\n      // 处理 co、cl 日期变化时的状态转换\n      if ((item.listType === 'co' || item.listType === 'cl') && item.inoutReason) {\n        // 基本状态转换\n        if (joinStr === 'co3') {\n          this.updateBillRow(billList, 'rl', 1, thisDate);\n        } else if (joinStr === 'co4') {\n          this.updateBillRow(billList, 'rq', 1, thisDate);\n          this.updateBillRow(billList, 'cq', 1, thisDate);\n          this.calculateCQDate(billList, thisDate, projType);\n        } else if (joinStr === 'cl1') {\n          this.updateBillRow(billList, 'rq', 1, thisDate);\n          this.updateBillRow(billList, 'cq', 1, thisDate);\n          this.calculateCQDate(billList, thisDate, projType);\n        }\n\n        // 新三板项目特殊逻辑\n        if (projType && (projType.includes('新三板_OTC-推荐挂牌') || projType.includes('新三板_OTC-定向发行') || projType.includes('新三板_OTC-公开发行') || projType.includes('新三板_OTC-优先股'))) {\n          if (joinStr === 'cl5') {\n            this.updateBillRow(billList, 'rq', 1, thisDate);\n            this.updateBillRow(billList, 'cq', 1, thisDate);\n            this.calculateCQDate(billList, thisDate, projType);\n          }\n        }\n\n        // 股权融资_非公开项目特殊逻辑\n        if (projType && (projType.includes('股权融资_非公开') || projType.includes('新三板_OTC-定向发行'))) {\n          if (joinStr === 'co1') {\n            this.updateBillRow(billList, 'rq', 1, thisDate);\n            this.updateBillRow(billList, 'cq', 1, thisDate);\n            this.calculateCQDate(billList, thisDate, projType);\n          }\n        }\n      }\n\n      // 处理 rq 日期变化时的静默期结束日期计算\n      if (item.listType === 'rq' && item.inoutReason) {\n        this.calculateCQDate(billList, thisDate, projType);\n      }\n    },\n    // 清除因之前选择的事由而自动联动填充的其他行\n    clearLinkedEffects(billList, item) {\n      if (item.listType === 'co') {\n        // co3 联动了 rl 行\n        const rlRow = billList.find(r => r.listType === 'rl');\n        if (rlRow && rlRow.rowClass === 'disabled-except-first') {\n          rlRow.linkSelected = false;\n          rlRow.selected = false;\n          rlRow.disabled = true;\n          rlRow.rowClass = 'disabled-row';\n          rlRow.inoutReason = '';\n          rlRow.inoutDate = '';\n        }\n        // co4/co1 联动了 rq + cq 行\n        const rqRow = billList.find(r => r.listType === 'rq');\n        if (rqRow && rqRow.rowClass === 'disabled-except-first') {\n          rqRow.linkSelected = false;\n          rqRow.selected = false;\n          rqRow.disabled = true;\n          rqRow.rowClass = 'disabled-row';\n          rqRow.inoutReason = '';\n          rqRow.inoutDate = '';\n        }\n        const cqRow = billList.find(r => r.listType === 'cq');\n        if (cqRow && cqRow.rowClass === 'disabled-except-first') {\n          cqRow.linkSelected = false;\n          cqRow.selected = false;\n          cqRow.rowClass = 'disabled-row';\n          cqRow.disabled = true;\n          cqRow.inoutReason = '';\n          cqRow.inoutDate = '';\n        }\n      } else if (item.listType === 'cl') {\n        // cl1/cl5 联动了 rq + cq 行\n        const rqRow = billList.find(r => r.listType === 'rq');\n        if (rqRow && rqRow.rowClass === 'disabled-except-first') {\n          rqRow.linkSelected = false;\n          rqRow.selected = false;\n          rqRow.disabled = true;\n          rqRow.rowClass = 'disabled-row';\n          rqRow.inoutReason = '';\n          rqRow.inoutDate = '';\n        }\n        const cqRow = billList.find(r => r.listType === 'cq');\n        if (cqRow && cqRow.rowClass === 'disabled-except-first') {\n          cqRow.linkSelected = false;\n          cqRow.selected = false;\n          cqRow.disabled = true;\n          cqRow.rowClass = 'disabled-row';\n          cqRow.inoutReason = '';\n          cqRow.inoutDate = '';\n        }\n      } else if (item.listType === 'rq') {\n        const cqRow = billList.find(r => r.listType === 'cq');\n        if (cqRow && cqRow.rowClass === 'disabled-except-first') {\n          cqRow.linkSelected = false;\n          cqRow.selected = false;\n          cqRow.disabled = true;\n          cqRow.rowClass = 'disabled-row';\n          cqRow.inoutReason = '';\n          cqRow.inoutDate = '';\n        }\n      }\n    },\n    // 处理状态转换\n    handleStatusTransition(item, billList) {\n      const projType = this.basicForm.projtype;\n      const joinStr = item.listType + item.inoutReason;\n      const thisDate = item.inoutDate;\n      let isTransition = false; // \n\n      // 特殊业务规则优先\n      if (projType && (projType.includes('新三板_OTC-推荐挂牌') || projType.includes('新三板_OTC-定向发行') || projType.includes('新三板_OTC-公开发行') || projType.includes('新三板_OTC-优先股')) && joinStr === 'cl5') {\n        this.updateBillRow(billList, 'rq', 1, thisDate);\n        this.updateBillRow(billList, 'cq', 1, thisDate);\n        this.calculateCQDate(billList, thisDate, projType);\n        isTransition = true;\n      } else if (projType && (projType.includes('股权融资_非公开') || projType.includes('新三板_OTC-定向发行')) && joinStr === 'co1') {\n        this.updateBillRow(billList, 'rq', 1, thisDate);\n        this.updateBillRow(billList, 'cq', 1, thisDate);\n        this.calculateCQDate(billList, thisDate, projType);\n        isTransition = true;\n      } else if (joinStr === 'co3') {\n        // co3 (出观察清单-转限制清单) -> rl (入限制清单)\n        this.updateBillRow(billList, 'rl', 1, thisDate);\n        isTransition = true;\n      } else if (joinStr === 'co4') {\n        // co4 (出观察清单-转静默期) -> rq (入静默期) + cq (出静默期)\n        this.updateBillRow(billList, 'rq', 1, thisDate);\n        this.updateBillRow(billList, 'cq', 1, thisDate);\n        this.calculateCQDate(billList, thisDate, projType);\n        isTransition = true;\n      } else if (joinStr === 'cl1') {\n        // cl1 (出限制清单-价格/利率确定) -> rq (入静默期) + cq (出静默期)\n        this.updateBillRow(billList, 'rq', 1, thisDate);\n        this.updateBillRow(billList, 'cq', 1, thisDate);\n        this.calculateCQDate(billList, thisDate, projType);\n        isTransition = true;\n      }\n      // 非转换触发器：取消所有其他行的选中和disabled-except-first状态\n      if (!isTransition) {\n        billList.forEach(row => {\n          if (row.listType !== item.listType && !row.dataFlag) {\n            row.selected = false;\n            if (row.disabled && !row.dataFlag) { row.rowClass = 'disabled-row' };\n          }\n        });\n      }\n    },\n    // 更新清单行\n    updateBillRow(billList, listType, reason, date) {\n      const row = billList.find(item => item.listType === listType);\n      if (row) {\n        row.linkSelected = true;\n        row.selected = true;\n        row.disabled = true;\n        row.rowClass = 'disabled-except-first';\n        row.inoutReason = reason.toString();\n        row.inoutDate = date;\n      }\n    },\n    // 计算静默期结束日期\n    calculateCQDate(billList, startDate, projType) {\n      const cqRow = billList.find(item => item.listType === 'cq');\n      if (cqRow && startDate) {\n        const days = this.getSilentPeriodDays(projType);\n        cqRow.inoutDate = this.addDate(startDate, days);\n      }\n    },\n    // 获取静默期天数\n    getSilentPeriodDays(projType) {\n      if (projType && (projType.includes('IPO') || projType.includes('新三板_OTC-推荐挂牌'))) {\n        return 40; // IPO 和新三板_OTC-推荐挂牌项目静默期为 40 天\n      }\n      return 10; // 其他项目静默期为 10 天\n    },\n    // 日期计算\n    addDate(date, days) {\n      const d = new Date(date);\n      d.setDate(d.getDate() + days);\n      return d.toISOString().split('T')[0];\n    },\n\n\n    // 添加清单行\n    addBillRow() {\n      this.billList.push({\n        listType: '',\n        inoutReason: '',\n        inoutDate: '',\n        reportDate: '',\n        remark: '',\n        remarkRequired: false,\n        filepath: '',\n        fileName: ''\n      });\n    },\n    // 删除清单行\n    removeBillRow() {\n      this.billList = this.billList.filter(item => !this.selectedBillRows.includes(item));\n      this.selectedBillRows = [];\n    },\n    // 添加审核记录\n    addAuditRecord(item) {\n      // 先展开全部审核记录表格\n      if (!item.auditExpanded) {\n        item.auditExpanded = !item.auditExpanded;\n      }\n      console.log(\"addAuditRecord,item:\", item)\n      const today = new Date().toISOString().split('T')[0];\n      if (!item.checkTableData) {\n        this.$set(item, 'checkTableData', []);\n      }\n      item.checkTableData.push({\n        check_result: '',     // 审核结果：1通过/2未通过\n        check_record: '',     // 审核记录内容\n        create_time: today,    // 审核日期\n        remark: '',     // 备注（跨填报日期+备注说明两列）\n        fileName: '',        // 附件文件名\n        filepath: '',        // 附件路径\n        isDisabled: false,    // 是否禁用\n        isDeleteShow: true,   // 是否展示删除按钮\n      });\n      console.log(\"end item:\", item)\n    },\n    // 删除审核记录\n    removeAuditRecord(item, rIdx) {\n      item.checkTableData.splice(rIdx, 1);\n    },\n    // 添加自查行\n    addCheckRow() {\n      this.tableData.push({\n        check_date: Wb.format(new Date(), 'yyyy-MM-dd'),\n        check_result: '',\n        user_name: '_$sys.username$_',\n        remark: '',\n        fileName: '',\n        filepath: ''\n      });\n    },\n    // 移除自查行\n    removeCheckRow(index) {\n      if (this.tableData.length > 1) {\n        this.tableData.splice(index, 1);\n      }\n    },\n    // 根据清单类型和事由值获取显示文本\n    getSelectedReasonLabel(listType, value) {\n      if (!value) return '';\n      const options = this.reasonOptions[listType] || [];\n      const opt = options.find(o => o.value === value);\n      return opt ? opt.label : '';\n    },\n    // 切换审核记录区域折叠/展开\n    toggleAuditExpanded(item) {\n      item.auditExpanded = !item.auditExpanded;\n    },\n    // 清单选择变化\n    handleBillSelectionChange(selection) {\n      this.selectedBillRows = selection;\n    },\n    // 根据清单类型获取事由选项\n    getReasonOptions(listType) {\n      return this.reasonOptions[listType] || [];\n    },\n    // 清单类型改变\n    onListTypeChange(row) {\n      row.inoutReason = '';\n    },\n    // 判断当前清单行是否允许上传附件\n    // 1.已填报过的行 inoutReason/reporDate/filepath不为空且被选中(selected)\n    // 2.未填写的行 需要允许修改（！disabled）且被选中(selected)\n    canUploadFile(item) {\n      if (item.selected && (item.dataFlag || item.linkSelected)) {\n        return true;\n      }\n      if (!item.disabled && item.selected) {\n        return true;\n      }\n      return false;\n    },\n    // 判断当前清单行附件是否必填\n    // 入静默期 出静默期 附件非必填\n    isFileRequired(item) {\n      const listType = item.listType;\n      return ['ro', 'co', 'rl', 'cl'].includes(listType);\n    },\n    // 上传成功\n    handleUploadSuccess(res, row) {\n      console.log(\"handleUploadSuccess,row:\", row)\n      this.$message.success(\"附件上传成功\", 2000);\n      // 检查文件名中的非法字符\n      const fileName = this.checkSymbol(res.name || '');\n      row.filepath = res.path;\n      row.fileName = fileName;\n\n    },\n    // 检查文件名中的非法字符\n    checkSymbol(filename) {\n      if (!filename) {\n        return '';\n      }\n      if (filename.indexOf('[') > 0 || filename.indexOf(']') > 0) {\n        Wb.info('文件名含[]非法字符，保存时将自动替换为【】 !');\n        filename = filename.replace(/\\[/g, '【').replace(/\\]/g, '】');\n        return filename;\n      } else {\n        return filename;\n      }\n    },\n    getBatchId() {\n      let that = this\n      if (that.showNewTable || !that.basicForm.batch_id) {\n        return new Promise(function (resolve, reject) {\n          Wb.ajax({\n            url: 'm?xwl=info_query/projlist_data/inout_q',\n            params: {\n              i_projid: '_$projid$_'\n            },\n            success: function (resp) {\n              resp = Wb.decode(resp).items[0];\n              that.basicForm.batch_id = resp.batch_id\n              resolve(resp.batch_id)\n            },\n            error: function (err) {\n              reject(err)\n            }\n          })\n        })\n      } else {\n        return that.basicForm.batch_id\n      }\n    },\n    // 提交 type 1-提交 2-修正\n    handleSubmit: async function (type) {\n      let that = this;\n      let projlist_status = '_$projlist_status$_' || this.projlist_status;\n      let billList = (this.showNewTable || (projlist_status == '0' && this.batchList?.length === 0)) ? this.billList : this.billListHis;\n      let selectEditRow = billList.find(item => item.selected && item.rowClass !== 'disabled-except-first');\n      // selectedRows表示所有需要提交数据的行\n      let selectedRows = [];\n      billList?.forEach(item => {\n        if (item.selected) {\n          selectedRows.push(item);\n        }\n      })\n      // console.log(\"selectedRows\", selectedRows)\n      if (!that.validateCompanyData()) {\n        console.log(\"关联公司校验\")\n        return;\n      }\n\n      // 1. 表单校验\n      if (!that.validateForm()) {\n        console.log(\"表单校验不通过\")\n        return;\n      }\n\n      // 2. 禁用提交按钮，防止重复提交\n      that.submitButtonDisabled = true;\n\n      // 3. 准备提交数据\n      let submitData = that.prepareSubmitData(type);\n\n      // 4. 调用接口提交 关联信息修改(op_flag==1)用multistk_s\n      if (that.op_flag == '1') {\n        // 4.1 关联信息修改入口 提交（该入口现已关闭，逻辑保留）\n        const today = new Date();\n        const todayStr = `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, '0')}-${String(today.getDate()).padStart(2, '0')}`;\n        let successCount = 0;\n        let totalCount = 0;\n        const fillId = Wb.getId(); // 生成唯一填充ID，同批次所有行共享\n\n        // 过滤出需要提交的行\n        const submitRows = that.companyList.filter(item => !item.dataFlag);\n\n        if (submitRows.length === 0) {\n          Wb.info('页面数据无修改，不做提交操作！');\n          that.submitButtonDisabled = false;\n          return;\n        }\n\n        totalCount = submitRows.length;\n\n        // 逐行提交\n        submitRows.forEach((item, index) => {\n          // 构建单行提交数据\n          let rowData = {\n            i_projid: '_$projid$_',\n            i_projlist_status: '_$projlist_status$_' || that.projlist_status,\n            i_usercode: '_$sys.username$_',\n            i_submit_status: type,\n            i_fill_id: fillId,\n            i_comp_name: item.compName || '',\n            i_stk_name: item.stkName || '',\n            i_stk_code: item.stkCode || '',\n            i_related_property: item.relatedProperty || '',\n            i_ralated_ramark: item.remark || '',\n            i_write_date: item.writeDate || todayStr,\n            // i_data_flag: item.dataFlag ? '1' : '' （未用到）\n          };\n\n          Wb.ajax({\n            url: 'm?xwl=info_query/projlist_data/multistk_s',\n            params: rowData,\n            success(resp) {\n              let res = Wb.decode(resp);\n              if (res.O_RETURN_CODE === '0') {\n                successCount++;\n                // 所有行提交成功\n                if (successCount === totalCount) {\n                  that.showMessage('提交成功！', 2000, 'success');\n                  window.close();\n                }\n              } else {\n                that.showMessage('第' + (index + 1) + '行提交失败：' + res.O_RETURN_MSG, 2000, 'error');\n                that.submitButtonDisabled = false;\n              }\n            },\n            failure() {\n              that.showMessage('第' + (index + 1) + '行提交失败，请稍后重试', 2000, 'error');\n              that.submitButtonDisabled = false;\n            }\n          });\n        });\n        return;\n      } else if (that.piid1 && selectedRows?.length === 0) {\n        // 4.2 自查流程 - 更改清单表格信息跳过inout_s的后台校验\n        if (that.isEditing) {\n          that.saveData(true);\n        }\n        Wb.ajax({\n          url: 'm?xwl=info_query/projlist_data/selfcheck_s',\n          params: {\n            batchList: that.tableData,\n            piid: that.piid1,\n            projid: that.projid,\n            check_id: Wb.getId(),\n            check_batch_id: that.check_batch_id\n          },\n          success(resp) {\n            let result = Wb.decode(resp);\n            if (result.O_RETURN_CODE == '0') {\n              that.showMessage(\"保存成功，请至全链接系统OA待办点击递交。\", 2000, 'success');\n              window.close();// 只能从流程中打开浏览器窗口\n            } else {\n              that.showMessage(result.O_RETURN_MSG, 5000, 'error')\n            }\n          }\n        })\n        return;\n      } else if (that.piid2 && that.piid2 == 'beforedraft' && that.nodeCode == 'hgrysh') {\n        // 4.3 隔离墙操作变动流程 - 合规人员审核节点只保存审核意见, 下发节点\n        const billListHis = that.billListHis;\n        if (!billListHis || !Array.isArray(billListHis)) return [];\n\n        // 定义 listType 到 inout_type/inout_direct 的映射关系\n        const typeMap = {\n          ro: { inout_type: 'o', inout_direct: 'i' }, // 入观察\n          co: { inout_type: 'o', inout_direct: 'o' }, // 出观察\n          rl: { inout_type: 'l', inout_direct: 'i' }, // 入限制\n          cl: { inout_type: 'l', inout_direct: 'o' }, // 出限制\n          rq: { inout_type: 'q', inout_direct: 'i' }, // 入静默\n          cq: { inout_type: 'q', inout_direct: 'o' }  // 出静默\n        };\n\n        const paramsTable = [];\n        let resCount = 0;\n        let checkResultText = ''; // 隔离墙操作变动流程所需参数 - 审核反馈 \n        let checkResultTime = ''; // 隔离墙操作变动流程所需参数 - 审核时间\n        let curBatch = '';\n        let pk_id = Wb.getId(); // 流程下发的唯一ID\n        const checkRecordSet = new Set();\n\n        Object.keys(that.cacheAuditData).forEach(batchKey => {\n          const batchCache = that.cacheAuditData[batchKey];\n          const batchId = batchCache.batchId || that.basicForm.batch_id || '';\n\n          Object.keys(batchCache.listTypes || {}).forEach(listType => {\n            const config = typeMap[listType];\n            if (!config) return;\n\n            const cacheItem = batchCache.listTypes[listType];\n            const tableRows = cacheItem.checkTableData || [];\n\n            tableRows.forEach(row => {\n              if (!row.isDisabled && row.check_result == '1') {\n                resCount += 1;\n                checkRecordSet.add(row.check_record);\n                checkResultTime = row.check_date; // 取最后一条审核记录的时间\n              }\n              if (!row.isDisabled) {\n                paramsTable.push({\n                  piid: that.piid2,\n                  projid: that.projid,\n                  batch_id: batchId || row.batch_id || '',\n                  inout_id: row.inout_id || '',\n                  check_id: Wb.getId(),\n                  check_result: row.check_result,\n                  check_record: row.check_record,\n                  remark: row.remark || '',\n                  upload_id: row.upload_id || '',\n                  filepath: row.filepath || '',\n                  create_time: row.create_time,\n                  create_user: row.create_user,\n                  update_time: row.update_time,\n                  update_user: row.update_user,\n                  inout_type: config.inout_type,\n                  inout_direct: config.inout_direct,\n                  pk_id: pk_id\n                });\n              }\n            });\n          });\n        });\n        checkResultText = [...checkRecordSet].map(r => r + '不准确').join('；');\n        if (paramsTable.length === 0) {\n          that.showMessage(\"未新增审核意见\", 2000, 'warning');\n          that.submitButtonDisabled = false;\n          return\n        }\n        // 保存合规人员审核意见\n        Wb.ajax({\n          url: 'm?xwl=info_query/projlist_data/comment_s',\n          params: {\n            paramsTable: paramsTable\n          },\n          success(resp) {\n            let result = Wb.decode(resp);\n            if (result.O_RETURN_CODE == '0') {\n              console.log(\"----resCount\", resCount);\n              that.showMessage(\"保存成功\", 2000, 'success');\n\n              if (resCount > 0 && that.piid2 == 'beforedraft') {\n                // 下发隔离墙操作变动流程 最终审核结果存在不准确的记录，且是合规人员点击提交，下发流程、\n\n                let formData = {\n                  PROJ_ID: '_$projid$_',\n                  BATCH_ID: that.basicForm.batch_id,\n                  DEPTMANANAME: '何川',//'_$deptmananame$_',\n                  KHNAME: that.basicForm.custname,\n                  PROJCODE: that.basicForm.projcode,\n                  STOCKCODE: '', // 证券代码（实际未用到）\n                  STOCKNAME: '', // 股票简称（实际未用到）\n                  STAFF_ID: '120578', //'_$staff_id$_',// 项目负责人阅知节点候选人参数，测试时先设置成固定人员 chenhaiyang  114398 hechuan 120578\n                  DEPTNAME: that.deptname,\n                  PROJLIST_STATUS: that.basicForm.projlist_status,\n                  OP_CONTENT: '', // 合规人员下发时无项目负责人操作内容\n                  OP_TIME: '',    // 合规人员下发时无项目负责人操作时间\n                  CHECK_RESULT: checkResultText,\n                  CHECK_TIME: checkResultTime,\n                  PROJNAME: that.basicForm.projname,\n                  IS_MANAUL: '1',// 1-合规人员主动触发 0-项目组变更清单内容触发\n                  PROJTYPE: that.basicForm.projtype,\n                  DEPT_USER_ID: '038622', // that.candidates hechuan 038622\n                  PK_ID: pk_id\n                };\n\n                Wb.ajax({\n                  url: 'm?xwl=th_projlist/ADMIN_PROJLIST/operation/flow_request_deal',\n                  params: {\n                    'x-flow-systemId': 'IBCM',//当前发送全连接流程类型\n                    'x-userId': '_$sys.userid$_',//当前登录人id\n                    'x-userName': '_$sys.username$_',//encodeURI('_$sys.username$_'),//当前登录人name\n                    'url': 'http://10.116.131.13:8094/auto/submit',\n                    'formDatas': formData,\n                    \"todoTitle\": that.basicForm.projname + '项目清单审核意见反馈',// 工作台待办名称\n                    \"sysGuid\": \"IBCM\",\n                    \"flowCode\": \"IBCM003\",\n                    \"templateName\": that.basicForm.projname + '项目清单审核意见反馈',// 待办表单打开后标题\n                    \"flowVer\": \"1\",\n                    \"nodeCode\": \"draft\",\n                    \"applyTable\": \"T_PROJ_CHANGE_FLOW\",\n                    \"candidates\": '038622', // 合规人员主动发起，candidates为项目负责人的user_id\n                  },\n                  success(resp) {\n                    let res = Wb.decode(resp)\n                    if (res.code == '0') {\n                      that.showMessage(\"存在不准确记录，已下发【合规人员清单审核管理流程】\", 2000, 'success');\n                      if (app.parentApp.parentContainer) {\n                        app.parentApp.parentContainer.close();\n                      }\n                    } else {\n                      that.showMessage(\"【合规人员清单审核管理流程】下发失败：\" + res.msg, 2000, 'error');\n                    }\n                  }\n                });\n              } else {\n                // 不存在不准确记录，直接关闭页面\n                if (app.parentApp.parentContainer) {\n                  app.parentApp.parentContainer.close();\n                }\n              }\n            } else {\n              that.submitButtonDisabled = false;\n              that.showMessage(result.O_RETURN_MSG, 5000, 'error')\n            }\n          }\n        })\n        return;\n      } else if (that.piid2 && that.piid2 != 'beforedraft' && that.nodeCode == 'hgrysh') {\n        // 4.3 隔离墙操作变动流程 - 合规人员审核节点只保存审核意见\n        const billListHis = that.billListHis;\n        if (!billListHis || !Array.isArray(billListHis)) return [];\n\n        // 定义 listType 到 inout_type/inout_direct 的映射关系\n        const typeMap = {\n          ro: { inout_type: 'o', inout_direct: 'i' }, // 入观察\n          co: { inout_type: 'o', inout_direct: 'o' }, // 出观察\n          rl: { inout_type: 'l', inout_direct: 'i' }, // 入限制\n          cl: { inout_type: 'l', inout_direct: 'o' }, // 出限制\n          rq: { inout_type: 'q', inout_direct: 'i' }, // 入静默\n          cq: { inout_type: 'q', inout_direct: 'o' }  // 出静默\n        };\n\n        const paramsTable = [];\n        let resCount = 0;\n        let checkResultText = ''; // 隔离墙操作变动流程所需参数 - 审核反馈 \n        let checkResultTime = ''; // 隔离墙操作变动流程所需参数 - 审核时间\n        let curBatch = '';\n        let curCheckId = Wb.getId(); // 当前最新一批审核记录的唯一id\n        const checkRecordSet = new Set();\n\n        Object.keys(that.cacheAuditData).forEach(batchKey => {\n          const batchCache = that.cacheAuditData[batchKey];\n          const batchId = batchCache.batchId || that.basicForm.batch_id || '';\n\n          Object.keys(batchCache.listTypes || {}).forEach(listType => {\n            const config = typeMap[listType];\n            if (!config) return;\n\n            const cacheItem = batchCache.listTypes[listType];\n            const tableRows = cacheItem.checkTableData || [];\n\n            tableRows.forEach(row => {\n              if (!row.isDisabled && row.check_result == '1') {\n                resCount += 1;\n                // checkResultText += row.check_record + '不准确；';\n                checkRecordSet.add(row.check_record);\n                checkResultTime = row.check_date; // 取最后一条审核记录的时间\n              }\n              if (!row.isDisabled) {\n                paramsTable.push({\n                  piid: that.piid2,\n                  projid: that.projid,\n                  batch_id: batchId || row.batch_id || '',\n                  inout_id: row.inout_id || '',\n                  check_id: Wb.getId(),\n                  check_result: row.check_result,\n                  check_record: row.check_record,\n                  remark: row.remark || '',\n                  upload_id: row.upload_id || '',\n                  filepath: row.filepath || '',\n                  create_time: row.create_time,\n                  create_user: row.create_user,\n                  update_time: row.update_time,\n                  update_user: row.update_user,\n                  inout_type: config.inout_type,\n                  inout_direct: config.inout_direct\n                });\n              }\n            });\n          });\n        });\n        checkResultText = [...checkRecordSet].map(r => r + '不准确').join('；');\n        if (paramsTable.length === 0) {\n          that.showMessage('未新增审核意见', 2000, 'warning');\n          that.submitButtonDisabled = false;\n          return;\n        }\n        // 保存合规人员审核意见\n        Wb.ajax({\n          url: 'm?xwl=info_query/projlist_data/comment_s',\n          params: {\n            paramsTable: paramsTable\n          },\n          success(resp) {\n            let result = Wb.decode(resp);\n            if (result.O_RETURN_CODE == '0') {\n              Wb.ajax({\n                url: 'm?xwl=th_projlist/ADMIN_PROJLIST/operation/update_mainform_value',\n                params: {\n                  piid2: that.piid2,\n                  check_result_flag: (resCount > 0) ? 1 : 0,\n                  check_result: checkResultText\n                },\n                success(resp) {\n                  let result = Wb.decode(resp);\n                  if (result.O_RETURN_CODE == '0') {\n                    that.showMessage(\"保存成功\", 2000, 'success');\n                    if (app?.parentApp?.parentContainer) {\n                      app.parentApp.parentContainer.close();\n                    } else {\n                      window.close()\n                    }\n                  } else {\n                    that.showMessage(result.O_RETURN_MSG, 2000, 'error');\n                    that.submitButtonDisabled = false;\n                  }\n                }\n              });\n            } else {\n              that.submitButtonDisabled = false;\n              that.showMessage(result.O_RETURN_MSG, 5000, 'error')\n            }\n          }\n        });\n        return;\n      } else {\n        // 4.4 修改了清单表格信息\n        // case1：前台清单变更入口进\n        // case2：自查流程 且修改了清单表单\n        // case3：隔离墙操作变动流程 且项目负责人阅知节点\n        Wb.ajax({\n          url: 'm?xwl=info_query/projlist_data/inout_s',\n          params: submitData,\n          success: async function (resp) {\n            let res = Wb.decode(resp);\n            if (res.O_RETURN_CODE == '0') {\n              that.saveData(true);\n              that.showMessage('提交成功！', 2000, 'success');\n              try {\n                // 如果是从自查流程进来则还需要保存自查结果\n                if (that.piid1) {\n                  Wb.ajax({\n                    url: 'm?xwl=info_query/projlist_data/selfcheck_s',\n                    params: {\n                      batchList: that.tableData,\n                      piid: that.piid1,\n                      projid: that.projid,\n                      check_id: Wb.getId(),\n                      check_batch_id: that.check_batch_id\n                    },\n                    success: async function (resp) {\n                      let result = Wb.decode(resp);\n                      if (result.O_RETURN_CODE == '0') {\n                        that.showMessage(\"保存成功，请至全链接系统OA待办点击递交。\", 2000, 'success');\n                        // 清单状态变更 发起隔离墙操作变动流程\n                        if (selectedRows) {\n                          const batch_id = await that.getBatchId()\n                          const now = new Date();\n\n                          // 获取各项时间并补零\n                          const year = now.getFullYear();\n                          const month = String(now.getMonth() + 1).padStart(2, '0'); // 月份从 0 开始，需要 +1\n                          const day = String(now.getDate()).padStart(2, '0');\n                          const hours = String(now.getHours()).padStart(2, '0');\n                          const minutes = String(now.getMinutes()).padStart(2, '0');\n                          const seconds = String(now.getSeconds()).padStart(2, '0');\n\n                          const nowTime = `${year}/${month}/${day} ${hours}:${minutes}:${seconds}`;\n\n                          let formData = {\n                            PROJ_ID: '_$projid$_',\n                            BATCH_ID: batch_id,\n                            DEPTMANANAME: '何川',//'_$deptmananame$_',\n                            KHNAME: that.basicForm.custname,\n                            PROJCODE: that.basicForm.projcode,\n                            STOCKCODE: '', // 证券代码（实际未用到）\n                            STOCKNAME: '', // 股票简称（实际未用到）\n                            STAFF_ID: '120578', //'_$staff_id$_', // 清单变更触发，项目负责人阅知节点候选人，测试时写死成 chenhaiyang 114398\n                            DEPTNAME: that.deptname,\n                            PROJLIST_STATUS: that.basicForm.projlist_status,\n                            OP_CONTENT: that.getOP_CONTENT(selectEditRow, selectedRows),\n                            OP_TIME: nowTime,\n                            CHECK_RESULT: '',\n                            CHECK_TIME: '',\n                            PROJNAME: that.basicForm.projname,\n                            IS_MANAUL: '0',// 1-合规人员主动触发 0-项目组变更清单内容触发\n                            PROJTYPE: that.basicForm.projtype,\n                            DEPT_USER_ID: '038622' //'_$sys.userid$_'\n                          };\n\n                          Wb.ajax({\n                            url: 'm?xwl=th_projlist/ADMIN_PROJLIST/operation/flow_request_deal',\n                            params: {\n                              'x-flow-systemId': 'IBCM',//当前发送全连接流程类型\n                              'x-userId': '_$sys.userid$_',//当前登录人id\n                              'x-userName': '_$sys.username$_',//encodeURI('_$sys.username$_'),//当前登录人name\n                              'url': 'http://10.116.131.13:8094/auto/submit',\n                              'formDatas': formData,\n                              \"todoTitle\": that.basicForm.projname + '项目清单审核意见反馈',// 工作台待办名称\n                              \"sysGuid\": \"IBCM\",\n                              \"flowCode\": \"IBCM003\",\n                              \"templateName\": that.basicForm.projname + '项目清单审核意见反馈',// 待办表单打开后标题\n                              \"flowVer\": \"1\",\n                              \"nodeCode\": \"draft\",\n                              \"applyTable\": \"T_PROJ_CHANGE_FLOW\",\n                              \"candidates\": '038622',//that.candidates,// 项目负责人user_id\n                            },\n                            success(resp) {\n                              let res = Wb.decode(resp)\n                              if (res.code == '0') {\n                                that.showMessage(\"清单状态变更，已下发【隔离墙操作变动流程】\", 2000, 'success');\n                                if (app?.parentApp?.parentContainer) {\n                                  app.parentApp.parentContainer.close();\n                                } else {\n                                  window.close();\n                                }\n                              } else {\n                                that.showMessage(\"【隔离墙操作变动流程】下发失败\", 2000, 'error');\n                              }\n                            }\n                          });\n                        } else {\n                          if (app?.parentApp?.parentContainer) {\n                            app.parentApp.parentContainer.close();\n                          } else {\n                            window.close();\n                          }\n                        }\n                      } else {\n                        that.showMessage(result.O_RETURN_MSG, 5000, 'error')\n                      }\n                    }\n                  })\n                } else {\n                  // 清单状态变更 发起隔离墙操作变动流程\n                  if (selectedRows) {\n                    const batch_id = await that.getBatchId()\n                    const now = new Date();\n\n                    // 获取各项时间并补零\n                    const year = now.getFullYear();\n                    const month = String(now.getMonth() + 1).padStart(2, '0'); // 月份从 0 开始，需要 +1\n                    const day = String(now.getDate()).padStart(2, '0');\n                    const hours = String(now.getHours()).padStart(2, '0');\n                    const minutes = String(now.getMinutes()).padStart(2, '0');\n                    const seconds = String(now.getSeconds()).padStart(2, '0');\n\n                    const nowTime = `${year}/${month}/${day} ${hours}:${minutes}:${seconds}`;\n\n                    let formData = {\n                      PROJ_ID: '_$projid$_',\n                      BATCH_ID: batch_id,\n                      DEPTMANANAME: '何川',//'_$deptmananame$_',\n                      KHNAME: that.basicForm.custname,\n                      PROJCODE: that.basicForm.projcode,\n                      STOCKCODE: '', // 证券代码（实际未用到）\n                      STOCKNAME: '', // 股票简称（实际未用到）\n                      STAFF_ID: '120578', //'_$staff_id$_', // 清单变更触发，项目负责人阅知节点候选人，测试时写死成 chenhaiyang 114398\n                      DEPTNAME: that.deptname,\n                      PROJLIST_STATUS: that.basicForm.projlist_status,\n                      OP_CONTENT: that.getOP_CONTENT(selectEditRow, selectedRows),\n                      OP_TIME: nowTime,\n                      CHECK_RESULT: '',\n                      CHECK_TIME: '',\n                      PROJNAME: that.basicForm.projname,\n                      IS_MANAUL: '0',// 1-合规人员主动触发 0-项目组变更清单内容触发\n                      PROJTYPE: that.basicForm.projtype,\n                      DEPT_USER_ID: '038622' // '_$sys.userid$_'\n                    };\n\n                    Wb.ajax({\n                      url: 'm?xwl=th_projlist/ADMIN_PROJLIST/operation/flow_request_deal',\n                      params: {\n                        'x-flow-systemId': 'IBCM',//当前发送全连接流程类型\n                        'x-userId': '_$sys.userid$_',//当前登录人id\n                        'x-userName': '_$sys.username$_',//encodeURI('_$sys.username$_'),//当前登录人name\n                        'url': 'http://10.116.131.13:8094/auto/submit',\n                        'formDatas': formData,\n                        \"todoTitle\": that.basicForm.projname + '项目清单审核意见反馈',// 工作台待办名称\n                        \"sysGuid\": \"IBCM\",\n                        \"flowCode\": \"IBCM003\",\n                        \"templateName\": that.basicForm.projname + '项目清单审核意见反馈',// 待办表单打开后标题\n                        \"flowVer\": \"1\",\n                        \"nodeCode\": \"draft\",\n                        \"applyTable\": \"T_PROJ_CHANGE_FLOW\",\n                        \"candidates\": '038622',//that.candidates,// 项目负责人user_id\n                      },\n                      success(resp) {\n                        let res = Wb.decode(resp)\n                        if (res.code == '0') {\n                          that.showMessage(\"清单状态变更，已下发【隔离墙操作变动流程】\", 2000, 'success');\n                          if (app?.parentApp?.parentContainer) {\n                            app.parentApp.parentContainer.close();\n                          } else {\n                            window.close();\n                          }\n                        } else {\n                          that.showMessage(\"【隔离墙操作变动流程】下发失败\", 2000, 'error');\n                        }\n                      }\n                    });\n                  } else {\n                    if (app?.parentApp?.parentContainer) {\n                      app.parentApp.parentContainer.close();\n                    } else {\n                      window.close();\n                    }\n                  }\n                }\n              } catch { }\n            } else {\n              that.showMessage(\"清单信息保存失败：\" + res.O_RETURN_MSG, 2000, 'error');\n            }\n            that.submitButtonDisabled = false;\n          },\n          failure() {\n            that.showMessage('提交失败，请稍后重试', 2000, 'error');\n            that.submitButtonDisabled = false;\n          }\n        });\n        return;\n      }\n    },\n    // 获取OP_CONTENT\n    getOP_CONTENT(selectEditRow, selectedRows) {\n      let parts = []\n      if (selectEditRow) {\n        parts.push(`清单状态变更-${selectEditRow.typeLabel}`)\n      }\n      if (selectedRows?.length > 0) {\n        let changeRows = []\n        let matchedRows = []\n        if (selectEditRow) {\n          changeRows = selectedRows?.filter(row =>\n            !row.dataFlag && row.listType != selectEditRow.listType && row.linkSelected && row.listType != 'cq'\n          )\n          matchedRows = selectedRows?.filter(row =>\n            row.dataFlag && row.filepath && row.listType != selectEditRow.listType && !row.linkSelected\n          )\n        } else {\n          matchedRows = selectedRows?.filter(row =>\n            row.dataFlag && row.filepath && !row.linkSelected\n          )\n        }\n        if (changeRows.length > 0) {\n          const labels = changeRows?.map(row => row.typeLabel).join('、')\n          parts.push(`清单状态变更-${labels}`)\n        }\n        if (matchedRows.length > 0) {\n          const labels = matchedRows?.map(row => row.typeLabel).join('、')\n          parts.push(`清单附件变更-${labels}`)\n        }\n      }\n      return parts.join('、')\n    },\n    // 关联公司校验\n    validateCompanyData() {\n      // 只有在编辑状态下才校验关联公司数据\n      if (this.isEditing) {\n        for (let i = 0; i < this.companyList.length; i++) {\n          let item = this.companyList[i];\n          if (item.compName && item.compName.trim() !== '') {\n            if (!item.stkCode) {\n              this.$message.warning('证券代码必填！');\n              return false;\n            }\n          }\n          // 如果填写了证券代码，则校验其他必填项\n          if (item.stkCode && item.stkCode.trim() !== '') {\n            if (!item.compName || item.compName.trim() === '') {\n              this.$message.warning('请填写关联公司名称');\n              return false;\n            }\n            if (!item.relatedProperty) {\n              this.$message.warning('关联性质必填！');\n              return false;\n            }\n            // 关联性质为\"其他\"时，备注必填\n            if (item.relatedProperty === '4' && (!item.remark || item.remark.trim() === '')) {\n              this.$message.warning('当关联性质选择为其他时，备注栏必填！');\n              return false;\n            }\n          }\n        }\n      }\n      return true;\n    },\n    // 表单校验\n    validateForm() {\n      console.log(\"进入表单校验\");\n      console.log(\"this.companyList\", this.companyList);\n      let op_flag = this.op_flag;\n      let projlist_status = '_$projlist_status$_' || this.projlist_status;\n      // 1. 校验关联公司列表（证券代码必填）\n      // // 1. 校验关联公司列表（仅当从关联信息修改入口进来时必填）\n      // if (op_flag == '1') {\n      //   // 从关联信息修改入口进来：关联信息必填\n      //   for (let i = 0; i < this.companyList.length; i++) {\n      //     let item = this.companyList[i];\n\n      //     // 关联性质必填\n      //     if (!item.relatedProperty) {\n      //       this.$message.warning('关联性质必填！');\n      //       return false;\n      //     }\n\n      //     // 证券代码必填\n      //     if (!item.stkCode || item.stkCode.trim() === '') {\n      //       this.$message.warning('证券代码必填！');\n      //       return false;\n      //     }\n\n      //     // 关联性质为\"其他\"时，备注必填\n      //     if (item.relatedProperty === '4' && (!item.remark || item.remark.trim() === '')) {\n      //       this.$message.warning('当关联性质选择为其他时，备注栏必填！');\n      //       return false;\n      //     }\n      //   }\n      // } else {\n      //   // 从清单填报入口进来：关联信息为可选填\n      //   // 只有填写了证券代码的行才需要校验其他字段\n      //   for (let i = 0; i < this.companyList.length; i++) {\n      //     let item = this.companyList[i];\n      //     // 如果填写了证券代码，则校验其他必填项\n      //     if (item.stkCode && item.stkCode.trim() !== '') {\n      //       if (!item.compName || item.compName.trim() === '') {\n      //         this.$message.warning('请填写关联公司名称');\n      //         return false;\n      //       }\n      //       if (!item.relatedProperty) {\n      //         this.$message.warning('关联性质必填！');\n      //         return false;\n      //       }\n      //       // 关联性质为\"其他\"时，备注必填\n      //       if (item.relatedProperty === '4' && (!item.remark || item.remark.trim() === '')) {\n      //         this.$message.warning('当关联性质选择为其他时，备注栏必填！');\n      //         return false;\n      //       }\n      //     }\n      //   }\n      // }\n\n      // 2. 校验清单数据\n      if (this.piid1) {\n        // 2.1 自查流程 自查表格校验\n        for (let i = 0; i < this.tableData.length; i++) {\n          const row = this.tableData[i];\n          console.log(\"row\", row)\n          // 校验 check_date\n          if (!row.check_date || String(row.check_date).trim() === '') {\n            this.showMessage(`自查情况的“自查日期”不能为空`, 2000, 'error');\n            return false;\n          }\n\n          // 校验 check_result\n          if (!row.check_result || String(row.check_result).trim() === '') {\n            this.showMessage(`自查情况的“自查结果”不能为空`, 2000, 'error');\n            return false;\n          }\n          // 校验 remark\n          if (row.check_result && row.check_result == '1' && (!row.remark || String(row.remark).trim() === '')) {\n            this.showMessage(`自查情况的“备注说明”不能为空，请说明更正情况。`, 2000, 'error');\n            return false;\n          }\n        }\n        // 如果勾选了清单行则清单行也要校验\n        let billList = (this.showNewTable || (projlist_status == '0' && this.batchList?.length === 0)) ? this.billList : this.billListHis;\n        let selectEditRow = billList.find(item => item.selected && item.rowClass !== 'disabled-except-first')\n        let selectedRows = [];\n        billList?.forEach(item => {\n          if (item.selected) {\n            selectedRows.push(item);\n          }\n        })\n        if (selectEditRow) {\n          if (selectEditRow && !selectEditRow.inoutReason) {\n            this.$message.warning('请选择入/出单事由');\n            return false;\n          }\n          if (selectEditRow && !selectEditRow.inoutDate) {\n            this.$message.warning('请选择入/出单事由发生日期');\n            return false;\n          }\n          // if (selectEditRow && !selectEditRow.reportDate) {\n          //   this.$message.warning('请选择入/出单事由填报日期');\n          //   return false;\n          // }\n          if (selectEditRow.inoutDate) {\n            const inoutDate = new Date(selectEditRow.inoutDate);\n            const today = new Date();\n            const reportDate = new Date(today.getFullYear(), today.getMonth(), today.getDate());\n            inoutDate.setHours(0, 0, 0, 0);\n            reportDate.setHours(0, 0, 0, 0);\n            if (inoutDate > reportDate) {\n              this.$message.warning('入/出单事由发生日期不能晚于填报日期');\n              return false;\n            }\n          }\n        }\n        // co5和cl7备注说明必填\n        if (selectEditRow && ((selectEditRow.listType === 'co' && selectEditRow.inoutReason === '5') ||\n          (selectEditRow.listType === 'cl' && selectEditRow.inoutReason === '7'))) {\n          if (!selectEditRow.remark || selectEditRow.remark.trim() === '') {\n            this.$message.warning('请填写备注说明');\n            return false;\n          }\n        }\n        // ro co rl cl 附件必填\n        if (selectEditRow && (this.isFileRequired(selectEditRow))) {\n          if (!selectEditRow.filepath || selectEditRow.filepath.trim() === '') {\n            this.$message.warning(`\"${selectEditRow.typeLabel}\"阶段必须上传附件`);\n            return false;\n          }\n        }\n        for (let i = 0; i < selectedRows.length; i++) {\n          if (selectedRows[i].rowClass === 'disabled-except-first' && !selectedRows[i].filepath && selectedRows[i].dataFlag && selectedRows[i].disabled) {\n            this.$message.warning(`若无需补充附件，请取消\"${selectedRows[i].typeLabel}\"行的勾选`);\n            return false;\n          }\n        }\n      } else if (this.piid2 && this.nodeCode == 'hgrysh') {\n        // 2.2 隔离墙操作变动流程 合规人员审核节点 只校验审核表单\n        this.cacheCurrentBatchAuid()\n\n        const batchKeys = Object.keys(this.cacheAuditData)\n        for (let i = 0; i < batchKeys.length; i++) {\n          const batchKey = batchKeys[i];\n          const batchCache = this.cacheAuditData[batchKey] || [];\n          const batchInfo = this.batchList.find(batch => batch.batchName.toString() === batchKey)\n          const batchName = batchInfo ? batchInfo.batchName : ('批次' + batchKey)\n\n          const listTypeKeys = Object.keys(batchCache.listTypes || [])\n\n          for (let j = 0; j < listTypeKeys.length; j++) {\n            const listType = listTypeKeys[j];\n            const cacheItem = batchCache.listTypes[listType]\n            const rowInfo = this.billListHis?.find(r => r.listType == listType)\n            const typeLabel = rowInfo ? rowInfo.typeLabel : listType\n\n            const tableRows = cacheItem.checkTableData || []\n            for (let k = 0; k < tableRows.length; k++) {\n              const row = tableRows[k]\n              // 1. 审核结果必填校验\n              if (!row.check_result || String(row.check_result).trim() === '') {\n                this.showMessage(`请选择“${batchName}-${typeLabel}”的审核结果`, 2000, 'error');\n                return false;\n              }\n\n              // 2. 审核结果为\"不准确\"时，审核记录必填\n              // check_result: '1' = 不准确, '0' = 准确\n              // check_record: '事由审核', '日期审核', '附件审核', '其他'\n              if (row.check_result === '1') {\n                if (!row.check_record || String(row.check_record).trim() === '') {\n                  this.showMessage(`${batchName}-${typeLabel}审核结果为\"不准确\"时请选择审核记录`, 2000, 'error');\n                  return false;\n                }\n              }\n            }\n          }\n        }\n      } else {\n        // 2.3 关联信息修改\n        // if (op_flag == '1') {\n        //   // 关联信息修改入口：只检查关联信息数据是否有修改\n        //   let hasChanges = false;\n        //   for (let i = 0; i < this.companyList.length; i++) {\n        //     let item = this.companyList[i];\n        //     if (item.dataFlag) {\n        //       hasChanges = true;\n        //       break;\n        //     }\n        //   }\n        //   if (!hasChanges) {\n        //     Wb.info('页面数据无修改，不做提交操作！');\n        //     this.submitButtonDisabled = false;\n        //     return false;\n        //   }\n        // } else {\n        // 清单填报入口：校验清单数据\n        let billList = (this.showNewTable || (projlist_status == '0' && this.batchList?.length === 0)) ? this.billList : this.billListHis;\n\n        let selectEditRow = billList.find(item => item.selected && item.rowClass !== 'disabled-except-first')\n        let selectedRows = [];\n\n        billList.forEach(item => {\n          if (item.selected) {\n            selectedRows.push(item);\n          }\n        });\n        console.log(\"--------------------selectedRows\", selectEditRow)\n        // hasChanges判断关联信息是否有变更\n        // let hasChanges = false;\n        // for (let i = 0; i < this.companyList.length; i++) {\n        //   let item = this.companyList[i];\n        //   if (item.dataFlag) {\n        //     hasChanges = true;\n        //     break;\n        //   }\n        // }\n        // 1.未选择任何清单行\n        if (selectedRows.length == 0) {\n          this.$message.warning('请选择清单类型');\n          return false;\n        } else {\n          if (selectEditRow) {\n            console.log(\"validate1\", selectEditRow);\n            // 只进行清单填报\n\n            if (!selectEditRow.inoutReason) {\n              this.$message.warning('请选择入/出单事由');\n              return false;\n            }\n\n            if (!selectEditRow.inoutDate) {\n              this.$message.warning('请选择入/出单事由发生日期');\n              return false;\n            }\n\n            // if (!selectEditRow.reportDate) {\n            //   this.$message.warning('请选择入/出单事由填报日期');\n            //   return false;\n            // }\n\n            if (selectEditRow.inoutDate) {\n              const inoutDate = new Date(selectEditRow.inoutDate);\n              const today = new Date();\n              const reportDate = new Date(today.getFullYear(), today.getMonth(), today.getDate());\n              inoutDate.setHours(0, 0, 0, 0);\n              reportDate.setHours(0, 0, 0, 0);\n              if (inoutDate > reportDate) {\n                this.$message.warning('入/出单事由发生日期不能晚于填报日期');\n                return false;\n              }\n            }\n\n            // co5和cl7备注说明必填\n            if ((selectEditRow.listType === 'co' && selectEditRow.inoutReason === '5') ||\n              (selectEditRow.listType === 'cl' && selectEditRow.inoutReason === '7')) {\n              if (!selectEditRow.remark || selectEditRow.remark.trim() === '') {\n                this.$message.warning('请填写备注说明');\n                return false;\n              }\n            }\n            // ro co rl cl 附件必填\n            if (this.isFileRequired(selectEditRow)) {\n              if (!selectEditRow.filepath || selectEditRow.filepath.trim() === '') {\n                this.$message.warning(`\"${selectEditRow.typeLabel}\"阶段必须上传附件`);\n                return false;\n              }\n            }\n          }\n          for (let i = 0; i < selectedRows.length; i++) {\n            if (selectedRows[i].rowClass === 'disabled-except-first' && !selectedRows[i].filepath && selectedRows[i].dataFlag && selectedRows[i].disabled) {\n              // cq行特殊处理\n              if (selectedRows[i].listType !== 'cq' || projlist_status !== 'rq') {\n                this.$message.warning(`若无需补充附件，请取消\"${selectedRows[i].typeLabel}\"行的勾选`);\n                return false;\n              }\n            }\n          }\n        }\n      }\n      return true;\n    },\n    // 准备提交数据\n    prepareSubmitData(type) {\n      let projlist_status = '_$projlist_status$_' || this.projlist_status;\n      let billList = (this.showNewTable || (projlist_status == '0' && this.batchList?.length === 0)) ? this.billList : this.billListHis;\n      let selectedRow = billList.find(item => item.selected);\n      let op_flag = '_$i_op_flag$_';\n\n      // 获取当日日期，用于i_write_date默认值\n      const today = new Date();\n      const todayStr = `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, '0')}-${String(today.getDate()).padStart(2, '0')}`;\n\n      let data = {\n        i_projid: '_$projid$_',\n        i_op_flag: '_$i_op_flag$_',\n        i_state: '_$state$_',\n        i_type: type, // 1: 提交, 2: 修正\n        i_revise: '_$revise$_',\n        i_reviseId: '_$reviseId$_',\n        i_projlist_status: projlist_status,\n        i_usercode: '_$sys.username$_',\n        i_submit_status: type\n      };\n\n      console.log(\"this.showNewTable\", this.showNewTable);\n      console.log(\"this.currentBatchIndex\", this.currentBatchIndex);\n      console.log(\"this.batchList\", this.batchList);\n      // 添加批次ID\n      if (!this.showNewTable && this.currentBatchIndex >= 0 && this.batchList && this.batchList[this.currentBatchIndex]) {\n        console.log(\"赋值batch_id\")\n        data.i_batch_id = this.batchList[this.currentBatchIndex].batchId;\n      }\n\n      // 如果不是关联信息修改模式，添加清单数据\n      if (op_flag != 1) {\n        billList.forEach(item => {\n          if (item.selected && (!item.dataFlag || !item.disabled)) {\n            var listType = item.listType;\n            data['i_' + listType + '_inout_reason'] = item.inoutReason;\n            data['i_' + listType + '_inout_date'] = item.inoutDate;\n            data['i_' + listType + '_report_date'] = item.reportDate;\n            data['i_' + listType + '_inout_remark'] = item.remark;\n            data['i_' + listType + '_filepath'] = item.filepath;\n          } else if (item.selected && item.dataFlag && item.disabled) {\n            var listType = item.listType;\n            data['i_' + listType + '_filepath'] = item.filepath;\n          }\n        });\n      }\n\n      // 关联公司列表 - 转换为接口需要的格式\n      // multistk_s接口需要：i_comp_name, i_stk_name, i_stk_code, i_related_property, i_ralated_ramark, i_write_date, i_fill_id\n      // if (this.companyList && this.companyList.length > 0) {\n      //   let formattedCompanyList = this.companyList.map(item => ({\n      //     i_fill_id: Wb.getId(),\n      //     i_comp_name: item.compName || '',\n      //     i_stk_name: item.stkName || '',\n      //     i_stk_code: item.stkCode || '',\n      //     i_related_property: item.relatedProperty || '',\n      //     i_ralated_ramark: item.remark || '',\n      //     i_write_date: todayStr, // 如果没有填写则使用当日日期\n      //     i_data_flag: item.dataFlag || ''\n      //   }));\n      //   data.companyList = JSON.stringify(formattedCompanyList);\n      // } else {\n      //   data.companyList = JSON.stringify([]);\n      // }\n\n      console.log(\"prepareSubmitData\", data);\n\n      return data;\n    }\n  },\n  watch: {\n\n  },\n  created: async function () {\n    // 设置填报日期为当前日期\n    const today = new Date().toISOString().split('T')[0];\n\n\n    const inList = ['ro', 'rl', 'rq'];  // 入单类型\n\n    // 只为入单行设置填报日期\n    this.billList.forEach(item => {\n      if (inList.includes(item.listType)) {\n        item.reportDate = today;\n      }\n      item.reportDisabled = true; // 填报日期默认禁用\n    });\n    this.billListHis.forEach(item => {\n      if (inList.includes(item.listType)) {\n        item.reportDate = today;\n      }\n      item.reportDisabled = true; // 填报日期默认禁用\n    });\n\n    // 清单表格数据查询\n    await this.inoutReq('_$projid$_');\n    await this.multistkReq('_$projid$_');\n    await this.selfcheckReq('_$projid$_');\n    await this.getCandidates('_$staff_id$_', '_$projid$_'); // 隔离墙操作变动流程 - 查询流程下一节点待办接收人\n\n\n    // 初始化是否禁用新增批次按钮\n    const projlist_status = '_$projlist_status$_';\n    this.isAddBatchDisabled = (projlist_status === '0' || projlist_status === 'ro' || projlist_status === 'rl' || projlist_status === 'rq');\n\n    // 初始化历史批次表格状态\n    this.initHisTableStatus();\n  },\n  mounted: function () {\n    console.log(\"piid1\", this.piid1);\n  },\n  beforeDestroy() {\n  }\n});\n"
              }
            }
          ]
        }
      ]
    }
  ]
}