b = $('#' + projId).find('.projlist-basic-bill.his');\n//     $.when(app.inoutReq()).then(function (resp) {\n//       resp = Wb.decode(resp.responseText).rows[0];\n//       projType = resp.PROJTYPE;\n//       BATCH_ID = resp.BATCH_ID;\n//       // ------------------批次tab逻辑开始--------------------\n//       console.log('resp-init-BATCH_COUNT----', resp.BATCH_COUNT);\n//       if (resp.BATCH_COUNT === null) {\n//         // 如果没有历史批次，隐藏批次管理按钮\n//         $('#' + projId).find('.projlist-tab-btn').hide().end().find('.projlist_tab_header').hide();\n//       } else {\n//         // 有历史批次，生成批次标签\n//         let listr = '';\n//         for (let a = 0; a < resp.BATCH_COUNT; a++) {\n//           listr += '<li data-index=' + (resp.BATCH_COUNT - a) + '>批次' + (resp.BATCH_COUNT - a) + '</li>';\n//         }\n//         $('#' + projId).find('.projlist_tab_header ul').append(listr).end()\n//           .find('.projlist_tab_header ul li:nth-child(1)').addClass(\"projlist_active\");\n//       }\n//       // ------------------批次tab逻辑结束--------------------\n\n//       // 遍历返回数据的所有字段\n//       for (let r in resp) {\n//         // 将数据填充到对应的表单元素中\n//         $itb.find('tr[data-type]').children('td:not(:last)').find('[data-id=\"' + r.toLowerCase() + '\"]').val(resp[r]);\n\n//         // 如果是附件路径字段，特殊处理\n//         if (equals(sp_L(r), 'FILEPATH') && notNil(resp[r]) && notNil(sp2fL(resp[r]))) {\n//           // 设置附件相关信息\n//           $itb.find('tr.' + sp_H_toLower(r)).attr('hasFile', true)\n//             .find('.x-form-field').val(sp2fL(resp[r])) // 显示文件名\n//             .end().find('a').attr('href', resp[r]); // 设置下载链接\n//         }\n\n//         // 如果是修正模式，记录需要修正的清单类型\n//         if (gt0(revise)) {\n//           if (and(equals(sp_L(r), 'REASON'), notNil(resp[r]))) {\n//             // 将字段名按下划线分割取第一部分，转小写后加入修正列表\n//             reviseList.push(sp_H(r).toLowerCase());\n//           }\n//         }\n//       }\n\n//       // 处理填报日期字段\n//       $itb.find('.now-date').each(function () {\n//        