{"title":"清单填报页保存","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"let object = Wb.sql(`{call thjs.p_projlist_inout_s({?i_projid?},{?i_batch_id?},\n  {?i_ro_inout_date?},{?i_ro_inout_reason?},{?i_ro_inout_remark?},{?i_ro_filepath?},\n  {?i_co_inout_date?},{?i_co_inout_reason?},{?i_co_inout_remark?},{?i_co_filepath?},\n  {?i_rl_inout_date?},{?i_rl_inout_reason?},{?i_rl_inout_remark?},{?i_rl_filepath?},\n  {?i_cl_inout_date?},{?i_cl_inout_reason?},{?i_cl_inout_remark?},{?i_cl_filepath?},\n  {?i_rq_inout_date?},{?i_rq_inout_reason?},{?i_rq_inout_remark?},{?i_rq_filepath?},\n  {?i_cq_inout_date?},{?i_cq_inout_reason?},{?i_cq_inout_remark?},{?i_cq_filepath?},\n  {?i_projlist_status?},{?i_submit_status?},{?i_usercode?},{*O_RETURN_MSG*},{*O_RETURN_CODE*})}`);\n\nWb.send(object)"},"_icon":"module"}