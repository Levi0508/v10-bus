{"title":"查询自查结果","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"Wb.sendRowx({\n  sql: `select a.*,b.display_name \nfrom thjs.tb_projlist_check_result a \nleft join basic_thjs.wb_user b\non a.create_user = b.user_name\nwhere projid = {?i_projid?}\norder by create_time desc`,\n  kv: {\n    check_result: 'check_result'\n  }\n})"},"_icon":"module"}