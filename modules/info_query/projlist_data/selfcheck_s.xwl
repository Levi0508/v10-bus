{"title":"保存自查结果","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"let batchList = Wb.decode(Wb.get('batchList'));\nlet projid = Wb.get('projid');\nlet piid = Wb.get('piid');\nlet check_id = Wb.get('check_id');\nlet check_batch_id = Wb.get('check_batch_id');\nlet user_name = Wb.get('sys.username');\n\nlet rs = {};\nlet msg = '';\nif (!batchList) {\n  rs.O_RETURN_CODE = -1;\n  rs.O_RETURN_MSG = \"没有获取到参数\";\n} else if (batchList && batchList.length == 0) {\n  rs.O_RETURN_CODE = -1;\n  rs.O_RETURN_MSG = \"获取到的参数为空\";\n} else if (!piid) {\n  rs.O_RETURN_CODE = -1;\n  rs.O_RETURN_MSG = \"流程号为空\";\n} else if (!projid) {\n  rs.O_RETURN_CODE = -1;\n  rs.O_RETURN_MSG = \"项目编号为空\";\n} else {\n  let conn = Wb.getConn();\n\n  try {\n    let sql1 = `INSERT INTO thjs.tb_projlist_check_result (PROCESS_ID, PROJID, BATCH_ID, INOUT_ID, CHECK_ID, CHECK_RESULT, \n      REMARK, CREATE_USER, CREATE_TIME, FILE_PATH, UPDATE_USER, UPDATE_TIME, CHECK_BATCH_ID\n      ) VALUES (\n      {?PROCESS_ID?}, {?PROJID?}, {?BATCH_ID?}, {?INOUT_ID?}, {?CHECK_ID?}, {?CHECK_RESULT?}, \n      {?REMARK?}, {?CREATE_USER?}, sysdate, {?FILE_PATH?}, {?UPDATE_USER?}, sysdate, {?CHECK_BATCH_ID?})`;\n\n    for (let i = 0; i < batchList.length; i++) {\n      Wb.sql({\n        sql: sql1,\n        contextParams: false,\n        params: {\n          PROCESS_ID: piid,\n          PROJID: projid,\n          INOUT_ID: '',\n          CHECK_ID: check_id,\n          CHECK_BATCH_ID: check_batch_id,\n          CHECK_RESULT: batchList[i].check_result,\n          REMARK: batchList[i].remark,\n          CREATE_USER: user_name,\n          FILE_PATH: batchList[i].filepath,\n          UPDATE_USER: user_name\n        },\n        trans: true,\n        commit: false\n      })\n    }\n    conn.commit();\n    rs.O_RETURN_CODE = 0;\n    rs.O_RETURN_MSG = \"执行成功\"\n  } catch (e) {\n    rs.O_RETURN_CODE = -1;\n    rs.O_RETURN_MSG = \"保存失败：\" + e;\n    conn.rollback();\n  } finally {\n    conn.close();\n  }\n}\n\nWb.send(Wb.encode(rs));"},"_icon":"module"}