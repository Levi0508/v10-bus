{"title":"查询","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","remark":"Select users","serverScript":"function main() {\n  const protectedText = Wb.UserUtil.protectedText;\n  let sql;\n\n  // sql = `select a.sid, a.sid as user_id_disp, a.user_name, a.display_name, '${protectedText}' as password, '${protectedText}' as confirm_password,\n  //          a.email, a.mobile_phone, a.use_lang, b.sid as dept_id, b.dept_id as dept_code_hide, b.dept_name as dept_name_tree,\n  //          a.login_times, a.create_date, a.last_login,a.status\n  //          from wb_user a left join wb_dept b on a.dept_id=b.sid`;\n    sql = `\nwith tmp as (\nselect distinct t.user_id, \nLISTAGG(t1.role_name, ',') WITHIN GROUP(ORDER BY 1)  OVER (PARTITION BY  t.user_id) as role_name\nfrom wb_user_role t\nleft join WB_ROLE t1 on t.role_id = t1.role_id\n)\nselect a.sid, a.sid as user_id_disp, a.user_name, a.display_name, tmp.role_name, '${protectedText}' as password, '${protectedText}' as confirm_password,\na.email, a.mobile_phone, b.sid as dept_id, b.dept_id as dept_code_hide, b.dept_name as dept_name_tree,\na.login_times, a.create_date, a.last_login,a.status\nfrom wb_user a left join wb_dept b on a.dept_id=b.sid\nleft join tmp on a.sid = tmp.user_id\n`;\n\n  if (Params.search) {\n    Wb.setLike('search');\n    sql += ' where a.user_name like {?search?} or a.display_name like {?search?} or a.sid like {?search?}';\n  }\n  sql += Wb.getOrderSql({ dept_name_tree: 'b.dept_name', user_id_disp: 'a.sid', $: 'a' });\n  Wb.sendDict(sql, 'wb,');\n}\nmain();"},"_icon":"module"}