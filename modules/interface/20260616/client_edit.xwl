{"title":"aml_monitor KYC01010 client_edit","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","links":"[\"wb/custom-made/vue/vue.js\",\"wb/custom-made/vue/element.js\",\"wb/custom-made/vue/element.css\",\"wb/custom-made/css/prs01.css\"]","serverScript":"Wb.set('CLIENT_ID', '47236');\nWb.set('ORGAN_FLAG', '1');\nWb.set('CLIENT_STATUS', '1');\nWb.set('CLIENT_NAME', 'test1111111');\nWb.set('CLIENT_BELONG', '融资端');\nWb.set('FK_FLAG', '0');\nWb.set('DATA_TYPE', '1');\n\nWb.set({\n  organ_flag: Wb.get('ORGAN_FLAG'),\n  client_belong: Wb.get('CLIENT_BELONG'),\n  client_id: Wb.get('CLIENT_ID'),\n  client_name: Wb.get('CLIENT_NAME'),\n  client_status: Wb.get('CLIENT_STATUS'),\n  fk_flag: Wb.get('FK_FLAG'),\n  data_type: Wb.get('DATA_TYPE'),\n  key: Wb.get('KEY'), // 只有从工作室填报时会传递的参数\n  cur_user: Wb.get('CUR_USER')// 工作室传递的i_usercode\n});\n\nWb.info(Wb.get());"},"_icon":"module","_expanded":true,"items":[{"_icon":"viewport","text":"viewport1","cls":"Wb.Viewport","properties":{"cid":"viewport1","layout":"fit"},"events":{"ready":"app.xwl1.ORGAN_FLAG = '_$organ_flag$_';\napp.xwl1.CLIENT_ID = '_$client_id$_';\nconsole.log(\"父组件的organ_flag\",'_$organ_flag$_');"},"_expanded":true,"items":[{"_icon":"module","text":"xwl1","cls":"Wb.Xwl","properties":{"cid":"xwl1","path":"interface/20260616/base_edit.xwl"}}]}]}