{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"var i_key = Wb.get('i_key') || '';\nvar i_cert_no = Wb.get('i_cert_no') || '';\nvar i_usercode = Wb.get('i_usercode') || '';\nvar i_username = Wb.get('sys.username') || '';\n\nlet sentence = \"进入了call_reback函数内部，i_key:\" + i_key + \";i_cert_no:\" + i_cert_no + \";i_usercode:\" + i_usercode + \";i_username:\" + i_username;\n\ntry {\n  var data1 = Wb.sql({ sql: `insert into thjs.t_tmp_exec_log(opt_user,opt_url,opt_params,opt_response)values({?opt_user?},{?opt_url?},{?opt_params?},{?opt_response?})`, contextParams: false, params: { opt_user: i_usercode, opt_url: 'http://10.181.100.144:8097/micro/aml', opt_params: 'sentence', opt_response: sentence } });\n} catch (e) {\n  Wb.error(\"call_reback函数日志记录报错：\", e)\n} finally {\n  Wb.log(\"call_reback函数日志记录\")\n}\n\nWb.invoke('m?xwl=sys/service/interface/http-post');\nvar params;\nparams = {\n  eventRecordId: i_key,\n  status: 'Y',\n  updator: i_usercode,\n  updateTime: DateUtil.format(new java.util.Date())\n};\n\n// 保存参数\nvar data2 = Wb.sql({ sql: `{call THJS.p_fxq_interface_log_s('1',{?i_cert_no?},{?i_key?},{?i_proj_type?},{?i_usercode?},{?@O_RETURN_MSG?},{?@INTEGER.O_RETURN_CODE?})}`, contextParams: false, params: { i_cert_no: i_cert_no, i_key: i_key, i_proj_type: '', i_usercode: i_usercode } });\n\nWb.log(data2);\n\n//生产环境\nlet result = app.httppost('http://10.181.100.144:8097/micro/aml', 'POST',\n  Wb.encode(params).getBytes(\"utf-8\"), 500, 'application/json');\n\nresult = Wb.decode(new JavaString(result, 'utf-8'));\nvar data3 = Wb.sql({ sql: `insert into thjs.t_tmp_exec_log(opt_user,opt_url,opt_params,opt_response)values({?opt_user?},{?opt_url?},{?opt_params?},{?opt_response?})`, contextParams: false, params: { opt_user: i_usercode, opt_url: 'http://10.181.100.144:8097/micro/aml', opt_params: Wb.encode(params), opt_response: Wb.encode(result) } });\n\nWb.send(result);"},"_icon":"module"}