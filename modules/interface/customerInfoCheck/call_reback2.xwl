{"title":"ceshi","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"var i_key = '001';//Wb.get('i_key');\nvar i_cert_no = 'testtest';//Wb.get('i_cert_no');\nvar i_usercode = 'testtesttesttest';//Wb.get('i_usercode');\nvar i_username = Wb.get('sys.username');\n\nWb.invoke('m?xwl=sys/service/interface/http-post');\nvar params;\nparams = {\n  eventRecordId: i_key,\n  status: 'Y',\n  updator: i_usercode,\n  updateTime: DateUtil.format(new java.util.Date())\n};\n\n// 保存参数\nvar data2 = Wb.sql({ sql: `{call THJS.p_fxq_interface_log_s('1',{?i_cert_no?},{?i_key?},{?i_proj_type?},{?i_usercode?},{?@O_RETURN_MSG?},{?@INTEGER.O_RETURN_CODE?})}`, contextParams: false, params: { i_cert_no: i_cert_no, i_key: i_key, i_proj_type: '', i_usercode: i_usercode } });\n\nWb.log(data2);\n\n//生产环境\nlet result = app.httppost('http://10.181.100.144:8097/micro/aml', 'POST',\n  Wb.encode(params).getBytes(\"utf-8\"), 500, 'application/json');\n\nresult = Wb.decode(new JavaString(result, 'utf-8'));\n\nWb.send(result);\n"},"_icon":"module"}