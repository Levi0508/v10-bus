{"title":"反洗钱客户状态查询","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"Wb.apply(app, {\n  getUserInfo: function () {\n    var i_usercode = request.getParameter('creditCode');\n    var i_entname = request.getParameter('custName');\n    // var i_usercode = 'xxx';\n    // var i_entname = '中国资产经营管理公司';\n\n    var username = Wb.get('sys.username');\n    var procParam = 'i_entname:' + i_entname + '-i_usercode:' + i_usercode + '-username:' + username;\n\n    let log1 = Wb.sql(\"INSERT INTO thjs.tb_exec_log(log_id, proc_name, proc_param, exec_time) \" + \"VALUES(thjs.tb_exec_log_id_seq.nextval, 'fxqCustStatusQ', '\" + procParam.replace(/'/g, \"''\") + \"', SYSDATE)\");\n\n    Wb.info(\"i_usercode=\" + i_usercode);\n    Wb.info(\"i_entname=\" + i_entname);\n    var outInfo = new JSONObject();\n\n    if (i_usercode === null && i_entname === null) {\n      outInfo.put(\"code\", \"-2\");\n      outInfo.put(\"resultMsg\", \"传参不能为空\");\n      return outInfo.toString();\n    }\n\n    // 信用代码和客户名称都传时，必须属于同一客户，否则无法确定以哪家为准\n    const hasCode = i_usercode !== null && String(i_usercode).trim() !== '';\n    const hasName = i_entname !== null && String(i_entname).trim() !== '';\n    if (hasCode && hasName) {\n      const sameCust = Wb.sql({ sql: `select 1 as flag from THJS.VW_FXQ_CUST_INFO_TH where cert_no = {?creditCode?} and cust_name = {?custName?} and rownum = 1`, contextParams: false, params: { custName: i_entname, creditCode: i_usercode } });\n      if (sameCust.items.length === 0) {\n        const anyCust = Wb.sql({ sql: `select 1 as flag from THJS.VW_FXQ_CUST_INFO_TH where (cert_no = {?creditCode?} or cust_name = {?custName?}) and rownum = 1`, contextParams: false, params: { custName: i_entname, creditCode: i_usercode } });\n        if (anyCust.items.length > 0) {\n          outInfo.put(\"code\", \"-3\");\n          outInfo.put(\"resultMsg\", \"信用代码与客户名称不属于同一客户，请核对\");\n          outInfo.put(\"data\", {\n            \"status\": null,\n            \"proj_status\": null\n          });\n          outInfo.put(\"success\", false);\n          let log4 = Wb.sql(\"INSERT INTO thjs.tb_exec_log(log_id, proc_name, proc_param, exec_time) \" + \"VALUES(thjs.tb_exec_log_id_seq.nextval, 'fxqCustStatusQ_return', '\" + procParam.replace(/'/g, \"''\") + '返回值：' + Wb.encode(outInfo) + \"', SYSDATE)\");\n          return outInfo.toString();\n        }\n      }\n    }\n\n    var rec = Wb.sql({ sql: `select status,proj_status,user_code,to_char(update_time,'YYYY-MM-DD HH24:MI:SS') as update_time,to_char(info_update_time,'YYYY-MM-DD HH24:MI:SS') as info_update_time from THJS.VW_FXQ_CUST_INFO_TH where cert_no = {?creditCode?} or cust_name = {?custName?}`, contextParams: false, params: { custName: i_entname, creditCode: i_usercode } });\n\n    if (rec.items.length > 0) {\n      outInfo.put(\"code\", \"0\");\n      outInfo.put(\"resultMsg\", \"执行成功\");\n      outInfo.put(\"data\", {\n        \"status\": rec.items[0].status,\n        \"proj_status\": rec.items[0].proj_status,\n        \"op_user\": rec.items[0].user_code,\n        \"update_time\": rec.items[0].update_time,\n        \"info_update_time\": rec.items[0].info_update_time\n      });\n      let log2 = Wb.sql(\"INSERT INTO thjs.tb_exec_log(log_id, proc_name, proc_param, exec_time) \" + \"VALUES(thjs.tb_exec_log_id_seq.nextval, 'fxqCustStatusQ_return', '\" + procParam.replace(/'/g, \"''\") + '返回值：' + Wb.encode(outInfo) + \"', SYSDATE)\");\n\n      return outInfo.toString();\n    } else {\n      outInfo.put(\"code\", \"-1\");\n      outInfo.put(\"resultMsg\", \"查询失败\");\n      outInfo.put(\"data\", {\n        \"status\": null,\n        \"proj_status\": null\n      });\n      outInfo.put(\"success\", false);\n      let log3 = Wb.sql(\"INSERT INTO thjs.tb_exec_log(log_id, proc_name, proc_param, exec_time) \" + \"VALUES(thjs.tb_exec_log_id_seq.nextval, 'fxqCustStatusQ_return', '\" + procParam.replace(/'/g, \"''\") + '返回值：' + Wb.encode(outInfo) + \"', SYSDATE)\");\n      return outInfo;//.toString();返回JSON格式\n    }\n  }\n});\n\nresponse.setContentType(\"application/json; charset=UTF-8\");\nWebUtil.send(response, app.getUserInfo());","loginRequired":"false"},"_icon":"module"}