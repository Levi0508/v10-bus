{
  "title": "",
  "icon": "",
  "img": "",
  "tags": "",
  "hideInMenu": "false",
  "text": "module",
  "cls": "Wb.Module",
  "properties": {
    "cid": "module",
    "serverScript": "let WHAT = Wb.get('WHAT'),\n  USERCODE = Wb.get('USERCODE'),\n  KEY = Wb.get('KEY'),\n  ENTNAME = Wb.get('ENTNAME'),\n  ITYPE = Wb.get('ITYPE'),\n  CUST_ID = Wb.get('CUST_ID'),\n  IS_DEPOSITORY_CUS = Wb.get('IS_DEPOSITORY_CUS'),\n  CUST_TYPE = Wb.get('CUST_TYPE'),\n  NEW_SYS_USER = Wb.get('sys.username');\n\n  // WHAT = '_$WHAT$_', USERCODE = '_$USERCODE$_', KEY = '_$KEY$_', ENTNAME = '_$ENTNAME$_',\n  // ITYPE = '_$ITYPE$_', CUST_ID = '_$CUST_ID$_', IS_DEPOSITORY_CUS = '_$IS_DEPOSITORY_CUS$_', CUST_TYPE = '_$CUST_TYPE$_';\n"
  },
  "_icon": "module",
  "events": {
    "initialize": "var WHAT = '_$WHAT$_', USERCODE = '_$USERCODE$_', KEY = '_$KEY$_', ENTNAME = '_$ENTNAME$_',\n  ITYPE = '_$ITYPE$_', CUST_ID = '_$CUST_ID$_', IS_DEPOSITORY_CUS = '_$IS_DEPOSITORY_CUS$_', \n  CUST_TYPE = '_$CUST_TYPE$_', NEW_SYS_USER='_$NEW_SYS_USER$_';\n\n// 老系统工作室表 0机构 1个人，新系统表t_th_client_info 0个人 1机构，所以工作室传CUST_TYPE为0时实际上是机构户，要进机构页面\nif (CUST_TYPE == 0) {\n  if (WHAT == 'insert') {\n    //提示页面02\n    let html = '<div style=\"background:rgb(22, 130, 185);color:#fff;text-align:center;height:40px;line-height:40px;\">系统中不存在该客户相关信息</div>' +\n      '<br/>' +\n      '<p>请准确、完整填写客户信息，保存打印后，交客户签章确认，并留存工作底稿&nbsp;</p>' +\n      '<br/>' +\n      '<div>你将成为该客户的最新维护人</div>' +\n      '<br/>';\n\n    Wb.confirm(html, function () {\n      if (ITYPE == '标准化票据') {\n        window.location.href = window.location.origin + '/thhg/m?' + 'rzSearchRow=1&CLIENT_ID=' + CUST_ID + '&WHAT=' + WHAT +\n          '&KEY=' + KEY + '&ORGAN_FLAG=1&CLIENT_NAME=' + ENTNAME.split(':')[0] + '&CLIENT_STATUS=0&CLIENT_BELONG=1&FK_FLAG=&CUR_USER=' + USERCODE\n          + '&xwl=aml_monitor/KYC01010/client_add';\n        // Wb.open({\n        //   url: 'm?xwl=aml_monitor/KYC01010/client_add',\n        //   title: '填写客户信息',\n        //   params: {\n        //     rzSearchRow: 1,\n        //     CLIENT_ID: CUST_ID,\n        //     WHAT: WHAT,\n        //     KEY: KEY,// 从工作室跳转来时提交数据时需要调用工作室接口\n        //     ORGAN_FLAG: '1',//新系统机构户为1\n        //     CLIENT_NAME: ENTNAME.split(':')[0],\n        //     CLIENT_STATUS: '0',\n        //     CLIENT_BELONG: '1',//1-融资端 2-投资端\n        //     FK_FLAG: '',\n        //     CUR_USER: USERCODE\n        //   },\n        //   success(scope) {\n        //     app.viewport1.add(scope.viewport1);\n        //   }\n        // });\n      } else {\n        // console.log(\"\")\n        window.location.href = window.location.origin + '/thhg/m?' + 'rzSearchRow=1&CLIENT_ID=' + CUST_ID + '&WHAT=' + WHAT +\n          '&KEY=' + KEY + '&ORGAN_FLAG=1&CLIENT_NAME=' + ENTNAME.split(':')[0] + '&CLIENT_STATUS=0&CLIENT_BELONG=1&FK_FLAG=&CUR_USER=' + USERCODE\n          + '&xwl=aml_monitor/KYC01010/client_add';\n        // Wb.open({\n        //   url: 'm?xwl=aml_monitor/KYC01010/client_add',\n        //   title: '填写客户信息',\n        //   container: false,\n        //   params: {\n        //     rzSearchRow: 1,\n        //     CLIENT_ID: CUST_ID,\n        //     WHAT: WHAT,\n        //     KEY: KEY,// 从工作室跳转来时提交数据时需要调用工作室接口\n        //     ORGAN_FLAG: '1',//新系统机构户为1\n        //     CLIENT_NAME: ENTNAME.split(':')[0],\n        //     CLIENT_STATUS: '0',\n        //     CLIENT_BELONG: '1',//1-融资端 2-投资端\n        //     FK_FLAG: '',\n        //     CUR_USER: USERCODE\n        //   },\n        //   success(scope) {\n        //     app.viewport1.add(scope.viewport1);\n\n        //     console.log(\"togo\", scope)\n        //   }\n        // });\n      }\n    }, null, true);\n  } else if (WHAT == 'update') {\n    //提示页面01\n    var html1 =\n      `<div style=\"background:rgb(85, 130, 53);color:#fff;text-align:center;height:40px;line-height:40px;\">【` + ENTNAME + `】已存在</div>` +\n      '<br>' +\n      '<p>点击【查看】以便阅知系统留存的客户反洗钱资料，系统将为你保存为该客户的最新更新人。</p>' +\n      '<p>在客户信息页，请核实已留存客户信息与底稿资料是否准确、完整。</p>' +\n      '<p>如遇更新或补充完善，请</p>' +\n      '<ul>' +\n      '<li style=\"list-style-type:none;\">（1）保存提交客户信息表并将打印版本交客户签章；</li>' +\n      '<li style=\"list-style-type:none;\">（2）签章版的客户信息表和补充的工作底稿上传到系统中。 </li>' +\n      '</ul>' +\n      '<br>' +\n      '<div>点击【取消】将退出本页面，反洗钱填报工作将不被记录。</div>' +\n      '<br>';\n    Wb.confirm(html1, function () {\n      Wb.ajax({\n        url: 'm?xwl=interface/customerInfoCheck/p_op_log_s',\n        params: {\n          i_op_type: '1',\n          i_cust_id: CUST_ID,\n          i_usercode: '_$sys.username$_',\n        },\n        success(resp) {\n          window.location.href = window.location.origin + '/thhg/m?' + 'rzSearchRow=1&CLIENT_ID=' + CUST_ID + '&WHAT=' + WHAT +\n            '&KEY=' + KEY + '&ORGAN_FLAG=1&CLIENT_NAME=' + ENTNAME + '&CLIENT_STATUS=&CLIENT_BELONG=1&FK_FLAG=&CUR_USER=' + USERCODE\n            + '&xwl=aml_monitor/KYC01010/client_edit';\n          // Wb.open({\n          //   url: 'm?xwl=aml_monitor/KYC01010/client_edit',\n          //   title: '填写客户信息',\n          //   params: {\n          //     CLIENT_ID: CUST_ID,\n          //     WHAT: WHAT,\n          //     KEY: KEY,// 从工作室跳转来时提交数据时需要调用工作室接口\n          //     ORGAN_FLAG: '1',//新系统机构户为1\n          //     CLIENT_NAME: ENTNAME,\n          //     CLIENT_STATUS: '',\n          //     CLIENT_BELONG: '1',//1-融资端 2-投资端\n          //     FK_FLAG: '',\n          //     CUR_USER: USERCODE,\n          //   },\n          //   reload: true\n          // });\n        }\n      });\n    }, null, true);\n  }\n} else if (CUST_TYPE == 1) {//自然人\n\n  if (WHAT == 'insert') {  //新增页面\n    var html2 =\n      '<div style=\"background:rgb(22, 130, 185);color:#fff;text-align:center;height:40px;line-height:40px;\">系统中不存在该客户相关信息</div>' +\n      '<br>' +\n      '<p>请准确、完整填写客户信息，保存打印后，交客户签章确认，并留存工作底稿&nbsp;</p>' +\n      '<br>' +\n      '<div>你将成为该客户的最新维护人</div>' +\n      '<br>';\n\n    Wb.confirm(html2, function () {\n      window.location.href = window.location.origin + '/thhg/m?' + 'rzSearchRow=1&CLIENT_ID=' + CUST_ID + '&WHAT=' + WHAT +\n        '&KEY=' + KEY + '&ORGAN_FLAG=0&CLIENT_NAME=' + ENTNAME.split(':')[0] + '&CLIENT_STATUS=0&CLIENT_BELONG=1&FK_FLAG=&CUR_USER=' + USERCODE\n        + '&xwl=aml_monitor/KYC01010/client_add';\n      // Wb.open({\n      //   url: 'm?xwl=aml_monitor/KYC01010/client_add',\n      //   title: '填写客户信息',\n      //   params: {\n      //     CLIENT_ID: CUST_ID,\n      //     WHAT: WHAT,\n      //     KEY: KEY,// 从工作室跳转来时提交数据时需要调用工作室接口\n      //     ORGAN_FLAG: '0',\n      //     CLIENT_NAME: ENTNAME.split(':')[0],\n      //     CLIENT_STATUS: '0',\n      //     CLIENT_BELONG: '1',//1-融资端 2-投资端\n      //     FK_FLAG: '',\n      //     CUR_USER: USERCODE\n      //   },\n      //   reload: true\n      // });\n    }, null, true);\n\n  } else if (WHAT == 'update') {  //已存在页面\n    //提示页面01\n    var html1 =\n      '<div style=\"background:rgb(85, 130, 53);color:#fff;text-align:center;height:40px;line-height:40px;\">【' + ENTNAME + '】已存在</div>' +\n      '<br>' +\n      '<p>点击【查看】以便阅知系统留存的客户反洗钱资料，系统将为你保存为该客户的最新更新人。</p>' +\n      '<p>在客户信息页，请核实已留存客户信息与底稿资料是否准确、完整。</p>' +\n      '<p>如遇更新或补充完善，请</p>' +\n      '<ul>' +\n      '<li style=\"list-style-type:none;\">（1）保存提交客户信息表并将打印版本交客户签章；</li>' +\n      '<li style=\"list-style-type:none;\">（2）签章版的客户信息表和补充的工作底稿上传到系统中。 </li>' +\n      '</ul>' +\n      '<br>' +\n      '<div>点击【取消】将退出本页面，反洗钱填报工作将不被记录。</div>' +\n      '<br>';\n    Wb.confirm(html1, function () {\n      Wb.ajax({\n        url: 'm?xwl=interface/customerInfoCheck/p_op_log_s',\n        params: {\n          i_op_type: '1',\n          i_cust_id: CUST_ID,\n          i_usercode: '_$sys.username$_'//USERCODE\n        },\n        success(resp) {\n          window.location.href = window.location.origin + '/thhg/m?' + 'rzSearchRow=1&CLIENT_ID=' + CUST_ID + '&WHAT=' + WHAT +\n            '&KEY=' + KEY + '&ORGAN_FLAG=0&CLIENT_NAME=' + ENTNAME + '&CLIENT_STATUS=&CLIENT_BELONG=1&FK_FLAG=&CUR_USER=' + USERCODE\n            + '&xwl=aml_monitor/KYC01010/client_edit';\n          // Wb.open({\n          //   url: 'm?xwl=aml_monitor/KYC01010/client_edit',\n          //   title: '填写客户信息',\n          //   params: {\n          //     CLIENT_ID: CUST_ID,\n          //     WHAT: WHAT,\n          //     KEY: KEY,// 从工作室跳转来时提交数据时需要调用工作室接口\n          //     ORGAN_FLAG: '0',\n          //     CLIENT_NAME: ENTNAME,\n          //     CLIENT_STATUS: '',\n          //     CLIENT_BELONG: '1',//1-融资端 2-投资端\n          //     FK_FLAG: '',\n          //     CUR_USER: USERCODE\n          //   },\n          //   reload: true\n          // });\n        }\n      });\n    }, null, true);\n  }\n}\n\n"
  },
  "_expanded": true,
  "items": [
    {
      "_icon": "viewport",
      "text": "viewport1",
      "cls": "Wb.Viewport",
      "properties": {
        "cid": "viewport1",
        "layout": "fit"
      }
    }
  ]
}