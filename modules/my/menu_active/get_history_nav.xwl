{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"const data = Wb.getRows({\n  sql:'select wb_menu.menu_name, wb_menu.menu_id from wb_menu inner join wb_user_menu on wb_menu.menu_id = wb_user_menu.menu_id where wb_user_menu.user_menu_type = {?wb_user_menu?} and staff_id = {?staff_id?} order by wb_user_menu.create_time desc limit 15',\n  params: {wb_user_menu: 'Recent', staff_id: Wb.userid}\n});\nWb.send(data);\n"},"_icon":"module"}