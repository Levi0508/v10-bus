{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"const sqlK = 'select distinct module_id, module_name from wb_menu';\nconst sqlV = 'select * from wb_menu';\nconst dataK = Wb.getRows(sqlK);\nconst dataV = Wb.getRows(sqlV);\nconst data = [];\ndataK.forEach((item1) => {\n  item1.items = [];\n  dataV.forEach((item2) => {\n    if (item2.module_id == item1.module_id) {\n      item1.items.push(item2)\n    }\n  })\n  data.push(item1);\n})\nWb.send(data)"},"_icon":"module"}