{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"const update = Wb.sql({\n  sql: 'update wb_user_menu set create_time = {?create_time?} where staff_id = {?staff_id?} and menu_id = {?menu_id?} and user_menu_type={?user_menu_type?}', \n  params:{\n    staff_id: Wb.userid,\n    menu_id: Params.menu_id,\n    user_menu_type: Params.user_menu_type,\n    create_time: Params.create_time,\n  }\n});\nif (!update) {\n  Wb.sync({\n    tableName:'wb_user_menu',\n    insert: {\n      staff_id: Wb.userid,\n      menu_id: Params.menu_id,\n      user_menu_type: Params.user_menu_type,\n      create_time: Params.create_time,\n    },\n  })\n}"},"_icon":"module"}