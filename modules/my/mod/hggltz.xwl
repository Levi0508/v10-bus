{"title":"合规管理通知","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","links":"[\n  \"wb/gtht/home/css/hggltz.css\"\n]"},"_icon":"module","_expanded":true,"items":[{"_icon":"window","text":"lookNotice","cls":"Wb.Window","_expanded":true,"properties":{"cid":"lookNotice","dialog":"false","height":"400","width":"500","buttonAlign":"center","modal":"true","title":"查看通知"},"events":{"close":"app.lookNoticeContent.setValue('');\napp.lookNoticeTitle.setValue('');"},"items":[{"_icon":"text","text":"lookNoticeTitle","cls":"Wb.Text","properties":{"cid":"lookNoticeTitle","text":"通知标题","width":"90%","readonly":"true","margin":"25px"},"hasDupCid":0,"_expanded":false},{"_icon":"file-html","text":"lookNoticeContent","cls":"Wb.HtmlEditor","properties":{"cid":"lookNoticeContent","text":"通知内容","width":"90%","height":"150","margin":"0px 25px 30px 25px","readonly":"true"},"hasDupCid":0},{"_icon":"container","text":"container1","cls":"Wb.Container","properties":{"cid":"container1","layout":"row","margin":"20px auto"},"_expanded":true,"hasDupCid":1,"items":[{"_icon":"button","text":"back","cls":"Wb.Button","properties":{"cid":"back","text":"关闭","width":"80","type":"primary","background":"rgb(33, 81, 209)"},"events":{"click":"app.lookNoticeContent.setValue('');\napp.lookNoticeTitle.setValue('');\napp.lookNotice.close();"},"hasDupCid":0}]}]},{"_icon":"viewport","text":"viewport1","cls":"Wb.Viewport","properties":{"cid":"viewport1","cls":"hggltz","padding":"0 1em","background":"rgba(255, 255, 255, .4)"},"_expanded":true,"events":{"ready":"// Wb.ajax({\n//   url: 'm?xwl=my/page/hg_hggltz/operation/selectListData',\n//   params:'',\n\n// })"},"items":[{"cls":"Wb.Toolbar","properties":{"cid":"tbar","isProperty":"true","justify":"space-between","padding":".5em 1em","background":"rgba(255, 255, 255, .4)"},"text":"tbar","_expanded":true,"_icon":"toolbar","hasDupCid":0,"items":[{"_icon":"title","text":"title1","cls":"Wb.Title","properties":{"cid":"title1","title":"合规管理通知","marker":"false","color":"#000000"}},{"_icon":"button","text":"button1","cls":"Wb.Button","properties":{"cid":"button1","text":"更多","type":"icon"},"hasDupCid":0,"events":{"click":"// Wb.openWin('m?xwl=my/mod-tb/hggltz-look');\nWb.openWin('m?xwl=my/page/hg_hggltz');"}}]},{"_icon":"container","text":"container1","cls":"Wb.Container","properties":{"cid":"container1","padding":"0 1em 1em 1em","layout":"column","flex":"1"},"_expanded":true,"hasDupCid":1,"items":[{"_icon":"list-view","text":"view1","cls":"Wb.View","properties":{"cid":"view1","flex":"1","autoScroll":"hide","border":"false","background":"transparent","cls":"hggltz-list","itemTplFn":"return `<div  class=\"w-item\" style=\"display: flex;\">\n  <div style=\"display: flex; ${data.order_index > 1 ? 'font-size: 14px; font-weight: 700;' : ''}\" >\n    ${data.order_index > 1 ? '<div class=\"w-icon icon-top\" style=\"color: red; margin-right: 10px; padding-top: 3px;\"></div>' : ''}\n    <div cid=\"title\" class=\"text\">\n      ${data.notice_title}\n      <span cid=\"content\" style=\"display:none;\">${data.notic_content}</span>\n    </div>\n  </div>\n  <div class=\"time\">${data.create_time}</div>\n</div>`\n// ${data.order_index > 1 ? '<div style=\"font-size: 14px; color: red;\">立即查看</div>' : `<div class=\"time\">${data.create_time}</div>`}\n","url":"m?xwl=my/page/hg_hggltz/operation/selectListData","autoLoad":"true"},"_expanded":true,"events":{"itemclick":"let target = e.target;\nif (target.closest('[cid=title]')) {\n  let content = target.querySelector('[cid=content]').innerHTML;\n  let title = target.closest('[cid=title]').innerText;\n  app.lookNoticeContent.setValue(content);\n  app.lookNoticeTitle.setValue(title);\n  console.log(content,title, \"pk_id\")\n  app.lookNotice.show();\n}"}}]}]}]}