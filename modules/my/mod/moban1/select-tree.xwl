{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"function xTree(list) {\n  let data = [];\n  list.each(node => {\n    if(node.hidden) return;\n    if(node._leaf) {\n      data.push(node);\n    } else {\n      if (node.items) {\n        data.push(...xTree(node.items));\n      }\n    }\n  })\n  return data;\n}\nfunction treeFilter(tree, name) {\n  let data = [];\n  tree?.each(item => { \n    if(item.hidden) return; \n    if(item._leaf && name.includes(item.path)) {\n      data.push(item);\n    } else {\n      if (name.includes(item.path)) {\n        if (item.items) {\n          item._expanded = true;\n          item.items = item.items.filter(i => !i.hidden);\n          item.items = xTree(item.items);\n        }\n        data.push(item);\n      } else {\n        if (item.items) {\n          data.push(...treeFilter(item.items, name));\n        }\n      }\n    }\n  })\n  return data;\n}\n\nfunction convertFlatToTree(flatList) {\n  const nodeMap = {};\n  const processedList = flatList.map(item => {\n    const node = { ...item,\n      title: item.title ? Wb.optText(item.title) : (item.is_folder ? Wb.getFilename(item.path) : Wb.getFilename(item.path).slice(0,-4)),\n      path: item.path,\n      xpath: item.is_folder ? item.path : (item.path).slice(0,-4),\n      items: []\n    };\n    const pathSegments = node.path.split('/');\n    node._pathSegments = pathSegments;\n    nodeMap[node.path] = node;\n    return node;\n  });\n\n  processedList.forEach(node => {\n    const { _pathSegments } = node;\n    if (_pathSegments.length > 1) {\n      const parentPath = _pathSegments.slice(0, -1).join('/');\n      const parentNode = nodeMap[parentPath];\n      if (parentNode) {\n        parentNode.items.push(node);\n      }\n    }\n  });\n  const treeData = processedList.filter(node => node._pathSegments.length === 1);\n  treeData.forEach(processTreeNodes);\n  return treeData;\n}\nfunction processTreeNodes(node) {\n    delete node._pathSegments;\n    if (node.items && node.items.length === 0) {\n        if (!node.is_folder)\n          node._leaf = true;\n    } else if (node.items && node.items.length > 0) {\n        node.items.forEach(processTreeNodes);\n    }\n}\nfunction main() {\n  let items, itemsFilter, data;\n  data = Wb.sql('select sid,path,title,hidden,is_folder from wb_file').items;\n  items = convertFlatToTree(data);\n  // // 确定模块目录路径 item_root\n  let item_root = ['my/mod', 'example'];\n  itemsFilter = treeFilter(items, item_root);\n  Wb.send(itemsFilter)\n}\nmain();"},"_icon":"module"}