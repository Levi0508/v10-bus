{"title":"单模板","icon":"","img":"","tags":"","hideInMenu":"true","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"let url = Params.xurl;\nif(url) {\n  Wb.set({ xurl: Wb.encode(url) });\n} else {\n  Wb.set({ xurl: Wb.encode('') });\n}\nWb.set({ \n  loginusername: Wb.encode(Wb.username),\n  title: Xwl.get(url+'.xwl')?.title\n});","links":"[\n  \"wb/gtht/home/css/moban1.css\"\n]","title":"_$title$_"},"_icon":"module","events":{"initialize":"Wb.apply(app, {\n  loginusername: _$loginusername$_,\n  xurl: _$xurl$_,\n  pickersearch(val, dom1) {\n    Wb.ajax({\n      url: xpath + '/get_gn_nav',\n      params: {query: val},\n      success(res) {\n        dom1.data = Wb.decode(res);\n      }\n    })\n  },\n  defaultWin() {\n    if (app.xurl) {\n      Wb.run({\n        url: 'm?xwl='+ app.xurl,\n        success(scope) {\n          app.container1.destroyAll();\n          app.container1.add(scope.viewport1);\n        }\n      });\n    }\n  },\n  ready() {\n    app.defaultWin();\n  },\n});"},"_expanded":true,"items":[{"_icon":"viewport","text":"viewport1","cls":"Wb.Viewport","properties":{"cid":"viewport1","layout":"fit","cls":"moban","border":"false"},"_expanded":true,"events":{"ready":"app.ready();"},"items":[{"cls":"Wb.Toolbar","properties":{"cid":"tbar","isProperty":"true","height":"4em","background":"rgb(33,81,209)","cls":"tbar","justify":"space-between","padding":"true"},"text":"tbar","_expanded":true,"_icon":"toolbar","hasDupCid":0,"items":[{"_icon":"container","text":"leftbox","cls":"Wb.Container","properties":{"cid":"leftbox","cls":"leftbox","layout":"row","gap":"true","align":"center","margin":"0 4em 0 0"},"hasDupCid":0,"_expanded":false,"items":[{"_icon":"picture","text":"picture1","cls":"Wb.Picture","properties":{"cid":"picture1","src":"wb/gtht/home/img/logo1.png","height":"2em"}},{"_icon":"divider","text":"divider1","cls":"Wb.Divider","properties":{"cid":"divider1","width":"2"},"hasDupCid":0},{"_icon":"label","text":"label1","cls":"Wb.Label