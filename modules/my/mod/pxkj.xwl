\"></div>' : '<div class=\"w-icon icon-favorite\"></div>'}\n        ${data.d > 4 ?'<div class=\"w-icon icon-favorite1\"></div>' : '<div class=\"w-icon icon-favorite\"></div>'}\n        <div class=\"xxnum\">${data.d}星</div>\n        </div>\n        <div>${data.c}</div>\n      </div>\n      <div class=\"bot\">\n        <div class=\"date\">${data.b}</div>\n        <a class=\"btn\">开始学习</a>\n      </div>\n    </div>\n  </div>\n`"}}]}]}]}