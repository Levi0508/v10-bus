{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","remark":"View the progress of workflow","serverScript":"function main(){let e=new Wb.Workflow({flowId:Params.flowId});Wb.send({flow:e.flow,activeNode:e.activeNode.data.name,users:Wb.getRowx(`select a.accept_time,a.process_time,b.display_name,a.node_name,a.node_text,a.status,a.user_type\\n        from wb_flow_user a, wb_user b where a.flow_id={?flowId?} and a.user_id=b.sid order by a.accept_time`)})}main();"},"_icon":"module"}