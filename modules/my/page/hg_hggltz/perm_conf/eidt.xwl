{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","_expanded":true,"properties":{"cid":"module","serverScript":"// let user_name = Wb.get('sys.username');\nlet staffId = Wb.get('sys.staffId');\nlet display_name = Wb.get('sys.dispname');\nlet inParam = {\n  // user_name,\n  staffId,\n  display_name\n};\nWb.set(inParam);\nlet sql = `{call hgpt.p_hg_kh_hggltz_u(\n    {?pk_id?},\n    {?addNoticeTitle?},\n    {?addNoticeContent?},\n    {?staffId?},\n    {?display_name?},\n    {?addDepartment?},\n    {?addRole?},\n    {?addRange?},\n    {?addBeginDate?},\n    {?addEndDate?},\n    {?addOrderIndex?},\n    {*returnMsg*},\n    {*returnCode*}\n    )} `;\nlet res = Wb.sql(sql);\nWb.send(res);"},"_icon":"module"}