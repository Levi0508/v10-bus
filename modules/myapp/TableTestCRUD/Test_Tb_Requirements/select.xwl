{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","_expanded":true,"properties":{"cid":"module","serverScript":"function main() {\n  let sql, data, download, fieldName;\n\n  download = Wb.getObject('__download');\n  if (download) {\n    sql = Wb.Query.createSQL({ tableName: 'TEST_TB_REQUIREMENTS' }).select;\n    data = Wb.getRow({ sql, blob: true, params: download });\n    fieldName = download._meta.fieldName;\n    if (data)\n      Wb.exportData(data[fieldName], fieldName + '.dat');\n    else\n      Wb.raise(Str.notFound.format(fieldName));\n  } else {\n    sql = 'select * from TEST_TB_REQUIREMENTS';\n    sql += Wb.Query.getParamsIf(['r_id={?char|r_id?}', 'req_id={?varchar|req_id?}', 'sub_no={?tinyint|sub_no?}', 'p_req_id={?varchar|p_req_id?}', 'system={?varchar|system?}', 'module={?tinyint|module?}', 'dept={?varchar|dept?}', 'grp={?varchar|grp?}', 'emp_id={?varchar|emp_id?}', 'emp_name={?varchar|emp_name?}', 'pro_date={?date|pro_date?}', 'type={?tinyint|type?}', 'urgency={?tinyint|urgency?}', 'use_permis={?varchar|use_permis?}', 'oth_req_file={?tinyint|oth_req_file?}', 'if_accept={?tinyint|if_accept?}', 'acc_date={?date|acc_date?}', 'status={?tinyint|status?}', 'progress={?tinyint|progress?}', 'developer={?varchar|developer?}', 'tester={?varchar|tester?}', 'priority={?tinyint|priority?}', 'exp_com_date={?date|exp_com_date?}', 'act_com_date={?date|act_com_date?}', 'version={?varchar|version?}', 'old_req_id={?varchar|old_req_id?}', 'if_valid={?tinyint|if_valid?}']);\n    sql += Wb.getOrderSql();\n    data = Wb.getDict({ sql });\n    Wb.send(data);\n  }\n}\nmain();"},"_icon":"module"}