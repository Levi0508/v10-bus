{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","_expanded":true,"properties":{"cid":"module","serverScript":"function main() {\n  let sql, data, download, fieldName;\n\n  download = Wb.getObject('__download');\n  if (download) {\n    sql = Wb.Query.createSQL({ tableName: 'WB_DICT' }).select;\n    data = Wb.getRow({ sql, blob: true, params: download });\n    fieldName = download._meta.fieldName;\n    if (data)\n      Wb.exportData(data[fieldName], fieldName + '.dat');\n    else\n      Wb.raise(Str.notFound.format(fieldName));\n  } else {\n    sql = 'select * from WB_DICT';\n    sql += Wb.Query.getParamsIf(['sid={?varchar|sid?}', 'name={?varchar|name?}', 'title={?varchar|title?}', 'group_name={?varchar|group_name?}', 'group_title={?varchar|group_title?}', 'remark={?varchar|remark?}', 'edit_hidden={?numeric|edit_hidden?}', 'cname={?varchar|cname?}', 'edit_length={?numeric|edit_length?}', 'edit_scale={?numeric|edit_scale?}', 'edit_height={?varchar|edit_height?}', 'edit_type={?varchar|edit_type?}', 'edit_hint={?varchar|edit_hint?}', 'edit_required={?numeric|edit_required?}', 'edit_readonly={?numeric|edit_readonly?}', 'edit_colspan={?numeric|edit_colspan?}', 'edit_fill={?numeric|edit_fill?}', 'key_name={?varchar|key_name?}', 'display_hidden={?numeric|display_hidden?}', 'display_width={?varchar|display_width?}', 'display_format={?varchar|display_format?}', 'display_type={?varchar|display_type?}', 'auto_wrap={?varchar|auto_wrap?}', 'check_box={?varchar|check_box?}']);\n    sql += Wb.getOrderSql();\n    data = Wb.getDict({ sql });\n    Wb.send(data);\n  }\n}\nmain();"},"_icon":"module"}