f (app.childGrid.data[0].p_req_id == data.req_id) {\n          app.childGrid.delayLoad({ params: {p_req_id: data.req_id} });\n        }\n      }\n      win.hide();\n      Wb.toastSucc('需求修改成功！');\n    },\n    failure(resp) {\n      Wb.toastError('需求修改失败！');\n    }\n  });\n};\nwin.show();\n"}},{"_icon":"item","text":"delBtn","cls":"Wb.Item","_expanded":true,"properties":{"cid":"delBtn","text":"删除","icon":"delete"},"hasDupCid":1,"events":{"click":"let rec = app.mainGrid.selection;\n\nif (!rec) {\n  Wb.tipSelect();\n  return;\n}\n\nlet data = rec.data;\n\nWb.confirm(Wb.getActionHint(), f => {\n  Wb.ajax({\n    url: xpath + '/rm-actions&xaction=del',\n    params: { r_id: data.r_id, req_id: data.req_id },\n    json: true,\n    success(resp) {\n      app.mainGrid.delayLoad({ comps: app.viewport1 });\n      if (app.childGrid.data[0]) {\n        app.childGrid.delayLoad({ params: {p_req_id: app.childGrid.data[0].p_req_id} });\n      }\n      Wb.toastSucc('需求删除成功！');\n    },\n    failure(resp) {\n      Wb.toastError('需求删除失败！');\n    }\n  })\n});"}},{"_icon":"divider","text":"divider1","cls":"Wb.Divider","properties":{"cid":"divider1"},"_expanded":true,"hasDupCid":1},{"_icon":"item","text":"addChild","cls":"Wb.Item","_expanded":true,"properties":{"cid":"addChild","text":"拆分子需求","icon":"share1"},"events":{"click":"let win = app.editWin, rec = app.mainGrid.selection, data;\n\nif (!rec) {\n  Wb.tipSelect();\n  return;\n}\n\ndata = rec.data;\n\nif (data.req_id == '暂无') {\n  Wb.info('所选需求暂未接收，无法拆分子需求，请先接收该需求！');\n  return;\n}\n\nwin.icon = 'share1';\nwin.title = '拆分需求 - ' + data.req_id;\nWb.setValue(win, data);\nWb.each(win.items$, (index,panel) => {\n  Wb.each(panel.items$, (index,item) => {\n    item.readonly = false;\n  });\n});\nwin.buttonsBar.setVisible(true);\nwin.find('panel1').title = '需求内容';\nwin.find('panel3').title = '需求实现';\nWb.each(win.find('panel1').items$, (index,item) => {\n  if (item.cid$ == 'content') {\n    item.text = '子需求内容';\n    item.clear();\n  } else\n    item.setVisible(false);\n});\nwin.find('panel3').find('if_accept').setVisible(false);\nwin.find('panel3').find('acc_date').setVisible(false);\nwin.find('panel2').find('front_end').clear();\nwin.find('panel2').find('back_end').clear();\nwin.find('panel2').find('data_base').clear();\nwin.find('panel3').find('imp_plan').clear();\nwin.find('panel4').find('cur_problem').clear();\nwin.find('panel4').find('notes').clear();\nwin.focusControl = null;\n\nwin.okHandler = (win, values) => {\n  values.p_req_id = data.req_id;\n  Wb.ajax({\n    url: xpath + '/rm-actions&xaction=addChild',\n    params: values,\n    json: true,\n    success(resp) {\n      app.mainGrid.delayLoad({ comps: app.viewport1 });\n      app.childGrid.delayLoad({ params: {p_req_id: data.req_id} });\n      win.hide();\n      Wb.toastSucc('子需求添加成功！');\n    },\n    failure(resp) {\n      Wb.toastError('子需求添加失败！');\n    }\n  });\n};\n\nwin.show();"}},{"_icon":"divider","text":"divider2","cls":"Wb.Divider","properties":{"cid":"divider2"},"_expanded":true},{"_icon":"item","text":"editProgress","cls":"Wb.Item","_expanded":true,"properties":{"cid":"editProgress","text":"填写开发进度","icon":"schedule"},"events":{"click":"let win = app.editProWin, rec = app.mainGrid.selection, data;\n\nif (!rec) {\n  Wb.tipSelect();\n  return;\n}\n\ndata = rec.data;\nwin.icon = 'schedule';\nwin.title = '填写开发进度' + (data.req_id == '暂无' ? '' : ' - 需求' + data.req_id);\n\nWb.ajax({\n  url: xpath + '/rm-actions&xaction=getLastWeekProgress',\n  params: { r_id: data.r_id },\n  json: true,\n  success(resp) {\n    Wb.setValue(win, resp);\n    win.okHandler = (win, values) => {\n      Wb.ajax({\n        url: xpath + '/rm-actions&xaction=editProgress',\n        params: values,\n        json: true,\n        success(resp) {\n          app.mainGrid.delayLoad({ comps: app.viewport1 });\n          win.hide();\n          Wb.toastSucc('开发进度提交成功！');\n        },\n        failure(resp) {\n          Wb.toastError('开发进度提交失败！');\n        }\n      });\n    };\n  },\n  failure(resp) {\n    Wb.toastError('开发时间查询失败！');\n  }\n});\nwin.show();\n"}},{"_icon":"item","text":"item1","cls":"Wb.Item","_expanded":true,"properties":{"cid":"item1","icon":"atom"},"events":{"click":"Wb.open({url: 'm?xwl=myapp/test', params: {foo: 'bar'}, success(scope){\n  scope.text1.value = '1245124512'\n}});"}}]},{"_icon":"array","text":"columns","cls":"Wb.Array","properties":{"cid":"columns"},"hasDupCid":1,"_expanded":true,"items":[{"_icon":"column","text":"rowNumCol","cls":"Wb.Column","properties":{"cid":"rowNumCol","rowNum":"true"},"hasDupCid":1},{"_icon":"column","text":"reqIdCol","cls":"Wb.Column","properties":{"cid":"reqIdCol","fieldName":"req_id","text":"需求编号","titleAlign":"center","align":"center","render":"if (value) {\n  let a = el.addEl('req-id-link', 'a');\n  el.cls = 'w-ta-center';\n  a.textContent = value;\n}"},"_expanded":true,"hasDupCid":1},{"_icon":"column","text":"contentCol","cls":"Wb.Column","properties":{"cid":"contentCol","fieldName":"content","width":"40em","text":"需求内容","titleAlign":"center"},"hasDupCid":1},{"_icon":"column","text":"statusCol","cls":"Wb.Column","properties":{"cid":"statusCol","fieldName":"status","text":"状态","titleAlign":"center","keyValue":"true","width":"6em","align":"center"},"hasDupCid":1},{"_icon":"column","text":"chgStatusCol","cls":"Wb.Column","properties":{"cid":"chgStatusCol","width":"3em"},"hasDupCid":1,"_expanded":true,"items":[{"cls":"Wb.Item","properties":{"cid":"buttons","isProperty":"true","icon":"right3","iconColor":"#369feb","iconSize":"0.8em","tip":"更新状态"},"text":"buttons","_expanded":true,"_icon":"item","hasDupCid":0,"events":{"click":"let data = this.gridItem.data;\nlet next_status = data.status + 1;\n\nif (next_status > 5) {\n  Wb.info('需求' + data.req_id + '已发布，不支持快捷更新状态，可通过“编辑”修改！');\n  return;\n}\n\nWb.ajax({\n  url: xpath + '/rm-actions&xaction=getNextStatus',\n  params: { status: next_status },\n  json: true,\n  success(resp) {\n    if (!data.if_accept | data.if_accept == 0) {\n      Wb.confirm('该需求暂未接收，是否自动接收并更新状态为【' + resp.status_name + '】？', f => {\n        Wb.ajax({\n          url: xpath + '/rm-actions&xaction=updateStatus',\n          params: { $r_id: data.r_id, $req_id: data.req_id, status: next_status, $if_accept: data.if_accept, $has_child: data.has_child, $old_req_id: data.old_req_id },\n          json: true,\n          success(resp) {\n            app.mainGrid.delayLoad({ comps: app.viewport1 });\n            if (app.childGrid.data[0]) {\n              app.childGrid.delayLoad({ params: {p_req_id: app.childGrid.data[0].p_req_id} });\n            }\n            Wb.toastSucc('状态更新成功！');\n          },\n          failure(resp) {\n            Wb.toastError('状态更新失败！');\n          }\n        });\n      });\n    } else {\n      Wb.confirm('确认更新需求' + data.req_id + '的状态为【' + resp.status_name + '】吗？', f => {\n        Wb.ajax({\n          url: xpath + '/rm-actions&xaction=updateStatus',\n          params: { $r_id: data.r_id, $req_id: data.req_id, status: next_status, $if_accept: data.if_accept, $has_child: data.has_child, $old_req_id: data.old_req_id },\n          json: true,\n          success(resp) {\n            app.mainGrid.delayLoad({ comps: app.viewport1 });\n            if (app.childGrid.data[0]) {\n              app.childGrid.delayLoad({ params: {p_req_id: app.childGrid.data[0].p_req_id} });\n            }\n            Wb.toastSucc('状态更新成功！');\n          },\n          failure(resp) {\n            Wb.toastError('状态更新失败！');\n          }\n        });\n      });\n    } \n  },\n  failure(resp) {\n    Wb.toastError('状态更新失败！');\n  }\n});"}}]},{"_icon":"column","text":"progressCol","cls":"Wb.Column","properties":{"cid":"progressCol","fieldName":"progress","text":"进度","titleAlign":"center","render":"el.setStyle('background', 'linear-gradient(to right, #4fba2b ' + value + '%, rgb(125, 125, 125) 0%)', 'important');\nel.setStyle('color', '#fff');\nreturn value + '%';","align":"center"},"hasDupCid":1,"_expanded":true},{"_icon":"column","text":"lastProDtCol","cl