{"title":"需求管理","icon":"list1","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"Wb.set('curUser', Wb.encode(Wb.username));"},"_icon":"module","_expanded":true,"hasDupCid":1,"events":{"initialize":"Wb.define(app, {\n  set$keyId(value) {\n    this.keyId$ = value;\n  },\n\n  get$keyId() {\n    return this.keyId$;\n  },\n\n  set$keyName(value) {\n    this.keyName$ = value;\n  },\n\n  get$keyName() {\n    return this.keyName$;\n  },\n\n  set$keyType(value) {\n    this.keyType$ = value;\n  },\n\n  get$keyType() {\n    return this.keyType$;\n  },\n\n  onChange() {\n    app.saveBtn.disabled = false;\n  },\n\n  save(success) {\n    let grid = app.listGrid;\n    grid.sync({\n      url: xpath + '/rm-actions&xaction=saveKeyValue',\n      params: { keyId: app.keyId, keyName: app.keyName },\n      success(resp) {\n        app.saveBtn.disabled = true;\n        success?.();\n      },\n      failure(resp) {\n        Wb.toastError('保存失败！');\n      }\n    });\n  }\n});","finalize":"app.userName = _$curUser$_;\nWb.ajax({\n  url: xpath + '/rm-actions&xaction=getUserName',\n  params: { user_name: app.userName },\n  json: true,\n  success(resp) {\n    app.curUserName = resp.display_name;\n    app.developerSel.value = app.curUserName;\n    app.mainGrid.load({ comps: app.viewport1 });\n  },\n  failure(resp) {\n    Wb.toastError('获取当前登录用户信息失败！');\n  }\n});"},"items":[{"_icon":"array","text":"no instanced items","cls":"Wb.Array","properties":{"cid":"no instanced items"},"_expanded":true,"items":[{"_icon":"window","text":"editWin","cls":"Wb.Window","_expanded":false,"properties":{"cid":"editWin","layout":"column","padding":"true","gap":"true","resetDialog":"true","autoScroll":"true"},"items":[{"_icon":"text","text":"r_id","cls":"Wb.Text","properties":{"cid":"r_id","visible":"false"},"hasDupCid":1},{"_icon":"text","text":"req_id","cls":"Wb.Text","properties":{"cid":"req_id","visible":"false"}},{"_icon":"text","text":"old_req_