perties":{"cid":"empNameCol","fieldName":"emp_name","text":"提出人员","titleAlign":"center","align":"center"},"_expanded":true},{"_icon":"column","text":"grpCol","cls":"Wb.Column","properties":{"cid":"grpCol","fieldName":"grp","text":"所在小组","titleAlign":"center"},"_expanded":true},{"_icon":"column","text":"proDateCol","cls":"Wb.Column","properties":{"cid":"proDateCol","fieldName":"pro_date","text":"提出日期","titleAlign":"center"},"_expanded":true},{"_icon":"column","text":"rIdCol","cls":"Wb.Column","properties":{"cid":"rIdCol","fieldName":"r_id","visible":"false"},"_expanded":true,"hasDupCid":1},{"_icon":"column","text":"oldReqIdCol","cls":"Wb.Column","properties":{"cid":"oldReqIdCol","fieldName":"old_req_id","visible":"false"}}]}]},{"_icon":"grid","text":"childGrid","cls":"Wb.Grid","properties":{"cid":"childGrid","flex":"1","url":"@xpath + '/rm-actions&xaction=selectChild'","gridLine":"horizontal","headerLine":"horizontal"},"events":{"click":"let req_id_link = e.target.closest('.sub-req-id-link');\n\nif (req_id_link) {\n  let win = app.editWin;\n  let row = this.findItemByEl(req_id_link);\n  let data = row.data;\n\n  win.title = '查看子需求 - ' + data.req_id;\n  win.icon = 'check';\n\n  Wb.setValue(win, data);\n  win.buttonsBar.setVisible(false);\n  Wb.each(win.items$, (index,panel) => {\n    Wb.each(panel.items$, (index,item) => {\n      item.readonly = true;\n      item.setVisible(true);\n    });\n  });\n  win.find('panel1').find('oth_req_file').setVisible(false);\n  win.show();\n};"},"_expanded":false,"items":[{"_icon":"array","text":"columns","cls":"Wb.Array","properties":{"cid":"columns"},"hasDupCid":1,"_expanded":true,"items":[{"_icon":"column","text":"rowNumCol","cls":"Wb.Column","properties":{"cid":"rowNumCol","rowNum":"true"},"_expanded":true,"hasDupCid":1},{"_icon":"column","text":"reqIdCol","cls":"Wb.Column","properties":{"cid":"reqIdCol","fieldName":"req_id","text":"子需求编号","titleAlign":"center","render":"if (value) {\n  let a = el.addEl('sub-req-id-link', 'a');\n  