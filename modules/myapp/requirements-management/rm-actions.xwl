{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"let actions = {\n  getUserName() {\n    Wb.sendRow(`select display_name from app.wb_user where user_name = '` + Params.user_name + `'`)\n  },\n\n  listDept() {\n    Wb.sendSql('select DEPT_ID, DEPT_NAME from APP.TB_DEPT');\n  },\n\n  listGrp() {\n    Wb.sendSql(`select GRP_ID, GRP_NAME from APP.TB_GROUP g\n                inner join APP.TB_DEPT d on g.DEPT_ID = d.DEPT_ID\n                and d.DEPT_NAME = {?dept_name?}`);\n  },\n\n  listEmp() {\n    Wb.sendSql(`select EMP_NO, EMP_NAME from APP.TB_EMP e\n                inner join APP.TB_GROUP g on e.GRP_ID = g.GRP_ID\n                and g.GRP_NAME = {?grp_name?} order by e.EMAIL`);\n  },\n\n  add() {\n    let othReqFile = Params.oth_req_file, file_cnt, if_accept;\n\n    if (othReqFile) {\n      if (othReqFile.name) \n        file_cnt = 1;\n      else\n        file_cnt = othReqFile.size();\n    }\n\n    let req_id = '暂无', req_no;\n\n    if (Params.if_accept == 1) {\n      if_accept = 1;\n      req_no = Wb.getRow('select APP.seq_req_no.nextval as req_no from dual').req_no;\n      req_id = 'FLHGPT' + req_no.toString().padStart(5, '0');\n    } else\n      if_accept = 0;\n\n    let r_id = Wb.getId();\n\n    let rec = { p_req_id: 'FLHGPT', oth_req_file: file_cnt, sub_no: 0, \n                progress: Params.status * 20, if_accept: if_accept,\n                r_id: r_id, req_id: req_id, if_valid: 1};\n\n    Wb.set(rec);\n    Wb.sync({ tableName: 'APP.TB_REQUIREMENTS', insert: Params });\n\n    if (othReqFile) {\n      let file_path, insert_rec;\n      if (othReqFile.name) {\n        file_path = 'files/rm-attachment/' + r_id + '/' + othReqFile.name;\n        new Wb.File(true, file_path).stream = othReqFile.stream;\n        insert_rec = { f_id: Wb.getId(), r_id: r_id, file_path: file_path, \n                      file_name: othReqFile.name, file_size: othReqFile.size, \n                      upload_time: Date.current(), if_valid: 1 };\n        Wb.sync({ tableName: 'APP.TB_FILES', insert: insert_rec });\n      } else {\n        othReqFile.forEach(file => {\n          file_path = 'files/rm-attachment/' + r_id + '/' + file.name;\n          new Wb.File(true, file_path).stream = file.stream;\n          insert_rec = { f_id: Wb.getId(), r_id: r_id, file_path: file_path, \n                        file_name: file.name, file_size: file.size, \n                        upload_time: Date.current(), if_valid: 1 };\n          Wb.sync({ tableName: 'APP.TB_FILES', insert: insert_rec });\n        });\n      }\n    }\n  },\n\n  select() {\n    Params.p_req_id ??= 'FLHGPT';\n    Params.statusSel ??= '[{\"0\":\"待定\",\"1\":0},{\"0\":\"需求分析中\",\"1\":1},{\"0\":\"开发中\",\"1\":2},{\"0\":\"测试中\",\"1\":3},{\"0\":\"待上线\",\"1\":4}]';\n\n    let sql;\n    \n    sql = `select a.R_ID,REQ_ID,SUB_NO,P_REQ_ID,SYSTEM,MODULE,DEPT,\n            GRP,EMP_ID,EMP_NAME,PRO_DATE,CONTENT,TYPE,URGENCY,\n            USE_PERMIS,OTH_REQ_FILE,CUR_PROBLEM,IF_ACCEPT,ACC_DATE,\n            IMP_PLAN,FRONT_END,BACK_END,DATA_BASE,TEC_REQUIRE,STATUS,\n            a.PROGRESS,DEVELOPER,TESTER,PRIORITY,EXP_COM_DATE,ACT_COM_DATE,OLD_REQ_ID,\n            VERSION,NOTES,case when (select count(*) from APP.TB_REQUIREMENTS b \n            where b.p_req_id = a.req_id and b.if_valid = 1) > 0 then 1 else 0 end as has_child,\n            DATE_FORMAT(b.begin_date,'yyyy/mm/dd') || '-' || DATE_FORMAT(b.end_date,'yyyy/mm/dd') as last_pro_date,\n            b.progress as dev_progress\n          from APP.TB_REQUIREMENTS a\n          left join (SELECT t.P_ID,t.R_ID,t.BEGIN_DATE,t.END_DATE,t.PROGRESS\n                       FROM APP.TB_DEV_PROGRESS t\n                       JOIN (select R_ID,max(BEGIN_DATE) as BEGIN_DATE from APP.TB_DEV_PROGRESS group by r_id) m \n                         ON t.r_id = m.r_id AND t.BEGIN_DATE = m.BEGIN_DATE) b on a.r_id = b.r_id \n          where a.p_req_id = {?p_req_id?} and if_valid = 1`;\n\n    if (Params.moduleSel) {\n      sql += ' AND MODULE = {?moduleSel?}';\n    }\n\n    if (Params.accFromDt) {\n      sql += ' AND ACC_DATE >= {?accFromDt?}';\n    }\n\n    if (Params.accToDt) {\n      sql += ' AND ACC_DATE <= {?accToDt?}';\n    }\n\n    if (Params.grpSel) {\n      sql += ' AND GRP = {?grpSel?}';\n    }\n\n    if (Params.contentTxt) {\n      Wb.setLike('contentTxt');\n      sql += ' AND CONTENT LIKE {?contentTxt?}';\n    }\n\n    if (Params.urgencySel) {\n      sql += ' AND URGENCY = {?urgencySel?}';\n    }\n\n    if (Params.typeSel) {\n      sql += ' AND TYPE = {?typeSel?}';\n    }\n\n    if (Params.expFromDt) {\n      sql += ' AND EXP_COM_DATE >= {?expFromDt?}';\n    }\n\n    if (Params.expToDt) {\n      sql += ' AND EXP_COM_DATE <= {?expToDt?}';\n    }\n\n    if (Params.developerSel) {\n      sql += ' AND DEVELOPER = {?developerSel?}';\n    }\n\n    if (Params.statusSel) {\n      let status = Params.statusSel;\n      let list_status;\n      if (Wb.isString(status)) {\n        list_status = Wb.decode(status).pluck(1);\n      } else {\n        list_status = status.pluck(1);\n      }\n      if (list_status.length > 0)\n        sql += ' AND STATUS in (' + list_status.join(',') + ')';\n    }\n\n    if (Params.ifAccSel) {\n      sql += ' AND IF_ACCEPT = {?ifAccSel?}';\n    }\n\n    if (Params.prioritySel) {\n      sql += ' AND PRIORITY = {?prioritySel?}';\n    }\n\n    if (Params.versionSel) {\n      sql += ' AND VERSION = {?versionSel?}';\n    }\n    \n    sql += Wb.getOrderSql();\n    Wb.sendSql({ sql, kv: { module: 'module', urgency: 'urgency', \n                status: 'req_status', priority: 'priority', if_accept: 'if_accept' } });\n  },\n\n  getFiles() {\n    let sql = `select F_ID,R_ID,FILE_NAME,FILE_PATH,FILE_SIZE,UPLOAD_TIME \n              from APP.TB_FILES where if_valid = 1 and r_id = {?r_id_files?}`;\n    if (Params.fileNameTxt) {\n      Wb.setLike('fileNameTxt');\n      sql += ' and file_name like {?fileNameTxt?}';\n    };\n    Wb.sendSql(sql);\n  },\n\n  editItem() {\n    Wb.sync({ tableName: 'APP.TB_REQUIREMENTS', update: Params });\n\n    if (Params.act_com_date) {\n      let updt_sub_sql = `UPDATE APP.TB_REQUIREMENTS T1 JOIN APP.TB_REQUIREMENTS T2 ON T1.P_REQ_ID = T2.REQ_ID\n                  SET T1.ACT_COM_DATE = {?act_com_date?}\n                WHERE T1.P_REQ_ID = (SELECT REQ_ID FROM APP.TB_REQUIREMENTS WHERE R_ID = {?$r_id?})\n                  AND T1.ACT_COM_DATE > {?act_com_date?}`;\n\n      Wb.sendSql(updt_sub_sql); \n\n      let updt_prt_sql = `UPDATE APP.TB_REQUIREMENTS T1 \n                            JOIN (SELECT T.P_REQ_ID, MAX(T.ACT_COM_DATE) AS ACT_COM_DATE FROM APP.TB_REQUIREMENTS T WHERE T.P_REQ_ID <> 'FLHGPT' GROUP BY T.P_REQ_ID) T2 \n                              ON T1.REQ_ID = T2.P_REQ_ID\n                             SET T1.ACT_COM_DATE = T2.ACT_COM_DATE\n                           WHERE T1.REQ_ID = (SELECT P_REQ_ID FROM APP.TB_REQUIREMENTS WHERE R_ID = {?$r_id?})`;\n\n      Wb.sendSql(updt_prt_sql); \n    }\n  },\n\n  edit() {\n    let rec;\n    let req_no, req_id, old_req_id = Params.$old_req_id;\n    if (Params.if_accept) {\n      if (Params.if_accept == 1) {\n        if (!old_req_id) {\n          req_no = Wb.getRow('select APP.seq_req_no.nextval as req_no from dual').req_no;\n          req_id = 'FLHGPT' + req_no.toString().padStart(5, '0');\n        } else \n          req_id = old_req_id;\n      } else {\n        req_id = '暂无';\n        old_req_id = Params.$req_id;\n      }\n      rec = { req_id: req_id, old_req_id: old_req_id };\n      Wb.set(rec);\n    }\n\n    let othReqFile = Params.oth_req_file, file_cnt;\n\n    if (othReqFile) {\n      if (othReqFile.name) \n        file_cnt = 1;\n      else\n        file_cnt = othReqFile.size();\n      rec = { oth_req_file: file_cnt };\n      Wb.set(rec);\n    }\n\n    if (Params.status) {\n      if (Params.status == 5) {\n        rec = { progress: Params.status * 20, act_com_date: Date.current().datePart }\n      } else {\n        rec = { progress: Params.status * 20, act_com_date: '' };\n      }\n      Wb.set(rec);\n    }\n\n    Wb.sync({ tableName: 'APP.TB_REQUIREMENTS', update: Params });\n\n    let r_id = Params.$r_id;\n    if (othReqFile) {\n      let file_path, insert_rec;\n      if (othReqFile.name) {\n        file_path = 'files/rm-attachment/' + r_id + '/' + othReqFile.name;\n        new Wb.File(true, file_path).stream = othReqFile.stream;\n        insert_rec = { f_id: Wb.getId(), r_id: r_id, file_path: file_path, \n                      file_name: othReqFile.name, file_size: othReqFile.size, \n                      upload_time: Date.current(), if_valid: 1 };\n        Wb.sync({ tableName: 'APP.TB_FILES', insert: insert_rec });\n      } else {\n        othReqFile.forEach(file => {\n          file_path = 'files/rm-attachment/' + r_id + '/' + file.name;\n          new Wb.File(true, file_path).stream = file.stream;\n          insert_rec = { f_id: Wb.getId(), r_id: r_id, file_path: file_path, \n                        file_name: file.name, file_size: file.size, \n                        upload_time: Date.current(), if_valid: 1 };\n          Wb.sync({ tableName: 'APP.TB_FILES', insert: insert_rec });\n        });\n      }\n    }\n\n    if (Params.$has_child == 1) {\n      let updt_sub_sql;\n      updt_sub_sql = `UPDATE APP.TB_REQUIREMENTS T1 JOIN APP.TB_REQUIREMENTS T2 ON T1.P_REQ_ID = T2.REQ_ID\n                      SET T1.SYSTEM = T2.SYSTEM, T1.MODULE = T2.MODULE, T1.DEPT = T2.DEPT, T1.GRP = T2.GRP, \n                      T1.EMP_NAME = T2.EMP_NAME, T1.PRO_DATE = T2.PRO_DATE, T1.TYPE = T2.TYPE, T1.URGENCY = T2.URGENCY, \n                      T1.OTH_REQ_FILE = T2.OTH_REQ_FILE, T1.IF_ACCEPT = T2.IF_ACCEPT, T1.ACC_DATE = T2.ACC_DATE\n                      WHERE T1.P_REQ_ID = {?$req_id?}`\n      Wb.sendSql(updt_sub_sql);\n\n      if (Params.developer) {\n        updt_sub_sql = `UPDATE APP.TB_REQUIREMENTS T1\n                        SET T1.developer = {?developer?} \n                        WHERE T1.P_REQ_ID = {?$req_id?}`;\n        Wb.sendSql(updt_sub_sql);\n      }\n\n      if (Params.tester) {\n        updt_sub_sql = `UPDATE APP.TB_REQUIREMENTS T1\n                        SET T1.tester = {?tester?} \n                        WHERE T1.P_REQ_ID = {?$req_id?}`;\n        Wb.sendSql(updt_sub_sql);\n      }\n\n      if (Params.priority) {\n        updt_sub_sql = `UPDATE APP.TB_REQUIREMENTS T1\n                        SET T1.priority = {?priority?} \n                        WHERE T1.P_REQ_ID = {?$req_id?}`;\n        Wb.sendSql(updt_sub_sql);\n      }\n\n      if (Params.version) {\n        updt_sub_sql = `UPDATE APP.TB_REQUIREMENTS T1\n                        SET T1.version = {?version?} \n                        WHERE T1.P_REQ_ID = {?$req_id?}`;\n        Wb.sendSql(updt_sub_sql);\n      }\n\n      if (Params.status) {\n        if (Params.status == 5) {\n          let cur_date = Date.current().datePart;\n          updt_sub_sql = `UPDATE APP.TB_REQUIREMENTS T1\n                          SET T1.act_com_date = '` + cur_date + `', T1.status = {?status?}, T1.progress = {?status?} * 20\n                          WHERE T1.P_REQ_ID = {?$req_id?} and nvl(T1.status,0) < 5`;\n          Wb.sendSql(updt_sub_sql);\n        } else {\n          updt_sub_sql = `UPDATE APP.TB_REQUIREMENTS T1\n                        SET T1.status = {?status?}, T1.progress = {?status?} * 20\n                        WHERE T1.P_REQ_ID = {?$req_id?} and nvl(T1.status,0) < {?status?}`;\n          Wb.sendSql(updt_sub_sql);\n        }\n      }\n    }\n  },\n\n  del() {\n    Wb.sync({ tableName: 'APP.TB_REQUIREMENTS', update: { $r_id: Params.r_id, if_valid: 0 } });\n    let del_files_sql = `UPDATE APP.TB_FILES T1\n                    SET T1.if_valid = 0 \n                    WHERE T1.r_id = {?r_id?}`;\n    Wb.sendSql(del_files_sql);\n    let del_sub_sql = `UPDATE APP.TB_REQUIREMENTS T1\n                    SET T1.if_valid = 0 \n                    WHERE T1.P_REQ_ID = {?req_id?}`;\n    Wb.sendSql(del_sub_sql);\n  },\n\n  delChild() {\n    let del_sub_sql = `UPDATE APP.TB_REQUIREMENTS T1\n                    SET T1.if_valid = 0 \n                    WHERE T1.REQ_ID = {?req_id?}`;\n    Wb.sendSql(del_sub_sql);\n  },\n\n  selectChild() {\n    let sql = `select R_ID,REQ_ID,SUB_NO,P_REQ_ID,SYSTEM,MODULE,DEPT,\n                GRP,EMP_ID,EMP_NAME,PRO_DATE,CONTENT,TYPE,URGENCY,\n                USE_PERMIS,OTH_REQ_FILE,CUR_PROBLEM,IF_ACCEPT,ACC_DATE,\n                IMP_PLAN,FRONT_END,BACK_END,DATA_BASE,TEC_REQUIRE,STATUS,\n                PROGRESS,DEVELOPER,TESTER,PRIORITY,EXP_COM_DATE,ACT_COM_DATE,\n                VERSION,NOTES\n              from APP.TB_REQUIREMENTS a where a.p_req_id = {?p_req_id?} and if_valid = 1`;\n\n    sql += Wb.getOrderSql();\n    Wb.sendSql({ sql, kv: { module: 'module', urgency: 'urgency', \n                status: 'req_status', priority: 'priority', if_accept: 'if_accept' } });\n  },\n\n  editChild() {\n    let rec;\n\n    if (Params.status) {\n      if (Params.status == 5) {\n        rec = { progress: Params.status * 20, act_com_date: Date.current().datePart }\n      } else {\n        rec = { progress: Params.status * 20, act_com_date: '' };\n      }\n      Wb.set(rec);\n    }\n\n    Wb.sync({ tableName: 'APP.TB_REQUIREMENTS', update: Params });\n\n    let updt_prt_sql = `UPDATE APP.TB_REQUIREMENTS T1 \n                        JOIN (\n                        SELECT T.P_REQ_ID, MIN(T.STATUS) AS STATUS, MAX(T.EXP_COM_DATE) AS EXP_COM_DATE, \n                        MAX(T.ACT_COM_DATE) AS ACT_COM_DATE FROM APP.TB_REQUIREMENTS T GROUP BY T.P_REQ_ID) T2 \n                        ON T1.REQ_ID = T2.P_REQ_ID\n                        SET T1.STATUS = T2.STATUS, T1.PROGRESS = T2.STATUS * 20,\n                        T1.EXP_COM_DATE = T2.EXP_COM_DATE, T1.ACT_COM_DATE = T2.ACT_COM_DATE\n                        WHERE T1.REQ_ID = {?$p_req_id?}`\n    Wb.sendSql(updt_prt_sql);\n\n  },\n\n  addChild() {\n    let sub_no = Wb.getRow(`select nvl(max(SUB_NO),0) + 1 as SUB_NO\n            from APP.TB_REQUIREMENTS a where a.p_req_id = {?p_req_id?} and a.if_valid = 1`).sub_no;\n\n    let sub_req_id = Params.p_req_id + '-' + sub_no.toString().padStart(3, '0');\n\n    let rec = { r_id: Wb.getId(), req_id: sub_req_id, p_req_id: Params.p_req_id, \n                sub_no: sub_no, progress: Params.status * 20, if_valid: 1 };\n\n    Wb.log(Params.p_req_id);\n\n    Wb.set(rec);\n    Wb.sync({ tableName: 'APP.TB_REQUIREMENTS', insert: Params });\n  },\n\n  downloadFile() {\n    Wb.exportData(new Wb.File(true, Params.file_path));\n  },\n\n  deleteFile() {\n    let file_cnt = Wb.getRow(`select nvl(oth_req_file, 0) as file_cnt\n                              from APP.TB_REQUIREMENTS \n                              where r_id = {?r_id?}`).file_cnt;\n    Wb.sync({ tableName: 'APP.TB_REQUIREMENTS', update: {$r_id: Params.r_id, oth_req_file: file_cnt - 1} });                      \n    Wb.sync({ tableName: 'APP.TB_FILES', update: {$f_id: Params.f_id, if_valid: 0} });\n  },\n\n  addFiles() {\n    let file_cnt = Wb.getRow(`select nvl(oth_req_file, 0) as file_cnt\n                              from APP.TB_REQUIREMENTS \n                              where r_id = {?r_id_addfiles?}`).file_cnt;\n    let r_id = Params.r_id_addfiles, filesIpt = Params.filesIpt;\n    let cnt_chg = 0;\n    let file_path, insert_rec, file_name, is_exist;\n\n    if (filesIpt.name) {\n      file_path = 'files/rm-attachment/' + r_id + '/' + filesIpt.name;\n      file_name = filesIpt.name;\n      new Wb.File(true, file_path).stream = filesIpt.stream;\n      is_exist = Wb.getRow('select * from APP.TB_FILES where file_name = \\''\n                          + file_name + '\\' and if_valid = 1 and r_id = {?r_id_addfiles?}');\n      if (is_exist) {\n        Wb.sync({ tableName: 'APP.TB_FILES', update: {$f_id: is_exist.f_id, if_valid: 0} });\n        cnt_chg += -1;\n      };\n      insert_rec = { f_id: Wb.getId(), r_id: r_id, file_path: file_path, \n                    file_name: file_name, file_size: filesIpt.size, \n                    upload_time: Date.current(), if_valid: 1 };\n      Wb.sync({ tableName: 'APP.TB_FILES', insert: insert_rec });\n      cnt_chg += 1;\n    } else {\n      filesIpt.forEach(file => {\n        file_path = 'files/rm-attachment/' + r_id + '/' + file.name;\n        file_name = file.name;\n        new Wb.File(true, file_path).stream = file.stream;\n        is_exist = Wb.getRow('select * from APP.TB_FILES where file_name = \\''\n                            + file_name + '\\' and if_valid = 1 and r_id = {?r_id_addfiles?}');\n        if (is_exist) {\n          Wb.sync({ tableName: 'APP.TB_FILES', update: {$f_id: is_exist.f_id, if_valid: 0} });\n          cnt_chg += -1;\n        };\n        insert_rec = { f_id: Wb.getId(), r_id: r_id, file_path: file_path, \n                      file_name: file_name, file_size: file.size, \n                      upload_time: Date.current(), if_valid: 1 };\n        Wb.sync({ tableName: 'APP.TB_FILES', insert: insert_rec });\n        cnt_chg += 1;\n      });\n    }\n    file_cnt = file_cnt + cnt_chg;\n    Wb.sync({ tableName: 'APP.TB_REQUIREMENTS', update: {$r_id: r_id, oth_req_file: file_cnt} });\n  },\n\n  getNextStatus() {\n    Wb.sendRow(`select A.MAP_K,A.MAP_V as status_name from APP.WB_KEY A\n                JOIN APP.WB_KEY_TYPE B ON A.RID = B.SID AND B.KEY_NAME = 'req_status'\n                where a.map_k = {?status?}`);\n  },\n\n  updateStatus() {\n    let rec;\n    let old_req_id = Params.$old_req_id;\n    let req_no, req_id;\n\n    if (Params.$if_accept == 0) {\n      if (!old_req_id) {\n        req_no = Wb.getRow('select APP.seq_req_no.nextval as req_no from dual').req_no;\n        req_id = 'FLHGPT' + req_no.toString().padStart(5, '0');\n      } else \n        req_id = old_req_id;\n      rec = { req_id: req_id, if_accept: 1, acc_date: Date.current().datePart };\n      Wb.set(rec);\n    }\n\n    if (Params.status == 5) {\n      rec = { progress: Params.status * 20, act_com_date: Date.current().datePart }\n    } else {\n      rec = { progress: Params.status * 20, act_com_date: '' };\n    }\n    Wb.set(rec);\n\n    Wb.sync({ tableName: 'APP.TB_REQUIREMENTS', update: Params });\n\n    if (Params.$has_child == 1) {\n      let updt_sub_sql;\n      if (Params.status == 5) {\n        let cur_date = Date.current().datePart;\n        updt_sub_sql = `UPDATE APP.TB_REQUIREMENTS T1\n                        SET T1.act_com_date = '` + cur_date + `', T1.status = {?status?}, T1.progress = {?status?} * 20\n                        WHERE T1.P_REQ_ID = {?$req_id?} and nvl(T1.status,0) < 5`;\n        Wb.sendSql(updt_sub_sql);\n      } else {\n        updt_sub_sql = `UPDATE APP.TB_REQUIREMENTS T1\n                      SET T1.status = {?status?}, T1.progress = {?status?} * 20\n                      WHERE T1.P_REQ_ID = {?$req_id?} and nvl(T1.status,0) < {?status?}`;\n        Wb.sendSql(updt_sub_sql);\n      }\n    }\n  },\n\n  updateSubStatus() {\n    let rec;\n\n    if (Params.status == 5) {\n      rec = { progress: Params.status * 20, act_com_date: Date.current().datePart }\n    } else {\n      rec = { progress: Params.status * 20, act_com_date: '' };\n    }\n    Wb.set(rec);\n\n    Wb.sync({ tableName: 'APP.TB_REQUIREMENTS', update: Params });\n\n    let updt_prt_sql = `UPDATE APP.TB_REQUIREMENTS T1 \n                        JOIN (\n                        SELECT T.P_REQ_ID, MIN(T.STATUS) AS STATUS, MAX(T.EXP_COM_DATE) AS EXP_COM_DATE, \n                        MAX(T.ACT_COM_DATE) AS ACT_COM_DATE FROM APP.TB_REQUIREMENTS T GROUP BY T.P_REQ_ID) T2 \n                        ON T1.REQ_ID = T2.P_REQ_ID\n                        SET T1.STATUS = T2.STATUS, T1.PROGRESS = T2.STATUS * 20,\n                        T1.EXP_COM_DATE = T2.EXP_COM_DATE, T1.ACT_COM_DATE = T2.ACT_COM_DATE\n                        WHERE T1.REQ_ID = {?$p_req_id?}`\n    Wb.sendSql(updt_prt_sql);\n  },\n\n  getKeyType() {\n    Wb.sendRow(`select * from app.wb_key_type b where b.key_name = {?keyName?}`);\n  },\n\n  selectKeyValue() {\n    let data, sql = `select * from app.wb_key where rid = {?rid?}`;\n    if (Params.searchList) {\n      Wb.setLike('searchList');\n      sql += ' and (map_k like {?searchList?} or map_v like {?searchList?})';\n    }\n    sql += ' order by map_k';\n    data = Wb.getDict(sql, 'wb,');\n    if (Params.keyType == '1') {\n      data.items.sort((a, b) => {\n        return parseInt(a.map_k) - parseInt(b.map_k);\n      });\n    }\n    Wb.send(data);\n  },\n\n  getLastWeekProgress() {\n    let last_week = Wb.getRow(`select min(busi_date) as begin_date, max(busi_date) as end_date\n                  from APP.TB_TRADEDATE\n                 where week_no = \n               (select decode(week_day,5,week_no,week_no-1)\n                  from APP.TB_TRADEDATE\n                 where busi_date = '` + Date.current().datePart + `')\n                   and is_tradedate = 1\n              group by week_no`);\n\n    let progress = Wb.getRow(`select P_ID,R_ID,BEGIN_DATE,END_DATE,PROGRESS\n                  from APP.TB_DEV_PROGRESS\n                 where BEGIN_DATE = '` + last_week.begin_date + `' and END_DATE = '` + last_week.end_date + `'\n                   and R_ID = {?r_id?}`);\n\n    if (progress) {\n      Wb.send(progress);\n    }\n    else {\n      Wb.send({ r_id: Params.r_id, begin_date: last_week.begin_date, end_date: last_week.end_date });\n    }\n  },\n\n  editProgress() {\n    Wb.sendSql(`MERGE INTO APP.TB_DEV_PROGRESS a\n\t                   USING DUAL\n                        ON (a.begin_date = {?begin_date?} and a.end_date = {?end_date?} and a.r_id = {?r_id?})\n              WHEN MATCHED\n              THEN\n                  UPDATE SET a.progress = {?progress?}\n              WHEN NOT MATCHED\n              THEN\n                  INSERT VALUES ('` + Wb.getId() + `',{?r_id?},{?begin_date?},{?end_date?},{?progress?})`);\n  },\n\n  selectProgress() {\n    Wb.sendRow(`select P_ID,R_ID,BEGIN_DATE,END_DATE,PROGRESS\n                  from APP.TB_DEV_PROGRESS\n                 where BEGIN_DATE = {?begin_date?} and END_DATE = {?end_date?}\n                   and R_ID = {?r_id?}`);\n  },\n\n  saveKeyValue() {\n    const Util = Wb.load('./util.mjs');\n    let sid, rid = Params.keyId, insert = [], rec;\n\n    Params.insert?.forEach(item => {\n      sid = Wb.getId();\n      rec = { sid, rid };\n      Wb.apply(item, rec);\n      insert.push(rec);\n    });\n    Params.tableName = 'app.wb_key';\n    Params.db = '';\n    Wb.sync(Params);\n    Util.loadKey(Params.keyName);\n    Wb.send({ insert });\n  },\n\n};\nactions[Params.xaction]();"},"_icon":"module"}