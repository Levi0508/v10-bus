{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"  \n//   --部门层级\n//     select dept_name as text, sid as subtext, dept_name, sid, parent_id,\n//       case when (select count(*) from BASIC_HG.WB_DEPT b where b.parent_id=a.sid)>0 then 0 else 1 end as \"_leaf\"\n//        from BASIC_HG.WB_DEPT a where sid != '0'\t;\n\n\n\n\n ----员工查PK_ID部门id 部门名称，个人名称  旧工号（ehr_id）\nSELECT\nT.PK_ID,\nA.DEPT_ID,\nB.DEPT_NAME,\nA.STAFF_ID,\nA.DISPLAY_NAME,\nA.USER_ID\nFROM HGPT.TB_HGKH_CONTACT_CONF T\nINNER JOIN BASIC_HG.WB_USER A\nON T.CONTACT_ID=A.STAFF_ID\n INNER JOIN  BASIC_HG.WB_DEPT B\nON  A.DEPT_ID=B.SID \nWHERE A.STAFF_ID=I_STAFF_ID\t;\n\n\n--\n\nSELECT\n\nA.DEPT_ID,\nB.DEPT_NAME,\nA.STAFF_ID,\nA.DISPLAY_NAME,\nA.USER_ID\nFROM  BASIC_HG.WB_USER A\n INNER JOIN  BASIC_HG.WB_DEPT B\nON  A.DEPT_ID=B.SID \nWHERE A.STAFF_ID=I_STAFF_ID\t;\n\n\n\n\n\n\n\n\n\n  SELECT \n    sid AS 部门ID,\n    dept_name AS 部门名称,\n    parent_id AS 父部门ID,\n    LEVEL AS 层级深度  -- 1=研发部，2=前端组，3=前端1组\nFROM BASIC_HG.WB_DEPT\nWHERE sid != '0' \nSTART WITH sid = 'D1'\nCONNECT BY NOCYCLE PRIOR sid = parent_id\n--CONNECT BY NOCYCLE PRIOR parent_id=sid  \nORDER SIBLINGS BY sid ASC;\n\n\n\n\n\n\n\n"},"_icon":"module"}