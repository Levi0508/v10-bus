{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","remark":"Select departments","serverScript":"function main() {\n  let sql, rows, firstItem, searchDept = Params.searchDept;\n\n  sql = `\n        select a.dept_name, a.dept_code, a.sid, a.parent_id, b.sid as user_id,\n        a.status, 'folder1' as \"_icon\", a.sid as dept_id_disp,\n        case when (select count(*) from wb_dept c where c.parent_id=a.sid)>0 then 1 else 0 end as items\n        from wb_dept a left join wb_user b on a.manager_id=b.sid\n        `;\n  if (searchDept) {\n    Wb.setLike('searchDept');\n    sql += ' where a.dept_name like {?searchDept?} or a.dept_code like {?searchDept?} or a.sid like {?searchDept?}';\n  } else {\n    Params.parent_id = Params.sid || '0';\n    sql += ' where a.parent_id={?parent_id?}';\n  }\n  sql += Wb.getOrderSql({ manager_name: 'b.display_name' });\n  rows = Wb.getDict({ sql, columns: 'tree', rs: searchDept ? 100 : -1 }, 'wb,');\n  if (!searchDept && !Params.sid && (firstItem = rows.items[0]) && rows.items.length == 1)\n    firstItem._expanded = true;\n  Wb.send(rows);\n}\nmain();"},"_icon":"module"}