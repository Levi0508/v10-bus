{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","remark":"Select users","serverScript":"function main() {\n  const protectedText = Wb.UserUtil.protectedText;//声明常量=用户会话密码(受保护)\n  let sql;\n\n  sql = `select a.sid, a.user_name, a.display_name, '${protectedText}' as password, '${protectedText}' as confirm_password,\n           a.email, a.mobile_phone, a.use_lang, b.sid as dept_id, b.dept_code as dept_code_hide, b.dept_name as dept_name_tree,\n           a.login_times, a.create_date, a.last_login,a.status, a.sid as user_id_disp,a.valid_date\n           from wb_user a left join wb_dept b on a.dept_id=b.sid where 1=1`;\n  if (Params.searchUser) {\n    Wb.setLike('searchUser');\n    sql += ' and (a.user_name like {?searchUser?} or a.display_name like {?searchUser?} or a.sid like {?searchUser?})';\n  }\n  if (Params.deptId) {\n    sql += ` and a.dept_id in (SELECT sid\n                               FROM   wb_dept\n                               START WITH sid={?deptId?} \n                               CONNECT BY PRIOR sid = parent_id) `\n  }\n  sql += Wb.getOrderSql({ dept_name_tree: 'b.dept_name', user_id_disp: 'a.sid', $: 'a' });\n  Wb.sendDict(sql, 'wb,');//运行SQL语句，并获取经过字典处理后的首个结果集的记录、列和元数据并发送到客户端\n}\nmain();"},"_icon":"module"}