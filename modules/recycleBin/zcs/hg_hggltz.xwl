{"title":"合规管理通知","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module"},"_icon":"module","_expanded":true,"events":{"initialize":"Wb.apply(app, {\n  processDeptData(data) {\n    if (data != -1 && data.length != 0) {\n      const arr = data.map(item => {\n        return item.sid;\n      })\n      return arr.join(',');\n    }\n  },\n  processRoleData(data) {\n    const roles = [];\n    if (data) {\n      data.forEach(item => {\n        roles.push(item.role_id);\n      })\n    }\n    return roles.join(',');\n  },\n  createArr(value1, value2, flag) {\n    if (value1 && value2) {\n      const value1Arr = value1.split(',');\n      const value2Arr = value2.split(',');\n      const newArr = [];\n      for (let i = 0; i < value1Arr.length; i++) {\n        if (flag == 'role') {\n          newArr.push({ role_name: value1Arr[i], role_id: value2Arr[i] })\n        } else if (flag == 'dept') {\n          newArr.push({ text: value1Arr[i], sid: value2Arr[i] })\n        }\n      }\n    console.log(newArr, \"新数组\");\n    return newArr;\n    }\n  }\n});"},"items":[{"_icon":"window","text":"addNotice","cls":"Wb.Window","_expanded":true,"properties":{"cid":"addNotice","dialog":"false","height":"500","width":"880","buttonAlign":"center","modal":"true"},"events":{"close":"Wb.reset(app.addNotice);\napp.addNoticeContent.setValue('');"},"items":[{"_icon":"container","text":"modalForm","cls":"Wb.Container","properties":{"cid":"modalForm","layout":"grid2"},"_expanded":true,"items":[{"_icon":"text","text":"addNoticeTitle","cls":"Wb.Text","properties":{"cid":"addNoticeTitle","text":"通知标题","labelWidth":"100","required":"true","width":"360"},"hasDupCid":0,"_expanded":false},{"_icon":"combo","text":"addDepartment","cls":"Gt.OrgSelect","properties":{"cid":"addDepartment","labelWidth":"100","tagWrap":"false","text":"可见部门","textField":"text","url":"m?xwl=COMMON/select","valueField":"sid","width":"360","multiSelect":"true"},"hasDupCid":0},{"_icon":"combo","text":"addRole","cls":"Wb.Select","_expanded":true,"properties":{"cid":"addRole","labelWidth":"100","multiSelect":"true","text":"可见角色","textField":"role_name","url":"@xpath+'/operation/selectRole'","valueField":"role_id","width":"360"}},{"_icon":"combo","text":"addRange","cls":"Wb.Select","_expanded":true,"properties":{"cid":"addRange","labelWidth":"100","multiSelect":"false","text":"可见范围","width":"360","keyName":"notice_range","autoLoad":"all"}},{"_icon":"calendar","text":"addBeginDate","cls":"Wb.Date","properties":{"cid":"addBeginDate","format":"yyyyMMdd","text":"开始日期","labelWidth":"100","width":"360"}},{"_icon":"calendar","text":"addEndDate","cls":"Wb.Date","_expanded":true,"properties":{"cid":"addEndDate","format":"yyyyMMdd","text":"结束日期","labelWidth":"100","width":"360"}},{"_icon":"number-edit","text":"addOrderIndex","cls":"Wb.Number","properties":{"cid":"addOrderIndex","width":"360","labelWidth":"100","text":"排序"}}]},{"_icon":"file-html","text":"addNoticeContent","cls":"Wb.HtmlEditor","properties":{"cid":"addNoticeContent","text":"通知内容","required":"true","width":"90%","height":"150","margin":"0px 0px 0px 25px"}},{"_icon":"container","text":"container1","cls":"Wb.Container","properties":{"cid":"container1","layout":"row","margin":"20px auto"},"_expanded":true,"hasDupCid":1,"items":[{"_icon":"button","text":"ok","cls":"Wb.Button","properties":{"cid":"ok","text":"提交","width":"80","background":"rgb(33, 81, 209)","type":"primary","border":"false","margin":"right"},"events":{"click":"let addNoticeTitle = app.addNoticeTitle.getValue();\nlet addDepartment = app.processDeptData(app.addDepartment.getValue());\nlet addRole = app.processRoleData(app.addRole.getValue());\nlet addRange = app.addRange.getValue();\nlet addBeginDate = app.addBeginDate.lastInputValue;\nlet addEndDate = app.addEndDate.lastInputValue;\nlet addOrderIndex = app.addOrderIndex.getValue();\nlet addNoticeContent = app.addNoticeContent.getValue();\nconsole.log(app.addDepartment.getValue(), app.addRole.getValue(), \"值\")\nif (app.flag == 'add') {\n  Wb.ajax({\n    url: xpath + '/perm_conf/add',\n    params: {\n      addNoticeTitle,\n      addDepartment,\n      addRole,\n      addRange,\n      addBeginDate,\n      addEndDate,\n      addNoticeContent,\n      addOrderIndex\n    },\n    success(resp) {\n      console.log(resp, \"响应数据\");\n      let temp = JSON.parse(resp);\n      if (temp.returnCode == '-1') {\n        Wb.error(temp.returnMsg);\n      } else {\n        Wb.succ('新增成功！');\n        app.mainGrid.load();\n      }\n    }\n  });\n} else if (app.flag == 'edit') {\n  let pk_id = app.selectData.pk_id;\n  Wb.ajax({\n    url: xpath + '/perm_conf/eidt',\n    params: {\n      pk_id,\n      addNoticeTitle,\n      addDepartment,\n      addRole,\n      addRange,\n      addBeginDate,\n      addEndDate,\n      addNoticeContent,\n      addOrderIndex\n    },\n    success(resp) {\n      let temp = JSON.parse(resp);\n      if (temp.returnCode == '-1') {\n        Wb.error(temp.returnMsg);\n      } else {\n        Wb.succ('编辑成功！');\n        app.mainGrid.load();\n      }\n    }\n  });\n}\napp.addNotice.close();\nWb.reset(app.modalForm);\napp.addNoticeContent.setValue('');"},"hasDupCid":0},{"_icon":"button","text":"back","cls":"Wb.Button","properties":{"cid":"back","text":"返回","width":"80"},"events":{"click":"Wb.reset(app.modalForm);\napp.addNoticeContent.setValue('');\napp.addNotice.close();"},"hasDupCid":0}]}]},{"_icon":"viewport","text":"viewport1","cls":"Wb.Viewport","properties":{"cid":"viewport1","background":"#fbfbfb"},"_expanded":true,"items":[{"_icon":"container","text":"formCt","cls":"Wb.Container","properties":{"cid":"formCt","layout":"grid4","style":"border-radius: 5px; box-shadow: 0px 2px 9px 0px #0000002b;","margin":"10px 20px 10px 20px"},"_expanded":true,"items":[{"_icon":"model","text":"controlCt","cls":"Wb.ControlCt","properties":{"cid":"controlCt","text":"日期","labelWidth":"50","width":"400"},"_expanded":true,"items":[{"_icon":"calendar","text":"beg