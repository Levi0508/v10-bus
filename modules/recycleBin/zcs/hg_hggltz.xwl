'新增合规通知';"}},{"_icon":"button","text":"edit","cls":"Wb.Button","_expanded":true,"properties":{"cid":"edit","type":"primary","text":"编辑","icon":"edit","background":"rgb(33, 81, 209)","border":"false","margin":"right"},"hasDupCid":0,"events":{"click":"if (app.selectData) {\n  app.addNotice.show();\n  app.addNotice.title = '编辑合规通知';\n  app.flag = 'edit';\n  \n  app.addNoticeTitle.setValue(app.selectData.notice_title);\n  // app.addDepartment.setValue(app.selectData.visible_dept);\n  app.addDepartment.setValue(app.createArr(app.selectData.visible_dept_name, app.selectData.visible_dept, 'dept'));\n  // app.addRole.setValue(app.selectData.visible_roles);\n  app.addRole.setValue(app.createArr(app.selectData.visible_role_name, app.selectData.visible_roles, 'role'));\n  // app.addRole.setValue([{role_name: 'admin', role_id: 'admin'}]);\n  app.addRange.setValue(app.selectData.visible_range);\n  app.addBeginDate.setValue(app.selectData.begin_date);\n  app.addEndDate.setValue(app.selectData.end_date);\n  app.addNoticeContent.setValue(app.selectData.notic_content);\n  app.addOrderIndex.setValue(app.selectData.order_index);\n} else {\n  Wb.tip('请选择一条数据');\n}\n"}},{"_icon":"button","text":"delete","cls":"Wb.Button","_expanded":true,"properties":{"cid":"delete","type":"primary","text":"删除","icon":"delete","border":"false","background":"rgb(33, 81, 209)"},"hasDupCid":0,"events":{"click":"if (app.selectData) {\n  Wb.ajax({\n    url: xpath + '/perm_conf/del',\n    params: { pk_id: app.selectData.pk_id },\n    success(resp) {\n      app.mainGrid.load();\n    }\n  });\n} else {\n  Wb.tip('请选择一条数据');\n}\n"}}]},{"_icon":"grid","text":"mainGrid","cls":"Wb.Grid","properties":{"cid":"mainGrid","url":"@xpath + '/perm_conf/select'","flex":"1","margin":"20px","height":"85%"},"_expanded":true,"hasDupCid":0,"events":{"itemclick":"app.selectData = {};\napp.selectData = item.data$;"},"items":[{"_icon":"array","text":"columns","cls":"Wb.Array","properties":{"cid":"columns"},"_expanded":false,"hasDup