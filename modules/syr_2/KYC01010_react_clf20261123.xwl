{
  "title": "反洗钱客户填报(react专用)",
  "icon": "",
  "img": "",
  "tags": "",
  "hideInMenu": "false",
  "text": "module",
  "cls": "Wb.Module",
  "properties": {
    "cid": "module",
    "links": "[\"wb/custom-made/vue/vue.js\",\"wb/custom-made/vue/element.js\",\"wb/custom-made/vue/element.css\"]",
    "serverScript": "const action = Wb.get('ACTION');\nif (action === 'find_institution_draft' || action === 'takeover_customer') {\n  if (String(request.getMethod()) !== 'POST' || String(request.getHeader('X-Requested-With')) !== 'XMLHttpRequest') {\n    Wb.accessDenied();\n  }\n  Wb.permitRole(['fxq_cust_wh', 'fxqtb-th', 'fxqgl'], '当前用户无反洗钱客户填报权限');\n  const institutionDrafts = `\n      from thjs.t_th_client_info_dft d\n      join thjs.t_th_client_dft_ver v on v.ver_id = d.ver_id\n     where v.dft_status in ('0', '1', '2')\n       and v.ver_no = (select max(v2.ver_no) from thjs.t_th_client_dft_ver v2 where v2.client_id = v.client_id)\n       and d.client_belong = '1'\n       and d.organ_flag = '1'`;\n  if (action === 'find_institution_draft') {\n    const clientName = String(Wb.get('CLIENT_NAME') || '').trim();\n    if (!clientName) {\n      Wb.send({ O_RETURN_CODE: -1, O_RETURN_MSG: '缺少客户名称，请重新检索' });\n      return;\n    }\n    const items = Wb.getRows({\n      sql: `select d.client_id, d.client_name, d.organ_flag, d.id_no, d.client_status,\n                   d.client_belong, d.data_status, v.dft_status, '0' as fk_flag\n             ${institutionDrafts}\n               and (d.client_name = {?client_name?} or d.id_no = {?id_no?})\n             order by d.client_id`,\n      params: { client_name: clientName, id_no: String(Wb.get('ID_NO') || '').trim() || null },\n      contextParams: false\n    });\n    Wb.send({ O_RETURN_CODE: 0, items: items });\n    return;\n  }\n\n  const username = String(Wb.username || '');\n  const clientId = String(Wb.get('CLIENT_ID') || '').trim();\n  if (!username || !/^\\d+$/.test(clientId)) {\n    Wb.send({ O_RETURN_CODE: -1, O_RETURN_MSG: '缺少登录用户或客户号，请重新检索' });\n    return;\n  }\n  const client = Wb.getRow({\n    sql: \"select client_id from thjs.t_th_client_info where client_id = {?client_id?} and client_belong = '1'\",\n    params: { client_id: clientId }, contextParams: false\n  });\n  if (client) {\n    Wb.send(Wb.sql({\n      sql: '{call thjs.p_fxq_cust_operator_s({?client_id?},{?new_maintainer?},{?update_user?},{*O_RETURN_MSG*},{*O_RETURN_CODE*})}',\n      params: { client_id: clientId, new_maintainer: username, update_user: username }, contextParams: false\n    }));\n    return;\n  }\n\n  const updated = Wb.sql({\n    sql: `update thjs.t_maintainer_info\n             set maintainer = new_maintainer, new_maintainer = {?username?},\n                 update_user = {?username?}, update_time = sysdate\n           where client_id = {?client_id?} and exists (\n                 select 1 ${institutionDrafts} and d.client_id = {?client_id?})`,\n    params: { client_id: clientId, username: username }, contextParams: false\n  });\n  Wb.send(Number(updated) > 0\n    ? { O_RETURN_CODE: 0 }\n    : { O_RETURN_CODE: -1, O_RETURN_MSG: '未查询到可接管的客户草稿及其维护人，请重新检索' });\n}"
  },
  "_icon": "module",
  "_expanded": true,
  "items": [
    {
      "_icon": "viewport",
      "text": "viewport1",
      "cls": "Wb.Viewport",
      "properties": {
        "cid": "viewport1",
        "layout": "middle"
      },
      "_expanded": true,
      "events": {
        "keydown": "if (e.keyCode == '13') {\n  app.seekBtn.fireClick()\n}"
      },
      "items": [
        {
          "_icon": "panel",
          "text": "panel1",
          "cls": "Wb.Panel",
          "properties": {
            "cid": "panel1",
            "layout": "vcenter",
            "padding": "20"
          },
          "_expanded": true,
          "hasDupCid": 0,
          "items": [
            {
              "_icon": "label",
              "text": "label1",
              "cls": "Wb.Label",
              "properties": {
                "cid": "label1",
                "html": "<div style=\"font-size:15px;font-weight:bold;\">请输入完整的<font color=\"red\">【公司名称】</font>或者<font color=\"red\">【统一社会信用代码】</font>进行检索，如名称中含有括号的请使用<font color=\"red\">【全角】</font>，点击右侧搜索按钮进行模糊匹配</div>",
                "alignSelf": "start",
                "padding": "0 0 0 10px",
                "visible": "false"
              },
              "_expanded": true,
              "hasDupCid": 1
            },
            {
              "_icon": "container",
              "text": "container1",
              "cls": "Wb.Container",
              "properties": {
                "cid": "container1",
                "layout": "form-compact",
                "gap": "0"
              },
              "_expanded": true,
              "hasDupCid": 0,
              "items": [
                {
                  "_icon": "container",
                  "text": "container2",
                  "cls": "Wb.Container",
                  "properties": {
                    "cid": "container2",
                    "padding": "0 10px 0 0"
                  },
                  "events": {
                    "ready": "let comp = this;\ncomp.vue = new Vue({\n  el: comp.el.addEl(),\n  template: `\n<div>\n  <div style=\"font-size:15px;font-weight:bold;width:1000px;\" v-if=\"organ_flag==='1'\">\n    请输入完整的<font color=\"red\">【公司名称】</font>或者<font color=\"red\">【统一社会信用代码】</font>进行检索，如名称中含有括号的请使用<font color=\"red\">【全角】</font>，点击右侧搜索按钮进行模糊匹配\n  </div>\n  <div style=\"font-size:15px;font-weight:bold;width:1000px;\" v-if=\"organ_flag==='0'\">\n    请输入完整的<font color=\"red\">【客户名称】</font>进行检索，如名称中含有括号的请使用<font color=\"red\">【全角】</font>\n  </div>\n  \n  <div style=\"margin-top: 15px; position: relative;\">\n    <el-autocomplete\n      ref=\"autoComplete\"\n      v-model=\"query\"\n      :fetch-suggestions=\"querySearch\"\n      :placeholder=\"placeholder\"\n      class=\"input-with-select\"\n      style=\"width: 100%;\"\n      @select=\"handleSelect\"\n      @keydown.native=\"handleKeydown\"\n    >\n      <el-select \n        v-model=\"organ_flag\" \n        slot=\"prepend\" \n        placeholder=\"请选择\" \n        style=\"width:100px\" \n        @change=\"handleChange\"\n      >\n        <el-option label=\"机构\" value=\"1\"></el-option>\n        <el-option label=\"自然人\" value=\"0\"></el-option>\n      </el-select>\n      \n      <el-button slot=\"append\" icon=\"el-icon-search\" @click=\"handleSearch(query)\"></el-button>\n    </el-autocomplete>\n  </div>\n</div>\n`,\n  data() {\n    return {\n      organ_flag: '1',\n      placeholder: '请输入完整的【公司名称】或者【统一社会信用代码】进行检索，如名称中含有括号的请使用【全角】',\n      query: '',\n      suggestions: [],\n      nameArr: []\n    };\n  },\n  methods: {\n    halfToFullWidth(str) {\n      return str.replace(/[()]/g, function (c) {\n        return String.fromCharCode(c.charCodeAt(0) + 0xFEE0);\n      });\n    },\n    maskIdNo(idNo) {\n      if (!idNo || typeof idNo !== 'string') { return idNo; }\n      const len = idNo.length;\n      let maskCount = 0;\n      let keepLength = 0;\n      if (len > 6) { maskCount = 6; keepLength = len - maskCount; }\n      else { maskCount = 4; keepLength = Math.max(0, len - maskCount); }\n      const stars = '*'.repeat(maskCount);\n      const prefix = idNo.slice(0, keepLength);\n      return prefix + stars;\n    },\n    handleChange(val) {\n      if (val === '1') {\n        this.placeholder = '请输入完整的【公司名称】或者【统一社会信用代码】进行检索，如名称中含有括号的请使用【全角】';\n      } else {\n        this.placeholder = '请输入完整的【客户姓名】进行检索，如名称中含有括号的请使用【全角】';\n      }\n      this.suggestions = [];\n    },\n\n    querySearch(queryString, cb) {\n      cb(this.suggestions);\n    },\n\n    openReactForm(route, title, params) {\n      // 与「我填报的反洗钱客户」联调入口使用同一个 React 开发服务。\n      const reactBase = 'https://localhost:3002/#';\n      const query = Object.keys(params).filter(key => params[key] != null)\n        .map(key => encodeURIComponent(key) + '=' + encodeURIComponent(params[key])).join('&');\n      const url = reactBase + route + (query ? '?' + query : '');\n      const tab = Globals.WbMainTab;\n      if (!tab) return Boolean(window.open(url, '_blank'));\n      const card = tab.insertAfter({ icon: 'module', title: title, path: ':', layout: 'fit', ksV10Page: true }, tab.activeCard);\n      card.el.innerHTML = '<iframe class=\"w-iframe\"></iframe>';\n      const iframe = card.el.firstChild;\n      let guarded = false;\n      const beforeClose = () => {\n        iframe.contentWindow.postMessage({ type: 'ks-v10:check-close' }, '*');\n        return false;\n      };\n      const onMessage = e => {\n        if (e.source !== iframe.contentWindow) return;\n        const data = e.data;\n        if (data?.type === 'ks-v10:guard-close') {\n          if (data.enabled && !guarded) {\n            card.on('beforeclose', beforeClose);\n            guarded = true;\n          } else if (!data.enabled && guarded) {\n            card.un('beforeclose', beforeClose);\n            guarded = false;\n          }\n          e.source.postMessage({ type: data.type + 'ed', id: data.id }, '*');\n        } else if (data?.type === 'ks-v10:close') {\n          card.close();\n        }\n      };\n      window.addEventListener('message', onMessage);\n      card.on('destroy', () => window.removeEventListener('message', onMessage));\n      iframe.src = url;\n      card.show();\n      return true;\n    },\n\n    openCustomerMaintenance(client) {\n      return this.openReactForm('/aml/client_edit', '客户基本信息维护', {\n        CLIENT_ID: client.client_id, CLIENT_NAME: client.client_name, ORGAN_FLAG: client.organ_flag,\n        CLIENT_STATUS: client.client_status, CLIENT_BELONG: client.client_belong,\n        FK_FLAG: client.fk_flag, DATA_TYPE: client.data_status\n      });\n    },\n\n    confirmCustomerTakeover(rows, allowSameNameAdd) {\n      const that = this;\n      const selectedType = String(this.organ_flag);\n      const clients = Array.from(new Map(rows.filter(item => String(item.organ_flag) === selectedType)\n        .map(item => [String(item.client_id), item])).values());\n      if (!clients.length) {\n        Wb.tipError('未查询到当前客户类型的记录，请切换客户类型后重新检索');\n        return;\n      }\n      const encode = value => String(value == null ? '' : value).replace(/[&<>\"']/g, ch =>\n        ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' })[ch]);\n      const options = clients.map((client, index) => {\n        const label = encode(client.client_name) + (client.dft_status == null ? '' : '（已有草稿）') +\n          '：' + encode(that.maskIdNo(client.id_no));\n        if (clients.length === 1) return '<div>' + label + '</div>';\n        return '<div style=\"margin:8px 0;\"><label><input type=\"radio\" name=\"syr2TakeoverClient\" value=\"' +\n          index + '\" style=\"margin-right:8px;\">' + label + '</label></div>';\n      }).join('');\n      const buttons = [{ text: '接管', type: 'primary', cid: 'takeover' }];\n      if (allowSameNameAdd) buttons.push({ text: '新增同名自然人', cid: 'add' });\n      buttons.push({ text: '取消', cid: 'cancel' });\n      let takingOver = false;\n      Wb.Window.showMessage({\n        title: '确认接管客户', icon: 'help1', name: 'sys.dialog', buttons: buttons,\n        html: '客户已存在，是否接管？接管后您将成为该客户的维护人。' +\n          '<div style=\"color:#888;padding:12px 0;\">' + options + '</div>',\n        callback(btn) {\n          if (takingOver) return false;\n          if (btn === 'add') {\n            Wb.ajax({\n              url: 'm?xwl=aml_monitor/KYC01010/new_client_id',\n              success(resp) {\n                app.ORGAN_FLAG.setValue(0);\n                app.FK_FLAG.setValue(clients[0].fk_flag);\n                app.CLIENT_ID.setValue(Wb.decode(resp).items[0].v_client_id);\n                app.CLIENT_NAME.setValue(clients[0].client_name);\n                app.addWin.show();\n              }\n            });\n          } else if (btn === 'takeover') {\n            const radio = document.querySelector('input[name=\"syr2TakeoverClient\"]:checked');\n            const client = clients.length === 1 ? clients[0] : (radio && clients[Number(radio.value)]);\n            if (!client) {\n              Wb.tipError('请选择一条要接管的客户记录');\n              return false;\n            }\n            const dialog = this;\n            takingOver = true;\n            Wb.ajax({\n              url: 'm?xwl=syr_2/KYC01010_react_clf20261123', method: 'POST', json: true,\n              params: { ACTION: 'takeover_customer', CLIENT_ID: client.client_id },\n              success(result) {\n                takingOver = false;\n                if (String(result.O_RETURN_CODE) !== '0') {\n                  Wb.tipError(result.O_RETURN_MSG || '接管客户失败');\n                  return;\n                }\n                dialog.close();\n                Wb.tipSucc('已接管客户');\n                that.openCustomerMaintenance(client);\n              },\n              failure() { takingOver = false; }\n            });\n            return false;\n          }\n          this.close();\n        }\n      });\n    },\n\n    handleSearch(query) {\n      let that = this;\n\n      if (!query) {\n        Wb.tipInfo(\"请输入检索内容\");\n        return;\n      }\n\n      // 机构查询\n      if (this.organ_flag === '1') {\n        let queryToFull = this.halfToFullWidth(query);\n\n        Wb.ajax({\n          url: 'm?xwl=aml_monitor/aml_interface/qcc_beneficiary_interface/fuzzySearch',\n          params: { SEARCH_KEY: queryToFull },\n          success(resp) {\n            let res = Wb.decode(resp).Result;\n\n            if (!res || res.length === 0) {\n              Wb.tipInfo(\"模糊匹配未查询到相关数据，请输入更详细内容\");\n              that.suggestions = [];\n              that.nameArr = [];\n              return;\n            }\n\n            // 2. 输入的不是完整内容 (需要展示下拉框)\n            let matchedItem = res.find(item => {\n              return item.Name === queryToFull || item.Name === query || item.CreditCode === queryToFull;\n            });\n\n            if (!matchedItem) {\n              that.nameArr = res.map(item => item.Name);\n              that.suggestions = that.nameArr.map(name => ({ value: name }));\n              that.$nextTick(() => {\n                const ac = that.$refs.autoComplete;\n                ac.suggestions = that.suggestions;\n                ac.dropdownVisible = true;\n                ac.focus();\n              })\n            }\n            // 3. 输入的是完整内容 (执行精确查询逻辑)\n            else {\n              let full_name = matchedItem.Name;\n              Wb.ajax({\n                url: 'm?xwl=aml_monitor/KYC01010/select',\n                params: {\n                  I_FULL_NAME: full_name,\n                  I_USER_ID: '_$sys.username$_'\n                },\n                success(resp) {\n                  console.log(\"resp\", Wb.decode(resp));\n                  let re = Wb.decode(resp).items;\n\n                  if (re[0] && re[0].user_flag == '0') {\n                    // case1 无查询权限\n                    Wb.error(\"当前用户无反洗钱客户填报权限，请联系合规管理员！\");\n                  } else if (re[0] && re[0].is_exists == '1') {\n                    // case2 客户已存在\n                    that.confirmCustomerTakeover(re, false);\n                  } else if (re[0] && re[0].is_exists == '0') {\n                    Wb.ajax({\n                      url: 'm?xwl=syr_2/KYC01010_react_clf20261123', method: 'POST', json: true,\n                      params: { ACTION: 'find_institution_draft', CLIENT_NAME: full_name, ID_NO: matchedItem.CreditCode || '' },\n                      success(result) {\n                        if (String(result.O_RETURN_CODE) !== '0') {\n                          Wb.tipError(result.O_RETURN_MSG || '查询客户草稿失败，请重试');\n                          return;\n                        }\n                        if (result.items.length) {\n                          that.confirmCustomerTakeover(result.items, false);\n                          return;\n                        }\n                        Wb.confirm(\"客户未填报，是否需要新增？\", function () {\n                          app.ORGAN_FLAG.setValue(1);\n                          app.FK_FLAG.setValue(re[0].fk_flag);\n                          app.CLIENT_ID.setValue(re[0].client_id);\n                          app.CLIENT_NAME.setValue(full_name);\n                          app.addWin.show();\n                        });\n                      }\n                    });\n                  }\n                  that.suggestions = []; // 选中后清空建议\n                }\n              });\n            }\n          }\n        });\n      }\n      // 自然人查询\n      else if (this.organ_flag === '0') {\n        Wb.ajax({\n          url: 'm?xwl=aml_monitor/KYC01010/select',\n          params: {\n            I_FULL_NAME: query,\n            I_USER_ID: '_$sys.username$_'\n          },\n          success(resp) {\n            let re = Wb.decode(resp).items;\n\n            if (re[0] && re[0].user_flag == '0') {\n              // case1 无查询权限\n              Wb.error(\"当前用户无反洗钱客户填报权限，请联系合规管理员！\");\n            } else if (re[0] && re[0].is_exists == '1') {\n              // case2 客户已存在\n              that.confirmCustomerTakeover(re, true);\n            } else if (re[0] && re[0].is_exists == '0') {\n              // case3 客户不存在\n              Wb.confirm(\"客户未填报，是否需要新增？\", function () {\n                app.FK_FLAG.setValue(re[0].fk_flag);\n                app.CLIENT_ID.setValue(re[0].client_id);\n                app.CLIENT_NAME.setValue(that.query);\n                app.ORGAN_FLAG.setValue(0);\n                app.addWin.show();\n              });\n            }\n          }\n        });\n      }\n    },\n    handleKeydown(event) {\n      if (event.key === 'Enter') {\n        event.preventDefault();\n        event.stopPropagation();\n        this.handleSearch(this.query);\n      }\n    },\n    handleSelect(item) {\n      console.log(\"选中了:\", item);\n      this.query = item.value;\n      this.handleSearch(item.value);\n    }\n  },\n  created: function () {\n    const today = new Date();\n    const year = today.getFullYear();\n    const month = String(today.getMonth() + 1).padStart(2, '0');\n    const day = String(today.getDate()).padStart(2, '0');\n  },\n});"
                  },
                  "_expanded": true
                }
              ]
            },
            {
              "_icon": "window",
              "text": "addWin",
              "cls": "Wb.Window",
              "_expanded": true,
              "properties": {
                "cid": "addWin",
                "title": "客户新增",
                "dialog": "true",
                "width": "500",
                "padding": "20"
              },
              "events": {
                "ok": "if (app.ORGAN_FLAG.value == -1 || app.ORGAN_FLAG.value == null) {\n  Wb.tipError(\"请选择客户类型！\");\n  return;\n}\n\nconst params = {\n  CLIENT_ID: app.CLIENT_ID.value,\n  CLIENT_NAME: app.CLIENT_NAME.value,\n  ORGAN_FLAG: app.ORGAN_FLAG.value,\n  CLIENT_BELONG: app.CLIENT_BELONG.value,\n  FK_FLAG: app.FK_FLAG.value,\n  CLIENT_STATUS: '0',// 首次添加默认正常\n};\nif (app.container2.vue.openReactForm('/aml/client_add', '填写客户信息', params)) {\n  app.addWin.hide();\n}"
              },
              "items": [
                {
                  "_icon": "radios",
                  "text": "ORGAN_FLAG",
                  "cls": "Wb.RadioGroup",
                  "properties": {
                    "cid": "ORGAN_FLAG",
                    "text": "客户类型",
                    "required": "true",
                    "padding": "10"
                  },
                  "events": {
                    "change": "console.log(app.ORGAN_FLAG.value);"
                  },
                  "_expanded": false,
                  "items": [
                    {
                      "_icon": "check2",
                      "text": "radio1",
                      "cls": "Wb.Radio",
                      "properties": {
                        "cid": "radio1",
                        "label": "自然人",
                        "required": "true"
                      },
                      "hasDupCid": 0,
                      "_expanded": true
                    },
                    {
                      "_icon": "check2",
                      "text": "radio2",
                      "cls": "Wb.Radio",
                      "properties": {
                        "cid": "radio2",
                        "label": "机构",
                        "required": "true"
                      },
                      "hasDupCid": 0,
                      "_expanded": true
                    }
                  ]
                },
                {
                  "_icon": "label",
                  "text": "label1",
                  "cls": "Wb.Label",
                  "properties": {
                    "cid": "label1",
                    "html": "<div style=\"color:#d75a4a;padding-left:105px;\">请确认客户类型是否准确，已填写类型后续无法修改</div>"
                  },
                  "hasDupCid": 1
                },
                {
                  "_icon": "radios",
                  "text": "CLIENT_BELONG",
                  "cls": "Wb.RadioGroup",
                  "properties": {
                    "cid": "CLIENT_BELONG",
                    "text": "客户归属",
                    "required": "true",
                    "padding": "10"
                  },
                  "events": {
                    "change": "console.log(app.CLIENT_BELONG.value);"
                  },
                  "_expanded": false,
                  "items": [
                    {
                      "_icon": "check2",
                      "text": "radio4",
                      "cls": "Wb.Radio",
                      "properties": {
                        "cid": "radio4",
                        "label": "融资端",
                        "value": "true"
                      },
                      "hasDupCid": 0
                    }
                  ]
                },
                {
                  "_icon": "text",
                  "text": "CLIENT_ID",
                  "cls": "Wb.Text",
                  "properties": {
                    "cid": "CLIENT_ID",
                    "text": "客户号（隐藏）",
                    "visible": "false",
                    "readonly": "true"
                  }
                },
                {
                  "_icon": "text",
                  "text": "CLIENT_NAME",
                  "cls": "Wb.Text",
                  "properties": {
                    "cid": "CLIENT_NAME",
                    "text": "客户名称（隐藏）",
                    "visible": "false",
                    "readonly": "true"
                  },
                  "_expanded": true
                },
                {
                  "_icon": "text",
                  "text": "FK_FLAG",
                  "cls": "Wb.Text",
                  "properties": {
                    "cid": "FK_FLAG",
                    "text": "是否具有风险核查页面查看权限（隐藏）",
                    "visible": "false",
                    "readonly": "true"
                  },
                  "_expanded": true
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
