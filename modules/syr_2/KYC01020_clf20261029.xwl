    {
      "_icon": "window",
      "text": "editWin",
      "cls": "Wb.Window",
      "_expanded": false,
      "properties": {
        "cid": "editWin",
        "title": "修改维护人",
        "dialog": "true",
        "width": "450",
        "padding": "20"
      },
      "events": {
        "ok": "Wb.ajax({\n  url: 'm?xwl=aml_monitor/KYC01030/edit',\n  params: {\n    NEW_MAINTAINER: app.I_NEW_MAINTAINER.value,\n    CLIENT_ID: app.I_CLIENT_ID.value\n  },\n  success(resp) {\n    let res = Wb.decode(resp);\n    console.log(\"res\", res);\n    if (res.O_RETURN_CODE == '0') {\n      app.editWin.hide();\n      Wb.tipSucc(\"修改成功\");\n      // 下发维护人变更流程\n      const client_ids_arr = app.I_CLIENT_ID.value.split(',');\n      const client_names_arr = app.I_CLIENT_NAME.value.split(',');\n      const organ_flag_arr = app.I_ORGAN_FLAG.value.split(',');\n\n      const client_arr = client_ids_arr.map((id, index) => ({\n        CLIENT_ID: id,\n        CLIENT_NAME: client_names_arr[index],\n        ORGAN_FLAG: organ_flag_arr[index]\n      }));\n      console.log(\"client_arr\", client_arr);\n      // 下发清单自查流程\n      // if ('_$sys.username$_' == 'chenhaiyang'||'_$sys.username$_'==='huangzhichang') {\n      var dealRequest = Wb.ajax({\n        url: 'm?xwl=aml_monitor/KYC01020/flow_request_deal1',\n        params: {\n          'x-flow-systemId': 'IBCM',//当前发送全连接流程类型\n          'x-userId': '_$sys.userid$_',//当前登录人id\n          'x-userName': '_$sys.username$_',//encodeURI('_$sys.username$_'),//当前登录人name\n          'url': 'http://10.116.131.13:8094/auto/submit',\n          'formDatas': client_arr,\n          \"todoTitle\": '维护人变更',// 工作台待办名称\n          \"sysGuid\": \"IBCM\",\n          \"flowCode\": \"IBCM004\",\n          \"templateName\": '维护人变更',// 待办表单打开后标题\n          \"flowVer\": \"1\",\n          \"nodeCode\": \"draft\",\n          \"applyTable\": \"T_TH_MAINTAIN_FLOW\",\n          \"candidates\": app.I_NEW_MAINTAINER_ID.value,// 项目负责人\n        },\n        success(resp) {\n          // if(resp.)\n          let res = Wb.decode(resp);\n          console.log(\"resp\", resp);\n          if (res.code === 0) {\n            Wb.tipSucc(\"成功发送【客户维护人变更】流程\");\n          } else {\n            Wb.tipError(res.msg);\n          }\n        },\n        //错误返回则删除数据\n        failure(resp) {\n          clearTimeout(timeoutId); // 成功响应时清除超时计时器\n        }\n      });\n      var timeoutId = setTimeout(function () {\n        // 如果存在 XMLHttpRequest 对象，则中止请求\n        if (dealRequest && typeof dealRequest.abort === 'function') {\n          dealRequest.abort();\n          console.log('请求超时');\n        }\n      }, 60000);\n      // }\n      app.grid1.reload();\n    } else {\n      Wb.tipError(\"修改失败：\" + rec.O_RETURN_MSG);\n    }\n  }\n});"
      },
      "items": [
        {
          "_icon": "text",
          "text": "I_CLIENT_ID",
          "cls": "Wb.Text",
          "properties": {
            "cid": "I_CLIENT_ID",
            "visible": "false",
            "text": "客户号"
          }
        },
        {
          "_icon": "text",
          "text": "I_ORGAN_FLAG",
          "cls": "Wb.Text",
          "properties": {
            "cid": "I_ORGAN_FLAG",
            "visible": "false",
            "text": "机构标识"
          }
        },
        {
          "_icon": "textarea",
          "text": "I_CLIENT_NAME",
          "cls": "Wb.TextArea",
          "properties": {
            "cid": "I_CLIENT_NAME",
            "text": "客户名称",
            "labelWidth": "100",
            "padding": "10",
            "readonly": "true"
          }
        },
        {
          "_icon": "text",
          "text": "I_MAINTAINER",
          "cls": "Wb.Text",
          "properties": {
            "cid": "I_MAINTAINER",
            "text": "原维护人",
            "padding": "10",
            "labelWidth": "100",
            "readonly": "true"
          },
          "_expanded": true
        },
        {
          "_icon": "text",
          "text": "I_NEW_MAINTAINER_ID",
          "cls": "Wb.Text",
          "properties": {
            "cid": "I_NEW_MAINTAINER_ID",
            "text": "新维护人user_id",
            "padding": "10",
            "labelWidth": "100",
            "readonly": "true",
            "visible": "false"
          },
          "_expanded": true
        },
        {
          "_icon": "combo",
          "text": "I_NEW_MAINTAINER",
          "cls": "Wb.Select",
          "properties": {
            "cid": "I_NEW_MAINTAINER",
            "text": "新维护人",
            "labelWidth": "100",
            "padding": "10",
            "required": "true",
            "valueField": "user_id",
            "textField": "textfield",
            "forceSelect": "true",
            "matchMode": "includesIC"
