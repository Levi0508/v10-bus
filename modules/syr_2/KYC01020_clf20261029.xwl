        {
          "_icon": "grid",
          "text": "grid1",
          "cls": "Wb.Grid",
          "properties": {
            "cid": "grid1",
            "pagingBar": "pageNums",
            "pageSize": "100",
            "full": "true",
            "border": "false",
            "url": "m?xwl=aml_monitor/KYC01020/select",
            "bindModule": "aml_monitor/KYC01020/select.xwl",
            "emptyHint": "true",
            "disabled": "false",
            "exportFilename": "反洗钱客户导出",
            "columnsSortable": "true",
            "textSelectable": "true",
            "sorters": "[{name:'update_time',desc:true}]",
            "clickSelect": "true",
            "fireSelected": "true",
            "stickSelect": "true",
            "editable": "true",
            "multiSelect": "false"
          },
          "_expanded": true,
          "events": {
            "itemdblclick": "let rec = app.grid1.selectionData;\n// 先查询用户是否有反馈结果页面查看权限\nWb.ajax({\n  url: 'm?xwl=aml_monitor/KYC01020/select_fk_flag',\n  params: {\n    I_USER_NAME: '_$sys.username$_'\n  },\n  success(resp) {\n    let res = Wb.decode(resp).items;\n    let fk_flag = res[0].fk_flag || '0';\n    Wb.open({\n      // url: 'm?xwl=aml_monitor/KYC01010/client_preview',\n      url: 'm?xwl=syr_2/client_preview_clf20261027',\n\n      // url: 'm?xwl=aml_monitor/KYC01010/client_edit',\n      params: {\n        CLIENT_ID: rec.client_id,//'_$client_id$_'\n        ORGAN_FLAG: rec.organ_flag,\n        CLIENT_STATUS: rec.client_status,\n        CLIENT_NAME: rec.client_name,\n        CLIENT_BELONG: rec.client_belong,\n        FK_FLAG: fk_flag,\n        DATA_TYPE: rec.data_type,\n        FLOW_CODE: '1'\n      },\n      title: '客户基本信息维护'\n    });\n  }\n})",
            "selectionchange": "// console.log(\"selection\", app.grid1.selectionData);\n// let checked = app.grid1.selectionData.checked || false;\n// app.grid1.selectionData.checked = !checked;\n// console.log(\"selection--checked\", app.grid1.selectionData.checked);\n// console.log(\"selectionsData\", app.grid1.selectionsData);\n\n// console.log(\"options\",app.grid1.options)",
            "itemclick": "console.log(\"item\",item);\n// row.addFooter({\n//   cname: 'toggle', returnType: 'int', value, toggleAlign: 'center', clickToggle: true,\n//   events: {\n//     change(value) {\n//       // If there is no need to synchronously update other fields, this is more efficient\n//       // row.data.checked = value; // only update checked field value\n//       row.set('checked', value); // update whole row\n//       app.checkCol1.syncHeaderCheck(); // manual sync header check of checkCol1\n//     }\n//   }\n// }, el);\n\n// let value = item.data.checked;\n// item.set('checked',value);\n// app.checkCol1.syncHeaderCheck();"
          },
          "items": [
            {
              "_icon": "toolbar",
              "text": "tbar",
