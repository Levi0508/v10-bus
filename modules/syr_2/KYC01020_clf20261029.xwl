                    "checkRefresh": "true",
                    "sortable": "false",
                    "headerCheck": "true",
                    "render": "let row = this;\nvalue = row.data.checked;\nrow.addFooter({\n  cname: 'check', returnType: 'int', value, toggleAlign: 'center', clickToggle: true,\n  events: {\n    change(value) {\n      console.log(\"row\",row)\n      // If there is no need to synchronously update other fields, this is more efficient\n      // row.data.checked = value; // only update checked field value\n      row.set('checked', value); // update whole row\n      row.selected = value === 1 ? true : false;\n      app.checkCol1.syncHeaderCheck(); // manual sync header check of checkCol1\n    }\n  }\n}, el);",
