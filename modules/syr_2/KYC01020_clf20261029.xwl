              "items": [
                {
                  "_icon": "button",
                  "text": "addBtn",
                  "cls": "Wb.Button",
                  "properties": {
                    "cid": "addBtn",
                    "text": "新建",
                    "roundBorder": "true",
                    "bindModule": "aml_monitor/KYC01020/buttons/add.xwl",
                    "style": "background-color:#5cbc85;color:#fff",
                    "icon": "add",
                    "iconColor": "#ffffff",
                    "height": "30px"
                  },
                  "hasDupCid": 0,
                  "events": {
                    "click": "Wb.open({\n  url: 'm?xwl=syr_2/KYC01010_clf20261026'\n});"
                  },
                  "_expanded": true
                },
                {
                  "_icon": "button",
                  "text": "editBtn",
                  "cls": "Wb.Button",
                  "properties": {
                    "cid": "editBtn",
                    "text": "修改",
                    "roundBorder": "true",
                    "bindModule": "aml_monitor/KYC01020/buttons/edit.xwl",
                    "style": "background-color:#f0ad4e;color:#fff",
                    "icon": "edit",
                    "iconColor": "#ffffff",
                    "height": "30px"
                  },
                  "events": {
                    "click": "if (!app.grid1.selection) {\n  Wb.info(\"请至少选中 1 条数据\");\n  return;\n}\nlet rec = app.grid1.selectionData;\nconsole.log(\"rec----\", rec.data_type);\n// 先查询用户是否有反馈结果页面查看权限\nWb.ajax({\n  url: 'm?xwl=aml_monitor/KYC01020/select_fk_flag',\n  params: {\n    I_USER_NAME: '_$sys.username$_'\n  },\n  success(resp) {\n    let res = Wb.decode(resp).items;\n    let fk_flag = res[0].fk_flag || '0';\n    Wb.open({\n      url: 'm?xwl=syr_2/client_edit_clf20261020',\n      params: {\n        CLIENT_ID: rec.client_id,//'_$client_id$_'\n        ORGAN_FLAG: rec.organ_flag,\n        CLIENT_STATUS: rec.client_status,\n        CLIENT_NAME: rec.client_name,\n        CLIENT_BELONG: rec.client_belong,\n        FK_FLAG: fk_flag,\n        DATA_TYPE: rec.data_type\n      },\n      title: '客户基本信息维护'\n    });\n  }\n})\n"
                  },
                  "_expanded": true,
                  "hasDupCid": 0
                },
                {
                  "_icon": "button",
                  "text": "invalidBtn",
                  "cls": "Wb.Button",
                  "properties": {
                    "cid": "invalidBtn",
                    "text": "失效",
                    "roundBorder": "true",
                    "bindModule": "aml_monitor/KYC01020/buttons/invalid.xwl",
                    "style": "background-color:#d9534f;color:#fff",
                    "icon": "delete",
                    "iconColor": "#ffffff",
                    "height": "30px"
                  },
                  "events": {
                    "click": "if (!app.grid1.selection) {\n  Wb.info(\"请选中 1 条数据\");\n  return;\n}\nlet rec = app.grid1.selectionData;\nif (rec.client_status === '1') {\n  Wb.tipError(\"该客户状态为已失效\");\n  return;\n}\nWb.ajax({\n  url: 'm?xwl=aml_monitor/KYC01020/select_client_proj',\n  params: {\n    I_CLIENT_ID: rec.client_id,\n    I_CLIENT_NAME: rec.client_name,\n    I_USER_NAME: '_$sys.username$_'\n  },\n  success(resp) {\n    let res = Wb.decode(resp).items;\n    console.log(\"res\", res);\n    let message = res[0].message;\n    if (message && message != '') {\n      Wb.info(\"<div style='max-width:800px;'>\"+message+\"</div>\", null, true);\n    } else {\n      Wb.confirm(\"确认将客户置为失效？\", function () {\n        Wb.ajax({\n          url: 'm?xwl=aml_monitor/KYC01020/update_client_status',\n          params: {\n            I_CLIENT_ID: rec.client_id,\n            I_OP_FLAG: '1',\n            I_USER_NAME: '_$sys.username$_'\n          },\n          success(resp) {\n            app.grid1.reload();\n            Wb.tipSucc(\"操作成功\");\n          }\n        });\n      });\n    }\n  }\n})"
                  },
                  "_expanded": true
                },
                {
                  "_icon": "button",
                  "text": "recoverBtn",
                  "cls": "Wb.Button",
                  "properties": {
                    "cid": "recoverBtn",
                    "text": "恢复",
                    "roundBorder": "true",
                    "bindModule": "aml_monitor/KYC01020/buttons/recover.xwl",
                    "style": "background-color:#337ab7;color:#fff",
                    "icon": "refresh",
                    "iconColor": "#ffffff",
                    "height": "30px"
                  },
                  "events": {
                    "click": "if (!app.grid1.selection) {\n  Wb.info(\"请选中 1 条数据\");\n  return;\n}\nlet rec = app.grid1.selectionData;\nif (rec.client_status !== '1') {\n  Wb.tipError(\"请选择状态为已失效的客户\");\n  return;\n}\n\nWb.ajax({\n  url: 'm?xwl=aml_monitor/KYC01020/update_client_status',\n  params: {\n    I_CLIENT_ID: rec.client_id,\n    I_OP_FLAG: '0',\n    I_USER_NAME: '_$sys.username$_'\n  },\n  success(resp) {\n    app.grid1.reload();\n    Wb.tipSucc(\"恢复成功\");\n  }\n});\n"
                  }
                },
                {
                  "_icon": "button",
                  "text": "apprBtn",
                  "cls": "Wb.Button",
                  "properties": {
                    "cid": "apprBtn",
                    "text": "审核",
                    "roundBorder": "true",
                    "bindModule": "aml_monitor/KYC01020/buttons/appr.xwl",
                    "style": "background-color:#f0ad4e;color:#fff",
                    "icon": "edit",
                    "iconColor": "#ffffff",
                    "height": "30px"
                  },
                  "events": {
                    "click": "// if (!app.grid1.selection) {\n//   Wb.info(\"请至少选中 1 条数据\");\n//   return;\n// }\n// let rec = app.grid1.selectionData;\n\n// console.log(\"rec\",rec);\n// // 先查询用户是否有反馈结果页面查看权限\n// Wb.ajax({\n//   url: 'm?xwl=aml_monitor/KYC01020/select_fk_flag',\n//   params: {\n//     I_USER_NAME: '_$sys.username$_'\n//   },\n//   success(resp) {\n//     let res = Wb.decode(resp).items;\n//     let fk_flag = res[0].fk_flag || '0';\n//     Wb.open({\n//       url: 'm?xwl=syr_2/client_appr_clf20261020',\n//       params: {\n//         CLIENT_ID: rec.client_id,//'_$client_id$_'\n//         ORGAN_FLAG: rec.organ_flag,\n//         CLIENT_STATUS: rec.client_status,\n//         CLIENT_NAME: rec.client_name,\n//         CLIENT_BELONG: rec.client_belong,\n//         MAINTAINER: rec.work_no, //最新维护人的work_no，（即wb_user表的user_id）全链接工作流接收候选人是这个参数\n//         FK_FLAG: fk_flag,\n//       },\n//       title: '客户信息详情'\n//     });\n//   }\n// });\n// 在门户中新开页签，用 iframe 打开 KS-v10 重构后的页面（与 React 里的 openPortalPage 一致）\n\n\n// const REACT_BASE = 'wb/ks/index.html#';\nconst REACT_BASE = 'https://localhost:3002/#';\nconst openReactPage = (route, title, params) => {\n  const query = Object.keys(params)\n    .filter(k => params[k] !== undefined && params[k] !== null)\n    .map(k => encodeURIComponent(k) + '=' + encodeURIComponent(params[k]))\n    .join('&');\n  const url = REACT_BASE + route + (query ? '?' + query : '');\n  const tab = Globals.WbMainTab;\n  if (!tab) {\n    window.open(url, '_blank');\n    return;\n  }\n  const card = tab.insertAfter({ icon: 'module', title: title, path: ':', layout: 'fit', ksV10Page: true }, tab.activeCard);\n  card.el.innerHTML = '<iframe class=\"w-iframe\"></iframe>';\n  card.el.firstChild.src = url;\n  card.show();\n};\n\nif (!app.grid1.selection) {\n  Wb.info(\"请至少选中 1 条数据\");\n  return;\n}\nlet rec = app.grid1.selectionData;\n// 先查询用户是否有反馈结果页面查看权限\nWb.ajax({\n  url: 'm?xwl=aml_monitor/KYC01020/select_fk_flag',\n  params: {\n    I_USER_NAME: '_$sys.username$_'\n  },\n  success(resp) {\n    let res = Wb.decode(resp).items;\n    let fk_flag = res[0].fk_flag || '0';\n    openReactPage('/aml/client_appr', '客户信息详情', {\n      CLIENT_ID: rec.client_id,\n      ORGAN_FLAG: rec.organ_flag,\n      CLIENT_STATUS: rec.client_status,\n      CLIENT_NAME: rec.client_name,\n      CLIENT_BELONG: rec.client_belong,\n      MAINTAINER: rec.work_no, //最新维护人的work_no，（即wb_user表的user_id）全链接工作流接收候选人是这个参数\n      FK_FLAG: fk_flag\n    });\n  }\n});\n"
                  },
                  "_expanded": false
                },
                {
                  "_icon": "item",
                  "text": "restrictiveBtn",
                  "cls": "Wb.Item",
                  "_expanded": false,
                  "properties": {
                    "cid": "restrictiveBtn",
                    "text": "限制措施",
                    "icon": "ellipsis",
                    "iconAlign": "right",
                    "roundBorder": "true",
                    "bindModule": "aml_monitor/KYC01020/buttons/restrictive.xwl",
                    "style": "background-color:#337ab7;color:#fff",
                    "iconColor": "#ffffff",
                    "height": "30px"
                  },
                  "hasDupCid": 0,
                  "items": [
                    {
                      "_icon": "menu2",
                      "text": "menu",
                      "cls": "Wb.Menu",
                      "properties": {
                        "cid": "menu",
                        "isProperty": "true"
                      },
                      "_expanded": true,
                      "hasDupCid": 0,
                      "items": [
                        {
                          "_icon": "item",
                          "text": "item1",
                          "cls": "Wb.Item",
                          "_expanded": true,
                          "properties": {
                            "cid": "item1",
                            "text": "强限制",
                            "bindModule": "aml_monitor/KYC01020/buttons/restrictive.xwl"
                          },
                          "hasDupCid": 0,
                          "events": {
                            "click": "if (!app.grid1.selection) {\n  Wb.info(\"请选中 1 条数据\");\n  return;\n}\nlet rec = app.grid1.selectionData;\nif (rec.client_status === '2') {\n  Wb.tipError(\"该客户状态为已限制\");\n  return;\n}\nWb.confirm(\"确认将客户置为限制状态？\", function () {\n  Wb.ajax({\n    url: 'm?xwl=aml_monitor/KYC01020/update_client_status',\n    params: {\n      I_CLIENT_ID: rec.client_id,\n      I_OP_FLAG: '2',\n      I_USER_NAME: '_$sys.username$_'\n    },\n    success(resp) {\n      app.grid1.reload();\n    }\n  });\n});"
                          }
                        },
                        {
                          "_icon": "item",
                          "text": "item2",
                          "cls": "Wb.Item",
                          "_expanded": true,
                          "properties": {
                            "cid": "item2",
                            "text": "弱限制",
                            "bindModule": "aml_monitor/KYC01020/buttons/restrictive.xwl"
                          },
                          "events": {
                            "click": "if (!app.grid1.selection) {\n  Wb.info(\"请选中 1 条数据\");\n  return;\n}\nlet rec = app.grid1.selectionData;\nif (rec.client_status === '2') {\n  Wb.tipError(\"该客户状态为已限制\");\n  return;\n}else if (rec.client_status === '3') {\n  Wb.tipError(\"该客户状态为弱限制\");\n  return;\n}\n\nWb.confirm(\"确认将客户置为弱限制状态？\", function () {\n  Wb.ajax({\n    url: 'm?xwl=aml_monitor/KYC01020/update_client_status',\n    params: {\n      I_CLIENT_ID: rec.client_id,\n      I_OP_FLAG: '3',\n      I_USER_NAME: '_$sys.username$_'\n    },\n    success(resp) {\n      app.grid1.reload();\n    }\n  });\n});"
                          }
                        },
                        {
                          "_icon": "item",
                          "text": "item3",
                          "cls": "Wb.Item",
                          "_expanded": true,
                          "properties": {
                            "cid": "item3",
                            "text": "解除限制",
                            "bindModule": "aml_monitor/KYC01020/buttons/restrictive.xwl"
                          },
                          "events": {
                            "click": "if (!app.grid1.selection) {\n  Wb.info(\"请选中 1 条数据\");\n  return;\n}\nlet rec = app.grid1.selectionData;\nif (rec.client_status !== '2' && rec.client_status !== '3') {\n  Wb.tipError(\"请选择状态为已限制的客户\");\n  return;\n}\n\n\nWb.ajax({\n  url: 'm?xwl=aml_monitor/KYC01020/update_client_status',\n  params: {\n    I_CLIENT_ID: rec.client_id,\n    I_OP_FLAG: '0',\n    I_USER_NAME: '_$sys.username$_'\n  },\n  success(resp) {\n    Wb.tipSucc(\"恢复成功\")\n    app.grid1.reload();\n  }\n});\n"
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "_icon": "button",
                  "text": "editBtn1",
                  "cls": "Wb.Button",
                  "properties": {
                    "cid": "editBtn1",
                    "text": "修改维护人",
                    "roundBorder": "true",
                    "style": "background-color:#f0ad4e;color:#fff",
                    "icon": "edit",
                    "iconColor": "#ffffff",
                    "height": "30px"
                  },
                  "events": {
                    "click": "let allData = app.grid1.data;\nconst checkedData = allData.filter(item=> item.checked ===1);\n\nconsole.log(\"checkedData\",checkedData);\n\nif (checkedData.length === 0) {\n  Wb.info(\"请至少选中 1 条数据\");\n  return;\n}\nconst maintianers = new Set(checkedData.map(item=>item.new_maintainer_id));\nif(maintianers.size>1){\n  Wb.info(\"请选择当前维护人相同的数据\");\n  return;\n}\n\nconst client_names = checkedData.map(item => item.client_name).join(',');\nconst client_ids = checkedData.map(item => item.client_id).join(',');\nconst organ_flags = checkedData.map(item => item.organ_flag).join(',');\n// console.log(\"selections\", app.grid1.data)\n// console.log(app.grid1.selectionData);\n// let rec = app.grid1.selectionData;\napp.I_CLIENT_ID.setValue(client_ids);\napp.I_ORGAN_FLAG.setValue(organ_flags);\napp.I_CLIENT_NAME.setValue(client_names);\napp.I_MAINTAINER.setValue(checkedData[0].new_maintainer);\napp.editWin.show();"
                  },
                  "hasDupCid": 0
                },
                {
                  "_icon": "button",
                  "text": "hisBtn",
                  "cls": "Wb.Button",
                  "properties": {
                    "cid": "hisBtn",
                    "text": "历史工作室信息",
                    "roundBorder": "true",
                    "height": "30px"
                  },
                  "events": {
                    "click": "if (!app.grid1.selection) {\n  Wb.info(\"请至少选中 1 条数据\");\n  return;\n}\nconsole.log(app.grid1.selectionData);\nlet rec = app.grid1.selectionData;\nconsole.log(\"rec-------\",rec)\nWb.open({\n  url: 'm?xwl=aml_monitor/KYC01020/his_proj_table',\n  params: {\n    CLIENT_ID: rec.client_id,\n    CLIENT_NAME: rec.client_name\n  },\n  success() {\n\n  }\n})"
                  },
                  "hasDupCid": 0
                },
                {
                  "_icon": "right1",
