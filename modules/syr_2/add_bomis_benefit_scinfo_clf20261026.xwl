{
  "title": "增加bomis受益人信息",
  "icon": "",
  "img": "",
  "tags": "",
  "hideInMenu": "true",
  "text": "module",
  "cls": "Wb.Module",
  "properties": {
    "cid": "module",
    "serverScript": "var benefit_scinfo = Wb.getObject('benefit_scinfo') || {};\nvar client_id = Wb.get('client_id') || '';\n\nvar rs = {\n  O_RETURN_CODE: 0,\n  O_RETURN_MSG: ''\n};\n\nif (!benefit_scinfo || !benefit_scinfo.related_name) {\n  rs.O_RETURN_CODE = -1;\n  rs.O_RETURN_MSG = '受益人数据不能为空，请重填';\n}\nif (client_id === '') {\n  rs.O_RETURN_CODE = -1;\n  rs.O_RETURN_MSG = '客户号不能为空，请重填';\n}\n\nif (rs.O_RETURN_CODE === 0) {\n  var dupSql = `\nselect related_name from thjs.T_TH_RELAT_INFO\n where client_id = {?client_id?} and related_type = '5' and related_name = {?related_name?}\nunion all\nselect related_name from thjs.T_TH_RELAT_INFO_tmp\n where client_id = {?client_id?} and related_type = '5' and related_name = {?related_name?}\n`;\n  var dupRs = Wb.getRowx({\n    sql: dupSql,\n    params: { client_id: client_id, related_name: benefit_scinfo.related_name }\n  });\n  if (dupRs.total > 0) {\n    rs.O_RETURN_CODE = -1;\n    rs.O_RETURN_MSG = '已存在主体名称为“' + benefit_scinfo.related_name + '”的【受益所有人】信息，请勿重复添加！';\n  }\n}\n\nif (rs.O_RETURN_CODE === -1) {\n  Wb.send(rs);\n} else {\n  var insertSqlData = [];\n  insertSqlData.push(benefit_scinfo);\n  insertSqlData.forEach(function (item) {\n    item.client_id = client_id;\n    function joinMulti(val) {\n      if (val === '' || val == null) {\n        return '';\n      }\n      if (Array.isArray(val)) {\n        return val.join(',');\n      }\n      return String(val);\n    }\n    item.bnf_type = joinMulti(item.bnf_type);\n    item.actctrltype = joinMulti(item.actctrltype);\n    item.seniormgrpos = joinMulti(item.seniormgrpos);\n    item.seniormgrposcn = joinMulti(item.seniormgrposcn);\n    if (item.bnf_type && item.bnf_type.indexOf('NI') >= 0) {\n      item.seniormgrpos = '10';\n    }\n  });\n\n  var insertSql = `\ninsert into thjs.T_TH_RELAT_INFO_tmp(client_id, related_type, organ_flag, related_name, nationality, id_type, id_no, id_begindate, id_enddate, birthday, shareholding_ratio, beneficiary, address, is_government_dept, object_id, create_user, create_time, update_user, update_time, related_key, data_status, gender, mobno1, mobno2, actctrl, acthdrat, shareratiostartdate, shareratioenddate, actctrlcpny, actctrltype, obtainactdate, terminationactdate, actotherforms, actconuppermarket, actconupperentname, actconuniscid, pribenfit, actownerprofitratio, profitratiostartdate, profitratioenddate, actownerprofitratiovote, profitratiovotestartdate, profitratiovoteenddate, seniormgr, seniormgrpos, actdailymgmtpostother, seniormgrcn, seniormgrposcn, ownerrightmgmtpostother, bnf_type, bo_type, company_type, full_info_flag)\nvalues({?client_id?}, '5', {?organ_flag?}, {?related_name?}, {?nationality?}, {?id_type?}, {?id_no?}, {?id_begindate?}, {?id_enddate?}, {?birthday?}, {?shareholding_ratio?}, {?beneficiary?}, {?address?}, {?is_government_dept?}, {?object_id?}, {?create_user?}, {?create_time?}, {?update_user?}, {?update_time?}, {?related_key?}, {?data_status?}, {?gender?}, {?mobno1?}, {?mobno2?}, {?actctrl?}, {?acthdrat?}, {?shareratiostartdate?}, {?shareratioenddate?}, {?actctrlcpny?}, {?actctrltype?}, {?obtainactdate?}, {?terminationactdate?}, {?actotherforms?}, {?actconuppermarket?}, {?actconupperentname?}, {?actconuniscid?}, {?pribenfit?}, {?actownerprofitratio?}, {?profitratiostartdate?}, {?profitratioenddate?}, {?actownerprofitratiovote?}, {?profitratiovotestartdate?}, {?profitratiovoteenddate?}, {?seniormgr?}, {?seniormgrpos?}, {?actdailymgmtpostother?}, {?seniormgrcn?}, {?seniormgrposcn?}, {?ownerrightmgmtpostother?}, {?bnf_type?}, {?bo_type?}, {?company_type?}, {?full_info_flag?})\n`;\n\n  var conn;\n  try {\n    conn = Wb.getConn();\n    Wb.sql({\n      sql: insertSql,\n      params: insertSqlData,\n      trans: true,\n      commit: false\n    });\n    conn.commit();\n    rs.O_RETURN_MSG = '执行成功';\n  } catch (e) {\n    rs.O_RETURN_CODE = -1;\n    rs.O_RETURN_MSG = '保存失败：' + e;\n    if (conn) {\n      conn.rollback();\n    }\n  } finally {\n    if (conn) {\n      conn.close();\n    }\n    Wb.send(rs);\n  }\n}"
  },
  "_icon": "module",
  "items": []
}