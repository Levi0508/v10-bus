{
  "title": "客户信息填报",
  "icon": "",
  "img": "",
  "tags": "",
  "hideInMenu": "true",
  "text": "module",
  "cls": "Wb.Module",
  "properties": {
    "cid": "module",
    "links": "[\n  \"wb/custom-made/js/prs01.js\"\n]"
  },
  "_icon": "module",
  "_expanded": true,
  "events": {
    "initialize": "let rules = getRules();\nlet forms = getRuleForm();\nlet directory = getDirConfig();\nlet selectKey = getSelectKey();\n// 定义全局变量\nlet data = {\n  rules: rules,// 表单校验规则\n  forms: forms,// 表单\n  list: selectKey.list,\n  dict: selectKey.dict,\n  directory: directory,// 附件目录\n  selectList: {},\n  organList: [],//机构主体列表\n  personList: [],//自然人主体列表\n  fileDialogVisible: false,\n  client_id: '_$client_id$_',\n  nextStep: false\n}\n\nWb.apply(app, {\n  data: data,\n  loadSelectList(item) {\n    if (!Wb.isEmpty(item.KEY_NAME)) {\n      Wb.ajax({\n        url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/select_key',\n        params: {\n          I_KEY_NAME: item.KEY_NAME\n        },\n        success(resp) {\n          let arr = Wb.decode(resp).items;\n          app.data.selectList[item.BIND_DATA + \"_list\"] = arr;\n        }\n      });\n    }\n  },\n  getDictMap(item) {\n    Wb.ajax({\n      url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/select_dict',\n      params: {\n        I_ENTRY_NO: item.ENTRY_NO\n      },\n      success(resp) {\n        let arr = Wb.decode(resp).items;\n        app.data.selectList[item.BIND_DATA + \"_list\"] = arr;\n      }\n    })\n  },\n  formatAddress(dict, key) {\n    const item = dict.find(item => item.value === key);\n    return item ? item.label : key;\n  },\n  formatMoneyType(dict, key) {\n    const item = dict.find(item => item.k === key);\n    return item ? item.v : '-';\n  },\n  createClientId() {\n    Wb.ajax({\n      url: 'm?xwl=aml_monitor/KYC01010/new_client_id',\n      params: {},\n      success(resp) {\n        let new_client_id = Wb.decode(resp).items[0].v_client_id;\n        app.data.client_id = new_client_id;\n      }\n    })\n  }\n});\n\n"
  },
  "items": [
    {
      "_icon": "viewport",
      "text": "viewport1",
      "cls": "Wb.Viewport",
      "properties": {
        "cid": "viewport1"
      },
      "_expanded": true,
      "events": {
        "ready": "if(!app.data.client_id){\n  app.createClientId();\n}\napp.data.list.forEach(item => {\n  app.loadSelectList(item);\n});\n\napp.data.dict.forEach(item => {\n  app.getDictMap(item);\n});\n"
      },
      "items": [
        {
          "_icon": "tab",
          "text": "tab1",
          "cls": "Wb.Tab",
          "_expanded": true,
          "properties": {
            "cid": "tab1",
            "full": "true",
            "border": "false",
            "tabPosition": "top",
            "tabSortable": "false",
            "cls": "tabcls"
          },
          "items": [
            {
              "_icon": "card",
              "text": "card1",
              "cls": "Wb.Card",
              "properties": {
                "cid": "card1",
                "title": "相关主体维护",
                "closable": "null",
                "layout": "column"
              },
              "_expanded": true,
              "hasDupCid": 0,
              "items": [
                {
                  "_icon": "toolbar",
                  "text": "tbar",
                  "cls": "Wb.Toolbar",
                  "properties": {
                    "cid": "tbar",
                    "gap": "true",
                    "padding": "0 0 10px 0"
                  },
                  "_expanded": true,
                  "items": [
                    {
                      "_icon": "right1",
                      "text": "fill1",
                      "cls": "Wb.Fill",
                      "properties": {
                        "cid": "fill1"
                      }
                    },
                    {
                      "_icon": "button",
                      "text": "cancelBtn",
                      "cls": "Wb.Button",
                      "properties": {
                        "cid": "cancelBtn",
                        "text": "取消"
                      },
                      "_expanded": true,
                      "events": {
                        "click": "// 关联人信息在点保存之前就会存表。如果点了“取消”需要先删除这个客户关联人表里的数据\n\nWb.ajax({\n  url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/delete_organ_entity',\n  params: {\n    CLIENT_ID: '_$client_id$_',\n    DATA_STATUS: '0'\n  },\n  async: false,\n  success() {\n    if (app?.parentApp?.parentContainer) {\n      app.parentApp.parentContainer.close();\n    } else {\n      window.close();\n    }\n  }\n});\n"
                      }
                    },
                    {
                      "_icon": "button",
                      "text": "saveBtn",
                      "cls": "Wb.Button",
                      "properties": {
                        "cid": "saveBtn",
                        "text": "保存草稿",
                        "type": "primary"
                      },
                      "hasDupCid": 0,
                      "events": {
                        "click": "// 调用投行数据接口\nfunction call_reback(key, certNo) {\n  Wb.ajax({\n    url: 'm?xwl=interface/customerInfoCheck/call_reback',\n    params: {\n      i_key: key,\n      i_cert_no: certNo,\n      i_usercode: '_$cur_user$_'\n    },\n    success(resp) {\n    }\n  });\n}\n\n// 个人\nif ('_$organ_flag$_' === '0') {\n  console.log(\"app.basicInfo.vue.ruleForm2\", app.basicInfo.vue.ruleForm2);\n  let form1 = app.basicInfo.vue.ruleForm2;\n  let form2 = app.otherInfo.vue;\n  Wb.ajax({\n    url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/save_client',\n    params: {\n      CLIENT_ID: '_$client_id$_' ? '_$client_id$_' : app.basicInfo.vue.client_id,\n      CLIENT_NAME: form1.client_name,\n      ORGAN_FLAG: '_$organ_flag$_',\n      ID_TYPE: form1.id_type,\n      ID_NO: form1.id_no,\n      ID_BEGINDATE: form1.id_begindate ? String(form1.id_begindate).replace(/\\s.*$/, '') : '',\n      ID_ENDDATE: form1.id_enddate ? String(form1.id_enddate).replace(/\\s.*$/, '') : '',\n      CLIENT_BELONG: '1',// 1融资端 2投资端 新系统只有融资端客户了\n      NATIONALITY: form1.nationality,\n      BIRTHDAY: form1.birthday,\n      INDUSTRY_TYPE: form1.industry_type,\n      TEL: form1.tel,\n      IS_OBJECT_REPORT: '工作室主体',//工作室主体/非工作室主体填报（默认为工作室主体）\n      ASSOCIATED_DATE: form2.associated_date,\n      REMARK: form2.remark,\n      CREATE_USER: '_$sys.username$_',\n      CREATE_TIME: '',\n      UPDATE_USER: '_$sys.username$_',\n      UPDATE_TIME: '',\n      WORK_TYPE: '0',// 0创建 1更新 2确认\n      CLIENT_STATUS: '0',// 0正常 1失效 2强限制 3弱限制\n      DATA_STATUS: '0',// 0草稿 1正式\n      GENDER: form1.gender,\n      INCOME: form1.income,\n      PROFESSION_CODE: form1.profession_code,// 职业分类\n      ID_ADDRESS: form1.id_address,// 证件地址\n      PROVINCE1: app.formatAddress(app.basicInfo.vue.proOptions, form1.province1),\n      CITY1: app.formatAddress(app.basicInfo.vue.cityOptions1, form1.city1),\n      DISTRICT1: app.formatAddress(app.basicInfo.vue.districtOptions1, form1.district1),\n      ADDRESS: form1.address,// 联系地址\n      PROVINCE2: app.formatAddress(app.basicInfo.vue.proOptions, form1.province2),\n      CITY2: app.formatAddress(app.basicInfo.vue.cityOptions2, form1.city2),\n      DISTRICT2: app.formatAddress(app.basicInfo.vue.districtOptions2, form1.district2),\n    },\n    async: false,\n    success(resp) {\n      let res = Wb.decode(resp);\n      if (res.O_RETURN_CODE === '0') {\n        Wb.tipSucc(\"保存成功\");\n        if (app.data.nextStep) {\n          if (app?.parentApp?.parentContainer) {\n            app.parentApp.parentContainer.close();\n          } else {\n            window.close();\n          }\n        }\n      } else {\n        Wb.tipError(res.O_RETURN_MSG);\n      }\n    }\n  });\n} else {\n  // 机构\n  console.log(\"app.basicInfo.vue.ruleForm1\", app.basicInfo.vue.ruleForm1);\n  let form1 = app.basicInfo.vue.ruleForm1;\n  let form2 = app.otherInfo.vue;\n  Wb.ajax({\n    url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/save_client',\n    params: {\n      CLIENT_ID: '_$client_id$_' ? '_$client_id$_' : app.basicInfo.vue.client_id,\n      CLIENT_NAME: form1.client_name,\n      ORGAN_FLAG: '_$organ_flag$_',\n      ID_TYPE: form1.id_type,\n      ID_NO: form1.id_no,\n      ID_BEGINDATE: form1.id_begindate ? String(form1.id_begindate).replace(/\\s.*$/, '') : '',\n      ID_ENDDATE: form1.id_enddate ? String(form1.id_enddate).replace(/\\s.*$/, '') : '',\n      CLIENT_BELONG: '1',// 1融资端 2投资端 新系统只有融资端客户了\n      OFFICE_ADDRESS: form1.office_address,// 办公地址\n      PROVINCE: app.formatAddress(app.basicInfo.vue.proOptions, form1.province),\n      CITY: app.formatAddress(app.basicInfo.vue.cityOptions, form1.city),\n      DISTRICT: app.formatAddress(app.basicInfo.vue.districtOptions, form1.district),\n      REGISTER_COUNTRY: form1.register_country,\n      REGISTER_MONEY_TYPE: form1.register_money_type ? (!isNaN(form1.register_money_type.trim()) ? app.formatMoneyType(app.data.selectList.register_money_type_list, form1.register_money_type) : form1.register_money_type) : '',//form1.register_money_type,//!isNaN(form1.register_money_type.trim()) ? app.formatMoneyType(app.data.selectList.register_money_type_list,form1.register_money_type) : form1.register_money_type,\n      REGISTER_FUND: (form1.register_fund && form1.register_fund != 'null') ? String(form1.register_fund).replace(/,/g, '') : '',\n      INDUSTRY_TYPE: form1.industry_type,\n      INDUSTRY_NAME: form1.industry_name,\n      TEL: form1.tel,\n      SETUP_DATE: form1.setup_date ? String(form1.setup_date).replace(/\\s.*$/, '') : '',\n      BUSI_SCOPE: form1.busi_scope,\n      IS_OBJECT_REPORT: '工作室主体',// 工作室主体/非主体填报（默认工作室主体）\n      ASSOCIATED_DATE: form2.associated_date,// 建立业务关系日期\n      REMARK: form2.remark,// 备注\n      CREATE_USER: '_$sys.username$_',\n      CREATE_TIME: '',\n      UPDATE_USER: '_$sys.username$_',\n      UPDATE_TIME: '',\n      WORK_TYPE: '0',// 0创建 1更新 2确认\n      CLIENT_STATUS: '0',// 0正常 1失效 2强限制 3弱限制\n      DATA_STATUS: '0'// 0草稿 1正式\n    },\n    async: false,\n    success(resp) {\n      let res = Wb.decode(resp);\n      if (res.O_RETURN_CODE === '0') {\n        Wb.tipSucc(\"保存成功\");\n        if (app.data.nextStep) {\n          if (app?.parentApp?.parentContainer) {\n            app.parentApp.parentContainer.close();\n          } else {\n            window.close();\n          }\n        }\n      } else {\n        Wb.tipError(res.O_RETURN_MSG);\n      }\n    }\n  });\n}"
                      }
                    },
                    {
                      "_icon": "button",
                      "text": "viewBtn",
                      "cls": "Wb.Button",
                      "properties": {
                        "cid": "viewBtn",
                        "text": "下一步",
                        "type": "primary"
                      },
                      "_expanded": true,
                      "events": {
                        "click": "app.data.nextStep = true;\napp.saveBtn.fireClick();//执行预览前先把当前页面数据保存\n\nWb.open({\n  url: 'm?xwl=aml_monitor/KYC01010/client_edit',\n  title: '编辑客户页面',\n  params: {\n    CLIENT_ID: '_$client_id$_' ? '_$client_id$_' : app.basicInfo.vue.client_id,\n    ORGAN_FLAG: '_$organ_flag$_',\n    CLIENT_STATUS: '0',//'_$client_status$_',\n    FK_FLAG: '_$fk_flag$_',\n    CLIENT_BELONG: '_$client_belong$_',\n    KEY: '_$key$_',\n    CUR_USER: '_$cur_user$_',\n    DATA_TYPE: '0'\n  },\n  title: '反洗钱客户维护',\n  success(scope) {\n  }\n});"
                      }
                    }
                  ]
                },
                {
                  "_icon": "container",
                  "text": "mainContainer",
                  "cls": "Wb.Container",
                  "properties": {
                    "cid": "mainContainer",
                    "autoScroll": "true",
                    "layout": "column"
                  },
                  "_expanded": true,
                  "hasDupCid": 0,
                  "items": [
                    {
                      "_icon": "container",
                      "text": "basicInfo",
                      "cls": "Wb.Container",
                      "properties": {
                        "cid": "basicInfo",
                        "padding": "10px 0"
                      },
                      "hasDupCid": 0,
                      "_expanded": true,
                      "events": {
                        "ready": "let comp = this;\ncomp.vue = new Vue({\n  el: comp.el.addEl(),\n  template: `\n<div>\n  <p style=\"color:#F56C6C;padding-left:40px;\">\n    注1：证照、身份证等有效期如果为“长期”、“永久”等，请在证照/身份证有效期截止选择“2100-12-31”。<br/>\n    注2：如果没有相关信息需要填写，请留白，不需要填写“不适用”、“无”等字段。<br/>\n    注3：附件上传后即为保存，将不允许修改和删除，如有错误可用新的同名文件更新替换。\n  </p>\n  <el-card class=\"box-card\">\n    <div slot=\"header\" class=\"clearfix\">\n      <span>{{organ_flag=='1'?'机构':'自然人'}}客户基本信息</span>\n    </div>\n    <div>\n      <!--个人-->\n      <el-form v-if=\"organ_flag =='0'\" :model=\"ruleForm2\" label-position=\"top\" style=\"padding:20px;\" :rules=\"rules\" :hide-required-asterisk=\"true\">\n        <el-row :gutter=\"20\">\n          <el-col :span=\"8\">\n            <el-form-item prop=\"client_name\">\n              <template slot=\"label\">\n                <div style=\"display: flex; align-items: center;\">\n                  <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\"><span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right:4px;\">*</span>姓名</div>\n                </div>\n              </template>\n              <el-input size=\"medium\" v-model=\"ruleForm2.client_name\" placeholder=\"请输入客户名称\" readonly />\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"16\">\n            <el-form-item prop=\"address\">\n              <template slot=\"label\">\n                <div style=\"display: flex; align-items: center;\">\n                  <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\"><span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right:4px;\">*</span>联系地址</div>\n                </div>\n              </template>\n              <div style=\"display:flex;width:100%;gap:8px;\">\n                <div style=\"flex:3;display:flex;gap:8px;\">\n                  <el-select size=\"medium\" v-model=\"ruleForm2.province2\" placeholder=\"省\" style=\"flex:1;\"\n                    @change=\"handleProvinceChg('2')\" clearable>\n                    <el-option v-for=\"item in proOptions\" :key=\"item.value\" :label=\"item.label\" :value=\"item.value\">\n                    </el-option>\n                  </el-select>\n                  <el-select size=\"medium\" v-model=\"ruleForm2.city2\" placeholder=\"市\" style=\"flex:1;\"\n                    @change=\"handleCityChg('2')\" clearable>\n                    <el-option v-for=\"item in cityOptions2\" :key=\"item.value\" :label=\"item.label\" :value=\"item.value\">\n                    </el-option>\n                  </el-select>\n                  <el-select size=\"medium\" v-model=\"ruleForm2.district2\" placeholder=\"区\" style=\"flex:1;\" clearable>\n                    <el-option v-for=\"item in districtOptions2\" :key=\"item.value\" :label=\"item.label\"\n                      :value=\"item.value\">\n                    </el-option>\n                  </el-select>\n                </div>\n                <el-input size=\"medium\" v-model=\"ruleForm2.address\" placeholder=\"详细地址\" style=\"flex:2;\"></el-input>\n              </div>\n            </el-form-item>\n          </el-col>\n        </el-row>\n        <el-row :gutter=\"20\">\n          <el-col :span=\"8\">\n            <el-form-item prop=\"nationality\">\n              <template slot=\"label\">\n                <div style=\"display: flex; align-items: center;\">\n                  <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\"><span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right:4px;\">*</span>国籍</div>\n                </div>\n              </template>\n              <el-select filterable size=\"medium\" v-model=\"ruleForm2.nationality\" placeholder=\"请选择\" clearable>\n                <el-option v-for=\"item in selectList.nationality_list\" :key=\"item.k\" :label=\"item.v\" :value=\"item.k\">\n                </el-option>\n              </el-select>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <el-form-item prop=\"gender\">\n              <template slot=\"label\">\n                <div style=\"display: flex; align-items: center;\">\n                  <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\"><span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right:4px;\">*</span>性别</div>\n                </div>\n              </template>\n              <el-select size=\"medium\" v-model=\"ruleForm2.gender\" placeholder=\"请选择\" clearable>\n                <el-option label=\"男\" value=\"1\" />\n                <el-option label=\"女\" value=\"2\" />\n                <el-option label=\"未知\" value=\"3\" />\n              </el-select>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <el-form-item prop=\"birthday\">\n              <template slot=\"label\">\n                <div style=\"display: flex; align-items: center;\">\n                  <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                    <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right:4px;\">*</span>\n                      出生年月\n                    <!--<el-tooltip \n                      class=\"item\" \n                      effect=\"dark\" \n                      content=\"如需手动填写，请按照“1990-01-01”的格式填写\" \n                      placement=\"top\">\n                      <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n                    </el-tooltip>-->\n                    <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n                    <span style=\"color:#F56C6C;font-size:14px;\">如需手动填写，请按照“1990-01-01”的格式填写</span>\n                  </div>\n                </div>\n              </template>\n              <el-date-picker v-model=\"ruleForm2.birthday\" type=\"date\" placeholder=\"选择日期\" style=\"width: 100%;\"\n                format=\"yyyy-MM-dd\" clearable editable @blur=\"handleDateBlur\"/>\n            </el-form-item>\n          </el-col>\n        </el-row>\n        <el-row :gutter=\"20\">\n          <el-col :span=\"8\">\n            <el-form-item prop=\"profession_code\">\n              <template slot=\"label\">\n                <div style=\"display: flex; align-items: center;\">\n                  <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\"><span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right:4px;\">*</span>职业分类</div>\n                </div>\n              </template>\n              <el-select filterable size=\"medium\" v-model=\"ruleForm2.profession_code\" placeholder=\"请选择\" clearable>\n                <el-option v-for=\"item in selectList.profession_code_list\" :key=\"item.k\" :label=\"item.v\"\n                  :value=\"item.k\">\n                </el-option>\n              </el-select>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <el-form-item prop=\"income\">\n              <template slot=\"label\">\n                <div style=\"display: flex; align-items: center;\">\n                  <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\"><span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right:4px;\">*</span>年收入（单位：人民币）</div>\n                </div>\n              </template>\n              <el-select filterable size=\"medium\" v-model=\"ruleForm2.income\" placeholder=\"请选择\" clearable>\n                <el-option v-for=\"item in selectList.year_income_list\" :key=\"item.k\" :label=\"item.v\" :value=\"item.k\">\n                </el-option>\n              </el-select>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <el-form-item prop=\"tel\">\n              <template slot=\"label\">\n                <div style=\"display: flex; align-items: center;\">\n                  <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\"><span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right:4px;\">*</span>联系电话</div>\n                </div>\n              </template>\n              <el-input size=\"medium\" v-model=\"ruleForm2.tel\" placeholder=\"请输入联系电话\" />\n            </el-form-item>\n          </el-col>\n        </el-row>\n        <el-row :gutter=\"20\">\n          <el-col :span=\"8\">\n            <el-form-item prop=\"id_type\">\n              <template slot=\"label\">\n                <div style=\"display: flex; align-items: center;\">\n                  <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\"><span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right:4px;\">*</span>身份证件类型</div>\n                </div>\n              </template>\n              <el-select size=\"medium\" v-model=\"ruleForm2.id_type\" placeholder=\"请选择\" clearable>\n                <el-option v-for=\"item in selectList.id_type_gr_list\" :key=\"item.k\" :label=\"item.v\" :value=\"item.k\">\n                </el-option>\n              </el-select>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <el-form-item prop=\"id_no\">\n              <template slot=\"label\">\n                <div style=\"display: flex; align-items: center;\">\n                  <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\"><span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right:4px;\">*</span>证件号码</div>\n                </div>\n              </template>\n              <el-input size=\"medium\" v-model=\"ruleForm2.id_no\" placeholder=\"请输入联系电话\" />\n            </el-form-item>\n          </el-col>\n        </el-row>\n        <el-row :gutter=\"20\">\n          <el-col :span=\"16\">\n            <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\"><span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right:4px;\">*</span>\n            证件有效期\n              <!--<el-tooltip \n                class=\"item\" \n                effect=\"dark\" \n                content=\"如需手动填写，请按照“1990-01-01”的格式填写\" \n                placement=\"top\">\n                <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n              </el-tooltip>-->\n              <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n              <span style=\"color:#F56C6C;font-size:14px;\">如需手动填写，请按照“1990-01-01”的格式填写</span>\n            </div>\n            <div style=\"display:flex;width:100%;gap:8px;\">\n              <el-form-item prop=\"id_begindate\">\n                <el-date-picker v-model=\"ruleForm2.id_begindate\" type=\"date\" placeholder=\"开始日期\" style=\"flex:1;\"\n                  format=\"yyyy-MM-dd\" clearable>\n                </el-date-picker>\n              </el-form-item>\n              <div style=\"height:40px;line-height:40px;\">至</div>\n              <el-form-item prop=\"id_enddate\">\n                <el-date-picker v-model=\"ruleForm2.id_enddate\" type=\"date\" placeholder=\"结束日期\" style=\"flex:1;\"\n                  format=\"yyyy-MM-dd\" align=\"right\" :picker-options=\"pickerOptions\" clearable>\n                </el-date-picker>\n              </el-form-item>\n            </div>\n          </el-col>\n        </el-row>\n        <el-row :gutter=\"20\">\n          <el-col :span=\"16\">\n            <el-form-item prop=\"address\">\n              <template slot=\"label\">\n                <div style=\"display: flex; align-items: center;\">\n                  <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\"><span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right:4px;\">*</span>证件地址</div>\n                </div>\n              </template>\n              <div style=\"display:flex;width:100%;gap:8px;\">\n                <div style=\"flex:3;display:flex;gap:8px;\">\n                  <el-select size=\"medium\" v-model=\"ruleForm2.province1\" placeholder=\"省\" style=\"flex:1;\"\n                    @change=\"handleProvinceChg('1')\" clearable>\n                    <el-option v-for=\"item in proOptions\" :key=\"item.value\" :label=\"item.label\" :value=\"item.value\">\n                    </el-option>\n                  </el-select>\n                  <el-select size=\"medium\" v-model=\"ruleForm2.city1\" placeholder=\"市\" style=\"flex:1;\"\n                    @change=\"handleCityChg('1')\" clearable>\n                    <el-option v-for=\"item in cityOptions1\" :key=\"item.value\" :label=\"item.label\" :value=\"item.value\">\n                    </el-option>\n                  </el-select>\n                  <el-select size=\"medium\" v-model=\"ruleForm2.district1\" placeholder=\"区\" style=\"flex:1;\" clearable>\n                    <el-option v-for=\"item in districtOptions1\" :key=\"item.value\" :label=\"item.label\"\n                      :value=\"item.value\">\n                    </el-option>\n                  </el-select>\n                </div>\n                <el-input size=\"medium\" v-model=\"ruleForm2.id_address\" placeholder=\"详细地址\" style=\"flex:2;\"></el-input>\n              </div>\n            </el-form-item>\n          </el-col>\n        </el-row>\n      </el-form>\n      <!--机构-->\n      <el-form v-else :model=\"ruleForm1\" label-position=\"top\" style=\"padding:20px;\" :rules=\"rules\" :hide-required-asterisk=\"true\">\n        <el-row :gutter=\"20\">\n          <el-col :span=\"8\">\n            <el-form-item prop=\"client_name\">\n              <template slot=\"label\">\n                <div style=\"display: flex; align-items: center;\">\n                  <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\"><span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right:4px;\">*</span>客户名称</div>\n                </div>\n              </template>\n              <el-row :gutter=\"20\">\n                <el-col :span=\"16\">\n                  <el-input size=\"medium\" v-model=\"ruleForm1.client_name\" placeholder=\"请输入客户名称\" readonly />\n                </el-col>\n                <el-col :span=\"8\">\n                  <el-button size=\"medium\" type=\"primary\" style=\"height:100%;width:100%\"\n                    @click=\"qccMatch(ruleForm1.client_name)\">工商匹配</el-button>\n                </el-col>\n              </el-row>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"16\">\n            <el-form-item prop=\"office_address\">\n              <template slot=\"label\">\n                <div style=\"display: flex; align-items: center;\">\n                  <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\"><span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right:4px;\">*</span>办公住所</div>\n                </div>\n              </template>\n              <div style=\"display:flex;width:100%;gap:8px;\">\n                <div style=\"flex:3;display:flex;gap:8px;\">\n                  <el-select size=\"medium\" v-model=\"ruleForm1.province\" placeholder=\"省\" style=\"flex:1;\"\n                    @change=\"handleProvinceChg('0')\" clearable>\n                    <el-option v-for=\"item in proOptions\" :key=\"item.value\" :label=\"item.label\" :value=\"item.value\">\n                    </el-option>\n                  </el-select>\n                  <el-select size=\"medium\" v-model=\"ruleForm1.city\" placeholder=\"市\" style=\"flex:1;\"\n                    @change=\"handleCityChg('0')\" clearable>\n                    <el-option v-for=\"item in cityOptions\" :key=\"item.value\" :label=\"item.label\" :value=\"item.value\">\n                    </el-option>\n                  </el-select>\n                  <el-select size=\"medium\" v-model=\"ruleForm1.district\" placeholder=\"区\" style=\"flex:1;\" clearable>\n                    <el-option v-for=\"item in districtOptions\" :key=\"item.value\" :label=\"item.label\"\n                      :value=\"item.value\">\n                    </el-option>\n                  </el-select>\n                </div>\n                <el-input size=\"medium\" v-model=\"ruleForm1.office_address\" placeholder=\"详细地址\" style=\"flex:2;\">\n                </el-input>\n              </div>\n            </el-form-item>\n          </el-col>\n        </el-row>\n        <el-row :gutter=\"20\">\n          <el-col :span=\"8\">\n            <el-form-item prop=\"register_country\">\n              <template slot=\"label\">\n                <div style=\"display: flex; align-items: center;\">\n                  <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\"><span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right:4px;\">*</span>注册国家地区</div>\n                </div>\n              </template>\n              <el-select filterable size=\"medium\" v-model=\"ruleForm1.register_country\" placeholder=\"请选择\" clearable>\n                <el-option v-for=\"item in selectList.nationality_list\" :key=\"item.k\" :label=\"item.v\" :value=\"item.k\">\n                </el-option>\n              </el-select>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <el-form-item prop=\"register_fund\">\n              <template slot=\"label\">\n                <div style=\"display: flex; align-items: center;\">\n                  <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\"><span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right:4px;\">*</span>注册资本金（单位：万元）</div>\n                </div>\n              </template>\n              <el-input size=\"medium\" v-model=\"ruleForm1.register_fund\" placeholder=\"请输入金额(万元)\"\n                @blur=\"ruleForm1.register_fund = formatMoney(ruleForm1.register_fund,'4')\" />\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <el-form-item prop=\"register_money_type\">\n              <template slot=\"label\">\n                <div style=\"display: flex; align-items: center;\">\n                  <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\"><span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right:4px;\">*</span>注册资本币种</div>\n                </div>\n              </template>\n              <el-select size=\"medium\" v-model=\"ruleForm1.register_money_type\" placeholder=\"请选择\" clearable>\n                <el-option v-for=\"item in selectList.register_money_type_list\" :key=\"item.k\" :label=\"item.v\"\n                  :value=\"item.k\">\n                </el-option>\n              </el-select>\n            </el-form-item>\n          </el-col>\n        </el-row>\n        <el-row :gutter=\"20\">\n          <el-col :span=\"8\">\n            <el-form-item prop=\"industry_type\">\n              <template slot=\"label\">\n                <div style=\"display: flex; align-items: center;\">\n                  <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\"><span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right:4px;\">*</span>行业分类</div>\n                </div>\n              </template>\n              <el-select size=\"medium\" v-model=\"ruleForm1.industry_type\" placeholder=\"请选择\" clearable>\n                <el-option v-for=\"item in selectList.industry_type_list\" :key=\"item.k\" :label=\"item.v\" :value=\"item.k\">\n                </el-option>\n              </el-select>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\" v-if=\"ruleForm1.industry_type=='26'\">\n            <el-form-item prop=\"industry_name\">\n              <template slot=\"label\">\n                <div style=\"display: flex; align-items: center;\">\n                  <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\"><span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right:4px;\">*</span>行业注明</div>\n                </div>\n              </template>\n              <el-input size=\"medium\" v-model=\"ruleForm1.industry_name\" placeholder=\"请输入行业注明\" />\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <el-form-item prop=\"tel\">\n              <template slot=\"label\">\n                <div style=\"display: flex; align-items: center;\">\n                  <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\"><span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right:4px;\">*</span>联系电话</div>\n                </div>\n              </template>\n              <el-input size=\"medium\" v-model=\"ruleForm1.tel\" placeholder=\"请输入联系电话\" />\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <el-form-item prop=\"setup_date\">\n              <template slot=\"label\">\n                <div style=\"display: flex; align-items: center;\">\n                  <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\"><span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\">*</span>成立日期</div>\n                  <!--<el-tooltip \n                    class=\"item\" \n                    effect=\"dark\" \n                    content=\"如需手动填写，请按照“1990-01-01”的格式填写\" \n                    placement=\"top\">\n                    <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n                  </el-tooltip>-->\n                  <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n                  <span style=\"color:#F56C6C;font-size:14px;\">如需手动填写，请按照“1990-01-01”的格式填写</span>\n                </div>\n              </template>\n              <el-date-picker v-model=\"ruleForm1.setup_date\" type=\"date\" placeholder=\"选择日期\" style=\"width: 100%;\"\n                format=\"yyyy-MM-dd\" clearable />\n            </el-form-item>\n          </el-col>\n        </el-row>\n        <el-row :gutter=\"20\">\n          <el-col :span=\"8\">\n            <el-form-item prop=\"id_type\">\n              <template slot=\"label\">\n                <div style=\"display: flex; align-items: center;\">\n                  <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\"><span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right:4px;\">*</span>证照类型</div>\n                </div>\n              </template>\n              <el-select size=\"medium\" v-model=\"ruleForm1.id_type\" placeholder=\"请选择\" clearable>\n                <el-option v-for=\"item in selectList.id_type_jg_list\" :key=\"item.k\" :label=\"item.v\" :value=\"item.k\">\n                </el-option>\n              </el-select>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <el-form-item prop=\"id_no\">\n              <template slot=\"label\">\n                <div style=\"display: flex; align-items: center;\">\n                  <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\"><span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right:4px;\">*</span>证照号码</div>\n                </div>\n              </template>\n              <el-input size=\"medium\" v-model=\"ruleForm1.id_no\" placeholder=\"请输入证照号码\" />\n            </el-form-item>\n          </el-col>\n        </el-row>\n        <el-row :gutter=\"20\">\n          <el-col :span=\"16\">\n            <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\"><span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right:4px;\">*</span>证件有效期\n              <!--<el-tooltip \n                class=\"item\" \n                effect=\"dark\" \n                content=\"如需手动填写，请按照“1990-01-01”的格式填写\" \n                placement=\"top\">\n                <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n              </el-tooltip>-->\n              <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n              <span style=\"color:#F56C6C;font-size:14px;\">如需手动填写，请按照“1990-01-01”的格式填写</span>\n            </div>\n            <div style=\"display:flex;width:100%;gap:8px;\">\n              <div>\n                <el-form-item prop=\"id_begindate\">\n                  <el-date-picker v-model=\"ruleForm1.id_begindate\" type=\"date\" placeholder=\"开始日期\" style=\"flex:1;\"\n                    format=\"yyyy-MM-dd\" clearable>\n                  </el-date-picker>\n                </el-form-item>\n                <div style=\"color:#F56C6C;margin-top:-18px;font-size:14px;\">请输入\"最新的发证日期\"</div>\n              </div>\n              <div style=\"height:40px;line-height:40px;\">至</div>\n              <el-form-item prop=\"id_enddate\">\n                <el-date-picker v-model=\"ruleForm1.id_enddate\" type=\"date\" placeholder=\"结束日期\" style=\"flex:1;\"\n                  format=\"yyyy-MM-dd\" align=\"right\" :picker-options=\"pickerOptions\" clearable>\n                </el-date-picker>\n              </el-form-item>\n            </div>\n          </el-col>\n        </el-row>\n        <el-row>\n          <el-col :span=\"24\">\n            <el-form-item prop=\"busi_scope\">\n              <template slot=\"label\">\n                <div style=\"display: flex; align-items: center;\">\n                  <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\"><span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right:4px;\">*</span>经营范围</div>\n                </div>\n              </template>\n              <el-input size=\"medium\" v-model=\"ruleForm1.busi_scope\" type=\"textarea\" :rows=\"3\" placeholder=\"请输入经营范围\" />\n            </el-form-item>\n          </el-col>\n        </el-row>\n      </el-form>\n    </div>\n    <div class=\"attachment-section\">\n      <span>附件信息</span>\n      <!--<el-tooltip \n        class=\"item\" \n        effect=\"dark\" \n        content=\"\" \n        placement=\"right\">\n      </el-tooltip>-->\n      <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n      <span style=\"color:#F56C6C;\">请上传基本信息表签章版、客户营业执照复印件、客户公司章程复印件、在工商外部数据库（如“企查查”）查验的报告。</span>\n      <el-table :data=\"attachmentList\" border style=\"width: 100%; margin-top: 10px;\" :default-sort = \"{prop: 'date', order: 'descending'}\">\n        <el-table-column prop=\"name\" label=\"附件名称\" sortable>\n          <template slot-scope=\"scope\">\n            <el-button type=\"text\" @click=\"handleDownload(scope.row)\" class=\"attachment-btn\">\n              {{ scope.row.name }}\n            </el-button>\n          </template>\n        </el-table-column>\n        <el-table-column prop=\"extension\" label=\"附件类型\" width=\"150\"></el-table-column>\n        <el-table-column prop=\"file_size\" label=\"附件大小\" width=\"120\" sortable>\n          <template slot-scope=\"scope\">\n            {{ formatSize(scope.row.file_size) }}\n          </template>\n        </el-table-column>\n        <el-table-column prop=\"create_by\" label=\"上传人\" width=\"150\" sortable></el-table-column>\n        <el-table-column prop=\"create_time\" label=\"上传时间\" width=\"180\" sortable></el-table-column>\n        <el-table-column prop=\"create_time\" label=\"操作\" width=\"180\">\n          <template slot-scope=\"scope\">\n            <div class=\"operation-buttons\">\n              <el-tooltip content=\"预览\">\n                <el-button type=\"text\" class=\"el-icon-view\" @click=\"handlePreview(scope.row)\"></el-button>\n              </el-tooltip>\n              <el-tooltip content=\"下载\">\n                <el-button type=\"text\" class=\"el-icon-download\" @click=\"handleDownload(scope.row)\"></el-button>\n              </el-tooltip>\n            </div>\n          </template>\n        </el-table-column>\n      </el-table>\n      <!-- 上传按钮 -->\n      <div class=\"upload-add\">\n        <div class=\"upload-demo\">\n          <el-button type=\"text\" icon=\"el-icon-plus\" @click=\"openFileDialog(1)\">添加</el-button>\n        </div>\n      </div>\n    </div>\n  </el-card>\n  <el-dialog title=\"附件管理\" :visible.sync=\"fileDialogVisible\" :close-on-click-modal=\"false\">\n    <el-form>\n      <el-form-item label=\"附件类型\">\n        <el-cascader v-model=\"selectedMenu\" :options=\"organ_flag==='0'?directoryConfig2:directoryConfig1\"\n          style=\"width:60%;margin-bottom:20px;\">\n      </el-form-item>\n      <el-form-item label=\"上传附件\">\n        <el-upload class=\"upload-demo\" ref=\"upload\" action=\"#\" name=\"file1\" header=\"{content-type:'text/html'}\"\n          :data=\"uploadParams\" :show-file-list=\"true\" :auto-upload=\"false\" :on-change=\"handleChange\" :before-upload=\"handleBeforeUpload\"\n          :on-remove=\"handleRemove\" :on-success=\"uploadSuccess\" multiple :file-list=\"fileList\">\n          <el-button slot=\"trigger\" size=\"mini\" icon=\"el-icon-upload2\">上传文件</el-button>\n          <div slot=\"tip\" class=\"el-upload__tip\">支持扩展名 .zip .rar .xlsx .xls .doc .docx .pdf .jpg .jpeg .svg .gif .png\n            .txt .mp3 .mp4</div>\n        </el-upload>\n      </el-form-item>\n    </el-form>\n    <div slot=\"footer\" class=\"dialog-footer\">\n      <el-button @click=\"fileDialogVisible = false\">取消</el-button>\n      <el-button type=\"primary\" @click=\"submitUpload\">提交</el-button>\n    </div>\n  </el-dialog>\n</div>\n`,\n  data() {\n    return {\n      organ_flag: '_$organ_flag$_',\n      client_id: '_$client_id$_',\n      client_belong: '_$client_belong$_',\n      selectList: {\n        'industry_type_list': [],\n        'register_money_type_list': [],\n        'id_type_list': [],\n        'nationality_list': [],\n      },\n      ruleForm1: app.data.forms.ruleForm1,\n      ruleForm2: app.data.forms.ruleForm2,\n      rules: app.data.rules,\n      // 省市区\n      proOptions: [],//省\n      cityOptions: [],// 办公地址市\n      districtOptions: [],// 办公地址区\n      cityOptions1: [],// 证件地址市\n      districtOptions1: [],// 证件地址区\n      cityOptions2: [],// 联系地址市\n      districtOptions2: [],// 联系地址区\n\n      // 非自然人附件目录\n      directoryConfig1: app.data.directory.directoryConfig1,\n      // 自然人附件目录\n      directoryConfig2: app.data.directory.directoryConfig2,\n      attachmentList: [],\n      fileList: [],\n      fileDialogVisible: false,\n      modalSize: { width: '80%', height: '70vh' },\n      isFullScreen: false,\n      isResizing: false,\n      isDragging: false,\n      previewVisible: false,\n      previewUrl: '',\n      previewTitle: '',\n      previewType: '',\n      previewContent: '',\n      previewFile: null,\n      selectedMenu: 1,//选中的目录\n      uploadParams: {\n        objectId: Wb.getId(),\n      },\n      pickerOptions: {\n        shortcuts: [{\n          text: '长期',\n          onClick(picker) {\n            picker.$emit('pick', '2100-12-31')\n          }\n        }]\n      }\n    };\n  },\n  methods: {\n    // 企查查工商匹配\n    qccMatch(client_name) {\n      let that = this;\n      Wb.ajax({\n        url: 'm?xwl=aml_monitor/aml_interface/qcc_beneficiary_interface/flow-push',\n        params: {\n          FULL_NAME: client_name,\n          PORT_TYPE: '1',// 1企查查 2元素 3中数 4鲸腾\n          ORDER_NO: Wb.getId(), //'',//订单号 唯一主键即可\n        },\n        success(resp) {\n          var res = Wb.decode(resp);\n          if (res.Status == '200') {\n            let result = res.Result;\n            console.log(\"result\", result);\n            if (result.Area) {\n              that.ruleForm1.province = result.Area.Province;// 办公地址-省\n              that.ruleForm1.city = that.processCity(result.Area.City);// 办公地址-省\n              that.ruleForm1.district = result.Area.County;// 办公地址-区\n              that.ruleForm1.office_address = that.processAddress(result.Address, result.Area.County) ? that.processAddress(result.Address, result.Area.County) : result.Address;// 办公地址-详细地址\n              that.ruleForm1.register_country = '00CN';// 注册国家地区 只有中国大陆的Area不是null\n            } else {\n              that.ruleForm1.office_address = result.Address;\n            }\n            // 注册资本金（万元）\n            if (result.RegisteredCapitalUnit.indexOf('万') != '-1') {\n              that.ruleForm1.register_fund = that.formatMoney(result.RegisteredCapital, '4');\n            } else {\n              that.ruleForm1.register_fund = that.formatMoney((result.RegisteredCapital / 10000), '4');\n            }\n            // 统一社会信用代码（营业执照）\n            if (result.CreditCode) {\n              that.ruleForm1.id_no = result.CreditCode;\n              that.ruleForm1.id_type = '3'\n            }\n            // if(result.CheckDate){\n            //   that.ruleForm1.id_begindate = result.CheckDate;\n            // }\n            that.ruleForm1.register_money_type = result.RegisteredCapitalCCY;// 注册资本金币种\n            that.ruleForm1.busi_scope = result.Scope;// 经营范围\n            that.ruleForm1.setup_date = result.StartDate;// 成立日期\n            // that.ruleForm1.id_begindate = result.TermStart;// 营业期限始 20260306注释，业务反馈不是最新的则不展示\n            that.ruleForm1.id_enddate = result.TermEnd;// 营业期限止\n          }\n        }\n      });\n    },\n    formatMoney(s, n) {\n      if (!s && s !== 0) return '';\n      let str = String(s);\n      let cleaned = str.replace(/[^\\d\\.]/g, \"\") // 移除所有非数字、非小数点的字符\n        .replace(/\\.{2,}/g, '.') // 多个小数点合并为一个\n        .replace(/^\\./, \"\"); // 移除开头的小数点\n\n      if (!cleaned) return \"\";\n      let num = parseFloat(cleaned);\n      if (isNaN(num)) return \"\";\n      let fixedNum = num.toFixed(n);\n      let [integerPart, decimalPart] = fixedNum.split('.');\n      let integerWithComma = integerPart.replace(/(?=(\\B)(\\d{3})+$)/g, ',');\n      return decimalPart ? `${integerWithComma}.${decimalPart}` : integerWithComma;\n    },\n    // 格式化附件大小\n    formatSize(bytes) {\n      if (!bytes && bytes !== 0) {\n        return '';\n      } else if (bytes === 0) {\n        return '0 B'\n      };\n\n      const k = 1024;\n      const sizes = ['B', 'KB', 'MB', 'GB', 'TB'];\n      const i = Math.floor(Math.log(bytes) / Math.log(k));\n\n      return (bytes / Math.pow(k, i)).toFixed(2) + ' ' + sizes[i];\n    },\n    handleDateBlur(event) {\n      console.log(event);\n      // const inputVal = event.target.value; // 获取输入框的原始值\n      // const modelVal = this.ruleForm2.birthday; // 获取当前绑定的值\n\n      // // 如果输入框有值，且绑定值为空（说明组件没识别出来），或者输入的是纯数字格式\n      // if (inputVal && !modelVal && /^\\d{8}$/.test(inputVal)) {\n      //   // 将 20260601 转换为 2026-06-01\n      //   const formattedDate = `${inputVal.slice(0, 4)}-${inputVal.slice(4, 6)}-${inputVal.slice(6, 8)}`;\n\n      //   // 尝试创建日期对象验证合法性\n      //   const date = new Date(formattedDate);\n\n      //   // 检查日期是否有效（防止输入 20269999 这种非法日期）\n      //   if (!isNaN(date.getTime())) {\n      //     this.ruleForm2.birthday = formattedDate; // 赋值给组件\n      //   }\n      // }\n    },\n    processCity(city) {\n      if (city == '北京市' ||\n        city == '天津市' ||\n        city == '重庆市' ||\n        city == '上海市') {\n        return '市辖区';\n      } else {\n        return city;\n      }\n    },\n    processAddress(source, search) {\n      console.log(source);\n      console.log(search);\n      const index = source.indexOf(search);\n      console.log(\"index\", index);\n      if (index !== -1) {\n        return source.substring(index + search.length);\n      } else {\n        return \"\"\n      };\n    },\n    // 获取文件类型\n    getFileType(filename) {\n      const extension = filename.split('.').pop().toLowerCase()\n      const imageTypes = ['jpg', 'jpeg', 'png', 'gif', 'bmp', 'webp']\n      const pdfTypes = ['pdf']\n      const textTypes = ['txt', 'json', 'xml', 'csv', 'md']\n\n      if (imageTypes.includes(extension)) return 'image'\n      if (pdfTypes.includes(extension)) return 'pdf'\n      if (textTypes.includes(extension)) return 'text'\n      return 'unsupported'\n    },\n    // 附件删除\n    delFile(file) {\n      let that = this;\n      Wb.ajax({\n        url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/files/delete_file',\n        params: {\n          file_pk_id: file.response\n        },\n        success() {\n          that.$message.success('删除成功');\n          that.loadAttachments(that.selectedMenu.value);\n          console.log(\"app.basicInfo.vue\", app.basicInfo.vue);\n        }\n      })\n    },\n    getProvince() {\n      let that = this;\n      // 查询省\n      Wb.ajax({\n        url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/select_province',\n        success: function (resp) {\n          let rec = Wb.decode(resp).items;\n          that.proOptions = rec.map(item => ({\n            label: item.pro_name,\n            value: item.pro_code\n          }));\n        }\n      });\n    },\n    handleProvinceChg(val) {\n      if (val == '0') {\n        this.ruleForm1.city = '';\n        this.ruleForm1.district = '';\n        this.ruleForm1.office_address = '';\n      } else if (val == '1') {\n        this.ruleForm2.city1 = '';\n        this.ruleForm2.district1 = '';\n        this.ruleForm2.id_address = '';\n      } else if (val == '2') {\n        this.ruleForm2.city2 = '';\n        this.ruleForm2.district2 = '';\n        this.ruleForm2.address = '';\n      }\n      this.getCity(val);\n    },\n    getCity(val) {\n      // 查询市\n      let that = this;\n      let province;\n      if (val == '0') {\n        province = that.ruleForm1.province\n      } else if (val == '1') {\n        province = that.ruleForm2.province1\n      } else if (val == '2') {\n        province = that.ruleForm2.province2\n      }\n      if (province) {\n        Wb.ajax({\n          url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/select_city',\n          params: {\n            I_PRO_CODE: province\n          },\n          success: function (resp) {\n            let rec = Wb.decode(resp).items;\n            console.log(\"市\", rec);\n            if (val == '0') {\n              that.cityOptions = rec.map(item => ({\n                label: item.area_name,\n                value: item.area_code\n              }));\n            } else if (val == '1') {\n              that.cityOptions1 = rec.map(item => ({\n                label: item.area_name,\n                value: item.area_code\n              }));\n            } else if (val == '2') {\n              that.cityOptions2 = rec.map(item => ({\n                label: item.area_name,\n                value: item.area_code\n              }));\n            }\n          }\n        });\n      }\n    },\n    handleCityChg(val) {\n      if (val == '0') {\n        this.ruleForm1.district = '';\n        this.ruleForm1.office_address = '';\n      } else if (val == '1') {\n        this.ruleForm2.district1 = '';\n        this.ruleForm2.id_address = '';\n      } else if (val == '2') {\n        this.ruleForm2.district2 = '';\n        this.ruleForm2.address = '';\n      }\n      this.getDistrict(val);\n    },\n    getDistrict(val) {\n      // 查询区\n      let that = this;\n      let province, city;\n      if (val == '0') {\n        province = that.ruleForm1.province;\n        city = that.ruleForm1.city;\n      } else if (val == '1') {\n        province = that.ruleForm2.province1;\n        city = that.ruleForm2.city1\n      } else if (val == '2') {\n        province = that.ruleForm2.province2;\n        city = that.ruleForm2.city2\n      }\n      Wb.ajax({\n        url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/select_district',\n        params: {\n          I_PRO_CODE: province,\n          I_AREA_CODE: city.substring(0, 4)\n        },\n        success: function (resp) {\n          let rec = Wb.decode(resp).items;\n          console.log(\"区\", rec);\n          if (val == '0') {\n            that.districtOptions = rec.map(item => ({\n              label: item.area_name,\n              value: item.area_code\n            }));\n          } else if (val == '1') {\n            that.districtOptions1 = rec.map(item => ({\n              label: item.area_name,\n              value: item.area_code\n            }));\n          } else if (val == '2') {\n            that.districtOptions2 = rec.map(item => ({\n              label: item.area_name,\n              value: item.area_code\n            }));\n          }\n        }\n      });\n    },\n    openFileDialog(menu) {\n      // this.fileList = [];\n\n      // this.fileDialogVisible = true;\n      this.fileList = [];\n      this.selectedMenu = menu;\n      this.uploadParams.file_type_no = this.selectedMenu;\n      this.uploadParams.client_id = this.client_id;\n      let curMenu = Number(String(menu)[0]);\n      let directoryConfig = this.organ_flag == '1' ? this.directoryConfig1 : this.directoryConfig2;\n      directoryConfig.forEach(item => {\n        item.disabled = true;\n      });\n      let targetItem = directoryConfig.find(item => item.value === curMenu);\n      if (targetItem) {\n        targetItem.disabled = false;\n      }\n      this.fileDialogVisible = true;\n    },\n    handleChange(file, fileList) {\n      this.fileList = fileList;\n    },\n    handleBeforeUpload(file) {\n      this.uploadParams.client_id = this.client_id;\n    },\n    // 下载附件\n    handleDownload(row) {\n      console.log(\"当前文件row\", row);\n      Wb.download({\n        url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/files/download_file',\n        params: {\n          id: row.id,\n          full_name: row.name + '.' + row.extension\n        }\n      })\n      // this.$message.success(`开始下载：${row.name}`);\n    },\n    // 查询客户基本信息附件\n    loadAttachments(directoryId) {\n      let that = this;\n      Wb.ajax({\n        url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/files/select_file',\n        params: {\n          I_CLIENT_ID: this.client_id,\n          I_FILE_TYPE_NO: directoryId\n        },\n        success(resp) {\n          let res = Wb.decode(resp).items;\n          that.attachmentList = res;\n          console.log(\"that.attachmentList\", that.attachmentList)\n\n        }\n      })\n    },\n    uploadFile(file) {\n      let that = this;\n      return new Promise((resolve) => {\n        Wb.ajax({\n          url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/files/upload_file1',\n          params: this.uploadParams,\n          success(resp) {\n            console.log(\"附件resp\", resp)\n            // if (resp.O_RETURN_CODE == 0) {\n            //   that.$message.success('上传成功');\n            resolve();\n            // } else {\n            //   that.$message.error('上传出现异常，请重试')\n            // }\n            // 上传完成时resolve\n          },\n          error() {\n            resolve(); // 即使出错也要resolve，确保计数器能继续\n          }\n        });\n      });\n    },\n    submitUpload() {\n      console.log(\"this.fileList\", this.fileList);\n      console.log(\"this.selectedMenu\", this.selectedMenu);\n      if (this.fileList.length === 0) {\n        this.$message.warning(\"请至少选择一个文件\");\n        return;\n      }\n      if (this.selectedMenu.length === 0) {\n        this.$message.warning(\"请选择附件类型\");\n        return;\n      }\n\n      this.uploadParams.file_type_no = Array.isArray(this.selectedMenu) ? this.selectedMenu[this.selectedMenu.length - 1] : this.selectedMenu;    // this.selectedMenu;\n\n      // 使用计数器跟踪上传完成情况\n      let completedCount = 0;\n      const totalFiles = this.fileList.length;\n\n      const checkAllCompleted = () => {\n        completedCount++;\n        if (completedCount === totalFiles) {\n          this.$message.success('上传成功');\n          // 所有文件都上传完成后，设置弹窗不可见\n          if (this.organ_flag == '1') {\n            this.loadAttachments('1,2,21,22');\n          } else {\n            this.loadAttachments('1,2');\n          }\n          this.fileDialogVisible = false;\n        }\n      };\n\n      for (const file of this.fileList) {\n        this.uploadParams.file1 = file.raw;\n        this.uploadFile(file).then(() => {\n          // 使用setTimeout确保异步执行，避免阻塞\n          setTimeout(checkAllCompleted, 0);\n        });\n      }\n    },\n    handleRemove(file, fileList) {\n    },\n    handlePreview(file) {\n      let that = this;\n      let params_file = {\n        'id': file.id,\n        'clientId': file.client_id,\n        'fileTypeNo': this.organ_flag == '1' ? '1,2,21,22' : '1,2',\n        'fileName': file.name + '.' + file.extension,\n        'extension': file.extension\n      };\n      Wb.ajax({\n        url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/files/preview_file',\n        params: {\n          id: file.id,\n          clientId: file.client_id,\n          fileTypeNo: this.organ_flag == '1' ? '1,2,21,22' : '1,2',\n          fileName: file.name + '.' + file.extension,\n          extension: file.extension\n        },\n        success(resp) {\n          console.log(\"resp\", resp);\n          let res = Wb.decode(resp);\n          let serverIp = '10.116.131.13';\n          if (res.code == '200') {\n            let previewUrl = res.data.previewUrl;\n            if (previewUrl.indexOf(serverIp) != -1) {\n              previewUrl = res.data.previewUrl.replace(/10\\.116\\.131\\.13:8090/g, '10.181.135.22:8080/ibcm_flow')\n            }\n            window.open(previewUrl, '_blank', 'width=800,height=600')\n          } else {\n            that.$message.error(\"当前文件类型不支持预览\")\n          }\n        }\n      });\n    },\n    handleResizeMouseDown() { },\n    uploadSuccess() {\n      this.$message.success('上传成功');;\n    },\n    uploadError() {\n      app.uploadError();\n    },\n    beforeRemove() {\n      app.beforeRemove();\n    },\n    createClientId() {\n      let that = this;\n      Wb.ajax({\n        url: 'm?xwl=aml_monitor/KYC01010/new_client_id',\n        params: {},\n        success(resp) {\n          let new_client_id = Wb.decode(resp).items[0].v_client_id;\n          that.client_id = new_client_id;\n        }\n      });\n    }\n  },\n  watch: {\n  },\n  created: async function () {\n    let originClientName = '_$client_name$_';\n    let formattedName = originClientName.replace(/\\(/g, '（').replace(/\\)/g, '）');// 半角转全角\n    this.getProvince();\n    // if (!this.client_id) {\n    //   await this.createClientId();\n    //   this.client_id = app.data.client_id\n    // }\n\n    setTimeout(() => {\n      this.selectList = { ...app.data.selectList }\n      if (!this.client_id) {\n        this.client_id = app.data.client_id\n      }\n      if (this.organ_flag == '0') {\n        this.ruleForm2.client_name = formattedName;// 新增填报客户时自动带出名称\n      } else {\n        this.ruleForm1.client_name = formattedName;\n      }\n    }, 1000);\n  },\n  mounted: function () {\n  }\n});"
                      }
                    },
                    {
                      "_icon": "container",
                      "text": "entityRegistration",
                      "cls": "Wb.Container",
                      "properties": {
                        "cid": "entityRegistration",
                        "padding": "10px 0"
                      },
                      "hasDupCid": 0,
                      "events": {
                        "ready": "let comp = this;\ncomp.vue = new Vue({\n  el: comp.el.addEl(),\n  template: `\n<div v-if=\"organ_flag=='1'\">\n  <div style=\"color:#F56C6C;padding:10px 20px;\">请在下方登记客户相关主体，应包含法定代表人（合伙企业填写执行事务合伙人或其委派代表）、授权代表人、全部控股股东、全部实际控制人、全部受益所有人。\n  同一主体有多个身份的无需重复添加，添加时选择多个角色标签即可。</div>\n  <el-card>\n    <!-- 标题行 -->\n    <div slot=\"header\">\n      <span class=\"card-title\">机构主体登记</span>\n      <el-button type=\"text\" icon=\"el-icon-plus\" class=\"add-btn\" @click=\"showDialog('1',{})\">添加</el-button>\n    </div>\n\n    <!-- 主体信息 -->\n    <div v-if=\"organList.length==0\" style=\"color:#8d8b8b;text-align:center\">暂无数据</div>\n    <el-card v-for=\"item in organList\" :key=\"item.related_id\" style=\"margin-bottom:10px;\">\n      <div class=\"client-info\">\n        <div class=\"client-title\">\n          <span>{{item.related_name}}</span>\n          <el-tag \n            v-for=\"type in item.related_type\" \n            :key=\"type\" \n            type=\"primary\" \n            size=\"mini\" \n            style=\"margin-left: 10px; margin-bottom: 5px;\">\n            {{formatDictMap('related_type_list', type)}}\n          </el-tag>\n        </div>\n\n        <el-row :gutter=\"10\" class=\"info-row\">\n          <div class=\"info-row-flex\"><label>国家或地区</label><div>{{formatDictMap('nationality_list',item.nationality)||'-'}}</div></div>\n          <div class=\"info-row-flex\"><label>证件类型</label><div>{{formatDictMap('id_type_list',item.id_type)||'-'}}</div></div>\n          <div class=\"info-row-flex\"><label>证件号码</label><div>{{item.id_no}}</div></div>\n        </el-row>\n\n        <el-row :gutter=\"10\" class=\"info-row\">\n          <div class=\"info-row-flex\"><label>证件有效期起始</label><div>{{item.id_begindate}}</div></div>\n          <div class=\"info-row-flex\"><label>证件有效期截止</label><div>{{item.id_enddate}}</div></div>\n          <div class=\"info-row-flex\"><label>是否政府部门</label><div>{{item.is_government_dept==='1'?'是':(item.is_government_dept==='0'?'否':'-')}}</div></div>\n        </el-row>\n      </div>\n\n      <!-- 操作按钮 -->\n      <div class=\"attachment-footer\">\n        <el-button type=\"text\" @click=\"deleteRalated(item)\">删除</el-button>\n        <el-button type=\"text\" @click=\"showDialog('2',item)\">编辑</el-button>\n      </div>\n    </el-card>\n  </el-card>\n\n  <el-dialog title=\"机构主体登记\" :visible.sync=\"dialogFormVisible\" width=\"60%\" :close-on-click-modal=\"false\">\n    <div>\n      <el-form :model=\"editForm\" label-width=\"120px\" label-position=\"top\" class=\"register-form\">\n        <el-row :gutter=\"20\">\n          <el-col :span=\"8\">\n            <el-form-item label=\"名称\" required>\n              <el-input v-model=\"editForm.related_name\" placeholder=\"请输入\" :readonly=\"editForm.new_flag ? false : true\"></el-input>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <el-form-item label=\"国家或地区\">\n              <el-select v-model=\"editForm.nationality\" filterable placeholder=\"请选择\">\n                <el-option v-for=\"item in selectList.nationality_list\" :key=\"item.k\" :label=\"item.v\" :value=\"item.k\">\n                </el-option>\n              </el-select>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <el-form-item label=\"是否政府部门\">\n              <el-radio-group v-model=\"editForm.is_government_dept\">\n                <el-radio label=\"1\">是</el-radio>\n                <el-radio label=\"0\">否</el-radio>\n              </el-radio-group>\n            </el-form-item>\n          </el-col>\n        </el-row>\n        <el-row :gutter=\"20\">\n          <el-col :span=\"8\">\n            <el-form-item label=\"证照号码\">\n              <el-input v-model=\"editForm.id_no\" placeholder=\"请输入\"></el-input>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <el-form-item label=\"证照类型\">\n              <el-select v-model=\"editForm.id_type\" placeholder=\"请选择\">\n                <el-option v-for=\"item in selectList.id_type_jg_list\" :key=\"item.k\" :label=\"item.v\" :value=\"item.k\">\n                </el-option>\n              </el-select>\n            </el-form-item>\n          </el-col>\n        </el-row>\n        <el-row :gutter=\"20\">\n          <el-col :span=\"16\">\n            <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">证件有效期\n              <!--<el-tooltip \n                class=\"item\" \n                effect=\"dark\" \n                content=\"如需手动填写，请按照“1990-01-01”的格式填写\" \n                placement=\"top\">\n                <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n              </el-tooltip>-->\n              <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n              <span style=\"color:#F56C6C;font-size:14px;\">如需手动填写，请按照“1990-01-01”的格式填写</span>\n            </div>\n            <div style=\"display:flex;width:100%;gap:8px;\">\n              <el-form-item prop=\"id_begindate\">\n                <el-date-picker v-model=\"editForm.id_begindate\" type=\"date\" placeholder=\"开始日期\" style=\"flex:1;\"\n                  format=\"yyyy-MM-dd\" clearable>\n                </el-date-picker>\n              </el-form-item>\n              <div style=\"height:40px;line-height:40px;\">至</div>\n              <el-form-item prop=\"id_enddate\">\n                <el-date-picker v-model=\"editForm.id_enddate\" type=\"date\" placeholder=\"结束日期\" style=\"flex:1;\"\n                  format=\"yyyy-MM-dd\" align=\"right\" :picker-options=\"pickerOptions\" clearable>\n                </el-date-picker>\n              </el-form-item>\n            </div>\n          </el-col>\n        </el-row>\n        <el-row :gutter=\"20\">\n          <el-col :span=\"24\">\n            <div class=\"tag-section\">\n              <span><span style=\"color:#F56C6C\">*&nbsp;</span>请选择关联主体标签</span>\n              <div class=\"tag-buttons\">\n                <el-button v-for=\"(tag, index) in tags\" :key=\"index\" :type=\"tag.active ? 'primary' : 'default'\" Plain\n                  size=\"mini\" @click=\"toggleTag(tag)\">\n                  {{ tag.label }}\n                </el-button>\n              </div>\n            </div>\n          </el-col>\n        </el-row>\n      </el-form>\n    </div>\n\n    <div slot=\"footer\" class=\"dialog-footer\">\n      <el-button @click=\"dialogFormVisible = false\">取消</el-button>\n      <el-button type=\"primary\" @click=\"submitForm('1')\">提交并录入下一条</el-button>\n      <el-button type=\"primary\" @click=\"submitForm('2')\">提交</el-button>\n    </div>\n  </el-dialog>\n</div>\n`,\n  data() {\n    return {\n      organ_flag: '_$organ_flag$_',\n      client_id:'_$client_id$_',\n      selectList: {\n        'nationality_list': [],\n        'id_type_list': [],\n        'id_type_jg_list': [],\n        'related_type_list': []\n      },\n      uploadParams: {\n        objectId: Wb.getId(),\n        client_id: app.basicInfo.vue.client_id\n      },\n      organList: [],\n      dialogFormVisible: false,\n      editForm: {\n        related_name: '',\n        nationality: '',\n        id_type: '',\n        id_no: '',\n        id_begindate: '',\n        id_enddate: '',\n        birthday: '',\n        is_government_dept: '',\n        related_type: ''\n      },\n      selectedTags: [],\n      curSelectedTags: [],\n      tags: [{\n        label: '控股股东',\n        related_type: '2',\n        active: false,\n        tag_type: 'default'\n      }, {\n        label: '实际控制人',\n        related_type: '3',\n        active: false,\n        tag_type: 'default'\n      }],\n      pickerOptions: {\n        shortcuts: [{\n          text: '长期',\n          onClick(picker) {\n            picker.$emit('pick', '2100-12-31')\n          }\n        }]\n      }\n    };\n  },\n  methods: {\n    // 页面展示数据字典转换\n    formatDictMap(dictType, key) {\n      const dictData = this.selectList[dictType];\n      const item = dictData.find(item => item.k === key);\n      return item ? item.v : '-';\n    },\n    // 关联人标签选中\n    toggleTag(tag) {\n      tag.active = !tag.active;\n      if (tag.active && this.curSelectedTags.indexOf(tag.related_type) == -1) {\n        this.curSelectedTags.push(tag.related_type);\n      }\n      if (!tag.active) {\n        const index = this.curSelectedTags.indexOf(tag.related_type);\n        if (index !== -1) {\n          this.curSelectedTags.splice(index, 1);\n        }\n      }\n      console.log(\"this.curSelectedTags\", this.curSelectedTags);\n    },\n    handleRemove(file) {\n      console.log('remove', file);\n    },\n    // 查询机构主体/自然人主体\n    selectOrganEntity(client_id, organ_flag) {\n      let that = this;\n      Wb.ajax({\n        url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/select_organ_entity',\n        params: {\n          CLIENT_ID: client_id,\n          ORGAN_FLAG: organ_flag\n        },\n        success(resp) {\n          console.log(\"重新查询机构主体/自然人主体\");\n          let res = Wb.decode(resp).items || [];\n          let related_types = [];\n\n          if (organ_flag == '0') {\n            // 1. 创建一个Map用于根据“唯一键”聚合数据\n            const personMap = new Map();\n\n            res.forEach(item => {\n              // 定义自然人的“唯一键” \n              const key = [\n                item.related_name,\n                item.id_type,\n                item.id_no,\n                item.id_begindate,\n                item.id_enddate,\n                item.birthday,\n                item.nationality\n              ].join('||');\n\n              if (personMap.has(key)) {\n                // 如果已存在，合并 related_type 和 related_id\n                const existing = personMap.get(key);\n                existing.related_type.push(item.related_type);\n                existing.related_id.push(item.related_id);\n              } else {\n                // 如果是新数据，初始化数组\n                const newItem = { ...item };\n                newItem.related_type = [item.related_type]; // 将字符串转为数组\n                newItem.related_id = [item.related_id];   // 将字符串转为数组\n                personMap.set(key, newItem);\n              }\n            });\n\n            // 2. 将Map转换回数组，并更新 related_types 统计\n            that.personList = Array.from(personMap.values());\n\n            // --- 原有逻辑修正 ---\n            // 注意：因为 personList 现在的结构变了（related_type 是数组），\n            // 原来的 related_types 统计逻辑需要调整，或者如果你不需要全局统计可以删除。\n            // 如果你需要统计所有出现过的类型，需要双重循环：\n            that.personList.forEach(person => {\n              person.related_type.forEach(type => {\n                if (!related_types.includes(type)) {\n                  related_types.push(type);\n                }\n              });\n            });\n\n            console.log(\"that.personList\", that.personList);\n\n          } else if (organ_flag == '1') {\n            const organMap = new Map();\n\n            res.forEach(item => {\n              // 定义机构的“唯一键” \n              const key = [\n                item.related_name,\n                item.id_type,\n                item.id_no,\n                item.id_begindate,\n                item.id_enddate,\n                item.is_government_dept,\n                item.nationality\n              ].join('||');\n\n              if (organMap.has(key)) {\n                const existing = organMap.get(key);\n                existing.related_type.push(item.related_type);\n                existing.related_id.push(item.related_id);\n              } else {\n                const newItem = { ...item };\n                newItem.related_type = [item.related_type];\n                newItem.related_id = [item.related_id];\n                organMap.set(key, newItem);\n              }\n            });\n\n            that.organList = Array.from(organMap.values());\n\n            // 统计机构类型\n            that.organList.forEach(organ => {\n              organ.related_type.forEach(type => {\n                if (!related_types.includes(type)) {\n                  related_types.push(type);\n                }\n              });\n            });\n          }\n\n          // --- 后续逻辑保持不变 (处理标签显隐) ---\n          that.selectedTags = related_types;\n          const exists_fddbr = that.personList.filter(person =>\n            // 注意：这里判断时，person.related_type 现在是数组\n            Array.isArray(person.related_type) ? person.related_type.includes('1') : person.related_type === '1'\n          ).length > 0;\n\n          const exists_sqdbr = that.personList.filter(person =>\n            Array.isArray(person.related_type) ? person.related_type.includes('4') : person.related_type === '4'\n          ).length > 0;\n\n          if (exists_fddbr) { that.tags.forEach(tag => { if (tag.related_type == '1') { tag.show = false } }); }\n          else { that.tags.forEach(tag => { if (tag.related_type == '1') { tag.show = true } }); }\n\n          if (exists_sqdbr) { that.tags.forEach(tag => { if (tag.related_type == '4') { tag.show = false } }); }\n          else { that.tags.forEach(tag => { if (tag.related_type == '4') { tag.show = true } }); }\n        }\n        \n        // success(resp) {\n        //   let res = Wb.decode(resp).items;\n        //   let related_types = [];\n        //   if (organ_flag == '0') {\n        //     that.personList = res;\n        //     console.log(\"that.personList\", that.personList)\n        //     for (let i = 0; i < res.length; i++) {\n        //       related_types.push(res[i].related_type);\n        //     }\n        //     that.selectedTags = related_types;\n        //   } else if (organ_flag == '1') {\n        //     that.organList = res;\n        //     for (let i = 0; i < res.length; i++) {\n        //       related_types.push(res[i].related_type);\n        //     }\n        //     that.selectedTags = related_types;\n        //   }\n        // }\n      });\n    },\n    // 删除机构主体\n    deleteRalated(item) {\n      let that = this;\n      Wb.ajax({\n        url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/delete_organ_entity',\n        params: {\n          CLIENT_ID: app.basicInfo.vue.client_id,\n          RELATED_NAME: item.related_name\n        },\n        success(resp) {\n          Wb.tipSucc(\"删除成功\");\n          that.selectOrganEntity(app.basicInfo.vue.client_id, '1');\n        }\n      });\n    },\n    showDialog(val, item) {\n      if (val == '1') {\n        console.log(\"打开新增弹窗\");\n        this.editForm = {\n          related_name: '',\n          nationality: '',\n          id_type: '',\n          id_no: '',\n          id_begindate: '',\n          id_enddate: '',\n          is_government_dept: '',\n          birthday: '',\n          related_type: '',\n          data_status: '0',//关联人数据状态 0-临时 1-正式\n          new_flag: true\n        };\n        this.curSelectedTags = [];\n        this.tags.forEach(tag => {\n          if (tag.active) {\n            tag.active = !tag.active;\n          }\n        });\n      } else if (val == '2') {\n        console.log(\"打开编辑弹窗\");\n        let that = this;\n        // 查询当前关联主体的全部机构关联类型\n        Wb.ajax({\n          url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/select_organ_entity',\n          params: {\n            CLIENT_ID: app.basicInfo.vue.client_id,\n            ORGAN_FLAG: '1',\n            RELATED_NAME: item.related_name\n          },\n          success(resp) {\n            let res = Wb.decode(resp).items;\n            that.curSelectedTags = res.map(function (item) {\n              return item.related_type;\n            });\n            console.log(\"that.curSelectedTags\", that.curSelectedTags);\n            that.editForm = {\n              related_name: item.related_name,\n              nationality: item.nationality,\n              id_type: item.id_type,\n              id_no: item.id_no,\n              id_begindate: item.id_begindate,\n              id_enddate: item.id_enddate,\n              birthday: item.birthday,\n              is_government_dept: item.is_government_dept,\n              related_type: item.related_type,\n              related_id: item.related_id,\n              data_status: item.data_status,//关联人数据状态 0-临时 1-正式\n              new_flag: false\n            }\n            that.tags.forEach(function (tag) {\n              if (that.curSelectedTags.includes(tag.related_type)) {\n                tag.active = true;\n              } else {\n                tag.active = false;\n              }\n            });\n          }\n        })\n      }\n      this.dialogFormVisible = true;\n    },\n    submitForm(val) {\n      let that = this;\n      if (!this.editForm.related_name) {\n        this.$message.error(\"请填写名称！\");\n        return;\n      }\n      if (this.curSelectedTags.length == 0) {\n        this.$message.error(\"请选择关联主体标签！\");\n        return;\n      }\n      let commonData = {\n        CLIENT_ID: app.basicInfo.vue.client_id,\n        RELATED_NAME: this.editForm.related_name,\n        ORGAN_FLAG: '1',\n        ID_TYPE: this.editForm.id_type,\n        ID_NO: this.editForm.id_no,\n        ID_BEGINDATE: this.editForm.id_begindate,\n        ID_ENDDATE: this.editForm.id_enddate,\n        NATIONALITY: this.editForm.nationality,\n        BIRTHDAY: this.editForm.birthday,\n        IS_GOVERNMENT_DEPT: this.editForm.is_government_dept,\n        DATA_STATUS: this.editForm.data_status,\n        OBJECT_ID: ''\n      };\n      const batchList = this.curSelectedTags.map(related_type => ({\n        ...commonData,\n        RELATED_TYPE: related_type,\n        UPDATE_USER:'_$sys.username$_',\n        CREATE_USER:'_$sys.username$_'\n      }));\n      console.log(\"batchList\",batchList);\n      // 新增\n      if (this.editForm.new_flag) {\n        Wb.ajax({\n          url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/select_organ_entity',\n          params: {\n            CLIENT_ID: app.basicInfo.vue.client_id,\n            ORGAN_FLAG: '1',\n            RELATED_NAME: this.editForm.related_name\n          },\n          success(resp) {\n            let res = Wb.decode(resp).items;\n            let exists = false;\n            exists = res.some(function (item) {\n              console.log(\"item.related_name\", item.related_name)\n              console.log(\"batchList[0].RELATED_NAME\", batchList[0].RELATED_NAME)\n              return String(item.related_name) === batchList[0].RELATED_NAME &&\n                String(item.related_type) === batchList[0].RELATED_TYPE;\n            });\n            if (exists) {\n              Wb.error(\"已存在主体名称为“\" + batchList[0].RELATED_NAME + \"”的【\" + that.formatDictMap('related_type_list', batchList[0].RELATED_TYPE) + \"】信息，请勿重复添加！\");\n              return;\n            }\n            Wb.ajax({\n              url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/save_organ_entity',\n              params: {\n                batchList: batchList\n              },\n              success(resp) {\n                Wb.tipSucc(\"添加成功\");\n                that.selectOrganEntity(app.basicInfo.vue.client_id, '1');\n                // 重置弹窗内容\n                that.editForm = {\n                  related_name: '',\n                  nationality: '',\n                  id_type: '',\n                  id_no: '',\n                  id_begindate: '',\n                  id_enddate: '',\n                  is_government_dept: '',\n                  birthday: '',\n                  related_type: ''\n                };\n                if (val == '1') {// 如果点击的是“提交并录入下一个”\n                  that.editForm.new_flag = true\n                } else if (val == '2') {\n                  that.dialogFormVisible = false;\n                }\n                // 提交时删除第一个元素\n                that.curSelectedTags.shift();\n                // 取消标签的选中样式状态\n                that.tags.forEach(item => {\n                  if (item.active) {\n                    item.active = !item.active\n                  }\n                });\n              }\n            });\n\n          }\n        })\n      } else {\n        // 编辑\n        Wb.ajax({\n          url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/update_organ_entity',\n          params: {\n            batchList: batchList\n          },\n          success(resp) {\n            Wb.tipSucc(\"编辑成功\");\n            that.selectOrganEntity(app.basicInfo.vue.client_id, '1');\n            // 重置弹窗内容\n            that.editForm = {\n              related_name: '',\n              nationality: '',\n              id_type: '',\n              id_no: '',\n              id_begindate: '',\n              id_enddate: '',\n              is_government_dept: '',\n              birthday: '',\n              related_type: ''\n            };\n            if (val == '1') {//如果点击的是“提交并录入下一个”\n              that.editForm.new_flag = true\n            } else if (val == '2') {\n              that.dialogFormVisible = false;\n            }\n            // 取消标签的选中样式状态\n            that.tags.forEach(item => {\n              if (item.active) {\n                item.active = !item.active\n              }\n            });\n          }\n        });\n      }\n    }\n  },\n  created: function () {\n    setTimeout(() => {\n      if (!this.client_id) {\n        this.client_id = app.data.client_id\n      }\n      this.selectList.id_type_jg_list = app.data.selectList.id_type_jg_list;\n      this.selectList.id_type_list = app.data.selectList.id_type_list;\n      this.selectList.nationality_list = app.data.selectList.nationality_list;\n      this.selectList.related_type_list = app.data.selectList.related_type_list;\n    }, 1000);\n  },\n});"
                      }
                    },
                    {
                      "_icon": "container",
                      "text": "personRegistration",
                      "cls": "Wb.Container",
                      "properties": {
                        "cid": "personRegistration",
                        "padding": "10px 0"
                      },
                      "_expanded": true,
                      "events": {
                        "ready": "let comp = this;\ncomp.vue = new Vue({\n  el: comp.el.addEl(),\n  template: `\n<div v-if=\"organ_flag=='1'\">\n  <el-card>\n    <!-- 标题行 -->\n    <div slot=\"header\">\n      <span class=\"card-title\">自然人主体登记</span>\n      <el-button type=\"text\" icon=\"el-icon-plus\" class=\"add-btn\" @click=\"showDialog('1',{})\">添加</el-button>\n      <el-button type=\"text\" icon=\"el-icon-plus\" class=\"add-btn\" @click=\"showNewBomisAddDialog\">添加受益人</el-button>\n    </div>\n\n    <!-- 主体信息 -->\n    <div v-if=\"personList.length==0\" style=\"color:#8d8b8b;text-align:center\">暂无数据</div>\n    <el-card v-for=\"item in personList\" :key=\"item.related_id\" style=\"margin-bottom:10px;\">\n      <div class=\"client-info\">\n        <div class=\"client-title\">\n          <span>{{item.related_name}}</span>\n          <el-tag v-for=\"type in item.related_type\" :key=\"type\" type=\"primary\" size=\"mini\"\n            style=\"margin-left: 10px; margin-bottom: 5px;\">\n            {{formatDictMap('related_type_list', type)}}\n          </el-tag>\n        </div>\n\n<template v-if=\"!item.benefitInfo\">\n        <el-row :gutter=\"10\" class=\"info-row\">\n          <div class=\"info-row-flex\"><label style=\"width:150px;\">国籍</label><div>{{formatDictMap('nationality_list',item.nationality)||'-'}}</div></div>\n          <div class=\"info-row-flex\"><label style=\"width:150px;\">证件类型</label><div>{{formatDictMap('id_type_list',item.id_type)||'-'}}</div></div>\n          <div class=\"info-row-flex\"><label style=\"width:150px;\">证件号码</label><div>{{item.id_no}}</div></div>\n        </el-row>\n\n        <el-row :gutter=\"10\" class=\"info-row\">\n          <div class=\"info-row-flex\"><label style=\"width:150px;\">证件有效期</label><div>{{item.id_begindate||'-'}}至{{item.id_enddate||'-'}}</div></div>\n          <div class=\"info-row-flex\"><label style=\"width:150px;\">出生年月</label><div>{{item.birthday || '-'}}</div></div>\n          <div class=\"info-row-flex\"><label style=\"width:150px;\">联系方式</label><div>{{item.mobno1 || '-'}}</div></div>\n        </el-row>\n\n</template>\n<template v-if=\"item.benefitInfo\">\n              <el-row :gutter=\"10\" class=\"info-row\">\n                <div class=\"info-row-flex\"><label>受益所有人</label>\n                  <div>{{formatDictMap('benefit_flag_list', item.benefitInfo.bo_type) || '-'}}</div>\n                </div>\n                <div class=\"info-row-flex\"><label>企业性质</label>\n                  <div>{{formatDictMap('benefit_company_no_list', item.benefitInfo.company_type) || '-'}}</div>\n                </div>\n                <div class=\"info-row-flex\"><label>客户信息披露情况</label>\n                  <div>{{formatFullInfoFlag(item.benefitInfo.full_info_flag)}}</div>\n                </div>\n              </el-row>\n              <el-row :gutter=\"10\" class=\"info-row\">\n                <div class=\"info-row-flex\"><label>受益所有权类型</label>\n                  <div>{{formatMultipleDictMap('bnf_type_new_list', item.benefitInfo.bnf_type_str || item.benefitInfo.bnf_type) || '-'}}</div>\n                </div>\n              </el-row>\n              <el-row :gutter=\"10\" class=\"info-row\"\n                v-if=\"bomisBnfIncludes(item.benefitInfo,'NA1') || bomisBnfIncludes(item.benefitInfo,'NB1') || bomisBnfIncludes(item.benefitInfo,'ND1')\">\n                <div class=\"info-row-flex\"><label>持有股权、股份或者合伙权益的比例（%）</label>\n                  <div>{{ item.benefitInfo.acthdrat != null && item.benefitInfo.acthdrat !== '' ? item.benefitInfo.acthdrat : '-' }}</div>\n                </div>\n                <div class=\"info-row-flex\"><label>形成日期(权益)</label>\n                  <div>{{item.benefitInfo.shareratiostartdate || '-'}}</div>\n                </div>\n                <div class=\"info-row-flex\"><label>终止日期(权益)</label>\n                  <div>{{item.benefitInfo.shareratioenddate || '-'}}</div>\n                </div>\n              </el-row>\n              <el-row :gutter=\"10\" class=\"info-row\"\n                v-if=\"bomisBnfIncludes(item.benefitInfo,'NA2-1') || bomisBnfIncludes(item.benefitInfo,'NB2-1') || bomisBnfIncludes(item.benefitInfo,'ND2-1')\">\n                <div class=\"info-row-flex\" style=\"width:100%;flex-basis:100%;\">\n                  <label style=\"font-weight:600;color:#303133;\">{{ bomisPriBenefitBlockTitle(item.benefitInfo, 'profit') }}</label>\n                  <div></div>\n                </div>\n                <div class=\"info-row-flex\"><label>持有收益权的比例(%)</label>\n                  <div>{{ item.benefitInfo.actownerprofitratio != null && item.benefitInfo.actownerprofitratio !== '' ? item.benefitInfo.actownerprofitratio : '-' }}</div>\n                </div>\n                <div class=\"info-row-flex\"><label>形成日期(收益权)</label>\n                  <div>{{item.benefitInfo.profitratiostartdate || '-'}}</div>\n                </div>\n                <div class=\"info-row-flex\"><label>终止日期(收益权)</label>\n                  <div>{{item.benefitInfo.profitratioenddate || '-'}}</div>\n                </div>\n              </el-row>\n              <el-row :gutter=\"10\" class=\"info-row\"\n                v-if=\"bomisBnfIncludes(item.benefitInfo,'NA2-2') || bomisBnfIncludes(item.benefitInfo,'NB2-2') || bomisBnfIncludes(item.benefitInfo,'ND2-2')\">\n                <div class=\"info-row-flex\" style=\"width:100%;flex-basis:100%;\">\n                  <label style=\"font-weight:600;color:#303133;\">{{ bomisPriBenefitBlockTitle(item.benefitInfo, 'vote') }}</label>\n                  <div></div>\n                </div>\n                <div class=\"info-row-flex\"><label>持有表决权的比例(%)</label>\n                  <div>{{ item.benefitInfo.actownerprofitratiovote != null && item.benefitInfo.actownerprofitratiovote !== '' ? item.benefitInfo.actownerprofitratiovote : '-' }}</div>\n                </div>\n                <div class=\"info-row-flex\"><label>形成日期(表决权)</label>\n                  <div>{{item.benefitInfo.profitratiovotestartdate || '-'}}</div>\n                </div>\n                <div class=\"info-row-flex\"><label>终止日期(表决权)</label>\n                  <div>{{item.benefitInfo.profitratiovoteenddate || '-'}}</div>\n                </div>\n              </el-row>\n              <el-row :gutter=\"10\" class=\"info-row\"\n                v-if=\"bomisBnfIncludes(item.benefitInfo,'NA3-1') || bomisBnfIncludes(item.benefitInfo,'NA3-2') || bomisBnfIncludes(item.benefitInfo,'NB3-1') || bomisBnfIncludes(item.benefitInfo,'NB3-2') || bomisBnfIncludes(item.benefitInfo,'ND3')\">\n                <div class=\"info-row-flex\"><label>实施实际控制的内容/方式</label>\n                  <div>{{formatMultipleDictMap('benefit_actctrltype_list', item.benefitInfo.actctrltype_str || item.benefitInfo.actctrltype) || '-'}}</div>\n                </div>\n                <div class=\"info-row-flex\" v-if=\"bomisBnfIncludes(item.benefitInfo,'NA3-2') || bomisBnfIncludes(item.benefitInfo,'NB3-2') || bomisBnfIncludes(item.benefitInfo,'ND3')\"><label>其他形式的具体内容</label>\n                  <div>{{item.benefitInfo.actotherforms || '-'}}</div>\n                </div>\n                <div class=\"info-row-flex\"><label>形成日期(实施实际控制)</label>\n                  <div>{{item.benefitInfo.obtainactdate || '-'}}</div>\n                </div>\n                <div class=\"info-row-flex\"><label>终止日期(实施实际控制)</label>\n                  <div>{{item.benefitInfo.terminationactdate || '-'}}</div>\n                </div>\n              </el-row>\n              <el-row :gutter=\"10\" class=\"info-row\"\n                v-if=\"bomisBnfIncludes(item.benefitInfo,'NA3-1') || bomisBnfIncludes(item.benefitInfo,'NB3-1') || bomisBnfIncludes(item.benefitInfo,'ND3')\">\n                <div class=\"info-row-flex\"><label>是否存在上一层备案主体</label>\n                  <div>{{formatDictMap('benefit_yesno_list', item.benefitInfo.actconuppermarket) || '-'}}</div>\n                </div>\n                <div class=\"info-row-flex\" v-if=\"item.benefitInfo.actconuppermarket === 'Y'\"><label>上一层备案主体名称</label>\n                  <div>{{item.benefitInfo.actconupperentname || '-'}}</div>\n                </div>\n                <div class=\"info-row-flex\" v-if=\"item.benefitInfo.actconuppermarket === 'Y'\"><label>统一社会信用代码</label>\n                  <div>{{item.benefitInfo.actconuniscid || '-'}}</div>\n                </div>\n              </el-row>\n              <el-row :gutter=\"10\" class=\"info-row\"\n                v-if=\"bomisBnfIncludes(item.benefitInfo,'NA4') || bomisBnfIncludes(item.benefitInfo,'NB4')\">\n                <div class=\"info-row-flex\"><label>负责日常经营管理的（高级管理）人员职位</label>\n                  <div>{{formatMultipleDictMap('benefit_seniormgrpos_list', item.benefitInfo.seniormgrpos_str || item.benefitInfo.seniormgrpos) || '-'}}</div>\n                </div>\n                <div class=\"info-row-flex\" v-if=\"bomisSeniormgrposIncludes(item.benefitInfo,'15')\"><label>公司章程规定的其他（高级管理）人员的具体职位</label>\n                  <div>{{item.benefitInfo.actdailymgmtpostother || '-'}}</div>\n                </div>\n              </el-row>\n              <el-row :gutter=\"10\" class=\"info-row\" v-if=\"bomisBnfIncludes(item.benefitInfo,'NA5')\">\n                <div class=\"info-row-flex\"><label>在华最高层级的高级管理人员职位</label>\n                  <div>{{formatMultipleDictMap('benefit_seniormgrposcn_list', item.benefitInfo.seniormgrposcn_str || item.benefitInfo.seniormgrposcn) || '-'}}</div>\n                </div>\n                <div class=\"info-row-flex\" v-if=\"bomisSeniormgrposcnIncludes(item.benefitInfo,'1')\"><label>在华最高层级的高级管理其他职位</label>\n                  <div>{{item.benefitInfo.ownerrightmgmtpostother || '-'}}</div>\n                </div>\n              </el-row>\n              <el-row :gutter=\"10\" class=\"info-row\">\n                <div class=\"info-row-flex\"><label>性别</label>\n                  <div>{{formatDictMap('benefit_gender_list', item.benefitInfo.gender) || '-'}}</div>\n                </div>\n                <div class=\"info-row-flex\"><label>国籍</label>\n                  <div>{{formatDictMap('nationality_list', item.benefitInfo.nationality) || '-'}}</div>\n                </div>\n                <div class=\"info-row-flex\"><label>出生年月</label>\n                  <div>{{item.benefitInfo.birthday || '-'}}</div>\n                </div>\n              </el-row>\n              <el-row :gutter=\"10\" class=\"info-row\">\n                <div class=\"info-row-flex\"><label>证件类型</label>\n                  <div>{{formatDictMap('id_type_gr_list', item.benefitInfo.id_type) || '-'}}</div>\n                </div>\n                <div class=\"info-row-flex\"><label>证件号码</label>\n                  <div>{{item.benefitInfo.id_no || '-'}}</div>\n                </div>\n                <div class=\"info-row-flex\"><label>证件有效期截止</label>\n                  <div>{{item.benefitInfo.id_enddate || '-'}}</div>\n                </div>\n              </el-row>\n              <el-row :gutter=\"10\" class=\"info-row\">\n                <div class=\"info-row-flex\"><label>联系方式（手机）</label>\n                  <div>{{item.benefitInfo.mobno1 || '-'}}</div>\n                </div>\n                <div class=\"info-row-flex\"><label>联系方式（固话）</label>\n                  <div>{{item.benefitInfo.mobno2 || '-'}}</div>\n                </div>\n                <div class=\"info-row-flex\"><label>联系地址</label>\n                  <div>{{item.benefitInfo.address || '-'}}</div>\n                </div>\n              </el-row>\n            </template>\n      </div>\n\n      <!-- 操作按钮 -->\n      <div class=\"attachment-footer\">\n        <el-button type=\"text\" @click=\"deleteRalated(item)\">删除</el-button>\n        <el-button type=\"text\" @click=\"editNaturalPerson(item)\">编辑</el-button>\n      </div>\n    </el-card>\n  </el-card>\n\n  <el-dialog :title=\"beneficiaryOnly ? '添加受益人' : '自然人主体登记'\" :visible.sync=\"dialogFormVisible\" width=\"60%\" :close-on-click-modal=\"false\">\n    <div>\n      <el-form :model=\"editForm\" :rules=\"editFormRules\" ref=\"editFormRef\" label-width=\"120px\" label-position=\"top\" class=\"register-form\">\n        <el-row :gutter=\"20\">\n          <el-col :span=\"8\">\n            <el-form-item label=\"姓名\" required>\n              <el-input v-model=\"editForm.related_name\" placeholder=\"请输入\" :readonly=\"editForm.new_flag ? false : true\">\n              </el-input>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <el-form-item label=\"国籍\">\n              <el-select v-model=\"editForm.nationality\" filterable placeholder=\"请选择\">\n                <el-option v-for=\"item in selectList.nationality_list\" :key=\"item.k\" :label=\"item.v\" :value=\"item.k\">\n                </el-option>\n              </el-select>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <el-form-item>\n              <template slot=\"label\">\n                <div style=\"display: flex; align-items: center;\">\n                  <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">出生年月</div>\n                  <el-tooltip \n                    class=\"item\" \n                    effect=\"dark\" \n                    content=\"如需手动填写，请按照“1990-01-01”的格式填写\" \n                    placement=\"top\">\n                    <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n                  </el-tooltip>\n                </div>\n              </template>\n              <el-date-picker v-model=\"editForm.birthday\" type=\"date\" placeholder=\"年-月-日\" style=\"flex:1;\"\n                format=\"yyyy-MM-dd\">\n              </el-date-picker>\n            </el-form-item>\n          </el-col>\n        </el-row>\n        <el-row :gutter=\"20\">\n          <el-col :span=\"8\">\n            <el-form-item label=\"证照号码\">\n              <el-input v-model=\"editForm.id_no\" placeholder=\"请输入\"></el-input>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <el-form-item label=\"证照类型\">\n              <el-select v-model=\"editForm.id_type\" placeholder=\"请选择\">\n                <el-option v-for=\"item in selectList.id_type_gr_list\" :key=\"item.k\" :label=\"item.v\" :value=\"item.k\">\n                </el-option>\n              </el-select>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\" v-if=\"curSelectedTags.includes('1')||curSelectedTags.includes('4')\">\n            <el-form-item label=\"联系方式\">\n              <el-input v-model=\"editForm.mobno1\" placeholder=\"请输入联系方式\">\n              </el-input>\n            </el-form-item>\n          </el-col>\n        </el-row>\n        <el-row :gutter=\"20\">\n          <el-col :span=\"16\">\n            <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">证件有效期\n              <!--<el-tooltip \n                class=\"item\" \n                effect=\"dark\" \n                content=\"如需手动填写，请按照“1990-01-01”的格式填写\" \n                placement=\"top\">\n                <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n              </el-tooltip>-->\n              <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n              <span style=\"color:#F56C6C;font-size:14px;\">如需手动填写，请按照“1990-01-01”的格式填写</span>\n            </div>\n            <div style=\"display:flex;width:100%;gap:8px;\">\n              <el-form-item prop=\"id_begindate\">\n                <el-date-picker v-model=\"editForm.id_begindate\" type=\"date\" placeholder=\"开始日期\" style=\"flex:1;\"\n                  format=\"yyyy-MM-dd\" clearable>\n                </el-date-picker>\n              </el-form-item>\n              <div style=\"height:40px;line-height:40px;\">至</div>\n              <el-form-item prop=\"id_enddate\">\n                <el-date-picker v-model=\"editForm.id_enddate\" type=\"date\" placeholder=\"结束日期\" style=\"flex:1;\"\n                  format=\"yyyy-MM-dd\" align=\"right\" :picker-options=\"pickerOptions\" clearable>\n                </el-date-picker>\n              </el-form-item>\n            </div>\n          </el-col>\n        </el-row>\n        <!-- 受益所有人特有字段 -->\n        <el-row :gutter=\"20\" v-if=\"curSelectedTags.includes('5')\">\n          <el-col :span=\"8\">\n            <el-form-item label=\"受益所有人类型\">\n              <el-select v-model=\"editForm.beneficiary\" placeholder=\"请选择\" clearable style=\"width:100%\" @change=\"clearRatio\">\n                <el-option v-for=\"item in selectList.beneficiary_list\" :key=\"item.k\" :label=\"item.v\" :value=\"item.k\">\n                </el-option>\n              </el-select>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\" v-if=\"['A1', 'A2', 'B1', 'D1'].includes(editForm.beneficiary)\">\n            <el-form-item label=\"股权/表决权比例\" prop=\"shareholding_ratio\">\n              <el-input v-model=\"editForm.shareholding_ratio\" placeholder=\"请输入(%)\">\n                <template slot=\"append\">%</template>\n              </el-input>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <el-form-item label=\"联系地址\">\n              <el-input v-model=\"editForm.address\" placeholder=\"请输入\"></el-input>\n            </el-form-item>\n          </el-col>\n        </el-row>\n        <el-row>\n          <el-col :span=\"24\">\n            <div class=\"tag-section\" v-if=\"!beneficiaryOnly\">\n              <span><span style=\"color:#F56C6C\">*&nbsp;</span>请选择关联主体标签</span>\n              <div class=\"tag-buttons\">\n                <el-button v-for=\"(tag, index) in tags\" :key=\"index\" :type=\"tag.active ? 'primary' : 'default'\" Plain\n                  size=\"mini\" @click=\"toggleTag(tag)\" v-show=\"tag.show && tag.related_type !== '5'\">\n                  {{ tag.label }}\n                </el-button>\n              </div>\n            </div>\n          </el-col>\n        </el-row>\n      </el-form>\n    </div>\n\n    <div slot=\"footer\" class=\"dialog-footer\">\n      <el-button @click=\"dialogFormVisible = false\">取消</el-button>\n      <el-button type=\"primary\" @click=\"submitForm('1')\">提交并录入下一条</el-button>\n      <el-button type=\"primary\" @click=\"submitForm('2')\">提交</el-button>\n    </div>\n  </el-dialog>\n<!-- 6 新版受益所有人 带bomis核验功能 -->\n  <el-dialog :title=\"bomisParams.editBomisForm.title\" :visible.sync=\"bomisParams.dialogBomisVisible\" width=\"80%\"\n    :close-on-click-modal=\"false\" @close=\"closeDialog('bomisDialog')\" custom-class=\"benefit-scroll-dialog\">\n    <div>\n      <el-form :model=\"bomisParams.editBomisForm\" ref=\"editBenefitForm\" :rules=\"bomisParams.editBomisFormRules\"\n        label-width=\"280px\" label-position=\"top\"\n        :class=\"['register-form', {'hide-required-mark': shouldHideRequiredMark}]\" :hide-required-asterisk=\"false\"\n        size=\"mini\">\n        <el-row :gutter=\"24\">\n          <el-col :span=\"8\">\n            <el-form-item label=\"受益所有人\" prop=\"bo_type\">\n              <el-select clearable v-model=\"bomisParams.editBomisForm.bo_type\" placeholder=\"请选择\"\n                class=\"formitem-full-width formitem-max-width\"\n                @change=\"bomisBoTypeChange(bomisParams.editBomisForm.bo_type, bomisParams.editBomisForm)\">\n                <el-option v-for=\"item in selectList.benefit_flag_list\" :key=\"item.k\" :label=\"item.v\" :value=\"item.k\">\n                </el-option>\n              </el-select>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <el-form-item label=\"企业性质\" prop=\"company_type\">\n              <el-select clearable v-model=\"bomisParams.editBomisForm.company_type\" placeholder=\"请选择\"\n                class=\"formitem-full-width formitem-max-width\"\n                @change=\"bomisCompanyTypeChange(bomisParams.editBomisForm.company_type, bomisParams.editBomisForm)\"\n                @visible-change=\"getBomisCompanyType(bomisParams.editBomisForm)\">\n                <el-option v-for=\"item in bomisParams.benefit_company_no_list\" :key=\"item.k\" :label=\"item.v\"\n                  :value=\"item.k\"> </el-option>\n              </el-select>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"24\">\n            <el-form-item prop=\"full_info_flag\">\n              <el-radio-group v-model=\"bomisParams.editBomisForm.full_info_flag\">\n                <el-radio key=\"full_info_flag01\" label=\"01\"\n                  @click.native=\"nativeRadioClick('01', bomisParams.editBomisForm, 'full_info_flag')\" value=\"01\">\n                  透明度较高、信息披露充分的客户（如上市公司、国有企业）</el-radio>\n                <el-radio key=\"full_info_flag02\" label=\"02\"\n                  @click.native=\"nativeRadioClick('02', bomisParams.editBomisForm, 'full_info_flag')\" value=\"02\">\n                  受益人信息不规范</el-radio>\n              </el-radio-group>\n              <div v-if=\"bomisParams.editBomisForm.full_info_flag === '01'\" style=\"color:#F56C6C;font-size:14px;line-height:22px;\">\n                <div>1、国有企业为经官方信息验证并确认属于国有独资公司、国有控股公司、全民所有制企业。</div>\n                <div>2、勾选后，仅需填写姓名、性别、国籍、出生年月，出生日期处需手动输入，格式为“1999-01”。</div>\n                <div>3、受益所有人身份证明文件的复印件请上传用于身份识别的照片。</div>\n              </div>\n              <div v-if=\"bomisParams.editBomisForm.full_info_flag === '02'\" style=\"color:#F56C6C;font-size:14px;line-height:22px;\">\n                勾选后，新客户仍为草稿状态，不进入审核流程；老客户自动设为强限制客户。\n              </div>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"24\">\n            <el-form-item label=\"受益所有权类型\" prop=\"bnf_type\">\n              <el-select clearable v-model=\"bomisParams.editBomisForm.bnf_type\" placeholder=\"请选择\" multiple\n                class=\"formitem-full-width formitem-24-max-width\"\n                @change=\"bomisBnfTypeChange(bomisParams.editBomisForm.bnf_type, bomisParams.editBomisForm)\"\n                @visible-change=\"getBomisBnfType(bomisParams.editBomisForm)\">\n                <el-option v-for=\"item in bomisParams.bnf_type_new_list\" :key=\"item.k\" :label=\"item.v\" :value=\"item.k\"\n                  :disabled=\"isBomisBnfTypeDisabled(item.k, bomisParams.editBomisForm)\">\n                </el-option>\n              </el-select>\n            </el-form-item>\n          </el-col>\n        </el-row>\n        <!-- 持有股权、股份或者合伙权益 -->\n        <el-row :gutter=\"24\"\n          v-if=\"bomisParams.editBomisForm.bnf_type.includes('NA1') || bomisParams.editBomisForm.bnf_type.includes('NB1') ||bomisParams.editBomisForm.bnf_type.includes('ND1') \">\n          <el-col :span=\"8\">\n            <el-form-item label=\"持有股权、股份或者合伙权益的比例（%)\" prop=\"acthdrat\">\n              <el-input-number v-model=\"bomisParams.editBomisForm.acthdrat\" :min=\"25\" :max=\"100\" :step=\"1\"\n                :precision=\"2\" controls-position=\"right\"\n                class=\"formitem-full-width formitem-max-width\" />\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <div style=\"height:28px;line-height:28px;font-size:14px;color:#606266;\">\n              <span v-if=\"bomisParams.editBomisForm.bnf_type.includes('NA1')\">形成日期(股权、股份) </span>\n              <span v-if=\"bomisParams.editBomisForm.bnf_type.includes('NB1')\">形成日期(合伙权益) </span>\n              <span v-if=\"bomisParams.editBomisForm.bnf_type.includes('ND1')\">形成日期(股权、份额) </span>\n              <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n              <span style=\"color:#F56C6C;font-size:12px;\">如需手动填写，请按照“1990-01-01”的格式填写</span>\n            </div>\n            <el-form-item prop=\"shareratiostartdate\">\n              <el-date-picker v-model=\"bomisParams.editBomisForm.shareratiostartdate\" type=\"date\" placeholder=\"选择日期\"\n                format=\"yyyy-MM-dd\" value-format=\"yyyy-MM-dd\" clearable editable\n                class=\"formitem-full-width formitem-max-width\" />\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <div style=\"height:28px;line-height:28px;font-size:14px;color:#606266;\">\n              终止日期(股权、股份)\n              <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n              <span style=\"color:#F56C6C;font-size:12px;\">如需手动填写，请按照“1990-01-01”的格式填写</span>\n            </div>\n            <el-form-item prop=\"shareratioenddate\">\n              <el-date-picker v-model=\"bomisParams.editBomisForm.shareratioenddate\" type=\"date\" placeholder=\"选择日期\"\n                format=\"yyyy-MM-dd\" value-format=\"yyyy-MM-dd\" clearable editable\n                class=\"formitem-full-width formitem-max-width\" />\n            </el-form-item>\n          </el-col>\n        </el-row>\n        <!-- 收益权 -->\n        <div\n          v-if=\"bomisParams.editBomisForm.bnf_type.includes('NA2-1') || bomisParams.editBomisForm.bnf_type.includes('NB2-1') || bomisParams.editBomisForm.bnf_type.includes('ND2-1')\"\n          :style=\"bomisPriBenefitWrapStyle(bomisParams.editBomisForm)\">\n        <el-row :gutter=\"24\">\n          <el-col :span=\"24\" style=\"margin-bottom: 8px;\">\n            <div style=\"font-size: 14px; font-weight: 600; color: #303133; line-height: 22px;\">\n              {{ bomisPriBenefitBlockTitle(bomisParams.editBomisForm, 'profit') }}\n            </div>\n          </el-col>\n          <el-col :span=\"8\">\n            <el-form-item label=\"持有收益权的比例(%)\" prop=\"actownerprofitratio\">\n              <el-input-number v-model=\"bomisParams.editBomisForm.actownerprofitratio\" :min=\"25\" :max=\"100\" :step=\"1\"\n                :precision=\"2\" controls-position=\"right\"\n                class=\"formitem-full-width formitem-max-width\" />\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <div style=\"height:28px;line-height:28px;font-size:14px;color:#606266;\">\n              形成日期(收益权)\n              <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n              <span style=\"color:#F56C6C;font-size:12px;\">如需手动填写，请按照“1990-01-01”的格式填写</span>\n            </div>\n            <el-form-item prop=\"profitratiostartdate\">\n              <el-date-picker v-model=\"bomisParams.editBomisForm.profitratiostartdate\" type=\"date\" placeholder=\"选择日期\"\n                format=\"yyyy-MM-dd\" value-format=\"yyyy-MM-dd\" clearable editable\n                class=\"formitem-full-width formitem-max-width\" />\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <div style=\"height:28px;line-height:28px;font-size:14px;color:#606266;\">\n              终止日期(收益权)\n              <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n              <span style=\"color:#F56C6C;font-size:12px;\">如需手动填写，请按照“1990-01-01”的格式填写</span>\n            </div>\n            <el-form-item prop=\"profitratioenddate\">\n              <el-date-picker v-model=\"bomisParams.editBomisForm.profitratioenddate\" type=\"date\" placeholder=\"选择日期\"\n                format=\"yyyy-MM-dd\" value-format=\"yyyy-MM-dd\" clearable editable\n                class=\"formitem-full-width formitem-max-width\" />\n            </el-form-item>\n          </el-col>\n        </el-row>\n        </div>\n        <!-- 表决权 -->\n        <div\n          v-if=\"bomisParams.editBomisForm.bnf_type.includes('NA2-2') || bomisParams.editBomisForm.bnf_type.includes('NB2-2') || bomisParams.editBomisForm.bnf_type.includes('ND2-2')\"\n          :style=\"bomisPriBenefitWrapStyle(bomisParams.editBomisForm)\">\n        <el-row :gutter=\"24\">\n          <el-col :span=\"24\" style=\"margin-bottom: 8px;\">\n            <div style=\"font-size: 14px; font-weight: 600; color: #303133; line-height: 22px;\">\n              {{ bomisPriBenefitBlockTitle(bomisParams.editBomisForm, 'vote') }}\n            </div>\n          </el-col>\n          <el-col :span=\"8\">\n            <el-form-item label=\"持有表决权的比例(%)\" prop=\"actownerprofitratiovote\">\n              <el-input-number v-model=\"bomisParams.editBomisForm.actownerprofitratiovote\" :min=\"25\" :max=\"100\"\n                :step=\"1\" :precision=\"2\" controls-position=\"right\"\n                class=\"formitem-full-width formitem-max-width\" />\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <div style=\"height:28px;line-height:28px;font-size:14px;color:#606266;\">\n              形成日期(表决权)\n              <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n              <span style=\"color:#F56C6C;font-size:12px;\">如需手动填写，请按照“1990-01-01”的格式填写</span>\n            </div>\n            <el-form-item prop=\"profitratiovotestartdate\">\n              <el-date-picker v-model=\"bomisParams.editBomisForm.profitratiovotestartdate\" type=\"date\"\n                placeholder=\"选择日期\" format=\"yyyy-MM-dd\" value-format=\"yyyy-MM-dd\" clearable editable\n                class=\"formitem-full-width formitem-max-width\" />\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <div style=\"height:28px;line-height:28px;font-size:14px;color:#606266;\">\n              终止日期(表决权)\n              <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n              <span style=\"color:#F56C6C;font-size:12px;\">如需手动填写，请按照“1990-01-01”的格式填写</span>\n            </div>\n            <el-form-item prop=\"profitratiovoteenddate\">\n              <el-date-picker v-model=\"bomisParams.editBomisForm.profitratiovoteenddate\" type=\"date\" placeholder=\"选择日期\"\n                format=\"yyyy-MM-dd\" value-format=\"yyyy-MM-dd\" clearable editable\n                class=\"formitem-full-width formitem-max-width\" />\n            </el-form-item>\n          </el-col>\n        </el-row>\n        </div>\n        <!-- 实际实施控制 -->\n        <el-row :gutter=\"24\">\n          <el-col :span=\"24\"\n            v-if=\"bomisParams.editBomisForm.bnf_type.includes('NA3-1') || bomisParams.editBomisForm.bnf_type.includes('NA3-2') || bomisParams.editBomisForm.bnf_type.includes('NB3-1') || bomisParams.editBomisForm.bnf_type.includes('NB3-2') || bomisParams.editBomisForm.bnf_type.includes('ND3')\">\n            <el-form-item prop=\"actctrltype\" label=\"实施实际控制的内容/方式\">\n              <el-select v-model=\"bomisParams.editBomisForm.actctrltype\" filterable placeholder=\"请选择\" clearable multiple\n                class=\"formitem-full-width formitem-24-max-width\">\n                <el-option v-for=\"item in selectList.benefit_actctrltype_list\" :key=\"item.k\" :label=\"item.v\"\n                  :value=\"item.k\">\n                </el-option>\n              </el-select>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"24\"\n            v-if=\"bomisParams.editBomisForm.bnf_type.includes('NA3-2') || bomisParams.editBomisForm.bnf_type.includes('NB3-2') || bomisParams.editBomisForm.bnf_type.includes('ND3')\">\n            <el-form-item prop=\"actotherforms\" label=\"其他形式的具体内容\">\n              <el-input v-model=\"bomisParams.editBomisForm.actotherforms\" placeholder=\"请输入\" clearable\n                class=\"formitem-full-width formitem-24-max-width\">\n              </el-input>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\"\n            v-if=\"bomisParams.editBomisForm.bnf_type.includes('NA3-1') || bomisParams.editBomisForm.bnf_type.includes('NA3-2') || bomisParams.editBomisForm.bnf_type.includes('NB3-1') || bomisParams.editBomisForm.bnf_type.includes('NB3-2') || bomisParams.editBomisForm.bnf_type.includes('ND3')\">\n            <div style=\"height:28px;line-height:28px;font-size:14px;color:#606266;\">\n              形成日期(实施实际控制)\n              <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n              <span style=\"color:#F56C6C;font-size:12px;\">如需手动填写，请按照“1990-01-01”的格式填写</span>\n            </div>\n            <el-form-item prop=\"obtainactdate\">\n              <el-date-picker v-model=\"bomisParams.editBomisForm.obtainactdate\" type=\"date\" placeholder=\"选择日期\"\n                format=\"yyyy-MM-dd\" clearable editable class=\"formitem-full-width formitem-max-width\" />\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\"\n            v-if=\"bomisParams.editBomisForm.bnf_type.includes('NA3-1') || bomisParams.editBomisForm.bnf_type.includes('NA3-2') || bomisParams.editBomisForm.bnf_type.includes('NB3-1') || bomisParams.editBomisForm.bnf_type.includes('NB3-2') || bomisParams.editBomisForm.bnf_type.includes('ND3')\">\n            <div style=\"height:28px;line-height:28px;font-size:14px;color:#606266;\">\n              终止日期(实施实际控制)\n              <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n              <span style=\"color:#F56C6C;font-size:12px;\">如需手动填写，请按照“1990-01-01”的格式填写</span>\n            </div>\n            <el-form-item prop=\"terminationactdate\">\n              <el-date-picker v-model=\"bomisParams.editBomisForm.terminationactdate\" type=\"date\" placeholder=\"选择日期\"\n                format=\"yyyy-MM-dd\" clearable editable class=\"formitem-full-width formitem-max-width\" />\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\"\n            v-if=\"bomisParams.editBomisForm.bnf_type.includes('NA3-1') || bomisParams.editBomisForm.bnf_type.includes('NB3-1') || bomisParams.editBomisForm.bnf_type.includes('ND3')\">\n            <el-form-item prop=\"actconuppermarket\" label=\"是否存在上一层备案主体\">\n              <el-select v-model=\"bomisParams.editBomisForm.actconuppermarket\" filterable placeholder=\"请选择\" clearable\n                class=\"formitem-full-width formitem-max-width\">\n                <el-option v-for=\"item in selectList.benefit_yesno_list\" :key=\"item.k\" :label=\"item.v\" :value=\"item.k\">\n                </el-option>\n              </el-select>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\"\n            v-if=\"(bomisParams.editBomisForm.bnf_type.includes('NA3-1') || bomisParams.editBomisForm.bnf_type.includes('NB3-1') || bomisParams.editBomisForm.bnf_type.includes('ND3')) && bomisParams.editBomisForm.actconuppermarket === 'Y'\">\n            <el-form-item prop=\"actconupperentname\" label=\"实际控制备案主体的上一层备案主体名称\">\n              <el-input v-model=\"bomisParams.editBomisForm.actconupperentname\" placeholder=\"请输入\" clearable\n                class=\"formitem-full-width formitem-max-width\">\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\"\n            v-if=\"(bomisParams.editBomisForm.bnf_type.includes('NA3-1') || bomisParams.editBomisForm.bnf_type.includes('NB3-1') || bomisParams.editBomisForm.bnf_type.includes('ND3')) && bomisParams.editBomisForm.actconuppermarket === 'Y'\">\n            <el-form-item prop=\"actconuniscid\" label=\"实际控制备案主体的统一社会信用代码\">\n              <el-input v-model=\"bomisParams.editBomisForm.actconuniscid\" placeholder=\"请输入\" clearable\n                class=\"formitem-full-width formitem-max-width\">\n            </el-form-item>\n          </el-col>\n        </el-row>\n        <!-- 负责日常经营管理 -->\n        <el-row :gutter=\"24\">\n          <el-col :span=\"16\"\n            v-if=\"bomisParams.editBomisForm.bnf_type.includes('NA4') || bomisParams.editBomisForm.bnf_type.includes('NB4')\">\n            <el-form-item prop=\"seniormgrpos\" label=\"负责日常经营管理的（高级管理）人员职位\">\n              <el-select v-model=\"bomisParams.editBomisForm.seniormgrpos\" filterable placeholder=\"请选择\" clearable\n                multiple class=\"formitem-full-width formitem-16-max-width\">\n                <el-option v-for=\"item in selectList.benefit_seniormgrpos_list\" :key=\"item.k\" :label=\"item.v\"\n                  :value=\"item.k\">\n                </el-option>\n              </el-select>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\"\n            v-if=\"(bomisParams.editBomisForm.bnf_type.includes('NA4') || bomisParams.editBomisForm.bnf_type.includes('NB4')) && bomisParams.editBomisForm.seniormgrpos.includes('15')\">\n            <el-form-item prop=\"actdailymgmtpostother\" label=\"公司章程规定的其他（高级管理）人员的具体职位\">\n              <el-input v-model=\"bomisParams.editBomisForm.actdailymgmtpostother\" placeholder=\"请输入\" clearable\n                class=\"formitem-full-width formitem-max-width\">\n            </el-form-item>\n          </el-col>\n        </el-row>\n        <!-- 在华最高层级的高级管理 -->\n        <el-row :gutter=\"24\">\n          <el-col :span=\"16\" v-if=\"bomisParams.editBomisForm.bnf_type.includes('NA5')\">\n            <el-form-item prop=\"seniormgrposcn\" label=\"在华最高层级的高级管理人员职位\">\n              <el-select v-model=\"bomisParams.editBomisForm.seniormgrposcn\" filterable placeholder=\"请选择\" clearable\n                multiple class=\"formitem-full-width formitem-16-max-width\">\n                <el-option v-for=\"item in selectList.benefit_seniormgrposcn_list\" :key=\"item.k\" :label=\"item.v\"\n                  :value=\"item.k\">\n                </el-option>\n              </el-select>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\"\n            v-if=\"bomisParams.editBomisForm.bnf_type.includes('NA5') && bomisParams.editBomisForm.seniormgrposcn.includes('1')\">\n            <el-form-item prop=\"ownerrightmgmtpostother\" label=\"在华最高层级的高级管理其他职位\">\n              <el-input v-model=\"bomisParams.editBomisForm.ownerrightmgmtpostother\" placeholder=\"请输入\" clearable\n                class=\"formitem-full-width formitem-max-width\">\n            </el-form-item>\n          </el-col>\n        </el-row>\n        <el-row :gutter=\"24\">\n          <el-col :span=\"8\">\n            <el-form-item label=\"姓名\" prop=\"related_name\">\n              <el-select clearable v-model=\"bomisParams.editBomisForm.related_name\" allow-create filterable\n                placeholder=\"请选择或手动输入\" @focus=\"selectRelaOptions('0')\"\n                :disabled=\"bomisParams.editBomisForm.new_flag ? false : true\"\n                @change=\"setRelaValue(bomisParams.editBomisForm.related_name,'bomisForm')\" default-first-option\n                class=\"formitem-full-width formitem-max-width\">\n                <el-option v-for=\"item in curRelaOptions\" :key=\"item.related_id\" :label=\"item.related_name\"\n                  :value=\"item.related_name\">\n                </el-option>\n              </el-select>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <el-form-item prop=\"id_type\" label=\"证件类型\">\n              <el-select v-model=\"bomisParams.editBomisForm.id_type\" placeholder=\"请选择\" clearable\n                @change=\"clearIdNoValidate('editBomisForm')\" class=\"formitem-full-width formitem-max-width\">\n                <el-option v-for=\"item in selectList.id_type_gr_list\" :key=\"item.k\" :label=\"item.v\" :value=\"item.k\">\n                </el-option>\n              </el-select>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <el-form-item prop=\"id_no\" label=\"证件编号\">\n              <el-input v-model=\"bomisParams.editBomisForm.id_no\" placeholder=\"请输入\" clearable\n                class=\"formitem-full-width formitem-max-width\">\n              </el-input>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <div style=\"height:28px;line-height:28px;font-size:14px;color:#606266;\">\n              证件有效期\n              <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n              <span style=\"color:#F56C6C;font-size:12px;\">如需手动填写，请按照“1990-01-01”的格式填写</span>\n            </div>\n            <div style=\"display:flex;width:100%;gap:8px;\" class=\"formitem-max-width\">\n              <el-form-item prop=\"id_begindate\" style=\"flex:1;\">\n                <el-date-picker v-model=\"bomisParams.editBomisForm.id_begindate\" type=\"date\" placeholder=\"开始日期\"\n                  class=\"formitem-full-width\" format=\"yyyy-MM-dd\" clearable>\n                </el-date-picker>\n              </el-form-item>\n              <div>~</div>\n              <el-form-item prop=\"id_enddate\" style=\"flex:1;\">\n                <el-date-picker v-model=\"bomisParams.editBomisForm.id_enddate\" type=\"date\" placeholder=\"结束日期\"\n                  class=\"formitem-full-width\" format=\"yyyy-MM-dd\" align=\"right\"\n                  :picker-options=\"bomisParams.pickerOptions\" clearable>\n                </el-date-picker>\n              </el-form-item>\n            </div>\n          </el-col>\n          <el-col :span=\"8\">\n            <el-form-item prop=\"gender\" label=\"性别\">\n              <el-select v-model=\"bomisParams.editBomisForm.gender\" placeholder=\"请选择\"\n                class=\"formitem-full-width formitem-max-width\">\n                <el-option v-for=\"item in selectList.benefit_gender_list\" :key=\"item.k\" :label=\"item.v\" :value=\"item.k\">\n                </el-option>\n              </el-select>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <el-form-item prop=\"nationality\" label=\"国籍\">\n              <el-select v-model=\"bomisParams.editBomisForm.nationality\" filterable placeholder=\"请选择\" clearable\n                class=\"formitem-full-width formitem-max-width\">\n                <el-option v-for=\"item in selectList.nationality_list\" :key=\"item.k\" :label=\"item.v\" :value=\"item.k\">\n                </el-option>\n              </el-select>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <div style=\"height:28px;line-height:28px;font-size:14px;color:#606266;\">\n              出生年月\n              <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n              <span style=\"color:#F56C6C;font-size:12px;\">请按照“1990-01-01”的格式填写</span>\n            </div>\n            <el-form-item prop=\"birthday\">\n              <el-input v-model=\"bomisParams.editBomisForm.birthday\" placeholder=\"\" clearable\n                class=\"formitem-full-width formitem-max-width\" />\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <el-form-item prop=\"mobno1\" label=\"联系方式（手机）\">\n              <el-input v-model=\"bomisParams.editBomisForm.mobno1\" placeholder=\"请输入\" clearable\n                class=\"formitem-full-width formitem-max-width\"></el-input>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <el-form-item prop=\"mobno2\" label=\"联系方式（固话）\">\n              <el-input v-model=\"bomisParams.editBomisForm.mobno2\" placeholder=\"请输入\" clearable\n                class=\"formitem-full-width formitem-max-width\"></el-input>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <el-form-item label=\"联系地址\" prop=\"address\">\n              <el-input v-model=\"bomisParams.editBomisForm.address\" placeholder=\"联系地址\"\n                class=\"formitem-full-width formitem-max-width\"></el-input>\n            </el-form-item>\n          </el-col>\n        </el-row>\n\n      </el-form>\n    </div>\n    <div slot=\"footer\" class=\"dialog-footer\">\n      <el-button @click=\"closeDialog('bomisDialog')\">取消</el-button>\n      <el-button type=\"primary\" @click=\"addNewBomisBnfInfo('1')\">提交并录入下一条</el-button>\n      <el-button type=\"primary\" @click=\"addNewBomisBnfInfo('2')\">提交</el-button>\n    </div>\n  </el-dialog>\n  \n</div>\n`,\n  data() {\n    return {\n      curRelaOptions: [],\n      shouldHideRequiredMark: false,\n      organ_flag: '_$organ_flag$_',\n      client_id: '_$client_id$_',\n      selectList: Object.assign({}, app.data.selectList || {}, {\n        'nationality_list': [],\n        'id_type_list': [],\n        'id_type_gr_list': [],\n        'related_type_list': [],\n        'beneficiary_list': [] // 受益所有人类型列表\n      }),\n      uploadParams: {\n        objectId: Wb.getId(),\n        client_id: app.basicInfo.vue.client_id,\n      },\n      personList: [],\n      dialogFormVisible: false,\n      beneficiaryOnly: false,\n      editForm: {\n        related_name: '',\n        nationality: '',\n        id_type: '',\n        id_no: '',\n        licenseDate: '',\n        id_begindate: '',\n        id_enddate: '',\n        is_government_dept: '',\n        birthday: '',\n        related_type: '',\n        beneficiary: '', // 受益所有人类型\n        shareholding_ratio: '', // 股权/表决权比例\n        address: '', // 联系地址\n        mobno1: ''\n      },\n      fileList: [],\n      selectedTags: [],// 自然人主体已选择的标签（用于判断法定代表人和授权代表人的删除）\n      curSelectedTags: [],//当前弹窗已选择的关联人标签\n      attachments: [],\n      tags: [{\n        label: '法定代表人', related_type: '1', active: false, show: true, tag_type: 'default'\n      }, {\n        label: '控股股东', related_type: '2', active: false, show: true, tag_type: 'default'\n      }, {\n        label: '实际控制人', related_type: '3', active: false, show: true, tag_type: 'default'\n      }, {\n        label: '授权代表人', related_type: '4', active: false, show: true, tag_type: 'default'\n      }, {\n        label: '受益所有人', related_type: '5', active: false, show: true, tag_type: 'default'\n      }],\n      pickerOptions: {\n        shortcuts: [{\n          text: '长期',\n          onClick(picker) {\n            picker.$emit('pick', '2100-12-31')\n          }\n        }]\n      },\n      editFormRules: {\n        shareholding_ratio: [\n          {\n            validator: (rule, value, callback) => {\n              if (value) {\n                const num = Number(value);\n                if (isNaN(num) || num <= 0 || num > 100) {\n                  callback(new Error('请输入大于0且小于等于100的数字'));\n                } else {\n                  callback();\n                }\n              }\n\n            },\n            trigger: 'change'\n          }\n        ]\n      }\n,\n      bomisParams: {\n        dialogBomisVisible: false, // bomis受益人核验窗口\n        benefitEditDialogVisible: false, // bomis受益人核验窗口中编辑单个受益人信息\n        onlineBomisCheckBtnDisable: true,\n        benefit_company_no_list: [], // 需要对this.selectList.benefit_company_no_list结合受益人类型进行过滤\n        bnf_type_new_list: [], // 需要对this.selectList.bnf_type_new_list结合企业性质进行过滤\n        cityOptions: [], // 地址\n        districtOptions: [], // 地址\n        editBomisForm: {\n          bo_type: '', // 受益人类型\n          company_type: '', // 企业性质\n          bnf_type: [],\n          common_rate: '',\n          full_info_flag: '',\n\n          actctrltype: [],\n          seniormgrpos: [],\n          seniormgrposcn: [],\n\n          related_name: '',\n          organ_flag: '0',\n          nationality: '',\n          id_type: '',\n          id_no: '',\n          id_begindate: '',\n          id_enddate: '',\n          birthday: '',\n          is_government_dept: '',\n          related_type: '',\n          title: '',\n          beneficiary: '',\n          shareholding_ratio: '',\n\n          province: '',\n          city: '',\n          district: '',\n          address: '',\n\n          mobno1: '',\n          mobno2: '',\n          gender: '',\n          new_flag: true,\n          data_status: '0',\n          acthdrat: undefined,\n          shareratiostartdate: '',\n          shareratioenddate: '',\n          actownerprofitratio: undefined,\n          profitratiostartdate: '',\n          profitratioenddate: '',\n          actownerprofitratiovote: undefined,\n          profitratiovotestartdate: '',\n          profitratiovoteenddate: '',\n          actotherforms: '',\n          obtainactdate: '',\n          terminationactdate: '',\n          actconuppermarket: '',\n          actconupperentname: '',\n          actconuniscid: '',\n          actdailymgmtpostother: '',\n          ownerrightmgmtpostother: '',\n          actctrlcpny: '',\n        },\n        editBomisFormRules: { related_name: [{ required: true, message: '请填写姓名', trigger: 'blur' }] },\n        pickerOptions: {\n          shortcuts: [{\n            text: '长期',\n            onClick(picker) {\n              picker.$emit('pick', '9999-12-31')\n            }\n          }]\n        },\n        bomisSourceTableData: [], // 待发送核验的受益人数据\n        bomisLastCheckResult: {\n          \"RETURN_CODE\": \"\",\n          \"RETURN_MSG\": \"\",\n          \"NoDiffList\": [],\n          \"COMPARE_REMARK\": \"\"\n        },\n        bomisLastCheckResultList: [], // 核验后返回的受益人数据\n        editOneBenefitForm: {\n          bo_type: '', // 受益人类型\n          company_type: '', // 企业性质\n          bnf_type: [],\n          common_rate: '',\n          full_info_flag: '',\n\n          actctrltype: [],\n          seniormgrpos: [],\n          seniormgrposcn: [],\n\n          related_name: '',\n          organ_flag: '0',\n          nationality: '',\n          id_type: '',\n          id_no: '',\n          id_begindate: '',\n          id_enddate: '',\n          birthday: '',\n          is_government_dept: '',\n          related_type: '',\n          title: '',\n          beneficiary: '',\n          shareholding_ratio: '',\n\n          province: '',\n          city: '',\n          district: '',\n          address: '',\n\n          mobno1: '',\n          mobno2: '',\n          gender: '',\n          new_flag: false,\n          data_status: '0',\n          acthdrat: undefined,\n          shareratiostartdate: '',\n          shareratioenddate: '',\n          actownerprofitratio: undefined,\n          profitratiostartdate: '',\n          profitratioenddate: '',\n          actownerprofitratiovote: undefined,\n          profitratiovotestartdate: '',\n          profitratiovoteenddate: '',\n          actotherforms: '',\n          obtainactdate: '',\n          terminationactdate: '',\n          actconuppermarket: '',\n          actconupperentname: '',\n          actconuniscid: '',\n          actdailymgmtpostother: '',\n          ownerrightmgmtpostother: '',\n          actctrlcpny: '',\n        },\n        editOneBenefitFormRules: {\n          bo_type: [{ required: true, message: '请选择是否识别受益所有人', trigger: 'change' }],\n          company_type: [{ required: true, message: '请选择企业性质', trigger: 'change' }],\n          full_info_flag: [{ required: true, message: '请选择', trigger: 'change' }],\n          actctrltype: [{ required: true, message: '请选择', trigger: 'change' }],\n          actotherforms: [{ required: true, message: '请填写', trigger: 'change' }],\n          obtainactdate: [{ required: true, message: '请选择', trigger: 'change' }],\n          terminationactdate: [{ required: true, message: '请选择', trigger: 'change' }],\n          actconuppermarket: [{ required: true, message: '请选择', trigger: 'change' }],\n          actconupperentname: [{ required: true, message: '请填写', trigger: 'change' }],\n          actconuniscid: [{ required: true, message: '请填写', trigger: 'change' }],\n          seniormgrpos: [{ required: true, message: '请选择', trigger: 'change' }],\n          actdailymgmtpostother: [{ required: true, message: '请填写', trigger: 'change' }],\n          seniormgrposcn: [{ required: true, message: '请选择', trigger: 'change' }],\n          ownerrightmgmtpostother: [{ required: true, message: '请填写', trigger: 'change' }],\n\n          related_name: [{ required: true, message: '请填写', trigger: 'change' }],\n          gender: [{ required: true, message: '请填写', trigger: 'change' }],\n          nationality: [{ required: true, message: '请填写', trigger: 'change' }],\n          birthday: [{ required: true, message: '请填写', trigger: 'change' }],\n        },\n      },\n    };\n  },\n  methods: {\n    // 页面展示数据字典转换\n    formatDictMap(dictType, key) {\n      const dictData = this.selectList[dictType] || [];\n      const item = dictData.find(item => item.k === key);\n      return item ? item.v : '-';\n    },\n    // 关联人标签选中\n    toggleTag(tag) {\n      tag.active = !tag.active;\n      if (tag.active && this.curSelectedTags.indexOf(tag.related_type) == -1) {\n        this.curSelectedTags.push(tag.related_type);\n      }\n      if (!tag.active) {\n        const index = this.curSelectedTags.indexOf(tag.related_type);\n        if (index !== -1) {\n          this.curSelectedTags.splice(index, 1);\n        }\n      }\n      console.log(\"this.curSelectedTags\", this.curSelectedTags);\n    },\n    // 查询机构主体/自然人主体\n    selectOrganEntity(client_id, organ_flag) {\n      let that = this;\n      Wb.ajax({\n        url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/select_organ_entity',\n        params: {\n          CLIENT_ID: client_id,\n          ORGAN_FLAG: organ_flag\n        },\n        success(resp) {\n          console.log(\"重新查询机构主体/自然人主体\");\n          let res = Wb.decode(resp).items || [];\n\n          // 1. 数据聚合逻辑\n          const personMap = new Map();\n          res.forEach(item => {\n            const key = [\n              item.related_name, item.id_type, item.id_no,\n              item.id_begindate, item.id_enddate, item.birthday, item.nationality\n            ].join('||');\n\n            if (personMap.has(key)) {\n              const existing = personMap.get(key);\n              if (!existing.related_type.includes(item.related_type)) {\n                existing.related_type.push(item.related_type);\n              }\n              existing.related_id.push(item.related_id);\n              if (String(item.related_type) === '5') existing.benefitInfo = Object.assign({}, item);\n\n              // 如果是受益所有人，保存受益所有人相关字段（取第一条）\n              if (item.related_type === '5' && !existing.beneficiary) {\n                existing.beneficiary = item.beneficiary;\n                existing.shareholding_ratio = item.shareholding_ratio;\n                existing.address = item.address;\n              }\n              // 如果是法定代表人或授权代表人，保存联系方式（取第一条）\n              if ((item.related_type === '1' || item.related_type === '4') && !existing.mobno1) {\n                existing.mobno1 = item.mobno1;\n              }\n            } else {\n              const newItem = { ...item };\n              if (String(item.related_type) === '5') newItem.benefitInfo = Object.assign({}, item);\n              newItem.related_type = [item.related_type];\n              newItem.related_id = [item.related_id];\n              personMap.set(key, newItem);\n            }\n          });\n\n          that.personList = Array.from(personMap.values());\n\n          // --- 关键修复：检查 personList 中是否包含 '1'(法人) 或 '4'(授权) ---\n          // 因为 related_type 是数组，我们需要用 some 配合 includes\n          const hasFddbr = that.personList.some(person => person.related_type.includes('1'));\n          const hasSqdbr = that.personList.some(person => person.related_type.includes('4'));\n\n          // --- 更新标签显隐逻辑 ---\n          // 如果全局存在 法人(1)，则所有非编辑该法人的弹窗都隐藏 法人 标签\n          that.tags.forEach(tag => {\n            if (tag.related_type === '1') {\n              tag.show = !hasFddbr; // 如果有法人了，这里设为 false (隐藏)\n            } else if (tag.related_type === '4') {\n              tag.show = !hasSqdbr; // 如果有授权了，这里设为 false (隐藏)\n            } else {\n              tag.show = true; // 其他标签（股东、实控、受益）始终显示\n            }\n          });\n\n          // 注意：这里不再需要 related_types 数组来控制显隐，因为我们直接控制了 tags 的 show\n        }\n      });\n    },\n    // 删除自然人主体\n    deleteRalated(item) {\n      let that = this;\n      Wb.ajax({\n        url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/delete_organ_entity',\n        params: {\n          CLIENT_ID: app.basicInfo.vue.client_id,\n          RELATED_NAME: item.related_name\n        },\n        success(resp) {\n          Wb.tipSucc(\"删除成功\");\n          that.selectOrganEntity(app.basicInfo.vue.client_id, '0');\n        }\n      });\n    },\n    // 显示弹窗\n    editNaturalPerson(item) {\n      if (!item.benefitInfo) { this.showDialog('2', item); return; }\n      this.resetBomisAddForm();\n      this.bomisParams.editBomisForm = this.normalizeBomisBenefitForm(item.benefitInfo);\n      this.bomisParams.editBomisForm.title = '编辑受益所有人';\n      this.bomisParams.editBomisFormRules = {\n        related_name: [{ required: true, message: '请填写姓名', trigger: 'blur' }]\n      };\n      this.getBomisCompanyType(this.bomisParams.editBomisForm);\n      this.getBomisBnfType(this.bomisParams.editBomisForm);\n      this.bomisParams.dialogBomisVisible = true;\n      this.$nextTick(() => { if (this.$refs.editBenefitForm) this.$refs.editBenefitForm.clearValidate(); });\n    },\n    showNewBomisAddDialog() {\n      this.resetBomisAddForm();\n      this.bomisParams.editBomisForm.related_id = '';\n      this.bomisParams.editBomisForm.title = '受益所有人';\n      this.bomisParams.editBomisForm.related_type = '5';\n      this.bomisParams.editBomisForm.organ_flag = '0';\n      this.bomisParams.editBomisForm.new_flag = true;\n      this.bomisParams.editBomisFormRules = {\n        related_name: [{ required: true, message: '请填写姓名', trigger: 'blur' }]\n      };\n      this.bomisParams.dialogBomisVisible = true;\n    },\n    bomisBnfTypeChange(newVal, form) {\n      form.bnf_type = this.normalizeBnfTypeSelection(newVal);\n    },\n    addNewBomisBnfInfo(op_flag) {\n      var that = this;\n      that.$refs.editBenefitForm.validate(function (valid) {\n        if (!valid) return;\n        Wb.ajax({\n          url: that.bomisParams.editBomisForm.new_flag === false\n            ? 'm?xwl=syr_2/edit_bomis_benefit_scinfo_clf20261026'\n            : 'm?xwl=syr_2/add_bomis_benefit_scinfo_clf20261026',\n          params: { client_id: '_$client_id$_', benefit_scinfo: that.bomisParams.editBomisForm },\n          json: true,\n          success(resp) {\n            if (resp.O_RETURN_CODE !== -1) {\n              Wb.tipSucc(that.bomisParams.editBomisForm.new_flag === false ? '保存成功' : '添加成功');\n              that.selectOrganEntity(app.basicInfo.vue.client_id, '0');\n              if (op_flag === '1') {\n                that.showNewBomisAddDialog();\n                that.bomisParams.editBomisForm.title = '受益所有人';\n                that.bomisParams.editBomisFormRules = {\n                  related_name: [{ required: true, message: '请填写姓名', trigger: 'blur' }]\n                };\n              } else {\n                that.bomisParams.dialogBomisVisible = false;\n              }\n            } else {\n              Wb.error(resp.O_RETURN_MSG);\n            }\n          }\n        });\n      });\n    },\n    showDialog(val, item, beneficiaryOnly) {\n      let that = this;\n      this.beneficiaryOnly = !!beneficiaryOnly;\n\n      // 1. 重置所有标签状态\n      this.tags.forEach(tag => {\n        tag.active = false;\n        // 注意：这里不要在这里重置 tag.show，因为 show 是由全局 personList 控制的\n        // 我们只在 selectOrganEntity 里更新 show\n      });\n\n      // 2. 重新获取最新的 personList 状态（或者使用 Vue 的响应式数据）\n      // 这里直接使用 this.personList，因为它应该已经被 selectOrganEntity 更新了\n      const hasFddbrGlobal = this.personList.some(p => p.related_type.includes('1'));\n      const hasSqdbrGlobal = this.personList.some(p => p.related_type.includes('4'));\n\n      // 3. 处理新增\n      if (val == '1') {\n        console.log(\"打开新增弹窗\");\n\n        // 新增时：如果全局已有 法人 或 授权，则在标签组里禁用（隐藏）它们\n        this.tags.forEach(tag => {\n          if (tag.related_type === '1') tag.show = !hasFddbrGlobal;\n          if (tag.related_type === '4') tag.show = !hasSqdbrGlobal;\n        });\n\n        this.editForm = {\n          related_name: '',\n          nationality: '',\n          id_type: '',\n          id_no: '',\n          id_begindate: '',\n          id_enddate: '',\n          is_government_dept: '',\n          birthday: '',\n          related_type: '',\n          beneficiary: '',\n          shareholding_ratio: '',\n          address: '',\n          mobno1: '',\n          data_status: '0',\n          new_flag: true,\n          related_id: ''\n        };\n        this.curSelectedTags = this.beneficiaryOnly ? ['5'] : [];\n        this.tags.forEach(tag => { tag.active = this.beneficiaryOnly && tag.related_type === '5'; });\n        this.dialogFormVisible = true;\n      }\n      // 4. 处理编辑\n      else if (val == '2') {\n        console.log(\"打开编辑弹窗\", item);\n\n        // 查询当前这个人到底有哪些标签（这里需要查询接口，因为 editForm 需要精确数据）\n        Wb.ajax({\n          url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/select_organ_entity',\n          params: {\n            CLIENT_ID: app.basicInfo.vue.client_id,\n            ORGAN_FLAG: '0',\n            RELATED_NAME: item.related_name\n          },\n          success(resp) {\n            let res = Wb.decode(resp).items || [];\n\n            // 获取当前这个人拥有的所有标签\n            const currentPersonTypes = res.map(itm => String(itm.related_type));\n            that.curSelectedTags = currentPersonTypes;\n\n            // --- 关键修复：编辑时的显隐逻辑 ---\n            // 编辑时，我们需要根据“除了当前这个人之外”的其他人，来决定是否显示 法人/授权\n            const othersList = that.personList.filter(p => {\n              // 这里的过滤逻辑比较复杂：我们要找的是“除了当前正在编辑的这个人之外”的列表\n              // 因为 personList 是聚合后的，我们通过姓名+证件号来判断是否是同一人\n              const personKey = [p.related_name, p.id_type, p.id_no, p.id_begindate, p.id_enddate, p.birthday, p.nationality].join('||');\n              const itemKey = [item.related_name, item.id_type, item.id_no, item.id_begindate, item.id_enddate, item.birthday, item.nationality].join('||');\n              return personKey !== itemKey;\n            });\n\n            // 检查“其他人”里有没有 法人 和 授权\n            const hasFddbrOthers = othersList.some(p => p.related_type.includes('1'));\n            const hasSqdbrOthers = othersList.some(p => p.related_type.includes('4'));\n\n            // 设置标签显隐：\n            // 如果“其他人”里有 法人，那么当前编辑弹窗里就不显示 法人 标签（除非当前编辑的人本身就是法人）\n            that.tags.forEach(tag => {\n              if (tag.related_type === '1') {\n                // 只有当“其他人”里没有 法人 时，才显示；或者当前编辑的人就是法人（让他能取消勾选）\n                tag.show = !hasFddbrOthers || currentPersonTypes.includes('1');\n              } else if (tag.related_type === '4') {\n                tag.show = !hasSqdbrOthers || currentPersonTypes.includes('4');\n              } else {\n                tag.show = true;\n              }\n\n              // 设置选中状态\n              tag.active = currentPersonTypes.includes(tag.related_type);\n            });\n\n            // 赋值表单数据（使用聚合后的数据或者第一条数据）\n            that.editForm = {\n              nationality: item.nationality,\n              id_type: item.id_type,\n              id_no: item.id_no,\n              id_begindate: item.id_begindate,\n              id_enddate: item.id_enddate,\n              birthday: item.birthday,\n              is_government_dept: item.is_government_dept,\n              data_status: item.data_status,\n              related_name: item.related_name,\n              related_type: item.related_type, // 这个字段在提交时其实用不到，因为我们用 curSelectedTags\n              related_id: item.related_id, // 聚合后的 related_id 数组，或者第一条的 ID\n              beneficiary: item.beneficiary || '', // 受益所有人类型\n              shareholding_ratio: item.shareholding_ratio || '', // 股权/表决权比例\n              address: item.address || '', // 联系地址\n              mobno1: item.mobno1 || '',\n              new_flag: false\n            };\n\n            that.dialogFormVisible = true;\n          }\n        });\n        return;\n      }\n    },\n\n    // 提交表单\n    submitForm(val) {\n      let that = this;\n\n      // 先验证表单规则\n      // this.$refs.editFormRef.validate((valid) => {\n      // if (!valid) {\n      //   return false;\n      // }\n\n      that.submitFormData(val);\n      // });\n    },\n    // 提交表单数据\n    submitFormData(val) {\n      let that = this;\n\n      if (!this.editForm.related_name) {\n        this.$message.error(\"请填写名称！\");\n        return;\n      }\n      if (this.curSelectedTags.length == 0) {\n        this.$message.error(\"请选择关联主体标签！\");\n        return;\n      }\n\n      // 校验受益所有人特有字段\n      // if (this.curSelectedTags.includes('5')) {\n      //   if (!this.editForm.beneficiary) {\n      //     this.$message.error(\"请选择受益所有人类型！\");\n      //     return;\n      //   }\n      //   // 当受益所有人类型不是A1、A2、B1、D1时，股权/表决权比例为必填\n      //   if (!['A1', 'A2', 'B1', 'D1'].includes(this.editForm.beneficiary)) {\n      //     if (!this.editForm.shareholding_ratio) {\n      //       this.$message.error(\"请填写股权/表决权比例！\");\n      //       return;\n      //     }\n      //   }\n      //   if (!this.editForm.address) {\n      //     this.$message.error(\"请填写联系地址！\");\n      //     return;\n      //   }\n      // }\n\n      let commonData = {\n        CLIENT_ID: app.basicInfo.vue.client_id,\n        RELATED_NAME: this.editForm.related_name,\n        ORGAN_FLAG: '0',\n        ID_TYPE: this.editForm.id_type,\n        ID_NO: this.editForm.id_no,\n        ID_BEGINDATE: this.editForm.id_begindate,\n        ID_ENDDATE: this.editForm.id_enddate,\n        NATIONALITY: this.editForm.nationality,\n        BIRTHDAY: this.editForm.birthday,\n        IS_GOVERNMENT_DEPT: this.editForm.is_government_dept,\n        DATA_STATUS: this.editForm.data_status,\n        OBJECT_ID: '' // 编辑时带上ID\n      };\n\n      const batchList = this.curSelectedTags.map(related_type => {\n        const item = {\n          ...commonData,\n          RELATED_TYPE: related_type,\n          CREATE_USER: '_$sys.username$_',\n          UPDATE_USER: '_$sys.username$_'\n        };\n\n        // 只有受益所有人(related_type==='5')才保存这三个字段\n        if (related_type === '5') {\n          item.BENEFICIARY = this.editForm.beneficiary;\n          // 当受益所有人类型不是A1、A2、B1、D1时，才保存股权/表决权比例\n          if (['A1', 'A2', 'B1', 'D1'].includes(this.editForm.beneficiary)) {\n            item.SHAREHOLDING_RATIO = this.editForm.shareholding_ratio;\n          }\n          item.ADDRESS = this.editForm.address;\n        }\n\n        // 法定代表人（1）和授权代表人（4）才保存联系方式\n        if (related_type === '1' || related_type === '4') {\n          item.MOBNO1 = this.editForm.mobno1;\n        }\n\n        return item;\n      });\n      // 1. 新增\n      if (this.editForm.new_flag) {\n        Wb.ajax({\n          url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/select_organ_entity',\n          params: {\n            CLIENT_ID: app.basicInfo.vue.client_id,\n            ORGAN_FLAG: '0',\n            RELATED_NAME: this.editForm.related_name\n          },\n          success(resp) {\n            let res = Wb.decode(resp).items || [];\n            let hasDuplicate = false;\n            let duplicateTypeName = \"\";\n\n            for (let i = 0; i < batchList.length; i++) {\n              let target = batchList[i];\n              let found = res.some(function (item) {\n                return String(item.RELATED_NAME || item.related_name) === String(target.RELATED_NAME) &&\n                  String(item.RELATED_TYPE || item.related_type) === String(target.RELATED_TYPE);\n              });\n\n              if (found) {\n                hasDuplicate = true;\n                duplicateTypeName = that.formatDictMap('related_type_list', target.RELATED_TYPE);\n                break;\n              }\n            }\n\n            if (!hasDuplicate) {\n              for (let i = 0; i < batchList.length; i++) {\n                let type = batchList[i].RELATED_TYPE;\n                if (type === '1' || type === '4') {\n                  let existsInGlobal = that.personList.some(p => String(p.related_type) === String(type));\n                  if (existsInGlobal) {\n                    hasDuplicate = true;\n                    duplicateTypeName = that.formatDictMap('related_type_list', type);\n                    break;\n                  }\n                }\n              }\n            }\n\n            if (hasDuplicate) {\n              Wb.error(\"已存在主体名称为“\" + batchList[0].RELATED_NAME + \"”的【\" + duplicateTypeName + \"】信息，请勿重复添加！\");\n              return;\n            }\n            Wb.ajax({\n              url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/save_organ_entity',\n              params: {\n                batchList: batchList\n              },\n              success(saveResp) {\n                Wb.tipSucc(\"添加成功\");\n                that.selectOrganEntity(app.basicInfo.vue.client_id, '0');\n                that.editForm = {\n                  related_name: '',\n                  nationality: '',\n                  id_type: '',\n                  id_no: '',\n                  id_begindate: '',\n                  id_enddate: '',\n                  is_government_dept: '',\n                  birthday: '',\n                  related_type: '',\n                  beneficiary: '',\n                  shareholding_ratio: '',\n                  address: '',\n                  mobno1: ''\n                };\n                if (val == '1') {//提交并录入下一个\n                  that.editForm.new_flag = true;\n                  that.curSelectedTags = that.beneficiaryOnly ? ['5'] : [];\n                  that.tags.forEach(tag => {\n                    tag.active = that.beneficiaryOnly && tag.related_type === '5';\n                  });\n                } else if (val == '2') {\n                  that.dialogFormVisible = false;\n                  that.curSelectedTags = [];\n                  that.tags.forEach(tag => {\n                    tag.active = false;\n                  });\n                }\n              }\n            });\n          }\n        });\n      } else {\n        // 2. 编辑\n        Wb.ajax({\n          url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/update_organ_entity',\n          params: {\n            batchList: batchList\n          },\n          success(resp) {\n            Wb.tipSucc(\"编辑成功\");\n            that.selectOrganEntity(app.basicInfo.vue.client_id, '0');\n            if (val == '1') {//提交并录入下一个\n              that.editForm.new_flag = true;\n            } else if (val == '2') {\n              that.dialogFormVisible = false;\n            }\n            that.curSelectedTags = [];\n            that.tags.forEach(tag => {\n              tag.active = false;\n            });\n          }\n        });\n      }\n    },\n    clearRatio() {\n      if (this.editForm.beneficiary != 'A1' && this.editForm.beneficiary != 'A2' && this.editForm.beneficiary != 'B1' && this.editForm.beneficiary != 'D1') {\n        this.editForm.shareholding_ratio = null;\n      }\n    },\n        beforeRemove(file, fileList) {\n      // 直接返回 false，阻止删除\n      return false;\n\n      // 如果你希望给用户一个提示，可以这样写：\n      // this.$message.warning('当前附件不允许删除');\n      // return false;\n    },\n        bomisBnfIncludes(item, code) {\n      if (!item) { return false; }\n      var t = item.bnf_type;\n      if (Array.isArray(t)) {\n        return t.indexOf(code) >= 0;\n      }\n      var s = item.bnf_type_str || t || '';\n      return String(s).split(',').indexOf(code) >= 0;\n    },\n        bomisBoTypeChange: function (newValue, form) {\n      if (newValue !== '1' && newValue !== '2' && newValue !== '') {\n        return;\n      }\n      form.company_type = '';\n      form.bnf_type = [];\n      form.common_rate = '';\n      form.actctrltype = [];\n      form.seniormgrpos = [];\n      form.seniormgrposcn = [];\n      form.acthdrat = undefined;\n      form.shareratiostartdate = '';\n      form.shareratioenddate = '';\n      form.actownerprofitratio = undefined;\n      form.profitratiostartdate = '';\n      form.profitratioenddate = '';\n      form.actownerprofitratiovote = undefined;\n      form.profitratiovotestartdate = '';\n      form.profitratiovoteenddate = '';\n      form.actotherforms = '';\n      form.obtainactdate = '';\n      form.terminationactdate = '';\n      form.actconuppermarket = '';\n      form.actconupperentname = '';\n      form.actconuniscid = '';\n      form.actdailymgmtpostother = '';\n      form.ownerrightmgmtpostother = '';\n      form.actctrlcpny = '';\n    },\n        bomisCompanyTypeChange: function (newValue, form) {\n      if (newValue !== '') {\n        form.bnf_type = [];\n      } else if (newValue === '') {\n        form.bnf_type = [];\n      }\n    },\n        bomisHasBothPriBenefitBlocks: function (formOrItem) {\n      if (!formOrItem) { return false; }\n      var bnf = formOrItem.bnf_type;\n      if (!Array.isArray(bnf)) {\n        var s = formOrItem.bnf_type_str || bnf || '';\n        bnf = s ? String(s).split(',') : [];\n      }\n      var hasProfit = ['NA2-1', 'NB2-1', 'ND2-1'].some(function (c) { return bnf.indexOf(c) >= 0; });\n      var hasVote = ['NA2-2', 'NB2-2', 'ND2-2'].some(function (c) { return bnf.indexOf(c) >= 0; });\n      return hasProfit && hasVote;\n    },\n        bomisPriBenefitBlockTitle: function (formOrItem, kind) {\n      var codes = kind === 'profit'\n        ? ['NA2-1', 'NB2-1', 'ND2-1']\n        : ['NA2-2', 'NB2-2', 'ND2-2'];\n      var fallback = kind === 'profit' ? '持有、使用收益权' : '持有、使用表决权';\n      if (!formOrItem) { return fallback; }\n      var bnf = formOrItem.bnf_type;\n      if (!Array.isArray(bnf)) {\n        var s = formOrItem.bnf_type_str || bnf || '';\n        bnf = s ? String(s).split(',') : [];\n      }\n      var activeCode = codes.find(function (c) { return bnf.indexOf(c) >= 0; });\n      if (!activeCode) { return fallback; }\n      var list = (this.bomisParams && this.bomisParams.bnf_type_new_list) || [];\n      var hit = list.find(function (d) { return d.k === activeCode; });\n      if (hit && hit.v) {\n        return hit.v + '（' + activeCode + '）';\n      }\n      return fallback + '（' + activeCode + '）';\n    },\n        bomisPriBenefitWrapStyle: function (formOrItem) {\n      if (!this.bomisHasBothPriBenefitBlocks(formOrItem)) {\n        return {};\n      }\n      return {\n        padding: '12px 12px 4px',\n        marginBottom: '10px',\n        background: '#fafafa',\n        border: '1px solid #ebeef5',\n        borderRadius: '4px'\n      };\n    },\n        bomisSeniormgrposIncludes(item, code) {\n      if (!item) { return false; }\n      var t = item.seniormgrpos;\n      if (Array.isArray(t)) {\n        return t.indexOf(code) >= 0;\n      }\n      var s = item.seniormgrpos_str || t || '';\n      return String(s).split(',').indexOf(code) >= 0;\n    },\n        bomisSeniormgrposcnIncludes(item, code) {\n      if (!item) { return false; }\n      var t = item.seniormgrposcn;\n      if (Array.isArray(t)) {\n        return t.indexOf(code) >= 0;\n      }\n      var s = item.seniormgrposcn_str || t || '';\n      return String(s).split(',').indexOf(code) >= 0;\n    },\n        clearIdNoValidate(formType) {\n      // 根据表单类型获取对应的表单引用\n      let formRef;\n      if (formType === 'ruleForm1') {\n        formRef = this.$refs.ruleForm1;\n      } else if (formType === 'ruleForm2') {\n        formRef = this.$refs.ruleForm2;\n      } else if (formType === 'editForm') {\n        formRef = this.$refs.editForm;\n      } else if (formType === 'editForm1') {\n        formRef = this.$refs.editForm1;\n      } else if (formType === 'editBomisForm') {\n        formRef = this.$refs.editBenefitForm;\n      } else if (formType === 'editOneBenefitForm') {\n        formRef = this.$refs.editOneBenefitForm;\n      }\n\n      // 清空证件号码字段的校验提示\n      if (formRef) {\n        formRef.clearValidate('id_no');\n      }\n    },\n        closeDialog(form) {\n      if (form == '1') {\n        // 清除校验提示\n        this.$refs.editForm.clearValidate();\n        // 关闭弹窗\n        this.dialogFormVisible = false;\n      } else if (form == '2') {\n        // 清除校验提示\n        this.$refs.editForm1.clearValidate();\n        // 关闭弹窗\n        this.dialogFormVisible1 = false;\n      } else if (form == '3') {\n        this.fileDialogVisible = false;\n      } else if (form === 'bomisDialog') {\n        this.bomisParams.dialogBomisVisible = false;\n      } else if (form === 'bomisBenefitDialog') {\n        this.bomisParams.benefitEditDialogVisible = false;\n      }\n\n    },\n        delBomisBnfInfo: function (row) {\n      var that = this;\n      that.$confirm('确认删除当前受益人信息？', '确认', {\n        distinguishCancelAndClose: true,\n        confirmButtonText: '确认',\n        cancelButtonText: '取消'\n      }).then(() => {\n        Wb.ajax({\n          url: 'm?xwl=syr_2/del_bomis_benefit_scinfo_clf20261026',\n          params: { client_id: '_$client_id$_', benefit_scinfo: row },\n          json: true,\n          success(resp) {\n            if (resp.O_RETURN_CODE !== -1) {\n              Wb.tipSucc('删除成功');\n              that.getRelatedInfo('_$client_id$_', '5');\n              that.getBomisSourceTableData();\n            } else {\n              Wb.error(resp.O_RETURN_MSG);\n            }\n          }\n        });\n      });\n    },\n        downloadPdf() {\n      if (!this.submit()) return;\n      console.log(\"uid\", this._uid);\n      const htmlContent = document.getElementById('pdf-container' + this._uid);\n      const clone = htmlContent.cloneNode(true);\n      clone.style.backgroundColor = '#ffffff'; // 确保背景白色\n      clone.style.padding = '20px';\n      clone.style.width = '1800px';\n      clone.style.maxWidth = 'none';\n\n      document.body.appendChild(clone);\n\n      setTimeout(() => {\n        html2canvas(clone, {\n          scale: window.devicePixelRatio,//2,\n          useCORS: true,\n          allowTaint: false,\n          backgroundColor: \"#ffffff\",\n          fontSize: '24px',\n          boxSizing: 'border-box',\n          // scrollX: 0,\n          // scrollY: -window.scrollY\n        }).then(canvas => {\n          const contentWidth = canvas.width;\n          const contentHeight = canvas.height;\n\n          const pageWidth = 595.28; // A4 pt 宽度\n          const pageHeight = 841.89; // A4 pt 高度\n          const imgWidth = pageWidth - 40; // 两边各留 20pt 边距\n          const imgHeight = (imgWidth / contentWidth) * contentHeight;\n\n          const pageData = canvas.toDataURL('image/jpeg', 1.0);\n          console.log(\"pageData.length\", pageData.length / (1024 * 1024) + \"MB\");\n          const pdf = new jsPDF('', 'pt', 'a4');\n\n          let leftHeight = imgHeight;\n          let position = 0;\n\n          if (leftHeight < pageHeight) {\n            pdf.addImage(pageData, 'JPEG', 20, 0, imgWidth, imgHeight);\n          } else {\n            while (leftHeight > 0) {\n              pdf.addImage(pageData, 'JPEG', 20, position, imgWidth, imgHeight);\n              leftHeight -= pageHeight;\n              position -= pageHeight;\n\n              if (leftHeight > 0) {\n                pdf.addPage();\n              }\n            }\n          }\n          pdf.save(\"客户基本信息表-【\" + ('_$organ_flag$_' === '1' ? this.ruleForm1.client_name : this.ruleForm2.client_name) + '(' + '_$client_id$_' + ')' + \"】\" + \".pdf\");\n          document.body.removeChild(clone);\n        }).catch(err => {\n          console.error('PDF导出失败', err);\n          document.body.removeChild(clone);\n        });\n      }, 500);\n    },\n        editBomisBnfInfo: function (op_flag) {\n      op_flag = op_flag || '2';\n      var that = this;\n      var payload = that.bomisParams.editOneBenefitForm;\n      if (!payload.related_id) {\n        Wb.error('缺少受益人标识，请刷新页面后重试');\n        return;\n      }\n      that.$refs.editOneBenefitForm.validate((valid) => {\n        if (valid) {\n          Wb.ajax({\n            url: 'm?xwl=syr_2/edit_bomis_benefit_scinfo_clf20261026',\n            params: { client_id: '_$client_id$_', benefit_scinfo: payload },\n            json: true,\n            success(resp) {\n              if (resp.O_RETURN_CODE !== -1) {\n                Wb.tipSucc('保存成功');\n                that.getRelatedInfo('_$client_id$_', '5');\n                that.getBomisSourceTableData();\n                if (op_flag === '2') {\n                  that.bomisParams.benefitEditDialogVisible = false;\n                } else {\n                  that.bomisParams.benefitEditDialogVisible = false;\n                  that.resetBomisAddForm();\n                  that.bomisParams.editBomisForm.title = '受益所有人';\n                  that.bomisParams.dialogBomisVisible = true;\n                  that.getLastOnlineBomisCheckRs();\n                }\n              } else {\n                Wb.error(resp.O_RETURN_MSG);\n              }\n            }\n          });\n        } else {\n          console.log('error submit!!');\n          return false;\n        }\n      });\n    },\n        formatFullInfoFlag(val) {\n      if (val === '01') {\n        return '透明度较高、信息披露充分的客户（如上市公司、国有企业）';\n      }\n      if (val === '02') {\n        return '受益人信息不规范';\n      }\n      return val || '-';\n    },\n        formatMoney(s, n) {\n      if (!s && s !== 0) return '';\n      let str = String(s);\n      let cleaned = str.replace(/[^\\d\\.]/g, \"\") // 移除所有非数字、非小数点的字符\n        .replace(/\\.{2,}/g, '.') // 多个小数点合并为一个\n        .replace(/^\\./, \"\"); // 移除开头的小数点\n\n      if (!cleaned) return \"\";\n      let num = parseFloat(cleaned);\n      if (isNaN(num)) return \"\";\n      let fixedNum = num.toFixed(n);\n      let [integerPart, decimalPart] = fixedNum.split('.');\n      let integerWithComma = integerPart.replace(/(?=(\\B)(\\d{3})+$)/g, ',');\n      return decimalPart ? `${integerWithComma}.${decimalPart}` : integerWithComma;\n    },\n        formatMultipleDictMap(dictType, key) {\n      var c_key = key || '';\n      if (Array.isArray(c_key)) {\n        c_key = c_key.join(',');\n      }\n      if (c_key === '') { return ' '; }\n      const keyList = c_key.split(',');\n      const dictData = this.selectList[dictType] || [];\n      const item = [];\n      for (let index = 0; index < keyList.length; index++) {\n        item.push(dictData?.find(item => item.k === keyList[index]));\n      }\n      return item.length && !!item[0] ? item.map(i => i.v).join('；') : '-';\n    },\n        formatRegisterMoneyTypeForSave(val) {\n      if (val == null || val === '' || val === '-') {\n        return '';\n      }\n      var s = String(val).trim();\n      if (s === '') {\n        return '';\n      }\n      if (!isNaN(s) && typeof app !== 'undefined' && app.formatMoneyType) {\n        return app.formatMoneyType(app.data.selectList.register_money_type_list, val);\n      }\n      return val;\n    },\n        formatSize(bytes) {\n      if (!bytes && bytes !== 0) {\n        return '';\n      } else if (bytes === 0) {\n        return '0 B'\n      };\n\n      const k = 1024;\n      const sizes = ['B', 'KB', 'MB', 'GB', 'TB'];\n      const i = Math.floor(Math.log(bytes) / Math.log(k));\n\n      return (bytes / Math.pow(k, i)).toFixed(2) + ' ' + sizes[i];\n    },\n        formatUpdateTime(val) {\n      if (!val) return '-';\n      return String(val).replace(/\\.\\d+$/, '');\n    },\n        getBasicInfo(client_id, data_type) {\n      let that = this;\n      Wb.ajax({\n        url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/select_basic_info',\n        params: {\n          CLIENT_ID: client_id,\n          DATA_TYPE: data_type\n        },\n        async: false,\n        success(resp) {\n          let res = Wb.decode(resp).items;\n          console.log(\"getBasicInfo===\", res[0])\n          if (res[0]) {\n            that.basicInfo = res[0];\n            if (app.updateTimeLabel) {\n              app.updateTimeLabel.text = '最新更新日期：' + that.formatUpdateTime(res[0].update_time);\n            }\n            if ('_$organ_flag$_' == '1') {\n              that.ruleForm1 = { ...that.basicInfo };//机构户基本信息数据回显\n              that.normalizeInstitutionBasicForm(that.ruleForm1);\n              if (that.ruleForm1.register_fund) {\n                that.ruleForm1.register_fund = that.formatMoney(that.ruleForm1.register_fund, '4');\n              }\n              that.uploadParams1.file_type_no = 72;// 与客户沟通记录\n              that.uploadParams2.file_type_no = 72;// 二级部门负责人同意的记录\n              that.uploadParams3.file_type_no = 72;// 其他底稿\n              console.log(\"that.ruleForm1\", that.ruleForm1);\n            } else {\n              that.ruleForm2 = { ...that.basicInfo };//个人户基本信息数据回显\n              that.uploadParams1.file_type_no = 3;// 与客户沟通记录\n              that.uploadParams2.file_type_no = 3;// 二级部门负责人同意的记录\n              that.uploadParams3.file_type_no = 3;// 其他底稿\n              console.log(\"that.ruleForm2\", that.ruleForm2);\n            }\n            that.ruleForm3 = {\n              is_special: that.basicInfo.is_special ? that.basicInfo.is_special : '0',\n              client_type: that.basicInfo.client_type ? that.basicInfo.client_type.split(',') : [],\n              client_type_other: that.basicInfo.client_type_other ? that.basicInfo.client_type_other : '',\n              special_matters: that.basicInfo.special_matters ? that.basicInfo.special_matters.split(',') : [],\n              missing_information: that.basicInfo.missing_information ? that.basicInfo.missing_information : '',\n              missing_draft: that.basicInfo.missing_draft ? that.basicInfo.missing_draft : '',\n              special_matters_other: that.basicInfo.special_matters_other ? that.basicInfo.special_matters_other : '',\n              special_reason: that.basicInfo.special_reason ? that.basicInfo.special_reason : '',\n              completed_cdd: that.basicInfo.completed_cdd ? that.basicInfo.completed_cdd : '',\n              low_risk_explanation: that.basicInfo.low_risk_explanation ? that.basicInfo.low_risk_explanation : '',\n              take_measures: that.basicInfo.take_measures ? that.basicInfo.take_measures : ''\n            };\n          }\n        }\n      });\n    },\n        getBomisBnfType: function (form) {\n      var firstChar = form.company_type[0] || '';\n      if (form.company_type !== '') {\n        this.bomisParams.bnf_type_new_list = this.selectList.bnf_type_new_list.filter(i => i.k.startsWith('N' + firstChar));\n      } else if (form.company_type === '') {\n        this.bomisParams.bnf_type_new_list = [];\n      }\n    },\n        getBomisCompanyType: function (form) {\n      if (form.bo_type === '1') {\n        this.bomisParams.benefit_company_no_list = this.selectList.benefit_company_no_list.filter(i => {\n          return i.k.startsWith('1') || i.k.startsWith('2') || i.k.startsWith('3') || i.k.startsWith('4') || i.k.startsWith('5') || i.k.startsWith('6')\n        });\n      } else if (form.bo_type === '2') {\n        this.bomisParams.benefit_company_no_list = this.selectList.benefit_company_no_list.filter(i => {\n          return !(i.k.startsWith('1') || i.k.startsWith('2') || i.k.startsWith('3') || i.k.startsWith('4') || i.k.startsWith('5') || i.k.startsWith('6'))\n        });\n      } else {\n        this.bomisParams.benefit_company_no_list = [];\n      }\n    },\n        getBomisSourceTableData: function () {\n      var that = this;\n      Wb.ajax({\n        url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/select_bomis_benefit_scinfo',\n        params: { client_id: '_$client_id$_' },\n        json: true,\n        success(resp) {\n          debugger\n          that.bomisParams.bomisSourceTableData = resp.items;\n\n          if (that.bomisParams.bomisSourceTableData.filter(i => {\n\n            var item = i.company_type || '';\n            return item.startsWith('A') || item.startsWith('B') || item.startsWith('I');\n          }\n          ).length) {\n            that.bomisParams.onlineBomisCheckBtnDisable = false;\n          } else {\n            that.bomisParams.onlineBomisCheckBtnDisable = true;\n          }\n        }\n      });\n    },\n        getCity(val) {\n      let that = this;\n      let province;\n      if (val == '0') {\n        province = this.ruleForm1.province;\n      } else if (val == '1') {\n        province = this.ruleForm2.province1;\n      } else if (val == '2') {\n        province = this.ruleForm2.province2;\n      } else if (val == 'bomis') {\n        province = this.bomisParams.editBomisForm.province;\n      }\n      if (province) {\n        Wb.ajax({\n          url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/select_city',\n          params: {\n            I_PRO_CODE: province\n          },\n          success: function (resp) {\n            let rec = Wb.decode(resp).items;\n            console.log(\"市\", rec);\n            if (val == '0') {\n              that.cityOptions = rec.map(item => ({\n                label: item.area_name,\n                value: item.area_code\n              }));\n            } else if (val == '1') {\n              that.cityOptions1 = rec.map(item => ({\n                label: item.area_name,\n                value: item.area_code\n              }));\n            } else if (val == '2') {\n              that.cityOptions2 = rec.map(item => ({\n                label: item.area_name,\n                value: item.area_code\n              }));\n            } else if (val == 'bomis') {\n              that.bomisParams.cityOptions = rec.map(item => ({\n                label: item.area_name,\n                value: item.area_code\n              }));\n            }\n          }\n        });\n      }\n    },\n        getDictMap(item) {\n      let that = this;\n      Wb.ajax({\n        url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/select_dict',\n        params: {\n          I_ENTRY_NO: item.ENTRY_NO\n        },\n        success(resp) {\n          let arr = Wb.decode(resp).items;\n          that.selectList[item.BIND_DATA + \"_list\"] = arr;\n          console.log(that.selectList, '===that.selectList===');\n        }\n      })\n    },\n        getDistrict(val) {\n      let that = this;\n      let province, city;\n      if (val == '0') {\n        province = this.ruleForm1.province;\n        city = this.ruleForm1.city;\n      } else if (val == '1') {\n        province = this.ruleForm2.province1;\n        city = this.ruleForm2.city1;\n      } else if (val == '2') {\n        province = this.ruleForm2.province2;\n        city = this.ruleForm2.city2;\n      } else if (val == 'bomis') {\n        province = this.bomisParams.editBomisForm.province;\n        city = this.bomisParams.editBomisForm.city;\n      }\n      Wb.ajax({\n        url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/select_district',\n        params: {\n          I_PRO_CODE: province,\n          I_AREA_CODE: city ? city.substring(0, 4) : ''\n        },\n        success: function (resp) {\n          let rec = Wb.decode(resp).items;\n          console.log(\"区\", rec);\n          if (val == '0') {\n            that.districtOptions = rec.map(item => ({\n              label: item.area_name,\n              value: item.area_code\n            }));\n          } else if (val == '1') {\n            that.districtOptions1 = rec.map(item => ({\n              label: item.area_name,\n              value: item.area_code\n            }));\n          } else if (val == '2') {\n            that.districtOptions2 = rec.map(item => ({\n              label: item.area_name,\n              value: item.area_code\n            }));\n          } else if (val == 'bomis') {\n            that.bomisParams.districtOptions = rec.map(item => ({\n              label: item.area_name,\n              value: item.area_code\n            }));\n          }\n\n        }\n      });\n    },\n        getLastOnlineBomisCheckRs: function () {\n      var that = this;\n      var params = {\n        client_id: '_$client_id$_'\n      };\n      Wb.ajax({\n        url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/select_his_bomis_response',\n        params: params,\n        json: true,\n        success(resp) {\n          if (resp.total > 0) {\n            if (!resp.items[0].response_info) { return; }\n            var response_info = JSON.parse(JSON.parse(resp.items[0].response_info));\n            that.bomisParams.bomisLastCheckResult = response_info;\n            that.bomisParams.bomisLastCheckResult.op_time = resp.items[0].op_time;\n            // JSON.parse(resp.items[0].response_info)\n            that.bomisParams.bomisLastCheckResultList = [];\n            if (response_info.NoDiffList[0].CONS_COUNT > 0) {\n              var tmpList = response_info.NoDiffList[0].ConsList.map(item => {\n                const newItem = {};\n                for (const key in item) {\n                  newItem[key.toLowerCase()] = item[key];\n                }\n                return newItem;\n              });\n              tmpList.forEach(function (i) { i.check_type_code = 'cons'; i.check_type_name = '核验一致'; });\n              that.bomisParams.bomisLastCheckResultList = that.bomisParams.bomisLastCheckResultList.concat(tmpList);\n\n            }\n            if (response_info.NoDiffList[0].LACK_COUNT > 0) {\n              // var tmpList = structuredClone(response_info.NoDiffList[0].LackList);\n              var tmpList = response_info.NoDiffList[0].LackList.map(item => {\n                const newItem = {};\n                for (const key in item) {\n                  newItem[key.toLowerCase()] = item[key];\n                }\n                return newItem;\n              });\n              tmpList.forEach(function (i) { i.check_type_code = 'lack'; i.check_type_name = '受益人缺失'; });\n              that.bomisParams.bomisLastCheckResultList = that.bomisParams.bomisLastCheckResultList.concat(tmpList);\n            }\n            if (response_info.NoDiffList[0].MORE_COUNT > 0) {\n              // var tmpList = structuredClone(response_info.NoDiffList[0].MoreList);\n              var tmpList = response_info.NoDiffList[0].MoreList.map(item => {\n                const newItem = {};\n                for (const key in item) {\n                  newItem[key.toLowerCase()] = item[key];\n                }\n                return newItem;\n              });\n              tmpList.forEach(function (i) { i.check_type_code = 'more'; i.check_type_name = '受益人多出'; });\n              that.bomisParams.bomisLastCheckResultList = that.bomisParams.bomisLastCheckResultList.concat(tmpList);\n            }\n            if (response_info.NoDiffList[0].ELMT_COUNT > 0) {\n              // var tmpList = structuredClone(response_info.NoDiffList[0].ElmtList);\n              var tmpList = response_info.NoDiffList[0].ElmtList.map(item => {\n                const newItem = {};\n                for (const key in item) {\n                  newItem[key.toLowerCase()] = item[key];\n                }\n                return newItem;\n              });\n              tmpList.forEach(function (i) { i.check_type_code = 'elmt'; i.check_type_name = '个人信息要素项不一致'; });\n              that.bomisParams.bomisLastCheckResultList = that.bomisParams.bomisLastCheckResultList.concat(tmpList);\n            }\n            if (response_info.NoDiffList[0].PERP_COUNT > 0) {\n              // var tmpList = structuredClone(response_info.NoDiffList[0].PerpList);\n              var tmpList = response_info.NoDiffList[0].PerpList.map(item => {\n                const newItem = {};\n                for (const key in item) {\n                  newItem[key.toLowerCase()] = item[key];\n                }\n                return newItem;\n              });\n              tmpList.forEach(function (i) { i.check_type_code = 'perp'; i.check_type_name = '备案主体填报类型为承诺免报'; });\n              that.bomisParams.bomisLastCheckResultList = that.bomisParams.bomisLastCheckResultList.concat(tmpList);\n            }\n            if (response_info.NoDiffList[0].SCEC_COUNT > 0) {\n              var tmpList = response_info.NoDiffList[0].ScecList.map(item => {\n                const newItem = {};\n                for (const key in item) {\n                  newItem[key.toLowerCase()] = item[key];\n                }\n                return newItem;\n              });\n              // var tmpList = structuredClone(response_info.NoDiffList[0].ScecList);\n              tmpList.forEach(function (i) { i.check_type_code = 'scec'; i.check_type_name = '备案主体填报类型为国有公司'; });\n              that.bomisParams.bomisLastCheckResultList = that.bomisParams.bomisLastCheckResultList.concat(tmpList);\n            }\n          }\n        }\n      });\n    },\n        getProvince() {\n      let that = this;\n      Wb.ajax({\n        url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/select_province',\n        success: function (resp) {\n          let rec = Wb.decode(resp).items;\n          that.proOptions = rec.map(item => ({\n            label: item.pro_name,\n            value: item.pro_code\n          }));\n        }\n      });\n    },\n        getRelatedInfo(client_id, rela_type) {\n      let that = this;\n      Wb.ajax({\n        url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/select_related_info',\n        params: {\n          CLIENT_ID: client_id,\n          RELATED_TYPE: rela_type,\n          // DATA_TYPE: '_$data_type$_'\n        },\n        async: false,\n        success(resp) {\n          let res = Wb.decode(resp).items;\n          if (rela_type == '1') {\n            that.relatedInfo1 = res;\n            console.log(\"法定代表人信息\", res);\n          } else if (rela_type == '2') {\n            that.relatedInfo2 = res;\n            console.log(\"控股股东信息\", res);\n          } else if (rela_type == '3') {\n            that.relatedInfo3 = res;\n            console.log(\"实际控制人信息\", res);\n          } else if (rela_type == '4') {\n            that.relatedInfo4 = res;\n            console.log(\"授权代表人信息\", res);\n          } else if (rela_type == '5') {\n            that.relatedInfo5 = res;\n            console.log(\"受益所有人信息\", res);\n            if ('_$showBomisBtn$_' === 'true') {\n              that.getBomisSourceTableData();\n            }\n          }\n        }\n      });\n    },\n        handleChange(file, fileList) {\n      this.fileList = fileList\n    },\n        handleChange1(file, fileList) {\n      this.attachmentList.communication = fileList\n    },\n        handleChange2(file, fileList) {\n      this.attachmentList.agree = fileList\n    },\n        handleChange3(file, fileList) {\n      this.attachmentList.other = fileList\n    },\n        handleCityChg(val) {\n      if (val == '0') {\n        this.ruleForm1.district = '';\n        this.ruleForm1.office_address = '';\n      } else if (val == '1') {\n        this.ruleForm2.district1 = '';\n        this.ruleForm2.id_address = '';\n      } else if (val == '2') {\n        this.ruleForm2.district2 = '';\n        this.ruleForm2.address = '';\n      } else if (val == 'bomis') {\n        this.bomisParams.editBomisForm.district = '';\n        this.bomisParams.editBomisForm.address = '';\n      }\n      this.getDistrict(val);\n    },\n        handleClick(tab, event) {\n      this.isScroll = false;\n      let that = this;\n      let element = document.getElementsByName(tab.name)[0];\n      element.scrollIntoView({\n        behavior: 'smooth',\n        block: 'start'\n      });\n      setTimeout(() => {\n        that.isScroll = true;\n      }, 500);\n      console.log(\"滚动监听中...\");\n    },\n        handleDelete(index) {\n\n    },\n        handleDownload(row) {\n      Wb.download({\n        url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/files/download_file',\n        params: {\n          id: row.id,\n          full_name: row.name + '.' + row.extension\n        }\n      })\n    },\n        handlePreview(file) {\n      let that = this;\n      let params_file = {\n        'id': file.id,\n        'clientId': file.client_id,\n        'fileTypeNo': this.organ_flag == '1' ? '1,2,21,22' : '1,2',\n        'fileName': file.name + '.' + file.extension,\n        'extension': file.extension\n      };\n      Wb.ajax({\n        url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/files/preview_file',\n        params: {\n          id: file.id,\n          clientId: file.client_id,\n          fileTypeNo: this.organ_flag == '1' ? '1,2,21,22' : '1,2',\n          fileName: file.name + '.' + file.extension,\n          extension: file.extension\n        },\n        success(resp) {\n          console.log(\"resp\", resp);\n          let res = Wb.decode(resp);\n          let serverIp = '10.116.131.13';\n          if (res.code == '200') {\n            let previewUrl = res.data.previewUrl;\n            if (previewUrl.indexOf(serverIp) != -1) {\n              previewUrl = res.data.previewUrl.replace(/10\\.116\\.131\\.13:8090/g, '10.181.135.22:8080/ibcm_flow')\n            }\n            window.open(previewUrl, '_blank', 'width=800,height=600')\n          } else {\n            that.$message.error(\"当前文件类型不支持预览\")\n          }\n        }\n      });\n    },\n        handleProvinceChg(val) {\n      if (val == '0') {\n        this.ruleForm1.city = '';\n        this.ruleForm1.district = '';\n        this.ruleForm1.office_address = '';\n      } else if (val == '1') {\n        this.ruleForm2.city1 = '';\n        this.ruleForm2.district1 = '';\n        this.ruleForm2.id_address = '';\n      } else if (val == '2') {\n        this.ruleForm2.city2 = '';\n        this.ruleForm2.district2 = '';\n        this.ruleForm2.address = '';\n      } else if (val == 'bomis') {\n        this.bomisParams.editBomisForm.city = '';\n        this.bomisParams.editBomisForm.district = '';\n        this.bomisParams.editBomisForm.address = '';\n      }\n      this.getCity(val);\n    },\n        handleRemove(file, fileList) {\n      let that = this;\n      Wb.ajax({\n        url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/files/delete_file',\n        params: {\n          file_pk_id: file.response\n        },\n        success() {\n          that.fileList = fileList;\n        }\n      })\n    },\n        handleRemove1(file, fileList) {\n      let that = this;\n      Wb.ajax({\n        url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/files/delete_file',\n        params: {\n          file_pk_id: file.id\n        },\n        success() {\n          that.attachmentList.communication = fileList;\n        }\n      })\n    },\n        handleRemove2(file, fileList) {\n      let that = this;\n      Wb.ajax({\n        url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/files/delete_file',\n        params: {\n          file_pk_id: file.id\n        },\n        success() {\n          that.attachmentList.agree = fileList;\n        }\n      })\n    },\n        handleRemove3(file, fileList) {\n      let that = this;\n      Wb.ajax({\n        url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/files/delete_file',\n        params: {\n          file_pk_id: file.id\n        },\n        success() {\n          that.attachmentList.other = fileList;\n        }\n      })\n    },\n        handleResizeMouseDown() { },\n        handleSuccess(file, fileList) {\n      this.selectFile();\n    },\n        isBomisBnfTypeDisabled: function (optionK, form) {\n      var list = this.bomisParams.bnf_type_new_list || [];\n      var i;\n      for (i = 0; i < list.length; i++) {\n        if (list[i].k === optionK && list[i].disabled === true) {\n          return true;\n        }\n      }\n      var selected = form.bnf_type;\n      if (!Array.isArray(selected)) {\n        selected = selected ? String(selected).split(',') : [];\n      }\n      if (selected.indexOf(optionK) >= 0) {\n        return false;\n      }\n      if (selected.length === 0) {\n        return false;\n      }\n      var trial = this.normalizeBnfTypeSelection(selected.concat([optionK]));\n      return trial.indexOf(optionK) < 0;\n    },\n        loadSelectList(item) {\n      let that = this;\n      if (!Wb.isEmpty(item.KEY_NAME)) {\n        Wb.ajax({\n          url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/select_key',\n          params: {\n            I_KEY_NAME: item.KEY_NAME\n          },\n          success(resp) {\n            let arr = Wb.decode(resp).items;\n            that.selectList[item.BIND_DATA + \"_list\"] = arr;\n            console.log(that.selectList, '===that.selectList===');\n          }\n        });\n      }\n    },\n        nativeRadioClick: function (val, obj, key) {\n      if (obj[key] === val) {\n        setTimeout(() => {\n          this.$set(obj, key, '')\n        }, 200)\n      }\n    },\n        normalizeBnfTypeSelection: function (newVal) {\n      var checkVal = (newVal || []).slice();\n      var result = checkVal.slice();\n      if (checkVal.length <= 1) {\n        return result;\n      }\n      var lastItem = checkVal[checkVal.length - 1];\n      if (checkVal.includes('NA1') && ['NA2-1', 'NA2-2', 'NA3-1', 'NA3-2', 'NA4'].includes(lastItem)) {\n        result.pop();\n      }\n      if (checkVal.includes('NA4') && ['NA2-1', 'NA2-2', 'NA3-1', 'NA3-2', 'NA1'].includes(lastItem)) {\n        result.pop();\n      }\n      if ((checkVal.includes('NA2-1') || checkVal.includes('NA2-2'))) {\n        if (checkVal.includes('NA3-1') && ['NA4', 'NA3-2', 'NA1'].includes(lastItem)) { result.pop(); }\n        if (checkVal.includes('NA3-2') && ['NA4', 'NA3-1', 'NA1'].includes(lastItem)) { result.pop(); }\n        if (['NA4', 'NA1'].includes(lastItem)) { result.pop(); }\n      }\n      if (checkVal.includes('NA3-1') && ['NA4', 'NA3-2', 'NA1'].includes(lastItem)) { result.pop(); }\n      if (checkVal.includes('NA3-2') && ['NA4', 'NA3-1', 'NA1'].includes(lastItem)) { result.pop(); }\n\n      if (checkVal.includes('NB1') && ['NB2-1', 'NB2-2', 'NB3-1', 'NB3-2', 'NB4'].includes(lastItem)) {\n        result.pop();\n      }\n      if (checkVal.includes('NB4') && ['NB2-1', 'NB2-2', 'NB3-1', 'NB3-2', 'NB1'].includes(lastItem)) {\n        result.pop();\n      }\n      if ((checkVal.includes('NB2-1') || checkVal.includes('NB2-2'))) {\n        if (checkVal.includes('NB3-1') && ['NB4', 'NB3-2', 'NB1'].includes(lastItem)) { result.pop(); }\n        if (checkVal.includes('NB3-2') && ['NB4', 'NB3-1', 'NB1'].includes(lastItem)) { result.pop(); }\n        if (['NB4', 'NB1'].includes(lastItem)) { result.pop(); }\n      }\n      if (checkVal.includes('NB3-1') && ['NB4', 'NB3-2', 'NB1'].includes(lastItem)) { result.pop(); }\n      if (checkVal.includes('NB3-2') && ['NB4', 'NB3-1', 'NB1'].includes(lastItem)) { result.pop(); }\n\n      if (checkVal.includes('ND1') && ['ND2-1', 'ND2-2', 'ND3', 'ND4'].includes(lastItem)) {\n        result.pop();\n      }\n      if ((checkVal.includes('ND2-1') || checkVal.includes('ND2-2'))) {\n        if (checkVal.includes('ND3') && ['ND4', 'ND1'].includes(lastItem)) { result.pop(); }\n        if (['ND4', 'ND1'].includes(lastItem)) { result.pop(); }\n      }\n      if (checkVal.includes('ND3') && ['ND4', 'ND1'].includes(lastItem)) { result.pop(); }\n\n      if (checkVal.includes('NE1') && ['NE2'].includes(lastItem)) {\n        result.pop();\n      }\n      if (checkVal.includes('NE2') && ['NE1'].includes(lastItem)) {\n        result.pop();\n      }\n      return result;\n    },\n        normalizeBomisBenefitForm: function (row) {\n      var base = this.bomisParams.editOneBenefitForm;\n      var form = Object.assign({}, base, row || {});\n      var toArray = function (val) {\n        if (val === '' || val == null) { return []; }\n        return Array.isArray(val) ? val.slice() : String(val).split(',').filter(Boolean);\n      };\n      var pickMulti = function (r, field, strField) {\n        if (!r) { return []; }\n        if (Array.isArray(r[field])) { return r[field].slice(); }\n        if (r[strField] != null && r[strField] !== '') { return toArray(r[strField]); }\n        return toArray(form[field]);\n      };\n      form.bnf_type = pickMulti(row, 'bnf_type', 'bnf_type_str');\n      form.actctrltype = pickMulti(row, 'actctrltype', 'actctrltype_str');\n      form.seniormgrpos = pickMulti(row, 'seniormgrpos', 'seniormgrpos_str');\n      form.seniormgrposcn = pickMulti(row, 'seniormgrposcn', 'seniormgrposcn_str');\n      form.gender = form.gender || '';\n      form.mobno1 = form.mobno1 || '';\n      form.mobno2 = form.mobno2 || '';\n      form.related_type = '5';\n      form.related_id = row && row.related_id != null ? row.related_id : form.related_id;\n      form.data_status = row && row.data_status != null ? row.data_status : (form.data_status || '0');\n      form.new_flag = false;\n      return form;\n    },\n        normalizeInstitutionBasicForm(form) {\n      if (!form) {\n        return;\n      }\n      if (form.register_money_type == null || form.register_money_type === undefined) {\n        form.register_money_type = '';\n      }\n    },\n        onRegisterMoneyTypeChange(val) {\n      this.ruleForm1.register_money_type = val == null ? '' : val;\n    },\n        onScroll(e) {\n      if (!this.isScroll) return;\n      var scrollItems = [];\n      this.navList.forEach(ele => {\n        var element = document.getElementsByName(ele.value)[0];\n        scrollItems.push(element);\n      });\n      var scrollTop = e.target.scrollTop;\n      var foundIndex = -1;\n      for (var i = 0; i < scrollItems.length; i++) {\n        var item = scrollItems[i];\n        var threshold = item.offsetTop - scrollItems[0].offsetTop;\n        if (scrollTop >= threshold) {\n          foundIndex = i;\n        } else {\n          break;\n        }\n      }\n      if (foundIndex !== -1) {\n        this.activeNav = this.navList[foundIndex.toString()].value;\n      }\n    },\n        onlineBomisCheck: function () {\n      // 收益所有人实时核验\n      var that = this;\n      var params = {\n        client_id: '_$client_id$_',\n        uscc: that.ruleForm1.id_no, // 统一社会信用代码\n        orgNm: that.ruleForm1.client_name, // 主体名称\n        branchCode: \"E1005431000011\",\n        branchName: \"国泰海通证券股份有限公司\",\n        benefitData: that.bomisParams.bomisSourceTableData,\n        orgTp: \"1\" // 1-公司  2-合伙企业 3-外国公司分支机构 4-豁免主体\n      };\n      that.$confirm('确定进行受益人信息核验？', '确认', {\n        distinguishCancelAndClose: true,\n        confirmButtonText: '确认',\n        cancelButtonText: '取消'\n      }).then(() => {\n\n        Wb.ajax({\n          // url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/online_bomis_check',\n          url: 'm?xwl=syr_2/online_bomis_check_clf20261026',\n\n          params: params,\n          json: true,\n          success(resp) {\n            that.getLastOnlineBomisCheckRs();\n          }\n        });\n      })\n    },\n        openFileDialog(menu) {\n      if (menu == 23) {\n        console.log(\"111\");\n        this.fileDialogDisabled = true;\n      } else {\n        this.fileDialogDisabled = false;\n      }\n      this.fileList = [];\n      this.selectedMenu = menu;\n      let curMenu = Number(String(menu)[0]);\n      let directoryConfig = this.organ_flag == '1' ? this.directoryConfig1 : this.directoryConfig2;\n      directoryConfig.forEach(item => {\n        item.disabled = true;\n      });\n      let targetItem = directoryConfig.find(item => item.value === curMenu);\n      if (targetItem) {\n        targetItem.disabled = false;\n      }\n      this.fileDialogVisible = true;\n    },\n        resetBomisAddForm() {\n      var form = this.bomisParams.editBomisForm;\n      form.bo_type = '';\n      form.company_type = '';\n      form.bnf_type = [];\n      form.common_rate = '';\n      form.full_info_flag = '';\n      form.actctrltype = [];\n      form.seniormgrpos = [];\n      form.seniormgrposcn = [];\n      form.related_name = '';\n      form.organ_flag = '0';\n      form.nationality = '';\n      form.id_type = '';\n      form.id_no = '';\n      form.id_begindate = '';\n      form.id_enddate = '';\n      form.birthday = '';\n      form.is_government_dept = '';\n      form.related_type = '5';\n      form.beneficiary = '';\n      form.shareholding_ratio = '';\n      form.province = '';\n      form.city = '';\n      form.district = '';\n      form.address = '';\n      form.mobno1 = '';\n      form.mobno2 = '';\n      form.gender = '';\n      form.new_flag = true;\n      form.data_status = '0';\n      form.acthdrat = undefined;\n      form.shareratiostartdate = '';\n      form.shareratioenddate = '';\n      form.actownerprofitratio = undefined;\n      form.profitratiostartdate = '';\n      form.profitratioenddate = '';\n      form.actownerprofitratiovote = undefined;\n      form.profitratiovotestartdate = '';\n      form.profitratiovoteenddate = '';\n      form.actotherforms = '';\n      form.obtainactdate = '';\n      form.terminationactdate = '';\n      form.actconuppermarket = '';\n      form.actconupperentname = '';\n      form.actconuniscid = '';\n      form.actdailymgmtpostother = '';\n      form.ownerrightmgmtpostother = '';\n      this.bomisParams.benefit_company_no_list = [];\n      this.bomisParams.bnf_type_new_list = [];\n      if (this.$refs.editBenefitForm) {\n        this.$refs.editBenefitForm.clearValidate();\n      }\n    },\n        resetForm(form) {\n      this.editForm.birthday = '';\n      this.editForm.is_government_dept = '';\n      this.editForm.id_type = '';\n      this.editForm.id_no = '';\n    },\n        saveEditForm(op_flag, form) {\n      let that = this;\n\n      // 1. 表单校验\n      let validSucc = this.submitForm(form);\n      if (!validSucc) {\n        return;\n      }\n\n      let currentForm = (form == '1') ? this.editForm : this.editForm1;\n      let dialogVisibleProp = (form == '1') ? 'dialogFormVisible' : 'dialogFormVisible1';\n      let currentRelatedType = String(currentForm.related_type);\n\n      // 公共字段\n      let baseParams = {\n        CLIENT_ID: '_$client_id$_',\n        RELATED_NAME: currentForm.related_name,\n        ORGAN_FLAG: currentForm.organ_flag,\n        ID_TYPE: currentForm.id_type,\n        ID_NO: currentForm.id_no,\n        ID_BEGINDATE: currentForm.id_begindate,\n        ID_ENDDATE: currentForm.id_enddate,\n        NATIONALITY: currentForm.nationality,\n        BIRTHDAY: currentForm.birthday,\n        IS_GOVERNMENT_DEPT: currentForm.is_government_dept,\n        DATA_STATUS: currentForm.data_status || '0'\n      };\n\n      // 受益人特有参数 (仅当当前正在编辑受益人弹窗时才取新值，否则留空待处理)\n      let newBeneficiaryParams = {};\n      console.log(\"currentRelatedType\", currentRelatedType)\n      if (currentRelatedType === '5') {\n        newBeneficiaryParams.BENEFICIARY = currentForm.beneficiary || '';\n        newBeneficiaryParams.SHAREHOLDING_RATIO = currentForm.shareholding_ratio || '';\n        newBeneficiaryParams.ADDRESS = currentForm.address || '';\n      }\n\n      let newMobno1Params = {};\n      if (currentRelatedType === '1' || currentRelatedType === '4') {\n        newMobno1Params.MOBNO1 = currentForm.mobno1 || '';\n      }\n\n      // 2. 新增\n      if (currentForm.new_flag) {\n        let targetRelatedType = currentForm.related_type;\n        let targetTitle = that.formatDictMap('related_type_list', targetRelatedType);\n\n        Wb.ajax({\n          url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/select_organ_entity',\n          params: {\n            CLIENT_ID: '_$client_id$_',\n            ORGAN_FLAG: baseParams.ORGAN_FLAG,\n            RELATED_NAME: baseParams.RELATED_NAME\n          },\n          success: function (resp) {\n            let res = Wb.decode(resp).items || [];\n            let hasDuplicate = false;\n\n            for (let i = 0; i < res.length; i++) {\n              if (String(res[i].related_name) === String(baseParams.RELATED_NAME) &&\n                String(res[i].related_type) === String(targetRelatedType)) {\n                hasDuplicate = true;\n                break;\n              }\n            }\n\n            if (hasDuplicate) {\n              Wb.error(\"已存在主体名称为“\" + baseParams.RELATED_NAME + \"”的【\" + targetTitle + \"】信息，请勿重复添加！\");\n              return;\n            }\n\n            let saveData = {};\n            for (let key in baseParams) { saveData[key] = baseParams[key]; }\n            saveData.RELATED_TYPE = targetRelatedType;\n            saveData.OBJECT_ID = '';\n            saveData.CREATE_USER = '_$sys.username$_';\n            saveData.UPDATE_USER = '_$sys.username$_';\n\n            // 如果是新增受益人，加上特有字段\n            if (String(targetRelatedType) === '5') {\n              saveData.BENEFICIARY = newBeneficiaryParams.BENEFICIARY;\n              saveData.SHAREHOLDING_RATIO = newBeneficiaryParams.SHAREHOLDING_RATIO;\n              saveData.ADDRESS = newBeneficiaryParams.ADDRESS;\n            }\n\n            if (String(targetRelatedType) === '1' || String(targetRelatedType) === '4') {\n              saveData.MOBNO1 = newMobno1Params.MOBNO1;\n            }\n\n            let batchList = [saveData];\n\n            Wb.ajax({\n              url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/save_organ_entity',\n              params: { batchList: batchList },\n              success: function (saveResp) {\n                Wb.tipSucc(\"添加成功\");\n                that.getRelatedInfo('_$client_id$_', targetRelatedType);\n\n                if (op_flag == '2') {\n                  that[dialogVisibleProp] = false;\n                }\n\n                let relaType = currentForm.related_type;\n                if (form == '1') {\n                  that.editForm = {\n                    related_name: '', organ_flag: '0', nationality: '', id_type: '', id_no: '',\n                    id_begindate: '', id_enddate: '', is_government_dept: '', birthday: '',\n                    related_type: relaType, data_status: '0', title: that.formatDictMap('related_type_list', relaType),\n                    new_flag: true, _tempBatchList: []\n                  };\n                  if (that.$refs.editForm) that.$refs.editForm.clearValidate();\n                } else {\n                  that.editForm1 = {\n                    related_name: '', organ_flag: '0', nationality: '', id_type: '', id_no: '',\n                    id_begindate: '', id_enddate: '', is_government_dept: '', birthday: '',\n                    beneficiary: '', shareholding_ratio: '', address: '', mobno1: '',\n                    related_type: relaType, data_status: '0', title: that.formatDictMap('related_type_list', relaType),\n                    new_flag: true, _tempBatchList: []\n                  };\n                }\n              }\n            });\n          }\n        });\n\n      }\n      // 3. 编辑\n      else {\n        let batchList = currentForm._tempBatchList || [];\n\n        if (batchList.length === 0) {\n          Wb.error(\"编辑数据异常，未找到关联信息，请重新打开弹窗。\");\n          return;\n        }\n\n        // 更新 batchList\n        for (let i = 0; i < batchList.length; i++) {\n          let item = batchList[i];\n          console.log(\"batchList[i]\", batchList[i])\n          let itemType = String(item.RELATED_TYPE);\n\n          // 1. 更新公共字段\n          item.RELATED_NAME = baseParams.RELATED_NAME;\n          item.ORGAN_FLAG = baseParams.ORGAN_FLAG;\n          item.ID_TYPE = baseParams.ID_TYPE;\n          item.ID_NO = baseParams.ID_NO;\n          item.ID_BEGINDATE = baseParams.ID_BEGINDATE;\n          item.ID_ENDDATE = baseParams.ID_ENDDATE;\n          item.NATIONALITY = baseParams.NATIONALITY;\n          item.BIRTHDAY = baseParams.BIRTHDAY;\n          item.IS_GOVERNMENT_DEPT = baseParams.IS_GOVERNMENT_DEPT;\n          item.DATA_STATUS = baseParams.DATA_STATUS;\n\n          // 2. 受益所有人特有字段\n          if (itemType === '5') {\n            // 判断：只有当当前正在编辑的弹窗也是“受益所有人”(type 5) 时，才更新这三个字段\n            // 如果当前是在编辑其他类型则保留 item 中原有的值，不要用空值覆盖\n            if (currentRelatedType === '5') {\n              item.BENEFICIARY = newBeneficiaryParams.BENEFICIARY;\n              item.SHAREHOLDING_RATIO = newBeneficiaryParams.SHAREHOLDING_RATIO;\n              item.ADDRESS = newBeneficiaryParams.ADDRESS;\n            }\n          }\n\n          if (itemType === '1' || itemType === '4') {\n            if (currentRelatedType === '1' || currentRelatedType === '4') {\n              item.MOBNO1 = newMobno1Params.MOBNO1;\n            }\n          }\n          // 20260923add\n        if (itemType === '2' || itemType === '3') {\n          // 控股股东/实控人记录本身没有 MOBNO1/BENEFICIARY 等字段\n          // 但为确保后端不收到 undefined，统一做清洗\n          if (item.MOBNO1 === undefined) {\n            item.MOBNO1 = '';\n          }\n          if (item.BENEFICIARY === undefined) {\n            item.BENEFICIARY = '';\n          }\n          if (item.SHAREHOLDING_RATIO === undefined) {\n            item.SHAREHOLDING_RATIO = '';\n          }\n          if (item.ADDRESS === undefined) {\n            item.ADDRESS = '';\n          }\n        }\n\n        // 对法定代表人(type='1')/授权代表人(type='4') 类型的记录做保护\n        if (itemType === '1' || itemType === '4') {\n          if (currentRelatedType !== '1' && currentRelatedType !== '4') {\n            // 当前编辑的不是法定代表人/授权代表人\n            // 保留 item 中已有的 MOBNO1 值（来自 showDialog 初始化时的赋值）\n            // 如果 MOBNO1 仍是 undefined（极端情况），设为空字符串\n            if (item.MOBNO1 === undefined) {\n              item.MOBNO1 = '';\n            }\n          }\n        }\n\n        // 对受益所有人(type='5') 类型的记录做保护\n        if (itemType === '5') {\n          if (currentRelatedType !== '5') {\n            // 当前编辑的不是受益所有人\n            // 保留 item 中已有的受益所有人特有字段值\n            if (item.BENEFICIARY === undefined) item.BENEFICIARY = '';\n            if (item.SHAREHOLDING_RATIO === undefined) item.SHAREHOLDING_RATIO = '';\n            if (item.ADDRESS === undefined) item.ADDRESS = '';\n          }\n        }\n\n        }\n\n        \n\n        Wb.ajax({\n          url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/update_organ_entity',\n          params: {\n            batchList: batchList\n          },\n          success: function (resp) {\n            let rs = Wb.decode(resp);\n            if (rs.O_RETURN_CODE == '0') {\n              Wb.tipSucc(\"修改成功\");\n              that.getRelatedInfo('_$client_id$_', '1');\n              that.getRelatedInfo('_$client_id$_', '2');\n              that.getRelatedInfo('_$client_id$_', '3');\n              that.getRelatedInfo('_$client_id$_', '4');\n              that.getRelatedInfo('_$client_id$_', '5');\n\n              if (op_flag == '2') {\n                that[dialogVisibleProp] = false;\n              }\n\n              let relaType = currentForm.related_type;\n              if (form == '1') {\n                that.editForm = {\n                  related_name: '', organ_flag: '0', nationality: '', id_type: '', id_no: '',\n                  id_begindate: '', id_enddate: '', is_government_dept: '', birthday: '',\n                  related_type: relaType, data_status: '0', title: that.formatDictMap('related_type_list', relaType),\n                  new_flag: true, _tempBatchList: []\n                };\n                if (that.$refs.editForm) that.$refs.editForm.clearValidate();\n              } else {\n                that.editForm1 = {\n                  related_name: '', organ_flag: '0', nationality: '', id_type: '', id_no: '',\n                  id_begindate: '', id_enddate: '', is_government_dept: '', birthday: '',\n                  beneficiary: '', shareholding_ratio: '', address: '', mobno1: '',\n                  related_type: relaType, data_status: '0', title: that.formatDictMap('related_type_list', relaType),\n                  new_flag: true, _tempBatchList: []\n                };\n              }\n            } else {\n              Wb.tipError(rs.O_RETURN_MSG);\n            }\n          }\n        });\n      }\n    },\n        selectFile() {\n      console.log(\"执行了selectFile\")\n      let that = this;\n      // 机构户附件\n      let fileType1 = {\n        'basicInfo': '1,2,21,22',\n        'LegalRep': '23',\n        'controllingShareholder': '3,31,32',\n        'actualController': '4,41,42',\n        'authorizedRep': '5,51,52',\n        'beneficialOwner': '6,61,62,63,64',\n      }\n      // 个人户附件\n      let fileType2 = {\n        'basicInfo': '1,2'\n      }\n      if (this.organ_flag == '1') {\n        for (const key in fileType1) {\n          Wb.ajax({\n            url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/files/select_file',\n            params: {\n              I_CLIENT_ID: '_$client_id$_',\n              I_FILE_TYPE_NO: fileType1[key]\n            },\n            success(resp) {\n              let rows = Wb.decode(resp).items\n              that.attachmentList[key] = rows;\n            }\n          })\n        }\n      } else {\n        for (const key in fileType2) {\n          Wb.ajax({\n            url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/files/select_file',\n            params: {\n              I_CLIENT_ID: '_$client_id$_',\n              I_FILE_TYPE_NO: fileType2[key]\n            },\n            success(resp) {\n              let rows = Wb.decode(resp).items\n              that.attachmentList[key] = rows;\n              console.log(\"that.attachmentList.\" + key, that.attachmentList[key])\n            }\n          })\n        }\n      }\n      // 反洗钱特殊情况 对文件细致分类过的回显时单独用object_id查询\n      const fxq_special_arr = ['communication', 'agree', 'other']\n      fxq_special_arr.forEach(item => {\n        Wb.ajax({\n          url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/files/select_file',\n          params: {\n            I_CLIENT_ID: '_$client_id$_',\n            I_OBJECT_ID: '_$client_id$_' + item\n          },\n          success(resp) {\n            let rows = Wb.decode(resp).items\n            that.attachmentList[item] = rows;\n          }\n        })\n      })\n    },\n        selectRelaOptions(organ_flag) {\n      let that = this;\n      Wb.ajax({\n        url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/select_organ_entity',\n        params: {\n          CLIENT_ID: '_$client_id$_',\n          ORGAN_FLAG: organ_flag\n        },\n        success(resp) {\n          let res = Wb.decode(resp).items;\n          if (res && res.length > 0) {\n            const uniqueMap = new Map();\n            res.forEach(item => {\n              const key = item.related_name + '_' + item.id_no + '_' + item.id_type;\n              if (!uniqueMap.has(key)) {\n                uniqueMap.set(key, item);\n              }\n            });\n            that.curRelaOptions = Array.from(uniqueMap.values());\n          } else {\n            that.curRelaOptions = [];\n          }\n        }\n      })\n    },\n        setRelaValue(related_name, form) {\n      const exist = this.curRelaOptions.find(item => item.related_name === related_name);\n      if (exist && form == 'form') {\n        const selectedRela = this.curRelaOptions.find(item => item.related_name === this.editForm.related_name);\n        this.editForm.birthday = selectedRela.birthday;\n        this.editForm.is_government_dept = selectedRela.is_government_dept;\n        this.editForm.id_type = selectedRela.id_type;\n        this.editForm.id_no = selectedRela.id_no;\n        this.editForm.id_begindate = selectedRela.id_begindate;\n        this.editForm.id_enddate = selectedRela.id_enddate;\n        this.editForm.nationality = selectedRela.nationality;\n      } else if (exist && form == 'form1') {\n        const selectedRela = this.curRelaOptions.find(item => item.related_name === this.editForm1.related_name);\n        this.editForm1.birthday = selectedRela.birthday;\n        this.editForm1.is_government_dept = selectedRela.is_government_dept;\n        this.editForm1.id_type = selectedRela.id_type;\n        this.editForm1.id_no = selectedRela.id_no;\n        this.editForm1.id_begindate = selectedRela.id_begindate;\n        this.editForm1.id_enddate = selectedRela.id_enddate;\n        this.editForm1.nationality = selectedRela.nationality;\n        if ((this.editForm1.related_type == '1' || this.editForm1.related_type == '4') && selectedRela.mobno1) {\n          this.editForm1.mobno1 = selectedRela.mobno1;\n        }\n      } else if (exist && form === 'bomisForm') {\n        // TODO\n        var that = this;\n        const selectedRela = this.curRelaOptions.find(item => item.related_name === that.bomisParams.editBomisForm.related_name);\n        that.bomisParams.editBomisForm.birthday = selectedRela.birthday;\n        that.bomisParams.editBomisForm.is_government_dept = selectedRela.is_government_dept;\n        that.bomisParams.editBomisForm.id_type = selectedRela.id_type;\n        that.bomisParams.editBomisForm.id_no = selectedRela.id_no;\n        that.bomisParams.editBomisForm.id_begindate = selectedRela.id_begindate;\n        that.bomisParams.editBomisForm.id_enddate = selectedRela.id_enddate;\n        that.bomisParams.editBomisForm.nationality = selectedRela.nationality;\n        that.bomisParams.editBomisForm.gender = selectedRela.gender || '';\n        that.bomisParams.editBomisForm.mobno1 = selectedRela.mobno1 || '';\n        that.bomisParams.editBomisForm.mobno2 = selectedRela.mobno2 || '';\n        that.bomisParams.editBomisForm.address = selectedRela.address;\n      }\n    },\n        showBenefitEditDialog: function (row) {\n      var that = this;\n      this.bomisParams.editOneBenefitForm = this.normalizeBomisBenefitForm(row);\n      // 编辑单个受益人信息的时候，需要先预加载下拉框的内容\n      if (that.bomisParams.editOneBenefitForm.bo_type === '1') {\n        this.bomisParams.benefit_company_no_list = this.selectList.benefit_company_no_list.filter(i => {\n          return i.k.startsWith('1') || i.k.startsWith('2') || i.k.startsWith('3') || i.k.startsWith('4') || i.k.startsWith('5') || i.k.startsWith('6')\n        });\n        // bo_type=1 时仍保留已存企业性质/所有权类型，不在打开弹窗时清空\n      } else if (that.bomisParams.editOneBenefitForm.bo_type === '2') {\n        this.bomisParams.benefit_company_no_list = this.selectList.benefit_company_no_list.filter(i => {\n          return !(i.k.startsWith('1') || i.k.startsWith('2') || i.k.startsWith('3') || i.k.startsWith('4') || i.k.startsWith('5') || i.k.startsWith('6'))\n        });\n      } else if (that.bomisParams.editOneBenefitForm.bo_type === '') {\n        this.bomisParams.benefit_company_no_list = [];\n      }\n      var firstChar = (this.bomisParams.editOneBenefitForm.company_type !== '' && this.bomisParams.editOneBenefitForm.company_type !== null) ? this.bomisParams.editOneBenefitForm.company_type[0] : '';\n      if (this.bomisParams.editOneBenefitForm.bo_type !== '') {\n        this.bomisParams.bnf_type_new_list = this.selectList.bnf_type_new_list.filter(i => i.k.startsWith('N' + firstChar));\n      } else if (this.bomisParams.editOneBenefitForm.bo_type === '') {\n        this.bomisParams.bnf_type_new_list = [];\n      }\n      this.bomisParams.benefitEditDialogVisible = true;\n      this.$nextTick(function () {\n        that.syncBomisShareRatioFieldRules(that.bomisParams.editOneBenefitFormRules, that.bomisParams.editOneBenefitForm);\n        if (that.$refs.editOneBenefitForm) {\n          that.$refs.editOneBenefitForm.clearValidate();\n        }\n      });\n    },\n        showBenefitEditDialogByRelated: function (item) {\n      var that = this;\n      Wb.ajax({\n        url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/select_bomis_benefit_scinfo',\n        params: { client_id: '_$client_id$_' },\n        json: true,\n        success(resp) {\n          var row = (resp.items || []).find(i => i.related_id === item.related_id && i.related_name === item.related_name);\n          if (!row) {\n            Wb.error('未找到该受益人信息，请刷新页面后重试');\n            return;\n          }\n          that.showBenefitEditDialog(row);\n        }\n      });\n    },\n        showMessage(msg, time, type) {\n      this.$message({\n        showClose: true,\n        dangerouslyUseHTMLString: true,\n        message: msg,\n        duration: time ? time : 0,\n        type: type ? type : 'success'\n      })\n    },\n        submit() {\n      console.log(\"进入了submit方法--------必填校验\");\n      let props = [];\n      let bool = true;\n      let msg = '';\n      // 1.如果是反洗钱特殊情况选择了“是”，则客户基本信息中的字段非必填，只校验ruleForm3反洗钱特殊情况模块，关联人只校验法定代表人、受益所有人和授权代表人的姓名。\n      if (this.ruleForm3.is_special == '1') {\n        console.log(\"this.attachmentList.communication\", this.attachmentList.communication);\n        console.log(\"this.attachmentList.agree\", this.attachmentList.agree);\n        // 1-1 关联人信息 只有机构类型客户（organ_flag='1'）需要维护关联人信息，自然人客户（organ_flag='0'）没有关联人信息\n        const emptyItem1 = this.relatedInfo1.find(item => {\n          return !item || item.related_name === null || item.related_name === undefined || item.related_name === '';\n        });\n        const emptyItem2 = this.relatedInfo4.find(item => {\n          return !item || item.related_name === null || item.related_name === undefined || item.related_name === '';\n        });\n        const emptyItem3 = this.relatedInfo5.find(item => {\n          return !item || item.related_name === null || item.related_name === undefined || item.related_name === '';\n        });\n        if ((emptyItem1 || this.relatedInfo1.length == 0) && this.organ_flag == '1') {\n          this.showMessage(\"请填写法定代表人姓名！\", 3000, 'error');\n          return;\n        }\n        if ((emptyItem2 || this.relatedInfo4.length == 0) && this.organ_flag == '1') {\n          this.showMessage(\"请填写授权代表人姓名！\", 3000, 'error');\n          return;\n        }\n        if ((emptyItem3 || this.relatedInfo5.length == 0) && this.organ_flag == '1') {\n          this.showMessage(\"请填写受益所有人姓名！\", 3000, 'error');\n          return;\n        }\n        // 1-2 附件信息\n        if (this.attachmentList.communication.length == 0) {\n          this.showMessage(\"请上传“与客户沟通记录”文件\", 3000, 'error');\n          return;\n        }\n        if (this.attachmentList.agree.length == 0) {\n          this.showMessage(\"请上传“二级部门负责人同意的记录”文件\", 3000, 'error');\n          return;\n        }\n        // 1-3 特殊情况表单信息\n        props = ['client_type', 'special_matters', 'special_reason', 'completed_cdd', 'low_risk_explanation', 'take_measures', 'communication_records', 'agree_records']\n        if (this.ruleForm3.client_type.indexOf('99') !== -1) {\n          props.push('client_type_other')\n        }\n        if (this.ruleForm3.special_matters.indexOf('1') !== -1) {\n          props.push('missing_information')\n        }\n        if (this.ruleForm3.special_matters.indexOf('2') !== -1) {\n          props.push('missing_draft')\n        }\n        if (this.ruleForm3.special_matters.indexOf('99') !== -1) {\n          props.push('special_matters_other')\n        }\n        this.$refs['ruleForm3'].validateField(props, function (valid) {\n          if (valid) {\n            bool = false;\n            msg += valid + '<br>';\n          } else {\n          }\n        });\n\n      } else {\n        const keys = Object.keys(this.ruleForm3);\n        for (const key of keys) {\n          if (key !== 'is_special') {\n            this.ruleForm3[key] = ''; // 除了is_special字段外，所有字段都清空为空字符串\n          }\n        }\n        // 2.若选择了“否”，则所有表单必填，控股股东与实控人表单允许为无\n        //   只有机构类型客户（organ_flag='1'）需要维护关联人信息，自然人客户（organ_flag='0'）没有关联人信息\n        if (this.relatedInfo1.length == 0 && this.organ_flag == '1') {\n          this.showMessage(\"请添加法定代表人信息！\", 3000, 'error');\n          return;\n        }\n        if (this.relatedInfo4.length == 0 && this.organ_flag == '1') {\n          this.showMessage(\"请添加授权代表人信息！\", 3000, 'error');\n          return;\n        }\n        if (this.relatedInfo5.length == 0 && this.organ_flag == '1') {\n          this.showMessage(\"请添加受益所有人信息！\", 3000, 'error');\n          return;\n        }\n        // if ((this.organ_flag === '1' && !this.ruleForm1.associated_date) ||\n        //   (this.organ_flag === '0' && !this.ruleForm2.associated_date)) {\n        //   this.showMessage(\"请填写“建立业务关系日期”\", 3000, 'error');\n        //   return;\n        // }\n        if (this.organ_flag == '1') {\n          // formNameArr = ['ruleForm1']; - 机构客户基本表单\n          props = ['client_name', 'office_address', 'register_country', 'register_money_type', 'register_fund',\n            'industry_type', 'tel', 'setup_date', 'id_type', 'id_no', 'id_begindate', 'id_enddate', 'busi_scope', 'associated_date'];\n          if (this.ruleForm1.register_country == '00CN') { //只有境内地区要校验省市区\n            props.push('province');\n            props.push('city');\n            props.push('district');\n          }\n          if (this.ruleForm1.industry_type == '26') {\n            props.push('industry_name');\n          }\n          this.$refs['ruleForm1'].validateField(props, function (valid) {\n            if (valid) {\n              bool = false;\n              msg += valid + '<br>';\n            } else {\n            }\n          });\n          // 关联人必填校验\n          const validateRelatedPerson = (infoArray, typeName) => {\n            const isEmpty = (val) => val === null || val === undefined || String(val).trim() === '';\n            const splitVal = (val) => isEmpty(val) ? [] : (Array.isArray(val) ? val : String(val).split(','));\n\n            for (let i = 0; i < infoArray.length; i++) {\n              const item = infoArray[i];\n              const index = i + 1;\n\n              // 受益所有人按新版受益人弹窗（editOneBenefitFormRules + 各表单项 v-if）的必填规则校验\n              if (item.related_type === '5') {\n                const bnfType = splitVal(item.bnf_type);\n                const hasBnf = (codes) => codes.some(c => bnfType.includes(c));\n                const prefix = `${typeName}${item.related_name || ''}的`;\n                const required = [\n                  ['bo_type', '受益所有人（是否识别受益所有人）'], ['company_type', '企业性质'],\n                  ['full_info_flag', '客户信息披露情况（透明度较高/受益人信息不规范）'],\n                  ['gender', '性别'], ['nationality', '国籍'], ['birthday', '出生年月']\n                ];\n                if (isEmpty(item.related_name)) {\n                  bool = false;\n                  msg += `${typeName}的姓名不能为空<br>`;\n                }\n                if (hasBnf(['NA1', 'NB1', 'ND1'])) {\n                  required.push(['acthdrat', '持有股权、股份或者合伙权益的比例'], ['shareratiostartdate', '形成日期(股权、股份)']);\n                }\n                if (hasBnf(['NA2-1', 'NB2-1', 'ND2-1'])) {\n                  required.push(['actownerprofitratio', '持有收益权的比例'], ['profitratiostartdate', '形成日期(收益权)']);\n                }\n                if (hasBnf(['NA2-2', 'NB2-2', 'ND2-2'])) {\n                  required.push(['actownerprofitratiovote', '持有表决权的比例'], ['profitratiovotestartdate', '形成日期(表决权)']);\n                }\n                if (hasBnf(['NA3-1', 'NA3-2', 'NB3-1', 'NB3-2', 'ND3'])) {\n                  required.push(['actctrltype', '实施实际控制的内容/方式'], ['obtainactdate', '形成日期(实施实际控制)'], ['terminationactdate', '终止日期(实施实际控制)']);\n                }\n                if (hasBnf(['NA3-2', 'NB3-2', 'ND3'])) {\n                  required.push(['actotherforms', '其他形式的具体内容']);\n                }\n                if (hasBnf(['NA3-1', 'NB3-1', 'ND3'])) {\n                  required.push(['actconuppermarket', '是否存在上一层备案主体']);\n                  if (item.actconuppermarket === 'Y') {\n                    required.push(['actconupperentname', '上一层备案主体名称'], ['actconuniscid', '上一层备案主体的统一社会信用代码']);\n                  }\n                }\n                if (hasBnf(['NA4', 'NB4'])) {\n                  required.push(['seniormgrpos', '负责日常经营管理的（高级管理）人员职位']);\n                  if (splitVal(item.seniormgrpos).includes('15')) {\n                    required.push(['actdailymgmtpostother', '公司章程规定的其他（高级管理）人员的具体职位']);\n                  }\n                }\n                if (hasBnf(['NA5'])) {\n                  required.push(['seniormgrposcn', '在华最高层级的高级管理人员职位']);\n                  if (splitVal(item.seniormgrposcn).includes('1')) {\n                    required.push(['ownerrightmgmtpostother', '在华最高层级的高级管理其他职位']);\n                  }\n                }\n                required.forEach(([field, label]) => {\n                  if (isEmpty(item[field])) {\n                    bool = false;\n                    msg += `${prefix}${label}不能为空<br>`;\n                  }\n                });\n                continue;\n              }\n\n              // 如果是政府部门，只校验姓名和是否政府部门字段\n              if (item.is_government_dept === '1') {\n                if (isEmpty(item.related_name)) {\n                  bool = false;\n                  msg += `${typeName}的姓名不能为空<br>`;\n                }\n                continue;\n              }\n\n              // 普通必填字段校验\n              if (isEmpty(item.related_name)) {\n                bool = false;\n                msg += `${typeName}的姓名不能为空<br>`;\n              }\n              if (isEmpty(item.nationality)) {\n                bool = false;\n                msg += `${typeName}${item.related_name}的国籍不能为空<br>`;\n              }\n              if (isEmpty(item.id_type)) {\n                bool = false;\n                msg += `${typeName}${item.related_name}的证件类型不能为空<br>`;\n              }\n              if (isEmpty(item.id_no)) {\n                bool = false;\n                msg += `${typeName}${item.related_name}的证件号码不能为空<br>`;\n              }\n              if (isEmpty(item.id_begindate)) {\n                bool = false;\n                msg += `${typeName}${item.related_name}的证件开始日期不能为空<br>`;\n              }\n              if (isEmpty(item.id_enddate)) {\n                bool = false;\n                msg += `${typeName}${item.related_name}的证件结束日期不能为空<br>`;\n              }\n\n              // 如果是机构（organ_flag='1'），校验是否政府部门字段\n              if (item.organ_flag === '1') {\n                if (item.is_government_dept !== '0' && item.is_government_dept !== '1') {\n                  bool = false;\n                  msg += `${typeName}${item.related_name}的是否政府部门不能为空<br>`;\n                }\n              }\n\n              // 如果是个人（organ_flag='0'），校验出生日期字段\n              if (item.organ_flag === '0') {\n                if (isEmpty(item.birthday)) {\n                  bool = false;\n                  msg += `${typeName}${item.related_name}的出生日期不能为空<br>`;\n                }\n              }\n\n              // 法定代表人和授权代表人特殊校验（related_type='1' ||related_type='4'）\n              if (item.related_type === '1' || item.related_type === '4') {\n                if (isEmpty(item.mobno1)) {\n                  bool = false;\n                  msg += `${typeName}${item.related_name}的联系方式不能为空<br>`;\n                }\n              }\n            }\n          };\n\n          // 校验五种类型的关联人数据\n          validateRelatedPerson(this.relatedInfo1, '法定代表人');\n          validateRelatedPerson(this.relatedInfo2, '控股股东');\n          validateRelatedPerson(this.relatedInfo3, '实际控制人');\n          validateRelatedPerson(this.relatedInfo4, '授权代表人');\n          validateRelatedPerson(this.relatedInfo5, '受益所有人');\n        } else {\n          // formNameArr = ['ruleForm2']; - 自然人客户基本表单\n          props = ['client_name', 'birthday', 'id_address', 'address', 'nationality', 'gender', 'income',\n            'profession_code', 'id_type', 'id_no', 'id_begindate', 'id_enddate', 'associated_date'];\n          if (this.ruleForm2.nationality == '00CN') {\n            props.push('province1');\n            props.push('city1');\n            props.push('district1');\n            props.push('province2');\n            props.push('city2');\n            props.push('district2');\n          }\n          this.$refs['ruleForm2'].validateField(props, function (valid) {\n            if (valid) {\n              bool = false;\n              msg += valid + '<br>';\n            } else {\n\n            }\n          });\n        }\n      }\n      if (!bool && msg) {\n        this.showMessage(msg, 5000, 'error')\n      }\n      return bool;\n    },\n        submitUpload() {\n      if (this.fileList.length === 0) {\n        this.$message.warning(\"请至少选择一个文件\");\n        return;\n      }\n      if (this.selectedMenu.length === 0) {\n        this.$message.warning(\"请选择附件类型\");\n        return;\n      }\n\n      this.uploadParams.file_type_no = Array.isArray(this.selectedMenu) ? this.selectedMenu[this.selectedMenu.length - 1] : this.selectedMenu;\n\n      // 使用计数器跟踪上传完成情况\n      let completedCount = 0;\n      const totalFiles = this.fileList.length;\n\n      const checkAllCompleted = () => {\n        completedCount++;\n        if (completedCount === totalFiles) {\n          // 所有文件都上传完成后，设置弹窗不可见\n          this.selectFile();\n          this.fileDialogVisible = false;\n        }\n      };\n\n      for (const file of this.fileList) {\n        this.uploadParams.file1 = file.raw;\n        this.uploadFile(file).then(() => {\n          // 使用setTimeout确保异步执行，避免阻塞\n          setTimeout(checkAllCompleted, 0);\n        });\n      }\n    },\n        syncBomisShareRatioFieldRules: function (rules, form) {\n      var that = this;\n      var ruleKeys = [\n        'acthdrat', 'shareratiostartdate', 'shareratioenddate',\n        'actownerprofitratio', 'profitratiostartdate', 'profitratioenddate',\n        'actownerprofitratiovote', 'profitratiovotestartdate', 'profitratiovoteenddate'\n      ];\n      var bnf = form.bnf_type;\n      if (!Array.isArray(bnf)) {\n        bnf = bnf ? String(bnf).split(',') : [];\n      }\n      var hasShare = ['NA1', 'NB1', 'ND1'].some(function (c) { return bnf.indexOf(c) >= 0; });\n      var hasProfit = ['NA2-1', 'NB2-1', 'ND2-1'].some(function (c) { return bnf.indexOf(c) >= 0; });\n      var hasVote = ['NA2-2', 'NB2-2', 'ND2-2'].some(function (c) { return bnf.indexOf(c) >= 0; });\n      ruleKeys.forEach(function (k) {\n        that.$delete(rules, k);\n      });\n      if (hasShare) {\n        that.$set(rules, 'acthdrat', [{ required: true, message: '请填写持有股权、股份或者合伙权益的比例', trigger: 'change' }]);\n        that.$set(rules, 'shareratiostartdate', [{ required: true, message: '请选择形成日期(股权、股份)', trigger: 'change' }]);\n      }\n      if (hasProfit) {\n        that.$set(rules, 'actownerprofitratio', [{ required: true, message: '请填写持有收益权的比例', trigger: 'change' }]);\n        that.$set(rules, 'profitratiostartdate', [{ required: true, message: '请选择形成日期(收益权)', trigger: 'change' }]);\n      }\n      if (hasVote) {\n        that.$set(rules, 'actownerprofitratiovote', [{ required: true, message: '请填写持有表决权的比例', trigger: 'change' }]);\n        that.$set(rules, 'profitratiovotestartdate', [{ required: true, message: '请选择形成日期(表决权)', trigger: 'change' }]);\n      }\n    },\n        uploadError() {\n      app.uploadError();\n    },\n        uploadFile(file) {\n      let that = this;\n      return new Promise((resolve) => {\n        Wb.ajax({\n          url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/files/upload_file1',\n          params: this.uploadParams,\n          success(resp) {\n            that.$message.success('上传成功');;\n            resolve(); // 上传完成时resolve\n          },\n          error() {\n            resolve(); // 即使出错也要resolve，确保计数器能继续\n          }\n        });\n      });\n    },\n        uploadSuccess() {\n      Wb.tipSucc(\"上传成功\");\n      this.fileDialogVisible = false;\n    },\n        validateBusinessLicense(rule, value, callback) {\n      if (!value) {\n        callback();\n        return;\n      }\n      // 统一社会信用代码为18位，由数字和大写字母组成\n      const reg = /^[0-9A-HJ-NPQRTUWXY]{2}\\d{6}[0-9A-HJ-NPQRTUWXY]{10}$/;\n      if (reg.test(value)) {\n        callback();\n      } else {\n        callback(new Error('请输入正确的统一社会信用代码格式'));\n      }\n    },\n        validateIdCard(rule, value, callback) {\n      if (!value) {\n        callback();\n        return;\n      }\n      // 15位或18位身份证号码正则\n      const reg = /^[1-9]\\d{5}(18|19|([23]\\d))\\d{2}((0[1-9])|(10|11|12))(([0-2][1-9])|10|20|30|31)\\d{3}[0-9Xx]$/;\n      if (reg.test(value)) {\n        callback();\n      } else {\n        callback(new Error('请输入正确的身份证号码格式'));\n      }\n    },\n        validateIdNoForBasicInfo() {\n      return (rule, value, callback) => {\n        if (!value) {\n          callback(new Error('请输入\"证件号码\"'));\n          return;\n        }\n        // 根据主体类型判断是机构户还是个人户\n        const idType = this.organ_flag === '1' ? this.ruleForm1.id_type : this.ruleForm2.id_type;\n\n        // 根据证件类型进行格式校验\n        if (idType === '1') {\n          // 身份证\n          const reg = /^[1-9]\\d{5}(18|19|([23]\\d))\\d{2}((0[1-9])|(10|11|12))(([0-2][1-9])|10|20|30|31)\\d{3}[0-9Xx]$/;\n          if (reg.test(value)) {\n            callback();\n          } else {\n            callback(new Error('请输入正确的身份证号码格式'));\n          }\n        } else if (idType === '3') {\n          // 营业执照（统一社会信用代码）\n          const reg = /^[0-9A-HJ-NPQRTUWXY]{2}\\d{6}[0-9A-HJ-NPQRTUWXY]{10}$/;\n          if (reg.test(value)) {\n            callback();\n          } else {\n            callback(new Error('请输入正确的统一社会信用代码格式'));\n          }\n        } else {\n          callback();\n        }\n      };\n    },\n        validateIdNoForRelated() {\n      return (rule, value, callback) => {\n        if (!value) {\n          callback(new Error('请输入\"证件号码\"'));\n          return;\n        }\n        // 判断当前是哪个弹窗（editForm 或 editForm1）\n        const currentForm = this.dialogFormVisible ? this.editForm : this.editForm1;\n        const idType = currentForm.id_type;\n\n        // 根据证件类型进行格式校验\n        if (idType === '1') {\n          // 身份证\n          const reg = /^[1-9]\\d{5}(18|19|([23]\\d))\\d{2}((0[1-9])|(10|11|12))(([0-2][1-9])|10|20|30|31)\\d{3}[0-9Xx]$/;\n          if (reg.test(value)) {\n            callback();\n          } else {\n            callback(new Error('请输入正确的身份证号码格式'));\n          }\n        } else if (idType === '3') {\n          // 营业执照（统一社会信用代码）\n          const reg = /^[0-9A-HJ-NPQRTUWXY]{2}\\d{6}[0-9A-HJ-NPQRTUWXY]{10}$/;\n          if (reg.test(value)) {\n            callback();\n          } else {\n            callback(new Error('请输入正确的统一社会信用代码格式'));\n          }\n        } else {\n          callback();\n        }\n      };\n    },\n  },\n  created: function () {\n    // 加载字典\n    setTimeout(() => {\n      if (!this.client_id) {\n        this.client_id = app.data.client_id\n      }\n      this.selectList = Object.assign({}, this.selectList, app.data.selectList || {});\n      this.selectList.id_type_list = app.data.selectList.id_type_list;\n      this.selectList.id_type_gr_list = app.data.selectList.id_type_gr_list;\n      this.selectList.nationality_list = app.data.selectList.nationality_list;\n      this.selectList.related_type_list = app.data.selectList.related_type_list;\n      this.selectList.beneficiary_list = app.data.selectList.beneficiary_list || [];\n    }, 1000);\n  },\n});"
                      }
                    },
                    {
                      "_icon": "container",
                      "text": "otherInfo",
                      "cls": "Wb.Container",
                      "properties": {
                        "cid": "otherInfo",
                        "padding": "10px 0"
                      },
                      "hasDupCid": 0,
                      "events": {
                        "ready": "let comp = this;\ncomp.vue = new Vue({\n  el: comp.el.addEl(),\n  template: `\n<el-card>\n  <!-- 标题行 -->\n  <div slot=\"header\">\n    <span class=\"card-title\" v-if=\"organ_flag=='1'\">声明：本机构保证所提供资料的真实性、准确性、完整性、有效性，并对其承担责任；\n                如上述内容发生变更时将及时以书面方式通知贵公司，如因为不能及时完成变更由此产生的一切后果将由本机构承担。<br>\n      机构盖章：</span>\n    <span class=\"card-title\" v-if=\"organ_flag==='0'\">声明：本人保证前述所填信息以及所提供资料的真实性、准确性、完整性、有效性，并对其承担责任；\n      如上述内容发生变更时将及时以书面方式通知贵公司，如因为不能及时完成变更由此产生的一切后果将由本人承担。<br><br>\n      签名：<br></span>\n  </div>\n\n  <div>\n    <el-form label-width=\"140px\" :rules=\"formRules\" ref=\"form\">\n      <el-form-item label=\"建立业务关系日期\" prop=\"associated_date\">\n        <el-date-picker type=\"date\" placeholder=\"选择日期\" v-model=\"associated_date\" format=\"yyyy-MM-dd\" :clearable=\"false\">\n        </el-date-picker><span style=\"color:#F56C6C;\">&nbsp;&nbsp;填写后不可更改，请谨慎填写！</span>\n      </el-form-item>\n      <el-form-item label=\"备注\" prop=\"remark\">\n        <el-input type=\"textarea\" style=\"width:100%\" v-model=\"remark\"></el-input>\n      </el-form-item>\n    </el-form>\n  </div>\n</el-card>\n`,\n  data() {\n    return {\n      organ_flag:'_$organ_flag$_',\n      associated_date: '',//建立业务关系日期\n      remark: '',//备注\n      formRules: {\n        associated_date: [\n          { required: true, message: '请填写建立业务关系日期', trigger: 'blur' }\n        ]\n      }\n    };\n  },\n  methods: {\n  },\n  created: function () {\n    const today = new Date();\n    const year = today.getFullYear();\n    const month = String(today.getMonth()+1).padStart(2,'0');\n    const day = String(today.getDate()).padStart(2,'0');\n    this.associated_date = `${year}-${month}-${day}`\n  },\n});"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "_icon": "card",
              "text": "card2",
              "cls": "Wb.Card",
              "properties": {
                "cid": "card2",
                "title": "附件导入",
                "closable": "null",
                "layout": "fit"
              },
              "_expanded": true,
              "items": [
                {
                  "_icon": "container",
                  "text": "fileManage",
                  "cls": "Wb.Container",
                  "properties": {
                    "cid": "fileManage"
                  },
                  "events": {
                    "ready": "let comp = this;\ncomp.vue = new Vue({\n  el: comp.el.addEl(),\n  template: `\n<div class=\"file-container\">\n  <!-- 左侧目录树 -->\n  <div class=\"left-panel\" ref=\"leftPanel\">\n    <div class=\"panel-title\">附件类型目录</div>\n    <div class=\"search-box\">\n      <el-input \n        placeholder=\"输入关键字进行过滤\" \n        v-model.trim=\"filterText\"\n        clearable\n        >\n        <i slot=\"prefix\" class=\"el-input__icon el-icon-search\"></i>\n      </el-input>\n    </div>\n\n    <el-tree \n      class=\"filter-tree\" \n      ref=\"tree\" \n      :data=\"organ_flag==='0'?directoryConfig2:directoryConfig1\" \n      :props=\"defaultProps\"\n      default-expand-all \n      :filter-node-method=\"filterNode\" \n      :expand-on-click-node=\"false\" \n      @node-click=\"handleNodeClick\" \n      highlight-current\n    >\n      <span \n        class=\"custom-tree-node\" \n        slot-scope=\"{ node, data }\"\n        :data-node-key=\"data.value\" \n        @dragenter=\"handleTreeDragEnter($event, node, data)\" \n        @dragover=\"handleTreeDragOver($event, node, data)\" \n        @drop=\"handleTreeDrop($event, node, data)\"\n      >\n        <span>{{ node.label }}</span>\n      </span>\n    </el-tree>\n  </div>\n\n  <!-- 右侧附件列表 -->\n  <div class=\"right-panel\">\n    <!--<div style=\"color:#F56C6C;padding-left:0 0 40px 0;\">【*附件上传后即为保存，将不允许修改和删除，如有错误可用新的同名文件更新替换】</div>-->\n    <div v-if=\"!selectedMenu\" style=\"display: flex; justify-content: center; align-items: center; height: 100%; color: #909399; font-size: 14px;\">请先从左侧选择目录</div>\n    <div v-else>\n      <div class=\"panel-title\">附件清单 - {{ selectedMenu.label }}</div>\n      <el-table :data=\"attachmentList\" stripe border class=\"attachment-table\" v-loading=\"loading\" :default-sort = \"{prop: 'date', order: 'descending'}\">\n        <el-table-column prop=\"name\" label=\"附件名称\" min-width=\"180\" :default-sort = \"{prop: 'date', order: 'descending'}\">\n          <template slot-scope=\"scope\">\n            <el-button type=\"text\" \n                      @click=\"handleDownload(scope.row)\" \n                      class=\"attachment-btn\"\n                      draggable=\"true\"\n                      native-type=\"button\"\n                      @dragstart.native=\"handleDragStart(scope.row)\"\n                      >\n            {{ scope.row.name }}\n            </el-button>\n          </template>\n        </el-table-column>\n        <el-table-column prop=\"extension\" label=\"附件类型\" width=\"120\"></el-table-column>\n        <el-table-column prop=\"create_time\" label=\"上传时间\" width=\"160\" sortable></el-table-column>\n        <el-table-column prop=\"file_size\" label=\"附件大小\" width=\"120\" sortable>\n          <template slot-scope=\"scope\">\n            {{ formatSize(scope.row.file_size) }}\n          </template>\n        </el-table-column>\n        <el-table-column prop=\"create_by\" label=\"上传人\" width=\"120\" sortable></el-table-column>\n        <el-table-column prop=\"create_time\" label=\"操作\" width=\"180\">\n          <template slot-scope=\"scope\">\n            <div class=\"operation-buttons\">\n              <el-tooltip content=\"预览\"><el-button type=\"text\" class=\"el-icon-view\" @click=\"handlePreview(scope.row)\"></el-button></el-tooltip>\n              <el-tooltip content=\"下载\"><el-button type=\"text\" class=\"el-icon-download\" @click=\"handleDownload(scope.row)\"></el-button></el-tooltip>\n              <!--<el-tooltip content=\"删除\"><el-button type=\"text\" class=\"el-icon-delete\" @click=\"handleDelete(scope.row)\"></el-button></el-tooltip>-->\n            </div>\n          </template>\n        </el-table-column>\n      </el-table>\n      <div style=\"display:flex;width:100%\" v-if=\"this.selectedMenu.label!='全部'\">\n        <el-upload class=\"upload-demo-drag\" ref=\"upload\" drag\n          action=\"m?xwl=aml_monitor/workflow/prs01/dataSource/files/upload_file1\" name=\"file1\"\n          header=\"{content-type:'text/html'}\" :data=\"uploadParams\" :auto-upload=\"true\" :on-change=\"handleChange\" :before-upload=\"handleBeforeUpload\"\n          :on-remove=\"handleRemove\" :on-success=\"handleSuccess\" :show-file-list=\"false\" multiple style=\"flex:1\">\n          <i class=\"el-icon-upload\"></i>\n          <div class=\"el-upload__text\">将文件拖到此处，或<em>点击上传</em></div>\n        </el-upload>\n      </div>\n    </div>\n  </div>\n</div>\n`,\n  data() {\n    return {\n      filterText: '', // 用于筛选\n      organ_flag: '_$organ_flag$_',\n      directoryConfig1: app.data.directory.directoryConfig1,\n      directoryConfig2: app.data.directory.directoryConfig2,\n      defaultProps: {\n        children: 'children',\n        label: 'label'\n      },\n      uploadParams: {\n        objectId: Wb.getId(),\n      },\n      client_id: '_$client_id$_',\n      selectedMenu: null,\n      attachmentList: [],\n      loading: false,\n      fileList: [],\n      dropTargetNode: null,\n      draggingFile: null,\n    };\n  },\n  // 新增 watch：监听 filterText 变化并触发 tree 过滤\n  watch: {\n    filterText(val) {\n      // 必须等 DOM 更新后才能调用 $refs.tree\n      this.$nextTick(() => {\n        if (this.$refs.tree) {\n          this.$refs.tree.filter(val);\n        }\n      });\n    }\n  },\n  methods: {\n    // 过滤方法\n    filterNode(value, data) {\n      if (!value) return true;\n      // 支持模糊搜索（不区分大小写）\n      return data.label.toLowerCase().includes(value.toLowerCase());\n    },\n    // 格式化附件大小\n    formatSize(bytes) {\n      if (!bytes && bytes !== 0) {\n        return '';\n      } else if (bytes === 0) {\n        return '0 B'\n      };\n\n      const k = 1024;\n      const sizes = ['B', 'KB', 'MB', 'GB', 'TB'];\n      const i = Math.floor(Math.log(bytes) / Math.log(k));\n\n      return (bytes / Math.pow(k, i)).toFixed(2) + ' ' + sizes[i];\n    },\n    handleNodeClick(data) {\n      this.selectedMenu = data;\n      console.log(\"selectedMenu\", this.selectedMenu);\n      this.uploadParams.file_type_no = this.selectedMenu.value;\n      this.loadAttachments(this.selectedMenu.value);\n    },\n    handleBeforeUpload(file) {\n      this.uploadParams.client_id = this.client_id\n    },\n    loadAttachments(directoryId) {\n      let that = this;\n      Wb.ajax({\n        url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/files/select_file',\n        params: {\n          I_CLIENT_ID: this.client_id,\n          I_FILE_TYPE_NO: directoryId\n        },\n        success(resp) {\n          let res = Wb.decode(resp).items;\n          that.attachmentList = res;\n        }\n      });\n    },\n\n    // 下载附件\n    handleDownload(row) {\n      console.log(\"当前文件row\", row);\n      if (row.file_size) {\n        Wb.download({\n          url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/files/download_file',\n          params: {\n            id: row.id,\n            full_name: row.name + '.' + row.extension\n          }\n        })\n      } else {\n        this.$message.error('当前文件为空！请确认上传是否无误');\n      }\n    },\n\n    handleChange(file, fileList) {\n      this.fileList = fileList;\n      // app.entityRegistration.vue.selectFile();\n      if (this.organ_flag == '0') {\n        app.basicInfo.vue.loadAttachments('1')\n      } else {\n        app.basicInfo.vue.loadAttachments('1,2,21,22')\n      }\n    },\n\n    handleDelete(row) {\n      this.$confirm(`确定要删除\"${row.name}\"吗?`, '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(() => {\n        console.log(row)\n        let that = this;\n        Wb.ajax({\n          url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/files/delete_file',\n          params: {\n            file_pk_id: row.id\n          },\n          success() {\n            that.$message.success('删除成功');\n            that.loadAttachments(that.selectedMenu.value);\n            if (that.organ_flag === '0') {\n              app.basicInfo.vue.loadAttachments('1')\n            } else {\n              app.basicInfo.vue.loadAttachments('1,2,21,22')\n            }\n            console.log(\"app.basicInfo.vue\", app.basicInfo.vue);\n          }\n        })\n      }).catch(() => { });\n    },\n\n    handleSuccess(resp) {\n      if (resp.O_RETURN_CODE == 0) {\n        // Wb.tipSucc(\"上传成功\");\n        this.$message.success(\"上传成功\")\n        this.loadAttachments(this.selectedMenu.value);\n      } else {\n        this.$message.error(resp.O_RETURN_MSG);\n      }\n    },\n\n    handleRemove(file, fileList) {\n      console.log(file, fileList);\n    },\n    handlePreview(file) {\n      let that = this;\n      params_file = {\n        'id': file.id,\n        'clientId': file.client_id,\n        'fileTypeNo': this.organ_flag == '1' ? '1,2,21,22' : '1,2',\n        'fileName': file.name + '.' + file.extension,\n        'extension': file.extension\n      },\n        Wb.ajax({\n          url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/files/preview_file',\n          params: {\n            id: file.id,\n            clientId: file.client_id,\n            fileTypeNo: this.organ_flag == '1' ? '1,2,21,22' : '1,2',\n            fileName: file.name + '.' + file.extension,\n            extension: file.extension\n          },\n          success(resp) {\n            console.log(\"resp\", resp);\n            let res = Wb.decode(resp);\n            let serverIp = '10.116.131.13';\n            if (res.code == '200') {\n              let previewUrl = res.data.previewUrl;\n              if (previewUrl.indexOf(serverIp) != -1) {\n                previewUrl = res.data.previewUrl.replace(/10\\.116\\.131\\.13:8090/g, '10.181.135.22:8080/ibcm_flow')\n              }\n              window.open(previewUrl, '_blank', 'width=800,height=600')\n            } else {\n              that.$message.error(\"当前文件类型不支持预览\")\n            }\n          }\n        });\n    },\n    handleExceed(files, fileList) {\n      this.$message.warning(`当前限制选择 3 个文件，本次选择了 ${files.length} 个文件，共选择了 ${files.length + fileList.length} 个文件`);\n    },\n    beforeRemove(file, fileList) {\n      return this.$confirm(`确定移除 ${file.name}？`);\n    },\n\n    handleDragStart(file) {\n      this.draggingFile = file;\n      console.log(\"dragfile:\", this.draggingFile);\n    },\n\n    handleTreeDragEnter(event, node, data) {\n      event.preventDefault();\n      this.dropTargetNode = node;\n    },\n\n    handleTreeDragOver(event, node, data) {\n      console.log(\"handleTreeDragOver\", node.data);\n      event.preventDefault();\n      this.dropTargetNode = node;\n    },\n\n    handleTreeDrop(event) {\n      let that = this;\n      console.log(\"handleTreeDrop\");\n      event.preventDefault();\n      event.stopPropagation();\n\n      if (!this.draggingFile || !this.dropTargetNode) return;\n\n      const file = this.draggingFile;\n      const targetNode = this.dropTargetNode;\n\n      let tip = '确定要把 “' + file.name + '” 移动到 “' + targetNode.label + '” 目录下吗？'\n      Wb.confirm(tip, function () {\n        Wb.ajax({\n          url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/files/update_file_dir',\n          params: {\n            I_FILE_TYPE_NO: targetNode.data.value,\n            I_ID: file.id\n          },\n          success(resp) {\n            that.loadAttachments(that.selectedMenu.value);\n            that.$message.success(\"操作成功\")\n            if (that.organ_flag === '0') {\n              app.basicInfo.vue.loadAttachments('1')\n            } else {\n              app.basicInfo.vue.loadAttachments('1,2,21,22')\n            }\n          }\n        })\n      });\n      this.draggingFile = null;\n      this.dropTargetNode = null;\n    },\n  },\n  mounted: function () {\n    const leftPanel = this.$refs.leftPanel;\n    let isResizing = false;\n    leftPanel.addEventListener('mouseenter', (e) => {\n      if (e.offsetX > leftPanel.offsetWidth - 5) {\n        document.body.style.cursor = 'col-resize';\n      }\n    });\n    leftPanel.addEventListener('mouseleave', (e) => {\n      if (e.offsetX > leftPanel.offsetWidth - 10) {\n        document.body.style.cursor = 'auto';\n      }\n    });\n    leftPanel.addEventListener('mousedown', (e) => {\n      if (e.offsetX > leftPanel.offsetWidth - 10) {\n        isResizing = true;\n        document.body.style.cursor = 'col-resize';\n        document.body.style.userSelect = 'none';\n      }\n    });\n\n    document.addEventListener('mousemove', (e) => {\n      if (!isResizing) return;\n\n      const newWidth = e.clientX - leftPanel.getBoundingClientRect().left;\n      if (newWidth >= 250 && newWidth <= 600) {\n        leftPanel.style.width = newWidth + 'px';\n      }\n    });\n\n    document.addEventListener('mouseup', () => {\n      isResizing = false;\n      document.body.style.cursor = '';\n      document.body.style.userSelect = '';\n    });\n  },\n  created: function () {\n    setTimeout(() => {\n      if (!this.client_id) {\n        this.client_id = app.data.client_id\n      }\n    }, 800)\n  }\n});"
                  },
                  "hasDupCid": 0
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}