{
  "title": "客户信息审核",
  "icon": "",
  "img": "",
  "tags": "",
  "hideInMenu": "true",
  "text": "module",
  "cls": "Wb.Module",
  "properties": {
    "cid": "module",
    "links": "[\n  \"wb/custom-made/js/prs01.js\",\n  \"wb/libs/exportPdf/html2canvas.js\",\n  \"wb/libs/exportPdf/jspdf.debug.js\"\n]"
  },
  "_icon": "module",
  "_expanded": true,
  "events": {
    "initialize": "let rules = getRules();\nlet forms = getRuleForm();\nlet directory = getDirConfig();\nlet selectKey = getSelectKey();\n\n// 定义全局变量\nlet data = {\n  rules: rules,// 表单校验规则\n  forms: forms,// 表单\n  list: selectKey.list,\n  dict: selectKey.dict,\n  directory: directory,// 附件目录\n  selectList: {},\n  fileDialogVisible: false,\n  basicInfo: {},// 客户基本信息\n  gshcInfo: {\n    name: '',\n    office_address: '',\n    register_money_type: '',\n    register_fund: '',\n    setup_date: '',\n    id_begindate: '',\n    id_enddate: ''\n  },// 工商核查信息\n  relatedInfo1: [],// 法定代表人\n  relatedInfo2: [],// 控股股东\n  relatedInfo3: [],// 实际控制人\n  relatedInfo4: [],// 授权代表人\n  relatedInfo5: [],// 受益所有人\n  errTypeOptions: []// 错误类型\n}\n\nWb.apply(app, {\n  data: data,\n  loadSelectList(item) {\n    if (!Wb.isEmpty(item.KEY_NAME)) {\n      Wb.ajax({\n        url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/select_key',\n        params: {\n          I_KEY_NAME: item.KEY_NAME\n        },\n        success(resp) {\n          let arr = Wb.decode(resp).items;\n          app.data.selectList[item.BIND_DATA + \"_list\"] = arr;\n        }\n      });\n    }\n  },\n  getDictMap(item) {\n    Wb.ajax({\n      url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/select_dict',\n      params: {\n        I_ENTRY_NO: item.ENTRY_NO\n      },\n      success(resp) {\n        let arr = Wb.decode(resp).items;\n        app.data.selectList[item.BIND_DATA + \"_list\"] = arr;\n      }\n    })\n  },\n  // 页面展示数据字典转换\n  formatDictMap(dictType, key) {\n    const dictData = this.selectList[dictType];\n    const item = dictData.find(item => item.k === key);\n    return item ? item.v : '-';\n  },\n  formatAddress(dict, key) {\n    const item = dict.find(item => item.k === key);\n    return item ? item.v : key;\n  },\n  // 查询客户基本信息\n  getBasicInfo(client_id) {\n    Wb.ajax({\n      url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/select_basic_info',\n      params: {\n        CLIENT_ID: client_id\n      },\n      success(resp) {\n        let res = Wb.decode(resp).items;\n        console.log(\"res[0]\", res[0])\n        if (res[0]) {\n          app.data.basicInfo = res[0];\n        }\n        \n        console.log(\"客户基本信息resp\", res[0]);\n        app.mainContainer.show();\n      }\n    });\n  },\n  // 查询关联人信息\n  getRelatedInfo(client_id, rela_type) {\n    Wb.ajax({\n      url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/select_related_info_hg',\n      params: {\n        CLIENT_ID: client_id,\n        RELATED_TYPE: rela_type\n      },\n      success(resp) {\n        let res = Wb.decode(resp).items;\n        if (res.length > 0 && rela_type == '1') {\n          app.data.relatedInfo1 = res;\n          console.log(\"法定代表人信息\", res);\n        } else if (res.length > 0 && rela_type == '2') {\n          app.data.relatedInfo2 = res;\n          console.log(\"控股股东信息\", res);\n        } else if (res.length > 0 && rela_type == '3') {\n          app.data.relatedInfo3 = res;\n          console.log(\"实际控制人信息\", res);\n        } else if (res.length > 0 && rela_type == '4') {\n          app.data.relatedInfo4 = res;\n          console.log(\"授权代表人信息\", res);\n        } else if (res.length > 0 && rela_type == '5') {\n          app.data.relatedInfo5 = res;\n          console.log(\"受益所有人信息\", res);\n        }\n      }\n    });\n  },\n\n});\n\n"
  },
  "items": [
    {
      "_icon": "viewport",
      "text": "viewport1",
      "cls": "Wb.Viewport",
      "properties": {
        "cid": "viewport1",
        "layout": "row"
      },
      "_expanded": true,
      "events": {
        "ready": "// 个人户没有工商核查\nif('_$organ_flag$_'=='0'){\n  app.qccMatch.hide()\n}\n\napp.data.list.forEach(item => {\n  app.loadSelectList(item);\n});\n\napp.data.dict.forEach(item => {\n  app.getDictMap(item);\n});\n\n// 获取客户基本信息\napp.getBasicInfo('_$client_id$_');\n// 获取法定代表人信息\napp.getRelatedInfo('_$client_id$_', '1');\n// 获取控股股东信息\napp.getRelatedInfo('_$client_id$_', '2');\n// 获取实际控制人信息\napp.getRelatedInfo('_$client_id$_', '3');\n// 获取授权代表人信息\napp.getRelatedInfo('_$client_id$_', '4');\n// 获取受益所有人信息\napp.getRelatedInfo('_$client_id$_', '5');\n\n// 只有合规人员有权查看反馈结果页面\nif ('_$fk_flag$_' == '0') {\n  app.card3.cardVisible = false;\n} else {\n  // app.card3.cardVisible = true;\n}\n\napp.apprForm.vue.getApprData(\"0\");//审核记录回显第一个tab页"
      },
      "items": [
        {
          "_icon": "tab",
          "text": "tab1",
          "cls": "Wb.Tab",
          "_expanded": true,
          "properties": {
            "cid": "tab1",
            "full": "true",
            "border": "false",
            "tabPosition": "top",
            "tabSortable": "false",
            "cls": "tabcls",
            "autoScroll": "auto-x",
            "minWidth": "300px"
          },
          "items": [
            {
              "_icon": "card",
              "text": "card1",
              "cls": "Wb.Card",
              "properties": {
                "cid": "card1",
                "title": "客户基本信息详情",
                "closable": "null",
                "layout": "column"
              },
              "_expanded": true,
              "hasDupCid": 0,
              "items": [
                {
                  "_icon": "toolbar",
                  "text": "tbar",
                  "cls": "Wb.Toolbar",
                  "properties": {
                    "cid": "tbar",
                    "gap": "true",
                    "padding": "0 10px 10px 0"
                  },
                  "_expanded": true,
                  "items": [
                    {
                      "_icon": "right1",
                      "text": "fill1",
                      "cls": "Wb.Fill",
                      "properties": {
                        "cid": "fill1"
                      }
                    },
                    {
                      "_icon": "label",
                      "text": "updateTimeLabel",
                      "cls": "Wb.Label",
                      "properties": {
                        "cid": "updateTimeLabel",
                        "style": "color:#606266;margin-right:10px;"
                      }
                    },
                    {
                      "_icon": "button",
                      "text": "qccMatch",
                      "cls": "Wb.Button",
                      "properties": {
                        "cid": "qccMatch",
                        "text": "工商核查",
                        "type": "primary"
                      },
                      "events": {
                        "click": "console.log(\"client_name\", '_$client_name$_')\nif (app.mainContainer.vue.gshcInfoVisible == false) {\n  app.qccMatch.text = '取消展示';\n  Wb.ajax({\n    url: 'm?xwl=aml_monitor/aml_interface/qcc_beneficiary_interface/flow-push',\n    params: {\n      FULL_NAME: '_$client_name$_',\n      PORT_TYPE: '1',// 1企查查 2元素 3中数 4鲸腾\n      ORDER_NO: Wb.getId(),//订单号 唯一主键即可\n    },\n    success(resp) {\n      var res = Wb.decode(resp);\n      console.log(resp);\n      if (res && res.Status == '200') {\n        let result = res.Result;\n        console.log(\"result\", result);\n        app.data.gshcInfo.name = result.Name;\n        app.data.gshcInfo.office_address = result.Address;// 办公地址-详细地址\n        // 注册国家地区\n        app.data.gshcInfo.register_money_type = result.RegisteredCapitalCCY;// 注册资本金币种\n        app.data.gshcInfo.register_fund = result.RegistCapi;// 注册资本金（万元）\n        app.data.gshcInfo.busi_scope = result.Scope;// 经营范围\n        app.data.gshcInfo.setup_date = String(result.StartDate).replace(/\\s.*$/, '');// 成立日期\n        app.data.gshcInfo.id_begindate = String(result.TermStart).replace(/\\s.*$/, '');// 营业期限始\n        app.data.gshcInfo.id_enddate = String(result.TermEnd).replace(/\\s.*$/, '');// 营业期限止\n        // 统一社会信用代码（营业执照）\n        if (result.CreditCode) {\n          console.log(\"1111\")\n          app.data.gshcInfo.id_no = result.CreditCode;\n          app.data.gshcInfo.id_type = '3'\n        }\n        app.mainContainer.vue.gshcInfoVisible = true;\n      } else if (res && res.Status == '504') {\n        Wb.tipError(\"查询失败：\" + res.Message);\n      } else if (res && res.Status == '112') {\n        Wb.tipError(\"【无效请求】您的账号剩余使用量已不足或已过期\");\n      } else {\n        Wb.tipError(\"接口未查询到【\" + '_$client_name$_' + \"】的工商信息\");\n      }\n    },\n    failure() {\n      Wb.tipError(\"查询企查查接口网络超时，请稍后重试\");\n    },\n    timeout: 50000// 前端配置超时时长50s，nginx为1分钟，前端先一步报错网络连接超时，阻断后续nginx的连接超时报错\n  });\n} else {\n  app.qccMatch.text = '工商核查'\n  app.mainContainer.vue.gshcInfoVisible = false\n}\n\n"
                      },
                      "_expanded": true
                    },
                    {
                      "_icon": "button",
                      "text": "apprBtn",
                      "cls": "Wb.Button",
                      "properties": {
                        "cid": "apprBtn",
                        "text": "审核",
                        "type": "primary",
                        "visible": "false"
                      },
                      "hasDupCid": 0,
                      "events": {
                        "click": "app.apprWin.show()"
                      }
                    },
                    {
                      "_icon": "button",
                      "text": "exportBtn",
                      "cls": "Wb.Button",
                      "properties": {
                        "cid": "exportBtn",
                        "text": "打印导出"
                      },
                      "_expanded": true,
                      "events": {
                        "click": "app.mainContainer.vue.downloadPdf();"
                      }
                    }
                  ]
                },
                {
                  "_icon": "container",
                  "text": "mainContainer",
                  "cls": "Wb.Container",
                  "properties": {
                    "cid": "mainContainer",
                    "autoScroll": "true",
                    "layout": "fit"
                  },
                  "_expanded": false,
                  "hasDupCid": 0,
                  "events": {
                    "ready": "let comp = this;\ncomp.vue = new Vue({\n  el: comp.el.addEl(),\n  template: `\n<div style=\"height:100%\">\n  <div class=\"main-container\" style=\"display:flex\">\n    <div class=\"left-panel\">\n      <el-tabs v-model=\"activeNav\" @tab-click=\"handleClick\" tab-position=\"left\">\n        <el-tab-pane v-for=\"(item, index) in navList\" :label=\"item.label\" :name=\"item.value\"></el-tab-pane>\n      </el-tabs>\n    </div>\n    <div v-if=\"loading\" class=\"right-panel\">\n      <el-loading v-loading=\"loading\" element-loading-text=\"页面加载中，若长时间无响应，请关闭后重试\"\n        element-loading-spinner=\"el-icon-loading\" style=\"display:inline-block;height:100%;width:100%\"></el-loading>\n    </div>\n    <div v-else class=\"right-panel\" @scroll=\"onScroll\" style=\"overflow-y:scroll;\">\n      <p style=\"color:#F56C6C;padding-left:20px;\">\n        注1：证照、身份证等有效期如果为“长期”、“永久”等，请在证照/身份证有效期截止选择“2100-12-31”。<br/>\n        注2：如果没有相关信息需要填写，请留白，不需要填写“不适用”、“无”等字段。<br/>\n        注3：附件上传后即为保存，将不允许修改和删除，如有错误可用新的同名文件更新替换。\n      </p>\n      <!--客户基本信息-->\n      <el-card class=\"box-card\" :name=\"'basicInfo'+this._uid\">\n        <div slot=\"header\" class=\"clearfix\">\n          <span>客户基本信息</span>\n        </div>\n        <div>\n          <!--个人-->\n          <el-form v-if=\"organ_flag==='0'\" :model=\"ruleForm2\" label-width=\"120px\" class=\"basic-info-form\">\n            <el-row :gutter=\"20\" class=\"info-row\">\n              <div class=\"info-row-flex\"><span class=\"client-label\">姓名</span><div>{{basicInfo.client_name|| '-'}}</div></div>\n              <div class=\"info-row-flex\"><span class=\"client-label\">联系地址</span><div>{{basicInfo.province2||''}}{{basicInfo.city2||''}}{{basicInfo.district2||''}}{{basicInfo.address||'-'}}</div></div>\n            </el-row>\n            <el-row :gutter=\"20\" class=\"info-row\">\n              <div class=\"info-row-flex\"><span class=\"client-label\">国籍</span><div>{{formatDictMap('nationality_list',basicInfo.nationality)||'-'}}</div></div>\n              <div class=\"info-row-flex\"><span class=\"client-label\">性别</span><div>{{(basicInfo.gender=='1'?'男':basicInfo.gender=='2'?'女':'未知')|| '-'}}</div></div>\n              <div class=\"info-row-flex\"><span class=\"client-label\">出生年月</span><div>{{basicInfo.birthday|| '-'}}</div></div>\n            </el-row>\n            <el-row :gutter=\"20\" class=\"info-row\">\n              <div class=\"info-row-flex\"><span class=\"client-label\">联系电话</span><div>{{basicInfo.tel|| '-'}}</div></div>\n              <div class=\"info-row-flex\"><span class=\"client-label\">年收入</span><div>{{formatDictMap('year_income_list',String(basicInfo.income))|| '-'}}</div></div>\n              <div class=\"info-row-flex\"><span class=\"client-label\">职业分类</span><div>{{formatDictMap('profession_code_list',basicInfo.profession_code)|| '-'}}</div></div>\n            </el-row>\n            <el-row :gutter=\"20\" class=\"info-row\">\n              <div class=\"info-row-flex\"><span class=\"client-label\">身份证件类型</span><div>{{formatDictMap('id_type_list',basicInfo.id_type)|| '-'}}</div></div>\n              <div class=\"info-row-flex\"><span class=\"client-label\">证件号码</span><div>{{basicInfo.id_no|| '-'}}</div></div>\n            </el-row>\n            <el-row :gutter=\"20\" class=\"info-row\">\n              <div class=\"info-row-flex\"><span class=\"client-label\">证件有效期</span><div>{{basicInfo.id_begindate|| '-'}}至{{basicInfo.id_enddate|| '-'}}</div></div>\n            </el-row>\n            <el-row :gutter=\"20\" class=\"info-row\">\n              <div class=\"info-row-flex\"><span class=\"client-label\">证件地址</span><div>{{basicInfo.province1||''}}{{basicInfo.city1||''}}{{basicInfo.district1||''}}{{basicInfo.address||'-'}}</div></div>\n            </el-row>\n          </el-form>\n          <!--机构-->\n          <el-form v-if=\"organ_flag==='1'\" :model=\"ruleForm1\" label-width=\"120px\" class=\"basic-info-form\">\n            <el-row :gutter=\"20\" class=\"info-row\">\n              <div class=\"info-row-flex\">\n                <span class=\"client-label\">客户名称</span>\n                <div>{{basicInfo.client_name|| '-'}}<div class=\"qcc_check\" v-show=\"gshcInfoVisible\">{{gshcInfo.name}}</div></div>\n              </div>\n              <div class=\"info-row-flex\">\n                <span class=\"client-label\">办公住所</span>\n                <div>\n                  {{basicInfo.province||''}}{{basicInfo.city||''}}{{basicInfo.district||''}}{{basicInfo.office_address||'-'}}\n                  <div class=\"qcc_check\" v-show=\"gshcInfoVisible\">{{gshcInfo.office_address}}</div>\n                </div>\n              </div>\n            </el-row>\n            <el-row :gutter=\"20\" class=\"info-row\">\n              <div class=\"info-row-flex\">\n                <span class=\"client-label\">注册国家地区</span>\n                <div>\n                  {{formatDictMap('nationality_list',basicInfo.register_country)|| '-'}}\n                  <div class=\"qcc_check\" v-show=\"gshcInfoVisible\">{{''}}</div>\n                </div>\n              </div>\n              <div class=\"info-row-flex\">\n                <span class=\"client-label\">注册资本币种</span>\n                <div>\n                  {{basicInfo.register_money_type}}\n                  <div class=\"qcc_check\" v-show=\"gshcInfoVisible\">{{gshcInfo.register_money_type}}</div>\n                </div>\n              </div>\n              <div class=\"info-row-flex\">\n                <span class=\"client-label\">注册资本金</span>\n                <div>\n                  {{basicInfo.register_fund?formatMoney(basicInfo.register_fund,'4'): '-'}}万元\n                  <div class=\"qcc_check\" v-show=\"gshcInfoVisible\">{{gshcInfo.register_fund}}</div>\n                </div>\n              </div>\n            </el-row>\n            <el-row :gutter=\"20\" class=\"info-row\">\n              <div class=\"info-row-flex\">\n                <span class=\"client-label\">行业分类</span>\n                <div>{{formatDictMap('industry_type_list',basicInfo.industry_type)|| '-'}}</div>\n              </div>\n              <div class=\"info-row-flex\" v-if=\"basicInfo.industry_type=='26'\">\n                <span class=\"client-label\">行业注明</span>\n                <div>{{basicInfo.industry_name}}</div>\n              </div>\n              <div class=\"info-row-flex\">\n                <span class=\"client-label\">联系电话</span>\n                <div>{{basicInfo.tel|| '-'}}</div>\n              </div>\n              <div class=\"info-row-flex\">\n                <span class=\"client-label\">成立日期</span>\n                <div>{{basicInfo.setup_date|| '-'}}<div class=\"qcc_check\" v-show=\"gshcInfoVisible\">{{gshcInfo.setup_date}}</div></div>\n              </div>\n            </el-row>\n            <el-row :gutter=\"20\" class=\"info-row\">\n              <div class=\"info-row-flex\">\n                <span class=\"client-label\">证照类型</span>\n                <div>{{formatDictMap('id_type_list',basicInfo.id_type)|| '-'}}<div class=\"qcc_check\" v-show=\"gshcInfoVisible\">{{gshcInfo.id_type==='3'?'营业执照':''}}</div></div>\n              </div>\n              <div class=\"info-row-flex\">\n                <span class=\"client-label\">证照号码</span>\n                <div>{{basicInfo.id_no|| '-'}}<div class=\"qcc_check\" v-show=\"gshcInfoVisible\">{{gshcInfo.id_type==='3'?gshcInfo.id_no:''}}</div></div>\n              </div>\n              <div class=\"info-row-flex\">\n                <span class=\"client-label\"></span>\n                <div><div class=\"qcc_check\" v-show=\"gshcInfoVisible\"></div></div>\n              </div>\n              <!---->\n            </el-row>\n            <el-row class=\"info-row\">\n              <div class=\"info-row-flex\">\n                <span class=\"client-label\">证照有效期</span>\n                <div>{{basicInfo.id_begindate|| '-'}}至{{basicInfo.id_enddate|| '-'}}<div class=\"qcc_check\" v-show=\"gshcInfoVisible\">{{gshcInfo.id_begindate|| '-'}}至{{gshcInfo.id_enddate|| '-'}}</div></div>\n              </div>\n            </el-row>\n            <el-row class=\"info-row\">\n              <div class=\"info-row-flex\">\n                <span class=\"client-label\">经营范围</span>\n                <div>\n                  {{basicInfo.busi_scope|| '-'}}\n                  <div class=\"qcc_check\" v-show=\"gshcInfoVisible\">{{gshcInfo.busi_scope|| '-'}}</div>\n                </div>\n            </el-row>\n          </el-form>\n        </div>\n        <div class=\"attachment-section\">\n          <span>附件信息</span>\n          <!--<el-tooltip \n            class=\"item\" \n            effect=\"dark\" \n            content=\"\" \n            placement=\"right\">\n            <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n          </el-tooltip>-->\n          <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n          <span style=\"color:#F56C6C;\">请上传基本信息表签章版、客户营业执照复印件、客户公司章程复印件、在工商外部数据库（如“企查查”）查验的报告。</span>\n          <el-table :data=\"attachmentList.basicInfo\" border style=\"width: 100%; margin-top: 10px;\" :default-sort = \"{prop: 'date', order: 'descending'}\">\n            <el-table-column prop=\"name\" label=\"附件名称\" sortable>\n              <template slot-scope=\"scope\">\n                <el-button type=\"text\" @click=\"handlePreview(scope.row)\" class=\"attachment-btn\">\n                  {{ scope.row.name }}\n                </el-button>\n              </template>\n            </el-table-column>\n            <el-table-column prop=\"extension\" label=\"附件类型\" width=\"80\"></el-table-column>\n            <el-table-column prop=\"create_time\" label=\"上传时间\" width=\"180\" sortable></el-table-column>\n            <el-table-column prop=\"file_size\" label=\"附件大小\" width=\"100\" sortable>\n              <template slot-scope=\"scope\">\n                {{ formatSize(scope.row.file_size) }}\n              </template>\n            </el-table-column>\n            <el-table-column prop=\"create_by\" label=\"上传人\" width=\"150\" sortable></el-table-column>\n            <el-table-column label=\"操作\" width=\"100\">\n              <template slot-scope=\"scope\">\n                <div class=\"operation-buttons\">\n                  <el-tooltip content=\"预览\">\n                    <el-button type=\"text\" class=\"el-icon-view\" @click=\"handlePreview(scope.row)\"></el-button>\n                  </el-tooltip>\n                  <el-tooltip content=\"下载\">\n                    <el-button type=\"text\" class=\"el-icon-download\" @click=\"handleDownload(scope.row)\"></el-button>\n                  </el-tooltip>\n                </div>\n              </template>\n            </el-table-column>\n          </el-table>\n        </div>\n      </el-card>\n      <!--反洗钱特殊情况申请-->\n      <el-card class=\"box-card\" :name=\"'fxqSpecial'+this._uid\">\n        <el-form :model=\"ruleForm3\" ref=\"ruleForm3\" style=\"padding:20px;\" label-position=\"top\" disabled>\n          <el-form-item label=\"是否存在反洗钱特殊情况申请\" prop=\"is_special\" label-width=\"200\">\n            <el-radio-group v-model=\"basicInfo.is_special\">\n              <el-radio label=\"1\">是</el-radio>\n              <el-radio label=\"0\">否</el-radio>\n            </el-radio-group>\n            <div style=\"color:#f56c6c;\">如目前存在未获取的反洗钱信息或底稿材料，请选择“是”</div>\n          </el-form-item>\n          <!--表单内容-->\n          <div v-if=\"basicInfo.is_special=='1'\">\n            <el-row :gutter=\"20\">\n              <el-col :span=\"12\">\n                <!--<el-form-item label=\"客户类型\" prop=\"client_type\">\n                  <el-select size=\"medium\" v-model=\"client_type_arr\" multiple placeholder=\"请选择\">\n                    <el-option v-for=\"item in selectList.client_type_list\" :key=\"item.k\" :label=\"item.v\"\n                      :value=\"item.k\">\n                    </el-option>\n                  </el-select>\n                </el-form-item>-->\n                <el-form-item label=\"客户类型\" prop=\"client_type\">\n                  <el-checkbox-group v-model=\"client_type_arr\">\n                    <el-checkbox v-for=\"item in selectList.client_type_list\" :key=\"item.k\" :label=\"item.k\">\n                      {{ item.v }}\n                    </el-checkbox>\n                  </el-checkbox-group>\n                </el-form-item>\n              </el-col>\n              <el-col :span=\"12\">\n                <el-form-item label=\"具体说明\" prop=\"client_type_other\" v-if=\"basicInfo.client_type.indexOf('99')!==-1\">\n                  <el-input size=\"medium\" v-model=\"basicInfo.client_type_other\">\n                  </el-input>\n                </el-form-item>\n              </el-col>\n            </el-row>\n            <el-row :gutter=\"20\">\n              <el-col :span=\"12\">\n                <!--<el-form-item label=\"特殊事项\" prop=\"special_matters\">\n                  <el-select size=\"medium\" v-model=\"special_matters_arr\" multiple placeholder=\"请选择\">\n                    <el-option v-for=\"item in selectList.special_matters_list\" :key=\"item.k\" :label=\"item.v\"\n                      :value=\"item.k\">\n                    </el-option>\n                  </el-select>\n                </el-form-item>-->\n                <el-form-item label=\"特殊事项\" prop=\"special_matters\">\n                  <el-checkbox-group v-model=\"special_matters_arr\">\n                    <el-checkbox v-for=\"item in selectList.special_matters_list\" :key=\"item.k\" :label=\"item.k\">\n                      {{ item.v }}\n                    </el-checkbox>\n                  </el-checkbox-group>\n                </el-form-item>\n              </el-col>\n              <el-col :span=\"12\">\n              </el-col>\n            </el-row>\n            <el-form-item label=\"具体说明缺失的信息\" prop=\"missing_information\" v-if=\"basicInfo.special_matters.indexOf('1')!==-1\">\n              <el-input size=\"medium\" v-model=\"basicInfo.missing_information\">\n              </el-input>\n            </el-form-item>\n            <el-form-item label=\"具体说明缺失的底稿\" prop=\"missing_draft\" v-if=\"basicInfo.special_matters.indexOf('2')!==-1\">\n              <el-input size=\"medium\" v-model=\"basicInfo.missing_draft\">\n              </el-input>\n            </el-form-item>\n            <el-form-item label=\"具体说明\" prop=\"special_matters_other\" v-if=\"basicInfo.special_matters.indexOf('99')!==-1\">\n              <el-input size=\"medium\" v-model=\"basicInfo.special_matters_other\">\n              </el-input>\n            </el-form-item>\n            <el-form-item label=\"特殊事项原因\" prop=\"special_reason\">\n              <el-input size=\"medium\" type=\"textarea\" autosize v-model=\"basicInfo.special_reason\">\n              </el-input>\n            </el-form-item>\n            <el-form-item label=\"已开展的反洗钱尽职调查工作\" prop=\"completed_cdd\">\n              <el-input size=\"medium\" type=\"textarea\" autosize v-model=\"basicInfo.completed_cdd\">\n              </el-input>\n            </el-form-item>\n            <el-form-item label=\"客户洗钱风险较低的评估说明\" prop=\"low_risk_explanation\">\n              <el-input size=\"medium\" type=\"textarea\" autosize v-model=\"basicInfo.low_risk_explanation\">\n              </el-input>\n            </el-form-item>\n            <el-form-item label=\"后续措施\" prop=\"take_measures\">\n              <el-input size=\"medium\" type=\"textarea\" autosize v-model=\"basicInfo.take_measures\">\n              </el-input>\n            </el-form-item>\n          </div>\n          <!--附件内容-->\n          <div v-if=\"basicInfo.is_special=='1'\">\n            <div style=\"font-weight:blod;font-size:15px;padding-bottom:20px;\">附件</div>\n            <el-row :gutter=\"5\" style=\"padding-bottom:20px;\">\n              <el-col :span=\"4\">\n                <font color=\"#F56C6C\">*&nbsp;</font>与客户沟通记录\n              </el-col>\n              <el-col :span=\"20\">\n                <!--<el-upload class=\"upload-demo\" ref=\"upload\"\n                  action=\"m?xwl=aml_monitor/workflow/prs01/dataSource/files/upload_file1\" name=\"file1\"\n                  header=\"{content-type:'text/html'}\" :data=\"uploadParams\" :file-list=\"attachmentList.communication\"\n                  :auto-upload=\"true\" :on-change=\"handleChange\" :on-remove=\"handleRemove\" multiple>\n                </el-upload>-->\n                <div v-if=\"attachmentList.communication.length === 0\" style=\"color:#909399;font-size:14px;\">暂无附件</div>\n                <div v-else class=\"custom-file-list\">\n                  <div v-for=\"file in attachmentList.communication\" :key=\"file.id\" style=\"display:flex;justify-content:space-between;padding-bottom:5px;\">\n                    <span class=\"file-name\" @click=\"handlePreview(file)\" style=\"cursor: pointer;color:#333333;\">\n                      <i class=\"el-icon-document\"></i> {{ file.name }}.{{file.extension }}\n                    </span>\n                    <div>\n                      <i class=\"el-icon-view\" @click=\"handlePreview(file)\" style=\"color:#1890ff;cursor: pointer;\"></i>\n                      <i class=\"el-icon-download\" @click=\"handleDownload(file)\" style=\"color:#1890ff;cursor: pointer;\"></i>\n                    </div>\n                  </div>\n                </div>\n              </el-col>\n            </el-row>\n            <el-row :gutter=\"5\" style=\"padding-bottom:20px;\">\n              <el-col :span=\"4\">\n                <font color=\"#F56C6C\">*&nbsp;</font>二级部门负责人同意的记录\n              </el-col>\n              <el-col :span=\"20\">\n                <!--<el-upload class=\"upload-demo\" ref=\"upload\"\n                  action=\"m?xwl=aml_monitor/workflow/prs01/dataSource/files/upload_file1\" name=\"file1\"\n                  header=\"{content-type:'text/html'}\" :data=\"uploadParams\" :file-list=\"attachmentList.agree\"\n                  :auto-upload=\"true\" :on-change=\"handleChange\" :on-remove=\"handleRemove\" multiple>\n                </el-upload>-->\n                <div v-if=\"attachmentList.communication.length === 0\" style=\"color:#909399;font-size:14px;\">暂无附件</div>\n                <div v-else class=\"custom-file-list\">\n                  <div v-for=\"file in attachmentList.agree\" :key=\"file.id\" style=\"display:flex;justify-content:space-between;padding-bottom:5px;\">\n                    <span class=\"file-name\" @click=\"handlePreview(file)\" style=\"cursor: pointer;color:#333333;\">\n                      <i class=\"el-icon-document\"></i> {{ file.name }}.{{file.extension }}\n                    </span>\n                    <div>\n                      <i class=\"el-icon-view\" @click=\"handlePreview(file)\" style=\"color:#1890ff;cursor: pointer;\"></i>\n                      <i class=\"el-icon-download\" @click=\"handleDownload(file)\" style=\"color:#1890ff;cursor: pointer;\"></i>\n                    </div>\n                  </div>\n                </div>\n              </el-col>\n            </el-row>\n            <el-row :gutter=\"5\" style=\"padding-bottom:20px;\">\n              <el-col :span=\"4\">\n                <font>&nbsp;&nbsp;</font>其他底稿\n              </el-col>\n              <el-col :span=\"20\">\n                <!--<el-upload class=\"upload-demo\" ref=\"upload\"\n                  action=\"m?xwl=aml_monitor/workflow/prs01/dataSource/files/upload_file1\" name=\"file1\"\n                  header=\"{content-type:'text/html'}\" :data=\"uploadParams\" :file-list=\"attachmentList.other\"\n                  :auto-upload=\"true\" :on-change=\"handleChange\" :on-remove=\"handleRemove\" multiple>\n                </el-upload>-->\n                <div v-if=\"attachmentList.other.length === 0\" style=\"color:#909399;font-size:14px;\">暂无附件</div>\n                <div v-else class=\"custom-file-list\">\n                  <div v-for=\"file in attachmentList.other\" :key=\"file.id\" style=\"display:flex;justify-content:space-between;padding-bottom:5px;\">\n                    <span class=\"file-name\" @click=\"handlePreview(file)\" style=\"cursor: pointer;color:#333333;\">\n                      <i class=\"el-icon-document\"></i> {{ file.name }}.{{file.extension }}\n                    </span>\n                    <div>\n                      <i class=\"el-icon-view\" @click=\"handlePreview(file)\" style=\"color:#1890ff;cursor: pointer;\"></i>\n                      <i class=\"el-icon-download\" @click=\"handleDownload(file)\" style=\"color:#1890ff;cursor: pointer;\"></i>\n                    </div>\n                  </div>\n                </div>\n              </el-col>\n            </el-row>\n          </div>\n        </el-form>\n      </el-card>\n      <!--法定代表人-->\n      <el-card class=\"box-card\" :name=\"'LegalRep'+this._uid\" v-if=\"organ_flag==='1'\">\n        <div slot=\"header\" class=\"clearfix\">\n          <span>法定代表人相关信息</span>\n        </div>\n        <div v-if=\"relatedInfo1.length==0\" style=\"color:#8d8b8b;text-align:center\">暂无数据</div>\n        <el-card v-for=\"item in relatedInfo1\" :key=\"item.related_id\" class=\"relat-card\">\n          <div class=\"client-info\">\n            <div class=\"client-title\">\n              <div>\n                <span>{{item.related_name|| '-'}}</span>\n                <el-tag type=\"success\" effect=\"dark\" size=\"mini\" style=\"margin-left: 10px;\" v-if=\"item.organ_flag==='0'\">\n                  自然人</el-tag>\n                <el-tag type=\"\" effect=\"dark\" size=\"mini\" style=\"margin-left: 10px;\" v-if=\"item.organ_flag==='1'\">法人\n                </el-tag>\n              </div>\n            </div>\n\n            <el-row :gutter=\"10\" class=\"info-row\">\n              <div class=\"info-row-flex\" v-if=\"item.organ_flag=='1'\"><label>国家或地区</label>\n                <div>{{formatDictMap('nationality_list',item.nationality)|| '-'}}</div>\n              </div>\n              <div class=\"info-row-flex\" v-if=\"item.organ_flag=='0'\"><label>国籍</label>\n                <div>{{formatDictMap('nationality_list',item.nationality)|| '-'}}</div>\n              </div>\n              <div class=\"info-row-flex\"><label>证件类型</label>\n                <div>{{formatDictMap('id_type_list',item.id_type)|| '-'}}</div>\n              </div>\n              <div class=\"info-row-flex\"><label>证件号码</label>\n                <div>{{item.id_no|| '-'}}</div>\n              </div>\n            </el-row>\n\n            <el-row :gutter=\"10\" class=\"info-row\">\n              <div class=\"info-row-flex\"><label>证件有效期</label>\n                <div>{{item.id_begindate|| '-'}}至{{item.id_enddate|| '-'}}</div>\n              </div>\n              <div class=\"info-row-flex\"><label>出生年月</label>\n                <div>{{item.birthday|| '-'}}</div>\n              </div>\n              <div class=\"info-row-flex\"><label>联系方式</label>\n                <div>{{item.mobno1|| '-'}}</div>\n              </div>\n            </el-row>\n          </div>\n        </el-card>\n        <!-- 附件信息表 -->\n        <div style=\"padding-top:10px;\">\n          <span>附件信息</span>\n          <!--<el-tooltip \n            class=\"item\" \n            effect=\"dark\" \n            content=\"\" \n            placement=\"right\">\n            <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n          </el-tooltip>-->\n          <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n          <span style=\"color:#F56C6C;\">请上传法定代表人身份证明文件的复印件</span>\n          <el-table :data=\"attachmentList.LegalRep\" border style=\"width: 100%;margin-top:10px;\" :default-sort = \"{prop: 'date', order: 'descending'}\">\n            <el-table-column prop=\"name\" label=\"附件名称\" sortable>\n              <template slot-scope=\"scope\">\n                <el-button type=\"text\" @click=\"handlePreview(scope.row)\" class=\"attachment-btn\">\n                  {{ scope.row.name }}\n                </el-button>\n              </template>\n            </el-table-column>\n            <el-table-column prop=\"extension\" label=\"附件类型\" width=\"80\" />\n            <el-table-column prop=\"create_time\" label=\"上传时间\" width=\"180\" sortable/>\n            <el-table-column prop=\"file_size\" label=\"附件大小\" width=\"100\" sortable>\n              <template slot-scope=\"scope\">\n                {{ formatSize(scope.row.file_size) }}\n              </template>\n            </el-table-column>\n            <el-table-column prop=\"create_by\" label=\"上传人\" width=\"150\" sortable/>\n            <el-table-column label=\"操作\" width=\"100\">\n              <template slot-scope=\"scope\">\n                <div class=\"operation-buttons\">\n                  <el-tooltip content=\"预览\">\n                    <el-button type=\"text\" class=\"el-icon-view\" @click=\"handlePreview(scope.row)\"></el-button>\n                  </el-tooltip>\n                  <el-tooltip content=\"下载\">\n                    <el-button type=\"text\" class=\"el-icon-download\" @click=\"handleDownload(scope.row)\"></el-button>\n                  </el-tooltip>\n                </div>\n              </template>\n            </el-table-column>\n          </el-table>\n        </div>\n      </el-card>\n      <!--控股股东-->\n      <el-card class=\"box-card\" :name=\"'controllingShareholder'+this._uid\" v-if=\"organ_flag==='1'\">\n        <div slot=\"header\" class=\"clearfix\">\n          <span>控股股东相关信息</span>\n        </div>\n        <div v-if=\"relatedInfo2.length==0\" style=\"color:#8d8b8b;text-align:center\">暂无数据</div>\n        <el-card v-for=\"item in relatedInfo2\" :key=\"item.related_id\" style=\"margin-bottom:10px;\" class=\"relat-card\">\n          <div class=\"client-info\">\n            <div class=\"client-title\">\n              <div>\n                <span>{{item.related_name|| '-'}}</span>\n                <el-tag type=\"success\" effect=\"dark\" size=\"mini\" style=\"margin-left: 10px;\" v-if=\"item.organ_flag==='0'\">\n                  自然人</el-tag>\n                <el-tag type=\"\" effect=\"dark\" size=\"mini\" style=\"margin-left: 10px;\" v-if=\"item.organ_flag==='1'\">法人\n                </el-tag>\n              </div>\n            </div>\n\n            <el-row :gutter=\"10\" class=\"info-row\">\n              <div class=\"info-row-flex\" v-if=\"item.organ_flag=='1'\"><label>国家或地区</label>\n                <div>{{formatDictMap('nationality_list',item.nationality)|| '-'}}</div>\n              </div>\n              <div class=\"info-row-flex\" v-if=\"item.organ_flag=='0'\"><label>国籍</label>\n                <div>{{formatDictMap('nationality_list',item.nationality)|| '-'}}</div>\n              </div>\n              <div class=\"info-row-flex\"><label>证件类型</label>\n                <div>{{formatDictMap('id_type_list',item.id_type)|| '-'}}</div>\n              </div>\n              <div class=\"info-row-flex\"><label>证件号码</label>\n                <div>{{item.id_no|| '-'}}</div>\n              </div>\n            </el-row>\n\n            <el-row :gutter=\"10\" class=\"info-row\">\n              <div class=\"info-row-flex\"><label>证件有效期起始</label>\n                <div>{{item.id_begindate|| '-'}}</div>\n              </div>\n              <div class=\"info-row-flex\"><label>证件有效期截止</label>\n                <div>{{item.id_enddate|| '-'}}</div>\n              </div>\n              <div class=\"info-row-flex\" v-if=\"item.organ_flag==='1'\"><label>是否政府部门</label>\n                <div>{{item.is_government_dept==='1'?'是':'否'}}</div>\n              </div>\n              <div class=\"info-row-flex\" v-if=\"item.organ_flag==='0'\"><label>出生年月</label>\n                <div>{{item.birthday || '-'}}</div>\n              </div>\n            </el-row>\n          </div>\n        </el-card>\n        <!-- 附件信息表 -->\n        <div style=\"padding-top:10px;\">\n          <span>附件信息</span>\n          <!--<el-tooltip \n            class=\"item\" \n            effect=\"dark\" \n            content=\"\" \n            placement=\"right\">\n            <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n          </el-tooltip>-->\n          <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n          <span style=\"color:#F56C6C;\">请上传营业执照复印件（控股股东如为非自然人-公司）、控股股东身份证明文件的复印件（如为自然人）</span>\n          <el-table :data=\"attachmentList.controllingShareholder\" border style=\"width: 100%;margin-top:10px;\" :default-sort = \"{prop: 'date', order: 'descending'}\">\n            <el-table-column prop=\"name\" label=\"附件名称\" sortable>\n              <template slot-scope=\"scope\">\n                <el-button type=\"text\" @click=\"handlePreview(scope.row)\" class=\"attachment-btn\">\n                  {{ scope.row.name }}\n                </el-button>\n              </template>\n            </el-table-column>\n            <el-table-column prop=\"extension\" label=\"附件类型\" width=\"80\"/>\n            <el-table-column prop=\"create_time\" label=\"上传时间\" width=\"180\" sortable/>\n            <el-table-column prop=\"file_size\" label=\"附件大小\" width=\"100\" sortable>\n              <template slot-scope=\"scope\">\n                {{ formatSize(scope.row.file_size) }}\n              </template>\n            </el-table-column>\n            <el-table-column prop=\"create_by\" label=\"上传人\" width=\"150\" sortable/>\n            <el-table-column label=\"操作\" width=\"100\">\n              <template slot-scope=\"scope\">\n                <div class=\"operation-buttons\">\n                  <el-tooltip content=\"预览\">\n                    <el-button type=\"text\" class=\"el-icon-view\" @click=\"handlePreview(scope.row)\"></el-button>\n                  </el-tooltip>\n                  <el-tooltip content=\"下载\">\n                    <el-button type=\"text\" class=\"el-icon-download\" @click=\"handleDownload(scope.row)\"></el-button>\n                  </el-tooltip>\n                </div>\n              </template>\n            </el-table-column>\n          </el-table>\n        </div>\n      </el-card>\n      <!--实际控制人-->\n      <el-card class=\"box-card\" :name=\"'actualController'+this._uid\" v-if=\"organ_flag==='1'\">\n        <div slot=\"header\" class=\"clearfix\">\n          <span>实际控制人相关信息</span>\n        </div>\n        <div v-if=\"relatedInfo3.length==0\" style=\"color:#8d8b8b;text-align:center\">暂无数据</div>\n        <el-card v-for=\"item in relatedInfo3\" :key=\"item.related_id\" style=\"margin-bottom:10px;\" class=\"relat-card\">\n          <div class=\"client-info\">\n            <div class=\"client-title\">\n              <div>\n                <span>{{item.related_name|| '-'}}</span>\n                <el-tag type=\"success\" effect=\"dark\" size=\"mini\" style=\"margin-left: 10px;\" v-if=\"item.organ_flag==='0'\">自然人</el-tag>\n                <el-tag type=\"\" effect=\"dark\" size=\"mini\" style=\"margin-left: 10px;\" v-if=\"item.organ_flag==='1'\">法人</el-tag>\n              </div>\n            </div>\n\n            <el-row :gutter=\"10\" class=\"info-row\">\n              <div class=\"info-row-flex\" v-if=\"item.organ_flag=='1'\"><label>国家或地区</label>\n                <div>{{formatDictMap('nationality_list',item.nationality)|| '-'}}</div>\n              </div>\n              <div class=\"info-row-flex\" v-if=\"item.organ_flag=='0'\"><label>国籍</label>\n                <div>{{formatDictMap('nationality_list',item.nationality)|| '-'}}</div>\n              </div>\n              <div class=\"info-row-flex\"><label>证件类型</label>\n                <div>{{formatDictMap('id_type_list',item.id_type)|| '-'}}</div>\n              </div>\n              <div class=\"info-row-flex\"><label>证件号码</label>\n                <div>{{item.id_no|| '-'}}</div>\n              </div>\n            </el-row>\n\n            <el-row :gutter=\"10\" class=\"info-row\">\n              <div class=\"info-row-flex\"><label>证件有效期起始</label>\n                <div>{{item.id_begindate|| '-'}}</div>\n              </div>\n              <div class=\"info-row-flex\"><label>证件有效期截止</label>\n                <div>{{item.id_enddate|| '-'}}</div>\n              </div>\n              <div class=\"info-row-flex\" v-if=\"item.organ_flag==='1'\"><label>是否政府部门</label>\n                <div>{{item.is_government_dept==='1'?'是':'否'}}</div>\n              </div>\n              <div class=\"info-row-flex\" v-if=\"item.organ_flag==='0'\"><label>出生年月</label>\n                <div>{{item.birthday || '-'}}</div>\n              </div>\n            </el-row>\n          </div>\n        </el-card>\n        <!-- 附件信息表 -->\n        <div style=\"padding-top:10px;\">\n          <span>附件信息</span>\n          <!--<el-tooltip \n            class=\"item\" \n            effect=\"dark\" \n            content=\"\" \n            placement=\"right\">\n            <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n          </el-tooltip>-->\n          <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n          <span style=\"color:#F56C6C;\">请上传营业执照复印件（实际控制人如为非自然人-公司）、实际控制人身份证明文件的复印件（如为自然人）</span>\n          <el-table :data=\"attachmentList.actualController\" border style=\"width: 100%;margin-top:10px;\" :default-sort = \"{prop: 'date', order: 'descending'}\">\n            <el-table-column prop=\"name\" label=\"附件名称\" sortable>\n              <template slot-scope=\"scope\">\n                <el-button type=\"text\" @click=\"handlePreview(scope.row)\" class=\"attachment-btn\">\n                  {{ scope.row.name }}\n                </el-button>\n              </template>\n            </el-table-column>\n            <el-table-column prop=\"extension\" label=\"附件类型\" width=\"80\" />\n            <el-table-column prop=\"create_time\" label=\"上传时间\" width=\"180\" sortable/>\n            <el-table-column prop=\"file_size\" label=\"附件大小\" width=\"100\" sortable>\n              <template slot-scope=\"scope\">\n                {{ formatSize(scope.row.file_size) }}\n              </template>\n            </el-table-column>\n            <el-table-column prop=\"create_by\" label=\"上传人\" width=\"150\" sortable/>\n            <el-table-column label=\"操作\" width=\"100\">\n              <template slot-scope=\"scope\">\n                <div class=\"operation-buttons\">\n                  <el-tooltip content=\"预览\">\n                    <el-button type=\"text\" class=\"el-icon-view\" @click=\"handlePreview(scope.row)\"></el-button>\n                  </el-tooltip>\n                  <el-tooltip content=\"下载\">\n                    <el-button type=\"text\" class=\"el-icon-download\" @click=\"handleDownload(scope.row)\"></el-button>\n                  </el-tooltip>\n                </div>\n              </template>\n            </el-table-column>\n          </el-table>\n        </div>\n      </el-card>\n      <!--授权代表人-->\n      <el-card class=\"box-card\" :name=\"'authorizedRep'+this._uid\" v-if=\"organ_flag==='1'\">\n        <div slot=\"header\" class=\"clearfix\">\n          <span>授权代表人相关信息</span>\n        </div>\n        <div v-if=\"relatedInfo4.length==0\" style=\"color:#8d8b8b;text-align:center\">暂无数据</div>\n        <el-card v-for=\"item in relatedInfo4\" :key=\"item.related_id\" class=\"relat-card\">\n          <div class=\"client-info\">\n            <div class=\"client-title\">\n              <div>\n                <span>{{item.related_name|| '-'}}</span>\n                <el-tag type=\"success\" effect=\"dark\" size=\"mini\" style=\"margin-left: 10px;\" v-if=\"item.organ_flag==='0'\">\n                  自然人</el-tag>\n                <el-tag type=\"\" effect=\"dark\" size=\"mini\" style=\"margin-left: 10px;\" v-if=\"item.organ_flag==='1'\">法人\n                </el-tag>\n              </div>\n            </div>\n\n            <el-row :gutter=\"10\" class=\"info-row\">\n              <div class=\"info-row-flex\" v-if=\"item.organ_flag=='1'\"><label>国家或地区</label>\n                <div>{{formatDictMap('nationality_list',item.nationality)|| '-'}}</div>\n              </div>\n              <div class=\"info-row-flex\" v-if=\"item.organ_flag=='0'\"><label>国籍</label>\n                <div>{{formatDictMap('nationality_list',item.nationality)|| '-'}}</div>\n              </div>\n              <div class=\"info-row-flex\"><label>证件类型</label>\n                <div>{{formatDictMap('id_type_list',item.id_type)|| '-'}}</div>\n              </div>\n              <div class=\"info-row-flex\"><label>证件号码</label>\n                <div>{{item.id_no|| '-'}}</div>\n              </div>\n            </el-row>\n\n            <el-row :gutter=\"10\" class=\"info-row\">\n              <div class=\"info-row-flex\"><label>证件有效期</label>\n                <div>{{item.id_begindate|| '-'}}至{{item.id_enddate|| '-'}}</div>\n              </div>\n              <div class=\"info-row-flex\"><label>出生年月</label>\n                <div>{{item.birthday|| '-'}}</div>\n              </div>\n              <div class=\"info-row-flex\"><label>联系方式</label>\n                <div>{{item.mobno1|| '-'}}</div>\n              </div>\n            </el-row>\n          </div>\n        </el-card>\n        <!-- 附件信息表 -->\n        <div style=\"padding-top:10px;\">\n          <span>附件信息</span>\n          <!--<el-tooltip \n            class=\"item\" \n            effect=\"dark\" \n            content=\"请上传授权代表人身份证明文件的复印件、授权委托书（授权代表人非法代时适用）\" \n            placement=\"right\">\n            <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n          </el-tooltip>-->\n          <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n          <span style=\"color:#F56C6C;\">请上传授权代表人身份证明文件的复印件、授权委托书（授权代表人非法代时适用）</span>\n          <el-table :data=\"attachmentList.authorizedRep\" border style=\"width: 100%;margin-top:10px;\" :default-sort = \"{prop: 'date', order: 'descending'}\">\n            <el-table-column prop=\"name\" label=\"附件名称\" sortable>\n              <template slot-scope=\"scope\">\n                <el-button type=\"text\" @click=\"handlePreview(scope.row)\" class=\"attachment-btn\">\n                  {{ scope.row.name }}\n                </el-button>\n              </template>\n            </el-table-column>\n            <el-table-column prop=\"extension\" label=\"附件类型\" width=\"80\" />\n            <el-table-column prop=\"create_time\" label=\"上传时间\" width=\"180\" sortable/>\n            <el-table-column prop=\"file_size\" label=\"附件大小\" width=\"100\" sortable>\n              <template slot-scope=\"scope\">\n                {{ formatSize(scope.row.file_size) }}\n              </template>\n            </el-table-column>\n            <el-table-column prop=\"create_by\" label=\"上传人\" width=\"150\" sortable/>\n            <el-table-column label=\"操作\" width=\"100\">\n              <template slot-scope=\"scope\">\n                <div class=\"operation-buttons\">\n                  <el-tooltip content=\"预览\">\n                    <el-button type=\"text\" class=\"el-icon-view\" @click=\"handlePreview(scope.row)\"></el-button>\n                  </el-tooltip>\n                  <el-tooltip content=\"下载\">\n                    <el-button type=\"text\" class=\"el-icon-download\" @click=\"handleDownload(scope.row)\"></el-button>\n                  </el-tooltip>\n                </div>\n              </template>\n            </el-table-column>\n          </el-table>\n        </div>\n      </el-card>\n      <!--受益所有人-->\n      <el-card class=\"box-card\" :name=\"'beneficialOwner'+this._uid\" v-if=\"organ_flag==='1'\">\n        <div slot=\"header\" class=\"clearfix\">\n          <span>客户受益所有人信息</span>\n          <el-button style=\"float: right;\" type=\"warning\" size=\"mini\" @click=\"onlineBomisCheck\"\n            :disabled=\"onlineBomisCheckBtnDisable\" :loading=\"bomisChecking\">受益所有人信息核验</el-button>\n          <el-button style=\"float: right; margin-right: 8px;\" type=\"primary\" size=\"mini\" plain\n            @click=\"openBomisHistoryDialog\">历史核验信息</el-button>\n        </div>\n        <div v-if=\"benefitOwnerCardList.length==0\" style=\"color:#8d8b8b;text-align:center\">暂无数据</div>\n        <el-card v-for=\"item in benefitOwnerCardList\" :key=\"item.related_id\" style=\"margin-bottom:10px;\"\n          :class=\"{ 'highlight-border': item.data_status === '0' }\" class=\"relat-card\">\n          <div class=\"client-info\">\n            <div class=\"client-title\">\n              <div>\n                <span>{{item.related_name|| '-'}}</span>\n                <el-tag type=\"success\" effect=\"dark\" size=\"mini\" style=\"margin-left: 10px;\"\n                  v-if=\"item.organ_flag!=='1'\">\n                  自然人</el-tag>\n                <el-tag type=\"\" effect=\"dark\" size=\"mini\" style=\"margin-left: 10px;\" v-if=\"item.organ_flag==='1'\">法人\n                </el-tag>\n              </div>\n              <div>\n                <el-tag type=\"danger\" effect=\"plain\" size=\"mini\" style=\"margin-left: 10px;\"\n                  v-if=\"item.data_status==='0'\">数据已变更 请点击表单“保存”或“提交并关闭页面”按钮保存当前草稿数据\n                </el-tag>\n              </div>\n            </div>\n            <!-- 旧版受益人卡片（非 BOMIS）；有 BOMIS 字段时与编辑页一致走新卡片 -->\n            <template v-if=\"'_$showBomisBtn$_'!='true' && !item.bo_type && !item.company_type && !item.bnf_type && !item.bnf_type_str\">\n              <el-row :gutter=\"10\" class=\"info-row\">\n                <div class=\"info-row-flex\" v-if=\"item.organ_flag==='1'\"><label>国家或地区</label>\n                  <div>{{formatDictMap('nationality_list',item.nationality)|| '-'}}</div>\n                </div>\n                <div class=\"info-row-flex\" v-if=\"item.organ_flag==='0'\"><label>国籍</label>\n                  <div>{{formatDictMap('nationality_list',item.nationality)|| '-'}}</div>\n                </div>\n                <div class=\"info-row-flex\"><label>证件类型</label>\n                  <div>{{formatDictMap('id_type_list',item.id_type)|| '-'}}</div>\n                </div>\n                <div class=\"info-row-flex\"><label>证件号码</label>\n                  <div>{{item.id_no|| '-'}}</div>\n                </div>\n              </el-row>\n              <el-row :gutter=\"10\" class=\"info-row\">\n                <div class=\"info-row-flex\"><label>证件有效期起始</label>\n                  <div>{{item.id_begindate|| '-'}}</div>\n                </div>\n                <div class=\"info-row-flex\"><label>证件有效期截止</label>\n                  <div>{{item.id_enddate|| '-'}}</div>\n                </div>\n                <div class=\"info-row-flex\"><label>出生年月</label>\n                  <div>{{item.birthday|| '-'}}</div>\n                </div>\n              </el-row>\n              <el-row :gutter=\"10\" class=\"info-row\">\n                <div class=\"info-row-flex\"><label>受益所有人类型</label>\n                  <div>{{formatDictMap('beneficiary_list',item.beneficiary)|| '-'}}</div>\n                </div>\n                <div class=\"info-row-flex\"><label>股权/表决权比例</label>\n                  <div>{{item.shareholding_ratio?(item.shareholding_ratio+'%'): '-'}}</div>\n                </div>\n                <div class=\"info-row-flex\"><label>联系地址</label>\n                  <div>{{item.address|| '-'}}</div>\n                </div>\n              </el-row>\n            </template>\n            <!-- BOMIS 受益人卡片：字段与弹窗表单一致 -->\n            <template v-else>\n              <el-row :gutter=\"10\" class=\"info-row\">\n                <div class=\"info-row-flex\"><label>受益所有人</label>\n                  <div>{{formatDictMap('benefit_flag_list', item.bo_type) || '-'}}</div>\n                </div>\n                <div class=\"info-row-flex\"><label>企业性质</label>\n                  <div>{{formatDictMap('benefit_company_no_list', item.company_type) || '-'}}</div>\n                </div>\n                <div class=\"info-row-flex\"><label>客户信息披露情况</label>\n                  <div>{{formatFullInfoFlag(item.full_info_flag)}}</div>\n                </div>\n              </el-row>\n              <el-row :gutter=\"10\" class=\"info-row\">\n                <div class=\"info-row-flex\"><label>受益所有权类型</label>\n                  <div>{{formatMultipleDictMap('bnf_type_new_list', item.bnf_type_str || item.bnf_type) || '-'}}</div>\n                </div>\n              </el-row>\n              <el-row :gutter=\"10\" class=\"info-row\"\n                v-if=\"bomisBnfIncludes(item,'NA1') || bomisBnfIncludes(item,'NB1') || bomisBnfIncludes(item,'ND1')\">\n                <div class=\"info-row-flex\"><label>持有股权、股份或者合伙权益的比例（%）</label>\n                  <div>{{ item.acthdrat != null && item.acthdrat !== '' ? item.acthdrat : '-' }}</div>\n                </div>\n                <div class=\"info-row-flex\"><label>形成日期(权益)</label>\n                  <div>{{item.shareratiostartdate || '-'}}</div>\n                </div>\n                <div class=\"info-row-flex\"><label>终止日期(权益)</label>\n                  <div>{{item.shareratioenddate || '-'}}</div>\n                </div>\n              </el-row>\n              <el-row :gutter=\"10\" class=\"info-row\"\n                v-if=\"bomisBnfIncludes(item,'NA2-1') || bomisBnfIncludes(item,'NB2-1') || bomisBnfIncludes(item,'ND2-1')\">\n                <div class=\"info-row-flex\"><label>持有收益权的比例(%)</label>\n                  <div>{{ item.actownerprofitratio != null && item.actownerprofitratio !== '' ? item.actownerprofitratio : '-' }}</div>\n                </div>\n                <div class=\"info-row-flex\"><label>形成日期(收益权)</label>\n                  <div>{{item.profitratiostartdate || '-'}}</div>\n                </div>\n                <div class=\"info-row-flex\"><label>终止日期(收益权)</label>\n                  <div>{{item.profitratioenddate || '-'}}</div>\n                </div>\n              </el-row>\n              <el-row :gutter=\"10\" class=\"info-row\"\n                v-if=\"bomisBnfIncludes(item,'NA2-2') || bomisBnfIncludes(item,'NB2-2') || bomisBnfIncludes(item,'ND2-2')\">\n                <div class=\"info-row-flex\"><label>持有表决权的比例(%)</label>\n                  <div>{{ item.actownerprofitratiovote != null && item.actownerprofitratiovote !== '' ? item.actownerprofitratiovote : '-' }}</div>\n                </div>\n                <div class=\"info-row-flex\"><label>形成日期(表决权)</label>\n                  <div>{{item.profitratiovotestartdate || '-'}}</div>\n                </div>\n                <div class=\"info-row-flex\"><label>终止日期(表决权)</label>\n                  <div>{{item.profitratiovoteenddate || '-'}}</div>\n                </div>\n              </el-row>\n              <el-row :gutter=\"10\" class=\"info-row\"\n                v-if=\"bomisBnfIncludes(item,'NA3-1') || bomisBnfIncludes(item,'NA3-2') || bomisBnfIncludes(item,'NB3-1') || bomisBnfIncludes(item,'NB3-2') || bomisBnfIncludes(item,'ND3')\">\n                <div class=\"info-row-flex\"><label>实施实际控制的内容/方式</label>\n                  <div>{{formatMultipleDictMap('benefit_actctrltype_list', item.actctrltype_str || item.actctrltype) || '-'}}</div>\n                </div>\n                <div class=\"info-row-flex\" v-if=\"bomisBnfIncludes(item,'NA3-2') || bomisBnfIncludes(item,'NB3-2') || bomisBnfIncludes(item,'ND3')\"><label>其他形式的具体内容</label>\n                  <div>{{item.actotherforms || '-'}}</div>\n                </div>\n                <div class=\"info-row-flex\"><label>形成日期(实施实际控制)</label>\n                  <div>{{item.obtainactdate || '-'}}</div>\n                </div>\n                <div class=\"info-row-flex\"><label>终止日期(实施实际控制)</label>\n                  <div>{{item.terminationactdate || '-'}}</div>\n                </div>\n              </el-row>\n              <el-row :gutter=\"10\" class=\"info-row\"\n                v-if=\"bomisBnfIncludes(item,'NA3-1') || bomisBnfIncludes(item,'NB3-1') || bomisBnfIncludes(item,'ND3')\">\n                <div class=\"info-row-flex\"><label>是否存在上一层备案主体</label>\n                  <div>{{formatDictMap('benefit_yesno_list', item.actconuppermarket) || '-'}}</div>\n                </div>\n                <div class=\"info-row-flex\" v-if=\"item.actconuppermarket === 'Y'\"><label>上一层备案主体名称</label>\n                  <div>{{item.actconupperentname || '-'}}</div>\n                </div>\n                <div class=\"info-row-flex\" v-if=\"item.actconuppermarket === 'Y'\"><label>统一社会信用代码</label>\n                  <div>{{item.actconuniscid || '-'}}</div>\n                </div>\n              </el-row>\n              <el-row :gutter=\"10\" class=\"info-row\"\n                v-if=\"bomisBnfIncludes(item,'NA4') || bomisBnfIncludes(item,'NB4')\">\n                <div class=\"info-row-flex\"><label>负责日常经营管理的（高级管理）人员职位</label>\n                  <div>{{formatMultipleDictMap('benefit_seniormgrpos_list', item.seniormgrpos_str || item.seniormgrpos) || '-'}}</div>\n                </div>\n                <div class=\"info-row-flex\" v-if=\"bomisSeniormgrposIncludes(item,'15')\"><label>公司章程规定的其他（高级管理）人员的具体职位</label>\n                  <div>{{item.actdailymgmtpostother || '-'}}</div>\n                </div>\n              </el-row>\n              <el-row :gutter=\"10\" class=\"info-row\" v-if=\"bomisBnfIncludes(item,'NA5')\">\n                <div class=\"info-row-flex\"><label>在华最高层级的高级管理人员职位</label>\n                  <div>{{formatMultipleDictMap('benefit_seniormgrposcn_list', item.seniormgrposcn_str || item.seniormgrposcn) || '-'}}</div>\n                </div>\n                <div class=\"info-row-flex\" v-if=\"bomisSeniormgrposcnIncludes(item,'1')\"><label>在华最高层级的高级管理其他职位</label>\n                  <div>{{item.ownerrightmgmtpostother || '-'}}</div>\n                </div>\n              </el-row>\n              <el-row :gutter=\"10\" class=\"info-row\">\n                <div class=\"info-row-flex\"><label>性别</label>\n                  <div>{{formatDictMap('benefit_gender_list', item.gender) || '-'}}</div>\n                </div>\n                <div class=\"info-row-flex\"><label>国籍</label>\n                  <div>{{formatDictMap('nationality_list', item.nationality) || '-'}}</div>\n                </div>\n                <div class=\"info-row-flex\"><label>出生年月</label>\n                  <div>{{item.birthday || '-'}}</div>\n                </div>\n              </el-row>\n              <el-row :gutter=\"10\" class=\"info-row\">\n                <div class=\"info-row-flex\"><label>证件类型</label>\n                  <div>{{formatDictMap('id_type_gr_list', item.id_type) || '-'}}</div>\n                </div>\n                <div class=\"info-row-flex\"><label>证件号码</label>\n                  <div>{{item.id_no || '-'}}</div>\n                </div>\n                <div class=\"info-row-flex\"><label>证件有效期截止</label>\n                  <div>{{item.id_enddate || '-'}}</div>\n                </div>\n              </el-row>\n              <el-row :gutter=\"10\" class=\"info-row\">\n                <div class=\"info-row-flex\"><label>联系方式（手机）</label>\n                  <div>{{item.mobno1 || '-'}}</div>\n                </div>\n                <div class=\"info-row-flex\"><label>联系方式（固话）</label>\n                  <div>{{item.mobno2 || '-'}}</div>\n                </div>\n                <div class=\"info-row-flex\"><label>联系地址</label>\n                  <div>{{item.address || '-'}}</div>\n                </div>\n              </el-row>\n            </template>\n          </div>\n        </el-card>\n        <!-- 附件信息表（整块在 v-for 外，与授权代表人等模块一致） -->\n        <div style=\"padding-top:10px;\">\n          <span>附件信息</span>\n          <!--<el-tooltip \n            class=\"item\" \n            effect=\"dark\"\n            placement=\"right\">\n          </el-tooltip>-->\n          <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n          <span style=\"color:#F56C6C;font-size:14px;\">请上传受益所有人的身份证明文件的复印件；确认受益所有人的证明文件，包括但不限于股权架构图、公司章程、委托持股协议、一致行动协议、表决权差异安排协议、任命文件等；关于股权/表决权等比例计算的说明（如涉及比例）；在受益所有人信息查询管理系统（BOMIS系统）备案的信息截图（如有）</span>\n          <el-table :data=\"attachmentList.beneficialOwner\" border style=\"width: 100%;margin-top:10px;\" :default-sort = \"{prop: 'date', order: 'descending'}\">\n            <el-table-column prop=\"name\" label=\"附件名称\" sortable>\n              <template slot-scope=\"scope\">\n                <el-button type=\"text\" @click=\"handlePreview(scope.row)\" class=\"attachment-btn\">\n                  {{ scope.row.name }}\n                </el-button>\n              </template>\n            </el-table-column>\n            <el-table-column prop=\"extension\" label=\"附件类型\" width=\"80\" />\n            <el-table-column prop=\"create_time\" label=\"上传时间\" width=\"180\" sortable/>\n            <el-table-column prop=\"file_size\" label=\"附件大小\" width=\"100\" sortable>\n              <template slot-scope=\"scope\">\n                {{ formatSize(scope.row.file_size) }}\n              </template>\n            </el-table-column>\n            <el-table-column prop=\"create_by\" label=\"上传人\" width=\"150\" sortable/>\n            <el-table-column label=\"操作\" width=\"100\">\n              <template slot-scope=\"scope\">\n                <div class=\"operation-buttons\">\n                  <el-tooltip content=\"预览\">\n                    <el-button type=\"text\" class=\"el-icon-view\" @click=\"handlePreview(scope.row)\"></el-button>\n                  </el-tooltip>\n                  <el-tooltip content=\"下载\">\n                    <el-button type=\"text\" class=\"el-icon-download\" @click=\"handleDownload(scope.row)\"></el-button>\n                  </el-tooltip>\n                </div>\n              </template>\n            </el-table-column>\n          </el-table>\n        </div>\n      </el-card>\n      <!--底部声明-->\n      <el-card class=\"box-card\">\n        <!-- 标题行 -->\n        <div slot=\"header\">\n          <span class=\"card-title\" v-if=\"organ_flag=='1'\">声明：本机构保证所提供资料的真实性、准确性、完整性、有效性，并对其承担责任；\n                如上述内容发生变更时将及时以书面方式通知贵公司，如因为不能及时完成变更由此产生的一切后果将由本机构承担。<br><br>\n            机构盖章：</span>\n          <span class=\"card-title\" v-if=\"organ_flag==='0'\">声明：本人保证前述所填信息以及所提供资料的真实性、准确性、完整性、有效性，并对其承担责任；\n            如上述内容发生变更时将及时以书面方式通知贵公司，如因为不能及时完成变更由此产生的一切后果将由本人承担。<br><br>\n            签名：<br></span>\n        </div>\n        <div>\n          <el-form label-width=\"140px\">\n            <el-form-item label=\"建立业务关系日期\" prop=\"associated_date\">\n              <el-date-picker type=\"date\" placeholder=\"选择日期\" v-model=\"basicInfo.associated_date\" disabled>\n              </el-date-picker>\n            </el-form-item>\n            <el-form-item label=\"备注\" prop=\"remark\">\n              <el-input type=\"textarea\" autosize style=\"width:100%\" v-model=\"basicInfo.remark\" disabled></el-input>\n            </el-form-item>\n          </el-form>\n        </div>\n      </el-card>\n      <!--pdf导出-->\n      <el-card v-show=\"false\" class=\"box-card\">\n        <div id=\"pdf-container\" style=\"width:100%;font-size:24px;\">\n          <h2 class=\"pdf-section-title\">客户基本信息</h2>\n          <div class=\"info-div\" v-if=\"organ_flag=='1'\">\n            <div class=\"table-row\">\n              <div class=\"cell-label col-3\">客户名称</div>\n              <div class=\"cell-value col-5\">{{basicInfo.client_name || '-'}}</div>\n              <div class=\"cell-label col-3\">办公住所</div>\n              <div class=\"cell-value col-13 long-text\">\n                {{basicInfo.province || ''}}{{basicInfo.city || ''}}{{basicInfo.district ||\n                ''}}{{basicInfo.office_address || '-'}}\n              </div>\n            </div>\n            <div class=\"table-row\">\n              <div class=\"cell-label col-3\">国家或地区</div>\n              <div class=\"cell-value col-5\">{{ basicInfo.register_country ? formatDictMap('nationality_list',\n                basicInfo.register_country) : '-'}}</div>\n              <div class=\"cell-label col-3\">注册资本金币种</div>\n              <div class=\"cell-value col-5\">\n                {{basicInfo.register_money_type}}\n              </div>\n              <div class=\"cell-label col-3\">注册资本金</div>\n              <div class=\"cell-value col-5\">{{basicInfo.register_fund || '-'}}万元</div>\n            </div>\n\n            <!-- 第三行 -->\n            <div class=\"table-row\">\n              <div class=\"cell-label col-3\" v-if=\"basicInfo.industry_type!='26'\">行业分类</div>\n              <div class=\"cell-value col-5\" v-if=\"basicInfo.industry_type!='26'\">\n                {{basicInfo.industry_type?formatDictMap('industry_type_list',basicInfo.industry_type): '-'}}\n              </div>\n              <div class=\"cell-label col-2\" v-if=\"basicInfo.industry_type=='26'\">行业分类</div>\n              <div class=\"cell-value col-2\" v-if=\"basicInfo.industry_type=='26'\">\n                {{basicInfo.industry_type?formatDictMap('industry_type_list',basicInfo.industry_type): '-'}}\n              </div>\n              <div class=\"cell-label col-2\" v-if=\"basicInfo.industry_type=='26'\">请注明</div>\n              <div class=\"cell-value col-2\" v-if=\"basicInfo.industry_type=='26'\">\n                {{basicInfo.industry_name}}\n              </div>\n              <div class=\"cell-label col-3\">成立日期</div>\n              <div class=\"cell-value col-5\">{{basicInfo.setup_date || '-'}}</div>\n              <div class=\"cell-label col-3\">联系电话</div>\n              <div class=\"cell-value col-5\">{{basicInfo.tel || '-'}}</div>\n            </div>\n\n            <!-- 第四行 -->\n            <div class=\"table-row\">\n              <div class=\"cell-label col-3\">证件类型</div>\n              <div class=\"cell-value col-5\">{{basicInfo.id_type?formatDictMap('id_type_list',basicInfo.id_type):'-'}}\n              </div>\n              <div class=\"cell-label col-3\">证件号码</div>\n              <div class=\"cell-value col-5\">{{basicInfo.id_no || '-'}}</div>\n              <div class=\"cell-label col-3\">证件有效期</div>\n              <div class=\"cell-value col-5\">{{basicInfo.id_begindate || '-'}}至{{basicInfo.id_enddate || '-'}}</div>\n            </div>\n            <div class=\"table-row\">\n              <div class=\"cell-label col-3\">经营范围</div>\n              <div class=\"cell-value col-21 long-text\">{{basicInfo.busi_scope || '-'}}</div>\n            </div>\n          </div>\n\n          <div class=\"info-div\" v-if=\"organ_flag=='0'\">\n            <div class=\"table-row\">\n              <div class=\"cell-label col-3\">姓名</div>\n              <div class=\"cell-value col-5\">{{basicInfo.client_name || '-'}}</div>\n              <div class=\"cell-label col-3\">联系地址</div>\n              <div class=\"cell-value col-13\">{{basicInfo.address || '-'}}</div>\n            </div>\n            <div class=\"table-row\">\n              <div class=\"cell-label col-3\">国籍</div>\n              <div class=\"cell-value col-5\">\n                {{basicInfo.nationality?formatDictMap('nationality_list',basicInfo.nationality):'-'}}</div>\n              <div class=\"cell-label col-3\">性别</div>\n              <div class=\"cell-value col-5\">{{(basicInfo.gender=='1'?'男':basicInfo.gender=='2'?'女':'未知')|| '-'}}</div>\n              <div class=\"cell-label col-3\">出生年月</div>\n              <div class=\"cell-value col-5\">{{basicInfo.birthday || '-'}}</div>\n            </div>\n\n            <div class=\"table-row\">\n              <div class=\"cell-label col-3\">联系电话</div>\n              <div class=\"cell-value col-5\">{{basicInfo.tel || '-'}}</div>\n              <div class=\"cell-label col-3\">年收入</div>\n              <div class=\"cell-value col-5\">\n                {{basicInfo.income?formatDictMap('year_income_list',String(basicInfo.income)): '-'}}</div>\n              <div class=\"cell-label col-3\">职业分类</div>\n              <div class=\"cell-value col-5\">\n                {{basicInfo.profession_code?formatDictMap('profession_code_list',basicInfo.profession_code):'-'}}</div>\n            </div>\n            <div class=\"table-row\">\n              <div class=\"cell-label col-3\">证件类型</div>\n              <div class=\"cell-value col-5\">{{basicInfo.id_type?formatDictMap('id_type_list',basicInfo.id_type):'-'}}\n              </div>\n              <div class=\"cell-label col-3\">证件号码</div>\n              <div class=\"cell-value col-5\">{{basicInfo.id_no || '-'}}</div>\n              <div class=\"cell-label col-3\">证件有效期</div>\n              <div class=\"cell-value col-5\">{{basicInfo.id_begindate || '-'}}至{{basicInfo.id_enddate || '-'}}</div>\n            </div>\n            <div class=\"table-row\">\n              <div class=\"cell-label col-3\">证件地址</div>\n              <div class=\"cell-value col-13\">{{basicInfo.id_address || '-'}}</div>\n            </div>\n          </div>\n\n          <div v-if=\"organ_flag=='1'\">\n            <h2 class=\"pdf-section-sub-title\">法定代表人信息</h2>\n            <div class=\"info-div\">\n              <div v-for=\"(item, index) in relatedInfo1\" :key=\"item.related_id\" :class=\"{'person-divider': index > 0}\">\n                <div class=\"table-row\">\n                  <div class=\"cell-label col-3\">法定代表人姓名</div>\n                  <div class=\"cell-value col-5\">{{item.related_name || '-'}}</div>\n                  <div class=\"cell-label col-3\">出生年月</div>\n                  <div class=\"cell-value col-5\">{{item.birthday || '-'}}</div>\n                  <div class=\"cell-label col-3\">国籍</div>\n                  <div class=\"cell-value col-5\">\n                    {{item.nationality?formatDictMap('nationality_list',item.nationality):'-'}}</div>\n                </div>\n                <div class=\"table-row\">\n                  <div class=\"cell-label col-3\">身份证件类型</div>\n                  <div class=\"cell-value col-5\">{{item.id_type?formatDictMap('id_type_list',item.id_type):'-'}}</div>\n                  <div class=\"cell-label col-3\">身份证件号码</div>\n                  <div class=\"cell-value col-5\">{{item.id_no || '-'}}</div>\n                  <div class=\"cell-label col-3\">证件有效期</div>\n                  <div class=\"cell-value col-5\">{{item.id_begindate || '-'}}至{{item.id_enddate || '-'}}</div>\n                </div>\n                <div class=\"table-row\">\n                  <div class=\"cell-label col-3\">联系方式</div>\n                  <div class=\"cell-value col-5\">{{ item.mobno1 }}</div>\n                  <div class=\"cell-label col-3\"></div>\n                  <div class=\"cell-value col-5\">\n                  </div>\n                  <div class=\"cell-label col-3\"></div>\n                  <div class=\"cell-value col-5\"></div>\n                </div>\n              </div>\n              <div v-if=\"!relatedInfo1 || relatedInfo1.length === 0\" class=\"table-row\">\n                <div class=\"cell-label col-3\">法定代表人信息</div>\n                <div class=\"cell-value col-21 empty-data\">暂无数据</div>\n              </div>\n            </div>\n            <h2 class=\"pdf-section-sub-title\">控股股东信息</h2>\n            <div class=\"info-div\">\n              <div v-for=\"(item, index) in relatedInfo2\" :key=\"item.related_id\" :class=\"{'person-divider': index > 0}\">\n                <div class=\"table-row\">\n                  <div class=\"cell-label col-3\" v-if=\"item.organ_flag=='1'\">控股股东(法人)</div>\n                  <div class=\"cell-label col-3\" v-if=\"item.organ_flag=='0'\">控股股东(自然人)</div>\n                  <div class=\"cell-value col-5\">{{item.related_name || '-'}}</div>\n                  <div class=\"cell-label col-3\" v-if=\"item.organ_flag=='1'\">国家或地区</div>\n                  <div class=\"cell-label col-3\" v-if=\"item.organ_flag=='0'\">国籍</div>\n                  <div class=\"cell-value col-5\">\n                    {{item.nationality?formatDictMap('nationality_list',item.nationality):'-'}}\n                  </div>\n                  <div class=\"cell-label col-3\">证件类型</div>\n                  <div class=\"cell-value col-5\">{{item.id_type?formatDictMap('id_type_list',item.id_type):'-'}}</div>\n                </div>\n                <div class=\"table-row\">\n                  <div class=\"cell-label col-3\">证件号码</div>\n                  <div class=\"cell-value col-5\">{{item.id_no || '-'}}</div>\n                  <div class=\"cell-label col-3\">证件有效期期限</div>\n                  <div class=\"cell-value col-5\">{{item.id_begindate || '-'}}至{{item.id_enddate || '-'}}</div>\n                  <div class=\"cell-label col-3\" v-if=\"item.organ_flag=='1'\">是否政府部门</div>\n                  <div class=\"cell-value col-5\" v-if=\"item.organ_flag=='1'\">{{item.is_government_dept==='1'?'是':'否'}}\n                  </div>\n                </div>\n              </div>\n              <div v-if=\"!relatedInfo2 || relatedInfo2.length === 0\" class=\"table-row\">\n                <div class=\"cell-label col-3\">控股股东信息</div>\n                <div class=\"cell-value col-21 empty-data\">暂无数据</div>\n              </div>\n            </div>\n            <h2 class=\"pdf-section-sub-title\">实际控制人信息</h2>\n            <div class=\"info-div\">\n              <div v-for=\"(item, index) in relatedInfo3\" :key=\"item.related_id\" :class=\"{'person-divider': index > 0}\">\n                <div class=\"table-row\">\n                  <div class=\"cell-label col-3\" v-if=\"item.organ_flag=='1'\">实际控制人(法人)</div>\n                  <div class=\"cell-label col-3\" v-if=\"item.organ_flag=='0'\">实际控制人(自然人)</div>\n                  <div class=\"cell-value col-5\">{{item.related_name || '-'}}</div>\n                  <div class=\"cell-label col-3\" v-if=\"item.organ_flag=='1'\">国家或地区</div>\n                  <div class=\"cell-label col-3\" v-if=\"item.organ_flag=='0'\">国籍</div>\n                  <div class=\"cell-value col-5\">\n                    {{item.nationality?formatDictMap('nationality_list',item.nationality):'-'}}\n                  </div>\n                  <div class=\"cell-label col-3\">证件类型</div>\n                  <div class=\"cell-value col-5\">{{item.id_type?formatDictMap('id_type_list',item.id_type):'-'}}</div>\n                </div>\n                <div class=\"table-row\">\n                  <div class=\"cell-label col-3\">证件号码</div>\n                  <div class=\"cell-value col-5\">{{item.id_no || '-'}}</div>\n                  <div class=\"cell-label col-3\">证件有效期期限</div>\n                  <div class=\"cell-value col-5\">{{item.id_begindate || '-'}}至{{item.id_enddate || '-'}}</div>\n                  <div class=\"cell-label col-3\" v-if=\"item.organ_flag=='1'\">是否政府部门</div>\n                  <div class=\"cell-value col-5\" v-if=\"item.organ_flag=='1'\">{{item.is_government_dept==='1'?'是':'否'}}\n                  </div>\n                  <div class=\"cell-label col-3\" v-if=\"item.organ_flag=='0'\">出生年月</div>\n                  <div class=\"cell-value col-5\" v-if=\"item.organ_flag=='0'\">{{item.birthday || '-'}}</div>\n                </div>\n              </div>\n              <div v-if=\"!relatedInfo3 || relatedInfo3.length === 0\" class=\"table-row\">\n                <div class=\"cell-label col-3\">实际控制人信息</div>\n                <div class=\"cell-value col-21 empty-data\">暂无数据</div>\n              </div>\n            </div>\n            <h2 class=\"pdf-section-sub-title\">授权代表人信息</h2>\n            <div class=\"info-div\">\n              <div v-for=\"(item, index) in relatedInfo4\" :key=\"item.related_id\" :class=\"{'person-divider': index > 0}\">\n                <div class=\"table-row\">\n                  <div class=\"cell-label col-3\">授权代表人姓名</div>\n                  <div class=\"cell-value col-5\">{{item.related_name || '-'}}</div>\n                  <div class=\"cell-label col-3\" v-if=\"item.organ_flag=='1'\">国家或地区</div>\n                  <div class=\"cell-label col-3\" v-if=\"item.organ_flag=='0'\">国籍</div>\n                  <div class=\"cell-value col-5\">\n                    {{item.nationality?formatDictMap('nationality_list',item.nationality):'-'}}\n                  </div>\n                  <div class=\"cell-label col-3\">证件类型</div>\n                  <div class=\"cell-value col-5\">{{item.id_type?formatDictMap('id_type_list',item.id_type):'-'}}</div>\n                </div>\n                <div class=\"table-row\">\n                  <div class=\"cell-label col-3\">证件号码</div>\n                  <div class=\"cell-value col-5\">{{item.id_no || '-'}}</div>\n                  <div class=\"cell-label col-3\">证件有效期期限</div>\n                  <div class=\"cell-value col-5\">{{item.id_begindate || '-'}}至{{item.id_enddate || '-'}}</div>\n                  <div class=\"cell-label col-3\" v-if=\"item.organ_flag=='1'\">是否政府部门</div>\n                  <div class=\"cell-value col-5\" v-if=\"item.organ_flag=='1'\">{{item.is_government_dept==='1'?'是':'否'}}\n                  </div>\n                  <div class=\"cell-label col-3\" v-if=\"item.organ_flag=='0'\">出生年月</div>\n                  <div class=\"cell-value col-5\" v-if=\"item.organ_flag=='0'\">{{item.birthday || '-'}}</div>\n                </div>\n                <div class=\"table-row\">\n                  <div class=\"cell-label col-3\">联系方式</div>\n                  <div class=\"cell-value col-5\">{{ item.mobno1 }}</div>\n                  <div class=\"cell-label col-3\"></div>\n                  <div class=\"cell-value col-5\">\n                  </div>\n                  <div class=\"cell-label col-3\"></div>\n                  <div class=\"cell-value col-5\"></div>\n                </div>\n              </div>\n              <div v-if=\"!relatedInfo4 || relatedInfo4.length === 0\" class=\"table-row\">\n                <div class=\"cell-label col-3\">授权代表人信息</div>\n                <div class=\"cell-value col-21 empty-data\">暂无数据</div>\n              </div>\n            </div>\n            <h2 class=\"pdf-section-sub-title\">受益所有人信息</h2>\n            <div class=\"info-div\">\n              <div v-for=\"(item, index) in relatedInfo5\" :key=\"item.related_id\" :class=\"{'person-divider': index > 0}\">\n                <div class=\"table-row\">\n                  <div class=\"cell-label col-3\">受益所有人姓名</div>\n                  <div class=\"cell-value col-5\">{{item.related_name || '-'}}</div>\n                  <div class=\"cell-label col-3\" v-if=\"item.organ_flag=='1'\">国家或地区</div>\n                  <div class=\"cell-label col-3\" v-if=\"item.organ_flag=='0'\">国籍</div>\n                  <div class=\"cell-value col-5\">\n                    {{item.nationality?formatDictMap('nationality_list',item.nationality):'-'}}\n                  </div>\n                  <div class=\"cell-label col-3\">证件类型</div>\n                  <div class=\"cell-value col-5\">{{item.id_type?formatDictMap('id_type_list',item.id_type):'-'}}</div>\n                </div>\n                <div class=\"table-row\">\n                  <div class=\"cell-label col-3\">证件号码</div>\n                  <div class=\"cell-value col-5\">{{item.id_no || '-'}}</div>\n                  <div class=\"cell-label col-3\">证件有效期期限</div>\n                  <div class=\"cell-value col-5\">{{item.id_begindate || '-'}}至{{item.id_enddate || '-'}}</div>\n                  <div class=\"cell-label col-3\">出生年月</div>\n                  <div class=\"cell-value col-5\">{{item.birthday || '-'}}</div>\n                </div>\n                <div class=\"table-row\">\n                  <div class=\"cell-label col-3\">股权/表决权比例</div>\n                  <div class=\"cell-value col-5\">{{item.shareholding_ratio ? (item.shareholding_ratio + '%') : '-'}}\n                  </div>\n                  <div class=\"cell-label col-3\">受益所有人类型</div>\n                  <div class=\"cell-value col-5\">{{item.beneficiary?formatDictMap('beneficiary_list',item.beneficiary) :\n                    '-'}}\n                  </div>\n                  <div class=\"cell-label col-3\">联系地址</div>\n                  <div class=\"cell-value col-5\">{{item.address || '-'}}</div>\n                </div>\n              </div>\n              <div v-if=\"!relatedInfo5 || relatedInfo5.length === 0\" class=\"table-row\">\n                <div class=\"cell-label col-3\">受益所有人信息</div>\n                <div class=\"cell-value col-21 empty-data\">暂无数据</div>\n              </div>\n            </div>\n          </div>\n\n          <div class=\"info-div\">\n            <div class=\"table-row\">\n              <div class=\"cell-value\" v-if=\"organ_flag=='1'\">声明：本机构保证所提供资料的真实性、准确性、完整性、有效性，并对其承担责任；\n                如上述内容发生变更时将及时以书面方式通知贵公司，如因为不能及时完成变更由此产生的一切后果将由本机构承担。<br><br>\n              </div>\n              <div class=\"cell-value\" v-if=\"organ_flag=='0'\">声明：本人保证前述所填信息以及所提供资料的真实性、准确性、完整性、有效性，并对其承担责任；\n                如上述内容发生变更时将及时以书面方式通知贵公司，如因为不能及时完成变更由此产生的一切后果将由本人承担。<br><br>\n                <div style=\"font-weight:bold;color:#303133\">签名：</div>\n              </div>\n            </div>\n            <div class=\"table-row\" v-if=\"organ_flag=='1'\">\n              <div class=\"cell-label col-3\" style=\"height:100px;\">机构盖章:</div>\n              <div class=\"cell-value col-21\"></div>\n            </div>\n            <div class=\"table-row\">\n              <div class=\"cell-label col-3\">建立业务关系日期</div>\n              <div class=\"cell-value col-5\">{{basicInfo.associated_date}}</div>\n            </div>\n          </div>\n        </div>\n      </el-card>\n    </div>\n  </div>\n\n  <el-dialog title=\"历史核验信息\" :visible.sync=\"bomisHistoryDialogVisible\" width=\"720px\" append-to-body\n    @open=\"loadBomisFlowHistory\">\n    <div v-loading=\"bomisHistoryLoading\" style=\"height: 520px; overflow-y: auto; box-sizing: border-box; padding-right: 6px;\">\n      <div v-if=\"!bomisHistoryLoading && bomisHistoryList.length === 0\" style=\"color:#8d8b8b;text-align:center;\">\n        暂无核验记录</div>\n      <div v-for=\"item in bomisHistoryList\" :key=\"item.id\"\n        style=\"border:1px solid #d1d6db;border-radius:2px;padding:8px 10px;margin-bottom:8px;line-height:22px;\">\n        <div style=\"display:flex;justify-content:space-between;align-items:center;\">\n          <span>{{ item.op_time }}&nbsp;&nbsp;{{ item.op_user_name || '-' }}</span>\n          <el-button type=\"text\" size=\"mini\" @click=\"showBomisHistoryDetail(item.list)\">查看明细</el-button>\n        </div>\n        <div>核验结果：{{ item.result.RETURN_MSG || '-' }}</div>\n        <div>比对受益所有权结果：{{ item.result.COMPARE_REMARK || '-' }}</div>\n        <div v-if=\"item.batch_nos && item.batch_nos.length\">\n          <el-tag v-for=\"n in item.batch_nos\" :key=\"n\" size=\"mini\" style=\"margin-right:6px;\">批次{{ n }} 依据</el-tag>\n        </div>\n      </div>\n    </div>\n    <div slot=\"footer\">\n      <el-button size=\"mini\" @click=\"bomisHistoryDialogVisible = false\">关闭</el-button>\n    </div>\n  </el-dialog>\n\n  <el-dialog title=\"附件管理\" :visible.sync=\"fileDialogVisible\" :close-on-click-modal=\"false\">\n    <el-form>\n      <el-form-item label=\"附件类型\">\n        <el-cascader v-model=\"selectedMenu\" :options=\"organ_flag==='0'?directoryConfig2:directoryConfig1\" clearable\n          style=\"width:60%;margin-bottom:20px;\">\n      </el-form-item>\n      <el-form-item label=\"上传附件\">\n        <el-upload class=\"upload-demo\" ref=\"upload\"\n          action=\"m?xwl=aml_monitor/workflow/prs01/dataSource/files/upload_file1\" name=\"file1\"\n          header=\"{content-type:'text/html'}\" :data=\"uploadParams\" :file-list=\"fileList\" :auto-upload=\"false\"\n          :on-change=\"handleChange\" :on-remove=\"handleRemove\" multiple>\n          <el-button slot=\"trigger\" size=\"mini\" icon=\"el-icon-upload2\">上传文件</el-button>\n          <div slot=\"tip\" class=\"el-upload__tip\">支持扩展名：.rar .zip .doc .docx .pdf .jpg...</div>\n        </el-upload>\n      </el-form-item>\n    </el-form>\n    <div slot=\"footer\" class=\"dialog-footer\">\n      <el-button @click=\"fileDialogVisible = false\">取消</el-button>\n      <el-button type=\"primary\" @click=\"submitUpload($event.target)\">提交</el-button>\n    </div>\n  </el-dialog>\n</div>\n`,\n  data() {\n    return {\n      organ_flag: '_$organ_flag$_',\n      client_id: '_$client_id$_',\n      client_belong: '_$client_belong$_',\n      selectList: app.data.selectList,\n      isScroll: true,\n      attachmentList: {\n        'basicInfo': [],\n        'LegalRep': [],\n        'controllingShareholder': [],\n        'actualController': [],\n        'authorizedRep': [],\n        'beneficialOwner': [],\n        'communication': [],\n        'agree': [],\n        'other': []\n      },\n      navList: [\n        {\n          label: '客户基本信息',\n          value: 'basicInfo',\n          name: '#basicInfo'\n        }, {\n          label: '反洗钱特殊情况',\n          value: 'fxqSpecial',\n          name: '#fxqSpecial'\n        }, {\n          label: '法定代表人',\n          value: 'LegalRep',\n          name: '#LegalRep'\n        }, {\n          label: '控股股东',\n          value: 'controllingShareholder',\n          name: '#controllingShareholder'\n        }, {\n          label: '实际控制人',\n          value: 'actualController',\n          name: '#actualController'\n        }, {\n          label: '授权代表人',\n          value: 'authorizedRep',\n          name: '#authorizedRep'\n        }, {\n          label: '受益所有人',\n          value: 'beneficialOwner',\n          name: '#beneficialOwner'\n        },\n      ],\n      activeNav: 'basicInfo',\n      tempDomArr: [],\n      client_type_arr: [],\n      special_matters_arr: [],\n      basicInfo: app.data.basicInfo,\n      gshcInfo: app.data.gshcInfo,// 工商核查结果\n\n      relatedInfo1: app.data.relatedInfo1,// 法定代表人\n      relatedInfo2: app.data.relatedInfo2,// 控股股东\n      relatedInfo3: app.data.relatedInfo3,// 实际控制人\n      relatedInfo4: app.data.relatedInfo4,// 授权代表人\n      relatedInfo5: app.data.relatedInfo5,// 受益所有人\n      bomisSourceTableData: [], // 待发送核验的受益人数据\n      onlineBomisCheckBtnDisable: true,\n      bomisChecking: false, // 核验请求中\n      bomisHistoryDialogVisible: false,\n      bomisHistoryLoading: false,\n      bomisHistoryList: [],\n      ruleForm1: app.data.forms.ruleForm1,\n      ruleForm2: app.data.forms.ruleForm2,\n      ruleForm3: app.data.forms.ruleForm3,\n      // 省市区\n      proOptions: [],//省\n      cityOptions: [],//市\n      districtOptions: [],//区\n\n      attachments: [],\n      // 非自然人附件目录\n      directoryConfig1: app.data.directory.directoryConfig1,\n      // 自然人附件目录\n      directoryConfig2: app.data.directory.directoryConfig2,\n      fileList: [],\n      fileDialogVisible: false,\n      gshcInfoVisible: false,// 是否显示工商核查信息\n      selectedMenu: [],// 选中的目录\n      uploadParams: {\n        objectId: Wb.getId(),\n        client_id: '_$client_id$_'\n      },\n      uploadParams1: {\n        objectId: Wb.getId(),\n        client_id: '_$client_id$_'\n      },\n      uploadParams2: {\n        objectId: Wb.getId(),\n        client_id: '_$client_id$_'\n      },\n      uploadParams3: {\n        objectId: Wb.getId(),\n        client_id: '_$client_id$_'\n      },\n      loading: true\n    };\n  },\n  computed: {\n    benefitOwnerCardList() {\n      var bomisList = this.bomisSourceTableData || [];\n      if ('_$showBomisBtn$_' === 'true' || bomisList.length > 0) {\n        return bomisList;\n      }\n      return this.relatedInfo5 || [];\n    }\n  },\n  methods: {\n    // 校验时的提示（需换行）\n    showMessage(msg, time, type) {\n      this.$message({\n        showClose: true,\n        dangerouslyUseHTMLString: true,\n        message: msg,\n        duration: time ? time : 0,\n        type: type ? type : 'success'\n      })\n    },\n    formatMoney(s, n) {\n      if (!s && s !== 0) return '';\n      let str = String(s);\n      let cleaned = str.replace(/[^\\d\\.]/g, \"\") // 移除所有非数字、非小数点的字符\n        .replace(/\\.{2,}/g, '.') // 多个小数点合并为一个\n        .replace(/^\\./, \"\"); // 移除开头的小数点\n\n      if (!cleaned) return \"\";\n      let num = parseFloat(cleaned);\n      if (isNaN(num)) return \"\";\n      let fixedNum = num.toFixed(n);\n      let [integerPart, decimalPart] = fixedNum.split('.');\n      let integerWithComma = integerPart.replace(/(?=(\\B)(\\d{3})+$)/g, ',');\n      return decimalPart ? `${integerWithComma}.${decimalPart}` : integerWithComma;\n    },\n    handleClick(tab, event) {\n      this.isScroll = false;\n      let that = this;\n      let element = document.getElementsByName(tab.name)[0];\n      element.scrollIntoView({\n        behavior: 'smooth',\n        block: 'start'\n      });\n      setTimeout(() => {\n        that.isScroll = true;\n      }, 500);\n      console.log(\"滚动监听中...\");\n    },\n    // 滚动监听\n    onScroll(e) {\n      if (!this.isScroll) return;\n      var scrollItems = [];\n      this.navList.forEach(ele => {\n        var element = document.getElementsByName(ele.value)[0];\n        scrollItems.push(element);\n      });\n      var scrollTop = e.target.scrollTop;\n      var foundIndex = -1;\n      for (var i = 0; i < scrollItems.length; i++) {\n        var item = scrollItems[i];\n        var threshold = item.offsetTop - scrollItems[0].offsetTop;\n        if (scrollTop >= threshold) {\n          foundIndex = i;\n        } else {\n          break;\n        }\n      }\n      if (foundIndex !== -1) {\n        this.activeNav = this.navList[foundIndex.toString()].value;\n      }\n    },\n    // 页面展示数据字典转换\n    formatDictMap(dictType, key) {\n      const dictData = this.selectList[dictType];\n      const item = dictData?.find(item => item.k === key);\n      return item ? item.v : '-';\n    },\n    formatMultipleDictMap(dictType, key) {\n      var c_key = key || '';\n      if (Array.isArray(c_key)) {\n        c_key = c_key.join(',');\n      }\n      if (c_key === '') { return ' '; }\n      const keyList = c_key.split(',');\n      const dictData = this.selectList[dictType];\n      const item = [];\n      for (let index = 0; index < keyList.length; index++) {\n        item.push(dictData?.find(item => item.k === keyList[index]));\n      }\n      return item.length && !!item[0] ? item.map(i => i.v).join('；') : '-';\n    },\n    formatFullInfoFlag(val) {\n      if (val === '01') {\n        return '透明度较高、信息披露充分的客户（如上市公司、国有企业）';\n      }\n      if (val === '02') {\n        return '受益人信息不规范';\n      }\n      return val || '-';\n    },\n    bomisBnfIncludes(item, code) {\n      if (!item) { return false; }\n      var t = item.bnf_type;\n      if (Array.isArray(t)) {\n        return t.indexOf(code) >= 0;\n      }\n      var s = item.bnf_type_str || t || '';\n      return String(s).split(',').indexOf(code) >= 0;\n    },\n    bomisSeniormgrposIncludes(item, code) {\n      if (!item) { return false; }\n      var t = item.seniormgrpos;\n      if (Array.isArray(t)) {\n        return t.indexOf(code) >= 0;\n      }\n      var s = item.seniormgrpos_str || t || '';\n      return String(s).split(',').indexOf(code) >= 0;\n    },\n    bomisSeniormgrposcnIncludes(item, code) {\n      if (!item) { return false; }\n      var t = item.seniormgrposcn;\n      if (Array.isArray(t)) {\n        return t.indexOf(code) >= 0;\n      }\n      var s = item.seniormgrposcn_str || t || '';\n      return String(s).split(',').indexOf(code) >= 0;\n    },\n    // 格式化附件大小\n    formatSize(bytes) {\n      if (!bytes && bytes !== 0) {\n        return '';\n      } else if (bytes === 0) {\n        return '0 B'\n      };\n\n      const k = 1024;\n      const sizes = ['B', 'KB', 'MB', 'GB', 'TB'];\n      const i = Math.floor(Math.log(bytes) / Math.log(k));\n\n      return (bytes / Math.pow(k, i)).toFixed(2) + ' ' + sizes[i];\n    },\n    loadSelectList(item) {\n      let that = this;\n      if (!Wb.isEmpty(item.KEY_NAME)) {\n        Wb.ajax({\n          url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/select_key',\n          params: {\n            I_KEY_NAME: item.KEY_NAME\n          },\n          success(resp) {\n            let arr = Wb.decode(resp).items;\n            that.selectList[item.BIND_DATA + \"_list\"] = arr;\n          }\n        });\n      }\n    },\n    getDictMap(item) {\n      let that = this;\n      Wb.ajax({\n        url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/select_dict',\n        params: {\n          I_ENTRY_NO: item.ENTRY_NO\n        },\n        success(resp) {\n          let arr = Wb.decode(resp).items;\n          that.selectList[item.BIND_DATA + \"_list\"] = arr;\n        }\n      })\n    },\n    // 查询客户基本信息\n    getBasicInfo(client_id) {\n      let that = this;\n      Wb.ajax({\n        url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/select_basic_info',\n        params: {\n          CLIENT_ID: client_id\n        },\n        async:false,\n        success(resp) {\n          let res = Wb.decode(resp).items;\n          console.log(\"res[0]\", res[0])\n          if (res[0]) {\n            that.basicInfo = res[0];\n            that.basicInfo.setup_date = res[0].setup_date ? String(res[0].setup_date).replace(/\\s.*$/, '') : '';\n            that.basicInfo.id_begindate = res[0].id_begindate ? String(res[0].id_begindate).replace(/\\s.*$/, '') : '';\n            that.basicInfo.id_enddate = res[0].id_enddate ? String(res[0].id_enddate).replace(/\\s.*$/, '') : '';\n          }\n          // app.mainContainer.show();\n        }\n      });\n    },\n    getBomisSourceTableData: function () {\n      var that = this;\n      Wb.ajax({\n        url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/select_bomis_benefit_scinfo',\n        params: { client_id: '_$client_id$_' },\n        json: true,\n        success(resp) {\n          that.bomisSourceTableData = resp.items;\n          that.onlineBomisCheckBtnDisable = !that.bomisSourceTableData.filter(i => {\n            var item = i.company_type || '';\n            return item.startsWith('A') || item.startsWith('B') || item.startsWith('I');\n          }).length;\n        }\n      });\n    },\n    openBomisHistoryDialog: function () {\n      this.bomisHistoryDialogVisible = true;\n    },\n    // 历史记录按客户查询，不受流程或审核批次限制。\n    loadBomisFlowHistory: function () {\n      var that = this;\n      var apprVue = app.apprForm && app.apprForm.vue;\n      if (!apprVue || !apprVue.rowsToBomisFlowHistory) {\n        Wb.tipWarn('审核意见区未加载完成，请稍后再试');\n        that.bomisHistoryLoading = false;\n        return;\n      }\n      that.bomisHistoryList = [];\n      that.bomisHistoryLoading = true;\n      Wb.ajax({\n        url: 'm?xwl=syr_2/select_his_bomis_response_clf20261027',\n        params: { client_id: '_$client_id$_' },\n        json: true,\n        success(resp) {\n          that.bomisHistoryLoading = false;\n          if (!resp || !Array.isArray(resp.items)) {\n            that.$message.error('历史核验记录加载失败，请稍后重试');\n            return;\n          }\n          that.bomisHistoryList = apprVue.rowsToBomisFlowHistory(resp.items);\n        },\n        failure() {\n          that.bomisHistoryLoading = false;\n          that.$message.error('历史核验记录加载失败，请稍后重试');\n        }\n      });\n    },\n    showBomisHistoryDetail: function (list) {\n      if (app.apprForm && app.apprForm.vue && app.apprForm.vue.showBomisDetail) {\n        app.apprForm.vue.showBomisDetail(list);\n      }\n    },\n    onlineBomisCheck: function () {\n      // 受益所有人实时核验\n      var that = this;\n      var params = {\n        client_id: '_$client_id$_',\n        uscc: that.basicInfo.id_no, // 统一社会信用代码\n        orgNm: that.basicInfo.client_name, // 主体名称\n        branchCode: \"E1005431000011\",\n        branchName: \"国泰海通证券股份有限公司\",\n        benefitData: that.bomisSourceTableData,\n        orgTp: \"1\", // 1-公司  2-合伙企业 3-外国公司分支机构 4-豁免主体\n        piid: app.apprForm.vue.flowPiid // 当前在途流程，无在途流程时为空\n      };\n      var lastTime = app.apprForm.vue.bomisLastCheckResult.op_time;\n      var tip = lastTime ? '该客户最近一次核验时间为 ' + lastTime + '，确定重新核验？' : '确定进行受益人信息核验？';\n      that.$confirm(tip, '确认', {\n        distinguishCancelAndClose: true,\n        confirmButtonText: '确认',\n        cancelButtonText: '取消'\n      }).then(() => {\n        that.bomisChecking = true;\n        Wb.ajax({\n          url: 'm?xwl=syr_2/online_bomis_check_clf20261026',\n        \n          params: params,\n          json: true,\n          success(resp) {\n            if (!resp || Number(resp.O_RETURN_CODE) !== 0) {\n              that.bomisChecking = false;\n              that.$message.error((resp && resp.O_RETURN_MSG) || '核验接口调用失败，请稍后重试');\n              return;\n            }\n            var apprVue = app.apprForm.vue;\n            var previousRespId = apprVue.bomisRespId;\n            // BOMIS 接口返回成功即视为核验完成；右侧数据在后台继续刷新。\n            that.$message.success('最新核验信息已更新至右侧审核栏，请查看并重新选择核验结论');\n            apprVue.loadPendingBomisCheck(function () {\n              that.bomisChecking = false;\n              if (that.bomisHistoryDialogVisible) { that.loadBomisFlowHistory(); }\n            });\n          },\n          failure() {\n            that.bomisChecking = false;\n            that.$message.error('核验接口调用失败或请求超时，请稍后重试');\n          }\n        });\n      }).catch(() => { });\n    },\n    // 查询关联人信息\n    getRelatedInfo(client_id, rela_type) {\n      let that = this;\n      Wb.ajax({\n        url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/select_related_info_hg',\n        params: {\n          CLIENT_ID: client_id,\n          RELATED_TYPE: rela_type,\n          DATA_TYPE:'1'\n        },\n        async:false,\n        success(resp) {\n          let res = Wb.decode(resp).items;\n          if (res.length > 0 && rela_type == '1') {\n            that.relatedInfo1 = res;\n          } else if (res.length > 0 && rela_type == '2') {\n            that.relatedInfo2 = res;\n          } else if (res.length > 0 && rela_type == '3') {\n            that.relatedInfo3 = res;\n          } else if (res.length > 0 && rela_type == '4') {\n            that.relatedInfo4 = res;\n          } else if (res.length > 0 && rela_type == '5') {\n            that.relatedInfo5 = res;\n          }\n        }\n      });\n    },\n    getProvince() {\n      let that = this;\n      // 查询省\n      Wb.ajax({\n        url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/select_province',\n        success: function (resp) {\n          let rec = Wb.decode(resp).items;\n          that.proOptions = rec.map(item => ({\n            label: item.pro_name,\n            value: item.pro_code\n          }));\n        }\n      });\n    },\n    getCity() {\n      // 查询市\n      let that = this;\n      let province = that.organ_flag == '1' ? that.ruleForm1.province : that.ruleForm1.province2;\n      if (province) {\n        Wb.ajax({\n          url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/select_city',\n          params: {\n            I_PRO_CODE: province\n          },\n          success: function (resp) {\n            let rec = Wb.decode(resp).items;\n            console.log(\"市\", rec);\n            that.cityOptions = rec.map(item => ({\n              label: item.area_name,\n              value: item.area_code\n            }));\n          }\n        });\n      } else {\n        Wb.tipWarn('请先选择省');\n      }\n    },\n    getDistrict() {\n      // 查询区\n      let that = this;\n      let province = that.organ_flag == '1' ? that.ruleForm1.province : that.ruleForm1.province2;\n      let city = that.organ_flag == '1' ? that.ruleForm1.city : that.ruleForm1.city2;\n      Wb.ajax({\n        url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/select_district',\n        params: {\n          I_PRO_CODE: province,\n          I_AREA_CODE: city.substring(0, 4)\n        },\n        success: function (resp) {\n          let rec = Wb.decode(resp).items;\n          console.log(\"区\", rec);\n          that.districtOptions = rec.map(item => ({\n            label: item.area_name,\n            value: item.area_code\n          }));\n        }\n      });\n    },\n    openFileDialog() {\n      this.fileList = [];\n      this.selectedMenu = []\n      this.fileDialogVisible = true;\n    },\n    handleChange(file, fileList) {\n      this.fileList = fileList\n    },\n    handleDelete(index) {\n    },\n    // 下载附件\n    handleDownload(row) {\n      console.log(\"当前文件row\", row);\n      Wb.download({\n        url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/files/download_file',\n        params: {\n          id: row.id,\n          full_name: row.name + '.' + row.extension\n        }\n      })\n      // this.$message.success(`开始下载：${row.name}`);\n    },\n    submitUpload() {\n      console.log(\"this.fileList\", this.fileList);\n      console.log(\"this.selectedMenu\", this.selectedMenu);\n      if (this.fileList.length === 0) {\n        Wb.tipWarn(\"请至少选择一个文件\");\n        return;\n      }\n      if (this.selectedMenu.length === 0) {\n        Wb.tipWarn(\"请选择附件类型\");\n        return;\n      }\n      this.uploadParams.file_type_no = this.selectedMenu[this.selectedMenu.length - 1]\n      this.$refs.upload.submit();\n    },\n    handleRemove(file, fileList) {\n      console.log(file, fileList);\n    },\n    handlePreview(file) {\n      let that = this;\n      params_file = {\n        'id': file.id,\n        'clientId': file.client_id,\n        'fileTypeNo': this.organ_flag == '1' ? '1,2,21,22' : '1,2',\n        'fileName': file.name + '.' + file.extension,\n        'extension': file.extension\n      },\n        Wb.ajax({\n          url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/files/preview_file',\n          params: {\n            id: file.id,\n            clientId: file.client_id,\n            fileTypeNo: this.organ_flag == '1' ? '1,2,21,22' : '1,2',\n            fileName: file.name + '.' + file.extension,\n            extension: file.extension\n          },\n          success(resp) {\n            console.log(\"resp\", resp);\n            let res = Wb.decode(resp);\n            let serverIp = '10.116.131.13';\n            if (res.code == '200') {\n              let previewUrl = res.data.previewUrl;\n              if (previewUrl.indexOf(serverIp) != -1) {\n                previewUrl = res.data.previewUrl.replace(/10\\.116\\.131\\.13:8090/g, '10.181.135.22:8080/ibcm_flow')\n              }\n              window.open(previewUrl, '_blank', 'width=800,height=600')\n            } else {\n              that.$message.error(\"当前文件类型不支持预览\")\n            }\n          }\n        });\n    },\n    uploadSuccess() {\n      Wb.tipSucc(\"上传成功\");\n      this.fileDialogVisible = false;\n    },\n    uploadError() {\n      app.uploadError();\n    },\n    beforeRemove() {\n      app.beforeRemove();\n    },\n    selectFile() {\n      console.log(\"执行了selectFile\")\n      let that = this;\n      // 机构户附件\n      let fileType1 = {\n        'basicInfo': '1,2,21,22',\n        'LegalRep': '23',\n        'controllingShareholder': '3,31,32',\n        'actualController': '4,41,42',\n        'authorizedRep': '5,51,52',\n        'beneficialOwner': '6,61,62,63,64'\n      }\n      // 个人户附件\n      let fileType2 = {\n        'basicInfo': '1,2',\n      }\n      if (this.organ_flag == '1') {\n        for (const key in fileType1) {\n          Wb.ajax({\n            url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/files/select_file',\n            params: {\n              I_CLIENT_ID: '_$client_id$_',\n              I_FILE_TYPE_NO: fileType1[key]\n            },\n            success(resp) {\n              let rows = Wb.decode(resp).items\n              that.attachmentList[key] = rows;\n              console.log(\"that.attachmentList.\" + key, that.attachmentList[key])\n            }\n          })\n        }\n      } else {\n        for (const key in fileType2) {\n          Wb.ajax({\n            url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/files/select_file',\n            params: {\n              I_CLIENT_ID: '_$client_id$_',\n              I_FILE_TYPE_NO: fileType2[key]\n            },\n            success(resp) {\n              let rows = Wb.decode(resp).items\n              that.attachmentList[key] = rows;\n              console.log(\"that.attachmentList.\" + key, that.attachmentList[key])\n            }\n          })\n        }\n      }\n      // 反洗钱特殊情况 对文件细致分类过的回显时单独用object_id查询\n      const fxq_special_arr = ['communication', 'agree', 'other']\n      fxq_special_arr.forEach(item => {\n        Wb.ajax({\n          url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/files/select_file',\n          params: {\n            I_CLIENT_ID: '_$client_id$_',\n            I_OBJECT_ID: '_$client_id$_' + item\n          },\n          success(resp) {\n            let rows = Wb.decode(resp).items\n            that.attachmentList[item] = rows;\n            console.log(\"that.attachmentList.\" + item, that.attachmentList[item])\n          }\n        })\n      })\n    },\nvalidateBeforeExport() {\n  const isEmpty = val => val === null || val === undefined || String(val).trim() === '';\n  const rules = getRules();\n  const info = this.basicInfo || {};\n  const isOrgan = this.organ_flag == '1';\n  const msgs = [];\n  const checkFields = props => props.forEach(p => {\n    if (isEmpty(info[p])) {\n      msgs.push(rules[p] ? rules[p][0].message : `“${p}”不能为空`);\n    }\n  });\n\n  if (info.is_special == '1') {\n    // 存在反洗钱特殊情况：关联人只校验姓名，再校验特殊情况模块和附件\n    if (isOrgan) {\n      const noName = list => list.length === 0 || list.some(item => !item || isEmpty(item.related_name));\n      if (noName(this.relatedInfo1)) msgs.push('请填写法定代表人姓名');\n      if (noName(this.relatedInfo4)) msgs.push('请填写授权代表人姓名');\n      if (noName(this.relatedInfo5)) msgs.push('请填写受益所有人姓名');\n    }\n    if (isEmpty(info.communication_records)) msgs.push('请上传“与客户沟通记录”文件');\n    if (isEmpty(info.agree_records)) msgs.push('请上传“二级部门负责人同意的记录”文件');\n\n    const clientType = info.client_type ? String(info.client_type).split(',') : [];\n    const matters = info.special_matters ? String(info.special_matters).split(',') : [];\n    const props = ['client_type', 'special_matters', 'special_reason', 'completed_cdd', 'low_risk_explanation', 'take_measures'];\n    if (clientType.includes('99')) props.push('client_type_other');\n    if (matters.includes('1')) props.push('missing_information');\n    if (matters.includes('2')) props.push('missing_draft');\n    if (matters.includes('99')) props.push('special_matters_other');\n    checkFields(props);\n  } else if (isOrgan) {\n    // 机构户：基本信息全部必填，法定代表人、授权代表人、受益所有人至少一条\n    if (this.relatedInfo1.length == 0) msgs.push('请添加法定代表人信息');\n    if (this.relatedInfo4.length == 0) msgs.push('请添加授权代表人信息');\n    if (this.relatedInfo5.length == 0) msgs.push('请添加受益所有人信息');\n\n    const props = ['client_name', 'office_address', 'register_country', 'register_money_type', 'register_fund',\n      'industry_type', 'tel', 'setup_date', 'id_type', 'id_no', 'id_begindate', 'id_enddate', 'busi_scope', 'associated_date'];\n    if (info.industry_type == '26') props.push('industry_name');\n    checkFields(props);\n\n    const validateRelatedPerson = (list, typeName) => {\n      list.forEach(item => {\n        const name = item.related_name || '';\n        if (isEmpty(item.related_name)) msgs.push(`${typeName}的姓名不能为空`);\n        if (item.is_government_dept === '1') return;\n        if (isEmpty(item.nationality)) msgs.push(`${typeName}${name}的国籍不能为空`);\n        if (isEmpty(item.id_type)) msgs.push(`${typeName}${name}的证件类型不能为空`);\n        if (isEmpty(item.id_no)) msgs.push(`${typeName}${name}的证件号码不能为空`);\n        if (isEmpty(item.id_begindate)) msgs.push(`${typeName}${name}的证件开始日期不能为空`);\n        if (isEmpty(item.id_enddate)) msgs.push(`${typeName}${name}的证件结束日期不能为空`);\n        if (item.organ_flag === '1' && item.is_government_dept !== '0' && item.is_government_dept !== '1') {\n          msgs.push(`${typeName}${name}的是否政府部门不能为空`);\n        }\n        if (item.organ_flag === '0' && isEmpty(item.birthday)) msgs.push(`${typeName}${name}的出生日期不能为空`);\n        if (item.related_type === '5') {\n          if (isEmpty(item.beneficiary)) msgs.push(`${typeName}${name}的受益所有人类型不能为空`);\n          if (isEmpty(item.address)) msgs.push(`${typeName}${name}的地址不能为空`);\n          if (['A1', 'A2', 'B1', 'D1'].includes(item.beneficiary) && isEmpty(item.shareholding_ratio)) {\n            msgs.push(`${typeName}${name}的股权/表决权比例不能为空`);\n          }\n        }\n        if ((item.related_type === '1' || item.related_type === '4') && isEmpty(item.mobno1)) {\n          msgs.push(`${typeName}${name}的联系方式不能为空`);\n        }\n      });\n    };\n    validateRelatedPerson(this.relatedInfo1, '法定代表人');\n    validateRelatedPerson(this.relatedInfo2, '控股股东');\n    validateRelatedPerson(this.relatedInfo3, '实际控制人');\n    validateRelatedPerson(this.relatedInfo4, '授权代表人');\n    validateRelatedPerson(this.relatedInfo5, '受益所有人');\n  } else {\n    // 自然人\n    checkFields(['client_name', 'birthday', 'id_address', 'address', 'nationality', 'gender', 'income',\n      'profession_code', 'id_type', 'id_no', 'id_begindate', 'id_enddate', 'associated_date']);\n  }\n\n  if (msgs.length > 0) {\n    this.showMessage('客户信息不完整，请在编辑页补充并提交后再打印导出：<br>' + msgs.join('<br>'), 8000, 'error');\n    return false;\n  }\n  return true;\n},\n    downloadPdf() {\n      if (!this.validateBeforeExport()) return;\n      // this.getBasicInfo('_$client_id$_');\n      // this.getRelatedInfo('_$client_id$_', '1');\n      // this.getRelatedInfo('_$client_id$_', '2');\n      // this.getRelatedInfo('_$client_id$_', '3');\n      // this.getRelatedInfo('_$client_id$_', '4');\n      // this.getRelatedInfo('_$client_id$_', '5');\n      \n      const htmlContent = document.getElementById('pdf-container');\n      const clone = htmlContent.cloneNode(true);\n      clone.style.backgroundColor = '#ffffff'; // 确保背景白色\n      clone.style.padding = '20px';\n      clone.style.width = '1800px';\n      clone.style.maxWidth = 'none';\n      document.body.appendChild(clone);\n\n      setTimeout(() => {\n        html2canvas(clone, {\n          scale: window.devicePixelRatio,//2,\n          useCORS: true,\n          allowTaint: false,\n          backgroundColor: \"#ffffff\",\n          fontSize: '24px',\n          boxSizing: 'border-box',\n          // scrollX: 0,\n          // scrollY: -window.scrollY\n        }).then(canvas => {\n          const contentWidth = canvas.width;\n          const contentHeight = canvas.height;\n\n          const pageWidth = 595.28; // A4 pt 宽度\n          const pageHeight = 841.89; // A4 pt 高度\n          const imgWidth = pageWidth - 40; // 两边各留 20pt 边距\n          const imgHeight = (imgWidth / contentWidth) * contentHeight;\n\n          const pageData = canvas.toDataURL('image/jpeg', 1.0);\n          console.log(\"pageData.length\", pageData.length / (1024 * 1024) + \"MB\");\n          const pdf = new jsPDF('', 'pt', 'a4');\n\n          let leftHeight = imgHeight;\n          let position = 0;\n\n          if (leftHeight < pageHeight) {\n            pdf.addImage(pageData, 'JPEG', 20, 0, imgWidth, imgHeight);\n          } else {\n            while (leftHeight > 0) {\n              pdf.addImage(pageData, 'JPEG', 20, position, imgWidth, imgHeight);\n              leftHeight -= pageHeight;\n              position -= pageHeight;\n\n              if (leftHeight > 0) {\n                pdf.addPage();\n              }\n            }\n          }\n          pdf.save(\"客户基本信息表-【\" + '_$client_name$_' + '(' + '_$client_id$_' + ')' + \"】\" + \".pdf\");\n          document.body.removeChild(clone);\n        }).catch(err => {\n          console.error('PDF导出失败', err);\n          document.body.removeChild(clone);\n        });\n      }, 500);\n    },\n  },\n  watch: {\n  },\n  created: async function () {\n    let that = this;\n    this.activeNav += this._uid;\n    let navList_jg = [\n      {\n        label: '客户基本信息',\n        value: 'basicInfo',\n        name: '#basicInfo'\n      }, {\n        label: '反洗钱特殊情况',\n        value: 'fxqSpecial',\n        name: '#fxqSpecial'\n      }, {\n        label: '法定代表人',\n        value: 'LegalRep',\n        name: '#LegalRep'\n      }, {\n        label: '控股股东',\n        value: 'controllingShareholder',\n        name: '#controllingShareholder'\n      }, {\n        label: '实际控制人',\n        value: 'actualController',\n        name: '#actualController'\n      }, {\n        label: '授权代表人',\n        value: 'authorizedRep',\n        name: '#authorizedRep'\n      }, {\n        label: '受益所有人',\n        value: 'beneficialOwner',\n        name: '#beneficialOwner'\n      },\n    ];\n    let navList_gr = [\n      {\n        label: '客户基本信息',\n        value: 'basicInfo',\n        name: '#basicInfo'\n      }, {\n        label: '反洗钱特殊情况',\n        value: 'fxqSpecial',\n        name: '#fxqSpecial'\n      }\n    ];\n    this.navList = '_$organ_flag$_' === '1' ? navList_jg : navList_gr;\n    this.navList.forEach(ele => {\n      ele.value += that._uid;\n    });\n\n    app.data.list.forEach(async item => {\n      await this.loadSelectList(item);\n    });\n\n    app.data.dict.forEach(async item => {\n      await this.getDictMap(item);\n    });\n\n    // 获取客户基本信息\n    await this.getBasicInfo('_$client_id$_');\n    // 获取法定代表人信息\n    await this.getRelatedInfo('_$client_id$_', '1');\n    // 获取控股股东信息\n    await this.getRelatedInfo('_$client_id$_', '2');\n    // 获取实际控制人信息\n    await this.getRelatedInfo('_$client_id$_', '3');\n    // 获取授权代表人信息\n    await this.getRelatedInfo('_$client_id$_', '4');\n    // 获取受益所有人信息\n    await this.getRelatedInfo('_$client_id$_', '5');\n    if (this.organ_flag === '1') {\n      this.getBomisSourceTableData();\n    }\n    await this.selectFile();\n    await this.getProvince();\n    // 从全局获取数据\n    setTimeout(() => {\n      try {\n        var info = this.basicInfo || {};\n        if (info.client_type) { this.client_type_arr = String(info.client_type).split(',') }\n        if (info.special_matters) { this.special_matters_arr = String(info.special_matters).split(',') }\n      } catch (e) {\n        console.error('mainContainer 初始化收尾失败', e);\n      } finally {\n        this.loading = false;\n      }\n    }, 1000);\n\n  },\n  mounted: function () {\n  },\n  beforeDestroy() {\n  },\n});"
                  }
                }
              ]
            },
            {
              "_icon": "card",
              "text": "card2",
              "cls": "Wb.Card",
              "properties": {
                "cid": "card2",
                "title": "附件清单",
                "closable": "null",
                "layout": "fit"
              },
              "_expanded": false,
              "items": [
                {
                  "_icon": "container",
                  "text": "fileManage",
                  "cls": "Wb.Container",
                  "properties": {
                    "cid": "fileManage"
                  },
                  "events": {
                    "ready": "let comp = this;\ncomp.vue = new Vue({\n  el: comp.el.addEl(),\n  template: `\n<div class=\"file-container\">\n  <!-- 左侧目录树 -->\n  <div class=\"left-panel\" ref=\"leftPanel\">\n    <div class=\"panel-title\">附件类型目录</div>\n    <div class=\"search-box\">\n      <el-input \n        placeholder=\"输入关键字进行过滤\" \n        v-model.trim=\"filterText\"\n        clearable\n        >\n        <i slot=\"prefix\" class=\"el-input__icon el-icon-search\"></i>\n      </el-input>\n    </div>\n\n    <el-tree class=\"filter-tree\" ref=\"tree\" :data=\"organ_flag==='0'?directoryConfig2:directoryConfig1\" :props=\"defaultProps\"\n      default-expand-all :filter-node-method=\"filterNode\" :expand-on-click-node=\"false\" @node-click=\"handleNodeClick\" highlight-current\n      >\n      <span class=\"custom-tree-node\" slot-scope=\"{ node, data }\" :data-node-key=\"data.value\" \n          @dragenter=\"handleTreeDragEnter($event, node, data)\" \n          @dragover=\"handleTreeDragOver($event, node, data)\" \n          @drop=\"handleTreeDrop($event, node, data)\">\n            <span>{{ node.label }}</span>\n      </span>\n    </el-tree>\n  </div>\n\n  <!-- 右侧附件列表 -->\n  <div class=\"right-panel\" style=\"overflow-y:auto;\">\n    <div v-if=\"!selectedMenu\" style=\"color:#8d8b8b;height:100%;display:flex;justify-content:center;align-items:center;\">请先从左侧选择目录</div>\n    <div v-else>\n      <div class=\"panel-title\">附件清单 - {{ selectedMenu.label }}</div>\n      <el-table :data=\"attachmentList\" stripe border class=\"attachment-table\" v-loading=\"loading\" :default-sort = \"{prop: 'date', order: 'descending'}\">\n        <el-table-column prop=\"name\" label=\"附件名称\" min-width=\"180\" sortable>\n          <template slot-scope=\"scope\">\n            <el-button type=\"text\" \n                      @click=\"handleDownload(scope.row)\" \n                      class=\"attachment-btn\"\n                      draggable=\"false\"\n                      native-type=\"button\"\n                      @dragstart.native=\"handleDragStart(scope.row)\"\n                      >\n            {{ scope.row.name }}\n            </el-button>\n          </template>\n        </el-table-column>\n        <el-table-column prop=\"extension\" label=\"附件类型\" width=\"100\"></el-table-column>\n        <el-table-column prop=\"create_time\" label=\"上传时间\" width=\"160\" sortable></el-table-column>\n        <el-table-column prop=\"file_size\" label=\"附件大小\" width=\"120\" sortable>\n          <template slot-scope=\"scope\">\n            {{ formatSize(scope.row.file_size) }}\n          </template>\n        </el-table-column>\n        <el-table-column prop=\"create_by\" label=\"上传人\" width=\"120\" sortable></el-table-column>\n        <el-table-column label=\"操作\" width=\"70\" fixed=\"right\">\n          <template slot-scope=\"scope\">\n            <div class=\"operation-buttons\">\n              <el-tooltip content=\"预览\"><el-button type=\"text\" class=\"el-icon-view\" @click=\"handlePreview(scope.row)\"></el-button></el-tooltip>\n              <el-tooltip content=\"下载\"><el-button type=\"text\" class=\"el-icon-download\" @click=\"handleDownload(scope.row)\"></el-button></el-tooltip>\n            </div>\n          </template>\n        </el-table-column>\n      </el-table>\n      <!--<div class=\"upload-add\">\n      <el-upload class=\"upload-demo\" \n          ref=\"upload\" \n          action=\"m?xwl=aml_monitor/workflow/prs01/dataSource/files/upload_file1\"\n          name = \"file1\"\n          header=\"{content-type:'text/html'}\"\n          :data=\"uploadParams\"\n          :auto-upload=\"true\" \n          :on-change=\"handleChange\"\n          :on-remove=\"handleRemove\"\n          :on-success=\"handleSuccess\"\n          :show-file-list=\"false\"\n          multiple>\n          <el-button type=\"text\" icon=\"el-icon-plus\">添加</el-button>\n        </el-upload>\n      </div>-->\n    </div>\n  </div>\n</div>\n`,\n  data() {\n    return {\n      filterText: '',\n      organ_flag: '_$organ_flag$_',\n      // 非自然人附件目录\n      directoryConfig1: app.data.directory.directoryConfig1,\n      // 自然人附件目录\n      directoryConfig2: app.data.directory.directoryConfig2,\n      defaultProps: {\n        children: 'children',\n        label: 'label'\n      },\n      selectedMenu: null,\n      attachmentList: [],\n      loading: false,\n      fileList: [],\n      dropTargetNode: null, // 接收拖拽的树节点\n      draggingFile: null, // 当前拖拽的文件\n    };\n  },\n  // 新增 watch：监听 filterText 变化并触发 tree 过滤\n  watch: {\n    filterText(val) {\n      // 必须等 DOM 更新后才能调用 $refs.tree\n      this.$nextTick(() => {\n        if (this.$refs.tree) {\n          this.$refs.tree.filter(val);\n        }\n      });\n    }\n  },\n  methods: {\n    // 过滤方法\n    filterNode(value, data) {\n      if (!value) return true;\n      // 支持模糊搜索（不区分大小写）\n      return data.label.toLowerCase().includes(value.toLowerCase());\n    },\n    // 处理节点点击\n    handleNodeClick(data) {\n      this.selectedMenu = data;\n      console.log(\"selectedMenu\", this.selectedMenu);\n      this.loadAttachments(this.selectedMenu.value);\n    },\n    // 格式化附件大小\n    formatSize(bytes) {\n      if (!bytes && bytes !== 0) {\n        return '';\n      } else if (bytes === 0) {\n        return '0 B'\n      };\n\n      const k = 1024;\n      const sizes = ['B', 'KB', 'MB', 'GB', 'TB'];\n      const i = Math.floor(Math.log(bytes) / Math.log(k));\n\n      return (bytes / Math.pow(k, i)).toFixed(2) + ' ' + sizes[i];\n    },\n    // 加载附件列表\n    loadAttachments(directoryId) {\n      let that = this;\n      Wb.ajax({\n        url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/files/select_file',\n        params: {\n          I_CLIENT_ID: '_$client_id$_',//'9999999',\n          I_FILE_TYPE_NO: directoryId\n        },\n        success(resp) {\n          let res = Wb.decode(resp).items;\n          that.attachmentList = res;\n        }\n      });\n    },\n    // 下载附件\n    handleDownload(row) {\n      console.log(\"当前文件row\", row);\n      Wb.download({\n        url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/files/download_file',\n        params: {\n          id: row.id,\n          full_name: row.name + '.' + row.extension\n        }\n      })\n      // this.$message.success(`开始下载：${row.name}`);\n    },\n    handleChange(file, fileList) {\n      this.fileList = fileList\n    },\n\n    // 删除附件\n    handleDelete(row) {\n      this.$confirm(`确定要删除\"${row.name}\"吗?`, '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(() => {\n        const index = this.attachmentList.findIndex(item => item.id === row.id);\n        if (index !== -1) {\n          this.attachmentList.splice(index, 1);\n          this.$message.success('删除成功');\n        }\n      }).catch(() => { });\n    },\n\n    // 上传相关方法\n    handleRemove(file, fileList) {\n      console.log(file, fileList);\n    },\n    handleSuccess() {\n      Wb.tipSucc(\"上传成功\");\n      this.loadAttachments(this.selectedMenu.value);\n    },\n    handlePreview(file) {\n      let that = this;\n      params_file = {\n        'id': file.id,\n        'clientId': file.client_id,\n        'fileTypeNo': this.organ_flag == '1' ? '1,2,21,22' : '1,2',\n        'fileName': file.name + '.' + file.extension,\n        'extension': file.extension\n      },\n        Wb.ajax({\n          url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/files/preview_file',\n          params: {\n            id: file.id,\n            clientId: file.client_id,\n            fileTypeNo: this.organ_flag == '1' ? '1,2,21,22' : '1,2',\n            fileName: file.name + '.' + file.extension,\n            extension: file.extension\n          },\n          success(resp) {\n            console.log(\"resp\", resp);\n            let res = Wb.decode(resp);\n            let serverIp = '10.116.131.13';\n            if (res.code == '200') {\n              let previewUrl = res.data.previewUrl;\n              if (previewUrl.indexOf(serverIp) != -1) {\n                previewUrl = res.data.previewUrl.replace(/10\\.116\\.131\\.13:8090/g, '10.181.135.22:8080/ibcm_flow')\n              }\n              window.open(previewUrl, '_blank', 'width=800,height=600')\n            } else {\n              that.$message.error(\"当前文件类型不支持预览\")\n            }\n          }\n        });\n    },\n    handleExceed(files, fileList) {\n      this.$message.warning(`当前限制选择 3 个文件，本次选择了 ${files.length} 个文件，共选择了 ${files.length + fileList.length} 个文件`);\n    },\n    beforeRemove(file, fileList) {\n      return this.$confirm(`确定移除 ${file.name}？`);\n    },\n\n    // 文件拖拽开始\n    handleDragStart(file) {\n      this.draggingFile = file;\n      console.log(\"dragfile:\", this.draggingFile);\n    },\n\n    // 树节点拖拽进入\n    handleTreeDragEnter(event, node, data) {\n      event.preventDefault();\n      this.dropTargetNode = node;\n    },\n    // 树节点经过\n    handleTreeDragOver(event, node, data) {\n      console.log(\"handleTreeDragOver\", node.data);\n      event.preventDefault(); // 必须，否则 drop 不生效\n      this.dropTargetNode = node;\n    },\n    // 树节点 drop 事件\n    handleTreeDrop(event) {\n      let that = this;\n      console.log(\"handleTreeDrop\");\n      event.preventDefault();\n      event.stopPropagation();\n\n      if (!this.draggingFile || !this.dropTargetNode) return;\n\n      const file = this.draggingFile;\n      const targetNode = this.dropTargetNode;\n\n      let tip = '确定要把 “' + file.name + '” 移动到 “' + targetNode.label + '” 目录下吗？'\n      Wb.confirm(tip, function () {\n        Wb.ajax({\n          url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/files/update_file_dir',\n          params: {\n            I_FILE_TYPE_NO: targetNode.data.value,\n            I_ID: file.id\n          },\n          success(resp) {\n            that.loadAttachments(that.selectedMenu.value);\n            that.$message.success(\"操作成功\")\n          }\n        })\n      });\n      // 清理数据\n      this.draggingFile = null;\n      this.dropTargetNode = null;\n    },\n  },\n\n  mounted: function () {\n    // 实现左侧面板宽度可调节\n    const leftPanel = this.$refs.leftPanel;\n    let isResizing = false;\n    leftPanel.addEventListener('mouseenter', (e) => {\n      if (e.offsetX > leftPanel.offsetWidth - 10) {\n        document.body.style.cursor = 'col-resize';\n      }\n    });\n    leftPanel.addEventListener('mouseleave', (e) => {\n      if (e.offsetX > leftPanel.offsetWidth - 10) {\n        document.body.style.cursor = 'auto';\n      }\n    });\n    leftPanel.addEventListener('mousedown', (e) => {\n      if (e.offsetX > leftPanel.offsetWidth - 10) {\n        isResizing = true;\n        document.body.style.cursor = 'col-resize';\n        document.body.style.userSelect = 'none';\n      }\n    });\n\n    document.addEventListener('mousemove', (e) => {\n      if (!isResizing) return;\n\n      const newWidth = e.clientX - leftPanel.getBoundingClientRect().left;\n      if (newWidth >= 250 && newWidth <= 600) {\n        leftPanel.style.width = newWidth + 'px';\n      }\n    });\n\n    document.addEventListener('mouseup', () => {\n      isResizing = false;\n      document.body.style.cursor = '';\n      document.body.style.userSelect = '';\n    });\n  }\n});"
                  },
                  "hasDupCid": 0
                }
              ]
            },
            {
              "_icon": "card",
              "text": "card3",
              "cls": "Wb.Card",
              "properties": {
                "cid": "card3",
                "closable": "null",
                "title": "反馈结果",
                "layout": "fit"
              },
              "_expanded": false,
              "items": [
                {
                  "_icon": "container",
                  "text": "feedBack",
                  "cls": "Wb.Container",
                  "properties": {
                    "cid": "feedBack",
                    "full": "true"
                  },
                  "events": {
                    "ready": "let comp = this;\ncomp.vue = new Vue({\n  el: comp.el.addEl(),\n  template: `\n  <el-card style=\"height:100%\">\n    <div slot=\"header\">\n      <span class=\"card-title\">反馈结果</span>\n    </div>\n    <el-form class=\"feedBack\">\n      <el-form-item label=\"风险名单筛查\" prop=\"if_risk_client\">\n        {{feedBack.screen_name||'-'}}\n      </el-form-item>\n      <el-form-item label=\"问题描述（如有）\" prop=\"problem_desc\">\n        {{feedBack.problem_desc||'-'}}\n      </el-form-item>\n      <el-form-item label=\"风险等级\" prop=\"risk_grade\">\n        {{feedBack.grade_name||'-'}}\n      </el-form-item>\n    </el-form>\n  </el-card>\n`,\n  data() {\n    return {\n      client_id: '_$client_id$_',\n      selectList: {\n        'grade_value_list': []\n      },\n      feedBack: {},\n    };\n  },\n  methods: {\n    // 查询反馈结果\n    getFeedBackInfo() {\n      let that = this;\n      Wb.ajax({\n        url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/select_feedback',\n        params: {\n          I_CLIENT_ID: '_$client_id$_',\n          I_USER_ID: '_$sys.user$_'\n        },\n        success(resp) {\n          let res = Wb.decode(resp).items;\n          that.feedBack = { ...res[0] };\n          console.log(\"feedBack\", that.feedBack);\n        }\n      });\n    },\n    // 查询反馈结果问题描述\n    getFeedBackDesc() {\n      let that = this;\n      Wb.ajax({\n        url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/select_feedback_desc',\n        params: {\n          I_CLIENT_ID: '_$client_id$_',\n          I_USER_ID: '_$sys.user$_'\n        },\n        success(resp) {\n          let res = Wb.decode(resp).items;\n          that.feedBack.problem_desc = res[0].screen_desc;\n          console.log(\"res\", res);\n        }\n      });\n    }\n  },\n  created: function () {\n    // 加载字典\n    setTimeout(() => {\n      this.selectList = { ...app.data.selectList }\n      this.getFeedBackInfo();\n      this.getFeedBackDesc();\n    }, 1000);\n  },\n});"
                  }
                }
              ]
            }
          ]
        },
        {
          "_icon": "splitter",
          "text": "splitter1",
          "cls": "Wb.Splitter",
          "properties": {
            "cid": "splitter1"
          }
        },
        {
          "_icon": "panel",
          "text": "panel1",
          "cls": "Wb.Panel",
          "properties": {
            "cid": "panel1",
            "autoScroll": "true",
            "padding": "20px",
            "width": "400px"
          },
          "_expanded": true,
          "items": [
            {
              "_icon": "container",
              "text": "apprForm",
              "cls": "Wb.Container",
              "properties": {
                "cid": "apprForm",
                "layout": "fit",
                "minWidth": "100px",
                "width": "100%"
              },
              "events": {
                "ready": "let comp = this;\ncomp.vue = new Vue({\n  el: comp.el.addEl(),\n  template: `\n<div>\n  <div style=\"display:flex;justify-content:space-between;border-bottom:1px solid #eee;padding-bottom:8px;\">\n    <div style=\"padding-top:50px;font-size:16px;font-weight:bold;color:#303133\">审核意见</div>\n    <div style=\"padding-top:40px;\">\n      <el-dropdown trigger=\"click\" @command=\"restrictiveBtn\">\n        <!-- 触发按钮 -->\n        <el-button type=\"primary\" size=\"small\">\n          限制措施<i class=\"el-icon-arrow-down el-icon--right\"></i>\n        </el-button>\n\n        <!-- 2. el-dropdown-menu：下拉列表内容 -->\n        <el-dropdown-menu slot=\"dropdown\">\n          <el-dropdown-item command=\"2\">强限制</el-dropdown-item>\n          <el-dropdown-item command=\"3\">弱限制</el-dropdown-item>\n          <el-dropdown-item command=\"0\">解除限制</el-dropdown-item>\n        </el-dropdown-menu>\n      </el-dropdown>\n    </div>\n  </div>\n  <div class=\"table-wrapper\">\n    <el-table :data=\"tableData\" border stripe style=\"width: 100%\">\n      <el-table-column label=\"序号\" width=\"50\" align=\"center\">\n        <template slot-scope=\"scope\">\n          <span>{{ scope.$index + 1 }}</span>\n          <input type=\"hidden\" v-model=\"scope.row.seq\" :value=\"scope.$index + 1\" />\n        </template>\n      </el-table-column>\n\n      <el-table-column label=\"错误类型\" width=\"200\">\n        <template slot-scope=\"scope\">\n          <el-select v-model=\"scope.row.error_type\" placeholder=\"请选择\" filterable clearable style=\"width: 100%\"\n            :key=\"scope.$index\">\n            <el-option v-for=\"item in errorTypeOptions\" :key=\"item.err_type\" :value=\"item.err_type\"></el-option>\n          </el-select>\n        </template>\n      </el-table-column>\n\n      <el-table-column label=\"问题描述\" min-width=\"200\">\n        <template slot-scope=\"scope\">\n          <el-input v-model=\"scope.row.problem_desc\" placeholder=\"请输入\" type=\"textarea\" :rows=\"1\" autosize />\n        </template>\n      </el-table-column>\n\n      <el-table-column label=\"操作\" width=\"60\" align=\"center\">\n        <template slot-scope=\"scope\">\n          <el-button type=\"text\" size=\"small\" style=\"color: #F56C6C\" @click=\"removeRow(scope.$index)\">\n            移除\n          </el-button>\n        </template>\n      </el-table-column>\n    </el-table>\n  </div>\n  <div class=\"add-btn-container\">\n      <el-button type=\"primary\" size=\"small\" @click=\"addRow\">添加行</el-button>\n    </div>\n  <div>\n    <div style=\"color:#4b4b4b;padding:20px 0 10px 0;\">备注</div>\n    <el-input type=\"textarea\" v-model=\"remark\" :rows=\"4\" :autosize=\"{minRows: 4}\"></el-input>\n  </div>\n  <div v-if=\"organFlag==='1'\">\n    <div style=\"color:#4b4b4b;padding:20px 0 10px 0;\">受益所有人当前核验信息</div>\n    <div v-if=\"!bomisLastCheckResult.RETURN_MSG\" style=\"color:#8d8b8b;text-align:center;\">暂无核验记录</div>\n    <div v-else>\n      <div style=\"border:1px solid #d1d6db;border-radius:2px;padding:10px 12px;line-height:24px;\">\n        <div>核验结果：{{ bomisLastCheckResult.RETURN_MSG }}</div>\n        <div>核验时间：{{ bomisLastCheckResult.op_time }}</div>\n        <div>比对受益所有权结果：{{ bomisLastCheckResult.COMPARE_REMARK }}</div>\n      </div>\n      <div style=\"font-weight:bold;margin:10px 0 0;\">核验明细：</div>\n      <el-table :data=\"bomisLastCheckResultList\" border style=\"width: 100%;margin: 0.5em 0 0;\"\n        :header-cell-style=\"{ background: '#EDF3FE' }\" size=\"mini\" max-height=\"400\">\n        <el-table-column v-for=\"col in bomisColumns\" :key=\"col.prop\" :prop=\"col.prop\" :label=\"col.label\"\n          :width=\"col.width\" :fixed=\"col.fixed || false\">\n          <template slot-scope=\"scope\">{{ col.dict ? formatMultipleDictMap(col.dict, scope.row[col.prop]) : scope.row[col.prop] }}</template>\n        </el-table-column>\n      </el-table>\n    </div>\n    <div style=\"color:#4b4b4b;padding:20px 0 10px 0;\">受益所有人核验结论</div>\n    <div v-if=\"lastBatchConclusion.result\" style=\"color:#8d8b8b;font-size:12px;padding-bottom:6px;\">\n      上次结论：{{ formatConclusion(lastBatchConclusion.result) }}（{{ lastBatchConclusion.user }} / {{ lastBatchConclusion.time }}）\n    </div>\n    <el-select v-model=\"bomisCheckConclusion\" placeholder=\"请选择\" clearable size=\"small\" style=\"width: 100%\">\n      <el-option v-for=\"item in bomisCheckConclusionOptions\" :key=\"item.k\" :label=\"item.k + '-' + item.v\"\n        :value=\"item.k\"></el-option>\n    </el-select>\n  </div>\n  <div>\n    <div style=\"display:flex;justify-content:space-between;padding-top:20px;\">\n      <el-button type=\"primary\" size=\"small\" @click=\"submitAppr\">保存提交</el-button>\n      <el-button size=\"small\" @click=\"cancel\">取消</el-button>\n    </div>\n  </div>\n  <div style=\"color:#4b4b4b;padding:20px 0 10px 0;\" @click=\"showHistoryLogs=!showHistoryLogs\">\n    <span v-if=\"showHistoryLogs\"><i class=\"el-icon-caret-bottom\"></i></span>\n    <span v-else><i class=\"el-icon-caret-top\"></i></span>\n    历史问题记录\n  </div>\n  <div v-if=\"showHistoryLogs\">\n    <div v-if=\"batch_total===0\"\n      style=\"color:#8d8b8b;height:100%;display:flex;justify-content:center;align-items:center;\">暂无数据</div>\n    <el-tabs v-model=\"activeTab\" @tab-click=\"handleTabClick\">\n      <el-tab-pane v-for=\"index in batch_total\" :key=\"index\" :label=\"'批次'+ (batch_total - index + 1)\"\n        :name=\"String(index)\">\n        <el-table :data=\"hisData\" border style=\"width: 100%;\">\n          <el-table-column prop=\"audit_desc\" label=\"问题分类\" width=\"120\" />\n          <el-table-column prop=\"dispose_desc\" label=\"问题内容\" width=\"200\"></el-table-column>\n          <el-table-column prop=\"batch_display_name\" label=\"提出人\" width=\"120\" />\n          <el-table-column prop=\"create_time\" label=\"提出时间\" width=\"200\" />\n        </el-table>\n        <div>\n          <div style=\"color:#4b4b4b;padding:20px 0 10px 0;\">备注</div>\n          <el-input type=\"textarea\" v-model=\"batch_remark\" disabled></el-input>\n          <template v-if=\"organFlag==='1'\">\n            <div style=\"color:#4b4b4b;padding:10px 0 0 0;\">受益所有人核验结论：{{ formatConclusion(batch_bomis_check_result) }}</div>\n            <div v-if=\"!batch_bomis_resp_id\" style=\"color:#8d8b8b;padding:6px 0 0 0;\">该轮未进行受益所有人核验</div>\n            <div v-else-if=\"batchBomisResult.RETURN_MSG\"\n              style=\"border:1px solid #d1d6db;border-radius:2px;margin-top:6px;padding:6px 10px;line-height:22px;\">\n              <div>核验结果：{{ batchBomisResult.RETURN_MSG }}</div>\n              <div>核验时间：{{ batchBomisResult.op_time }}</div>\n              <div>比对受益所有权结果：{{ batchBomisResult.COMPARE_REMARK }}</div>\n              <el-button type=\"text\" size=\"mini\" @click=\"showBomisDetail(batchBomisList)\">查看明细</el-button>\n            </div>\n          </template>\n          <div style=\"color:#4b4b4b;padding:10px 0 0 0;text-align:right\">审核人:&nbsp;&nbsp;{{batch_display_name}}</div>\n          <div style=\"color:#4b4b4b;padding:10px 0 0 0;text-align:right\">审核时间:&nbsp;&nbsp;{{batch_create_time}}</div>\n        </div>\n      </el-tab-pane>\n    </el-tabs>\n  </div>\n\n  <el-dialog title=\"核验明细\" :visible.sync=\"bomisDetailVisible\" width=\"80%\" append-to-body>\n    <el-table :data=\"bomisDetailList\" border style=\"width: 100%;\" :header-cell-style=\"{ background: '#EDF3FE' }\"\n      size=\"mini\" max-height=\"500\">\n        <el-table-column v-for=\"col in bomisColumns\" :key=\"col.prop\" :prop=\"col.prop\" :label=\"col.label\"\n          :width=\"col.width\" :fixed=\"col.fixed || false\">\n          <template slot-scope=\"scope\">{{ col.dict ? formatMultipleDictMap(col.dict, scope.row[col.prop]) : scope.row[col.prop] }}</template>\n        </el-table-column>\n    </el-table>\n  </el-dialog>\n</div>\n`,\n  data() {\n    return {\n      selectList: null,\n      dialogFormVisible: false,\n      fileList: [],\n      attachments: [],\n\n      tableData: [{}],//当前审核详情\n      remark: '',\n\n      hisData: [],//历史审核详情\n      errorTypeOptions: [],//错误类型下拉框选项\n      showHistoryLogs: true,//是否展示历史问题记录\n      batch_display_name: '',\n      batch_create_time: '',\n      batch_remark: '',\n      batch_total: 0,//批次总数\n      activeTab: '1',\n\n      organFlag: '_$organ_flag$_',\n      bomisLastCheckResult: {\n        \"RETURN_CODE\": \"\",\n        \"RETURN_MSG\": \"\",\n        \"NoDiffList\": [],\n        \"COMPARE_REMARK\": \"\"\n      },\n      bomisLastCheckResultList: [], // 核验后返回的受益人数据\n      bomisRespId: '', // 当前展示的核验记录主键，提交时一并保存\n      bomisCheckConclusion: '', // 受益所有人核验结论\n      lastBatchConclusion: { result: '', user: '', time: '' }, // 最近一个审核批次的核验结论\n      batch_bomis_check_result: '',\n      batch_bomis_resp_id: '',\n      batchBomisResult: { RETURN_MSG: '' },\n      batchBomisList: [],\n      bomisDetailVisible: false,\n      bomisDetailList: [], // 明细弹窗数据\n      flowPiid: '', // 当前在途流程实例ID，无在途流程时为空\n      bomisFlowHistory: [], // 供左侧「历史核验信息」弹窗使用\n      bomisColumns: [\n        { prop: 'check_type_name', label: '差异类型', width: 150, fixed: 'left' },\n        { prop: 'name', label: '姓名', width: 120 },\n        { prop: 'gender', label: '性别', width: 70, dict: 'benefit_gender_list' },\n        { prop: 'ntlty', label: '国籍', width: 160, dict: 'bomis_nationality_list' },\n        { prop: 'birthdt', label: '出生日期', width: 160 },\n        { prop: 'idtp', label: '证件类型', width: 220, dict: 'benefit_id_type_list' },\n        { prop: 'idnb', label: '证件号码', width: 260 },\n        { prop: 'iddate', label: '证件有效期', width: 260 },\n        { prop: 'addr', label: '联系地址', width: 300 },\n        { prop: 'mobno1', label: '联系电话(手机)', width: 300 },\n        { prop: 'mobno2', label: '联系电话(固定电话)', width: 300 },\n        { prop: 'acthdrat', label: '持有股权、股份或者合伙权益的比例（%)', width: 160 },\n        { prop: 'shareratiostartdate', label: '形成日期(股权、股份或者合伙权益)', width: 160 },\n        { prop: 'shareratioenddate', label: '终止日期(股权、股份或者合伙权益)', width: 160 },\n        { prop: 'actownerprofitratio', label: '持有收益权的比例(%)', width: 160 },\n        { prop: 'profitratiostartdate', label: '形成日期(收益权)', width: 160 },\n        { prop: 'profitratioenddate', label: '终止日期(收益权)', width: 160 },\n        { prop: 'actownerprofitratiovote', label: '持有表决权的比例(%)', width: 160 },\n        { prop: 'profitratiovotestartdate', label: '形成日期(表决权)', width: 160 },\n        { prop: 'profitratiovoteenddate', label: '终止日期(表决权)', width: 160 },\n        { prop: 'actctrltype', label: '实施实际控制的内容/方式', width: 300, dict: 'benefit_actctrltype_list' },\n        { prop: 'actotherforms', label: '其他形式的具体内容', width: 160 },\n        { prop: 'obtainactdate', label: '形成日期(实施实际控制)', width: 160 },\n        { prop: 'terminationactdate', label: '终止日期(实施实际控制)', width: 160 },\n        { prop: 'actconuppermarket', label: '是否存在上一层备案主体', width: 150, dict: 'benefit_yesno_list' },\n        { prop: 'actconupperentname', label: '实际控制备案主体的上一层备案主体名称', width: 240 },\n        { prop: 'actconuniscid', label: '实际控制备案主体的统一社会信用代码', width: 200 },\n        { prop: 'seniormgrpos', label: '负责日常经营管理的（高级管理）人员职位', width: 240, dict: 'benefit_seniormgrpos_list' },\n        { prop: 'actdailymgmtpostother', label: '公司章程规定的其他（高级管理）人员的具体职位', width: 240 },\n        { prop: 'seniormgrposcn', label: '在华最高层级的高级管理人员职位', width: 240, dict: 'benefit_seniormgrposcn_list' },\n        { prop: 'ownerrightmgmtpostother', label: '在华最高层级的高级管理其他职位', width: 240 }\n      ],\n      bomisCheckConclusionOptions: [\n        { k: '1', v: 'BOMIS信息正确，录入信息有误' },\n        { k: '2', v: 'BOMIS信息有误，录入信息正确' },\n        { k: '3', v: 'BOMIS信息有误，录入信息有误' },\n        { k: '4', v: '经营主体应备案未备案' },\n        { k: '5', v: '经营主体无需备案' }\n      ],\n    };\n  },\n  methods: {\n    //添加行\n    addRow() {\n      this.tableData.push({\n        seq: '',\n        error_type: '',\n        problem_desc: ''\n      });\n    },\n    // 校验时的提示（需换行）\n    showMessage(msg, time, type) {\n      this.$message({\n        showClose: true,\n        dangerouslyUseHTMLString: true,\n        message: msg,\n        duration: time ? time : 0,\n        type: type ? type : 'success'\n      })\n    },\n    //移除行\n    removeRow(index) {\n      this.tableData.splice(index, 1);\n    },\n    handleTabClick(tab) {\n      // tab.name是从1开始的，需要转换为从0开始的index\n      // console.log(\"tab\",tab);\n      const index = parseInt(tab.name) - 1;\n      this.getApprData(index);\n    },\n    restrictiveBtn(item) {\n      console.log('用户选择了:', item);\n      console.log('当前用户状态:', app.mainContainer.vue.basicInfo.client_status);\n      const client_status = app.mainContainer.vue.basicInfo.client_status;\n      if (item == '0' && client_status !== '2' && client_status !== '3') {\n        Wb.tipError(\"请选择状态为已限制的客户\");\n        return;\n      }\n      if (item == '2' && client_status == '2') {\n        Wb.tipError(\"该客户状态为已限制\");\n        return;\n      }\n      if (item == '3' && client_status == '3') {\n        Wb.tipError(\"该客户状态为弱限制\");\n        return;\n      } else if (item == '3' && client_status == '2') {\n        Wb.tipError(\"该客户状态为已限制\");\n        return;\n      }\n      Wb.ajax({\n        url: 'm?xwl=aml_monitor/KYC01020/update_client_status',\n        params: {\n          I_CLIENT_ID: '_$client_id$_',\n          I_OP_FLAG: item,\n          I_USER_NAME: '_$sys.username$_'\n        },\n        success(resp) {\n          let res = Wb.decode(resp);\n          if (res.O_RETURN_CODE == '0') {\n            Wb.tipSucc(\"操作成功\");\n          } else {\n            Wb.tipError(res.O_RETURN_MSG);\n          }\n          app.mainContainer.vue.getBasicInfo('_$client_id$_');\n        }\n      });\n    },\n    // 查询审核记录\n    getApprData(batch) {\n      let that = this;\n      Wb.ajax({\n        // url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/select_appr_details',\n        url: 'm?xwl=syr_2/select_appr_details_clf20261026',\n\n        params: {\n          I_CLIENT_ID: '_$client_id$_',\n          I_BATCH_NUM: batch\n        },\n        success(resp) {\n          let res = Wb.decode(resp).items;\n          console.log(`批次 ${batch} 的数据:`, res);\n\n          // 统一更新历史数据，不再区分 lastData 和 hisData\n          that.hisData = res;\n          that.batch_display_name = res[0]?.batch_display_name || '';\n          that.batch_create_time = res[0]?.batch_create_time || '';\n          that.batch_remark = res[0]?.batch_remark || '';\n          that.batch_bomis_check_result = res[0]?.batch_bomis_check_result || '';\n          that.batch_bomis_resp_id = res[0]?.batch_bomis_resp_id || '';\n          that.batchBomisResult = { RETURN_MSG: '' };\n          that.batchBomisList = [];\n          if (that.batch_bomis_resp_id) {\n            that.getBomisCheckRsById(that.batch_bomis_resp_id);\n          }\n        }\n      })\n    },\n    // 查询审核批次\n    getBatchTotal() {\n      let that = this;\n      Wb.ajax({\n        url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/select_batch_total',\n        params: {\n          I_CLIENT_ID: '_$client_id$_'\n        },\n        success(resp) {\n          let res = Wb.decode(resp).items;\n          that.batch_total = res[0].cnt;\n          if (that.batch_total > 0 && that.organFlag === '1') {\n            that.getLastBatchConclusion();\n          }\n          // 批次总数获取后，加载第一个历史tab的数据\n          if (that.batch_total > 0) {\n            that.getApprData(0); // 加载第一个历史批次（index从0开始）\n          }\n        }\n      })\n    },\n    // 查询错误类型\n    getErrorType() {\n      let that = this;\n      Wb.ajax({\n        url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/select_err_type',\n        params: {\n          ORGAN_FLAG: '_$organ_flag$_'\n        },\n        success(resp) {\n          let rows = Wb.decode(resp).items;\n          that.errorTypeOptions = rows;\n          console.log(\"that.errorTypeOptions\", that.errorTypeOptions);\n        }\n      });\n    },\n    // 保存提交 并下发流程\n    submitAppr() {\n      console.log(\"app.apprForm.vue.tableData\", this.tableData);\n      let tableData = this.tableData;\n      let that = this;\n\n      const audit_id = Wb.getId();\n      const submittedBomisRespId = this.bomisRespId;\n      const batchList = tableData.map((item, index) => ({\n        CLIENT_ID: '_$client_id$_',\n        AUDIT_ID: audit_id,\n        AUDIT_SEQ: index + 1,       // 对应 tableData[i].seq\n        AUDIT_DESC: item.error_type, // 对应 tableData[i].error_type\n        DISPOSE_DESC: item.problem_desc, // 对应 tableData[i].problem_desc\n        CREATE_USER: '_$sys.username$_'\n      }));\n\n      let errors = [];\n      if (batchList.length == 0) {\n        Wb.tipError(\"审核意见为空！\");\n        return;\n      }\n\n      tableData.forEach((row, rowIndex) => {\n        if (!row['error_type']) {\n          errors.push(`请选择第${rowIndex + 1}行的错误类型`);\n        }\n        if (!row['problem_desc']) {\n          errors.push(`请填写第${rowIndex + 1}行的问题描述`);\n        }\n      });\n\n      if (this.organFlag === '1' && !this.bomisCheckConclusion) {\n        errors.push('请选择受益所有人核验结论');\n      }\n\n      if (errors.length > 0) {\n        Wb.tipError(errors.join('\\n'));\n        return;\n      }\n\n      console.log(\"batchList\", batchList);\n      // 插入审核意见list表\n      Wb.ajax({\n        // url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/save_appr_list',\n        url: 'm?xwl=syr_2/save_appr_list_clf20261026',\n\n        params: {\n          CLIENT_ID: '_$client_id$_',\n          AUDIT_ID: audit_id,\n          REMARK: this.remark,\n          BOMIS_CHECK_RESULT: this.bomisCheckConclusion,\n          BOMIS_RESP_ID: submittedBomisRespId,\n          PIID: this.flowPiid,\n          CREATE_USER: '_$sys.username$_'\n        },\n        success(resp) {\n          Wb.ajax({\n            url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/save_appr_details',\n            params: {\n              batchList: batchList\n            },\n            success() {\n              var dealRequest = Wb.ajax({\n                url: 'm?xwl=aml_monitor/KYC01020/flow_request_deal',\n                params: {\n                  'x-flow-systemId': 'IBCM',//当前发送全连接流程类型\n                  'x-userId': '_$sys.userid$_',//当前登录人id\n                  'x-userName': '_$sys.username$_',//encodeURI('_$sys.username$_'),//当前登录人name\n                  'url': 'http://10.116.131.13:8094/auto/submit',\n                  \"CLIENT_ID\": '_$client_id$_',\n                  \"CLIENT_NAME\": '_$client_name$_',\n                  \"ORGAN_FLAG\": '_$organ_flag$_',\n                  \"CLIENT_BELONG\": '_$client_belong$_' == '融资端' ? '1' : '2',//1融资端 2投资端\n                  \"CLIENT_STATUS\": '_$client_status$_',\n                  \"FK_FLAG\": '_$fk_flag$_',\n                  \"todoTitle\": '_$client_name$_' + \" 客户反洗钱审核意见\",\n                  \"sysGuid\": \"IBCM\",\n                  \"flowCode\": \"IBCM001\",\n                  \"templateName\": '_$client_name$_' + \" 反洗钱客户填报审核\",\n                  \"flowVer\": \"2\",\n                  \"nodeCode\": \"draft\",\n                  \"applyTable\": \"T_TH_CLIENT_FLOW\",\n                  \"candidates\": '_$maintainer$_',\n                },\n                success(resp) {\n                  // Wb.tipSucc(\"成功发送【反洗钱客户信息填报审核】流程\")\n                  that.showMessage(\"成功发送【反洗钱客户信息填报审核】流程\", 2000, 'success');\n                  that.bindBomisAudit(audit_id, submittedBomisRespId, function () {\n                    app.parentApp.parentContainer.close();\n                  });\n\n                },\n                //错误返回则删除数据\n                failure(resp) {\n                  clearTimeout(timeoutId); // 成功响应时清除超时计时器\n                }\n              });\n              var timeoutId = setTimeout(function () {\n                // 如果存在 XMLHttpRequest 对象，则中止请求\n                if (dealRequest && typeof dealRequest.abort === 'function') {\n                  dealRequest.abort();\n                  console.log('请求超时');\n                }\n              }, 60000); // 设置1分钟的超时时间\n            }\n          });\n        }\n      });\n    },\n    cancel() {\n      app.parentApp.parentContainer.close();\n    },\n    // 页面展示数据字典转换 多选（字典在 mainContainer 中加载）\n    formatMultipleDictMap(dictType, key) {\n      var c_key = key || '';\n      if (c_key === '') { return ' '; }\n      const keyList = c_key.split(',');\n      const dictData = app.mainContainer.vue.selectList[dictType];\n      const item = [];\n      for (let index = 0; index < keyList.length; index++) {\n        item.push(dictData?.find(item => item.k === keyList[index]));\n      }\n      return item.length && !!item[0] ? item.map(i => i.v).join('；') : '-';\n    },\n    formatConclusion(key) {\n      const item = this.bomisCheckConclusionOptions.find(i => i.k === key);\n      return item ? item.k + '-' + item.v : '-';\n    },\n    // 解析一条核验记录，返回核验结果摘要和明细列表\n    parseBomisResponse(row) {\n      if (!row || !row.response_info) { return null; }\n      var response_info;\n      try {\n        response_info = JSON.parse(JSON.parse(row.response_info));\n      } catch (e) {\n        return null;\n      }\n      response_info.op_time = row.op_time;\n      var list = [];\n      var noDiff = (response_info.NoDiffList || [])[0];\n      if (noDiff) {\n        var checkTypes = [\n          { count: 'CONS_COUNT', list: 'ConsList', code: 'cons', name: '核验一致' },\n          { count: 'LACK_COUNT', list: 'LackList', code: 'lack', name: '受益人缺失' },\n          { count: 'MORE_COUNT', list: 'MoreList', code: 'more', name: '受益人多出' },\n          { count: 'ELMT_COUNT', list: 'ElmtList', code: 'elmt', name: '个人信息要素项不一致' },\n          { count: 'PERP_COUNT', list: 'PerpList', code: 'perp', name: '备案主体填报类型为承诺免报' },\n          { count: 'SCEC_COUNT', list: 'ScecList', code: 'scec', name: '备案主体填报类型为国有公司' }\n        ];\n        checkTypes.forEach(function (t) {\n          if (noDiff[t.count] > 0) {\n            list = list.concat(noDiff[t.list].map(item => {\n              const newItem = {};\n              for (const key in item) {\n                newItem[key.toLowerCase()] = item[key];\n              }\n              newItem.check_type_code = t.code;\n              newItem.check_type_name = t.name;\n              return newItem;\n            }));\n          }\n        });\n      }\n      return { result: response_info, list: list };\n    },\n    isPendingBomisRow: function (row) {\n      if (!row) { return false; }\n      var hasPiid = row.piid != null && String(row.piid).trim() !== '';\n      var hasAudit = row.audit_id != null && String(row.audit_id).trim() !== '';\n      return !hasPiid && !hasAudit;\n    },\n    filterBomisItemsForRightPanel: function (items) {\n      var list = items || [];\n      var that = this;\n      if (that.flowPiid) {\n        return list.filter(function (row) { return (row.piid || '') === that.flowPiid; });\n      }\n      return list.filter(function (row) { return that.isPendingBomisRow(row); });\n    },\n    clearBomisPendingDisplay: function () {\n      this.bomisLastCheckResult = {};\n      this.bomisLastCheckResultList = [];\n      this.bomisRespId = '';\n      this.bomisCheckConclusion = '';\n      this.bomisFlowHistory = [];\n    },\n    rowsToBomisFlowHistory: function (items) {\n      var that = this;\n      return (items || []).map(function (row) {\n        var parsed = that.parseBomisResponse(row);\n        return {\n          id: row.id,\n          op_time: row.op_time,\n          op_user_name: row.op_user_name,\n          batch_nos: row.batch_nos || [],\n          result: parsed ? parsed.result : { RETURN_MSG: '无返回信息', COMPARE_REMARK: '' },\n          list: parsed ? parsed.list : []\n        };\n      });\n    },\n    syncBomisRightPanelFromRows: function (items) {\n      var pending = this.filterBomisItemsForRightPanel(items);\n      this.bomisFlowHistory = this.flowPiid ? this.rowsToBomisFlowHistory(pending) : [];\n      var row = pending.length > 0 ? pending[0] : null;\n      if (!row) {\n        this.clearBomisPendingDisplay();\n        return;\n      }\n      var parsed = this.parseBomisResponse(row);\n      if (!parsed) {\n        this.clearBomisPendingDisplay();\n        return;\n      }\n      var nextRespId = row.id || '';\n      if (this.bomisRespId !== nextRespId) {\n        this.bomisCheckConclusion = '';\n      }\n      this.bomisLastCheckResult = parsed.result;\n      this.bomisLastCheckResultList = parsed.list;\n      this.bomisRespId = nextRespId;\n    },\n    fetchBomisResponseItems: function (done) {\n      var that = this;\n      var finish = function (items) {\n        done(that.filterBomisItemsForRightPanel(items || []));\n      };\n      Wb.ajax({\n        url: 'm?xwl=syr_2/select_flow_bomis_history_clf20261026',\n        params: { client_id: '_$client_id$_', piid: that.flowPiid || '' },\n        json: true,\n        success(resp) {\n          finish(resp.items);\n        },\n        failure() {\n          Wb.ajax({\n            url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/select_his_bomis_response',\n            params: { client_id: '_$client_id$_' },\n            json: true,\n            success(resp2) {\n              finish(resp2.items);\n            },\n            failure() {\n              finish([]);\n            }\n          });\n        }\n      });\n    },\n    // 右侧：未提交前跨次进入仍展示；提交 bind 后再次进入为空\n    loadPendingBomisCheck: function (callback) {\n      var that = this;\n      that.fetchBomisResponseItems(function (pending) {\n        that.syncBomisRightPanelFromRows(pending);\n        if (typeof callback === 'function') { callback(pending); }\n      });\n    },\n    getLastOnlineBomisCheckRs: function () {\n      this.loadPendingBomisCheck();\n    },\n    // 按主键查询某条核验记录（历史批次用）\n    getBomisCheckRsById(id) {\n      var that = this;\n      Wb.ajax({\n        url: 'm?xwl=syr_2/select_his_bomis_response_clf20261027',\n        params: { client_id: '_$client_id$_', id: id },\n        json: true,\n        success(resp) {\n          if (that.batch_bomis_resp_id !== id) { return; }\n          var row = resp.total > 0 ? resp.items[0] : null;\n          // 校验返回记录主键，避免展示其他核验记录\n          var parsed = row && row.id === id ? that.parseBomisResponse(row) : null;\n          if (!parsed) { return; }\n          that.batchBomisResult = parsed.result;\n          that.batchBomisList = parsed.list;\n        }\n      });\n    },\n    showBomisDetail(list) {\n      this.bomisDetailList = list || [];\n      this.bomisDetailVisible = true;\n    },\n    // 查询客户当前在途流程，取得 piid 后加载当前流程历史核验记录\n    getFlowCurNode() {\n      var that = this;\n      Wb.ajax({\n        url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/select_flow_cur_node',\n        params: { client_id: '_$client_id$_' },\n        json: true,\n        success(resp) {\n          that.flowPiid = resp && resp.O_RETURN_CODE === 0 && !resp.finished ? resp.piid : '';\n          that.getBomisFlowHistory();\n        },\n        failure() {\n          that.flowPiid = '';\n          that.getBomisFlowHistory();\n        }\n      });\n    },\n    mapBomisFlowHistoryRows(items) {\n      if (!this.flowPiid) { return []; }\n      return this.rowsToBomisFlowHistory(this.filterBomisItemsForRightPanel(items));\n    },\n    getBomisFlowHistory() {\n      if (!this.flowPiid) { this.bomisFlowHistory = []; return; }\n      this.loadPendingBomisCheck();\n    },\n    // 审核提交成功后，将本次引用的核验记录绑定到审核批次\n    bindBomisAudit(audit_id, bomis_resp_id, done) {\n      // 无关联核验记录的批次无需反向绑定。\n      if (!bomis_resp_id) { done(); return; }\n      var that = this;\n      function handleFailure(message) {\n        that.$confirm('审核已保存且流程已发送，但核验记录批次绑定未完成。' + message + '。点击重试只补做绑定，请勿重复提交审核。', '核验记录绑定失败', {\n          confirmButtonText: '重试绑定',\n          cancelButtonText: '关闭页面',\n          closeOnClickModal: false,\n          closeOnPressEscape: false,\n          showClose: false,\n          type: 'warning'\n        }).then(function () {\n          that.bindBomisAudit(audit_id, bomis_resp_id, done);\n        }).catch(function () { done(); });\n      }\n      Wb.ajax({\n        url: 'm?xwl=syr_2/bind_bomis_audit_clf20261026',\n        params: { client_id: '_$client_id$_', audit_id: audit_id, bomis_resp_id: bomis_resp_id },\n        json: true,\n        success(resp) {\n          if (resp && Number(resp.O_RETURN_CODE) === 0) { done(); }\n          else { handleFailure((resp && resp.O_RETURN_MSG) || '服务返回异常'); }\n        },\n        failure() { handleFailure('绑定请求失败或超时'); }\n      });\n    },\n    // 查询最近一个审核批次的核验结论\n    getLastBatchConclusion() {\n      let that = this;\n      Wb.ajax({\n        // url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/select_appr_details',\n        url: 'm?xwl=syr_2/select_appr_details_clf20261026',\n\n        params: {\n          I_CLIENT_ID: '_$client_id$_',\n          I_BATCH_NUM: 0\n        },\n        success(resp) {\n          let res = Wb.decode(resp).items;\n          that.lastBatchConclusion = {\n            result: res[0]?.batch_bomis_check_result || '',\n            user: res[0]?.batch_display_name || '',\n            time: res[0]?.batch_create_time || ''\n          };\n        }\n      });\n    }\n  },\n  created: function () {\n    // 加载字典\n    setTimeout(() => {\n      this.selectList = { ...app.data.selectList }\n      this.getBatchTotal();\n      this.getErrorType();\n      if (this.organFlag === '1') {\n        this.getLastOnlineBomisCheckRs();\n        // this.getFlowCurNode();\n      }\n    }, 1000);\n  },\n});"
              },
              "hasDupCid": 0
            }
          ]
        }
      ]
    },
