            "ready": "// let comp = this;\n// comp.vue = new Vue({\n//   el: comp.el.addEl(),\n//   template: `\n// <div>\n//   <div class=\"table-wrapper\">\n//     <el-table :data=\"tableData\" border stripe style=\"width: 100%\">\n//       <el-table-column label=\"序号\" width=\"60\" align=\"center\">\n//         <template slot-scope=\"scope\">\n//           <span>{{ scope.$index + 1 }}</span>\n//           <input type=\"hidden\" v-model=\"scope.row.seq\" :value=\"scope.$index + 1\" />\n//         </template>\n//       </el-table-column>\n\n//       <el-table-column label=\"错误类型\" width=\"250\">\n//         <template slot-scope=\"scope\">\n//           <el-select v-model=\"scope.row.error_type\" placeholder=\"请选择\" filterable clearable style=\"width: 100%\"\n//             :key=\"scope.$index\">\n//             <el-option v-for=\"item in errorTypeOptions\" :key=\"item.err_type\" :value=\"item.err_type\"></el-option>\n//           </el-select>\n//         </template>\n//       </el-table-column>\n\n//       <el-table-column label=\"问题描述\">\n//         <template slot-scope=\"scope\">\n//           <el-input v-model=\"scope.row.problem_desc\" placeholder=\"请输入\" type=\"textarea\" :rows=\"1\" autosize />\n//         </template>\n//       </el-table-column>\n\n//       <el-table-column label=\"操作\" width=\"100\" align=\"center\">\n//         <template slot-scope=\"scope\">\n//           <el-button type=\"text\" size=\"small\" style=\"color: #F56C6C\" @click=\"removeRow(scope.$index)\">\n//             移除\n//           </el-button>\n//         </template>\n//       </el-table-column>\n//     </el-table>\n\n//     <div class=\"add-btn-container\">\n//       <el-button type=\"primary\" @click=\"addRow\">添加行</el-button>\n//     </div>\n//   </div>\n//   <div>\n//     <div style=\"color:#4b4b4b;padding:20px 0 10px 0;\">备注</div>\n//     <el-input type=\"textarea\" v-model=\"remark\"></el-input>\n//   </div>\n//   <div style=\"color:#4b4b4b;padding:20px 0 10px 0;\" @click=\"showHistoryLogs=!showHistoryLogs\">\n//     <span v-if=\"showHistoryLogs\"><i class=\"el-icon-caret-bottom\"></i></span>\n//     <span v-else><i class=\"el-icon-caret-top\"></i></span>\n//     历史问题记录\n//   </div>\n//   <div v-if=\"showHistoryLogs\">\n//     <div v-if=\"batch_total===0\"\n//       style=\"color:#8d8b8b;height:100%;display:flex;justify-content:center;align-items:center;\">暂无数据</div>\n//     <el-tabs v-model=\"activeTab\" @tab-click=\"handleTabClick\">\n//       <el-tab-pane v-for=\"index in batch_total\" :key=\"index\" :label=\"'批次'+ (batch_total - index + 1)\"\n//         :name=\"String(index)\">\n//         <el-table :data=\"hisData\" border style=\"width: 100%;\">\n//           <el-table-column prop=\"dispose_desc\" label=\"问题内容\"></el-table-column>\n//           <el-table-column prop=\"audit_desc\" label=\"问题分类\" width=\"300\" />\n//           <el-table-column prop=\"batch_display_name\" label=\"提出人\" width=\"200\" />\n//           <el-table-column prop=\"create_time\" label=\"提出时间\" width=\"200\" />\n//         </el-table>\n//         <div>\n//           <div style=\"color:#4b4b4b;padding:20px 0 10px 0;\">备注</div>\n//           <el-input type=\"textarea\" v-model=\"batch_remark\" disabled></el-input>\n//           <div style=\"color:#4b4b4b;padding:10px 0 0 0;text-align:right\">审核人:&nbsp;&nbsp;{{batch_display_name}}</div>\n//           <div style=\"color:#4b4b4b;padding:10px 0 0 0;text-align:right\">审核时间:&nbsp;&nbsp;{{batch_create_time}}</div>\n//         </div>\n//       </el-tab-pane>\n//     </el-tabs>\n//   </div>\n// </div>\n// `,\n//   data() {\n//     return {\n//       selectList: null,\n//       dialogFormVisible: false,\n//       fileList: [],\n//       attachments: [],\n\n//       tableData: [],//当前审核详情\n//       remark: '',\n\n//       hisData: [],//历史审核详情\n//       errorTypeOptions: [],//错误类型下拉框选项\n//       showHistoryLogs: true,//是否展示历史问题记录\n//       batch_display_name: '',\n//       batch_create_time: '',\n//       batch_remark: '',\