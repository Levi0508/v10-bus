{
  "title": "客户信息新增（React 草稿版）",
  "icon": "",
  "img": "",
  "tags": "",
  "hideInMenu": "false",
  "text": "module",
  "cls": "Wb.Module",
  "properties": {
    "cid": "module",
    "serverScript": "Wb.set({\n  client_id: Wb.get('CLIENT_ID'),\n  client_name: Wb.get('CLIENT_NAME'),\n  organ_flag: Wb.get('ORGAN_FLAG'),\n  client_belong: Wb.get('CLIENT_BELONG'),\n  client_status: Wb.get('CLIENT_STATUS'),\n  fk_flag: Wb.get('FK_FLAG'),\n  key: Wb.get('KEY'),\n  cur_user: Wb.get('CUR_USER')\n});"
  },
  "_icon": "module",
  "_expanded": true,
  "items": [
    {
      "_icon": "viewport",
      "text": "viewport1",
      "cls": "Wb.Viewport",
      "properties": {
        "cid": "viewport1",
        "layout": "middle"
      },
      "_expanded": true,
      "items": [
        {
          "_icon": "panel",
          "text": "panel1",
          "cls": "Wb.Panel",
          "properties": {
            "cid": "panel1",
            "layout": "vcenter",
            "padding": "20"
          },
          "_expanded": true,
          "items": [
            {
              "_icon": "button",
              "text": "button1",
              "cls": "Wb.Button",
              "properties": {
                "cid": "button1",
                "text": "打开新版客户填报"
              },
              "events": {
                "click": "const params = {\n  ORGAN_FLAG: app.data.organ_flag,\n  CLIENT_ID: app.data.client_id,\n  CLIENT_NAME: app.data.client_name,\n  CLIENT_STATUS: app.data.client_status,\n  CLIENT_BELONG: app.data.client_belong,\n  FK_FLAG: app.data.fk_flag,\n  KEY: app.data.key,\n  CUR_USER: app.data.cur_user\n};\nconst query = Object.keys(params)\n  .filter(key => params[key] !== undefined && params[key] !== null)\n  .map(key => encodeURIComponent(key) + '=' + encodeURIComponent(params[key]))\n  .join('&');\nconst url = 'wb/ks/index.html#/aml/client_add' + (query ? '?' + query : '');\nconst tab = Globals.WbMainTab;\nif (!tab) {\n  window.open(url, '_blank');\n  return;\n}\nconst card = tab.insertAfter({ icon: 'module', title: '填写客户信息', path: ':', layout: 'fit', ksV10Page: true }, tab.activeCard);\ncard.el.innerHTML = '<iframe class=\"w-iframe\"></iframe>';\ncard.el.firstChild.src = url;\ncard.show();"
              },
              "_expanded": true
            }
          ]
        }
      ]
    }
  ]
}
