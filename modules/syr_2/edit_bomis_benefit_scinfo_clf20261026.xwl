{
  "title": "修改bomis受益人信息",
  "icon": "",
  "img": "",
  "tags": "",
  "hideInMenu": "true",
  "text": "module",
  "cls": "Wb.Module",
  "properties": {
    "cid": "module",
    "serverScript": "var benefit_scinfo = Wb.getObject('benefit_scinfo') || {};\nvar client_id = Wb.get('client_id') || '';\nlet conn;\n\nvar rs = {\n  O_RETURN_CODE: 0,\n  O_RETURN_MSG: ''\n};\n\nif (!benefit_scinfo || benefit_scinfo === {} || !benefit_scinfo.related_id) {\n  rs.O_RETURN_CODE = -1;\n  rs.O_RETURN_MSG = '受益人数据不能为空，请重填';\n}\nif (client_id === '') {\n  rs.O_RETURN_CODE = -1;\n  rs.O_RETURN_MSG = '客户号不能为空，请重填';\n}\n\nif (rs.O_RETURN_CODE === -1) { Wb.send(rs); }\n\nvar sqlData = [];\nsqlData.push(benefit_scinfo);\nsqlData.forEach(function (item) {\n  item.client_id = client_id;\n  function joinMulti(val) {\n    if (val === '' || val == null) {\n      return '';\n    }\n    if (Array.isArray(val)) {\n      return val.join(',');\n    }\n    return String(val);\n  }\n  item.bnf_type = joinMulti(item.bnf_type);\n  item.actctrltype = joinMulti(item.actctrltype);\n  item.seniormgrpos = joinMulti(item.seniormgrpos);\n  item.seniormgrposcn = joinMulti(item.seniormgrposcn);\n  item.related_type = '5';\n  item.data_status = item.data_status || '0';\n  if (item.bnf_type.indexOf('NI') >= 0) {\n    item.seniormgrpos = '10';\n  }\n});\n\nvar updateBody = `\nset client_id = {?client_id?},\nrelated_type = '5',\norgan_flag = {?organ_flag?},\nrelated_name = {?related_name?},\nnationality = {?nationality?},\nid_type = {?id_type?},\nid_no = {?id_no?},\nid_begindate = {?id_begindate?},\nid_enddate = {?id_enddate?},\nbirthday = {?birthday?},\nshareholding_ratio = {?shareholding_ratio?},\nbeneficiary = {?beneficiary?},\naddress = {?address?},\nis_government_dept = {?is_government_dept?},\nobject_id = {?object_id?},\ncreate_user = {?create_user?},\ncreate_time = {?create_time?},\nupdate_user = {?update_user?},\nupdate_time = {?update_time?},\nrelated_key = {?related_key?},\ndata_status = {?data_status?},\ngender = {?gender?},\nmobno1 = {?mobno1?},\nmobno2 = {?mobno2?},\nactctrl = {?actctrl?},\nacthdrat = {?acthdrat?},\nshareratiostartdate = {?shareratiostartdate?},\nshareratioenddate = {?shareratioenddate?},\nactctrlcpny = {?actctrlcpny?},\nactctrltype = {?actctrltype?},\nobtainactdate = {?obtainactdate?},\nterminationactdate = {?terminationactdate?},\nactotherforms = {?actotherforms?},\nactconuppermarket = {?actconuppermarket?},\nactconupperentname = {?actconupperentname?},\nactconuniscid = {?actconuniscid?},\npribenfit = {?pribenfit?},\nactownerprofitratio = {?actownerprofitratio?},\nprofitratiostartdate = {?profitratiostartdate?},\nprofitratioenddate = {?profitratioenddate?},\nactownerprofitratiovote = {?actownerprofitratiovote?},\nprofitratiovotestartdate = {?profitratiovotestartdate?},\nprofitratiovoteenddate = {?profitratiovoteenddate?},\nseniormgr = {?seniormgr?},\nseniormgrpos = {?seniormgrpos?},\nactdailymgmtpostother = {?actdailymgmtpostother?},\nseniormgrcn = {?seniormgrcn?},\nseniormgrposcn = {?seniormgrposcn?},\nownerrightmgmtpostother = {?ownerrightmgmtpostother?},\nbnf_type = {?bnf_type?},\nbo_type = {?bo_type?},\ncompany_type = {?company_type?},\nfull_info_flag = {?full_info_flag?}\nwhere client_id = {?client_id?} and related_id = {?related_id?} and related_type = '5'\n`;\n\nvar updateTmpSql = 'update thjs.T_TH_RELAT_INFO_tmp ' + updateBody;\nvar updateFormalSql = 'update thjs.T_TH_RELAT_INFO ' + updateBody;\n\ntry {\n  conn = Wb.getConn();\n\n  Wb.sql({\n    sql: updateTmpSql,\n    params: sqlData,\n    trans: true,\n    commit: false\n  });\n\n  Wb.sql({\n    sql: updateFormalSql,\n    params: sqlData,\n    trans: true,\n    commit: false\n  });\n\n  conn.commit();\n  rs.O_RETURN_CODE = 0;\n  rs.O_RETURN_MSG = '执行成功';\n} catch (e) {\n  rs.O_RETURN_CODE = -1;\n  rs.O_RETURN_MSG = '保存失败：' + e;\n  conn.rollback();\n} finally {\n  conn.close();\n  Wb.send(rs);\n}"
  },
  "_icon": "module",
  "items": []
}