{
  "title": "React应用模块权限查询",
  "icon": "",
  "img": "",
  "hideInMenu": "true",
  "text": "module",
  "cls": "Wb.Module",
  "properties": {
    "cid": "module",
    "loginRequired": "false",
    "remark": "返回当前登录会话的模块权限快照，供React页面和按钮共享；不接收外部用户或角色参数，不执行业务操作。",
    "serverScript": "const loggedIn = !!Wb.userid;\nconst roles = loggedIn ? (Wb.roles || []) : [];\nconst isAdmin = roles.includes('admin');\nlet permissions = [];\nif (roles.length > 0 && !isAdmin) {\n  const sqlMap = Wb.Query.getArraySql(roles, 'varchar');\n  permissions = Wb.getAllRows({\n    sql: 'select distinct module_path from wb_perm where role_id in (' + sqlMap.sql + ')',\n    params: sqlMap.params\n  }).pluck('module_path');\n}\nWb.send({\n  loggedIn,\n  isAdmin,\n  permissions,\n  loginUrl: Wb.getConfig('sys.session.loginPage')\n});"
  }
}
