{
  "title": "客户信息提交合规审核（IBCM001 第 3 版）",
  "icon": "",
  "img": "",
  "tags": "",
  "hideInMenu": "false",
  "text": "module",
  "cls": "Wb.Module",
  "properties": {
    "cid": "module",
    "serverScript": "function text(value) {\n  return value == null ? '' : String(value).trim();\n}\n\nfunction failure(message, verId) {\n  return { O_RETURN_CODE: -1, O_RETURN_MSG: message, DRAFT_SAVED: !!verId, VER_ID: verId || '' };\n}\n\nvar batchList = Wb.getObject('batchList') || [];\nvar missingBenefitBase = batchList.some(function (item) {\n  var role = item.RELATED_TYPE !== undefined ? item.RELATED_TYPE : item.related_type;\n  if (String(role) !== '5') { return false; }\n  var companyType = item.COMPANY_TYPE !== undefined ? item.COMPANY_TYPE : item.company_type;\n  var boType = item.BO_TYPE !== undefined ? item.BO_TYPE : item.bo_type;\n  return !String(companyType == null ? '' : companyType).trim() ||\n    !String(boType == null ? '' : boType).trim();\n});\n\nvar SAVE_SQL = \"{call thjs.p_th_client_info_dft_s({?CLIENT_ID?},{?CLIENT_NAME?},{?ORGAN_FLAG?},{?ID_TYPE?},{?ID_NO?},{?ID_BEGINDATE?},{?ID_ENDDATE?},{?CLIENT_BELONG?},{?NATIONALITY?},{?BIRTHDAY?},{?OFFICE_ADDRESS?},\\n{?PROVINCE?},{?CITY?},{?DISTRICT?},{?REGISTER_COUNTRY?},{?REGISTER_MONEY_TYPE?},{?REGISTER_FUND?},{?INDUSTRY_TYPE?},{?TEL?},{?SETUP_DATE?},{?BUSI_SCOPE?},{?IS_OBJECT_REPORT?},{?ASSOCIATED_DATE?},{?REMARK?},{?CREATE_USER?},\\n{?CREATE_TIME?},{?UPDATE_USER?},{?UPDATE_TIME?},{?IS_SPECIAL?},{?CLIENT_TYPE?},{?CLIENT_TYPE_OTHER?},{?SPECIAL_MATTERS?},{?MISSING_INFORMATION?},{?MISSING_DRAFT?},{?SPECIAL_MATTERS_OTHER?},\\n{?SPECIAL_REASON?},{?COMPLETED_CDD?},{?LOW_RISK_EXPLANATION?},{?TAKE_MEASURES?},{?COMMUNICATION_RECORDS?},{?AGREE_RECORDS?},{?OTHER_RECORDS?},{?INDUSTRY_TYPE1?},{?WORK_TYPE?},{?CLIENT_STATUS?},{?DATA_STATUS?},\\n{?RELATED_PROJ?},{?IF_RISK_CLIENT?},{?RISK_LIST_TYPE?},{?PROBLEM_DESC?},{?GRADE_VALUE?},{?GENDER?},{?INCOME?},{?PROFESSION_CODE?},{?POSITION?},{?WORK_PLACE?},{?ZIPCODE?},{?FILLIN_DATE?},{?ID_ADDRESS?},{?PROVINCE1?},\\n{?CITY1?},{?DISTRICT1?},{?ADDRESS?},{?PROVINCE2?},{?CITY2?},{?DISTRICT2?},{?IF_RISK_LIST?},{?INDUSTRY_NAME?},{?SAVE_TYPE?},{?BASE_VER_ID?},{?batchList?},{*O_RETURN_MSG*},{*O_RETURN_CODE*})}\";\nvar AUDIT_CANDIDATE_BRANCH = '7000'; // 全链接按 branch_code 查询待办候选人，7000 为联调配置。\nvar SIMULATE_FLOW_SUCCESS = true; // 仅测试联调。改为 false 后恢复 WebBuilder 实际下发流程。\n\nfunction saveDraftForReview(conn, clientId, username) {\n  var baseVerId = text(Wb.get('BASE_VER_ID'));\n  var result = Wb.sql({\n    sql: SAVE_SQL,\n    db: conn,\n    trans: true,\n    commit: false,\n    params: { SAVE_TYPE: 'save', DATA_STATUS: '0', CREATE_USER: username, UPDATE_USER: username }\n  });\n  if (String(result.O_RETURN_CODE) !== '0') {\n    conn.rollback();\n    return { rejection: result.O_RETURN_MSG || '保存送审草稿失败' };\n  }\n\n  // 派单前只保存普通草稿，本次版本号在保存事务内读取。\n  var row = Wb.getRecord({\n    db: conn,\n    contextParams: false,\n    sql: \"select v.ver_id from thjs.t_th_client_dft_ver v \" +\n      \"where v.client_id = {?client_id?} and v.dft_status = '0' and v.create_user = {?username?} \" +\n      \"and nvl(v.base_ver_id, '#') = nvl({?base_ver_id?}, '#') \" +\n      \"and v.ver_no = (select max(x.ver_no) from thjs.t_th_client_dft_ver x where x.client_id = v.client_id)\",\n    params: { client_id: clientId, base_ver_id: baseVerId, username: username }\n  });\n  var verId = row && text(row[0]);\n  if (!verId) throw new Error('未取得本次生成的送审版本号');\n\n  // 先检查绑定列并保存现有的工作室回写参数，确认数据库已就绪后再发待办。\n  Wb.sql({\n    db: conn,\n    contextParams: false,\n    unique: true,\n    sql: 'update thjs.t_th_client_dft_ver set flow_piid = null, callback_key = {?callback_key?}, ' +\n      'callback_user = {?callback_user?} where ver_id = {?ver_id?}',\n    params: { ver_id: verId, callback_key: text(Wb.get('KEY')), callback_user: text(Wb.get('CUR_USER')) }\n  });\n  Wb.sql({\n    db: conn,\n    contextParams: false,\n    sql: 'insert into thjs.t_tmp_exec_log(opt_user,opt_url,opt_params,opt_response) ' +\n      'values({?user_name?},{?opt_url?},{?opt_params?},{?opt_response?})',\n    params: { user_name: username, opt_url: 'p_th_client_info_dft_s',\n      opt_params: text(Wb.get('CLIENT_NAME')) + '客户信息submit',\n      opt_response: 'OP_FLAG:submit,CLIENT_BELONG:' + text(Wb.get('CLIENT_BELONG1')) + ',KEY:' + text(Wb.get('KEY')) }\n  });\n  conn.commit(); // 待办可打开前，必须已经能读取这版快照。\n  return { verId: verId };\n}\n\nfunction startFlow(flowUrl, clientId, userId, username) {\n  var clientName = text(Wb.get('CLIENT_NAME'));\n  var payload = {\n    todoTitle: clientName + ' 反洗钱客户填报审核',\n    sysGuid: 'IBCM',\n    flowCode: 'IBCM001',\n    flowVer: '3',\n    templateName: clientName + ' 反洗钱客户填报审核',\n    nodeCode: 'draft',\n    applyTable: 'T_TH_CLIENT_FLOW',\n    candidates: AUDIT_CANDIDATE_BRANCH,\n    formData: JSON.stringify({\n      CLIENT_ID: clientId,\n      CLIENT_NAME: clientName,\n      ORGAN_FLAG: text(Wb.get('ORGAN_FLAG')),\n      CLIENT_BELONG: text(Wb.get('CLIENT_BELONG')),\n      CLIENT_STATUS: text(Wb.get('CLIENT_STATUS')) || '0'\n    })\n  };\n  var response = Packages.cn.hutool.http.HttpUtil.createPost(flowUrl)\n    .header('Content-Type', 'application/json;charset=UTF-8')\n    .header('x-flow-systemId', 'IBCM')\n    .header('x-userId', userId)\n    .header('x-userName', username)\n    .timeout(15000)\n    .body(JSON.stringify(payload))\n    .execute();\n  try {\n    if (!response.isOk()) throw new Error('全链接 HTTP ' + response.getStatus());\n    var result = Wb.decode(String(response.body()));\n    if (!result || result.code == null || text(result.code) === '') throw new Error('全链接没有返回业务状态');\n    if (String(result.code) !== '0') return { rejection: text(result.msg || result.message) || '全链接拒绝发起流程' };\n    var data = result.data || result.Data || {};\n    if (typeof data === 'string') data = Wb.decode(data);\n    var info = data.instFlowBase || data;\n    var piid = text(info.piid || info.PIID || result.piid || result.PIID);\n    return { piid: piid };\n  } finally {\n    response.close();\n  }\n}\n\nfunction submitClient() {\n  var username = text(Wb.get('sys.username'));\n  var userId = text(Wb.get('sys.userid'));\n  var clientId = text(Wb.get('CLIENT_ID'));\n  if (!username || !userId) return failure('请重新登录后再提交审核');\n  if (!clientId || !text(Wb.get('CLIENT_NAME'))) return failure('客户号和客户名称不能为空');\n  if (missingBenefitBase) return failure('请清除浏览器缓存后再进行尝试');\n\n  var flowUrl = 'http://10.106.2.92:8094/auto/submit';\n\n  var conn = Wb.getConn();\n  var verId = '';\n  var piid = '';\n  var flowStarted = false;\n  try {\n    var saved = saveDraftForReview(conn, clientId, username);\n    if (saved.rejection) return failure(saved.rejection);\n    verId = saved.verId;\n\n    var flow = SIMULATE_FLOW_SUCCESS ? { piid: '' } : startFlow(flowUrl, clientId, userId, username);\n    if (flow.rejection) {\n      return failure('待办发起失败，资料已保存为草稿：' + flow.rejection, verId);\n    }\n\n    flowStarted = true;\n    piid = flow.piid;\n    // 全链接确认派单成功才进入待审核；成功响应可能没有实例号。\n    Wb.sql({\n      db: conn, contextParams: false, unique: true, commit: true,\n      sql: \"update thjs.t_th_client_dft_ver set dft_status = '1', save_type = 'submit', \" +\n        \"submit_user = {?submit_user?}, submit_time = sysdate, flow_piid = {?varchar|piid?} \" +\n        \"where ver_id = {?ver_id?} and dft_status = '0' and flow_piid is null\",\n      params: { ver_id: verId, submit_user: username, piid: piid || null }\n    });\n    if (SIMULATE_FLOW_SUCCESS) {\n      return {\n        O_RETURN_CODE: 0, O_RETURN_MSG: '已模拟派单成功并保存待审核草稿，待办请通过 Postman 手动下发。',\n        DRAFT_SAVED: true, VER_ID: verId, PIID: '', FLOW_STARTED: true, FLOW_SIMULATED: true\n      };\n    }\n    if (!piid) {\n      return { ...failure('待办已发出，但全链接未返回流程实例号，送审版本尚未绑定。请勿重复提交。', verId), FLOW_STARTED: true };\n    }\n    return { O_RETURN_CODE: 0, O_RETURN_MSG: '已提交合规审核', DRAFT_SAVED: true, VER_ID: verId, PIID: piid };\n  } catch (e) {\n    conn.rollback();\n    var logMessage = '反洗钱 V3 送审失败 clientId=' + clientId + ', verId=' + verId + ', piid=' + piid + ': ' + String(e);\n    try {\n      Wb.recordErrorx(logMessage, 'syr2-dft-submit');\n    } catch (logError) {\n      Wb.recordError(logMessage + ' (系统日志写入失败: ' + String(logError) + ')');\n    }\n    // 未收到派单确认时保留普通草稿，超时仍需先核对全链接是否已创建待办。\n    if (flowStarted) {\n      if (SIMULATE_FLOW_SUCCESS) return failure('模拟派单后更新待审状态失败，请联系管理员核对。', verId);\n      return { ...failure('待办已发出，但更新待审状态失败，请联系管理员核对。请勿重复提交。', verId), FLOW_STARTED: true };\n    }\n    if (verId) return failure('资料已保存为草稿，暂未确认派单结果，请先核对全链接待办。', verId);\n    return failure('保存送审草稿失败，请联系管理员');\n  } finally {\n    conn.close();\n  }\n}\n\nWb.send(submitClient());\n"
  },
  "_icon": "module"
}
