{
  "title": "保存受益人基础信息",
  "icon": "",
  "img": "",
  "tags": "",
  "hideInMenu": "true",
  "text": "module",
  "cls": "Wb.Module",
  "properties": {
    "cid": "module",
    "serverScript": "var clientId = Wb.get('client_id');\nvar action = Wb.get('action') || 'save';\nvar companyType = Wb.get('company_type');\nvar fullInfoFlag = Wb.get('full_info_flag');\nvar conn;\nvar rs = { O_RETURN_CODE: 0, O_RETURN_MSG: '', PERSISTED: false, BASE_INFO: null };\n\nfunction baseText(value) {\n  return value == null ? '' : String(value).trim();\n}\n\nclientId = baseText(clientId);\ncompanyType = baseText(companyType);\nfullInfoFlag = baseText(fullInfoFlag);\n\ntry {\n  if (!clientId) { throw new Error('客户号不能为空'); }\n  if (action === 'query') {\n    rs.BASE_INFO = readBenefitBaseInfo();\n  } else if (action === 'delete' || action === 'save') {\n    conn = Wb.getConn();\n    if (action === 'delete') {\n      deleteBenefitBaseInfo();\n    } else {\n      saveBenefitBaseInfo();\n    }\n    conn.commit();\n    rs.PERSISTED = true;\n  } else {\n    throw new Error('不支持的基础信息操作');\n  }\n} catch (e) {\n  rs.O_RETURN_CODE = -1;\n  rs.O_RETURN_MSG = '基础信息操作失败：' + (e.message || e);\n  if (conn) { conn.rollback(); }\n} finally {\n  if (conn) { conn.close(); }\n  Wb.send(rs);\n}\n\nfunction readBenefitBaseInfo() {\n  return Wb.getRowx({\n    sql: `\nselect client_id, company_type, bo_type, full_info_flag\n  from thjs.T_TH_BENEFIT_BASE_INFO\n where client_id = {?client_id?}\n`,\n    params: { client_id: clientId }\n  }).items[0] || null;\n}\n\nfunction readBenefitRows() {\n  return Wb.getRowx({\n    sql: `\nselect company_type, bo_type, full_info_flag\n  from thjs.T_TH_RELAT_INFO\n where client_id = {?client_id?} and related_type = '5'\nunion all\nselect company_type, bo_type, full_info_flag\n  from thjs.T_TH_RELAT_INFO_TMP\n where client_id = {?client_id?} and related_type = '5'\n`,\n    params: { client_id: clientId }\n  }).items;\n}\n\nfunction deleteBenefitBaseInfo() {\n  if (readBenefitRows().length > 0) {\n    throw new Error('请先删除当前所有受益人，才能删除基础信息');\n  }\n  Wb.sql({\n    sql: 'delete from thjs.T_TH_BENEFIT_BASE_INFO where client_id = {?client_id?}',\n    params: { client_id: clientId },\n    trans: true,\n    commit: false\n  });\n  rs.O_RETURN_MSG = '受益人基础信息已删除';\n}\n\nfunction saveBenefitBaseInfo() {\n  if (!companyType) { throw new Error('请选择企业性质'); }\n  if (fullInfoFlag !== '' && fullInfoFlag !== '01' && fullInfoFlag !== '02') {\n    throw new Error('客户信息披露情况不正确');\n  }\n\n  var boType = ['1', '2', '3', '4', '5', '6'].indexOf(companyType.charAt(0)) >= 0 ? '1' : '2';\n  var params = {\n    client_id: clientId,\n    company_type: companyType,\n    bo_type: boType,\n    full_info_flag: fullInfoFlag\n  };\n\n  var savedBase = readBenefitBaseInfo();\n  var rows = readBenefitRows();\n  if (rows.length > 0) {\n    if (savedBase && (baseText(savedBase.company_type) !== companyType ||\n        baseText(savedBase.bo_type) !== boType || baseText(savedBase.full_info_flag) !== fullInfoFlag)) {\n      throw new Error('如需编辑基础信息，请先删除当前所有受益人');\n    }\n    if (!savedBase || rows.some(function (row) {\n      return !baseText(row.company_type) || !baseText(row.bo_type);\n    })) {\n      updateBenefitRows(params);\n    }\n  }\n\n  Wb.sql({\n    sql: `\nmerge into thjs.T_TH_BENEFIT_BASE_INFO b\nusing (select {?client_id?} as client_id from dual) s\n   on (b.client_id = s.client_id)\n when matched then update set\n      b.company_type = {?company_type?},\n      b.bo_type = {?bo_type?},\n      b.full_info_flag = {?full_info_flag?}\n when not matched then insert (client_id, company_type, bo_type, full_info_flag)\n      values (s.client_id, {?company_type?}, {?bo_type?}, {?full_info_flag?})\n`,\n    params: params,\n    trans: true,\n    commit: false\n  });\n  rs.BASE_INFO = params;\n  rs.O_RETURN_MSG = '受益人基础信息已保存';\n}\n\nfunction updateBenefitRows(params) {\n  var updateBody = `\n   set company_type = {?company_type?},\n       bo_type = {?bo_type?},\n       full_info_flag = {?full_info_flag?}\n where client_id = {?client_id?} and related_type = '5'\n`;\n  Wb.sql({\n    sql: 'update thjs.T_TH_RELAT_INFO ' + updateBody,\n    params: params,\n    trans: true,\n    commit: false\n  });\n  Wb.sql({\n    sql: 'update thjs.T_TH_RELAT_INFO_TMP ' + updateBody,\n    params: params,\n    trans: true,\n    commit: false\n  });\n}\n"
  },
  "_icon": "module",
  "items": []
}
