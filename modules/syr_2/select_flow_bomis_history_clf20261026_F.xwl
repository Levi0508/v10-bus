{
  "title": "查询流程维度BOMIS核验历史",
  "icon": "",
  "img": "",
  "tags": "",
  "hideInMenu": "true",
  "text": "module",
  "cls": "Wb.Module",
  "properties": {
    "cid": "module",
    "serverScript": "var client_id = Wb.get('client_id');\n\nvar sql = `\n  select t.*\n  from thjs.th_bomis_response t\n  where t.client_id = {?client_id?}\n`;\n\n// 未绑定审核批次的核验均可回显，不限制流程号。\nsql += ` and (t.audit_id is null or trim(t.audit_id) is null)`;\n\nsql += ` order by t.op_time desc`;\n\ntry {\n  Wb.send(Wb.getRowx({ sql: sql }));\n} catch (e) {\n  try {\n    var sql2 = `\n      select t.*\n      from thjs.th_bomis_response t\n      where t.client_id = {?client_id?}\n        and (t.audit_id is null or trim(t.audit_id) is null)\n      order by t.op_time desc\n    `;\n    Wb.send(Wb.getRowx({ sql: sql2 }));\n  } catch (e2) {\n    var fallbackSql = `\n      select t.*\n      from thjs.th_bomis_response t\n      where t.client_id = {?client_id?}\n        and (t.audit_id is null or trim(t.audit_id) is null)\n      order by t.op_time desc\n    `;\n    Wb.send(Wb.getRowx({ sql: fallbackSql }));\n  }\n}"
  },
  "_icon": "module",
  "items": []
}
