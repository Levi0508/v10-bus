{
  "title": "更新客户信息（编辑页面）",
  "icon": "",
  "img": "",
  "tags": "",
  "hideInMenu": "true",
  "text": "module",
  "cls": "Wb.Module",
  "properties": {
    "cid": "module",
    "serverScript": "let client_name = Wb.get('CLIENT_NAME') || '';\nlet op_flag = Wb.get('OP_FLAG') || '';\nlet client_belong1 = Wb.get('CLIENT_BELONG1') || '';\nlet key = Wb.get('KEY') || '';\nlet username = Wb.get('sys.username');\n\nlet params = 'OP_FLAG:' + op_flag + ',CLIENT_BELONG:' + client_belong1 + ',KEY:' + key;\n\nlet obj = Wb.sql(`{call thjs.p_th_client_info_s_lxy({?CLIENT_ID?},{?CLIENT_NAME?},{?ORGAN_FLAG?},{?ID_TYPE?},{?ID_NO?},{?ID_BEGINDATE?},{?ID_ENDDATE?},{?CLIENT_BELONG?},{?NATIONALITY?},{?BIRTHDAY?},{?OFFICE_ADDRESS?},\n{?PROVINCE?},{?CITY?},{?DISTRICT?},{?REGISTER_COUNTRY?},{?REGISTER_MONEY_TYPE?},{?REGISTER_FUND?},{?INDUSTRY_TYPE?},{?TEL?},{?SETUP_DATE?},{?BUSI_SCOPE?},{?IS_OBJECT_REPORT?},{?ASSOCIATED_DATE?},{?REMARK?},{?CREATE_USER?},\n{?CREATE_TIME?},{?UPDATE_USER?},{?UPDATE_TIME?},{?IS_SPECIAL?},{?CLIENT_TYPE?},{?CLIENT_TYPE_OTHER?},{?SPECIAL_MATTERS?},{?MISSING_INFORMATION?},{?MISSING_DRAFT?},{?SPECIAL_MATTERS_OTHER?},\n{?SPECIAL_REASON?},{?COMPLETED_CDD?},{?LOW_RISK_EXPLANATION?},{?TAKE_MEASURES?},{?COMMUNICATION_RECORDS?},{?AGREE_RECORDS?},{?OTHER_RECORDS?},{?INDUSTRY_TYPE1?},{?WORK_TYPE?},{?CLIENT_STATUS?},{?DATA_STATUS?},\n{?RELATED_PROJ?},{?IF_RISK_CLIENT?},{?RISK_LIST_TYPE?},{?PROBLEM_DESC?},{?GRADE_VALUE?},{?GENDER?},{?INCOME?},{?PROFESSION_CODE?},{?POSITION?},{?WORK_PLACE?},{?ZIPCODE?},{?FILLIN_DATE?},{?ID_ADDRESS?},{?PROVINCE1?},\n{?CITY1?},{?DISTRICT1?},{?ADDRESS?},{?PROVINCE2?},{?CITY2?},{?DISTRICT2?},{?IF_RISK_LIST?},{?INDUSTRY_NAME?},{*O_RETURN_MSG*},{*O_RETURN_CODE*})}`);\n\n\n\nlet log = Wb.sql({ sql: `insert into thjs.t_tmp_exec_log(opt_user,opt_url,opt_params,opt_response)values({?opt_user?},{?opt_url?},{?opt_params?},{?opt_response?})`, contextParams: false, params: { opt_user: username, opt_url: 'p_th_client_info_s', opt_params: client_name + '客户信息'+op_flag, opt_response: params } });\n\nWb.send(obj);\n\n"
  },
  "_icon": "module",
  "items": []
}