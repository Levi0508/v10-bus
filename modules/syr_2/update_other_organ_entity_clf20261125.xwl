{"title":"其他关联人更新","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"let batchList = Wb.decode(Wb.get('batchList'));\nif (batchList) {\n  batchList = batchList.filter(row => String(row.RELATED_TYPE) !== '5');\n}\nlet rs = {};\nlet msg = '';\n\nif (!batchList) {\n  rs.O_RETURN_CODE = -1;\n  rs.O_RETURN_MSG = \"没有获取到参数\";\n} else if (batchList && batchList.length == 0) {\n  rs.O_RETURN_CODE = -1;\n  rs.O_RETURN_MSG = \"获取到的参数为空\";\n} else if (!batchList[0].CLIENT_ID) {\n  rs.O_RETURN_CODE = -1;\n  rs.O_RETURN_MSG = \"客户号为空\";\n} else if (!batchList[0].RELATED_NAME) {\n  rs.O_RETURN_CODE = -1;\n  rs.O_RETURN_MSG = \"关联人名称为空\";\n} else {\n  \n  let username = Wb.get('sys.username');\n  let client_id = batchList[0].CLIENT_ID;\n  let related_name = batchList[0].RELATED_NAME;\n  let batch_length = batchList.length;\n  let params = '客户号client_id：' + client_id + ',关联人名称related_name：' + related_name + ',同名关联人数：' + batch_length;\n\n  let log = Wb.sql({ sql: `insert into thjs.t_tmp_exec_log(opt_user,opt_url,opt_params,opt_response)values({?opt_user?},{?opt_url?},{?opt_params?},{?opt_response?})`, contextParams: false, params: { opt_user: username, opt_url: 'update_organ_entity', opt_params: params, opt_response: '备注：在客户信息编辑页面执行了编辑关联人操作' } });\n\n  let conn = Wb.getConn();\n\n  try {\n    syncBeneficiaryPersonalInfo(batchList);\n    let sql1 = `delete from thjs.t_th_relat_info where client_id = {?CLIENT_ID?} and related_name = {?RELATED_NAME?} and organ_flag = {?ORGAN_FLAG?} and (related_type is null or related_type <> '5')`;// 正式表\n    let sql2 = `delete from thjs.t_th_relat_info_tmp where client_id = {?CLIENT_ID?} and related_name = {?RELATED_NAME?} and organ_flag = {?ORGAN_FLAG?} and (related_type is null or related_type <> '5')`;// 临时表\n\n    // 1.删除同一关联人信息\n    Wb.sql({\n      sql: sql1,\n      contextParams: false,\n      params: {\n        CLIENT_ID: batchList[0].CLIENT_ID,\n        RELATED_NAME: batchList[0].RELATED_NAME,\n        ORGAN_FLAG: batchList[0].ORGAN_FLAG,\n      },\n      trans: true,\n      commit: false\n    });\n\n    Wb.sql({\n      sql: sql2,\n      contextParams: false,\n      params: {\n        CLIENT_ID: batchList[0].CLIENT_ID,\n        RELATED_NAME: batchList[0].RELATED_NAME,\n        ORGAN_FLAG: batchList[0].ORGAN_FLAG,\n      },\n      trans: true,\n      commit: false\n    });\n\n    let sql3 = `INSERT INTO thjs.t_th_relat_info_tmp (CLIENT_ID, RELATED_TYPE, RELATED_NAME, ORGAN_FLAG, ID_TYPE, ID_NO, ID_BEGINDATE, ID_ENDDATE,\n      NATIONALITY, BIRTHDAY, IS_GOVERNMENT_DEPT, BENEFICIARY, SHAREHOLDING_RATIO, ADDRESS, OBJECT_ID, CREATE_USER, CREATE_TIME, UPDATE_USER, UPDATE_TIME, DATA_STATUS, \n      GENDER, MOBNO1, MOBNO2, ACTCTRL, ACTHDRAT, SHARERATIOSTARTDATE, SHARERATIOENDDATE, ACTCTRLCPNY, ACTCTRLTYPE, OBTAINACTDATE, TERMINATIONACTDATE, ACTOTHERFORMS, \n      ACTCONUPPERMARKET, ACTCONUPPERENTNAME, ACTCONUNISCID, PRIBENFIT, ACTOWNERPROFITRATIO, PROFITRATIOSTARTDATE, PROFITRATIOENDDATE, ACTOWNERPROFITRATIOVOTE, \n      PROFITRATIOVOTESTARTDATE, PROFITRATIOVOTEENDDATE, SENIORMGR, SENIORMGRPOS, ACTDAILYMGMTPOSTOTHER, SENIORMGRCN, SENIORMGRPOSCN, OWNERRIGHTMGMTPOSTOTHER, BNF_TYPE\n      ) VALUES (\n      {?CLIENT_ID?}, {?RELATED_TYPE?}, {?RELATED_NAME?}, {?ORGAN_FLAG?}, {?ID_TYPE?}, {?ID_NO?}, {?ID_BEGINDATE?}, {?ID_ENDDATE?}, \n      {?NATIONALITY?}, {?BIRTHDAY?}, {?IS_GOVERNMENT_DEPT?}, {?BENEFICIARY?}, {?SHAREHOLDING_RATIO?}, {?ADDRESS?}, {?OBJECT_ID?}, {?CREATE_USER?}, sysdate, {?UPDATE_USER?}, sysdate, '0',\n      {?GENDER?}, {?MOBNO1?}, {?MOBNO2?}, {?ACTCTRL?}, {?ACTHDRAT?}, {?SHARERATIOSTARTDATE?}, {?SHARERATIOENDDATE?}, {?ACTCTRLCPNY?}, {?ACTCTRLTYPE?}, {?OBTAINACTDATE?}, {?TERMINATIONACTDATE?}, {?ACTOTHERFORMS?}, \n      {?ACTCONUPPERMARKET?}, {?ACTCONUPPERENTNAME?}, {?ACTCONUNISCID?}, {?PRIBENFIT?}, {?ACTOWNERPROFITRATIO?}, {?PROFITRATIOSTARTDATE?}, {?PROFITRATIOENDDATE?}, {?ACTOWNERPROFITRATIOVOTE?}, \n      {?PROFITRATIOVOTESTARTDATE?}, {?PROFITRATIOVOTEENDDATE?}, {?SENIORMGR?}, {?SENIORMGRPOS?}, {?ACTDAILYMGMTPOSTOTHER?}, {?SENIORMGRCN?}, {?SENIORMGRPOSCN?}, {?OWNERRIGHTMGMTPOSTOTHER?}, {?BNF_TYPE?});`;\n\n    // 2.重新往临时表插入\n    for (let i = 0; i < batchList.length; i++) {\n      Wb.sql({\n        sql: sql3,\n        contextParams: false,\n        params: {\n          CLIENT_ID: batchList[i].CLIENT_ID,\n          RELATED_TYPE: batchList[i].RELATED_TYPE,\n          RELATED_NAME: batchList[i].RELATED_NAME,\n          ORGAN_FLAG: batchList[i].ORGAN_FLAG,\n          ID_TYPE: batchList[i].ID_TYPE,\n          ID_NO: batchList[i].ID_NO,\n          ID_BEGINDATE: batchList[i].ID_BEGINDATE,\n          ID_ENDDATE: batchList[i].ID_ENDDATE,\n          NATIONALITY: batchList[i].NATIONALITY,\n          BIRTHDAY: batchList[i].BIRTHDAY,\n          IS_GOVERNMENT_DEPT: batchList[i].IS_GOVERNMENT_DEPT,\n          BENEFICIARY: batchList[i].BENEFICIARY,\n          SHAREHOLDING_RATIO: batchList[i].SHAREHOLDING_RATIO,\n          ADDRESS: batchList[i].ADDRESS,\n          OBJECT_ID: batchList[i].OBJECT_ID,\n          CREATE_USER: batchList[i].CREATE_USER,\n          UPDATE_USER: batchList[i].UPDATE_USER,\n          GENDER: batchList[i].GENDER || '',\n          MOBNO1: batchList[i].MOBNO1 || '',\n          MOBNO2: batchList[i].MOBNO2 || '',\n          ACTCTRL: batchList[i].ACTCTRL || '',\n          ACTHDRAT: batchList[i].ACTHDRAT || '',\n          BNF_TYPE: batchList[i].BNF_TYPE || '',\n          SHARERATIOSTARTDATE: batchList[i].SHARERATIOSTARTDATE || '',\n          SHARERATIOENDDATE: batchList[i].SHARERATIOENDDATE || '',\n          ACTCTRLCPNY: batchList[i].ACTCTRLCPNY || '',\n          ACTCTRLTYPE: batchList[i].ACTCTRLTYPE || '',\n          OBTAINACTDATE: batchList[i].OBTAINACTDATE || '',\n          TERMINATIONACTDATE: batchList[i].TERMINATIONACTDATE || '',\n          ACTOTHERFORMS: batchList[i].ACTOTHERFORMS || '',\n          ACTCONUPPERMARKET: batchList[i].ACTCONUPPERMARKET || '',\n          ACTCONUPPERENTNAME: batchList[i].ACTCONUPPERENTNAME || '',\n          ACTCONUNISCID: batchList[i].ACTCONUNISCID || '',\n          ACTOWNERPROFITRATIO: batchList[i].ACTOWNERPROFITRATIO || '',\n          PROFITRATIOSTARTDATE: batchList[i].PROFITRATIOSTARTDATE || '',\n          PROFITRATIOENDDATE: batchList[i].PROFITRATIOENDDATE || '',\n          ACTOWNERPROFITRATIOVOTE: batchList[i].ACTOWNERPROFITRATIOVOTE || '',\n          PROFITRATIOVOTESTARTDATE: batchList[i].PROFITRATIOVOTESTARTDATE || '',\n          PROFITRATIOVOTEENDDATE: batchList[i].PROFITRATIOVOTEENDDATE || '',\n          SENIORMGRPOS: batchList[i].SENIORMGRPOS || '',\n          ACTDAILYMGMTPOSTOTHER: batchList[i].ACTDAILYMGMTPOSTOTHER || '',\n          SENIORMGRPOSCN: batchList[i].SENIORMGRPOSCN || '',\n          OWNERRIGHTMGMTPOSTOTHER: batchList[i].OWNERRIGHTMGMTPOSTOTHER || '',\n        },\n        trans: true,\n        commit: false\n      })\n    }\n\n    conn.commit();\n    rs.O_RETURN_CODE = 0;\n    rs.O_RETURN_MSG = \"执行成功\"\n  } catch (e) {\n    rs.O_RETURN_CODE = -1;\n    rs.O_RETURN_MSG = \"保存失败：\" + e;\n    conn.rollback();\n  } finally {\n    conn.close();\n  }\n}\n\nWb.send(Wb.encode(rs));\n\nfunction syncBeneficiaryPersonalInfo(batch) {\n  const first = batch[0];\n  const sourceRelatedId = Wb.get('SOURCE_RELATED_ID');\n  if (String(first.ORGAN_FLAG) !== '0' || !sourceRelatedId) return;\n\n  const sourceCondition = \" where client_id = {?client_id?} and related_id = {?related_id?} and related_name = {?related_name?} and organ_flag = '0' and related_type in ('1','2','3','4')\";\n  const tables = ['thjs.t_th_relat_info_tmp', 'thjs.t_th_relat_info'];\n  const source = Wb.getRowx({\n    sql: tables.map((table, index) => 'select nationality, birthday, id_type, id_no, id_begindate, id_enddate, mobno1, ' + index + ' as source_order from ' + table + sourceCondition).join(' union all ') + ' order by source_order',\n    params: { client_id: first.CLIENT_ID, related_id: sourceRelatedId, related_name: first.RELATED_NAME },\n    contextParams: false\n  }).items[0];\n  if (!source) return;\n\n  const fields = ['nationality', 'birthday', 'id_type', 'id_no', 'id_begindate', 'id_enddate'];\n  const personalInfo = {};\n  fields.forEach(field => { personalInfo[field] = first[field.toUpperCase()]; });\n  if (String(Wb.get('SYNC_MOBILE')) === '1') {\n    const mobileRow = batch.find(row => ['1', '4'].includes(String(row.RELATED_TYPE)));\n    if (mobileRow) {\n      fields.push('mobno1');\n      personalInfo.mobno1 = mobileRow.MOBNO1;\n    }\n  }\n\n  const changed = fields.filter(field => personalInfo[field] !== undefined && textValue(personalInfo[field]) !== textValue(source[field]));\n  if (!changed.length) return;\n\n  const assignments = changed.map(field => field + ' = {?' + field + '?}').join(', ');\n  const params = { client_id: first.CLIENT_ID, related_name: first.RELATED_NAME };\n  changed.forEach(field => { params[field] = personalInfo[field]; });\n  tables.forEach(table => {\n    Wb.sql({\n      sql: 'update ' + table + ' set ' + assignments + \" where client_id = {?client_id?} and related_name = {?related_name?} and organ_flag = '0' and related_type = '5'\",\n      params: params,\n      contextParams: false,\n      trans: true,\n      commit: false\n    });\n  });\n\n  function textValue(value) {\n    return String(value == null ? '' : value).trim();\n  }\n}"},"_icon":"module"}
