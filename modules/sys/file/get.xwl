{"text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"function main() {\n  let fs = Wb.load('./fs.mjs'), items, path = Params.path, filterName = Params.filterName, filterExt = Params.filterExt;\n\n  items = fs.listFiles(path, Params.type, Params.sort, Wb.getBool('desc'), Wb.getBool('moduleSort'));\n  if (filterName) {\n    let baseFolder = items.find(item => item.text == filterName);\n    if (baseFolder) {\n      baseFolder._expanded = true;\n      items = [baseFolder];\n    } else {\n      Wb.raise(Str.notFound.format(path + filterName));\n    }\n  }\n  if (filterExt) {\n    filterExt = filterExt.splitTrim();\n    items = items.filter(item => {\n      return filterExt.some(ext => item.text.endsWith(ext) || !item._leaf);\n    });\n  }\n  Wb.send(items);\n}\nmain();","remark":"Get files in any path"},"_icon":"module","title":""}