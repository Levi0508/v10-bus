{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","remark":"Get current user data","serverScript":"function main() {\n  const protectedText = Wb.UserUtil.protectedText;\n  let sql;\n\n  sql = `select '${protectedText}' as password, '${protectedText}' as confirm_password, display_name, create_date,\n    login_times, email, mobile_phone, use_lang from wb_user where sid={?sys.userid?}`;\n  Wb.sendDict(sql, 'wb,');\n}\nmain();"},"_icon":"module"}