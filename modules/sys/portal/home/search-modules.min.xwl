{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","remark":"Search module names","serverScript":"function main(){let e=Params.query,t=Wb.load(\"wb/modules/sys/file/fs.mjs\");if(e.startsWith(\"[\")&&e.endsWith(\"]\"))e=e.slice(1,-1);else if(!e.includes(\"*\")&&!e.includes(\"?\"))e=\"*\"+e+\"*\";Wb.send(search(t,Wb.File.moduleFolder.path,e).mixSort(\"text\"))}function search(e,t,i){let s,l=e.listFiles(t,\"home\"),a=[];l.forEach((t=>{s=t.path;if(t._leaf){if(t.text.wildcardMatch(i)||t.path.lastItem(\"/\").wildcardMatch(i)){a.push(Wb.applyWith({},t,[\"text\",\"_icon\",\"_img\",\"path\",\"strTitle\"]))}}else{a.pushAll(search(e,s,i))}}));return a}main();"},"_icon":"module"}