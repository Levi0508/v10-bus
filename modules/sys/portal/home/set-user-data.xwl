{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","remark":"Set current user data","serverScript":"function main() {\n  const protectedText = Wb.UserUtil.protectedText;\n  let session, pwd = Params.password, fields = 'display_name,email,mobile_phone,use_lang';\n\n  if (pwd != protectedText)\n    fields += ',password';\n  Wb.set({\n    $sid: Wb.userid, password: Wb.UserUtil.encryptPassword(pwd)\n  });\n  Wb.sync({ tableName: 'wb_user', update: Params, fields });\n  session = request.getSession(false);\n  session?.setAttribute('sys.dispname', Params.display_name);\n  session?.setAttribute('sys.lang', Params.use_lang);\n}\nmain();"},"_icon":"module"}