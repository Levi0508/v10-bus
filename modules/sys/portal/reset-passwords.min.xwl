{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","remark":"Prompt to reset all users password"},"_icon":"module","_expanded":true,"events":{"initialize":"Wb.make(app,{cname:\"window\",layout:\"grid1\",dialog:true,visible:true,closeAction:\"destroy\",icon:\"key\",title:Str.resetPassword,cid:\"main\",events:{ok(e){if(app.password.value!=app.repassword.value){Wb.tipError(Str.pwdNotSame);app.password.focus();return}Wb.ajax({url:xpath+\"/reset\",comps:app.password,success:e=>{this.close()}})}},items:[{cname:\"displayField\",icon:\"info\",value:Str.resetPwdHint,cid:\"hint\"},{cname:\"text\",password:true,minLength:6,text:Str.password,required:true,cid:\"password\"},{cname:\"text\",password:true,minLength:6,text:Str.confirmPassword,required:true,cid:\"repassword\"}]});"}}