{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"function main(){const e=Wb.load(\"wb/ss/dbe.mjs\");let t=[],s,a,l,i=Wb.decodeBase64(Params.data).toLowerCase(),o=Wb.getConn(Params.db),n,d,f,r=Params.key.toLowerCase(),c=o.schema,u=e.getSchemas(o),m=e.getTables(o,c).concat(e.getTables(o,c,true));d=r.split(\".\");n=d.length;r=d[0];if(n==1){[u,m].forEach((e=>addItems(t,e,r,\"Unit\")));s=getTablesFromSQL(i);s.forEach((s=>{if(s.includes(\".\")){d=s.split(\".\");if(l=u.find((e=>e.text.toLowerCase()==d[0]))){a=l.text;if(l=e.getTables(o,a).concat(e.getTables(o,a,true)).find((e=>e.text.toLowerCase()==d[1]))){addItems(t,e.getColumns(o,a,l.text),null,\"Field\")}}}else if(l=m.find((e=>e.text.toLowerCase()==s))){addItems(t,e.getColumns(o,c,l.text),null,\"Field\")}}))}else{if(l=u.find((e=>e.text.toLowerCase()==r))){a=l.text;[false,true].forEach((s=>addItems(t,e.getTables(o,a,s),null,\"Unit\")))}else{l=m.find((e=>e.text.toLowerCase()==r));if(l){a=c;s=l.text}else{d=i.split(/\\s+|,/).filter((e=>e));d.each(((t,i)=>{if(i>0&&t==r){f=d[i-1];if(f.includes(\".\")){d=f.split(\".\");if(Wb.isAlphaNum(d[0])&&(l=u.find((e=>e.text.toLowerCase()==d[0])))){a=l.text;if(Wb.isAlphaNum(d[1])&&(l=e.getTables(o,a).concat(e.getTables(o,a,true)).find((e=>e.text.toLowerCase()==d[1])))){s=l.text;return false}}}else{l=Wb.isAlphaNum(f)&&m.find((e=>e.text.toLowerCase()==f));if(l){a=c;s=l.text;return false}}}}))}if(s){addItems(t,e.getColumns(o,a,s),null,\"Field\")}}}Wb.send(t)}function addItems(e,t,s,a){let l;t.forEach((t=>{l=t.text;if((!s||l.toLowerCase().includes(s))&&!e.some((e=>e.text==l))){e.push({text:l,cate:a})}}))}function getTablesFromSQL(e){const t=/(?:FROM|JOIN|INTO|UPDATE|DELETE)\\s+([^\\s,\\)]+)/gi;const s=[];let a;while(a=t.exec(e)){s.push(a[1])}return s}main();","remark":"Provide SQL completion items"},"_icon":"module"}