{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"Wb.apply(app, {\n  httppost: function(url, method, params, timeout, contentType) {\n    var conn = (new java.net.URL(url)).openConnection();\n    try {\n      conn.setConnectTimeout(timeout);\n      conn.setReadTimeout(8000);\n      conn.setUseCaches(false);\n      conn.setRequestMethod(method);\n      if (params !== null) {\n        conn.setDoOutput(true);\n        conn.setRequestProperty(\"content-type\", contentType);\n        var os = conn.getOutputStream();\n        try {\n          os.write(params);\n          os.flush();\n        } finally {\n          os.close();\n        }\n      }\n      var bos = new java.io.ByteArrayOutputStream();\n      var is = conn.getInputStream();\n      try {\n        org.apache.commons.io.IOUtils.copy(is, bos);\n      } finally {\n        is.close();\n      }\n      return bos.toByteArray();\n    } finally {\n      conn.disconnect();\n    }\n  }\n});"},"_icon":"module"}