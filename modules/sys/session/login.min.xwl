{"title":"@login","icon":"","img":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","loginRequired":"false","remark":"Login page","serverScript":"Wb.set({title:Wb.getConfig(\"sys.app.title\"),verifyCode:Wb.getConfig(\"sys.session.verifyCode\")});","theme":"true"},"_icon":"module","_expanded":true,"tags":"","events":{"initialize":"Wb.make(app,{cname:\"viewport\",layout:\"middle\",border:false,bodyStyle:\"background-color:#959595;background-image: repeating-linear-gradient(40deg,rgba(0,0,255,0.2) 2px,transparent 2.5px),repeating-linear-gradient(126deg,rgba(255,0,0,0.2) 2px,transparent 2.5px),repeating-linear-gradient(238deg,rgba(0,255,0,0.2) 2px,transparent 2.5px);\",autoScroll:true,cid:\"viewport1\",tbar:{cname:\"toolbar\",padding:true,items:[{cname:\"icon\",icon:\"geejing\",fontSize:\"3em\",cid:\"logoIcon\"},{cname:\"label\",style:\"font-weight: bold; color: #333;\",fontSize:\"2em\",text:\"_$title$_\",cid:\"titleLabel\"}]},bbar:{cname:\"toolbar\",padding:true,justify:\"center\",items:[{cname:\"label\",style:\"color:#555\",fontSize:\".8em\",text:\"Copyright © Geejing, All Rights Reserved.\",cid:\"copyrightLabel\"}]},items:[{cname:\"panel\",style:\"box-shadow:#00000055 0px 2px 10px 5px\",cls:\"w-limit-width\",cid:\"panel1\",events:{ready(e,a){Wb.createLoginPanel(this,(e=>location.reload()),false,_$verifyCode$_)}}}]});app.panel1.setLoginFocus();"}}