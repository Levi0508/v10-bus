{"text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"function setResource(){let{name:e,value:s,type:t}=Params;if(s){if(s.stream instanceof InputStream)s=s.stream;else if(t==\"object\")t=1}else{s=null}Wb.setResource(e,s,app.userid,t)}setResource();","remark":"Set current user resource"},"_icon":"module","icon":"","img":"","tags":"","title":"","hideInMenu":"false"}