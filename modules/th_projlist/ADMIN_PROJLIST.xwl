        {
          "_icon": "grid",
          "text": "grid1",
          "cls": "Wb.Grid",
          "properties": {
            "cid": "grid1",
            "pagingBar": "pageNums",
            "pageSize": "100",
            "full": "true",
            "border": "false",
            "url": "@xpath + '/perm_conf/select'",
            "emptyHint": "true",
            "textSelectable": "true",
            "columnsSortable": "true"
          },
          "_expanded": true,
          "hasDupCid": 0,
          "events": {
            "itemdblclick": "app.reportTask(0);"
          },
          "items": [
            {
              "_icon": "toolbar",
              "text": "tbar",
              "cls": "Wb.Toolbar",
              "properties": {
                "cid": "tbar",
                "gap": "true",
                "layout": "form-compact",
                "isProperty": "true",
                "border": "false"
              },
              "_expanded": false,
              "hasDupCid": 0,
              "items": [
                {
                  "_icon": "button",
                  "text": "auditBtn",
                  "cls": "Wb.Button",
                  "properties": {
                    "cid": "auditBtn",
                    "text": "清单审核",
                    "type": "primary",
                    "roundBorder": "true"
                  },
                  "events": {
                    "click": "// 点击【清单审核】按钮\nvar rec = app.grid1.selection;\nif (!rec) {\n  Wb.info(\"请先选择一条记录！\");\n  return;\n}\nrec = rec.data;\nconsole.log(\"---------reeccccc\", rec);\n\nWb.open({\n  url: 'm?xwl=info_query/projlist/projlist_form_container',\n  params: {\n    piid2: 'beforedraft',  // 手动发起审核页面还未生成流程id，此处参数仅作为有值的判断控制显隐展示\n    projid: rec.projid,\n    nodeCode: 'hgrysh',// hgrysh-合规人员审核  xmfzryz=项目负责人阅知\n    staff_id: rec.staff_id,\n    deptmananame: rec.deptmananame,\n    deptname: rec.deptname\n  },\n  title: '清单审核 - ' + rec.projname\n})"
                  }
                },
                {
                  "_icon": "right1",
                  "text": "fill1",
                  "cls": "Wb.Fill",
                  "properties": {
                    "cid": "fill1"
                  }
                },
                {
                  "_icon": "button",
                  "text": "seekBtn",
                  "cls": "Wb.Button",
                  "properties": {
                    "cid": "seekBtn",
                    "text": "查询",
                    "type": "primary",
                    "roundBorder": "true"
                  },
                  "events": {
                    "click": "let data = Wb.getValue(app.panel1)\nif(Wb.verify(app.panel1)){\n  app.grid1.load({\n    comps:app.panel1,\n    params:{},\n  })\n}\n"
                  }
                },
                {
                  "_icon": "button",
                  "text": "resetBtn",
                  "cls": "Wb.Button",
                  "properties": {
                    "cid": "resetBtn",
                    "text": "重置",
                    "roundBorder": "true"
                  },
                  "events": {
                    "click": "Wb.reset(app.panel1);\napp.grid1.load();"
                  }
                }
              ]
            },
            {
              "_icon": "array",
