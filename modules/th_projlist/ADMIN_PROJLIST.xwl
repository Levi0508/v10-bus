      "cls": "Wb.Window",
      "_expanded": true,
      "properties": {
        "cid": "selectUserWin",
        "width": "675",
        "height": "500",
        "title": "查询负责人",
        "modal": "true"
      },
      "items": [
        {
          "_icon": "text",
          "text": "query",
          "cls": "Wb.Text",
          "properties": {
            "cid": "query",
            "placeholder": "用户ID或用户名"
          },
          "events": {
            "change": "app.grid2.load({params:{query:value}})"
          },
          "_expanded": false
        },
        {
          "_icon": "grid",
          "text": "grid2",
          "cls": "Wb.Grid",
          "properties": {
            "cid": "grid2",
            "url": "@xpath + '/../th_projlist_data/select-director'",
            "full": "true"
          },
          "events": {
            "itemdblclick": "app.selectUserWin.close();\napp.DIRECTOR.setValue(item.data.display_name);"
          },
          "hasDupCid": 0,
          "_expanded": true,
          "items": [
            {
              "_icon": "array",
