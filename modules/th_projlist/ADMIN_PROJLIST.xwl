                    "fieldName": "custname",
                    "minWidth": "300",
                    "render": "if (data.multi_stk) {\n  let a = el.addEl('multi_stk', 'sup');\n  a.setStyle('color', 'red');\n  a.setStyle('font-size', '12px')\n  a.textContent = '[' + data.multi_stk + ']';\n  let b = el.addEl('', 'span')\n  b.textContent = ' '+value;\n\n} else {\n  return value;\n}"
                  }
