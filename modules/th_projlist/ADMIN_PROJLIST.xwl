{
  "title": "我管理的清单列表",
  "icon": "",
  "img": "",
  "tags": "",
  "hideInMenu": "false",
  "text": "module",
  "cls": "Wb.Module",
  "properties": {
    "cid": "module",
    "links": "[\"wb/custom-made/vue/vue.js\",\"wb/custom-made/vue/element.js\",\"wb/custom-made/vue/element.css\",\"wb/custom-made/css/myCss.css\"]",
    "cls": "w-input-wrap"
  },
  "_icon": "module",
  "_expanded": true,
  "events": {
    "initialize": "Wb.apply(app, {\n  TaskTodo: function (PROJID, state) {\n    Wb.ajax({\n      url: 'm?xwl=info_query/projlist_data/inout_q',\n      params: {\n        i_projid: PROJID,\n        i_usercode: '_$sys.username$_'\n      },\n      success(resp) {\n        var scope = Wb.decode(resp).items[0];\n        var card, encodedParams = scope.projid;\n        if (state) scope.state = state;\n        if (window.destTabPanel) {\n          window.destTabPanel.items.each(function (item) {\n            if (item.detailParams == encodedParams) {\n              card = item;\n              return false;\n            }\n          });\n          if (card) {\n            destTabPanel.setActiveTab(card);\n            return;\n          }\n        }\n        card = Wb.open({\n          url: 'm?xwl=info_query/projlist/projlist_form_container',//yufang\n          params: scope,\n          title: '清单查看 - ' + scope.custname\n        });\n        if (card) {\n          card.detailParams = encodedParams;\n          window.destTabPanel = card.ownerCt;\n        }\n      }\n    });\n  },\n  reportTask: function (step) {\n    if (step === 0) {\n      var rec = app.grid1.selection;\n      console.log(\"rec\", rec);\n      if (!rec) {\n        Wb.info(\"请先选择一条记录！\");\n        return;\n      }\n      rec = rec.data;\n      this.TaskTodo(rec.projid, 'info');\n    } else if (step === 1) {\n      var recs = app.projlistGrid.selection;\n      if (!recs) {\n        Wb.info(\"请先选择一条记录！\");\n        return;\n      }\n      var data = recs.data;\n      this.TaskTodo(data.proj_id, 'info');\n      app.projlistWin.close();\n    }\n  }\n});"
  },
  "items": [
    {
      "_icon": "viewport",
      "text": "viewport1",
      "cls": "Wb.Viewport",
      "properties": {
        "cid": "viewport1",
        "width": "100%",
        "height": "100%",
        "full": "true"
      },
      "_expanded": true,
      "events": {
        "keydown": "if (e.keyCode == '13') {\n  app.seekBtn.fireClick()\n}"
      },
      "items": [
        {
          "_icon": "panel",
          "text": "panel1",
          "cls": "Wb.Panel",
          "properties": {
            "cid": "panel1",
            "border": "false",
            "layout": "form",
            "minWidth": "200",
            "gap": "8"
          },
          "_expanded": false,
          "hasDupCid": 0,
          "items": [
            {
              "_icon": "text",
              "text": "PROJID",
              "cls": "Wb.Text",
              "properties": {
                "cid": "PROJID",
                "text": "项目编号",
                "placeholder": "请输入",
                "clearButton": "true"
              },
              "hasDupCid": 0
            },
            {
              "_icon": "text",
              "text": "CUSTNAME",
              "cls": "Wb.Text",
              "properties": {
                "cid": "CUSTNAME",
                "text": "公司全称",
                "placeholder": "请输入",
                "clearButton": "true"
              },
              "hasDupCid": 0
            },
            {
              "_icon": "text",
              "text": "STKCODE",
              "cls": "Wb.Text",
              "properties": {
                "cid": "STKCODE",
                "text": "证券代码",
                "placeholder": "请输入",
                "clearButton": "true"
              },
              "hasDupCid": 0
            },
            {
              "_icon": "text",
              "text": "STKNAME",
              "cls": "Wb.Text",
              "properties": {
                "cid": "STKNAME",
                "text": "股票简称",
                "placeholder": "请输入",
                "clearButton": "true"
              },
              "hasDupCid": 0
            },
            {
              "_icon": "combo",
              "text": "PROJTYPE",
              "cls": "Wb.Select",
              "properties": {
                "cid": "PROJTYPE",
                "text": "业务类型",
                "url": "@xpath + '/operation/p_projlist_projtype_q'",
                "valueField": "projtype",
                "textField": "projtype_desc",
                "clearButton": "true"
              },
              "hasDupCid": 0,
              "_expanded": true
            },
            {
              "_icon": "combo",
              "text": "DIRECTOR",
              "cls": "Wb.Select",
              "properties": {
                "cid": "DIRECTOR",
                "text": "项目负责人",
                "clearButton": "true"
              },
              "_expanded": true,
              "events": {
                "action": "app.selectUserWin.show();"
              }
            },
            {
              "_icon": "text",
              "text": "DEPTNAME",
              "cls": "Wb.Text",
              "properties": {
                "cid": "DEPTNAME",
                "text": "部门名称",
                "placeholder": "请输入",
                "clearButton": "true"
              },
              "hasDupCid": 0,
              "_expanded": true
            },
            {
              "_icon": "combo",
              "text": "LISTTYPE",
              "cls": "Wb.Select",
              "properties": {
                "cid": "LISTTYPE",
                "text": "清单类别",
                "data": "[\n  [\n    '所有', '0',\n  ],\n  [\n    '观察清单', '1'\n  ],\n  [\n    '限制清单', '2'\n  ],\n  [\n    '静默期', '3'\n  ]\n]",
                "clearButton": "true"
              }
            },
            {
              "_icon": "combo",
              "text": "INOUTTYPE",
              "cls": "Wb.Select",
              "properties": {
                "cid": "INOUTTYPE",
                "text": "出入单类型",
                "data": "[\n  [\n    '全部', '0'\n  ],\n  [\n    '入单', '1'\n  ],\n  [\n    '出单', '2'\n  ]\n]",
                "clearButton": "true"
              },
              "_expanded": true
            },
            {
              "_icon": "combo",
              "text": "DATETYPE",
              "cls": "Wb.Select",
              "properties": {
                "cid": "DATETYPE",
                "text": "日期类型",
                "data": "[\n  [\n    '全部', '0'\n  ],\n  [\n    '发生日期', '1'\n  ],\n  [\n    '填报日期', '2'\n  ]\n]",
                "clearButton": "true"
              },
              "_expanded": true
            },
            {
              "_icon": "calendar",
              "text": "BEGINDATE",
              "cls": "Wb.Date",
              "properties": {
                "cid": "BEGINDATE",
                "text": "起始日期",
                "format": "y-MM-dd",
                "clearButton": "true"
              }
            },
            {
              "_icon": "calendar",
              "text": "ENDDATE",
              "cls": "Wb.Date",
              "properties": {
