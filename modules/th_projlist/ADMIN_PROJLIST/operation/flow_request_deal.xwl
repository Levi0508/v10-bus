  "cls": "Wb.Module",
  "properties": {
    "cid": "module",
    "serverScript": "// 隔离墙操作变动流程 流程下发接口\n\n// 测试场景  合规人员 huangzhichang_112065_018152，项目负责人 chenhaiyang_114398_035937\n// case1：合规人员主动发起审核。 开始 -> 合规起草 -> 项目负责人阅知 -> 结束\n// case2: 清单操作变更发起       开始 -> 项目负责人起草 -> 合规人员审核 -> 项目负责人阅知 -> 结束\n\n// 重要路径控制参数\n// 1.IS_MANAUL：是否手工发起 1-合规人员手动发起 0-清单操作变更发起\n// 2.CHECK_RESULT_FLAG：最终审核结果标识  0-全部准确 1-至少有一条不准确\n\nWb.info(\"隔离墙操作变动流程 流程下发接口调用\");\n\nvar HttpUtil = Packages.cn.hutool.http.HttpUtil;\nvar Method = Packages.cn.hutool.http.Method;\n\nvar formDatas = Wb.get('formDatas');\nvar formData = JSON.stringify(Wb.decode(formDatas));\n// Wb.send(String(formData));\n\nvar obj = {\n  \"todoTitle\": Wb.get('todoTitle'),\n  \"sysGuid\": Wb.get('sysGuid'),\n  \"flowCode\": Wb.get('flowCode'),\n  \"formData\": String(formData),\n  \"templateName\": Wb.get('templateName'),\n  \"flowVer\": Wb.get('flowVer'),\n  \"nodeCode\": Wb.get('nodeCode'),\n  \"applyTable\": Wb.get('applyTable'),\n  \"candidates\": Wb.get('candidates')\n};\n\n// 测试数据一（前提条件：清单操作变动发起，有不准确内容。预期路线：进入合规人员节点后再次进入项目负责人节点。）\n// var obj = {\n//     \"todoTitle\":\"隔离墙操作变动流程下发测试\",\n//     \"sysGuid\":\"IBCM\",\n//     \"flowCode\":\"IBCM003\",\n//     \"formData\":\"{\\\"PROJ_ID\\\":\\\"DD42AF6252EF459A98293F865664221B\\\",\\\"BATCH_ID\\\":\\\"39E07A02D33A52AEE0630364B40AD50A\\\",\\\"DEPTMANANAME\\\":\\\"陈海洋\\\",\\\"KHNAME\\\":\\\"杭州剂泰医药科技有限责任公司\\\",\\\"PROJCODE\\\":\\\"245377\\\",\\\"PROJTYPE\\\":\\\"股权融资_IPO\\\",\\\"STOCKCODE\\\":\\\"245377\\\",\\\"STOCKNAME\\\":\\\"某某证券\\\",\\\"STAFF_ID\\\":\\\"114398\\\",\\\"DEPTNAME\\\":\\\"医疗健康行业部\\\",\\\"PROJLIST_STATUS\\\":\\\"co\\\",\\\"OP_CONTENT\\\":\\\"附件补充\\\",\\\"OP_TIME\\\":\\\"2026-06-17 15:32:16\\\",\\\"CHECK_RESULT\\\":\\\"出入单事由不准确\\\",\\\"CHECK_TIME\\\":\\\"2026-06-18 15:32:16\\\",\\\"PROJNAME\\\":\\\"杭州剂泰医药科技有限责任公司IPO\\\",\\\"IS_MANAUL\\\":\\\"0\\\",\\\"CHECK_RESULT_FLAG\\\":\\\"1\\\"}\",\n//     \"templateName\":\"隔离墙操作变动流程\",\n//     \"flowVer\":\"1\",\n//     \"nodeCode\":\"draft\",\n//     \"applyTable\":\"T_PROJ_CHANGE_FLOW\",\n//     \"candidates\":\"018152\"\n// }\n\n// 测试数据二（前提条件：合规人员主动发起，有不准确内容。预期路线：直接进入项目负责人节点。）\n// var obj = {\n//   \"todoTitle\": \"隔离墙操作变动流程下发测试\",\n//   \"sysGuid\": \"IBCM\",\n//   \"flowCode\": \"IBCM003\",\n//   \"formData\": \"{\\\"PROJ_ID\\\":\\\"DD42AF6252EF459A98293F865664221B\\\",\\\"BATCH_ID\\\":\\\"39E07A02D33A52AEE0630364B40AD50A\\\",\\\"DEPTMANANAME\\\":\\\"陈海洋\\\",\\\"KHNAME\\\":\\\"杭州剂泰医药科技有限责任公司\\\",\\\"PROJCODE\\\":\\\"245377\\\",\\\"PROJTYPE\\\":\\\"股权融资_IPO\\\",\\\"STOCKCODE\\\":\\\"245377\\\",\\\"STOCKNAME\\\":\\\"某某证券\\\",\\\"STAFF_ID\\\":\\\"114398\\\",\\\"DEPTNAME\\\":\\\"医疗健康行业部\\\",\\\"PROJLIST_STATUS\\\":\\\"co\\\",\\\"OP_CONTENT\\\":\\\"附件补充\\\",\\\"OP_TIME\\\":\\\"2026-06-17 15:32:16\\\",\\\"CHECK_RESULT\\\":\\\"出入单事由不准确\\\",\\\"CHECK_TIME\\\":\\\"2026-06-18 15:32:16\\\",\\\"PROJNAME\\\":\\\"杭州剂泰医药科技有限责任公司IPO\\\",\\\"IS_MANAUL\\\":\\\"1\\\",\\\"CHECK_RESULT_FLAG\\\":\\\"1\\\"}\",\n//   \"templateName\": \"隔离墙操作变动流程\",\n//   \"flowVer\": \"1\",\n//   \"nodeCode\": \"draft\",\n//   \"applyTable\": \"T_PROJ_CHANGE_FLOW\",\n//   \"candidates\": \"035937\"\n// }\n\nvar data = JSON.stringify(obj);\n\nWb.info(\"Packages.cn.hutool.json.JSONUtil.toJsonStr处理后的data\");\nWb.info(Packages.cn.hutool.json.JSONUtil.toJsonStr(data))\n\nvar url = \"http://10.116.131.13:8094/auto/submit\";\n\n//调用接口\nvar resp = Packages.cn.hutool.http.HttpUtil\n  .createPost(url)\n  .header(\"Content-Type\", \"application/json;charset=utf-8\")\n  .header(\"x-flow-systemId\", Wb.get('x-flow-systemId'))\n  .header(\"x-userId\", Wb.get('x-userId'))\n  .header(\"x-userName\", Wb.get('x-userName'))\n  .body(Packages.cn.hutool.json.JSONUtil.toJsonStr(data))\n  .execute()\n  .body();\n\nWb.info(resp);\nWb.send(resp);"
  },
  "_icon": "module"
}