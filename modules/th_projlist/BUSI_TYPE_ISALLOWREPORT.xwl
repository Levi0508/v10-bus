{"title":"项目类型是否允许清单填报查询","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","links":"[\"wb/custom-made/vue/vue.js\",\"wb/custom-made/vue/element.js\",\"wb/custom-made/vue/element.css\",\"wb/custom-made/css/myCss.css\"]","cls":"w-input-wrap"},"_icon":"module","_expanded":true,"events":{"initialize":"Wb.apply(app, {\n  /*\n  * 打开修改弹窗\n  */\n  updateBeneficialView: function () {\n    var rec = app.grid1.selection;\n    if (!rec) {\n      Wb.warn('请选择 1 条需要修改的记录。');\n      return;\n    }\n    var record = rec.data;\n    console.log(\"record\", record);\n    app.BUSI_TYPE1_BAK = record.busi_type1;\n    app.BUSI_TYPE2_BAK = record.busi_type2;\n    //打开弹窗\n    app.updateBeneficialWin.show();\n    app.isNew = true;\n    app.updateBeneficialWin.title = \"修改\";\n    //给对应的输入框添值\n    app.E_BUSI_TYPE1.setValue(record.busi_type1);\n    app.E_BUSI_TYPE2.setValue(record.busi_type2);\n    app.E_IS_ALLOW_REPORT.setValue(record.is_allow_report);\n    app.E_IS_LIMIT_FXQ.setValue(record.is_limit_fxq);\n  },\n  /*\n  * 修改信息  并保存\n  */\n  updateBeneficialSave: function () {\n    //if(Wb.verify(app.updateBeneficialWin)){//该判断用于用于在非空项是否填写，如果未填写为false\n    var BUSI_TYPE1 = app.E_BUSI_TYPE1.value;\n    var BUSI_TYPE2 = app.E_BUSI_TYPE2.value;\n    console.log(\"app.E_IS_ALLOW_REPORT\", app.E_IS_ALLOW_REPORT.value);\n    console.log(\"app.E_IS_LIMIT_FXQ\", app.E_IS_LIMIT_FXQ.value)\n    Wb.ajax({\n      url: xpath + '/perm_conf/update_busitype',\n      params: {\n        BUSI_TYPE1: app.E_BUSI_TYPE1.value,\n        BUSI_TYPE2: app.E_BUSI_TYPE2.value,\n        IS_ALLOW_REPORT: (app.E_IS_ALLOW_REPORT.value == \"是\" || app.E_IS_ALLOW_REPORT.value == \"1\") ? 1 : 0,\n        IS_LIMIT_FXQ: (app.E_IS_LIMIT_FXQ.value == \"是\" || app.E_IS_LIMIT_FXQ.value == \"1\") ? 1 : 0\n      },\n      success(resp) {\n        Wb.tip('修改成功！');\n        app.updateBeneficialWin.close();\n        // app.searchlist();\n        app.seekBtn.fireClick();\n      }\n    });\n  }\n});"},"items":[{"_icon":"viewport","text":"viewport1","cls":"Wb.Viewport","properties":{"cid":"viewport1"},"_expanded":true,"events":{"keydown":"if (e.keyCode == '13') {\n  app.seekBtn.fireClick()\n}"},"items":[{"_icon":"panel","text":"panel1","cls":"Wb.Panel","properties":{"cid":"panel1","border":"false","layout":"form","minWidth":"200","gap":"8"},"_expanded":true,"hasDupCid":0,"items":[{"_icon":"combo","text":"I_BUSI_TYPE","cls":"Wb.Select","properties":{"cid":"I_BUSI_TYPE","text":"业务类型","url":"m?xwl=info_query/P_USER_PROJECT_UQ/operation/search_busitype","textField":"busi_type","clearButton":"true"},"hasDupCid":0,"_expanded":true},{"_icon":"right1","text":"fill1","cls":"Wb.Fill","properties":{"cid":"fill1"},"hasDupCid":0},{"_icon":"button","text":"seekBtn","cls":"Wb.Button","properties":{"cid":"seekBtn","text":"查询","type":"primary","roundBorder":"true"},"events":{"click":"let data = Wb.getValue(app.panel1)\nif(Wb.verify(app.panel1)){\n  app.grid1.load({\n    comps:app.panel1,\n    params:{},\n  })\n}\n"},"hasDupCid":0},{"_icon":"button","text":"resetBtn","cls":"Wb.Button","properties":{"cid":"resetBtn","text":"重置","roundBorder":"true"},"events":{"click":"app.I_BUSI_TYPE.setValue('');\napp.grid1.load()"},"hasDupCid":0}]},{"_icon":"grid","text":"grid1","cls":"Wb.Grid","properties":{"cid":"grid1","pagingBar":"pageNums","pageSize":"100","full":"true","border":"false","url":"@xpath + '/perm_conf/select'","emptyHint":"true","textSelectable":"true","columnsSortable":"true"},"_expanded":false,"hasDupCid":0,"items":[{"_icon":"toolbar","text":"tbar","cls":"Wb.Toolbar","properties":{"cid":"tbar","gap":"true","layout":"form-compact","isProperty":"true","border":"false"},"_expanded":true,"hasDupCid":0,"items":[{"_icon":"button","text":"updateBtn","cls":"Wb.Button","properties":{"cid":"updateBtn","text":"修改","roundBorder":"true","type":"primary"},"events":{"click":"app.updateBeneficialView();"},"hasDupCid":0}]},{"_icon":"array","text":"columns","cls":"Wb.Array","properties":{"cid":"columns"},"_expanded":true,"hasDupCid":0,"items":[{"_icon":"column","text":"rownum1_Col","cls":"Wb.Column","properties":{"cid":"rownum1_Col","rowNum":"true","width":"80"},"hasDupCid":0},{"_icon":"column","text":"BUSI_TYPE1_COL","cls":"Wb.Column","properties":{"cid":"BUSI_TYPE1_COL","text":"业务类型（一级）","fieldName":"busi_type1"}},{"_icon":"column","text":"BUSI_TYPE2_COL","cls":"Wb.Column","properties":{"cid":"BUSI_TYPE2_COL","text":"业务类型（二级）","fieldName":"busi_type2"}},{"_icon":"column","text":"IS_ALLOW_REPORT_COL","cls":"Wb.Column","properties":{"cid":"IS_ALLOW_REPORT_COL","text":"是否允许填报清单（默认是）","fieldName":"is_allow_report","width":"300"}},{"_icon":"column","text":"IS_LIMIT_FXQ_COL","cls":"Wb.Column","properties":{"cid":"IS_LIMIT_FXQ_COL","text":"是否限制反洗钱失效（默认是）","fieldName":"is_limit_fxq","width":"300"},"hasDupCid":0}]}]}]},{"_icon":"window","text":"updateBeneficialWin","cls":"Wb.Window","_expanded":true,"properties":{"cid":"updateBeneficialWin","width":"500","height":"350","layout":"form","labelAlign":"right","dialog":"true","minHeight":"350","minWidth":"500"},"events":{"ok":"if (!app.E_BUSI_TYPE1.value || !app.E_BUSI_TYPE2.value) {\n  Wb.tipError(\"业务类型不能为空\");\n  return;\n}\napp.updateBeneficialSave();"},"items":[{"_icon":"text","text":"E_BUSI_TYPE1","cls":"Wb.Text","properties":{"cid":"E_BUSI_TYPE1","text":"业务类型（一级）","labelWidth":"180","disabled":"true","required":"true"},"_expanded":true},{"_icon":"text","text":"E_BUSI_TYPE2","cls":"Wb.Text","properties":{"cid":"E_BUSI_TYPE2","text":"业务类型（二级）","labelWidth":"180","disabled":"true","required":"true"}},{"_icon":"combo","text":"E_IS_ALLOW_REPORT","cls":"Wb.Select","properties":{"cid":"E_IS_ALLOW_REPORT","text":"是否允许填报清单","labelWidth":"180","data":"[['是','1'],['否','0']]","required":"true"}},{"_icon":"combo","text":"E_IS_LIMIT_FXQ","cls":"Wb.Select","properties":{"cid":"E_IS_LIMIT_FXQ","text":"是否限制反洗钱失效","labelWidth":"180","data":"[['是','1'],['否','0']]","required":"true"},"_expanded":true}]}]}