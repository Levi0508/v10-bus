{"title":"查询合规管理人员","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"Wb.sendRowx(`select u.user_id, u.user_name, u.display_name, u.staff_id,\nu.staff_id || ' - ' || u.display_name || '(' || u.user_name || ')' as textfield\nfrom basic_thjs.wb_user u\nwhere ({?query?} is null or instr(u.user_id, {?query?}) > 0 or\n  instr(u.user_name, {?query?}) > 0 or\n  instr(u.display_name, {?query?}) > 0 or\n  instr(u.staff_id, {?query?}) > 0) \nand exists (select 1\nfrom basic_thjs.wb_user_role r\nwhere r.role_id = 'thhgz'\nand r.user_id = u.sid)\norder by u.user_name;`);"},"_icon":"module"}