{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"Wb.sendRowx({\n  sql: `select * from thjs.tb_projlist_review_conf t\n  where (t.deptname = {?DEPTNAME?} or {?DEPTNAME?} is null)\n  and (t.sub_deptname = {?SUB_DEPTNAME?} or{?SUB_DEPTNAME?} is null)\n  and (t.manager = {?MANAGER?} or t.manager_work_no = {?MANAGER?} or {?MANAGER?} is null)` + Wb.getOrderSql()\n});\n"},"_icon":"module"}