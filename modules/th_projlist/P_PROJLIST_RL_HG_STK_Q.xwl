{"title":"限制清单导出","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","links":"[\"wb/custom-made/vue/vue.js\",\"wb/custom-made/vue/element.js\",\"wb/custom-made/vue/element.css\",\"wb/custom-made/css/myCss.css\"]","cls":"w-input-wrap"},"_icon":"module","_expanded":true,"events":{"initialize":"Wb.apply(app, {\n  /*\n  * 打开修改弹窗\n  */\n  updateBeneficialView: function () {\n    var rec = app.grid1.selection;\n    if (!rec) {\n      Wb.warn('请选择 1 条需要修改的记录。');\n      return;\n    }\n    var record = rec.data;\n    console.log(\"record\", record);\n    app.BUSI_TYPE1_BAK = record.busi_type1;\n    app.BUSI_TYPE2_BAK = record.busi_type2;\n    //打开弹窗\n    app.updateBeneficialWin.show();\n    app.isNew = true;\n    app.updateBeneficialWin.title = \"修改\";\n    //给对应的输入框添值\n    app.E_BUSI_TYPE1.setValue(record.busi_type1);\n    app.E_BUSI_TYPE2.setValue(record.busi_type2);\n    app.E_IS_ALLOW_REPORT.setValue(record.is_allow_report);\n    app.E_IS_LIMIT_FXQ.setValue(record.is_limit_fxq);\n  },\n  /*\n  * 修改信息  并保存\n  */\n  updateBeneficialSave: function () {\n    //if(Wb.verify(app.updateBeneficialWin)){//该判断用于用于在非空项是否填写，如果未填写为false\n    var BUSI_TYPE1 = app.E_BUSI_TYPE1.value;\n    var BUSI_TYPE2 = app.E_BUSI_TYPE2.value;\n    Wb.ajax({\n      url: xpath + '/perm_conf/update_busitype',\n      params: {\n        BUSI_TYPE1: app.E_BUSI_TYPE1.value,\n        BUSI_TYPE2: app.E_BUSI_TYPE2.value,\n        IS_ALLOW_REPORT: app.E_IS_ALLOW_REPORT.value == \"是\" ? 1 : 0,\n        IS_LIMIT_FXQ: app.E_IS_LIMIT_FXQ.value == \"是\" ? 1 : 0\n      },\n      success(resp) {\n        Wb.tip('修改成功！');\n        app.updateBeneficialWin.close();\n        // app.searchlist();\n        app.seekBtn.fireClick();\n      }\n    });\n  }\n});"},"items":[{"_icon":"viewport","text":"viewport1","cls":"Wb.Viewport","properties":{"cid":"viewport1"},"_expanded":true,"events":{"keydown":"if (e.keyCode == '13') {\n  app.seekBtn.fireClick()\n}"},"items":[{"_icon":"panel","text":"panel1","cls":"Wb.Panel","properties":{"cid":"panel1","border":"false","layout":"form","minWidth":"200","gap":"8"},"_expanded":true,"hasDupCid":0,"items":[{"_icon":"text","text":"PROJNAME","cls":"Wb.Text","properties":{"cid":"PROJNAME","visible":"false","text":"项目名","clearButton":"true"}},{"_icon":"text","text":"CUSTNAME","cls":"Wb.Text","properties":{"cid":"CUSTNAME","visible":"false","text":"客户名","clearButton":"true"}},{"_icon":"button","text":"seekBtn","cls":"Wb.Button","properties":{"cid":"seekBtn","text":"查询","type":"primary","roundBorder":"true"},"events":{"click":"let data = Wb.getValue(app.panel1)\nif(Wb.verify(app.panel1)){\n  app.grid1.load({\n    comps:app.panel1,\n    params:{},\n  })\n}\n"},"hasDupCid":0},{"_icon":"button","text":"resetBtn","cls":"Wb.Button","properties":{"cid":"resetBtn","text":"重置","roundBorder":"true"},"events":{"click":"Wb.reset(app.panel1);\napp.grid1.load()"},"hasDupCid":0}]},{"_icon":"grid","text":"grid1","cls":"Wb.Grid","properties":{"cid":"grid1","pagingBar":"pageNums","pageSize":"100","full":"true","border":"false","url":"@xpath + '/perm_conf/select'","emptyHint":"true","textSelectable":"true","columnsSortable":"true","sorters":"['rowno']"},"_expanded":true,"hasDupCid":0,"items":[{"_icon":"array","text":"columns","cls":"Wb.Array","properties":{"cid":"columns"},"_expanded":true,"hasDupCid":0,"items":[{"_icon":"column","text":"rownum1_Col","cls":"Wb.Column","properties":{"cid":"rownum1_Col","rowNum":"true","width":"80"},"hasDupCid":0},{"_icon":"column","text":"ROWNO_col","cls":"Wb.Column","properties":{"cid":"ROWNO_col","text":"序号","fieldName":"rowno","width":"70"}},{"_icon":"column","text":"STKCODE_col","cls":"Wb.Column","properties":{"cid":"STKCODE_col","text":"证券代码","fieldName":"stkcode"}},{"_icon":"column","text":"CUSTNAME_col","cls":"Wb.Column","properties":{"cid":"CUSTNAME_col","text":"上市公司名称","fieldName":"custname","width":"350"}},{"_icon":"column","text":"PROJTYPE_col","cls":"Wb.Column","properties":{"cid":"PROJTYPE_col","text":"业务类型","fieldName":"projtype","width":"300"},"hasDupCid":0},{"_icon":"column","text":"RL_FILL_TIME_col","cls":"Wb.Column","properties":{"cid":"RL_FILL_TIME_col","text":"入单时间","fieldName":"rl_fill_time","width":"300"},"hasDupCid":0}]}]}]}]}