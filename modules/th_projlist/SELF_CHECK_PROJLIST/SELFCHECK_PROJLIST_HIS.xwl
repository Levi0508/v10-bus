        {
          "_icon": "grid",
          "text": "grid1",
          "cls": "Wb.Grid",
          "properties": {
            "cid": "grid1",
            "pagingBar": "pageNums",
            "pageSize": "100",
            "full": "true",
            "border": "false",
            "url": "@xpath + '/selfcheck_history_q'",
            "emptyHint": "true",
            "multiSelect": "true",
            "textSelectable": "true"
          },
          "_expanded": true,
          "hasDupCid": 0,
          "events": {
            "click": "let link = e.target.closest('.viewBtn');\nif (link) {\n  let row = this.findItemByEl(link);\n  Wb.tip('查看通知详情');\n  Wb.open({\n    url: xpath + '/../SELEFCHECK_PROJLIST_DETAIL',\n    params: {\n      title: row.data.title,\n      content: row.data.content,\n      check_batch_id: row.data.check_batch_id\n    }\n  })\n}\n\nlet correctLink = e.target.closest('.correctBtn');\nif (correctLink) {\n  let row = this.findItemByEl(correctLink);\n  Wb.open({\n    url: xpath + '/../SELFCHECK_PROJLIST_QUERY',\n    params: {\n      title: row.data.title,\n      check_batch_id: row.data.check_batch_id,\n      check_result: '0',\n    },\n    title: '已完成自查列表'\n  })\n}\n\nlet editedLink = e.target.closest('.editedBtn');\nif (editedLink) {\n  let row = this.findItemByEl(editedLink);\n  Wb.open({\n    url: xpath + '/../SELFCHECK_PROJLIST_QUERY',\n    params: {\n      title: row.data.title,\n      check_batch_id: row.data.check_batch_id,\n      check_result: '1',\n    },\n    title: '已完成自查列表'\n  })\n}\n\nlet undoLink = e.target.closest('.undodBtn');\nif (undoLink) {\n  let row = this.findItemByEl(undoLink);\n  Wb.open({\n    url: xpath + '/../SELFCHECK_PROJLIST_QUERY',\n    params: {\n      title: row.data.title,\n      check_batch_id: row.data.check_batch_id,\n      check_result: '-1',\n    },\n    title: '未完成自查列表'\n  })\n}\n\n// 批量下发催办\nlet remindLink = e.target.closest('.remindBtn');\nif (remindLink) {\n  let row = this.findItemByEl(remindLink);\n  let undo_cnt = row.data.undo_cnt;\n\n  if (undo_cnt == '0') {\n    Wb.tipError(\"该批次所有项目已完成自查，无需发送催办！\");\n    return;\n  }\n  \n  let check_batch_id = row.data.check_batch_id;\n\n  Wb.confirm(\"该操作会对所有本批次下发且未完成自查的项目对应的项目负责人下发催办，请问是否下发催办？\", () => {\n    // 1.查询出该批次未完成自查的项目列表\n    Wb.ajax({\n      url: xpath + '/../operation/start_selfcheck_mail',\n      params: {\n        CHECK_BATCH_ID: check_batch_id,\n      },\n      success(resp) {\n        let res = Wb.decode(resp);\n        if (res.O_RETURN_CODE === 0) {\n          Wb.tipSucc(\"催办邮件发送成功！\")\n        } else {\n          Wb.tipError(\"催办邮件发送失败：\" + res.O_RETURN_MSG)\n        }\n      }\n    });\n  });\n}",
            "itemdblclick": "console.log(\"item\", item);\nWb.open({\n  url: xpath + '/../SELEFCHECK_PROJLIST_DETAIL',\n  params: {\n    title: item.data.title,\n    check_batch_id: item.data.check_batch_id\n  }\n});"
          },
          "items": [
