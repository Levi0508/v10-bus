            }
          ]
        },
        {
          "_icon": "grid",
          "text": "grid1",
          "cls": "Wb.Grid",
          "properties": {
            "cid": "grid1",
            "pagingBar": "pageNums",
            "pageSize": "100",
            "full": "true",
            "border": "false",
            "url": "@xpath + '/selfcheck_projlist_query'",
            "emptyHint": "true",
            "multiSelect": "true"
          },
          "_expanded": true,
          "hasDupCid": 0,
          "events": {
            "click": "let link = e.target.closest('.viewBtn');\nif (link) {\n  let row = this.findItemByEl(link);\n  console.log(\"row\", row);\n  Wb.ajax({\n    url: 'm?xwl=info_query/projlist_data/inout_q',\n    params: {\n      i_projid: row.data.projid,\n      i_usercode: '_$sys.username$_'\n    },\n    success(resp) {\n      var scope = Wb.decode(resp).items[0];\n      scope.deptname = row.data.dept_name;\n      var card, encodedParams = scope.projid;\n      scope.state = 'info';\n      if (window.destTabPanel) {\n        window.destTabPanel.items.each(function (item) {\n          if (item.detailParams == encodedParams) {\n            card = item;\n            return false;\n          }\n        });\n        if (card) {\n          destTabPanel.setActiveTab(card);\n          return;\n        }\n      }\n      card = Wb.open({\n        url: 'm?xwl=info_query/projlist/projlist_form_container',//yufang\n        params: scope,\n        title: '清单查看 - ' + scope.custname,\n        success(scope) {\n        }\n      });\n      if (card) {\n        card.detailParams = encodedParams;\n        window.destTabPanel = card.ownerCt;\n      }\n    }\n  });\n}",
            "itemdblclick": "console.log(\"item\", item);",
            "beforeload": "params.check_batch_id = '_$check_batch_id$_'\nparams.check_result = '_$check_result$_'"
          },
          "items": [
            {
              "_icon": "array",
              "text": "columns",
              "cls": "Wb.Array",
              "properties": {
                "cid": "columns"
              },
              "_expanded": true,
              "hasDupCid": 0,
              "items": [
                {
                  "_icon": "column",
                  "text": "rownum1_Col",
                  "cls": "Wb.Column",
                  "properties": {
