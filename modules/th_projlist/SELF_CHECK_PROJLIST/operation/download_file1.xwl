{"title":"附件下载","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"// 获取文件信息\nlet file = Wb.getRow({ sql: \"select * from thjs.t_proj_selfcheck_file where id = {?id?}\" });\n\nif (!file || !file.file_path) {\n  Wb.send({\n    code: '500',\n    message: '文件不存在或路径错误'\n  });\n  return;\n}\n\ntry {\n  // 构建完整文件路径\n  let fullPath = '../../../../../../../' + file.file_path;\n\n  // 创建 File 对象\n  let wbFile = new Wb.File(true, fullPath);\n\n  if (!wbFile.exists) {\n    Wb.send({\n      code: '500',\n      message: '文件在服务器上不存在：' + fullPath\n    });\n    return;\n  }\n\n  // 通过 stream 属性获取输入流\n  // 参考 wb-server.js 第 2800-2803 行\n  let inputStream = wbFile.stream;\n\n  if (!inputStream) {\n    Wb.send({\n      code: '500',\n      message: '无法打开文件流：' + fullPath\n    });\n    return;\n  }\n\n  // 直接使用 Wb.encodeBase64() 将输入流转换为 base64\n  // 参考 wb-server.js 第 297 行和第 4494 行\n  let base64 = Wb.encodeBase64(inputStream);\n\n  if (!base64 || base64.length === 0) {\n    Wb.send({\n      code: '500',\n      message: '文件内容为空'\n    });\n    return;\n  }\n\n  // 构建 MIME 类型\n  let mimeType = 'application/octet-stream';\n  let extension = (file.extension || '').toLowerCase();\n  switch (extension) {\n    case 'pdf':\n      mimeType = 'application/pdf';\n      break;\n    case 'jpg':\n    case 'jpeg':\n      mimeType = 'image/jpeg';\n      break;\n    case 'png':\n      mimeType = 'image/png';\n      break;\n    case 'gif':\n      mimeType = 'image/gif';\n      break;\n    case 'doc':\n      mimeType = 'application/msword';\n      break;\n    case 'docx':\n      mimeType = 'application/vnd.openxmlformats-officedocument.wordprocessingml.document';\n      break;\n    case 'xls':\n      mimeType = 'application/vnd.ms-excel';\n      break;\n    case 'xlsx':\n      mimeType = 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet';\n      break;\n    case 'txt':\n      mimeType = 'text/plain';\n      break;\n    case 'zip':\n      mimeType = 'application/zip';\n      break;\n    default:\n      // 尝试从文件扩展名推断\n      if (extension) {\n        mimeType = 'application/' + extension;\n      }\n  }\n\n  // 返回 JSON 格式数据（不使用 Wb.exportData，避免强制下载）\n  Wb.send({\n    code: '0',\n    content: base64,\n    name: (file.name || '') + '.' + (file.extension || ''),\n    type: mimeType,\n    size: wbFile.length\n  });\n\n} catch (e) {\n  Wb.send({\n    code: '500',\n    message: '读取文件失败：' + e.message\n  });\n}"},"_icon":"module"}