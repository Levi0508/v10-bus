{
  "title": "发送清单自查流程和邮件",
  "icon": "",
  "img": "",
  "tags": "",
  "hideInMenu": "false",
  "text": "module",
  "cls": "Wb.Module",
  "properties": {
    "cid": "module",
    "serverScript": "let title = Wb.get('title');\nlet content = Wb.get('content');\nlet create_user = Wb.get('sys.username');\nlet create_user_id = Wb.get('sys.userid');\n\nlet formDatas = Wb.decode(Wb.get('formDatas')) || [];\n\nlet rs = {};\nlet msg = '';\nif (!formDatas) {\n  rs.O_RETURN_CODE = -1;\n  rs.O_RETURN_MSG = \"没有获取到参数\";\n} else if (formDatas && formDatas.length == 0) {\n  rs.O_RETURN_CODE = -1;\n  rs.O_RETURN_MSG = \"获取到的参数为空\";\n} else if (!title) {\n  rs.O_RETURN_CODE = -1;\n  rs.O_RETURN_MSG = \"通知标题为空\";\n} else if (!content) {\n  rs.O_RETURN_CODE = -1;\n  rs.O_RETURN_MSG = \"通知正文为空\";\n} else {\n  let conn = Wb.getConn();\n\n  try {\n    let sql1 = `INSERT INTO thjs.tb_proj_flow_inst(FLOW_CODE, BUSI_DATE, PROJID, PROJNAME, CHECK_BATCH, CHECK_BATCH_ID, TITLE,\n      CONTENT, CREATE_USER, CREATE_TIME, SEND_STATUS, CREATE_USER_ID, RECEIVE_USER_ID, RECEIVE_USER_NAME, RECEIVE_DISPLAY_NAME,\n      RECEIVE_STAFF_ID,PROJLIST_STATUS\n      ) SELECT {?FLOW_CODE?}, {?BUSI_DATE?}, {?PROJID?}, {?PROJNAME?}, {?CHECK_BATCH?}, {?CHECK_BATCH_ID?}, {?TITLE?}, \n      {?CONTENT?}, {?CREATE_USER?}, sysdate, {?SEND_STATUS?},{?CREATE_USER_ID?}, u.user_id, u.user_name, {?RECEIVE_DISPLAY_NAME?},\n      {?RECEIVE_STAFF_ID?}, {?PROJLIST_STATUS?}\n      FROM basic_thjs.wb_user u\n      WHERE u.staff_id = {?RECEIVE_STAFF_ID?}`;\n    // let sql1 = `INSERT INTO thjs.tb_proj_flow_inst(FLOW_CODE, BUSI_DATE, PROJID, PROJNAME, CHECK_BATCH, CHECK_BATCH_ID, TITLE,\n    //   CONTENT, CREATE_USER, CREATE_TIME, SEND_STATUS, CREATE_USER_ID, RECEIVE_USER_ID, RECEIVE_USER_NAME, RECEIVE_DISPLAY_NAME,\n    //   RECEIVE_STAFF_ID,PROJLIST_STATUS\n    //   ) SELECT {?FLOW_CODE?}, {?BUSI_DATE?}, {?PROJID?}, {?PROJNAME?}, {?CHECK_BATCH?}, {?CHECK_BATCH_ID?}, {?TITLE?}, \n    //   {?CONTENT?}, {?CREATE_USER?}, sysdate, {?SEND_STATUS?},{?CREATE_USER_ID?}, \n    //   listagg(u.user_id,',')within group(order by u.user_id) as user_id, \n    //   listagg(u.user_name,',')within group(order by u.user_id) as user_name, \n    //   {?RECEIVE_DISPLAY_NAME?}, {?RECEIVE_STAFF_ID?}, {?PROJLIST_STATUS?}\n    //   FROM basic_thjs.wb_user u\n    //   WHERE instr({?RECEIVE_STAFF_ID?}, u.staff_id) > 0`;\n\n    for (let i = 0; i < formDatas.length; i++) {\n\n      // 1. IBCM002流程下发 进入tb_proj_flow_inst表后由java调度任务调用/auto/submit接口下发流程\n      Wb.sql({\n        sql: sql1,\n        contextParams: false,\n        params: {\n          FLOW_CODE: 'IBCM002',// oa全链接流程 - 项目负责人清单自查\n          BUSI_DATE: formDatas[i].BUSIDATE,\n          PROJID: formDatas[i].PROJID,\n          PROJNAME: formDatas[i].PROJNAME,\n          CHECK_BATCH: formDatas[i].CHECK_BATCH,\n          CHECK_BATCH_ID: formDatas[i].CHECK_BATCH_ID,\n          TITLE: title,\n          CONTENT: content,\n          CREATE_USER: create_user,\n          SEND_STATUS: '0',\n          CREATE_USER_ID: create_user_id,//测试阶段用黄志昌老师作为流程下发人\n          RECEIVE_USER_ID: '',// 可不填 在sql语句中通过RECEIVE_STAFF_ID查出\n          RECEIVE_USER_NAME: '',// 可不填 在sql语句中通过RECEIVE_STAFF_ID查出\n          RECEIVE_DISPLAY_NAME: '陈海洋',// formDatas[i].DEPTMANANAME,\n          RECEIVE_STAFF_ID: '114398',//formDatas[i].STAFF_ID,\n          PROJLIST_STATUS: formDatas[i].PROJLIST_STATUS,\n        },\n        trans: true,\n        commit: false\n      });\n\n      // 2.清单自查邮件通知 进入tb_proj_flow_inst表后由邮件服务发送邮件\n      Wb.sql({\n        sql: sql1,\n        contextParams: false,\n        params: {\n          FLOW_CODE: 'proj_selfcheck_mail',// 下发流程的同时也下发一条邮件 - 项目负责人清单自查\n          BUSI_DATE: formDatas[i].BUSIDATE,\n          PROJID: formDatas[i].PROJID,\n          PROJNAME: formDatas[i].PROJNAME,\n          CHECK_BATCH: formDatas[i].CHECK_BATCH,\n          CHECK_BATCH_ID: formDatas[i].CHECK_BATCH_ID,\n          TITLE: title,\n          CONTENT: content,\n          CREATE_USER: create_user,\n          SEND_STATUS: '0',\n          CREATE_USER_ID: create_user_id, //测试阶段用黄志昌老师作为流程下发人\n          RECEIVE_USER_ID: '',\n          RECEIVE_USER_NAME: '',\n          RECEIVE_DISPLAY_NAME: '陈海洋',// formDatas[i].DEPTMANANAME,\n          RECEIVE_STAFF_ID: '114398',//formDatas[i].STAFF_ID,\n          PROJLIST_STATUS: formDatas[i].PROJLIST_STATUS,\n        },\n        trans: true,\n        commit: false\n      });\n    }\n    conn.commit();\n    rs.O_RETURN_CODE = 0;\n    rs.O_RETURN_MSG = \"执行成功\"\n  } catch (e) {\n    rs.O_RETURN_CODE = -1;\n    rs.O_RETURN_MSG = \"保存失败：\" + e;\n    conn.rollback();\n  } finally {\n    conn.close();\n  }\n}\n\nWb.send(Wb.encode(rs));"
  },
  "_icon": "module"
}