{"title":"下发催办","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"let check_batch_id = Wb.get('CHECK_BATCH_ID')\nlet create_user = Wb.get('sys.username');\nlet create_user_id = Wb.get('sys.userid');\n\nlet rs = {};\nlet msg = '';\nif (!check_batch_id) {\n  rs.O_RETURN_CODE = -1;\n  rs.O_RETURN_MSG = \"没有获取到参数\";\n} else {\n  let conn = Wb.getConn();\n\n  try {\n    let sql1 = `INSERT INTO thjs.TB_PROJ_FLOW_INST (\n    pk_id,             \n    flow_code,\n    busi_date,\n    projid,\n    projname,\n    check_batch,\n    check_batch_id,\n    title,\n    content,\n    create_time,\n    create_user,\n    send_status,\n    send_time,\n    create_user_id,\n    receive_user_id,\n    receive_user_name,\n    receive_display_name,\n    receive_staff_id,\n    projlist_status,\n    err_info,\n    lock_flag\n)\nSELECT\n    SYS_GUID() AS pk_id,\n    'proj_selfcheck_remind' AS flow_code,\n    TO_CHAR(SYSDATE, 'YYYYMMDD') AS busi_date,\n    src_data.projid,\n    src_data.projname,\n    src_data.check_batch,\n    src_data.check_batch_id,\n    src_data.title,\n    src_data.content,\n    SYSDATE AS create_time,\n    {?CREATE_USER?} AS create_user,\n    '0' AS send_status,\n    '' AS send_time,\n    {?CREATE_USER_ID?} AS create_user_id,\n    src_data.receive_user_id,\n    src_data.receive_user_name,\n    src_data.receive_display_name,\n    src_data.receive_staff_id,\n    src_data.projlist_status,\n    '' AS err_info,\n    '0' AS lock_flag \nFROM (\n    SELECT\n        t.projid,\n        t.projname,\n        t.check_batch,\n        t.check_batch_id,\n        t.title,\n        t.content,\n        t.receive_user_id,\n        t.receive_user_name,\n        t.receive_display_name,\n        t.receive_staff_id,\n        t.projlist_status,\n        ROW_NUMBER() OVER (PARTITION BY t.projid ORDER BY t.create_time DESC) as rn\n    FROM thjs.TB_PROJ_FLOW_INST t\n    WHERE t.check_batch_id = {?CHECK_BATCH_ID?}\n      AND t.flow_code != 'proj_selfcheck_remind' \n) src_data\nWHERE src_data.rn = 1\n  AND NOT EXISTS (\n      SELECT 1\n      FROM thjs.TB_PROJLIST_CHECK_RESULT r\n      WHERE r.projid = src_data.projid\n        AND r.check_batch_id = src_data.check_batch_id\n  );`;\n\n    Wb.sql({\n      sql: sql1,\n      contextParams: false,\n      params: {\n        CHECK_BATCH_ID: check_batch_id,\n        CREATE_USER: create_user,\n        CREATE_USER_ID: create_user_id\n      },\n      trans: true,\n      commit: false\n    });\n\n    conn.commit();\n    rs.O_RETURN_CODE = 0;\n    rs.O_RETURN_MSG = \"执行成功\"\n  } catch (e) {\n    rs.O_RETURN_CODE = -1;\n    rs.O_RETURN_MSG = \"保存失败：\" + e;\n    conn.rollback();\n  } finally {\n    conn.close();\n  }\n}\n\nWb.send(Wb.encode(rs));"},"_icon":"module"}