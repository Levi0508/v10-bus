{"title":"通知图片上传","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"// 富文本编辑器图片上传接口（不入库，仅保存文件到磁盘）\nlet data = Wb.get();\nlet file = Wb.get('file');\n\nlet rs = {};\n\nif (!file) {\n  rs.O_RETURN_CODE = -1;\n  rs.O_RETURN_MSG = \"未接收到图片文件\";\n} else {\n  try {\n    // 读取文件并转换为 base64\n    let inputStream = file.stream;\n    if (!inputStream) {\n      rs.O_RETURN_CODE = -1;\n      rs.O_RETURN_MSG = \"无法读取文件流\";\n    } else {\n      // let base64 = Wb.encodeBase64(inputStream);\n\n      // 判断 MIME 类型\n      let fileNameLower = file.name.toLowerCase();\n      let mimeType = 'image/png';\n      if (fileNameLower.match(/\\.(png)$/)) {\n        mimeType = 'image/png';\n      } else if (fileNameLower.match(/\\.(jpg|jpeg)$/)) {\n        mimeType = 'image/jpeg';\n      } else if (fileNameLower.match(/\\.(gif)$/)) {\n        mimeType = 'image/gif';\n      } else if (fileNameLower.match(/\\.(webp)$/)) {\n        mimeType = 'image/webp';\n      }\n\n      // 保存文件到磁盘（保留原逻辑）\n      let path = Base.path + 'wb/projSelfcheck/' + data.date;\n      let fileObj = new File(path, file.name);\n      let parent = fileObj.getParentFile();\n\n      if (!parent.exists()) { parent.mkdirs(); }\n\n      let os = new java.io.FileOutputStream(new File(path, file.name));\n      try {\n        IOUtils.copy(file.stream, os);\n      } finally {\n        os.close();\n      }\n\n      // 返回 base64 数据\n      // rs.O_RETURN_CODE = 0;\n      // rs.base64 = mimeType + ';base64,' + base64;\n      // rs.message = \"上传成功\";\n      // rs.path = 'wb/projSelfcheck/' + data.date + '/' + file.name;\n      let inputStream2 = new java.io.FileInputStream(new File(path, file.name));\n      try {\n        let base64 = Wb.encodeBase64(inputStream2);\n\n        rs.O_RETURN_CODE = 0;\n        rs.base64 = mimeType + ';base64,' + base64;\n        rs.message = \"上传成功\";\n        rs.path = 'wb/projSelfcheck/' + data.date + '/' + file.name;\n      } finally {\n        inputStream2.close();\n      }\n    }\n  } catch (e) {\n    rs.O_RETURN_CODE = -1;\n    rs.O_RETURN_MSG = \"图片上传失败：\" + e;\n    throw e;\n  }\n}\n\nWb.send(Wb.encode(rs));"},"_icon":"module"}