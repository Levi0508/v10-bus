{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"let order = Wb.getOrderSql();\n\nWb.sendRowx({\n  sql: `{call thjs.p_projlist_main_mq11({*cursor|result*},{?PROJID?},{?CUSTNAME?},{?i_projname?},{?STKCODE?},{?STKNAME?},{?PROJTYPE?},{?DIRECTOR?},{?DEPTNAME?},{?LISTTYPE?},{?INOUTTYPE?},{?DATETYPE?},{?BEGINDATE?},{?ENDATE?},{?sys.username?},'2','${order}',{?CHECK_RESULT?},{*O_RETURN_MSG*},{*O_RETURN_CODE*})}`,\n  kv: {\n    projlist_status: 'projlist_status',\n    ro_inout_reason: 'ro_inout_reason',\n    rl_inout_reason: 'rl_inout_reason',\n    co_inout_reason: 'co_inout_reason',\n    cl_inout_reason: 'cl_inout_reason'\n  }\n});\n"},"_icon":"module"}