                    "freeze": "true",
                    "isProperty": "false",
                    "menuText": "Check",
                    "render": "let row = this;\nvalue = row.data.checked;\nrow.addFooter({\n  cname: 'check', returnType: 'int', value, toggleAlign: 'center', clickToggle: true,\n  events: {\n    change(value) {\n      console.log(\"row\",row)\n      row.set('checked', value); // update whole row\n      row.selected = value === 1 ? true : false;\n      app.check_Col.syncHeaderCheck(); // manual sync header check of checkCol1\n    }\n  }\n}, el);",
