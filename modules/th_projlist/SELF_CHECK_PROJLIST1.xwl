                    "fieldName": "cl_inout_reason",
                    "html": "出限制清单<br/>事由",
                    "keyValue": "true"
                  },
                  "hasDupCid": 0
                },
                {
                  "_icon": "column",
                  "text": "CL_CHECK_RESULT_col",
                  "cls": "Wb.Column",
                  "properties": {
                    "cid": "CL_CHECK_RESULT_col",
                    "fieldName": "cl_check_result",
                    "html": "出限制清单<br/>检查结果",
                    "keyValue": "true"
                  },
                  "hasDupCid": 0
                },
                {
                  "_icon": "column",
                  "text": "RQ_INOUT_DATE_col",
                  "cls": "Wb.Column",
                  "properties": {
                    "cid": "RQ_INOUT_DATE_col",
                    "fieldName": "cq_inout_date",
                    "html": "静默期<br/>起始日期"
                  },
                  "_expanded": true
                },
                {
                  "_icon": "column",
                  "text": "CQ_INOUT_DATE_col",
                  "cls": "Wb.Column",
                  "properties": {
                    "cid": "CQ_INOUT_DATE_col",
                    "fieldName": "cq_inout_date",
                    "html": "静默期<br/>终止日期"
                  },
                  "_expanded": true
                },
                {
                  "_icon": "column",
                  "text": "CHECK_STATUS_col",
                  "cls": "Wb.Column",
                  "properties": {
                    "cid": "CHECK_STATUS_col",
                    "fieldName": "check_status",
                    "text": "检查结果"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "_icon": "window",
      "text": "startWin",
      "cls": "Wb.Window",
      "_expanded": true,
      "properties": {
        "cid": "startWin",
        "width": "800",
        "padding": "20",
        "layout": "fit",
        "draggable": "true",
        "full": "false",
        "minWidth": "200",
        "frame": "false",
        "closeAction": "destroy",
        "instanced": "true",
        "minHeight": "800"
      },
      "events": {
        "ok": "// 插入数据\n\n// 下发流程"
      },
      "items": [
        {
          "_icon": "viewport",
          "text": "viewport2",
          "cls": "Wb.Viewport",
          "properties": {
            "cid": "viewport2",
            "autoScroll": "true",
            "layout": "fit"
          },
          "events": {
            "ready": "let comp = this;\n\n// 确保 ElementUI 组件已注册\nif (typeof Vue !== 'undefined' && typeof ElementUI !== 'undefined') {\n  Vue.use(ElementUI);\n}\n\ncomp.vue = new Vue({\n  el: comp.el.addEl(),\n  template: `\n  <div style=\"height:100%\"> \n    <!-- 下发清单自查弹窗 -->\n    <el-form label-position=\"top\" size=\"small\">\n        <el-form-item label=\"标题\">\n          <el-input v-model=\"startFlowForm.TITLE\" placeholder=\"请输入通知标题\"></el-input>\n        </el-form-item>\n        <el-form-item label=\"正文\">\n          <!-- 富文本编辑区 -->\n          <div class=\"rich-editor-wrapper\">\n            <!-- 工具栏 -->\n            <div class=\"editor-toolbar\">\n              <button type=\"button\" @mousedown.prevent=\"execCmd('bold')\" class=\"toolbar-btn\" title=\"加粗\"><b>B</b></button>\n              <button type=\"button\" @mousedown.prevent=\"execCmd('italic')\" class=\"toolbar-btn\" title=\"斜体\"><img src=\"wb/custom-made/images/italic.png\" style=\"width:12px;height:12px;\"></button>\n              <button type=\"button\" @mousedown.prevent=\"execCmd('underline')\" class=\"toolbar-btn\" title=\"下划线\"><u>U</u></button>\n              <span class=\"toolbar-divider\"></span>\n              <button type=\"button\" @mousedown.prevent=\"execCmd('justifyLeft')\" class=\"toolbar-btn\" title=\"左对齐\"><img src=\"wb/custom-made/images/align-left.png\" style=\"width:12px;height:12px;\"></button>\n              <button type=\"button\" @mousedown.prevent=\"execCmd('justifyCenter')\" class=\"toolbar-btn\" title=\"居中\"><img src=\"wb/custom-made/images/align-center.png\" style=\"width:12px;height:12px;\"></button>\n              <button type=\"button\" @mousedown.prevent=\"execCmd('justifyRight')\" class=\"toolbar-btn\" title=\"右对齐\"><img src=\"wb/custom-made/images/symbol.png\" style=\"width:12px;height:12px;\"></button>\n              <span class=\"toolbar-divider\"></span>\n              <button type=\"button\" @mousedown.prevent=\"execCmd('insertOrderedList')\" class=\"toolbar-btn\" title=\"有序列表\">1.</button>\n              <button type=\"button\" @mousedown.prevent=\"execCmd('insertUnorderedList')\" class=\"toolbar-btn\" title=\"无序列表\">•</button>\n              <button type=\"button\" @mousedown.prevent=\"saveEditorCursor\" class=\"toolbar-btn\" title=\"插入图片\" @click=\"insertImage\" :disabled=\"!editorFocused\"><i class=\"el-icon-picture-outline\"></i></button>\n            </div>\n            <!-- 编辑区 -->\n            <div ref=\"editorContent\" class=\"editor-content\" contenteditable=\"true\" @input=\"onEditorInput\" @focus=\"editorFocused = true\" @blur=\"editorFocused = false\" @paste=\"handlePaste\" placeholder=\"请输入正文内容\"></div>\n            <!-- 隐藏的图片上传组件 -->\n            <el-upload ref=\"imageUpload\" action=\"m?xwl=th_projlist/SELF_CHECK_PROJLIST/operation/upload_image\" name=\"file\" :data=\"uploadParam\" :show-file-list=\"false\" accept=\"image/*\" :on-success=\"handleImageSuccess\" :on-error=\"handleImageError\" style=\"display:none;\"></el-upload>\n          </div>\n        </el-form-item>\n        <el-form-item>\n          <div style=\"border:1px solid #EBEEF5;padding:20px;\">\n            <el-upload ref=\"uploadRef\" action=\"m?xwl=th_projlist/SELF_CHECK_PROJLIST/operation/upload\"  name=\"file1\" multiple :data=\"uploadParam\" >\n              <el-button size=\"mini\" icon=\"el-icon-upload2\">附件上传</el-button>\n              <div slot=\"tip\" class=\"el-upload__tip\">支持扩展名 .zip .rar .xlsx .xls .doc .docx .pdf .jpg .jpeg .svg .gif .png .txt .mp3 .mp4</div>\n            </el-upload>\n          </div>\n        </el-form-item>\n        <!-- 已选中的数据展示 -->\n        <el-form-item v-if=\"selectedRows.length > 0\" :label=\"'已选中的项目 (' + selectedRows.length + ' 个)'\">\n          <el-table :data=\"selectedRowsForDialog\" border size=\"mini\" max-height=\"200\">\n            <el-table-column prop=\"projcode\" label=\"项目编号\" width=\"120\"></el-table-column>\n            <el-table-column prop=\"custname\" label=\"公司全称\" min-width=\"150\"></el-table-column>\n            <el-table-column prop=\"projname\" label=\"项目名称\" min-width=\"150\"></el-table-column>\n            <el-table-column prop=\"projtype\" label=\"业务类型\" width=\"120\"></el-table-column>\n          </el-table>\n        </el-form-item>\n      </el-form>\n    <span slot=\"footer\" class=\"dialog-footer\">\n      <el-button @click=\"startFlowDialogVisible = false\">取 消</el-button>\n      <el-button type=\"primary\" @click=\"confirmStartFlow\">确认下发</el-button>\n    </span>\n  </div>\n  `,\n  data() {\n    return {\n      loading: false,\n      allData: [],  // 原始数据（所有数据）\n      hisTableData: [],\n      selectedRows: [],\n      selectList: {},\n      pagination: {\n        pageNum: 1,\n        pageSize: 100,\n        total: 0\n      },\n      searchForm: {\n        PROJID: '',\n        CUSTNAME: '',\n        STKCODE: '',\n        STKNAME: '',\n        PROJTYPE: [],\n        DIRECTOR: '',\n        DEPTNAME: '',\n        LISTTYPE: [],\n        INOUTTYPE: '',\n        DATETYPE: '',\n        BEGINDATE: '',\n        ENDDATE: '',\n        CHECK_RESULT: ''\n      },\n      // 业务类型选项（从接口加载）\n      projTypeOptions: [],\n      // 事由选项\n      reasonOptions: {\n        ro: [\n          { value: '1', label: '1、签订保密协议' },\n          { value: '2', label: '2、项目立项' },\n          { value: '3', label: '3、进场开展工作' },\n          { value: '4', label: '4、实际获知敏感信息' }\n        ],\n        co: [\n          { value: '1', label: '1、价格确定' },\n          { value: '2', label: '2、项目终止' },\n          { value: '3', label: '3、转限制清单' },\n          { value: '4', label: '4、转静默期' },\n          { value: '5', label: '5、见备注说明' }\n        ],\n        rl: [\n          { value: '1', label: '1、项目信息已公告' },\n          { value: '2', label: '2、项目公告后进场' }\n        ],\n        cl: [\n          { value: '1', label: '1、价格/利率确定' },\n          { value: '2', label: '2、股东大会审议通过' },\n          { value: '3', label: '3、项目终止' },\n          { value: '4', label: '4、收购交易完成并公告' },\n          { value: '5', label: '5、挂牌并公开转让之日' },\n          { value: '6', label: '6、交易所同意转板的意见之日' },\n          { value: '7', label: '7、见备注说明' }\n        ]\n      },\n      // 下发弹窗相关\n      startFlowDialogVisible: false,\n      startFlowForm: {\n        TITLE: '',\n        CONTENT: '',\n        CHECK_BATCH_ID: ''\n      },\n      uploadParam: {\n        checkBatchId: '',\n        date: Wb.format(new Date(), 'yMMdd'),\n      },\n      editorCommand: {\n        fontSize: ''\n      },\n      savedEditorRange: null,  // 保存编辑器光标位置\n      editorFocused: false\n    };\n  },\n  computed: {\n    // 弹窗中展示的选中行数据\n    selectedRowsForDialog() {\n      return this.selectedRows.map(row => ({\n        projcode: row.projcode,\n        custname: row.custname,\n        projname: row.projname,\n        projtype: row.projtype\n      }));\n    }\n  },\n  methods: {\n    showMessage(msg, time, type) {\n      this.$message({\n        showClose: true,\n        dangerouslyUseHTMLString: true,\n        message: msg,\n        duration: time ? time : 0,\n        type: type ? type : 'success'\n      })\n    },\n    // 加载字典\n    loadSelectList(item) {\n      const vm = this;\n      if (!Wb.isEmpty(item.KEY_NAME)) {\n        Wb.ajax({\n          url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/select_key',\n          params: {\n            I_KEY_NAME: item.KEY_NAME\n          },\n          success(resp) {\n            let arr = Wb.decode(resp).items;\n            vm.selectList[item.BIND_DATA + \"_list\"] = arr;\n          }\n        });\n      }\n    },\n    // 加载业务类型下拉选项\n    loadProjTypeOptions() {\n      const vm = this;\n      Wb.ajax({\n        url: xpath + '/../ADMIN_PROJLIST/operation/p_projlist_projtype_q',\n        success: function (resp) {\n          const data = Wb.decode(resp);\n          // vm.projTypeOptions = data.items || [];\n          const options = data.items || [];\n          vm.projTypeOptions = options.map(item => ({\n            ...item,\n            projtype: (item.projtype === null && item.projtype_desc === '全部') ? 'ALL' : item.projtype\n          }));\n        },\n        failure: function () {\n          vm.$message.error('加载业务类型失败');\n        }\n      });\n    },\n    // 页面展示数据字典转换\n    formatDictMap(dictType, key) {\n      const dictData = this.selectList[dictType];\n      const item = dictData.find(item => item.k === key);\n      return item ? item.v : '-';\n    },\n    // 获取事由显示文本\n    getReasonText(type, value) {\n      if (!value) return '-';\n      const options = this.reasonOptions[type];\n      if (!options) return value;\n      const found = options.find(opt => opt.value === value);\n      return found ? found.label : value;\n    },\n    headerCellStyle({ row, column, rowIndex, columnIndex }) {\n      // 检查当前列是否包含我们自定义的类名\n      if (column.className && column.className.includes('ro-header')) {\n        return { backgroundColor: '#1e90ff', color: '#fff' }; // 设置背景色和字体颜色\n      } else if (column.className && column.className.includes('co-header')) {\n        return { backgroundColor: '#6495ed', color: '#fff' }; // 设置背景色和字体颜色\n      } else if (column.className && column.className.includes('rl-header')) {\n        return { backgroundColor: '#4169e1', color: '#fff' }; // 设置背景色和字体颜色\n      } else if (column.className && column.className.includes('cl-header')) {\n        return { backgroundColor: '#4472c4', color: '#fff' }; // 设置背景色和字体颜色\n      } else if (column.className && column.className.includes('q-header')) {\n        return { backgroundColor: '#44546a', color: '#fff' }; // 设置背景色和字体颜色\n      } else if (column.className && column.className.includes('status-header')) {\n        return { backgroundColor: '#ffc000', color: '#555' }; // 设置背景色和字体颜色\n      } else {\n        return { backgroundColor: '#f5f5f5', color: '#555' };\n      }\n      // 如果不匹配，返回空对象，使用默认样式\n      // return {};\n    },\n    // 查询\n    search() {\n      this.pagination.pageNum = 1;\n      this.loadData();\n    },\n\n    // 重置\n    reset() {\n      this.searchForm = {\n        PROJID: '',\n        CUSTNAME: '',\n        STKCODE: '',\n        STKNAME: '',\n        PROJTYPE: [],\n        DIRECTOR: '',\n        DEPTNAME: '',\n        LISTTYPE: [],\n        INOUTTYPE: '',\n        DATETYPE: '',\n        BEGINDATE: '',\n        ENDDATE: '',\n        CHECK_RESULT: '',\n      };\n      this.search();\n    },\n\n    // 加载数据（一次性加载所有数据）\n    loadData() {\n      const vm = this;\n      vm.loading = true;\n\n      // 构造查询参数（不传分页参数，后端返回所有数据）\n      const params = {\n        pageNum: vm.pagination.pageNum,\n        pageSize: vm.pagination.pageSize,\n        PROJID: vm.searchForm.PROJID,\n        CUSTNAME: vm.searchForm.CUSTNAME,\n        STKCODE: vm.searchForm.STKCODE,\n        STKNAME: vm.searchForm.STKNAME,\n        PROJTYPE: vm.searchForm.PROJTYPE.includes('ALL') ? null : vm.searchForm.PROJTYPE.join(','),\n        DIRECTOR: vm.searchForm.DIRECTOR,\n        DEPTNAME: vm.searchForm.DEPTNAME,\n        LISTTYPE: vm.searchForm.LISTTYPE.join(','),\n        INOUTTYPE: vm.searchForm.INOUTTYPE,\n        DATETYPE: vm.searchForm.DATETYPE,\n        BEGINDATE: vm.searchForm.BEGINDATE,\n        ENDDATE: vm.searchForm.ENDDATE,\n        CHECK_RESULT: vm.searchForm.CHECK_RESULT,\n      };\n\n      // 移除空值参数\n      Object.keys(params).forEach(key => {\n        if (params[key] === '' || params[key] === null || params[key] === undefined) {\n          delete params[key];\n        }\n      });\n\n      Wb.ajax({\n        url: xpath + '/../SELF_CHECK_PROJLIST/perm_conf/select',\n        params: params,\n        success: function (resp) {\n          const data = Wb.decode(resp);\n          const statusMap = {\n            '0': '准确',\n            '1': '已更正',\n            '2': '无自查记录'\n          };\n\n          vm.allData = data.items.map(item => ({\n            ...item,\n            check_result: statusMap[item.check_result] || '-'\n          }));\n          // console.log(\"allData\",vm.allData)\n          // 保存所有数据\n          // vm.allData = data.items || [];\n          // 设置总条数\n          vm.pagination.total = vm.allData.length;\n          // 前端分页：只取当前页的数据\n          vm.sliceData();\n          vm.loading = false;\n        },\n        failure: function () {\n          vm.loading = false;\n          vm.$message.error('查询失败，请稍后重试');\n        }\n      });\n    },\n\n    // 前端分页：根据当前页和每页条数切分数据\n    sliceData() {\n      const vm = this;\n      const start = (vm.pagination.pageNum - 1) * vm.pagination.pageSize;\n      const end = start + vm.pagination.pageSize;\n      vm.hisTableData = vm.allData.slice(start, end);\n    },\n\n    // 分页大小改变\n    handleSizeChange(val) {\n      this.pagination.pageSize = val;\n      this.pagination.pageNum = 1;  // 重置到第一页\n      this.sliceData();\n    },\n\n    // 页码改变\n    handleCurrentChange(val) {\n      this.pagination.pageNum = val;\n      this.sliceData();\n    },\n\n    // 选择行变化\n    handleSelectionChange(selection) {\n      this.selectedRows = selection;\n    },\n\n    // 行点击事件 - 切换选中状态\n    handleRowClick(row, event, column) {\n      // 如果点击的是复选框列，不处理（让复选框自己处理）\n      if (column.type === 'selection') {\n        return;\n      }\n      // 切换当前行的选中状态\n      this.$refs.mainTable.toggleRowSelection(row);\n    },\n    // 双击行打开详情\n    handleRowDbClick(row) {\n      this.openDetail(row.projid, 'info', row);\n    },\n    // 行样式 - 高亮选中行\n    tableRowClassName({ row, rowIndex }) {\n      const isSelected = this.selectedRows.some(item => item.projid === row.projid);\n      return isSelected ? 'selected-row' : '';\n    },\n\n    // 下发清单自查 - 打开弹窗\n    startFlow() {\n      const selectedRows = this.$refs.mainTable.selection;\n      if (!selectedRows || selectedRows.length === 0) {\n        this.$message.warning('请先选择要下发的项目');\n        return;\n      }\n      // 初始化表单数据\n      const today = new Date();\n      const year = today.getFullYear();\n      const month = String(today.getMonth() + 1).padStart(2, '0');\n      const day = String(today.getDate()).padStart(2, '0');\n      console.log(\"selectedRows\", selectedRows);\n      this.startFlowForm = {\n        TITLE: '关于开展投行业务信息隔离墙清单自查工作的通知',\n        CONTENT: '<p>各业务部门、行业组：</p><p>为提升信息隔离墙清单的准确性、完整性及与投行项目状态的一致性，现开展投行业务信息隔离墙清单的自查工作。具体工作要求如下：</p><p>一、本次自查要求</p><p>请核查本人负责的信息隔离墙清单中的项目，对照当前投行项目状态，根据《xxxx信息隔离墙管理办法》《xxxxx细则》明确的隔离墙名单进出时点，对项目所涉公司或证券是否需转入信息隔离墙限制清单或退出信息隔离墙清单进行核查清理：</p><p>（一）项目应转入限制名单的自查</p><p>对于已在隔离墙观察清单的项目，请重点关注当前投行项目状态是否符合转入限制清单的情形，对于项目角色公开或首次对外公告（董事会决议公告、停牌公告）的，应及时转入隔离墙限制清单。</p><p>（二）项目应退出隔离墙清单的自查</p><p>对于已在清单内的项目，请关注项目状态，对项目已上市或实施完成的，应及时退出隔离墙名单。同时对照投行项目终止的要求，对于项目被否决、撤回、暂停、协议终止等情况，应及时申请项目终止并退出隔离墙名单。</p><p>（三）重要关联方填报及其他情况的自查</p><p>Xxxxxxxx</p><p>二、相关操作要求</p><p>项目负责人请根据上述要求开展核查清理工作，通过OA待办流程内所附链接跳转到合规大数据平台-清单管理系统，在合规大数据平台-我的清单列表中对本次待查项目做好自查并记录。如自查发现该项目清单情况有误请立即更正，并记录自查结果为\"已更正\"，同时备注说明具体更正情况。在合规大数据平台完成该项目清单自查并保存后，项目负责人需重新打开并刷新OA待办流程，OA流程中自动展示清单管理系统中保存的自查结果，在OA待办流程中逐条点击【递交】按钮，OA流程由待处理状态变为已处理。</p><p>三、相关时间要求</p><p>请根据上述要求开展核查清理及相关工作，于2026年【】月【】日前予以完成并反馈核查清理情况，未按时完成的，将按公司合规xxxx制度在年度考核时予以合规扣分/合规问责。</p><p>特此通知。</p><br><p style=\"text-align:right\">投资银行业务委员会</p><p style=\"text-align:right\">合规管理组 </p><p style=\"text-align:right\">2026年【】月【】日</p>',\n        CHECK_BATCH_ID: Wb.getId()\n      };\n      // 打开弹窗\n      this.startFlowDialogVisible = true;\n\n      this.uploadParam.checkBatchId = this.startFlowForm.CHECK_BATCH_ID;\n\n      // 弹窗打开后初始化富文本内容（使用nextTick确保DOM已渲染）\n      this.$nextTick(() => {\n        if (this.$refs.editorContent) {\n          this.$refs.editorContent.innerHTML = this.startFlowForm.CONTENT;\n        }\n      });\n    },\n    // 确认下发 往流程任务表插入send_status为0的数据\n    confirmStartFlow() {\n      const vm = this;\n      const selectedRows = this.$refs.mainTable.selection;\n      if (!selectedRows || selectedRows.length === 0) {\n        this.$message.warning('请先选择要下发的项目');\n        return;\n      }\n\n      if (!this.startFlowForm.TITLE.trim()) {\n        this.$message.warning('请输入通知标题');\n        return;\n      }\n\n      const today = new Date();\n      const year = today.getFullYear();\n      const month = String(today.getMonth() + 1).padStart(2, '0');\n      const day = String(today.getDate()).padStart(2, '0');\n      // 获取选中的项目ID列表\n      const formDatas = selectedRows.map(row => ({\n        BUSIDATE: `${year}${month}${day}`,\n        PROJID: row.projid,\n        PROJLIST_STATUS: row.projlist_status,\n        DEPTMANANAME: row.deptmananame,\n        STAFF_ID: row.staff_id,\n        START_USER: '_$sys.username$_',\n        CHECK_BATCH: `${year}${month}`,\n        CHECK_BATCH_ID: this.startFlowForm.CHECK_BATCH_ID,\n        TITLE: '',\n        CONTENT: '',\n        PROJNAME: row.projname,\n      }));\n      console.log('选中的项目:', formDatas);\n      console.log('选中的项目数量:', formDatas.length);\n\n      // 下发清单自查流程前先转换富文本中的图片为 base64\n      // let contentToConvert = this.startFlowForm.CONTENT;\n\n      // 使用转换后的内容进行提交\n      Wb.ajax({\n        url: xpath + '/operation/start_selfcheck_flow',\n        params: {\n          'formDatas': formDatas,\n          'title': vm.startFlowForm.TITLE,\n          'content': this.startFlowForm.CONTENT\n        },\n        success(resp) {\n          let result = Wb.decode(resp);\n          console.log(\"start_selfcheck_flow 响应:\", resp);\n          if (result.O_RETURN_CODE === 0) {\n            vm.showMessage(\"成功发送！\" + formDatas.length + \"条【项目负责人清单自查】流程数据已进入任务列表\", 2000, 'success');\n            vm.startFlowDialogVisible = false;\n          } else {\n            vm.showMessage(result.O_RETURN_MSG, 2000, 'error');\n          }\n        },\n        error(err) {\n          console.error('下发流程失败:', err);\n          vm.showMessage('下发流程失败：' + err.message, 2000, 'error');\n        }\n      });\n    },\n    // 富文本编辑器 - 执行命令\n    execCmd(command, value) {\n      // 确保编辑器存在\n      if (!this.$refs.editorContent) {\n        console.error('[execCmd] 编辑器不存在');\n        return;\n      }\n\n      // 先聚焦编辑器（必须在执行命令之前）\n      this.$refs.editorContent.focus();\n\n      // 设置默认值\n      if (command === 'fontSize') {\n        value = value || this.editorCommand.fontSize || '3';\n      }\n\n      // 记录调试信息\n      console.log('[execCmd] 开始执行命令:', {\n        command: command,\n        value: value,\n        selection: window.getSelection ? window.getSelection().toString() : '无选区',\n        editorFocused: document.activeElement === this.$refs.editorContent\n      });\n\n      // 特殊处理对齐命令：当选中图片时，需要找到图片的父容器应用text-align\n      if (['justifyLeft', 'justifyCenter', 'justifyRight'].indexOf(command) >= 0) {\n        const alignMap = {\n          'justifyLeft': 'left',\n          'justifyCenter': 'center',\n          'justifyRight': 'right'\n        };\n        const textAlign = alignMap[command];\n\n        // 获取当前选区\n        const selection = window.getSelection();\n        if (selection && selection.rangeCount > 0) {\n          const range = selection.getRangeAt(0);\n          let startNode = range.startContainer;\n\n          //如果是选择的文本节点，找到父元素\n          if (startNode.nodeType === Node.TEXT_NODE) {\n            startNode = startNode.parentNode\n          }\n\n          // 向上查找最近的块级元素（p/div/img等）\n          let currentEl = startNode;\n          while (currentEl && currentEl !== this.$refs.editorContent) {\n            if (currentEl.tagName === 'IMG') {\n              let parentEl = currentEl.parentNode;\n              while (parentEl && parentEl !== this.$refs.editorContent) {\n                const tagName = parentEl.tagName;\n                if (tagName === 'P' || tagName === 'DIV' || tagName === 'BODY') {\n                  parentEl.style.textAlign = textAlign;\n                  currentEl.style.display = 'inline-block';\n                  currentEl.style.float = 'none';\n                  console.log(\"[execCmd]图片对齐成功\", tagName);\n                  break;\n                }\n                parentEl = parentEl.parentNode;\n              }\n              break;\n            }\n            else if (['P', 'DIV', 'BLOCKQUOTE'].indexOf(currentEl.tagName) >= 0) {\n              currentEl.style.textAlign = textAlign;\n              console.log(\"[execCmd]块级元素对齐成功，已设置\", currentEl.tagName, 'text-align:', textAlign);\n              break;\n            }\n            currentEl = currentEl.parentNode;\n          }\n          this.startFlowForm.CONTENT = this.$refs.editorContent.innerHTML;\n          return;\n        }\n      }\n\n      // 执行命令并获取返回值\n      const result = document.execCommand(command, false, value);\n\n      // 输出执行结果\n      console.log('[execCmd] 命令执行结果:', {\n        command: command,\n        success: result,\n        editorContent: this.$refs.editorContent.innerHTML.substring(0, 200) + '...'\n      });\n\n      // 如果执行失败，尝试手动实现加粗效果\n      if (command === 'bold' && !result) {\n        this.manualBold();\n      }\n    },\n    // 保存编辑器光标位置\n    saveEditorCursor() {\n      const editor = this.$refs.editorContent;\n      if (!editor) return;\n      const selection = window.getSelection();\n      if (selection.rangeCount > 0) {\n        this.savedEditorRange = selection.getRangeAt(0).cloneRange();\n      }\n    },\n    // 插入图片 - 触发隐藏的文件选择器\n    insertImage() {\n      if (this.$refs.imageUpload) {\n        this.$refs.imageUpload.$children[0].$refs.input.click();\n      }\n    },\n    // 图片上传成功回调\n    handleImageSuccess(res) {\n      const editor = this.$refs.editorContent;\n      if (!editor) return;\n\n      // 恢复光标位置\n      if (this.savedEditorRange) {\n        const selection = window.getSelection();\n        selection.removeAllRanges();\n        selection.addRange(this.savedEditorRange);\n      }\n\n      // 直接使用接口返回的 base64 数据构建 img 标签\n      let imgSrc = '';\n      if (res.base64 && res.base64.length > 0) {\n        imgSrc = res.base64;\n      } else if (res.O_RETURN_CODE === 0 && res.path) {\n        // 兼容旧版本：如果接口未返回 base64，则使用路径\n        imgSrc = encodeURIComponent(res.path);\n      } else {\n        this.$message.error('图片上传失败：未收到有效的图片数据');\n        return;\n      }\n\n      // const imgHtml = '<img src=\"data:' + imgSrc + '\" style=\"max-width:100%;height:auto;display:inline-block;\" />';\n      const imgHtml = '<img style=\"width:100%;height:auto;display:inline-block;\" src=\"data:' + imgSrc + '\" />';\n\n      // 插入图片到编辑器\n      document.execCommand('insertHTML', false, imgHtml);\n\n      // 同步内容到表单\n      this.startFlowForm.CONTENT = editor.innerHTML;\n      // this.$message.success('图片插入成功');\n    },\n    // 图片上传失败回调\n    handleImageError() {\n      this.$message.error('图片上传失败');\n    },\n    // 处理富文本编辑器中的图片粘贴（截图粘贴等场景）\n    handlePaste(e) {\n      const vm = this;\n      const editor = this.$refs.editorContent;\n      if (!editor) return;\n\n      const clipboardData = e.clipboardData || window.clipboardData;\n      const items = clipboardData.items;\n\n      // 检查剪贴板中是否有图片文件（如截图粘贴）\n      const imageFiles = [];\n      for (let i = 0; i < items.length; i++) {\n        if (items[i].type.indexOf('image') !== -1) {\n          imageFiles.push(items[i].getAsFile());\n        }\n      }\n\n      if (imageFiles.length > 0) {\n        // 有图片文件，阻止默认粘贴行为\n        e.preventDefault();\n\n        let processedCount = 0;\n        imageFiles.forEach(file => {\n          const reader = new FileReader();\n          reader.onload = function (event) {\n            const imgSrc = event.target.result;\n            // 使用与上传图片相同的样式\n            const imgHtml = '<img style=\"width:100%;height:auto;display:inline-block;\" src=\"data:' + imgSrc + '\" />';\n            document.execCommand('insertHTML', false, imgHtml);\n\n            processedCount++;\n            if (processedCount === imageFiles.length) {\n              vm.startFlowForm.CONTENT = editor.innerHTML;\n            }\n          };\n          reader.readAsDataURL(file);\n        });\n      }\n      // 如果没有图片文件，让默认行为处理文本粘贴\n    },\n    // 手动实现加粗效果（备用方案）\n    manualBold() {\n      const selection = window.getSelection();\n      if (!selection.rangeCount) {\n        console.warn('[manualBold] 没有选区，无法执行加粗');\n        return;\n      }\n\n      const range = selection.getRangeAt(0);\n      const selectedText = range.toString();\n\n      if (!selectedText) {\n        console.warn('[manualBold] 选区为空');\n        return;\n      }\n\n      // 创建 <strong> 标签包裹选中内容\n      const strong = document.createElement('strong');\n      range.surroundContents(strong);\n      console.log('[manualBold] 手动加粗成功');\n    },\n    // 富文本编辑器 - 输入事件\n    onEditorInput(e) {\n      this.startFlowForm.CONTENT = e.target.innerHTML;\n    },\n    // 查看清单自查历史\n    viewHistory() {\n      Wb.open({\n        url: xpath + '/SELFCHECK_PROJLIST_HIS',\n        params: {},\n        success() {\n\n        }\n      })\n    },\n    // 打开详情页面\n    openDetail(projid, state, row) {\n      Wb.ajax({\n        url: 'm?xwl=info_query/projlist_data/inout_q',\n        params: {\n          i_projid: projid,\n          i_usercode: '{#sys.username#}'\n        },\n        success: function (resp) {\n          const scope = Wb.decode(resp).items[0];\n          scope.deptname = row.deptname;\n          if (state) scope.state = state;\n\n          let card;\n          const encodedParams = scope.PROJID;\n\n          // 检查是否已打开\n          if (window.destTabPanel) {\n            window.destTabPanel.items.each(function (item) {\n              if (item.detailParams == encodedParams) {\n                card = item;\n                return false;\n              }\n            });\n          }\n\n          if (card) {\n            window.destTabPanel.setActiveTab(card);\n            return;\n          }\n\n          if (state === 'info') {\n            // 双击查看模式\n            card = Wb.open({\n              url: 'm?xwl=info_query/projlist/projlist_form_container',\n              params: scope,\n              title: '清单填报 - ' + scope.custname\n            });\n          } else {\n            // 关联信息修改模式\n            scope.i_op_flag = 1;\n            card = Wb.open({\n              url: 'm?xwl=info_query/projlist/projlist_form_container',\n              params: scope,\n              title: '清单填报（关联信息修改） - ' + scope.custname\n            });\n          }\n\n          if (card) {\n            card.detailParams = encodedParams;\n            window.destTabPanel = card.ownerCt;\n          }\n        }\n      });\n    },\n    remindTodo() {\n      const selectedRows = this.$refs.mainTable.selection;\n      if (!selectedRows || selectedRows.length === 0) {\n        this.$message.warning('请先选择要下发的项目');\n        return;\n      }\n      const formDatas = selectedRows.map(row => ({\n        i_projname: row.projname,\n        i_check_batch_id: row.check_batch_id,\n        i_staff_id: row.staff_id\n      }));\n    }\n  },\n  created: function () {\n    const vm = this;\n    // 加载业务类型下拉选项\n    vm.loadProjTypeOptions();\n    // 初始化加载数据\n    // vm.loadData();\n    vm.loadSelectList({\n      \"KEY_NAME\": \"projlist_status\",\n      \"BIND_DATA\": \"projlist_status\",\n      \"COMPONENT_TYPE\": \"4\"\n    });\n    // let allData = app.grid1.data;\n    // vm.selectedRows = allData.filter(item=> item.checked ===1);\n    // console.log(\"选中的项目列表\",vm.selectedRows);\n\n    // 绑定回车查询事件（排除弹窗打开状态和富文本编辑区域）\n    document.onkeydown = function (e) {\n      // 如果弹窗已打开，不触发查询\n      if (vm.startFlowDialogVisible) return;\n      // 如果焦点在富文本编辑区，不触发查询\n      const activeEl = document.activeElement;\n      if (activeEl && (activeEl.contentEditable === 'true' || activeEl.classList.contains('editor-content'))) return;\n      // 其他情况：回车触发查询\n      // if (e.keyCode === 13) {\n      //   vm.search();\n      // }\n    };\n\n    \n  },\n  beforeDestroy: function () {\n    // 清理事件监听\n    document.onkeydown = null;\n  }\n});\n"
          },
          "hasDupCid": 0
        }
      ]
    }
  ]
}