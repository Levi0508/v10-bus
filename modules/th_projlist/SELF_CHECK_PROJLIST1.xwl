{
  "title": "我管理的清单自查列表（已废弃）",
  "icon": "",
  "img": "",
  "tags": "",
  "hideInMenu": "true",
  "text": "module",
  "cls": "Wb.Module",
  "properties": {
    "cid": "module",
    "links": "[\"wb/custom-made/vue/vue.js\",\"wb/custom-made/vue/element.js\",\"wb/custom-made/vue/element.css\",\"wb/custom-made/css/self_check.css\",\"wb/custom-made/wangeditor/style.css\",\"wb/custom-made/wangeditor/index.js\"]"
  },
  "_icon": "module",
  "_expanded": true,
  "events": {
    "initialize": "Wb.apply(app, {\n  TaskTodo(PROJID, state) {\n    Wb.ajax({\n      url: 'm?xwl=info_query/projlist_data/inout_q',\n      params: {\n        i_projid: PROJID,\n        i_usercode: '_$sys.username$_'\n      },\n      success: function (resp) {\n        var scope = Wb.decode(resp).items[0];\n        var card, encodedParams = scope.projid;\n        if (state) scope.state = state;\n        if (window.destTabPanel) {\n          window.destTabPanel.items.each(function (item) {\n            if (item.detailParams == encodedParams) {\n              card = item;\n              return false;\n            }\n          });\n          if (card) {\n            destTabPanel.setActiveTab(card);\n            return;\n          }\n        }\n        card = Wb.open({\n          url: 'm?xwl=info_query/projlist/projlist_form_container',\n          params: scope,\n          title: '清单填报 - ' + scope.custname\n        });\n        if (card) {\n          card.detailParams = encodedParams;\n          window.destTabPanel = card.ownerCt;\n        }\n      }\n    });\n\n  },\n\n  reportTask(step, ifNew) {\n    if (step === 0 && ifNew && ifNew != 'info') {\n      app.projlistWin.show();\n    } else if (step === 0 && !ifNew) {\n      var rec = app.grid1.selection;\n      if (!rec) {\n        Wb.info(\"请先选择一条记录！\");\n        return;\n      }\n      rec = rec.data;\n      this.TaskTodo(rec.projid);\n    } else if (step === 1) {\n      var recs = app.projlistGrid.selection;\n      if (!recs) {\n        Wb.info(\"请先选择一条记录！\");\n        return;\n      }\n      var data = recs.data;\n      this.TaskTodo(data.proj_id);\n      app.projlistWin.close();\n    } else if (step === 0 && ifNew == 'info') {\n      var rec1 = app.grid1.selection;\n      if (!rec1) {\n        Wb.info(\"请先选择一条记录！\");\n        return;\n      }\n      rec1 = rec1.data;\n      this.TaskTodo(rec1.projid, 'info'); //双击查看  \n    }\n  },\n\n  req(name, params) {\n    var defer = $.Deferred();\n    Wb.ajax({\n      url: 'm?xwl=th_projlist/th_projlist_data/' + name,\n      params: params,\n      success: function (resp) { defer.resolve(resp); }\n    });\n    return defer.promise();\n  },\n\n  modify(name, params) {\n    var rec = app.grid1.selection;\n    if (!rec) {\n      Wb.info(\"请先选择一条记录！\");\n      return;\n    }\n    rec = rec.data;\n    this.query(rec.projid);\n  },\n  query: function (PROJID) {\n    Wb.ajax({\n      url: 'm?xwl=info_query/projlist_data/inout_q',\n      params: {\n        i_projid: PROJID,\n        i_usercode: '{#sys.username#}'\n      },\n      success: function (resp) {\n        var scope = Wb.decode(resp).items[0];\n        var card, encodedParams = scope.PROJID;\n\n        if (window.destTabPanel) {\n          window.destTabPanel.items.each(function (item) {\n            if (item.detailParams == encodedParams) {\n              card = item;\n              return false;\n            }\n          });\n          if (card) {\n            destTabPanel.setActiveTab(card);\n            return;\n          }\n        }\n        scope.i_op_flag = 1;\n        card = Wb.open({\n          url: 'm?xwl=info_query/projlist/projlist_form_container',\n          params: scope,\n          title: '清单填报（关联信息修改） - ' + scope.custname\n        });\n        if (card) {\n          card.detailParams = encodedParams;\n          window.destTabPanel = card.ownerCt;\n          console.log('haveDest', card);\n        }\n      }\n    });\n  },\n\n  setRemindBtn: function () {\n    $.when(app.req('remind_q', {})).then(function (resp) {\n      if (!Wb.decode(resp).items[0]) { app.remindBtn.setDisabled(true); }\n    });\n  }\n});"
  },
