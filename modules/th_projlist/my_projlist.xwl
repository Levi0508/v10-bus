                  "_icon": "column",
                  "text": "PROJNAME_col",
                  "cls": "Wb.Column",
                  "properties": {
                    "cid": "PROJNAME_col",
                    "text": "项目名称",
                    "fieldName": "projname",
                    "minWidth": "300",
                    "visible": "false"
                  },
                  "hasDupCid": 1
                },
