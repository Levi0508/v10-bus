                    "keyValue": "true",
                    "html": "<div style=\"background-color:rgb(255, 192, 0);padding:20px 20px 20px 10px;margin:-10px -20px -10px -10px;\">状态</div>",
                    "render": "const outList = ['出观察清单', '出限制清单', '出静默']\nif (outList.indexOf(value) != -1) {\n  el.parentNode.setStyle('background', '#D9D9D9', 'important');\n}\nreturn value;\n"
                  }
                },
