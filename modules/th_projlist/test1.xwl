{
  "title": "",
  "icon": "",
  "img": "",
  "tags": "",
  "hideInMenu": "false",
  "text": "module",
  "cls": "Wb.Module",
  "properties": {
    "cid": "module",
    "serverScript": "Create or Replace procedure \"THJS\".\"P_PROJLIST_INOUT_S\" (i_projid          in varchar2, --项目id\n                                                    i_batch_id        in varchar2, --清单填报批次ID：新增批次默认为空，否则传入当前批次ID\n                                                    i_ro_inout_date   in varchar2, --入观察清单日期\n                                                    i_ro_inout_reason in varchar2, --入观察清单事由\n                                                    i_ro_inout_remark in varchar2, --入观察清单备注\n                                                    i_ro_filepath     in varchar2, --入观察清单附件\n                                                    i_co_inout_date   in varchar2, --出观察清单日期\n                                                    i_co_inout_reason in varchar2, --出观察清单事由\n                                                    i_co_inout_remark in varchar2, --出观察清单备注\n                                                    i_co_filepath     in varchar2, --出观察清单附件\n                                                    i_rl_inout_date   in varchar2, --入限制清单日期\n                                                    i_rl_inout_reason in varchar2, --入限制清单事由\n                                                    i_rl_inout_remark in varchar2, --入限制清单备注\n                                                    i_rl_filepath     in varchar2, --入限制清单附件\n                                                    i_cl_inout_date   in varchar2, --出限制清单日期\n                                                    i_cl_inout_reason in varchar2, --出限制清单事由\n                                                    i_cl_inout_remark in varchar2, --出限制清单备注\n                                                    i_cl_filepath     in varchar2, --出限制清单附件\n                                                    i_rq_inout_date   in varchar2, --入静默期日期\n                                                    i_rq_inout_reason in varchar2, --入静默期事由\n                                                    i_rq_inout_remark in varchar2, --入静默期备注\n                                                    i_rq_filepath     in varchar2, --入静默期附件\n                                                    i_cq_inout_date   in varchar2, --出静默期日期\n                                                    i_cq_inout_reason in varchar2, --出静默期事由\n                                                    i_cq_inout_remark in varchar2, --出静默期备注\n                                                    i_cq_filepath     in varchar2, --出静默期附件\n                                                    i_projlist_status in varchar2, --清单状态\n                                                    i_submit_status   in varchar2, --提交状态 0 草稿 1 提交  2 修正\n                                                    i_usercode        in varchar2, --操作员\n                                                    o_return_msg      out varchar2,\n                                                    o_return_code     out integer) is\n  ----------------------------------------------------------------------------------\n  --版    权：GTJA\n  --版    本：1.0.0\n  --开发人员：CZC@GTJA\n  --创建日期：20190510\n  --模块编号：\n  --模块名称：清单管理 - 清单填报页面信息保存\n  --功能名称：清单填报页面信息保存\n  ----------------------------------------------------------------------------------\n\n  --==============================================================================\n  --固定变量\n  v_userexp exception; -- 用户定义错\n  v_tradedate    varchar2(8); -- 任务执行时间(业务日期)\n  v_exec_func_id integer default '0'; -- 任务id\n  v_func_own     varchar2(20) default 'thjs'; -- 任务归属用户（schema）\n  v_func_name    varchar2(2000) default 'p_projlist_inout_s'; -- 任务名称(存储过程的名字)\n  v_sqlerrm      varchar2(4000); -- 错误提示信息\n  v_sqlcode      number; -- 错误代码\n  v_sqlerrl      varchar2(4000); -- 错误行号\n  --==============================================================================\n  ---------------------------------------------------------------------------------------\n  --业务变量\n  v_filldate              varchar2(10);\n  v_projlist_status       varchar2(20);\n  v_inout_id              varchar2(80); --出入单iD\n  v_inout_id_next         varchar2(80); --出单时同时入单id\n  v_inout_id_third        varchar2(80); --出单时同时入单后出的id\n  v_projlist_status_next  varchar2(20); --出入单同时入单状态\n  v_projlist_status_third varchar2(20);\n  v_projlist_status_four  varchar2(20);\n  v_proj_type             varchar2(50); --项目类型\n\n  p_ro_inout_date varchar2(10);\n  p_co_inout_date varchar2(10);\n  p_rl_inout_date varchar2(10);\n  p_cl_inout_date varchar2(10);\n  p_rq_inout_date varchar2(10);\n  p_cq_inout_date varchar2(10);\n\n  v_ro_inout_date varchar2(10);\n  v_co_inout_date varchar2(10);\n  v_rl_inout_date varchar2(10);\n  v_cl_inout_date varchar2(10);\n  v_rq_inout_date varchar2(10);\n  v_cq_inout_date varchar2(10);\n\n  v_ro_id varchar2(80);\n  v_co_id varchar2(80);\n  v_rl_id varchar2(80);\n  v_cl_id varchar2(80);\n  v_rq_id varchar2(80);\n  v_cq_id varchar2(80);\n\n  v_batch_id varchar2(80); --批次ID\n\n  v_co_filepath varchar2(1000);\n  v_updated number := 0;  --附件更新计数\n  --=============================================================\n  -- 业务处理过程\n  --=============================================================\n\nbegin\n\n  v_tradedate := to_char(sysdate, 'yyyyMMdd');\n  v_filldate  := to_char(sysdate, 'yyyy-MM-dd');\n\n  insert into thjs.tb_exec_log\n    (log_id, proc_name, proc_param, exec_time)\n  values\n    (thjs.tb_exec_log_id_seq.nextval,\n     'p_projlist_inout_s',\n     i_projid || ',' || i_batch_id || ',' || i_ro_inout_date || ',' ||\n     i_ro_inout_reason || ',' || i_ro_inout_remark || ',' || i_ro_filepath || ',' ||\n     i_co_inout_date || ',' || i_co_inout_reason || ',' ||\n     i_co_inout_remark || ',' || i_co_filepath || ',' || i_rl_inout_date || ',' ||\n     i_rl_inout_reason || ',' || i_rl_inout_remark || ',' || i_rl_filepath || ',' ||\n     i_cl_inout_date || ',' || i_cl_inout_reason || ',' ||\n     i_cl_inout_remark || ',' || i_cl_filepath || ',' || i_rq_inout_date || ',' ||\n     i_rq_inout_reason || ',' || i_rq_inout_remark || ',' || i_rq_filepath || ',' ||\n     i_cq_inout_date || ',' || i_cq_inout_reason || ',' ||\n     i_cq_inout_remark || ',' || i_cq_filepath || ',' || i_projlist_status || ',' ||\n     i_submit_status || ',' || i_usercode,\n     sysdate);\n  commit;\n  \n -- ==================== 仅更新附件或备注说明（信创新系统新增需求）  ====================\n  declare\n    v_robserve_id varchar2(80);\n    v_cobserve_id varchar2(80);\n    v_rlimit_id   varchar2(80);\n    v_climit_id   varchar2(80);\n    v_rquiet_id   varchar2(80);\n    v_cquiet_id   varchar2(80);\n    \n    v_ro_inout_remark varchar2(2000);\n  \tv_co_inout_remark varchar2(2000);\n  \tv_rl_inout_remark varchar2(2000);\n  \tv_cl_inout_remark varchar2(2000);\n  \tv_rq_inout_remark varchar2(2000);\n  \tv_cq_inout_remark varchar2(2000);\n  \t\n  begin\n  \n    select p.robserve_id,\n           p.cobserve_id,\n           p.rlimit_id,\n           p.climit_id,\n           p.rquiet_id,\n           p.cquiet_id\n      into v_robserve_id,\n           v_cobserve_id,\n           v_rlimit_id,\n           v_climit_id,\n           v_rquiet_id,\n           v_cquiet_id\n      from thjs.tb_projlist_main p\n     where p.projid = i_projid;\n     \n    -- 获取本次变更前的备注说明 --edit by chengjing 20261030\n    select\n    \tmax(case when t.inout_direct = 'i' and t.inout_type = 'o' then t.inout_remark end),\n    \tmax(case when t.inout_direct = 'o' and t.inout_type = 'o' then t.inout_remark end),\n    \tmax(case when t.inout_direct = 'i' and t.inout_type = 'l' then t.inout_remark end),\n    \tmax(case when t.inout_direct = 'o' and t.inout_type = 'l' then t.inout_remark end),\n    \tmax(case when t.inout_direct = 'i' and t.inout_type = 'q' then t.inout_remark end),\n    \tmax(case when t.inout_direct = 'o' and t.inout_type = 'q' then t.inout_remark end)\n    into \n    \tv_ro_inout_remark,\n    \tv_co_inout_remark,\n    \tv_rl_inout_remark,\n    \tv_cl_inout_remark,\n    \tv_rq_inout_remark,\n    \tv_cq_inout_remark\n    from thjs.tb_projlist_inout t\n    where t.batch_id = i_batch_id\n    \tand t.projid = i_projid\n    \tand t.inout_type in ('o','l','q')\n    \tand t.inout_direct in ('i','o');\n\n    -- 更新【入观察附件】或【入观察备注说明】\n    if v_robserve_id is not null and (i_ro_filepath is not null or v_ro_inout_remark <> i_ro_inout_remark) then\n      update thjs.tb_projlist_inout t\n      set t.filepath = i_ro_filepath,\n\t\t  t.inout_remark = i_ro_inout_remark,\n          t.update_user = i_usercode,\n          t.update_time = sysdate\n      where t.inout_id = v_robserve_id\n        and t.projid = i_projid;\n\t  v_updated := v_updated + 1;\n    end if;\n\n    -- 更新【出观察附件】或【出观察备注说明】\n    if v_cobserve_id is not null and (i_co_filepath is not null or v_co_inout_remark <> i_co_inout_remark) then\n      update thjs.tb_projlist_inout t\n      set t.filepath = i_co_filepath,\n\t\t  t.inout_remark = i_co_inout_remark,\n          t.update_user = i_usercode,\n          t.update_time = sysdate\n      where t.inout_id = v_cobserve_id\n        and t.projid = i_projid;\n\t  v_updated := v_updated + 1;\n    end if;\n\n    -- 更新【入限制附件】或【入限制备注说明】\n    if v_rlimit_id is not null and (i_rl_filepath is not null or v_rl_inout_remark <> i_rl_inout_remark) then\n      update thjs.tb_projlist_inout t\n      set t.filepath = i_rl_filepath,\n\t\t  t.inout_remark = i_rl_inout_remark,\n          t.update_user = i_usercode,\n          t.update_time = sysdate\n      where t.inout_id = v_rlimit_id\n        and t.projid = i_projid;\n\t  v_updated := v_updated + 1;\n    end if;\n\n    -- 更新【出限制附件】或【出限制备注说明】\n    if v_climit_id is not null and (i_cl_filepath is not null or v_cl_inout_remark <> i_cl_inout_remark) then\n      update thjs.tb_projlist_inout t\n      set t.filepath = i_cl_filepath,\n\t\t\tt.inout_remark = i_cl_inout_remark,\n          t.update_user = i_usercode,\n          t.update_time = sysdate\n      where t.inout_id = v_climit_id\n        and t.projid = i_projid;\n\t  v_updated := v_updated + 1;\n    end if;\n\n    -- 更新【入静默附件】或【入静默备注说明】\n    if v_rquiet_id is not null and (i_rq_filepath is not null or v_rq_inout_remark <> i_rq_inout_remark) then\n      update thjs.tb_projlist_inout t\n      set t.filepath = i_rq_filepath,\n\t\t\tt.inout_remark = i_rq_inout_remark,\n          t.update_user = i_usercode,\n          t.update_time = sysdate\n      where t.inout_id = v_rquiet_id\n        and t.projid = i_projid;\n\t  v_updated := v_updated + 1;\n    end if;\n\n    -- 更新【出静默附件】或【出静默备注说明】\n    if v_cquiet_id is not null and (i_cq_filepath is not null or v_cq_inout_remark <> i_cq_inout_remark) then\n      update thjs.tb_projlist_inout t\n      set t.filepath = i_cq_filepath,\n\t\t\tt.inout_remark = i_cq_inout_remark,\n          t.update_user = i_usercode,\n          t.update_time = sysdate\n      where t.inout_id = v_cquiet_id\n        and t.projid = i_projid;\n\t  v_updated := v_updated + 1;\n    end if;\n\n  exception\n    when no_data_found then\n      null;\n    when too_many_rows then\n      null;\n  end;\n  -- ==================== 附件更新模块结束 ====================\n  \n    -- ==================== 提前返回判断 ====================\n  -- 如果没有传入任何日期参数，说明只更新附件（或什么都没传）\n  if i_ro_inout_date is null and i_co_inout_date is null and\n     i_rl_inout_date is null and i_cl_inout_date is null and\n     i_rq_inout_date is null and i_cq_inout_date is null then\n     \n    if v_updated > 0 then\n      commit;\n      o_return_msg := '执行成功';\n      o_return_code := 0;\n      return;\n    else\n      o_return_msg := '没有需要更新的数据';\n      o_return_code := 0;\n      return;\n    end if;\n  end if;\n  -- ==================== 提前返回判断结束 ====================\n\n  v_co_filepath := i_co_filepath;\n  --测试代码\n  /*if i_projid='D1D9967EE60F4DAD9A4AB95000CDE228' and i_co_filepath is not null then\n    v_co_filepath:=substr(i_co_filepath,instr(i_co_filepath,'/',-1,1))||'undefined';   \n  end if;*/\n  --=======================================================\n\n  select nvl(m.projlist_status, '0')\n    into v_projlist_status\n    from dual\n    left join thjs.tb_projlist_main m\n      on m.projid = i_projid;\n\n  --项目类型\n  select m.projtype\n    into v_proj_type\n    from thjs.tb_ib_cust_info m\n   where m.projid = i_projid;\n\n  select t.ro_inout_date,\n         t.co_inout_date,\n         t.rl_inout_date,\n         t.cl_inout_date,\n         nvl(t.rq_inout_date, i_rq_inout_date),\n         nvl(t.cq_inout_date, i_cq_inout_date)\n    into p_ro_inout_date,\n         p_co_inout_date,\n         p_rl_inout_date,\n         p_cl_inout_date,\n         p_rq_inout_date,\n         p_cq_inout_date\n    from dual\n    left join thjs.vw_projlist_main_inout t\n      on t.projid = i_projid\n     and t.batch_id = i_batch_id;\n\n  --=========有效性验证========================================\n  --批次处理：为空时，表示新批次，验证清单状态（必须为出单状态）\n  if i_batch_id is null and\n     v_projlist_status not in ('0', 'co', 'cl', 'cq') then\n    o_return_msg  := '清单非出单状态，无法填报新批次！';\n    o_return_code := -1;\n    return;\n  end if;\n\n  --判断清单状态是否匹配，如不匹配返回错误（已有其他提交）\n  if i_projlist_status <> v_projlist_status then\n    o_return_msg  := '清单状态不匹配，请重新打开页面填报！';\n    o_return_code := -1;\n    return;\n  end if;\n\n  if i_co_inout_date is not null and i_co_inout_date < p_ro_inout_date then\n    o_return_msg  := '出观察清单日期不应早于入观察清单日期！';\n    o_return_code := -1;\n    return;\n  end if;\n\n  if i_cl_inout_date is not null and i_cl_inout_date < p_rl_inout_date then\n    o_return_msg  := '出限制清单日期不应早于入限制清单日期！';\n    o_return_code := -1;\n    return;\n  end if;\n\n  if i_cq_inout_date is not null and i_cq_inout_date < p_rq_inout_date then\n    o_return_msg  := '出静默期日期不应早于入静默期日期！';\n    o_return_code := -1;\n    return;\n  end if;\n\n  if i_projlist_status = 'ro' and i_co_inout_reason = '4' and\n     (i_rq_inout_date is null or i_cq_inout_date is null) then\n    o_return_msg  := '出观察转静默期有误，请联系系统管理员！';\n    o_return_code := -1;\n    return;\n  end if;\n\n  if i_projlist_status = 'rl' and i_cl_inout_reason = '1' and\n     (i_rq_inout_date is null or i_cq_inout_date is null) then\n    o_return_msg  := '出限制转静默期有误，请联系系统管理员！';\n    o_return_code := -1;\n    return;\n  end if;\n\n  if (i_ro_filepath is not null and i_ro_filepath like '%undefined') or\n     (v_co_filepath is not null and v_co_filepath like '%undefined') or\n     (i_rl_filepath is not null and i_rl_filepath like '%undefined') or\n     (i_cl_filepath is not null and i_cl_filepath like '%undefined') or\n     (i_rq_filepath is not null and i_rq_filepath like '%undefined') or\n     (i_cq_filepath is not null and i_cq_filepath like '%undefined') then\n    o_return_msg  := '附件上传有误，请联系系统管理员！';\n    o_return_code := -1;\n    return;\n  end if;\n\n  --===========================================================\n  --为防止日期控件在不同浏览器中传入格式不同，统一重新截止日期格式为YYYY-MM-DD\n  v_ro_inout_date := to_char(to_date(regexp_replace(i_ro_inout_date,\n                                                    '[^0-9]',\n                                                    ''),\n                                     'YYYYMMDD'),\n                             'YYYY-MM-DD');\n  v_co_inout_date := to_char(to_date(regexp_replace(i_co_inout_date,\n                                                    '[^0-9]',\n                                                    ''),\n                                     'YYYYMMDD'),\n                             'YYYY-MM-DD');\n  v_rl_inout_date := to_char(to_date(regexp_replace(i_rl_inout_date,\n                                                    '[^0-9]',\n                                                    ''),\n                                     'YYYYMMDD'),\n                             'YYYY-MM-DD');\n  v_cl_inout_date := to_char(to_date(regexp_replace(i_cl_inout_date,\n                                                    '[^0-9]',\n                                                    ''),\n                                     'YYYYMMDD'),\n                             'YYYY-MM-DD');\n  v_rq_inout_date := to_char(to_date(regexp_replace(i_rq_inout_date,\n                                                    '[^0-9]',\n                                                    ''),\n                                     'YYYYMMDD'),\n                             'YYYY-MM-DD');\n  v_cq_inout_date := to_char(to_date(regexp_replace(i_cq_inout_date,\n                                                    '[^0-9]',\n                                                    ''),\n                                     'YYYYMMDD'),\n                             'YYYY-MM-DD');\n\n  --======================\n  --20240708 清单阶段及自动化核验\n  --\n  if v_projlist_status = '0' then\n    --未入单\n    v_projlist_status_next := case\n                                when v_ro_inout_date is not null then\n                                 'ro'\n                                when v_rl_inout_date is not null then\n                                 'rl'\n                                when v_rq_inout_date is not null then\n                                 'rq'\n                                else\n                                 null\n                              end;\n  \n  elsif v_projlist_status in ('ro', 'rl', 'rq') then\n    --入观察清单，入限制清单，入静默期       \n  \n    v_projlist_status_next := 'c' || substr(v_projlist_status, 2);\n  \n  elsif v_projlist_status in ('co', 'cl', 'cq') then\n    --出观察清单，出限制清单，出静默期\n  \n    --入清单,获取选中的入清单阶段\n    v_projlist_status_next := case\n                                when v_ro_inout_date is not null then\n                                 'ro'\n                                when v_rl_inout_date is not null then\n                                 'rl'\n                                when v_rq_inout_date is not null then\n                                 'rq'\n                                else\n                                 null\n                              end;\n  \n  else\n    o_return_msg  := '清单状态有误，请联系系统管理员！';\n    o_return_code := -1;\n    return;\n  \n  end if;\n\n  --清单填报实际阶段状态\n  if v_projlist_status_next is not null then\n  \n    if (v_projlist_status_next = 'ro' and v_ro_inout_date is null) or\n       (v_projlist_status_next = 'co' and v_co_inout_date is null) or\n       (v_projlist_status_next = 'rl' and v_rl_inout_date is null) or\n       (v_projlist_status_next = 'cl' and v_cl_inout_date is null) or\n       (v_projlist_status_next = 'rq' and v_rq_inout_date is null) or\n       (v_projlist_status_next = 'cq' and v_cq_inout_date is null) then\n    \n      o_return_msg  := '清单填报日期有误，请联系系统管理员！';\n      o_return_code := -1;\n      return;\n    \n    end if;\n  \n    --自动逻辑处理  \n    if v_projlist_status_next = 'co' and i_co_inout_reason = '3' then\n      --出观察转限制清单\n    \n      v_projlist_status_third := 'rl';\n      v_rl_inout_date         := nvl(v_rl_inout_date, v_co_inout_date);\n    \n      if v_rl_inout_date is null then\n        o_return_msg  := '转限制清单有误，请联系系统管理员！';\n        o_return_code := -1;\n        return;\n      end if;\n    elsif v_projlist_status_next = 'co' and i_co_inout_reason = '4' then\n      --出观察转静默期\n      v_projlist_status_third := 'rq';\n      v_projlist_status_four  := 'cq';\n    \n      --自动静默期处理\n      v_rq_inout_date := nvl(v_rq_inout_date, v_co_inout_date);\n      if v_cq_inout_date is null or v_cq_inout_date = v_rq_inout_date then\n      \n        v_cq_inout_date := to_char(to_date(v_rq_inout_date, 'yyyy-MM-dd') +\n                                   (case\n                                      when v_proj_type like '%IPO%' then\n                                       40\n                                      else\n                                       10\n                                    end),\n                                   'yyyy-MM-dd');\n      end if;\n    \n    elsif v_projlist_status_next = 'cl' and i_co_inout_reason = '1' then\n      --出限制，事由=价格利率确定\n    \n      v_projlist_status_third := 'rq';\n      v_projlist_status_four  := 'cq';\n    \n      --自动静默期处理\n      v_rq_inout_date := nvl(v_rq_inout_date, v_cl_inout_date);\n      if v_cq_inout_date is null or v_cq_inout_date = v_rq_inout_date then\n      \n        v_cq_inout_date := to_char(to_date(v_rq_inout_date, 'yyyy-MM-dd') +\n                                   (case\n                                      when v_proj_type like '%IPO%' then\n                                       40\n                                      else\n                                       10\n                                    end),\n                                   'yyyy-MM-dd');\n      end if;\n    \n    elsif v_projlist_status_next = 'rq' then\n      --手工入静默期\n      v_projlist_status_third := 'cq';\n    \n      --自动静默期处理\n      if v_cq_inout_date is null or v_cq_inout_date = v_rq_inout_date then\n      \n        v_cq_inout_date := to_char(to_date(v_rq_inout_date, 'yyyy-MM-dd') +\n                                   (case\n                                      when v_proj_type like '%IPO%' then\n                                       40\n                                      else\n                                       10\n                                    end),\n                                   'yyyy-MM-dd');\n      \n      end if;\n    \n    end if;\n  \n  else\n    o_return_msg  := '清单状态有误，请联系系统管理员！';\n    o_return_code := -1;\n    return;\n  end if;\n\n  --====================================================================\n  --生成新的批次号\n  if i_batch_id is null then\n    v_batch_id := sys_guid();\n    --新批次时，保存原批次，清空主表出入单绑定ID\n    insert into thjs.tb_projlist_main_batch\n      select * from thjs.tb_projlist_main t where t.projid = i_projid;\n  \n    update thjs.tb_projlist_main t\n       set t.batch_id    = v_batch_id,\n           t.robserve_id = null,\n           t.cobserve_id = null,\n           t.rlimit_id   = null,\n           t.climit_id   = null,\n           t.rquiet_id   = null,\n           t.cquiet_id   = null\n     where t.projid = i_projid;\n    commit;\n  else\n    v_batch_id := i_batch_id;\n  end if;\n\n  if i_submit_status <> '2' then\n    --草稿，提交\n  \n    --根据清单状态，判断填报阶段，保存填报信息，更新主表 \n    v_inout_id       := sys_guid();\n    v_inout_id_next  := sys_guid();\n    v_inout_id_third := sys_guid();\n  \n    if v_projlist_status = '0' then\n      --未入单\n      v_projlist_status_next := case\n                                  when v_ro_inout_date is not null then\n                                   'ro'\n                                  when v_rl_inout_date is not null then\n                                   'rl'\n                                  when v_rq_inout_date is not null then\n                                   'rq'\n                                  else\n                                   null\n                                end;\n    \n      if v_projlist_status_next is not null then\n      \n        insert into thjs.tb_projlist_inout\n          (busidate,\n           batch_id,\n           inout_id,\n           projid,\n           inout_type,\n           inout_direct,\n           fill_date,\n           inout_date,\n           inout_reason,\n           inout_remark,\n           filepath,\n           inout_user,\n           inout_status,\n           update_user,\n           update_time)\n        values\n          (v_tradedate,\n           v_batch_id,\n           v_inout_id,\n           i_projid,\n           substr(v_projlist_status_next, 2), --取清单类型       \n           'i', --入观察清单\n           v_filldate,\n           decode(v_projlist_status_next,\n                  'ro',\n                  v_ro_inout_date,\n                  'rl',\n                  v_rl_inout_date,\n                  'rq',\n                  v_rq_inout_date),\n           decode(v_projlist_status_next,\n                  'ro',\n                  i_ro_inout_reason,\n                  'rl',\n                  i_rl_inout_reason,\n                  'rq',\n                  i_rq_inout_reason),\n           decode(v_projlist_status_next,\n                  'ro',\n                  i_ro_inout_remark,\n                  'rl',\n                  i_rl_inout_remark,\n                  'rq',\n                  i_rq_inout_remark),\n           decode(v_projlist_status_next,\n                  'ro',\n                  i_ro_filepath,\n                  'rl',\n                  i_rl_filepath,\n                  'rq',\n                  i_rq_filepath),\n           i_usercode,\n           i_submit_status,\n           i_usercode,\n           sysdate);\n           \n        -----------------------\n         insert into thjs.tb_tmp_0406          \n          select v_tradedate,\n                 c.projid,\n                 '',\n                 v_batch_id,\n                 decode(v_projlist_status_next, 'ro', v_inout_id, ''),\n                 decode(v_projlist_status_next, 'rl', v_inout_id, ''),\n                 decode(v_projlist_status_next, 'rq', v_inout_id, ''),\n                 v_projlist_status_next,\n                 i_usercode,\n                 i_usercode\n            from thjs.tb_ib_cust_info c\n           where c.projid = i_projid; \n        commit;                   \n        -----------------------\n           \n      \n        --根据清单状态更新主表\n        insert into thjs.tb_projlist_main\n          (busidate,\n           projid,\n           gtjarole,\n           --multistk_id,\n           batch_id,\n           robserve_id,\n           rlimit_id,\n           rquiet_id,\n           projlist_status,\n           update_user,\n           create_user)\n          select v_tradedate,\n                 c.projid,\n                 '',\n                 v_batch_id,\n                 decode(v_projlist_status_next, 'ro', v_inout_id, ''),\n                 decode(v_projlist_status_next, 'rl', v_inout_id, ''),\n                 decode(v_projlist_status_next, 'rq', v_inout_id, ''),\n                 v_projlist_status_next,\n                 i_usercode,\n                 i_usercode\n            from thjs.tb_ib_cust_info c\n           where c.projid = i_projid;\n        commit;\n      \n        --直接入静默期时，自动出静默期\n        if v_projlist_status_next = 'rq' then\n        \n          --入静默期\n          --处理页面有误，入静默期日期未传递/出静默=入静默时，根据出限制日期自动计算日期\n          if v_cq_inout_date is null or v_rq_inout_date = v_cq_inout_date then\n            --v_rq_inout_date,v_cq_inout_date\n            select to_char(to_date(v_rq_inout_date, 'yyyy-MM-dd') + case\n                             when v_proj_type like '%IPO%' then\n                              40\n                             else\n                              10\n                           end,\n                           'yyyy-MM-dd')\n              into v_cq_inout_date\n              from dual;\n          end if;\n        \n          if v_cq_inout_date is not null then\n          \n            insert into thjs.tb_projlist_inout\n              (busidate,\n               batch_id,\n               inout_id,\n               projid,\n               inout_type,\n               inout_direct,\n               fill_date,\n               inout_date,\n               inout_reason,\n               inout_remark,\n               filepath,\n               inout_user,\n               inout_status,\n               update_user,\n               update_time)\n            values\n              (v_tradedate,\n               v_batch_id,\n               v_inout_id_next,\n               i_projid,\n               'q', --静默期\n               'o', --出清单\n               v_filldate,\n               v_cq_inout_date,\n               i_cq_inout_reason,\n               i_cq_inout_remark,\n               i_cq_filepath,\n               i_usercode,\n               i_submit_status,\n               i_usercode,\n               sysdate);\n          \n            update thjs.tb_projlist_main p\n               set p.cquiet_id       = v_inout_id_next,\n                   p.projlist_status = case\n                                         when v_cq_inout_date >\n                                              to_char(sysdate, 'YYYY-MM-DD') then\n                                          'rq'\n                                         else\n                                          'cq'\n                                       end,\n                   p.update_user     = i_usercode,\n                   p.update_time     = sysdate\n             where p.projid = i_projid;\n          \n            commit;\n          else\n          \n            o_return_msg  := '静默期自动出单有误，请联系系统管理员！';\n            o_return_code := -1;\n            rollback;\n            return;\n          end if;\n        \n        end if;\n      \n      else\n      \n        o_return_msg  := '入单有误，请联系系统管理员！';\n        o_return_code := -1;\n        return;\n      \n      end if;\n    \n    elsif v_projlist_status in ('ro', 'rl', 'rq') then\n      --入观察清单，入限制清单，入静默期\n    \n      --出清单\n      insert into thjs.tb_projlist_inout\n        (busidate,\n         batch_id,\n         inout_id,\n         projid,\n         inout_type,\n         inout_direct,\n         fill_date,\n         inout_date,\n         inout_reason,\n         inout_remark,\n         filepath,\n         inout_user,\n         inout_status,\n         update_user,\n         update_time,\n         debug_info)\n      values\n        (v_tradedate,\n         v_batch_id,\n         v_inout_id,\n         i_projid,\n         substr(v_projlist_status, 2), --取清单类型\n         'o', --出清单\n         v_filldate,\n         decode(v_projlist_status,\n                'ro',\n                v_co_inout_date,\n                'rl',\n                v_cl_inout_date,\n                'rq',\n                v_cq_inout_date),\n         decode(v_projlist_status,\n                'ro',\n                i_co_inout_reason,\n                'rl',\n                i_cl_inout_reason,\n                'rq',\n                i_cq_inout_reason),\n         decode(v_projlist_status,\n                'ro',\n                i_co_inout_remark,\n                'rl',\n                i_cl_inout_remark,\n                'rq',\n                i_cq_inout_remark),\n         decode(v_projlist_status,\n                'ro',\n                i_co_filepath,\n                'rl',\n                i_cl_filepath,\n                'rq',\n                i_cq_filepath),\n         i_usercode,\n         i_submit_status,\n         i_usercode,\n         sysdate,\n         'projtype:' || v_proj_type);\n    \n      --根据清单状态更新主表\n      --出单记录id及状态更新\n      update thjs.tb_projlist_main p\n         set p.cobserve_id     = decode(v_projlist_status,\n                                        'ro',\n                                        v_inout_id,\n                                        p.cobserve_id),\n             p.climit_id       = decode(v_projlist_status,\n                                        'rl',\n                                        v_inout_id,\n                                        p.climit_id),\n             p.cquiet_id       = decode(v_projlist_status,\n                                        'rq',\n                                        v_inout_id,\n                                        p.cquiet_id),\n             p.projlist_status = 'c' || substr(v_projlist_status, 2),\n             p.update_user     = i_usercode,\n             p.update_time     = sysdate\n       where p.projid = i_projid;\n      commit;\n    \n      --出观察清单同时入其他清单\n      if v_projlist_status = 'ro' and i_co_inout_reason in ('3', '4') then\n        --3 转限制清单 4 转静默期\n      \n        v_projlist_status_next := case\n                                    when v_projlist_status <> 'ro' and v_ro_inout_date is not null then\n                                     'ro'\n                                    when v_projlist_status <> 'rl' and v_rl_inout_date is not null then\n                                     'rl'\n                                    when v_projlist_status <> 'rq' and v_rq_inout_date is not null then\n                                     'rq'\n                                    else\n                                     null\n                                  end;\n      \n        --入清单\n        if v_projlist_status_next is not null then\n        \n          insert into thjs.tb_projlist_inout\n            (busidate,\n             batch_id,\n             inout_id,\n             projid,\n             inout_type,\n             inout_direct,\n             fill_date,\n             inout_date,\n             inout_reason,\n             inout_remark,\n             filepath,\n             inout_user,\n             inout_status,\n             update_user,\n             update_time)\n          values\n            (v_tradedate,\n             v_batch_id,\n             v_inout_id_next,\n             i_projid,\n             substr(v_projlist_status_next, 2), --取清单类型       \n             'i', --入清单\n             v_filldate,\n             decode(v_projlist_status_next,\n                    'ro',\n                    v_ro_inout_date,\n                    'rl',\n                    v_rl_inout_date,\n                    'rq',\n                    v_rq_inout_date),\n             decode(v_projlist_status_next,\n                    'ro',\n                    i_ro_inout_reason,\n                    'rl',\n                    i_rl_inout_reason,\n                    'rq',\n                    i_rq_inout_reason),\n             decode(v_projlist_status_next,\n                    'ro',\n                    i_ro_inout_remark,\n                    'rl',\n                    i_rl_inout_remark,\n                    'rq',\n                    i_rq_inout_remark),\n             decode(v_projlist_status_next,\n                    'ro',\n                    i_ro_filepath,\n                    'rl',\n                    i_rl_filepath,\n                    'rq',\n                    i_rq_filepath),\n             i_usercode,\n             i_submit_status,\n             i_usercode,\n             sysdate);\n        \n          --同时入单记录id及状态二次更新\n          update thjs.tb_projlist_main p\n             set p.robserve_id     = decode(v_projlist_status_next,\n                                            'ro',\n                                            v_inout_id_next,\n                                            p.robserve_id),\n                 p.rlimit_id       = decode(v_projlist_status_next,\n                                            'rl',\n                                            v_inout_id_next,\n                                            p.rlimit_id),\n                 p.rquiet_id       = decode(v_projlist_status_next,\n                                            'rq',\n                                            v_inout_id_next,\n                                            p.rquiet_id),\n                 p.projlist_status = v_projlist_status_next,\n                 p.update_user     = i_usercode,\n                 p.update_time     = sysdate\n           where p.projid = i_projid;\n          commit;\n        \n          --观察转静默，静默期自动完成\n          if v_projlist_status_next = 'rq' then\n          \n            --入静默期\n            --处理页面有误，入静默期日期未传递/出静默=入静默时，根据出限制日期自动计算日期\n            if v_cq_inout_date is null or v_rq_inout_date = v_cq_inout_date then\n              --v_rq_inout_date,v_cq_inout_date\n              select to_char(to_date(v_rq_inout_date, 'yyyy-MM-dd') + case\n                               when v_proj_type like '%IPO%' then\n                                40\n                               else\n                                10\n                             end,\n                             'yyyy-MM-dd')\n                into v_cq_inout_date\n                from dual;\n            end if;\n          \n            --自动静默期有误时，错误提醒\n            if v_cq_inout_date is null then\n              o_return_msg  := '静默期自动入出单有误，请联系系统管理员！';\n              o_return_code := -1;\n              rollback;\n              return;\n            end if;\n          \n          end if;\n        \n        else\n          --转限制，静默时日期 未成功返回\n          o_return_msg  := '观察清单转限制/静默有误，请联系系统管理员！';\n          o_return_code := -1;\n          rollback;\n          return;\n        \n        end if;\n      \n      end if;\n    \n      --出限制清单时，选择价格/利率确定 自动完成静默期阶段\n      if v_projlist_status = 'rl' and i_cl_inout_reason = '1' then\n      \n        --IPO类型  入静默期日期+40日后自动出静默期\n        --其余类型 入静默期日期+10日后自动出静默期\n      \n        --入静默期\n        --处理页面有误，入静默期日期未传递/出静默=入静默时，根据出限制日期自动计算日期\n        if v_rq_inout_date is null or v_rq_inout_date = v_cq_inout_date then\n          --v_rq_inout_date,v_cq_inout_date\n          select v_cl_inout_date,\n                 to_char(to_date(v_cl_inout_date, 'yyyy-MM-dd') + case\n                           when v_proj_type like '%IPO%' then\n                            40\n                           else\n                            10\n                         end,\n                         'yyyy-MM-dd')\n            into v_rq_inout_date, v_cq_inout_date\n            from dual;\n        end if;\n      \n        --自动静默期有误时，错误提醒\n        if v_rq_inout_date is null or v_cq_inout_date is null then\n          o_return_msg  := '静默期自动入出单有误，请联系系统管理员！';\n          o_return_code := -1;\n          rollback;\n          return;\n        end if;\n      \n        if v_rq_inout_date is not null then\n        \n          insert into thjs.tb_projlist_inout\n            (busidate,\n             batch_id,\n             inout_id,\n             projid,\n             inout_type,\n             inout_direct,\n             fill_date,\n             inout_date,\n             inout_reason,\n             inout_remark,\n             filepath,\n             inout_user,\n             inout_status,\n             update_user,\n             update_time)\n          values\n            (v_tradedate,\n             v_batch_id,\n             v_inout_id_next,\n             i_projid,\n             'q', --静默期\n             'i', --入清单\n             v_filldate,\n             v_rq_inout_date,\n             i_rq_inout_reason,\n             i_rq_inout_remark,\n             i_rq_filepath,\n             i_usercode,\n             i_submit_status,\n             i_usercode,\n             sysdate);\n        \n          update thjs.tb_projlist_main p\n             set p.rquiet_id       = v_inout_id_next,\n                 p.projlist_status = 'rq',\n                 p.update_user     = i_usercode,\n                 p.update_time     = sysdate\n           where p.projid = i_projid;\n        \n        end if;\n      \n        commit;\n      \n      end if;\n    \n      --自动出静默期\n      if v_projlist_status <> 'rq' and v_cq_inout_date is not null then\n      \n        insert into thjs.tb_projlist_inout\n          (busidate,\n           batch_id,\n           inout_id,\n           projid,\n           inout_type,\n           inout_direct,\n           fill_date,\n           inout_date,\n           inout_reason,\n           inout_remark,\n           filepath,\n           inout_user,\n           inout_status,\n           update_user,\n           update_time)\n        values\n          (v_tradedate,\n           v_batch_id,\n           v_inout_id_third,\n           i_projid,\n           'q', --静默期\n           'o', --出清单\n           v_filldate,\n           v_cq_inout_date,\n           i_cq_inout_reason,\n           i_cq_inout_remark,\n           i_cq_filepath,\n           i_usercode,\n           i_submit_status,\n           i_usercode,\n           sysdate);\n      \n        update thjs.tb_projlist_main p\n           set p.cquiet_id       = v_inout_id_third,\n               p.projlist_status = case\n                                     when v_cq_inout_date >\n                                          to_char(sysdate, 'YYYY-MM-DD') then\n                                      'rq'\n                                     else\n                                      'cq'\n                                   end,\n               p.update_user     = i_usercode,\n               p.update_time     = sysdate\n         where p.projid = i_projid;\n      \n        commit;\n      \n      end if;\n    \n    elsif v_projlist_status in ('co', 'cl', 'cq') then\n      --出观察清单，出限制清单，出静默期\n    \n      --入清单,获取选中的入清单阶段\n      v_projlist_status_next := case\n                                  when v_ro_inout_date is not null then\n                                   'ro'\n                                  when v_rl_inout_date is not null then\n                                   'rl'\n                                  when v_rq_inout_date is not null then\n                                   'rq'\n                                  else\n                                   null\n                                end;\n    \n      --入清单\n      if v_projlist_status_next is not null then\n      \n        insert into thjs.tb_projlist_inout\n          (busidate,\n           batch_id,\n           inout_id,\n           projid,\n           inout_type,\n           inout_direct,\n           fill_date,\n           inout_date,\n           inout_reason,\n           inout_remark,\n           filepath,\n           inout_user,\n           inout_status,\n           update_user,\n           update_time)\n        values\n          (v_tradedate,\n           v_batch_id,\n           v_inout_id_next,\n           i_projid,\n           substr(v_projlist_status_next, 2), --取清单类型       \n           'i', --入清单\n           v_filldate,\n           decode(v_projlist_status_next,\n                  'ro',\n                  v_ro_inout_date,\n                  'rl',\n                  v_rl_inout_date,\n                  'rq',\n                  v_rq_inout_date),\n           decode(v_projlist_status_next,\n                  'ro',\n                  i_ro_inout_reason,\n                  'rl',\n                  i_rl_inout_reason,\n                  'rq',\n                  i_rq_inout_reason),\n           decode(v_projlist_status_next,\n                  'ro',\n                  i_ro_inout_remark,\n                  'rl',\n                  i_rl_inout_remark,\n                  'rq',\n                  i_rq_inout_remark),\n           decode(v_projlist_status_next,\n                  'ro',\n                  i_ro_filepath,\n                  'rl',\n                  i_rl_filepath,\n                  'rq',\n                  i_rq_filepath),\n           i_usercode,\n           i_submit_status,\n           i_usercode,\n           sysdate);\n      \n        --入单记录id及状态更新\n        update thjs.tb_projlist_main p\n           set p.robserve_id     = decode(v_projlist_status_next,\n                                          'ro',\n                                          v_inout_id_next,\n                                          p.robserve_id),\n               p.rlimit_id       = decode(v_projlist_status_next,\n                                          'rl',\n                                          v_inout_id_next,\n                                          p.rlimit_id),\n               p.rquiet_id       = decode(v_projlist_status_next,\n                                          'rq',\n                                          v_inout_id_next,\n                                          p.rquiet_id),\n               p.projlist_status = v_projlist_status_next,\n               p.update_user     = i_usercode,\n               p.update_time     = sysdate\n         where p.projid = i_projid;\n        commit;\n      \n      end if;\n    \n      --自动出静默期\n      if v_projlist_status_next = 'rq' then\n      \n        --入静默期\n        --处理页面有误，入静默期日期未传递/出静默=入静默时，根据出限制日期自动计算日期\n        if v_cq_inout_date is null or v_rq_inout_date = v_cq_inout_date then\n          --v_rq_inout_date,v_cq_inout_date\n          select to_char(to_date(v_rq_inout_date, 'yyyy-MM-dd') + case\n                           when v_proj_type like '%IPO%' then\n                            40\n                           else\n                            10\n                         end,\n                         'yyyy-MM-dd')\n            into v_cq_inout_date\n            from dual;\n        end if;\n      \n        if v_cq_inout_date is not null then\n          insert into thjs.tb_projlist_inout\n            (busidate,\n             batch_id,\n             inout_id,\n             projid,\n             inout_type,\n             inout_direct,\n             fill_date,\n             inout_date,\n             inout_reason,\n             inout_remark,\n             filepath,\n             inout_user,\n             inout_status,\n             update_user,\n             update_time)\n          values\n            (v_tradedate,\n             v_batch_id,\n             v_inout_id_third,\n             i_projid,\n             'q', --静默期\n             'o', --出清单\n             v_filldate,\n             v_cq_inout_date,\n             i_cq_inout_reason,\n             i_cq_inout_remark,\n             i_cq_filepath,\n             i_usercode,\n             i_submit_status,\n             i_usercode,\n             sysdate);\n        \n          update thjs.tb_projlist_main p\n             set p.cquiet_id       = v_inout_id_third,\n                 p.projlist_status = case\n                                       when v_cq_inout_date >\n                                            to_char(sysdate, 'YYYY-MM-DD') then\n                                        'rq'\n                                       else\n                                        'cq'\n                                     end,\n                 p.update_user     = i_usercode,\n                 p.update_time     = sysdate\n           where p.projid = i_projid;\n        \n          commit;\n        \n        else\n        \n          o_return_msg  := '静默期自动入出单有误，请联系系统管理员！';\n          o_return_code := -1;\n          rollback;\n          return;\n        \n        end if;\n      \n      end if;\n    \n    end if;\n  \n  elsif i_submit_status = '2' then\n    --修正\n  \n    update thjs.tb_projlist_main p\n       set p.update_user = i_usercode, p.update_time = sysdate\n     where p.projid = i_projid;\n  \n    v_inout_id       := sys_guid();\n    v_inout_id_next  := sys_guid();\n    v_inout_id_third := sys_guid();\n  \n    --判断存在的清单阶段\n    --针对存在的阶段数据作更新操作\n    --不存在的阶段，有值传入（出观察时入其他阶段），视作清单填报处理\n    select p.robserve_id,\n           p.cobserve_id,\n           p.rlimit_id,\n           p.climit_id,\n           p.rquiet_id,\n           p.cquiet_id\n      into v_ro_id, v_co_id, v_rl_id, v_cl_id, v_rq_id, v_cq_id\n      from thjs.tb_projlist_main p\n     where p.projid = i_projid;\n  \n    --入观察\n    if v_ro_id is not null and v_ro_inout_date is not null then\n    \n      update thjs.tb_projlist_inout i\n         set i.inout_date   = v_ro_inout_date,\n             i.inout_reason = i_ro_inout_reason,\n             i.inout_remark = i_ro_inout_remark,\n             i.filepath     = i_ro_filepath,\n             i.update_user  = i_usercode,\n             i.update_time  = sysdate\n       where i.inout_id = v_ro_id;\n    \n    end if;\n  \n    --出观察\n    if v_co_id is not null and v_co_inout_date is not null then\n    \n      update thjs.tb_projlist_inout i\n         set i.inout_date   = v_co_inout_date,\n             i.inout_reason = i_co_inout_reason,\n             i.inout_remark = i_co_inout_remark,\n             i.filepath     = i_co_filepath,\n             i.update_user  = i_usercode,\n             i.update_time  = sysdate\n       where i.inout_id = v_co_id;\n    \n    end if;\n  \n    --入限制\n    if v_rl_inout_date is not null then\n    \n      if v_rl_id is not null then\n        update thjs.tb_projlist_inout i\n           set i.inout_date   = v_rl_inout_date,\n               i.inout_reason = i_rl_inout_reason,\n               i.inout_remark = i_rl_inout_remark,\n               i.filepath     = i_rl_filepath,\n               i.update_user  = i_usercode,\n               i.update_time  = sysdate\n         where i.inout_id = v_rl_id;\n      \n      else\n        insert into thjs.tb_projlist_inout\n          (busidate,\n           batch_id,\n           inout_id,\n           projid,\n           inout_type,\n           inout_direct,\n           fill_date,\n           inout_date,\n           inout_reason,\n           inout_remark,\n           filepath,\n           inout_user,\n           inout_status,\n           update_user,\n           update_time)\n        values\n          (v_tradedate,\n           v_batch_id,\n           v_inout_id,\n           i_projid,\n           'l',\n           'i',\n           v_tradedate,\n           v_rl_inout_date,\n           i_rl_inout_reason,\n           i_rl_inout_remark,\n           i_rl_filepath,\n           i_usercode,\n           '1',\n           i_usercode,\n           sysdate);\n      \n        update thjs.tb_projlist_main p\n           set p.rlimit_id = v_inout_id\n         where p.projid = i_projid;\n      \n      end if;\n    \n    end if;\n  \n    --出限制\n    if v_cl_id is not null and v_cl_inout_date is not null then\n    \n      update thjs.tb_projlist_inout i\n         set i.inout_date   = v_cl_inout_date,\n             i.inout_reason = i_cl_inout_reason,\n             i.inout_remark = i_cl_inout_remark,\n             i.filepath     = i_cl_filepath,\n             i.update_user  = i_usercode,\n             i.update_time  = sysdate\n       where i.inout_id = v_cl_id;\n    \n    end if;\n  \n    --入静默\n    if v_rq_inout_date is not null then\n    \n      if v_rq_id is not null then\n        update thjs.tb_projlist_inout i\n           set i.inout_date   = v_rq_inout_date,\n               i.inout_reason = i_rq_inout_reason,\n               i.inout_remark = i_rq_inout_remark,\n               i.filepath     = i_rq_filepath,\n               i.update_user  = i_usercode,\n               i.update_time  = sysdate\n         where i.inout_id = v_rq_id;\n      \n      else\n      \n        insert into thjs.tb_projlist_inout\n          (busidate,\n           batch_id,\n           inout_id,\n           projid,\n           inout_type,\n           inout_direct,\n           fill_date,\n           inout_date,\n           inout_reason,\n           inout_remark,\n           filepath,\n           inout_user,\n           inout_status,\n           update_user,\n           update_time)\n        values\n          (v_tradedate,\n           v_batch_id,\n           v_inout_id_next,\n           i_projid,\n           'q',\n           'i',\n           v_tradedate,\n           v_rq_inout_date,\n           i_rq_inout_reason,\n           i_rq_inout_remark,\n           i_rq_filepath,\n           i_usercode,\n           '1',\n           i_usercode,\n           sysdate);\n      \n        update thjs.tb_projlist_main p\n           set p.rquiet_id = v_inout_id_next\n         where p.projid = i_projid;\n      \n      end if;\n    \n    end if;\n  \n    --出静默\n    if v_cq_inout_date is not null then\n    \n      if v_cq_id is not null then\n        update thjs.tb_projlist_inout i\n           set i.inout_date   = v_cq_inout_date,\n               i.inout_reason = i_cq_inout_reason,\n               i.inout_remark = i_cq_inout_remark,\n               i.filepath     = i_cq_filepath,\n               i.update_user  = i_usercode,\n               i.update_time  = sysdate\n         where i.inout_id = v_cq_id;\n      \n      else\n      \n        insert into thjs.tb_projlist_inout\n          (busidate,\n           batch_id,\n           inout_id,\n           projid,\n           inout_type,\n           inout_direct,\n           fill_date,\n           inout_date,\n           inout_reason,\n           inout_remark,\n           filepath,\n           inout_user,\n           inout_status,\n           update_user,\n           update_time)\n        values\n          (v_tradedate,\n           v_batch_id,\n           v_inout_id_third,\n           i_projid,\n           'q',\n           'o',\n           v_tradedate,\n           v_cq_inout_date,\n           i_cq_inout_reason,\n           i_cq_inout_remark,\n           i_cq_filepath,\n           i_usercode,\n           '1',\n           i_usercode,\n           sysdate);\n      \n        update thjs.tb_projlist_main p\n           set p.cquiet_id = v_inout_id_third\n         where p.projid = i_projid;\n      \n      end if;\n    \n    end if;\n  \n    commit;\n  \n  end if;\n\n  --因关联信息存在置空情况，故关联信息批次代码fill_id应主动清空。并由关联信息修改sp去更新\n  update thjs.tb_projlist_main p\n     set p.multistk_id = ''\n   where p.projid = i_projid;\n  commit;\n\n  --由于实际操作日期与出入单发生日期（页面输入）不一定一致，需根据清单各阶段日期取值，重新计算状态字段\n  merge into thjs.tb_projlist_main p\n  using (select t.projid,\n                t.projname,\n                t.ro_inout_date,\n                t.co_inout_date,\n                t.rl_inout_date,\n                t.cl_inout_date,\n                t.rq_inout_date,\n                t.cq_inout_date,\n                case\n                  when (t.ro_inout_date is not null and\n                       t.ro_inout_date <= to_char(sysdate, 'yyyy-MM-dd')) and\n                       (t.co_inout_date is null or\n                       t.co_inout_date > to_char(sysdate, 'yyyy-MM-dd')) and\n                       t.rl_inout_date is null and t.rq_inout_date is null then\n                   'ro'\n                  when (t.rl_inout_date is null or\n                       t.rl_inout_date > to_char(sysdate, 'yyyy-MM-dd')) and\n                       (t.co_inout_date is not null and\n                       t.co_inout_date <= to_char(sysdate, 'yyyy-MM-dd')) and\n                       (t.rq_inout_date is null or\n                       t.rq_inout_date > to_char(sysdate, 'yyyy-MM-dd')) then\n                   'co'\n                  when (t.rl_inout_date is not null and\n                       t.rl_inout_date <= to_char(sysdate, 'yyyy-MM-dd')) and\n                       (t.cl_inout_date is null or\n                       t.cl_inout_date > to_char(sysdate, 'yyyy-MM-dd')) then\n                   'rl'\n                  when (t.rq_inout_date is null or\n                       t.rq_inout_date > to_char(sysdate, 'yyyy-MM-dd')) and\n                       (t.cl_inout_date is not null and\n                       t.cl_inout_date <= to_char(sysdate, 'yyyy-MM-dd')) and\n                       t.rq_inout_date is null then\n                   'cl'\n                  when (t.rq_inout_date is not null and\n                       t.rq_inout_date <= to_char(sysdate, 'yyyy-MM-dd')) and\n                       (t.cq_inout_date is null or\n                       t.cq_inout_date > to_char(sysdate, 'yyyy-MM-dd')) then\n                   'rq'\n                  when t.cq_inout_date is not null and\n                       t.cq_inout_date <= to_char(sysdate, 'yyyy-MM-dd') then\n                   'cq'\n                  else\n                   '0'\n                end as calc_status,\n                t.projlist_status\n           from THJS.VW_PROJLIST_MAIN_INOUT t\n          where t.projid = i_projid) t\n  on (p.projid = t.projid)\n  when matched then\n    update set p.projlist_status = t.calc_status;\n  commit;\n\n  --刷新清单所有入出单记录检查结果\n  merge into thjs.tb_projlist_check c\n  using (select i.busidate,\n                i.projid,\n                i.inout_id,\n                case\n                  when date_diff <= 0 then\n                   '0'\n                  else\n                   '1'\n                end as check_flag,\n                case\n                  when date_diff < 0 then\n                   '早' || cast(abs(i.date_diff) as int) || '天'\n                  when date_diff = 0 then\n                   '准确'\n                  else\n                   '晚' || cast(abs(i.date_diff) as int) || '天'\n                end as check_result\n           from (select i.*,\n                        to_date(i.fill_date, 'yyyy-MM-dd') -\n                        to_date(i.inout_date, 'yyyy-MM-dd') as date_diff\n                   from thjs.tb_projlist_inout i\n                  where i.projid = i_projid) i) i\n  on (c.projid = i.projid and c.inout_id = i.inout_id)\n  when matched then\n    update set c.check_flag = i.check_flag, c.check_result = i.check_result\n  when not matched then\n    insert\n      (BUSIDATE,\n       PROJID,\n       INOUT_ID,\n       CHECK_FLAG,\n       CHECK_RESULT,\n       CHECK_USER,\n       CREATE_TIME)\n    values\n      (i.busidate,\n       i.projid,\n       i.inout_id,\n       i.check_flag,\n       i.check_result,\n       'admin',\n       sysdate);\n\n  commit;\n\n  o_return_msg  := '执行成功';\n  o_return_code := 0;\n\n  /*insert into thjs.tb_test\n    (id, text)\n  values\n    (95, o_return_msg || '-' || o_return_code);*/\n\nexception\n  -- 非预定义异常处理\n  when v_userexp then\n    rollback;\n  \n    v_sqlerrm := sqlerrm;\n    v_sqlcode := sqlcode;\n    v_sqlerrl := dbms_utility.format_error_backtrace();\n  \n    thjs.p_write_error_log(i_tradedate    => v_tradedate,\n                            i_exec_func_id => v_exec_func_id,\n                            i_func_own     => v_func_own,\n                            i_func_name    => v_func_name,\n                            i_occur_time   => sysdate,\n                            i_sqlerrm      => v_sqlerrm,\n                            i_sqlcode      => v_sqlcode,\n                            i_sqlerrl      => v_sqlerrl);\n    commit;\n    raise;\n    -- 预定义异常处理\n  when others then\n    rollback;\n  \n    v_sqlerrm := sqlerrm;\n    v_sqlcode := sqlcode;\n    v_sqlerrl := dbms_utility.format_error_backtrace();\n  \n    thjs.p_write_error_log(i_tradedate    => v_tradedate,\n                            i_exec_func_id => v_exec_func_id,\n                            i_func_own     => v_func_own,\n                            i_func_name    => v_func_name,\n                            i_occur_time   => sysdate,\n                            i_sqlerrm      => v_sqlerrm,\n                            i_sqlcode      => v_sqlcode,\n                            i_sqlerrl      => v_sqlerrl);\n    commit;\n    raise;\nend;\n\n"
  },
  "_icon": "module"
}