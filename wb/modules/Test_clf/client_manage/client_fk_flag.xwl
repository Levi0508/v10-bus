  "text": "module",
  "cls": "Wb.Module",
  "properties": {
    "cid": "module",
    "serverScript": "Wb.sendRowx({\n  sql: `select case\n  when count(1) > 0 then\n  '1' \n  else '0' \n  end as fk_flag\n    from basic_thjs.wb_user u\n   inner join basic_thjs.wb_user_role r\n      on u.staff_id = r.user_id\n     and r.role_id = 'fxqrisk-th'\n   where u.user_name = {?I_USER_NAME?};`\n});"
  },
  "_icon": "module"
}