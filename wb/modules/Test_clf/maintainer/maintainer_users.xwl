{
  "title": "查询可选维护人",
  "icon": "",
  "img": "",
  "tags": "",
  "hideInMenu": "true",
  "text": "module",
  "cls": "Wb.Module",
  "properties": {
    "cid": "module",
    "serverScript": "Wb.sendRowx(`select u.user_id, u.user_name, u.display_name, u.staff_id,\nu.staff_id || ' - ' || u.display_name || '(' || u.user_name || ')' as textfield\nfrom basic_thjs.wb_user u\nwhere ({?query?} is null or instr(u.user_id, {?query?}) > 0 or\n  instr(u.user_name, {?query?}) > 0 or\n  instr(u.display_name, {?query?}) > 0 or\n  instr(u.staff_id, {?query?}) > 0) \nand u.user_name != 'admin'\nand exists (select 1\nfrom basic_thjs.wb_user_role r\nwhere r.role_id = 'fxqtb-th'\nand r.user_id = u.sid)\norder by u.user_name;`);\n\n// Wb.sendRowx(`select u.user_id, u.user_name, u.display_name, u.staff_id\n// from basic_th.wb_user u\n// where ({?query?} is null or instr(u.user_id, {?query?}) > 0 or\n// instr(u.user_name, {?query?}) > 0 or\n// instr(u.display_name, {?query?}) > 0 or\n// instr(u.staff_id, {?query?}) > 0)\n// and exists (select 1\n// from basic_th.wb_user_role r\n// where r.role_id = 'fxqtb-th'\n// and r.user_id = u.user_id)\n// order by u.user_name;`);\n"
  },
  "_icon": "module"
}