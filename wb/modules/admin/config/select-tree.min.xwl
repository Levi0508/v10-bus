{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","remark":"Select config folder items","serverScript":"function main(){let e=[],n=Config.getBuffer();n.forEach((n=>e.push(n.beforeItem(\".\"))));e=Wb.Builder.getTree(e,\".\");e.find((e=>e.text==\"sys\"))._expanded=true;Wb.send(e)}main();"},"_icon":"module"}