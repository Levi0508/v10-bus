{"title":"@console","icon":"console","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","remark":"System console"},"_icon":"module","_expanded":true,"events":{"initialize":"Wb.apply(app,{consoleSize:100,totalSize:0,allowScroll:false,cardVisible:true,toBottom(e){if(e||app.allowScroll&&app.toBottomItem.active){let e=app.viewer1.el;e.scrollTop=e.scrollHeight;app.allowScroll=false}},addData(e){let t=app.viewer1,a=t.el,l=app.consoleSize*1024,o;o=a.addTag(\"span\");o.textContent=e;o.xSize=Math.max(e.length,100);app.totalSize+=o.xSize;if(app.totalSize>l){let e=a.children,t,i=e.length;for(t=0;t<i;t++){o=e[t];app.totalSize-=o.xSize;o.remove();t--;i--;if(app.totalSize<l)break}}app.allowScroll=true;if(app.cardVisible){app.toBottom()}}});Wb.make(app,{cname:\"socket\",name:\"$console\",xwl:\"admin/console/socket.xwl\",cid:\"socket1\",events:{message(e,t){app.addData(e.data)}}});Wb.make(app,{cname:\"viewport\",layout:\"fit\",autoScroll:true,cid:\"viewport1\",tbar:{cname:\"toolbar\",items:[{icon:\"recycle\",text:Str.clear,cid:\"clearItem\",events:{click(e,t){app.viewer1.el.clearChildren();app.totalSize=0}}},{cname:\"divider\",cid:\"divider1\"},{icon:\"property\",text:Str.size,cid:\"sizeItem\",menu:{cname:\"menu\",items:[{cname:\"container\",layout:\"row\",gap:\".5em\",width:\"15em\",cid:\"container1\",items:[{cname:\"slider\",minValue:100,maxValue:1e4,flex:1,tabIndex:null,focusable:false,step:100,value:app.consoleSize,cid:\"sizeSlider\",events:{change(e,t,a){app.consoleSize=e}}},{cname:\"label\",text:\"KB\",cid:\"kbLabel\"}]}]}},{cname:\"fill\",cid:\"fill1\"},{activeBgColor:false,icon:\"bottom\",active:true,tip:\"Auto scroll to bottom\",cid:\"toBottomItem\",events:{toggle(e,t){if(e)app.toBottom(true)}}}]},events:{ready(e,t){parentContainer?.on(\"show\",(e=>{app.cardVisible=true;app.toBottom()}));parentContainer?.on(\"hide\",(e=>{app.cardVisible=false}))}},items:[{cname:\"viewer\",cls:\"w-pre w-lh\",cid:\"viewer1\"}]});"}}