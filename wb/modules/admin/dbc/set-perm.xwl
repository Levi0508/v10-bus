{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"let actions = {\n  /**\n   * 获取权限数据。\n   */\n  getPerms() {\n    Wb.send(Wb.getAllRows('select role_id from wb_db_perm where source_name={?varchar|name?}').pluck('role_id'));\n  },\n  /**\n   * 设置权限数据。\n   */\n  setPerms() {\n    let insert = [], source_name = Params.name;\n\n    Wb.getObject('roles').forEach(role => {\n      insert.push({ sid: Wb.getId(), source_name, role_id: role });\n    });\n    Wb.startTrans();\n    Wb.sql('delete from wb_db_perm where source_name={?varchar|name?}');\n    Wb.sync({ tableName: 'wb_db_perm', insert });\n  }\n};\nactions[Params.xaction]();"},"_icon":"module"}