{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","remark":"Import data to table","serverScript":"function main(){const a=Wb.load(\"./util.mjs\");switch(Wb.getFileExt(Params.file.name)){case\"wbt\":a.importWbTable();break;case\"xls\":case\"xlsx\":a.importExcel();break;case\"txt\":case\"csv\":a.importText();break}}main();"},"_icon":"module"}