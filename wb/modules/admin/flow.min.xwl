{"title":"@flowMng","icon":"flow1","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","remark":"Workflow management tool","serverScript":"function main(){Params.flowPathLength=new Wb.File(true,\"wb/system/resource/flow\").path.length}main();","links":"[\"wb/libs/x6.js\",\"wb/js/flow-designer.js\",\"wb/js/monaco.js\"]"},"_icon":"module","_expanded":true,"events":{"initialize":"Wb.define(app,{basePath:\"|wb/system/resource/flow\",getFileUrl:\"m?xwl=sys/file/get-resource\",get$graph(){return app.tab1.activeCard?.graph},get$inInput(){return document.activeElement.isInput},get$flowDesigner(){return app.tab1.activeCard?.flowDesigner},get$activeCard(){return app.tab1.activeCard},flowPathLength:_$flowPathLength$_,newFile(){Wb.promptFile(((e,t)=>{if(!e.endsWith(\".flw\"))e+=\".flw\";Wb.ajax({url:\"m?xwl=sys/file/add\",params:{fullname:e},json:true,success(e){app.createCard(null,e.path,e.lastModified.dateValue.getTime());t.close()}})}),app.basePath,\".flw\",Str.addFile,false,app.getFileUrl)},openFile(){Wb.promptFiles(((e,t)=>{e.forEach((e=>app.doOpenFile(e)));t.close()}),app.basePath,\".flw\",Str.selectFile,app.getFileUrl)},findCard(e){return this.tab1.findBy((t=>t.path==e))},doOpenFile(e,t){let a=app.findCard(e);if(a){a.show();t?.call(app,a)}else{Wb.ajax({url:\"m?xwl=sys/file/open-resource\",params:{path:e,charset:\"UTF-8\"},success(i){let l,p,s;l=i.indexOf(\"|\");p=i.substr(0,l);s=i.substr(l+1);if(s)s=Wb.decode(s);app.createCard(s,e,p);t?.call(app,a)}})}},createCard(e,t,a){let i,l,p,s=this;if(Wb.isString(a))a=parseInt(a);if(t){p=Wb.getFilename(t);l=t.substr(app.flowPathLength+1)}else{app.fileIndex??=1;p=Str.new+\" - \"+app.fileIndex++;l=undefined}i=app.tab1.add({title:p,tabTip:l,path:t,lastModified:a,icon:\"flow1\",layout:\"fit\",events:{beforeclose(){return this.confirmClose(s.saveCard,s)}},items:{cname:\"flowDesigner\",cid:\"designerComp\",events:{change(){app.setModified(this.parent)}}}});i.flowDesigner=i.down(\"designe