{"title":"修改","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","_expanded":true,"properties":{"cid":"module","serverScript":"let actions = {\n  /**\n   * 添加记录。\n   */\n  add() {\n    let rec = { sid: Params.sid || Wb.getId() };\n\n    Wb.set(rec);\n    Wb.sync({ tableName: 'WB_MENU', insert: Params });\n    Wb.send(rec);\n  },\n  /**\n   * 修改记录。\n   */\n  edit() {\n    Wb.sync({ tableName: 'WB_MENU', update: Params });\n  },\n  /**\n   * 删除记录。\n   */\n  del() {\n    let del = Wb.getObject('del');\n\n    Wb.sync({ tableName: 'WB_MENU', del });\n  }\n};\nactions[Params.xaction]();"},"_icon":"module","items":[]}