{"title":"@onlineUsers","icon":"earth","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","remark":"View online users"},"_icon":"module","_expanded":true,"events":{"initialize":"Wb.make(app,{cname:\"viewport\",layout:\"column\",cid:\"viewport1\",items:[{cname:\"grid\",autoSelect:true,flex:1,textSelectable:true,url:xpath+\"/select-users\",cid:\"userGrid\",multiSelect:true,columns:[{cname:\"column\",rowNum:true,cid:\"rowCol\"},{cname:\"column\",fieldName:\"username\",width:\"12em\",text:Str.username,render(e,t,i,c){let m=t.sessions;if(m>1)return e+\" (\"+m+\")\";else return e},cid:\"usernameCol\"},{cname:\"column\",fieldName:\"dispname\",width:\"12em\",text:Str.displayName,cid:\"dispnameCol\"},{cname:\"column\",fieldName:\"ip\",width:\"18em\",text:Str.ip,cid:\"ipCol\"},{cname:\"column\",fieldName:\"createTime\",width:\"13em\",text:Str.createTime,cid:\"createTimeCol\"},{cname:\"column\",fieldName:\"lastAccessTime\",width:\"13em\",text:Str.lastAccessTime,cid:\"lastAccessTimeCol\"}],tbar:{cname:\"toolbar\",items:[{icon:\"delete\",text:Str.logout,cid:\"delItem\",events:{click(e,t){app.userGrid.removeRecords(xpath+\"/remove-sessions\",\"username\",null,null,null,Str.logout)}}}]},events:{selectionchange(e){let t=this.selection?.data.userid;if(t)app.sessionGrid.load({params:{userid:t}})}}},{cname:\"splitter\",cid:\"splitter1\"},{cname:\"grid\",autoLoad:false,textSelectable:true,url:xpath+\"/select-sessions\",cid:\"sessionGrid\",height:\"14em\",columns:[{cname:\"column\",rowNum:true,cid:\"rowCol\"},{cname:\"column\",fieldName:\"ip\",width:\"18em\",text:Str.ip,cid:\"ipCol\"},{cname:\"column\",fieldName:\"createTime\",width:\"13em\",text:Str.createTime,cid:\"createTimeCol\"},{cname:\"column\",fieldName:\"lastAccessTime\",width:\"13em\",text:Str.lastAccessTime,cid:\"lastAccessTimeCol\"}]}]});"}}