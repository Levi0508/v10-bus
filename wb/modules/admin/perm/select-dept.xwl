{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"function toNestedTree(flatData) {\n  const data = JSON.parse(JSON.stringify(flatData));\n  const nodeMap = new Map();\n  data.forEach(node => {\n    nodeMap.set(node.sid, node);\n    node.items = [];\n  });\n  const deptNodes = [];\n  data.forEach(node => {\n    const parentId = node.parent_id;\n    if (parentId == '0' || !parentId) {\n      deptNodes.push(node);\n    } else {\n      const parentNode = nodeMap.get(parentId);\n      if (parentNode) {\n        parentNode.items.push(node);\n      } else {\n        deptNodes.push(node);\n      }\n    }\n    delete node.parent_id;\n  })\n  function cleanLeaf(node) {\n    if (node.items && node.items.length > 0) {\n      delete node._leaf;\n      node.items.forEach(child => cleanLeaf(child));\n    } else {\n      delete node.items;\n    }\n  }\n  deptNodes.forEach(node => cleanLeaf(node));\n  return deptNodes;\n}\n\nfunction filterTree(data, text) {\n  let filterData = [];\n  data.each(node => {\n    if (!node.dept_name) return\n    if (node.dept_name.includes(text)) {\n      filterData.push(node);\n    } else {\n      if (!node._leaf) {\n        filterData.push(...filterTree(node.items, text));\n      }\n    }\n  })\n  return filterData;\n}\n\nfunction main() {\n  let sql, data, rolesMap = {}, roles, items;\n  sql = `\n        select 'true' as \"_leaf\", 'folder1' as \"_icon\", a.dept_name, a.dept_name as text, a.dept_id, a.sid, a.parent_id, b.sid as user_id,\n        b.display_name as manager_name from wb_dept a left join wb_user b on a.manager_id=b.sid where a.dept_name is not null\n        `;\n  // if (Params.search4) {\n  //   Wb.setLike('search4');\n  //   sql += ' where a.dept_name like {?search4?} or a.dept_code like {?search4?} or a.sid like {?search4?}';\n  // }\n  sql += Wb.getOrderSql({ manager_name: 'b.display_name' });\n  data = Wb.sql({sql, rs: -1});\n\n  Wb.getRows('select dept_id,role_id from wb_data_role', row => {\n    roles = rolesMap[row.dept_id] ??= [];\n    roles.push(row.role_id);\n  });\n  items = [{ text:'集团', dept_name: '集团',dept_code: '集团', _expanded: true, items: toNestedTree(data.items)}];\n  Wb.log(rolesMap)\n  Wb.cascade(items, item => {\n    item.roles = rolesMap[item.dept_code];\n  });\n  if (Params.search4) {\n    items = filterTree(items, Params.search4);\n  }\n\n  Wb.send(items);\n}\nmain();"},"_icon":"module"}