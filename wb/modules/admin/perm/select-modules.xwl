{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","remark":"Select modules","serverScript":"function filterTree(data, text) {\n  let filterData = [];\n  data.each(node => {\n    if (!node.text) return\n    if (node.text.includes(text)) {\n      filterData.push(node);\n    } else {\n      if (!node._leaf) {\n        filterData.push(...filterTree(node.items, text));\n      }\n    }\n  })\n  return filterData;\n}\n\nfunction filterTreeByText(treeData, filterKeywords) {\n  const data = JSON.parse(JSON.stringify(treeData));\n  const recursionFilter = (nodes) => {\n    const filteredNodes = nodes.filter(node => !filterKeywords.includes(node.remark || node.text));\n    filteredNodes.forEach(node => {\n      if (Array.isArray(node.items) && node.items.length > 0) {\n        node.items = recursionFilter(node.items);\n      }\n    });\n    return filteredNodes;\n  };\n  return recursionFilter(data);\n}\n\nfunction filterDataByKeyword(data, keyword) {\n  function processNode(node) {\n    if (keyword.includes(node.text || node.remark)) {\n      return { ...node };\n    }\n    if (node.items && node.items.length > 0) {\n      const filteredItems = node.items.map(item => processNode(item)).filter(item => item !== null);\n      if (filteredItems.length > 0) {\n        return {\n          ...node,\n          items: filteredItems\n        };\n      }\n    }\n    return null;\n  }\n  const filteredData = data.map(node => processNode(node)).filter(node => node !== null);\n  return filteredData;\n}\n\nfunction main() {\n  const fs = Wb.load('wb/modules/sys/file/fs.mjs');\n  let items, rolesMap = {}, roles;\n\n  Wb.getRows('select module_path,role_id from wb_perm', row => {\n    roles = rolesMap[row.module_path] ??= [];\n    roles.push(row.role_id);\n  });\n  items = [{ text: Str.all, _expanded: true, items: fs.listPermModules() }];\n  Wb.cascade(items, item => {\n    if (item._leaf) {\n      item.roles = rolesMap[item.path];\n    }\n  });\n  if (Params.search2) {\n    items = filterTree(items, Params.search2);\n  }\n  Wb.log(items)\n    Wb.log(Params.appMode)\n    Wb.log(\"---------\")\n  if (Params.appMode) {\n    items = filterTreeByText(items, ['operation']);\n    \n    items = filterDataByKeyword(items, Wb.decode(Params.appMode));\n  }\n  Wb.send(items);\n}\nmain();"},"_icon":"module"}