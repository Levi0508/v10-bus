{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","remark":"Select roles","serverScript":"function toNestedTree(flatData) {\n  const data = JSON.parse(JSON.stringify(flatData));\n  const nodeMap = new Map();\n  data.forEach(node => {\n    nodeMap.set(node.sid, node);\n    node.items = [];\n  });\n  const roleNodes = [];\n  data.forEach(node => {\n    const parentId = node.parent_role_id;\n    if (!parentId) {\n      roleNodes.push(node);\n    } else {\n      const parentNode = nodeMap.get(parentId);\n      if (parentNode) {\n        parentNode.items.push(node);\n      } else {\n        roleNodes.push(node);\n      }\n    }\n    delete node.parent_role_id;\n  })\n  function cleanLeaf(node) {\n    if (node.items && node.items.length > 0) {\n      delete node._leaf;\n      node._expanded = false;\n      node.items.forEach(child => cleanLeaf(child));\n    } else {\n      delete node.items;\n    }\n  }\n  roleNodes.forEach(node => cleanLeaf(node));\n  return roleNodes;\n}\n\nfunction classifyByRoleClass(data) {\n  const groupMap = {};\n  data.forEach(item => {\n    const key = String(item.role_class); \n    if (!groupMap[key]) {\n      groupMap[key] = [];\n    }\n    groupMap[key].push(item);\n  });\n  const result = Object.entries(groupMap).map(([classKey, items]) => ({\n    text: classKey, \n    _expanded: false, \n    _fixed: true,  \n    items: items \n  }));\n  return result;\n}\n\nfunction main() {\n  let data;  \n  if (Params.search5) {\n    Wb.setLike('search5');\n    data = Wb.sql({\n      sql: `select role_class, role_type, parent_role_id, role_id as sid,role_name as text` + (Params.check ? `,0 as \"_checked\"` : '') +\n      `,'true' as \"_leaf\" from wb_role where role_name like {?search5?} order by role_name`,\n      rs: -1\n    });\n  } else {\n    data = Wb.sql({\n      sql: `select role_class, role_type, parent_role_id, role_id as sid,role_name as text` + (Params.check ? `,0 as \"_checked\"` : '') +\n      `,'true' as \"_leaf\" from wb_role order by role_name`,\n      rs: -1\n    });\n  }\n  let allrole = toNestedTree(data.items)?.filter(item => item.role_type);\n  Wb.send([{\"text\":\"数据角色\",\"_expanded\":true,\"_fixed\":true,\"items\": classifyByRoleClass(allrole)}]);\n}\n\nmain();"},"_icon":"module"}