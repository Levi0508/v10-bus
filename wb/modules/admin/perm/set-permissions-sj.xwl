{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","remark":"Set permissions","serverScript":"// function main() {\n//   let modules = Params.modules, oldModules, roleId = Params.roleId, checked = Wb.getBool('checked'),\n//     roles = Wb.roles, isAdmin = roles.includes('admin');\n\n//   if (!roleId || !isAdmin && roles.includes(roleId))\n//     Wb.raise('You are not allowed to set your own permissions. Please contact the administrator.');\n//   Wb.startTrans();\n//   if (checked) {\n//     let insert = [];\n//     oldModules = Wb.getAllRecords('select dept_id from wb_data_role where role_id={?roleId?}').pluck(0);\n//     modules = modules.diff(oldModules);\n//     modules.forEach(item => {\n//       insert.push({ sid: Wb.getId(), dept_id: item, role_id: roleId });\n//     });\n//     Wb.sync({ tableName: 'wb_data_role', insert });\n//   } else {\n//     let del = [];\n\n//     modules.forEach(item => {\n//       del.push({ $dept_id: item, $role_id: roleId });\n//     });\n//     Wb.sync({ tableName: 'wb_data_role', del, whereFields: 'dept_id,role_id', unique: false });\n//   }\n// }\n// main();\n\nfunction main() {\n  let modules = Params.modules, oldModules, roleId = Params.roleId, checked = Wb.getBool('checked'),\n    roles = Wb.roles, isAdmin = roles.includes('admin');\n\n  if (!roleId || !isAdmin && roles.includes(roleId))\n    Wb.raise('You are not allowed to set your own permissions. Please contact the administrator.');\n  Wb.startTrans();\n  if (checked) {\n    let insert = [];\n    oldModules = Wb.getAllRecords('select dept_id from wb_data_role where role_id={?roleId?}').pluck(0);\n    modules = modules.diff(oldModules);\n    Wb.log(1111)\n    Wb.log(modules)\n    // Wb.log(insert)\n    modules.forEach(item => {\n      insert.push({ sid: Wb.getId(), dept_id: item, role_id: roleId });\n    });\n    Wb.sync({ tableName: 'wb_data_role', insert });\n  } else {\n    let del = [];\n    Wb.log(22222)\n    Wb.log(modules)\n    // Wb.log(del)\n    modules.forEach(item => {\n      del.push({ $dept_id: item, $role_id: roleId });\n    });\n    Wb.sync({ tableName: 'wb_data_role', del, whereFields: 'dept_id,role_id', unique: false });\n  }\n}\nmain();"},"_icon":"module"}