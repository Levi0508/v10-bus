{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","remark":"Set permissions","serverScript":"function main(){let e=Params.modules,r,o,t=Params.roleId,a=Wb.getBool(\"checked\"),l=Wb.roles,i,s=l.includes(\"admin\");if(!t||!s&&l.includes(t))Wb.raise(\"You are not allowed to set your own permissions. Please contact the administrator.\");Wb.startTrans();if(a){let a=[];r=Wb.getAllRecords(\"select module_path from wb_perm where role_id={?roleId?}\").pluck(0);e=e.diff(r);e.forEach((e=>{i=e+\".xwl\";o=new Wb.File(Wb.File.moduleFolder,i);if(!o.exists)Wb.raise(Str.notExists.format(e));if(!s&&!Perm.permit(i,l))Wb.raise(Str.notHavePerm.format(i));a.push({sid:Wb.getId(),module_path:e,role_id:t})}));Wb.sync({tableName:\"wb_perm\",insert:a});e.forEach((e=>Perm.put(e,t)))}else{let r=[];e.forEach((e=>{i=e+\".xwl\";if(!s&&!Perm.permit(i,l))Wb.raise(Str.notHavePerm.format(i));r.push({$module_path:e,$role_id:t})}));Wb.sync({tableName:\"wb_perm\",del:r,whereFields:\"module_path,role_id\",unique:false});e.forEach((e=>Perm.remove(e,t)))}}main();"},"_icon":"module"}