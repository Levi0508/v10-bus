{"title":"@roleConfig","icon":"role","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","remark":"Add role"},"_icon":"module","_expanded":true,"events":{"initialize":"Wb.apply(app, {\n  /**\n   * Load the specified box data. @priv\n   * @param {Wb.DualBox} box Dual box component.\n   */\n  loadBoxData(box) {\n    if (!box.visible)\n      return;\n    let data = app.selectedData, srcGrid, destGrid, configs;\n\n    box.disabled = !data || box == app.moduleBox && data?.sid == 'admin';\n    srcGrid = box.sourceGrid;\n    destGrid = box.destGrid;\n    srcGrid.subTitle = destGrid.subTitle = data ? data.role_name : Str.notSelected;\n    if (data) {\n      configs = { params: { role_id: data.sid } };\n      srcGrid.load(configs);\n      destGrid.load(configs);\n    } else {\n      srcGrid.destroyAll();\n      destGrid.destroyAll();\n    }\n  }\n});"},"items":[{"_icon":"window","text":"addWin","cls":"Wb.Window","_expanded":false,"properties":{"cid":"addWin","resetDialog":"true","icon":"add","title":"添加角色","layout":"form1","width":"45em"},"items":[{"cls":"Wb.Text","properties":{"cid":"role_name","required":"true","text":"角色名称"},"text":"role_name","_expanded":true,"_icon":"text","hasDupCid":1},{"_icon":"switcher-on","text":"status","cls":"Wb.Toggle","properties":{"cid":"status","required":"true","text":"启用"},"hasDupCid":1,"_expanded":true},{"cls":"Wb.Text","properties":{"cid":"role_id","required":"true","text":"角色ID"},"text":"role_id","_expanded":true,"_icon":"text","hasDupCid":1},{"_icon":"combo","text":"role_type","cls":"Wb.Select","properties":{"cid":"role_type","keyName":"roleType","required":"true","text":"角色类别"},"hasDupCid":1,"_expanded":true},{"_icon":"combo","text":"role_class","cls":"Wb.Select","properties":{"cid":"role_class","keyName":"roleClass","required":"true","text":"角色分类"},"hasDupCid":1},{"cls":"Wb.Text","properties":{"cid":"parent_role_id","text":"父角色"},"text":"parent_role_id","_expanded":true,"_icon":"text"