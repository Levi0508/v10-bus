{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","remark":"Get users by role","serverScript":"let sql;\n\nif (Wb.getBool('inRole')) {\n  sql = `select sid,user_name,display_name from wb_user where sid in\n         (select user_id from wb_user_role where role_id={?role_id?})`;\n} else {\n  sql = `select sid,user_name,display_name from wb_user where sid not in\n         (select user_id from wb_user_role where role_id={?role_id?})`;\n}\nif (Params.search) {\n  Wb.setLike('search');\n  sql += ' and (user_name like {?search?} or display_name like {?search?})';\n}\nWb.sendRows(sql);"},"_icon":"module"}