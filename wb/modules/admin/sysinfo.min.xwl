{"title":"@sysinfo","icon":"system","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","remark":"View system information"},"_icon":"module","_expanded":true,"events":{"initialize":"Wb.make(app,{cname:\"grid\",textSelectable:true,pagingBar:false,reserveScrollbar:true,url:xpath+\"/select\",cid:\"grid1\",full:true,tbar:{cname:\"toolbar\",items:[{icon:\"refresh\",text:Str.refresh,cid:\"refreshItem\",events:{click(e,a){app.grid1.reload()}}},{cname:\"divider\",cid:\"divider1\"},{cname:\"toggle\",tip:Str.autoRefresh,cid:\"toggle1\",events:{change(e,a,r){if(e){app.autoRefreshTimer=setInterval((e=>{let a=app.grid1;if(!a.loading)a.reload()}),2e3)}else{clearInterval(app.autoRefreshTimer)}}}}]},columns:[{cname:\"column\",rowNum:true,cid:\"rowNumCol\"},{cname:\"column\",fieldName:\"name\",width:\"16em\",text:Str.name,cid:\"nameCol\"},{cname:\"column\",fieldName:\"value\",width:-1,text:Str.value,autoWrap:\"break-all\",cid:\"valueCol\"}],events:{destroy(e){clearInterval(app.autoRefreshTimer)}}});"}}