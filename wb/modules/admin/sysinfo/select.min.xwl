{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","remark":"Select system information","serverScript":"Wb.checkDemo();function main(){let e=[],a=Runtime.getRuntime(),r=System.getProperties(),t=System.getenv(),o=Classes.InetAddress.getLocalHost(),n=a.totalMemory(),m=a.freeMemory();e=[{name:\"Current Time\",value:(new Date).format(Str.dateTimeFormat)},{name:\"System startup time\",value:new Date(Base.startTime.getTime()).format(Str.dateTimeFormat)},{name:\"Total Memory\",value:n.mb},{name:\"Used Memory\",value:(n-m).mb},{name:\"Free Memory\",value:m.mb},{name:\"Max Memory\",value:a.maxMemory().mb},{name:\"Available Processors\",value:a.availableProcessors().intText},{name:\"Username\",value:t?.get(\"USERNAME\")},{name:\"Computer Name\",value:t?.get(\"COMPUTERNAME\")},{name:\"User Domain\",value:t?.get(\"USERDOMAIN\")},{name:\"Host Address\",value:o.getHostAddress()},{name:\"Host Name\",value:o.getHostName()},{name:\"OS Name\",value:r.getProperty(\"os.name\")},{name:\"OS Architecture\",value:r.getProperty(\"os.arch\")},{name:\"OS Version\",value:r.getProperty(\"os.version\")},{name:\"Java Version\",value:r.getProperty(\"java.version\")},{name:\"Java Vendor\",value:r.getProperty(\"java.vendor\")},{name:\"Java Vendor URL\",value:r.getProperty(\"java.vendor.url\")},{name:\"Java Home\",value:r.getProperty(\"java.home\")},{name:\"Java VM Specification Version\",value:r.getProperty(\"java.vm.specification.version\")},{name:\"Java VM Specification Vendor\",value:r.getProperty(\"java.vm.specification.vendor\")},{name:\"Java VM Specification Name\",value:r.getProperty(\"java.vm.specification.name\")},{name:\"Java VM Version\",value:r.getProperty(\"java.vm.version\")},{name:\"Java VM Vendor\",value:r.getProperty(\"java.vm.vendor\")},{name:\"Java VM Name\",value:r.getProperty(\"java.vm.name\")},{name:\"Java Specification Version\",value:r.getProperty(\"java.specification.version\")},{name:\"Java Specification Vendor\",value:r.getProperty(\"java.specification.vendor\")},{name:\"Java Specification Name\",value:r.getProperty(\"java.specification.name\")},{name:\"Java Class Version\",value:r.getProperty(\"java.class.version\")},{name:\"Java Class Path\",value:r.getProperty(\"java.class.path\")},{name:\"Java Library Path\",value:r.getProperty(\"java.library.path\")},{name:\"File Separator\",value:Wb.encode(r.getProperty(\"file.separator\"))},{name:\"Path Separator\",value:Wb.encode(r.getProperty(\"path.separator\"))},{name:\"Line Separator\",value:Wb.encode(r.getProperty(\"line.separator\"))},{name:\"User Account Name\",value:r.getProperty(\"user.name\")},{name:\"User Home Directory\",value:r.getProperty(\"user.home\")},{name:\"User Directory\",value:r.getProperty(\"user.dir\")},{name:\"Java Extension Directories\",value:r.getProperty(\"java.ext.dirs\")},{name:\"Java Temp Directory\",value:r.getProperty(\"java.io.tmpdir\")}];Wb.send(e)}main();"},"_icon":"module"}