{"title":"@taskMng","icon":"task","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"function main(){Wb.set(\"isStartup\",JobUtil.isStartup())}main();","remark":"Scheduled task management tool","links":"[\"wb/js/monaco.js\"]"},"_icon":"module","_expanded":true,"events":{"initialize":"Wb.apply(app,{isStartup:_$isStartup$_,setStatus(e){let t=app.grid1,r=t.selections;if(!r.length){Wb.tipSelect();return}r=r.filter((t=>t.data.status!=e));if(!r.length)return;Wb.ajax({url:xpath+\"/set-status\",json:true,params:{update:r.pluck(\"originData\"),status:e},success(t){r.forEach(((r,a)=>{t[a].status=e;r.update(t[a])}))}})},setStartStopBtn(){let e=app.isStartup,t=app.startStopBtn;t.icon=e?\"stop\":\"play\";t.text=e?Str.stop:Str.start}});Wb.make(app,{cname:\"window\",resetDialog:true,layout:\"form1\",width:\"70em\",tableStyle:true,icon:\"task\",cid:\"editWin\",items:[{cname:\"text\",text:Str.name,required:true,cid:\"job_name\"},{cname:\"controlCt\",layout:\"grid1\",gap:\".5em\",text:Str.interval,required:true,cid:\"intervalCt\",items:[{cname:\"radioGroup\",layout:\"row\",gap:\"2em\",cid:\"interval_type\",events:{change(e){let t=this.value;app.interval_value.visible=[0,1,2].includes(t);app.trigger_time.visible=t>2&&t<7;app.trigger_weekday.visible=t==4;app.trigger_day.visible=t==5||t==6;app.trigger_month.visible=t==6;app.cron_express.visible=t==7}},items:[{cname:\"radio\",label:Str.s,cid:\"secondRadio\"},{cname:\"radio\",label:Str.m,cid:\"minuteRadio\"},{cname:\"radio\",label:Str.h,cid:\"hourRadio\"},{cname:\"radio\",label:Str.day,cid:\"dayRadio\"},{cname:\"radio\",label:Str.week,cid:\"weekRadio\"},{cname:\"radio\",label:Str.month,cid:\"monthRadio\"},{cname:\"radio\",label:Str.year,cid:\"yearRadio\"},{cname:\"radio\",label:\"Cron\",cid:\"cronRadio\"}]},{cname:\"container\",layout:\"row\",gap:true,cid:\"valuesCt\",items:[{cname:\"number\",minValue:1,width:\"15em\",text:Str.every,decimalCount:0,required:true,cid:\"interval_value\"},{cname:\"select\",data:(e=>{let t=new Date(2022,0,1),r,a=[],i=new Intl.DateTimeFormat(Str.lang,{month:\"long\"});for(r=0;r<12;r++)a.push({text:i.format(t.addMonth(r)),value:r+1});return a})(),forceSelect:true,text:Str.month,required:true,cid:\"trigger_month\"},{cname:\"select\",data:(e=>{let t=new Date(2022,10,6),r,a=[],i=new Intl.DateTimeFormat(Str.lang,{weekday:\"long\"});for(r=0;r<7;r++)a.push({text:i.format(t.addDay(r)),value:r+1});return a})(),width:\"15em\",forceSelect:true,text:Str.week,required:true,cid:\"trigger_weekday\"},{cname:\"number\",minValue:-31,maxValue:31,width:\"10em\",validator(e){if(e==0)return Str.invalidDate.format(e)},text:Str.day,required:true,cid:\"trigger_day\"},{cname:\"time\",width:\"15em\",text:Str.time,required:true,cid:\"trigger_time\"},{cname:\"text\",flex:1,text:Str.expression,required:true,cid:\"cron_express\"}]}]},{cname:\"controlCt\",gap:true,text:Str.duration,cid:\"durationCt\",items:[{cname:\"datetime\",text:Str.from,cid:\"begin_date\"},{cname:\"datetime\",text:Str.to,cid:\"end_date\"}]},{cname:\"controlCt\",layout:\"row\",gap:\"2em\",text:Str.options,cid:\"optionCt\",items:[{cname:\"toggle\",text:Str.enabled,value:true,cid:\"status\"},{cname:\"toggle\",text:Str.concurrent,value:true,cid:\"concurrent\"},{cname:\"toggle\",text:Str.oneTimeTask,cid:\"auto_removed\"}]},{cname:\"text\",text:Str.desc,cid:\"job_desc\"},{cname:\"controlCt\",layout:\"fit\",minHeight:\"15em\",padding:0,flex:1,text:Str.script,required:true,cid:\"scriptCt\",items:[{cname:\"codeEditor\",minimap:false,required:true,cid:\"server_script\"}]}]});Wb.make(app,{cname:\"viewport\",layout:\"fit\",autoContextMenu:true,cid:\"viewport1\",tbar:{cname:\"toolbar\",items:[{keys:\"Ctrl+E\",icon:\"add\",text:Str.add,cid:\"addBtn\",events:{click(e,t){let r=app.interval_type;app.grid1.insertRecord({url:xpath+\"/add\",failure(e){Wb.checkExists(e,\"wb_job_job_name\",app.job_name)}},app.editWin);if(r.value==-1)r.value=3}}},{keys:\"Ctrl+J\",icon:\"edit\",text:Str.edit,cid:\"editBtn\",events:{click(e,t){app.grid1.editRecord({url:xpath+\"/edit\",failure(e){Wb.checkExists(e,\"wb_job_job_name\",app.job_name)}},app.editWin,\"job_name\")}}},{keys:\"Ctrl+D\",icon:\"delete\",text:Str.del,cid:\"delBtn\",events:{click(e,t){app.grid1.removeRecords(xpath+\"/del\",\"job_name\")}}},{cname:\"divider\",cid:\"divider1\"},{icon:\"pause\",text:Str.pause,cid:\"pauseBtn\",events:{click(e,t){app.setStatus(false)}}},{icon:\"resume\",text:Str.resume,cid:\"resumeBtn\",events:{click(e,t){app.setStatus(true)}}},{cname:\"divider\",cid:\"divider2\"},{cid:\"startStopBtn\",events:{ready(e,t){app.setStartStopBtn()},click(e,t){Wb.confirm(Str.doConfirm.format(app.startStopBtn.text),(e=>{Wb.ajax({url:xpath+\"/start-stop-task\",params:{status:!app.isStartup},success(){app.isStartup=!app.isStartup;app.setStartStopBtn();app.grid1.reload()}})}))}}},{cname:\"divider\",cid:\"divider3\"},{cname:\"text\",clearButton:true,flex:1,minWidth:\"5em\",placeholder:Str.search,cid:\"search\",maxWidth:\"20em\",events:{change(e,t,r){app.grid1.delayLoad({comps:app.search})}}}]},items:[{cname:\"grid\",columnsSortable:true,keyFields:\"sid,status\",stateData:\"_$004RJWJ8ZC63P$_\",stateId:\"wb.task\",sorters:\"job_name\",url:xpath+\"/select\",cid:\"grid1\",multiSelect:true,columns:[{cname:\"column\",rowNum:true,cid:\"numCol\"},{cname:\"column\",fieldName:\"job_name\",width:\"15em\",text:Str.name,render(e,t,r,a){a.insertCellIcon(t.status?t.next_time?\"play\":\"ok\":\"delete\",e)},cid:\"nameCol\"},{cname:\"column\",fieldName:\"interval_type\",width:\"17em\",text:Str.interval,align:\"left\",render(e,t,r,a){let i=t.interval_value,d=\" (\"+t.trigger_time?.timeText+\")\",n,c;switch(e){case 0:return Str.every+\" \"+i+\" \"+Str.s;case 1:return Str.every+\" \"+i+\" \"+Str.m;case 2:return Str.every+\" \"+i+\" \"+Str.h;case 3:return Str.every+' \"'+Str.day+'\" '+d;case 4:n=t.trigger_weekday;return Str.every+' \"'+app.trigger_weekday.data.find((e=>e.value==n)).text+'\"'+d;case 5:return Str.every+' \"'+Str.month+'\" '+t.trigger_day+d;case 6:c=t.trigger_month;return Str.every+' \"'+app.trigger_month.data.find((e=>e.value==c)).text+'\" '+t.trigger_day+d;case 7:return t.cron_express}},cid:\"intervalCol\"},{cname:\"column\",fieldName:\"previous_date\",width:\"17em\",text:Str.runTime,autoWrap:\"pre\",sortable:false,render(e,t,r,a){return Str.previous+Str.labelSeparator+(t.previous_time?.dateTimeText||\"\")+\"\\n\"+Str.next+Str.labelSeparator+(t.next_time?.dateTimeText||\"\")},cid:\"runTimeCol\"},{cname:\"column\",fieldName:\"begin_date\",width:\"17em\",text:Str.duration,autoWrap:\"pre\",render(e,t,r,a){return Str.from+Str.labelSeparator+(e?.dateTimeText||\"\")+\"\\n\"+Str.to+Str.labelSeparator+(t.end_date?.dateTimeText||\"\")},cid:\"durationCol\"},{cname:\"column\",fieldName:\"job_desc\",width:-1,text:Str.desc,sortable:false,cid:\"descCol\"}],events:{itemdblclick(e,t,r){app.editBtn.fireEvent(\"click\")}}}]});"},"stateMap":{"wb.task":"004RJWJ8ZC63P"}}