{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","remark":"Add task","serverScript":"function main() {\n  const Util = Wb.load('./util.mjs');\n  let sid = Wb.getId(), rec = { sid }, db = Wb.getConn();\n\n  Wb.set(rec);\n  Wb.sync({ tableName: 'wb_job', insert: Params, db });\n  JobUtil.reloadJob(sid, db.connection);\n  Wb.send(Wb.apply(rec, Util.getFireTime(sid)));\n}\nmain();"},"_icon":"module"}