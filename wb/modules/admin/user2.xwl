{"title":"@userMng","icon":"user2","img":"","tags":"","hideInMenu":"true","text":"module","cls":"Wb.Module","properties":{"cid":"module","remark":"User account management tool","serverScript":"// Params.roleClassData = Wb.encode(Wb.ServerDict.getKVObject(('roleClass')));"},"_icon":"module","events":{"initialize":"Wb.apply(app, {\n  /** @property {Object} - The edit window configs object. */\n  winConfigs: {\n    tagName: 'form',\n    layout: 'form1',\n    height: '45em',\n    width: '85em',\n    autoScroll: true,\n    manualShow: true,\n    events: {\n      ready() {\n        let win = this, ct = new Wb.Container({ layout: 'grid3', padding: false, autoGrid: true });\n        win.down('display_name').inputEl.autocomplete = 'off';\n        win.el.autocomplete = 'off';\n        ct.add(win.items.copy());\n        win.add(ct);\n        win.add({\n          cid: 'roleBox',\n          cname: 'tree',\n          header: false,\n          flex: 1,\n          autoLoad: false,\n          multiSelect: true,\n          url: xpath + '/select-roles-gn',\n          minHeight: '15em',\n          height: '15em',\n          gridHeader: true,\n          searchBar: true,\n          linkedCheck: true,\n          fields: {\n            sid: { type: 'string' }\n          },\n          columns: [\n            { cname: 'column', fieldName: 'text', text: '角色名称', expander: true, width: -1 }\n          ],\n          getValue() {\n            var checkedNodes = this.checkedNodes;\n            var checkeDatas = [];\n            for (var i = 0; i < checkedNodes.length; i++) {\n              var tmpData = checkedNodes[i].data;\n              if (tmpData.role_id) {\n                tmpData.begin_date = null;\n                tmpData.end_date = null;\n                checkeDatas.push(tmpData);\n              }\n            }\n            return checkeDatas;\n          },\n          events: {\n            itemclick(item, e, options) {\n              // dualTreeBox 这个控件单击只触发selectchange，只能手动触发checkchange\n              item.checked = !item.checked;\n            },\n          }\n        });\n        // win.add({\n        //   cid: 'roleBox', cname: 'dualTreeCheckBox', flex: 1, minHeight: '15em', gridHeader: true,\n        //   searchBar: true, sourceUrl: xpath + '/select-roles-gn',\n        //   getValue() {\n        //     return this.destData;\n        //   },\n        //   sourceTreeConfigs: {\n        //     title: '功能角色', gridLine: true, showIcon: false, linkedCheck: true,\n        //     columns: [\n        //       { cname: 'column', fieldName: 'text', text: '角色名称', expander: true, width: -1 }\n        //     ],\n        //     events: {\n        //       itemdblclick(item, e, options) {\n        //         // dualTreeBox 这个控件双击会进入选中列，只能阻止这个默认行为\n        //         return false;\n        //       },\n        //       itemclick(item, e, options) {\n        //         // dualTreeBox 这个控件单击只触发selectchange，只能手动触发checkchange\n        //         item.checked = !item.checked;\n        //       },\n        //       checkchange(node, checked, options) {\n        //         console.log(node)\n        //         console.log(checked)\n        //         debugger\n        //         console.log(this.destData)\n        //       if (checked !== 'half') {\n\n        //       }\n        //       //   // dualTreeBox 这个控件只支持selected的node，需要手动select\n        //       //   // 使用reverse() 是因为执行doSelect的时候会定位到第一个node的位置\n        //       //   if (checked !== 'half') {\n        //       //     if (checked) {\n        //       //       this.doSelect(this.checkedNodes, true, true, true, true, true, false);\n        //       //     } else {\n        //       //       if (node.data$._leaf === 'true') {\n        //       //         this.doSelect(this.checkedNodes, true, true, true, true, true, false);\n        //       //         // this.deselect(node, true); // 这个方法会改变当前tree的位置，使用node.deselect()会更好\n        //       //         node.deselect();\n        //       //       }\n        //       //     }\n        //       //   }\n        //       },\n        //       deselect(item, option) {\n        //         console.log(item)\n        //       //   // if(item.checked) { item.checked = !item.checked; }\n        //       }\n        //     }\n        //   },\n        //   destGridConfigs: {\n        //     title: Str.selectedRoles, editable: true, visible: true,\n        //     columns: [\n        //       {\n        //         cname: \"column\",\n        //         cid: \"checkCol1111\",\n        //         checkBox: \"int\",\n        //         fieldName: \"_checked\",\n        //         checkRefresh: true,\n        //         menuText: \"Check\"\n        //       },\n        //       { cname: 'column', fieldName: 'text', text: '角色名称', width: -1 },\n        //       {\n        //         cname: 'column', fieldName: 'begin_date', text: '开始日期',\n        //         editor: {\n        //           cname: 'date',\n        //           events: {\n        //             focus() {\n        //               let me = this, data = me.el.getClosestComp(Wb.Grid).editRow.data;\n        //               me.maxValue = data.end_date;\n        //             }\n        //           }\n        //         }\n        //       },\n        //       {\n        //         cname: 'column', fieldName: 'end_date', text: '结束日期',\n        //         editor: {\n        //           cname: 'date', events: {\n        //             focus() {\n        //               let me = this, data = me.el.getClosestComp(Wb.Grid).editRow.data;\n        //               me.minValue = data.begin_date;\n        //             }\n        //           }\n        //         }\n        //       }],\n        //     events: {\n        //       itemclick(item, e, options) {\n        //         // dualTreeBox 这个控件单击只触发selectchange，只能手动触发checkchange\n        //         item.checked = !item.checked;\n        //       }\n        //     }\n        //   }\n        // });\n        win.add({\n          cid: 'role2Box', cname: 'dualTreeBox', visible: false, flex: 1, minHeight: '10em', gridHeader: true, searchBar: true, sourceUrl: xpath + '/select-roles-sj',\n          getValue() {\n            return this.destData;\n          },\n          sourceTreeConfigs: {\n            title: '数据角色', gridLine: true, showIcon: false,\n            columns: [{ cname: 'column', fieldName: 'text', text: '角色名称', expander: true, width: -1 }]\n          }, destGridConfigs: {\n            title: Str.selectedRoles, editable: true,\n            columns: [{ cname: 'column', fieldName: 'text', text: '角色名称', width: -1 },\n            {\n              cname: 'column', fieldName: 'begin_date', text: '开始日期',\n              editor: {\n                cname: 'date',\n                events: {\n                  focus() {\n                    let me = this, data = me.el.getClosestComp(Wb.Grid).editRow.data;\n                    me.maxValue = data.end_date;\n                  }\n                }\n              }\n            },\n            {\n              cname: 'column', fieldName: 'end_date', text: '结束日期',\n              editor: {\n                cname: 'date', events: {\n                  focus() {\n                    let me = this, data = me.el.getClosestComp(Wb.Grid).editRow.data;\n                    me.minValue = data.begin_date;\n                  }\n                }\n              }\n            }]\n          }\n        });\n      },\n      beforeok() {\n        let win = this, pwd = win.down('password');\n        //The two passwords are not the same\n        if (pwd.value != win.down('confirm_password').value) {\n          Wb.warn(Str.pwdNotSame, f => pwd.focus(false, true));\n          return false;\n        }\n      },\n      hide() {\n        app.grid1.reload();\n      }\n    },\n\n  },\n  /**\n   * Fired after insert or update fails.\n   */\n  onFailure(resp) {\n    Wb.checkExists(resp, 'wb_user_user_name', app.grid1.dictWin.down('user_name'));\n  },\n  /**\n   * Load available roles.\n   * @param {Function} success The callback function after success.\n   * @param {Array} .items Available roles.\n   * @param {String} [userId] User id for getting dest roles.\n   */\n\n  loadRoles(success, userId) {\n    Wb.ajax({\n      url: xpath + '/select-roles-xz',\n      json: true,\n      params: { userId },\n      success(data) {\n        success?.(data);\n      }\n    });\n  },\n});"},"_expanded":true,"items":[{"_icon":"window","text":"resetWin","cls":"Wb.Window","_expanded":true,"properties":{"cid":"resetWin","layout":"grid1","resetDialog":"true","autoGrid":"true","title":"用户密码重置","width":"40em","resizable":"false"},"items":[{"cls":"Wb.Text","properties":{"cid":"user_id_disp","text":"用户账号","readonly":"true"},"text":"user_id_disp","_expanded":true,"_icon":"text","hasDupCid":0},{"cls":"Wb.Text","properties":{"cid":"user_name","text":"用户名称","readonly":"true"},"text":"user_name","_expanded":true,"_icon":"text","hasDupCid":0},{"cls":"Wb.Text","properties":{"cid":"password","required":"true","text":"新密码","password":"true","eyeButton":"true"},"text":"password","_expanded":true,"_icon":"text","hasDupCid":0}]},{"_icon":"viewport","text":"viewport1","cls":"Wb.Viewport","properties":{"cid":"viewport1","layout":"fit","autoContextMenu":"true"},"_expanded":true,"items":[{"cls":"Wb.Toolbar","properties":{"cid":"tbar","isProperty":"true"},"text":"tbar","_expanded":true,"_icon":"toolbar","hasDupCid":0,"items":[{"_icon":"item","text":"addBtn","cls":"Wb.Item","_expanded":true,"properties":{"cid":"addBtn","text":"@Str.add","icon":"add","keys":"Ctrl+E"},"events":{"click":"app.loadRoles(data => {\n  let win, roleBox, role2Box;\n  debugger;\n  win = app.grid1.dictAdd({\n    url: xpath + '/add',\n    failure: app.onFailure\n  }, Str.username, null, null, app.winConfigs);\n  roleBox = win.down('roleBox');\n  roleBox.destData = [];\n  roleBox.sourceTree.reload();  // checked信息没办法重置，只能重置sourceTree的数据\n  role2Box = win.down('role2Box');\n  role2Box.destData = [];\n  win.show();\n  win.down('user_id_disp').hide();\n});"}},{"_icon":"item","text":"editBtn","cls":"Wb.Item","_expanded":true,"properties":{"cid":"editBtn","text":"@Str.edit","icon":"edit","keys":"Ctrl+J"},"events":{"click":"let grid = app.grid1, data = grid.selectionData;\nif (!data) {\n  Wb.tipSelect();\n  return;\n}\nconst sid = data.sid;\napp.loadRoles(data => {\n  let win, roleBox, role2Box;\n  win = grid.dictEdit({\n    url: xpath + '/edit',\n    failure: app.onFailure\n  }, 'user_name', null, null, app.winConfigs);\n  roleBox = win.down('roleBox');\n  // const roleBox1 = roleBox\n  // const roleData = data\n  // roleBox.destData = data?.filter(item => !item.role_type);\n  // // roleBox.sourceTree.reload();  // checked信息没办法重置，只能重置sourceTree的数据\n  roleBox.reload({ params: { userId: sid || '' } }, function(res) {\n    // roleBox1.findItem('text','清单').checked = false\n    // console.log(roleBox1)\n    // console.log(roleData)\n  });\n  role2Box = win.down('role2Box');\n  role2Box.destData = data?.filter(item => item.role_type);\n  win.show();\n  win.down('user_id_disp').show();\n}, data.sid);\n"}},{"_icon":"item","text":"delBtn","cls":"Wb.Item","_expanded":true,"properties":{"cid":"delBtn","text":"@Str.del","icon":"delete","keys":"Ctrl+D"},"events":{"click":"app.grid1.removeRecords(xpath + '/del', 'user_name');"}},{"_icon":"divider","text":"divider1","cls":"Wb.Divider","properties":{"cid":"divider1"}},{"_icon":"item","text":"resetBtn","cls":"Wb.Item","_expanded":true,"properties":{"cid":"resetBtn","text":"密码重置","icon":"rotate"},"events":{"click":"let win = app.resetWin, rec = app.grid1.selection, data;\nif (!rec) {\n  Wb.tipSelect();\n  return;\n}\ndata = rec.data;\nWb.setValue(win, {user_id_disp: data.user_id_disp, user_name: data.user_name});\nwin.okHandler = (win, values) => {\n   Wb.ajax({\n    url: xpath + '/reset-password',\n    params: {\n      sid: values.user_id_disp,\n      password: values.password,\n    },\n    json: true,\n    success(resp) {\n      win.hide()\n    },\n    failure(resp) {\n     \n    }\n  });\n}\nwin.show();"}},{"_icon":"text","text":"search","cls":"Wb.Text","properties":{"cid":"search","clearButton":"true","placeholder":"@Str.search","flex":"1","minWidth":"5em","maxWidth":"20em"},"events":{"change":"app.grid1.delayLoad({ comps: app.search });"}}]},{"_icon":"grid","text":"grid1","cls":"Wb.Grid","properties":{"cid":"grid1","url":"@xpath + '/select'","multiSelect":"true","columnsSortable":"true","sorters":"user_name","stateId":"wb.user"},"_expanded":true,"events":{"itemdblclick":"app.editBtn.fireEvent('click');"}}]}]}