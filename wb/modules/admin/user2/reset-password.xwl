{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"function main() {\n  const Util = Wb.UserUtil;\n  let password = Params.password;\n  Wb.set('password', Util.encryptPassword(password));\n  Wb.sync({ tableName: 'wb_user', update: {$password: Params.password}});\n}\nmain();"},"_icon":"module"}