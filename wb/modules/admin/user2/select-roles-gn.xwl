{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"function toNestedTree(flatData) {\n  const data = JSON.parse(JSON.stringify(flatData));\n  const nodeMap = new Map();\n  data.forEach(node => {\n    nodeMap.set(node.role_id, node);\n    node.items = [];\n  });\n  const roleNodes = [];\n  data.forEach(node => {\n    // node._checked = false;\n    node._checked = node._checked === 'true' ? true : false;\n    node._icon = '';\n    const parentId = node.parent_role_id;\n    if (!parentId) {\n      roleNodes.push(node);\n    } else {\n      const parentNode = nodeMap.get(parentId);\n      if (parentNode) {\n        parentNode.items.push(node);\n      } else {\n        roleNodes.push(node);\n      }\n    }\n  })\n  function cleanLeaf(node) {\n    if (node.items && node.items.length > 0) {\n      delete node._leaf;\n      node._expanded = false;\n      node._icon = '';\n      node.items.forEach(child => cleanLeaf(child));\n    } else {\n      delete node.items;\n    }\n  }\n  roleNodes.forEach(node => cleanLeaf(node));\n  return roleNodes;\n}\n\nfunction classifyByRoleClass(data) {\n  const groupMap = {};\n  data.forEach(item => {\n    const key = String(item.role_class); \n    if (!groupMap[key]) {\n      groupMap[key] = [];\n    }\n    groupMap[key].push(item);\n  });\n  // const result = Object.entries(groupMap).map(([classKey, items]) => ({\n  //   text: KVBuffer.getValue('roleClass', Number(classKey)) || classKey, \n  //   _expanded: false, \n  //   _fixed: true,  \n  //   items: items \n  // }));\n  const result = Object.entries(groupMap).map(([classKey, items]) => ({\n    text: KVBuffer.getValue('roleClass', Number(classKey)) || classKey, \n    _expanded: true, \n    _fixed: true,  \n    _checked: false,\n    _icon: '',\n    items: items \n  }));\n  return result;\n}\n\nfunction main() {\n  let sql, sourceRoles;\n  // sql = `select sid, role_id, role_name as text,role_type, remark as subtext, role_class, 'true' as \"_leaf\",'false' as \"_checked1\", parent_role_id from wb_role where role_id<>'default' and status=1 and role_type=0`\n  sql = `\n    select \n    t1.sid, t1.role_id, t1.role_name as text,t1.role_type, t1.remark as subtext, t1.role_class, \n    'true' as \"_leaf\",\n    (case when t2.role_id is not null then 'true' else 'false' end) as \"_checked\", \n    parent_role_id \n    from wb_role t1\n    left join wb_user_role t2 on t1.role_id = t2.role_id and t2.user_id= {?userId?}\n    where t1.role_id<>'default' and t1.status=1 and t1.role_type=0\n  `;\n  if (Params.search) {\n    Wb.setLike('search');\n    sql += ' and role_name like {?search?}';\n  }\n  sql += 'order by role_name';\n  sourceRoles = Wb.getAllRows(sql);\n  Wb.send(classifyByRoleClass(toNestedTree(sourceRoles)));\n}\nmain();"},"_icon":"module"}