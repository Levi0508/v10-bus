{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"let order = Wb.getOrderSql();\n\nWb.sendRowx({\n  sql: `{call thjs.p_fxq_cust_rz_self_q({*cursor|return*},{?CLIENT_NAME?},{?WORK_TYPE?},{?CLIENT_STATUS?},{?sys.username?},{?MAINTAINER?},{?bigint|_from?},{?bigint|_size?},'${order}',{*O_TOTAL_COUNT*},{*O_RETURN_MSG*},{*O_RETURN_CODE*})}`,\n  kv: {\n    client_belong: 'client_belong',\n    client_status: 'client_status',\n    organ_flag: 'organ_flag',\n    industry_type: 'industry_type',\n    work_type: 'work_type',\n    data_status: 'data_type'\n  },\n  paging: false,\n  total: `select count(0) from (select * from thjs.t_th_client_info b union select * from thjs.t_th_client_info_draft b) b\n  left join thjs.t_maintainer_info a \n    on a.client_id = b.client_id \n  left join basic_thjs.wb_user c \n    on a.new_maintainer = c.SID\n  LEFT JOIN basic_thjs.wb_user_hg c1\n    on a.new_maintainer = c1.user_name\n  where (b.client_name like '%'||{?CLIENT_NAME?}||'%' or {?CLIENT_NAME?} is null)\n    and b.client_belong = '1'\n  and (b.work_type = {?WORK_TYPE?} or {?WORK_TYPE?} is null)\n  and (a.new_maintainer = {?sys.username?} or {?sys.username?} = 'admin' or b.update_user = {?sys.username?})\n  and (instr(a.NEW_MAINTAINER, {?MAINTAINER?}) > 0 \n\t\t\t\t\t                  or instr(nvl(c.DISPLAY_NAME,c1.display_name),{?MAINTAINER?}) > 0\n                            or {?MAINTAINER?} is null)\n  and (b.client_status = {?CLIENT_STATUS?} or {?CLIENT_STATUS?} is null)`\n});\n\n// 管理员能查询所有人填报的反洗钱客户\n"},"_icon":"module","_expanded":true}