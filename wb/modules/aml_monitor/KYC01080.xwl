{"title":"反洗钱客户审核类型设置","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","links":"[\"wb/custom-made/vue/vue.js\",\"wb/custom-made/vue/element.js\",\"wb/custom-made/vue/element.css\"]"},"_icon":"module","_expanded":true,"items":[{"_icon":"viewport","text":"viewport1","cls":"Wb.Viewport","properties":{"cid":"viewport1"},"_expanded":true,"events":{"keydown":"if (e.keyCode == '13') {\n  app.seekBtn.fireClick()\n}"},"items":[{"_icon":"panel","text":"header","cls":"Wb.Panel","properties":{"cid":"header","html":"<div style=\"font-size:16px;font-weight:bold;padding:20px;\">反洗钱客户审核类型设置</div>","maxHeight":"80","style":"display:none"},"_expanded":true,"items":[{"cls":"Wb.Container","events":{"ready":"let comp = this;\ncomp.vue = new Vue({\n  el: comp.el.addEl(),\n  template: `\n<div style=\"padding:15px 0 0 20px;\">\n  <el-breadcrumb separator=\"/\">\n  <el-breadcrumb-item>反洗钱系统</el-breadcrumb-item>\n  <el-breadcrumb-item>反洗钱客户审核类型设置</el-breadcrumb-item>\n  </el-breadcrumb>\n</div>\n`,\n  data() {\n    return {\n    }\n  },\n  methods: {\n  }\n});"},"properties":{"cid":"headers","isProperty":"true"},"text":"headers","_expanded":true,"_icon":"container","hasDupCid":0}]},{"_icon":"splitter","text":"splitter1","cls":"Wb.Splitter","properties":{"cid":"splitter1"}},{"_icon":"panel","text":"panel1","cls":"Wb.Panel","properties":{"cid":"panel1","border":"false","layout":"grid4"},"_expanded":true,"hasDupCid":0,"items":[{"_icon":"combo","text":"ERR_TYPE","cls":"Wb.Select","properties":{"cid":"ERR_TYPE","text":"错误类型","placeholder":"请选择错误类型","url":"@xpath + '/select_err_type'","textField":"err_type","valueField":"err_type","width":"400","matchMode":"startsWith","plainIcon":"true","alignSelf":"start","labelAlign":"left","labelWidth":"100px"}}]},{"_icon":"grid","text":"grid1","cls":"Wb.Grid","properties":{"cid":"grid1","pagingBar":"pageNums","pageSize":"100","full":"true","border":"false","url":"@xpath + '/select'","editable":"true","textSelectable":"true","columnsSortable":"true","sorters":"['err_type','status','organ_flag']"},"_expanded":true,"items":[{"_icon":"toolbar","text":"tbar","cls":"Wb.Toolbar","properties":{"cid":"tbar","gap":"true","layout":"form-compact","isProperty":"true","border":"false"},"_expanded":true,"hasDupCid":0,"items":[{"_icon":"button","text":"addBtn","cls":"Wb.Button","properties":{"cid":"addBtn","text":"新建","roundBorder":"true","icon":"add","iconColor":"#ffffff","style":"background-color:#5cbc85;color:#fff","height":"30px"},"hasDupCid":0,"events":{"click":"app.I_ERR_TYPE.setValue('');\napp.I_STATUS.setValue('');\napp.I_ORGAN_FLAG.setValue('');\napp.addWin.show();"}},{"_icon":"button","text":"editBtn","cls":"Wb.Button","properties":{"cid":"editBtn","text":"修改","roundBorder":"true","type":"plain","style":"background-color:#f0ad4e;color:#fff","icon":"edit","iconColor":"#ffffff","height":"30px"},"events":{"click":"if(!app.grid1.selection){\n  Wb.info(\"请至少选中 1 条数据\");\n  return;\n}\nconsole.log(app.grid1.selectionData);\nlet rec = app.grid1.selectionData;\napp.A_ERR_TYPE.setValue(rec.err_type)\napp.A_STATUS.setValue(rec.status);\napp.A_ORGAN_FLAG.setValue(rec.organ_flag);\napp.A_ID.setValue(rec.id);\napp.editWin.show();"}},{"_icon":"button","text":"delBtn","cls":"Wb.Button","properties":{"cid":"delBtn","text":"删除","roundBorder":"true","style":"background-color:#d9534f;color:#fff","icon":"delete","iconColor":"#ffffff","height":"30px"},"events":{"click":"if (!app.grid1.selection) {\n  Wb.info(\"请选中 1 条数据\");\n  return;\n}\nlet sel = app.grid1.selectionsData;\nconsole.log(sel);\n\nWb.confirm(\"是否确认要删除该条数据？\", () => {\n  Wb.ajax({\n    url: xpath + '/del',\n    params: {\n      ID: sel.map(item => item.id).join(',')\n    },\n    success(resp) {\n      Wb.tipSucc(\"删除成功\");\n      app.grid1.reload()\n    }\n  });\n});\n"}},{"_icon":"right1","text":"fill1","cls":"Wb.Fill","properties":{"cid":"fill1"}},{"_icon":"button","text":"seekBtn","cls":"Wb.Button","properties":{"cid":"seekBtn","text":"查询","type":"primary","roundBorder":"true","style":"background-color:#337ab7;color:#fff","icon":"search","iconColor":"#ffffff","height":"30px"},"events":{"click":"let data = Wb.getValue(app.panel1)\nif(Wb.verify(app.panel1)){\n  app.grid1.load({\n    comps:app.panel1,\n    params:{},\n  })\n}"}},{"_icon":"button","text":"resetBtn","cls":"Wb.Button","properties":{"cid":"resetBtn","text":"重置","roundBorder":"true","style":"background-color:#5cbc85;color:#fff","icon":"loading3","iconColor":"#ffffff","height":"30px"},"events":{"click":"app.ERR_TYPE.setValue('');\napp.grid1.reload();"},"_expanded":true}]},{"_icon":"array","text":"columns","cls":"Wb.Array","properties":{"cid":"columns"},"_expanded":true,"items":[{"_icon":"column","text":"rownum_Col","cls":"Wb.Column","properties":{"cid":"rownum_Col","rowNum":"true","width":"75","titleAlign":"left"}},{"_icon":"column","text":"ERR_TYPE_Col","cls":"Wb.Column","properties":{"cid":"ERR_TYPE_Col","text":"错误类型","fieldName":"err_type","width":"300","sortable":"true"},"hasDupCid":0},{"_icon":"column","text":"STATUS_Col","cls":"Wb.Column","properties":{"cid":"STATUS_Col","text":"是否有效","fieldName":"status","render":"if (value == '0') {\n  return '否'\n} else {\n  return '是'\n}","sortable":"true","width":"200"},"hasDupCid":0},{"_icon":"column","text":"ORGAN_FLAG_Col","cls":"Wb.Column","properties":{"cid":"ORGAN_FLAG_Col","text":"客户类型","fieldName":"organ_flag","render":"if (value == '0') {\n  return '个人客户'\n} else {\n  return '机构客户'\n}","sortable":"true","width":"300"},"hasDupCid":0}]}]}]},{"_icon":"window","text":"addWin","cls":"Wb.Window","_expanded":true,"properties":{"cid":"addWin","title":"新增","dialog":"true","width":"500","padding":"20"},"events":{"ok":"// 先查询数据是否已存在\nWb.ajax({\n  url: xpath + '/select_is_exist',\n  params: {\n    ERR_TYPE: app.I_ERR_TYPE.getValue(),\n    STATUS: app.I_STATUS.getValue(),\n    ORGAN_FLAG: app.I_ORGAN_FLAG.getValue()\n  },\n  success(resp) {\n    let cnt = Wb.decode(resp).items[0].cnt;\n    if (cnt) {\n      Wb.info(\"请勿添加重复信息！\");\n      return;\n    } else {\n      Wb.ajax({\n        url: xpath + '/add',\n        params: {\n          ERR_TYPE: app.I_ERR_TYPE.getValue(),\n          STATUS: app.I_STATUS.getValue(),\n          ORGAN_FLAG: app.I_ORGAN_FLAG.getValue()\n        },\n        success(resp) {\n          app.addWin.hide();\n          Wb.tipSucc(\"新增成功\")\n          app.grid1.reload()\n        }\n      });\n    }\n  }\n})\n"},"items":[{"_icon":"text","text":"I_ERR_TYPE","cls":"Wb.Text","properties":{"cid":"I_ERR_TYPE","text":"错误类型","labelWidth":"100","padding":"10"},"hasDupCid":0,"_expanded":true},{"_icon":"combo","text":"I_STATUS","cls":"Wb.Select","properties":{"cid":"I_STATUS","text":"是否有效","data":"[['是', '1'], ['否', '0']]","labelWidth":"100","padding":"10","forceSelect":"true"}},{"_icon":"combo","text":"I_ORGAN_FLAG","cls":"Wb.Select","properties":{"cid":"I_ORGAN_FLAG","text":"客户类型","data":"[['个人客户', '0'], ['机构客户', '1']]","labelWidth":"100","padding":"10","forceSelect":"true"}}]},{"_icon":"window","text":"editWin","cls":"Wb.Window","_expanded":true,"properties":{"cid":"editWin","title":"修改","dialog":"true","width":"500","padding":"20"},"events":{"ok":"Wb.ajax({\n  url: xpath + '/edit',\n  params: {\n    STATUS: app.A_STATUS.getValue(),\n    ID: app.A_ID.getValue()\n  },\n  success(resp) {\n    app.editWin.hide();\n    Wb.tipSucc(\"修改成功\")\n    app.grid1.reload()\n  }\n});"},"items":[{"_icon":"text","text":"A_ERR_TYPE","cls":"Wb.Text","properties":{"cid":"A_ERR_TYPE","text":"错误类型","labelWidth":"100","padding":"10","readonly":"true"},"hasDupCid":0},{"_icon":"combo","text":"A_STATUS","cls":"Wb.Select","properties":{"cid":"A_STATUS","text":"是否有效","data":"[['是', '1'], ['否', '0']]","labelWidth":"100","padding":"10","forceSelect":"true"},"hasDupCid":0},{"_icon":"combo","text":"A_ORGAN_FLAG","cls":"Wb.Select","properties":{"cid":"A_ORGAN_FLAG","text":"客户类型","data":"[['个人客户', '0'], ['机构客户', '1']]","labelWidth":"100","padding":"10","readonly":"true","forceSelect":"true"}},{"_icon":"text","text":"A_ID","cls":"Wb.Text","properties":{"cid":"A_ID","visible":"false","labelWidth":"100","padding":"10","readonly":"true"}}]}]}