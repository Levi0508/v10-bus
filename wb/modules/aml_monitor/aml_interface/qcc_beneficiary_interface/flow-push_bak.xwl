{"title":"受益所有人信息获取","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"// var url = \"https://api.qichacha.com/ECIV4/GetBasicDetailsByName\";\nvar url = \"http://10.181.135.22:8080/ECIV4/GetBasicDetailsByName\";\nvar APP_KEY = 'dd0218bc47a04dccabcebbcb3e05dad1';\nvar SECRET_KEY = '7C1A873B0874BD72FAB0AF33B4195B9E';\nvar FULL_NAME = Wb.get('FULL_NAME');\nvar ID_NO = Wb.get('ID_NO');\nvar ORDER_NO = Wb.get('ORDER_NO');\nvar PORT_TYPE = Wb.get('PORT_TYPE');\nvar benefQryUrl = geturl(url);\n//  时间戳\nvar xTimestamp = java.time.Instant.now().getEpochSecond() + '';\n// 签名\nvar orignSign = APP_KEY + xTimestamp + SECRET_KEY;\nvar DigestUtils = org.apache.commons.codec.digest.DigestUtils;\nvar xSignature = DigestUtils.md5Hex(orignSign).toUpperCase();\n\n//调用接口\nvar benefResp = Packages.cn.hutool.http.HttpUtil\n  .createGet(benefQryUrl)\n  .header('Content-Type', 'application/json;charset=utf-8')\n  .header('Token', xSignature)\n  .header('Timespan', xTimestamp)\n  .execute().body();\nvar result = Wb.decode(benefResp);\nWb.send(result);\nWb.info(result);\nWb.info(\"调用方结束\");\nif (result.Status == '200') {\n  //插入基本信息\n  if (!Wb.isEmpty(result.Result)) {\n    var basicData = result.Result;\n    var sql = \" insert into thjs.t_qcc_basic_v2(\" +\n      \" order_no,                        \" +\n      \" keyno,                          \" +\n      \" name,                           \" +\n      \" no,                             \" +\n      \" belongorg,                      \" +\n      \" operid,                         \" +\n      \" opername,                       \" +\n      \" startdate,                      \" +\n      \" enddate,                        \" +\n      \" status,                         \" +\n      \" province,                       \" +\n      \" updateddate,                    \" +\n      \" creditcode,                     \" +\n      \" registcapi,                     \" +\n      \" registeredcapital,              \" +\n      \" registeredcapitalccy,           \" +\n      \" registeredcapitalunit,          \" +\n      \" econkind,                       \" +\n      \" address,                        \" +\n      \" scope,                          \" +\n      \" termstart,                      \" +\n      \" termend,                        \" +\n      \" checkdate,                      \" +\n      \" orgno,                          \" +\n      \" isonstock,                      \" +\n      \" stocknumber,                    \" +\n      \" stocktype,                      \" +\n      \" imageurl,                       \" +\n      \" enttype,                        \" +\n      \" reccap,                         \" +\n      \" paidupcapital,                  \" +\n      \" paidupcapitalccy,               \" +\n      \" paidupcapitalunit,              \" +\n      \" areacode                        \" +\n      \"  )                          \" +\n      \" select                          \" +\n      \" {?ORDER_NO?},                        '\" +\n      basicData.KeyNo + \"','\" +\n      basicData.Name + \"','\" +\n      basicData.No + \"','\" +\n      basicData.BelongOrg + \"','\" +\n      basicData.OperId + \"','\" +\n      basicData.OperName + \"','\" +\n      basicData.OrgNo + \"','\" +\n      basicData.EndDate + \"','\" +\n      basicData.Status + \"','\" +\n      basicData.Province + \"','\" +\n      basicData.UpdatedDate + \"','\" +\n      basicData.CreditCode + \"','\" +\n      basicData.RegistCapi + \"','\" +\n      basicData.RegisteredCapital + \"','\" +\n      basicData.RegisteredCapitalCCY + \"','\" +\n      basicData.RegisteredCapitalUnit + \"','\" +\n      basicData.EconKind + \"','\" +\n      basicData.Address + \"','\" +\n      basicData.Scope + \"','\" +\n      basicData.TermStart + \"','\" +\n      basicData.TermEnd + \"','\" +\n      basicData.CheckDate + \"','\" +\n      basicData.OrgNo + \"','\" +\n      basicData.IsOnStock + \"','\" +\n      basicData.StockNumber + \"','\" +\n      basicData.StockType + \"','\" +\n      basicData.ImageUrl + \"','\" +\n      basicData.EntType + \"','\" +\n      basicData.RecCap + \"','\" +\n      basicData.PaidUpCapital + \"','\" +\n      basicData.PaidUpCapitalCCY + \"','\" +\n      basicData.PaidUpCapitalUnit + \"','\" +\n      basicData.AreaCode +\n      \"' from dual                       \";\n    Wb.sendRowx(sql);\n    if (!Wb.isEmpty(basicData.Area)) {\n      // 构建动态SQL语句\n      var sql1 =\n        \"INSERT INTO thjs.t_qcc_area_v2 (\" +\n        \"province, city, county,order_no) VALUES ('\" +\n        basicData.Area.Province + \"','\" + basicData.Area.City + \"','\" + basicData.Area.County + \"',{?ORDER_NO?}\" +\n        \")\";\n      // 执行插入操作\n      Wb.sendRowx(sql1);\n    }\n    if (!Wb.isEmpty(basicData.RevokeInfo)) {\n      // 构建动态SQL语句\n      var sql2 =\n        \"INSERT INTO thjs.T_QCC_REVOKEINFO_v2 (\" +\n        \"cancelreason, canceldate, revokedate, revokereason, order_no) VALUES ('\" +\n        basicData.RevokeInfo.CancelReason + \"','\" + basicData.RevokeInfo.CancelDate + \"','\" + basicData.Area.RevokeDate + \"','\" + basicData.Area.RevokeReason + \"',{?ORDER_NO?}\" +\n        \")\";\n      // 执行插入操作\n      Wb.sendRowx(sql2);\n    }\n    //受益所有人推荐信息\n    var desi_data = basicData.DesignatedRepresentativeList;\n    for (var i = 0; i < desi_data.length; i++) {\n\n      var desiData = [];\n      var desiFields = [];\n      var desiParams = [];\n      // 构建要插入的字段和值的数组\n      for (var field in desi_data[i]) {\n        if (desi_data[i][field] !== undefined) {\n          desiData.push(\"'\" + desi_data[i][field] + \"'\");\n          desiFields.push(field);\n          desiParams.push('?');\n        }\n      }\n      // 构建动态SQL语句\n      var sql3 =\n        'INSERT INTO thjs.t_qcc_designatedlist_v2 (' +\n        \"order_no,\" +\n        desiFields.join(',') +\n        ') VALUES (' +\n        \"{?ORDER_NO?},\" +\n        desiData.join(',') +\n        ')';\n      // 执行插入操作\n      Wb.sendRowx(sql3);\n    }\n    //受益所有人推荐信息\n    var orig_data = basicData.OriginalName;\n    for (var i = 0; i < orig_data.length; i++) {\n      var origData = [];\n      var origFields = [];\n      var origParams = [];\n      // 构建要插入的字段和值的数组\n      for (var field in orig_data[i]) {\n        if (orig_data[i][field] !== undefined) {\n          origData.push(\"'\" + orig_data[i][field] + \"'\");\n          origFields.push(field);\n          origParams.push('?');\n        }\n      }\n      // 构建动态SQL语句\n      var sql4 =\n        'INSERT INTO thjs.t_qcc_originalname_v2 (' +\n        \"order_no,\" +\n        origFields.join(',') +\n        ') VALUES (' +\n        \"{?ORDER_NO?},\" +\n        origData.join(',') +\n        ')';\n      // 执行插入操作\n      Wb.sendRowx(sql4);\n    }\n    var sql5 = \"update thjs.T_WSDL_CLIENT_BEN a set a.status='4' where a.PK_ID={?ORDER_NO?} and a.PORT_TYPE={?PORT_TYPE?}\";\n    Wb.sendRowx(sql5);\n\n\n  }\n} else {\n  var sql6 = \"update thjs.T_WSDL_CLIENT_BEN a set a.status='5' where a.PK_ID={?ORDER_NO?} and a.PORT_TYPE={?PORT_TYPE?}\";\n  Wb.sendRowx(sql6);\n}\n// 插入日志表\nvar sql5 = \"insert into thjs.T_WSDL_LOG_V2(\" +\n  \"order_no,\" +\n  \"result_code,\" +\n  \"result_desc,\" +\n  \"search_condition,\" +\n  \"PORT_TYPE\" +\n  \")values( \" +\n  \"{?ORDER_NO?},'\" +\n  result.Status + \"','\" +\n  result.Message + \"','\" +\n  \"full_name:'||{?FULL_NAME?}||' ', \" +\n  \"{?PORT_TYPE?}\" +\n  \")\";\nWb.sendRowx(sql5);\n\n//编码url\nfunction geturl(url) {\n  var name = FULL_NAME;\n  return url + \"?key=\" + APP_KEY + \"&keyword=\" + name;//encodeURIComponent(name);\n}"},"_icon":"module","items":[]}