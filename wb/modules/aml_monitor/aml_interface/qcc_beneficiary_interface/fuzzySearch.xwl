{"title":"企业模糊搜索","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"// var url = \"https://api.qichacha.com/FuzzySearch/GetList\";\n//汇总查询结果\nvar searchResult = [];\n\nvar url = \"http://10.181.135.22:8080/FuzzySearch/GetList\";\nvar APP_KEY = 'dd0218bc47a04dccabcebbcb3e05dad1';\nvar SECRET_KEY = '7C1A873B0874BD72FAB0AF33B4195B9E';\n// var FULL_NAME = Wb.get('FULL_NAME');\n// var ID_NO = Wb.get('ID_NO');\n// var ORDER_NO = Wb.get('ORDER_NO');\n// var PORT_TYPE = Wb.get('PORT_TYPE');\nvar SEARCH_KEY = Wb.get('SEARCH_KEY');\nvar benefQryUrl = url + \"?key=\" + APP_KEY + \"&searchKey=\" + SEARCH_KEY;\n//  时间戳\nvar xTimestamp = java.time.Instant.now().getEpochSecond() + '';\n// 签名\nvar orignSign = APP_KEY + xTimestamp + SECRET_KEY;\nvar DigestUtils = org.apache.commons.codec.digest.DigestUtils;\nvar xSignature = DigestUtils.md5Hex(orignSign).toUpperCase();\n\n// 调用接口\n\nvar benefResp = Packages.cn.hutool.http.HttpUtil\n  .createGet(benefQryUrl)\n  .header('Content-Type', 'application/json;charset=utf-8')\n  .header('Token', xSignature)\n  .header('Timespan', xTimestamp)\n  .execute().body();\n\n// Wb.info(benefResp)\n// var result = {\n//   \"Status\": \"200\", \"Message\": \"【有效请求】查询成功\", \"OrderNumber\": \"FUZZYSEARCH2026040910303026176075\", \"Paging\": { \"PageSize\": 5, \"PageIndex\": 1, \"TotalRecords\": 5000 }, \"Result\": [\n//     {\n//       \"KeyNo\": \"79rj5yvislevrp3jjkpkjribrarprrl53k\",\n//       \"Name\": \"北京壹佰壹拾壹医药科技有限公司\",\n//       \"CreditCode\": \"91110105055570983W\",\n//       \"StartDate\": \"2012-10-26\",\n//       \"OperName\": \"龙岩\",\n//       \"Status\": \"存续\",\n//       \"No\": \"110105015327185\",\n//       \"Address\": \"北京市朝阳区阜通东大街1号院5号楼2单元31层323102室\"\n//     },\n//     {\n//       \"KeyNo\": \"l535syeavvjrh3ajmmah9hsebrpl5e3eei\",\n//       \"Name\": \"111, Inc.\",\n//       \"CreditCode\": \"\",\n//       \"StartDate\": \"2013-05-01\",\n//       \"OperName\": \"刘峻岭\",\n//       \"Status\": \"存续\",\n//       \"No\": \"\",\n//       \"Address\": \"上海市浦东新区张江高科祖冲之路295号3-4层\"\n//     },\n//     {\n//       \"KeyNo\": \"h3sihylike9sl5kjjvsr9sl9mje3kbpvbp\",\n//       \"Name\": \"111有限公司\",\n//       \"CreditCode\": \"36262575\",\n//       \"StartDate\": \"2005-11-29\",\n//       \"OperName\": \"\",\n//       \"Status\": \"仍注册\",\n//       \"No\": \"1010771\",\n//       \"Address\": \"ROOM 904, 9/F, JOIN-IN HANG SING CENTRE, 2-16 KWAI FUNG CRESCENT, 71-75 CONTAINER PORT ROAD, KWAI CHUNG, NT, HONG KONG\"\n//     },\n//     {\n//       \"KeyNo\": \"hmsery5i5lmpkksj3v3a95ikae99jhvlke\",\n//       \"Name\": \"CLH 111 (HK) Limited\",\n//       \"CreditCode\": \"68838091\",\n//       \"StartDate\": \"2018-01-18\",\n//       \"OperName\": \"\",\n//       \"Status\": \"仍注册\",\n//       \"No\": \"2642887\",\n//       \"Address\": \"3806 CENTRAL PLAZA, 18 HARBOUR RD WANCHAI, HONG KONG\"\n//     },\n//     {\n//       \"KeyNo\": \"hm9iry3hhm559bej3h9mhjvbrmm5bsk9is\",\n//       \"Name\": \"Compass Shipping 111 Corporation Limited\",\n//       \"CreditCode\": \"75851503\",\n//       \"StartDate\": \"2023-10-30\",\n//       \"OperName\": \"\",\n//       \"Status\": \"仍注册\",\n//       \"No\": \"3332141\",\n//       \"Address\": \"ROOM 1915, 19/F, LEE GARDEN ONE, 33 HYSAN AVENUE, CAUSEWAY BAY, HONG KONG\"\n//     }\n//   ]\n// }\nvar result = Wb.decode(benefResp);\n\nsearchResult = searchResult.concat(result.Result);\n// Wb.send(result.Result);\nWb.send(result);\nWb.info(\"调用方结束\");\n// Wb.info(result);\n\nif (result.Status == '200') {\n  Wb.info(\"成功\");\n\n  // 插入日志表  --模糊匹配是否往这个表里插入\n  var sql5 = \"insert into thjs.T_WSDL_LOG_V2(\" +\n    \"order_no,\" +\n    \"result_code,\" +\n    \"result_desc,\" +\n    \"search_condition,\" +\n    \"PORT_TYPE\" +\n    \")values( \" +\n    \"{?ORDER_NO?},'\" +\n    result.Status + \"','\" +\n    result.Message + \"','\" +\n    \"full_name:'||{?FULL_NAME?}||' ', \" +\n    \"{?PORT_TYPE?}\" +\n    \")\";\n  Wb.sendRowx(sql5);\n} else {\n  Wb.info(\"失败\");\n}"},"_icon":"module"}