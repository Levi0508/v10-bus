{"title":"附件上传（磁盘）","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"let file1 = Wb.get('file1'),\n  clientId = Wb.get('client_id'),\n  fileTypeNo = Wb.get('file_type_no'),\n  objectId = Wb.get('objectId');\n\nlet rs = {};\n\nif (!clientId) {\n  rs.O_RETURN_CODE = -1;\n  rs.O_RETURN_MSG = \"没有获取到客户号\";\n} else if (!fileTypeNo) {\n  rs.O_RETURN_CODE = -1;\n  rs.O_RETURN_MSG = \"没有获取到附件类型\";\n} else {\n  let path = '/data/thfxqfiles/' + clientId + '/';\n  let file = new File(path, file1.name);\n  let parent = file.getParentFile();\n  let userName = Wb.get('sys.username');\n  let id = SysUtil.getId();\n  let fileInfoSql = `insert into thjs.t_th_client_file(client_id, file_type_no, id, name, file_size, extension, create_by, create_time, file_path, object_id,status)\n  values(?,?,?,?,?,?,?,?,?,?,?)`;\n  var conn = DataSource.getConnection(), pstmt;\n  var content = file1.stream;\n\n  if (!parent.exists()) { parent.mkdirs(); }\n\n  let os = new java.io.FileOutputStream(new File(path, file1.name));\n  try {\n    pstmt = conn.prepareStatement(fileInfoSql);\n    pstmt.setString(1, clientId);\n    pstmt.setString(2, fileTypeNo);\n    pstmt.setString(3, id);\n    pstmt.setString(4, FileUtil.removeExtension(file1.name));\n    pstmt.setDouble(5, file1.size);\n    pstmt.setString(6, FileUtil.getFileExt(file1.name));\n    pstmt.setString(7, userName);\n    pstmt.setTimestamp(8, new java.sql.Timestamp(new java.util.Date().getTime()));\n    pstmt.setString(9, path + file1.name);\n    pstmt.setString(10, objectId);\n    pstmt.setString(11, '0');\n    pstmt.executeUpdate();\n\n    IOUtils.copy(file1.stream, os); // 文件内容存磁盘\n    rs.O_RETURN_CODE = 0;\n    rs.O_RETURN_MSG = \"执行成功\"\n  } catch (e) {\n    rs.O_RETURN_CODE = -1;\n    rs.O_RETURN_MSG = \"上传失败：\" + e;\n    conn.rollback();\n    throw e;\n  } finally {\n    conn.commit();\n    conn.close();\n    os.close();\n  }\n}\n\nWb.send(Wb.encode(rs));"},"_icon":"module"}