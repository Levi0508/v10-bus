{"title":"查询客户基本信息","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"// Wb.sendRowx(`select a.* from thjs.t_th_client_info a where a.client_id = {?CLIENT_ID?}`);\nWb.sendRowx(`select t.*\n             from (select a.*,row_number() over(partition by a.client_id order by a.update_time desc) as rn from(\n              select a.* from thjs.t_th_client_info a where a.client_id = {?CLIENT_ID?}\n             union \n             select a.* from thjs.t_th_client_info_draft a where a.client_id = {?CLIENT_ID?}) a) t\n            where rn = 1 order by t.data_status desc`);"},"_icon":"module"}