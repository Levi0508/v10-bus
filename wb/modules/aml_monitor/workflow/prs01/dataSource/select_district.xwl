{"title":"查询区","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"Wb.sendRowx({\n  sql: `select * from thjs.t_dict_area_code_v2 t \n  where t.pro_code != t.area_code \n  and t.area_code like {?I_AREA_CODE?} || '%'\n  and t.area_code not like '%00'\n  and t.pro_code = {?I_PRO_CODE?}`,\n  paging: false\n});"},"_icon":"module"}