{"title":"查询有效错误类型","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"Wb.sendRowx(`select distinct a.err_type\nfrom thjs.t_par_err_type a \nwhere a.status = '1'\nand a.organ_flag = {?ORGAN_FLAG?} or {?ORGAN_FLAG?} is null\norder by a.err_type`);\n"},"_icon":"module"}