{"title":"机构/自然人主体 查询","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"Wb.sendRowx(`select a.* from thjs.t_th_relat_info a \nwhere a.client_id = {?CLIENT_ID?} \nand a.organ_flag = {?ORGAN_FLAG?} \nand (a.related_name = {?RELATED_NAME?} or {?RELATED_NAME?} is null or {?RELATED_NAME?} = '')\nunion all\nselect b.* from thjs.t_th_relat_info_tmp b \nwhere b.client_id = {?CLIENT_ID?} \nand b.organ_flag = {?ORGAN_FLAG?}\nand (b.related_name = {?RELATED_NAME?} or {?RELATED_NAME?} is null or {?RELATED_NAME?} = '')\norder by create_time;`);"},"_icon":"module"}