{"title":"查询是否客户已落库企查查数据","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"Wb.sendRowx({\n  sql:`SELECT COUNT(0) as cnt, name, startdate, registcapi, registeredcapitalccy, address, scope, termstart, termend \n  FROM thjs.T_QCC_BASIC_V2 \n  WHERE name = {?CLIENT_NAME?}\n  GROUP BY name, startdate, registcapi, registeredcapitalccy, address, scope, termstart, termend;`\n});"},"_icon":"module"}