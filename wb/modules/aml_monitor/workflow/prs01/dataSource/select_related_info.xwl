{"title":"查询关联人信息","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"Wb.sendRowx(`select a.* from thjs.t_th_relat_info a \nwhere a.client_id = {?CLIENT_ID?} \nand a.related_type = {?RELATED_TYPE?}\nand (a.data_status = {?DATA_TYPE?} OR {?DATA_TYPE?} IS NULL)\nunion all\nselect b.* from thjs.t_th_relat_info_tmp b \nwhere b.client_id = {?CLIENT_ID?} \nand b.related_type = {?RELATED_TYPE?}\n`);"},"_icon":"module"}