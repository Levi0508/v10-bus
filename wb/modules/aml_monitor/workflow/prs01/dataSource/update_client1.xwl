{"title":"更新客户信息（工作室接口）","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"let rs = {};\nlet msg = '';\n\nlet op_flag = Wb.get('OP_FLAG') || '';\nlet client_name = Wb.get('CLIENT_NAME') || '';\nlet client_belong1 = Wb.get('CLIENT_BELONG1') || '';\nlet i_key = Wb.get('KEY') || '';\nvar i_cert_no = Wb.get('ID_NO');\nvar i_usercode = Wb.get('i_usercode');\nlet i_username = Wb.get('sys.username');\n\nlet params1 = 'OP_FLAG:' + op_flag + ',CLIENT_BELONG:' + client_belong1 + ',KEY:' + i_key;\n\nif (!i_key || !i_cert_no || !i_usercode) {\n  rs.O_RETURN_CODE = -1;\n  rs.O_RETURN_MSG = \"工作室参数不能为空\";\n} else {\n\n  let conn = Wb.getConn();\n\n  try {\n\n    let obj = Wb.sql({\n      sql: `{call thjs.p_th_client_info_s({?CLIENT_ID?},{?CLIENT_NAME?},{?ORGAN_FLAG?},{?ID_TYPE?},{?ID_NO?},{?ID_BEGINDATE?},{?ID_ENDDATE?},{?CLIENT_BELONG?},{?NATIONALITY?},{?BIRTHDAY?},{?OFFICE_ADDRESS?},\n{?PROVINCE?},{?CITY?},{?DISTRICT?},{?REGISTER_COUNTRY?},{?REGISTER_MONEY_TYPE?},{?REGISTER_FUND?},{?INDUSTRY_TYPE?},{?TEL?},{?SETUP_DATE?},{?BUSI_SCOPE?},{?IS_OBJECT_REPORT?},{?ASSOCIATED_DATE?},{?REMARK?},{?CREATE_USER?},\n{?CREATE_TIME?},{?UPDATE_USER?},{?UPDATE_TIME?},{?IS_SPECIAL?},{?CLIENT_TYPE?},{?CLIENT_TYPE_OTHER?},{?SPECIAL_MATTERS?},{?MISSING_INFORMATION?},{?MISSING_DRAFT?},{?SPECIAL_MATTERS_OTHER?},\n{?SPECIAL_REASON?},{?COMPLETED_CDD?},{?LOW_RISK_EXPLANATION?},{?TAKE_MEASURES?},{?COMMUNICATION_RECORDS?},{?AGREE_RECORDS?},{?OTHER_RECORDS?},{?INDUSTRY_TYPE1?},{?WORK_TYPE?},{?CLIENT_STATUS?},{?DATA_STATUS?},\n{?RELATED_PROJ?},{?IF_RISK_CLIENT?},{?RISK_LIST_TYPE?},{?PROBLEM_DESC?},{?GRADE_VALUE?},{?GENDER?},{?INCOME?},{?PROFESSION_CODE?},{?POSITION?},{?WORK_PLACE?},{?ZIPCODE?},{?FILLIN_DATE?},{?ID_ADDRESS?},{?PROVINCE1?},\n{?CITY1?},{?DISTRICT1?},{?ADDRESS?},{?PROVINCE2?},{?CITY2?},{?DISTRICT2?},{?IF_RISK_LIST?},{?INDUSTRY_NAME?},{*O_RETURN_MSG*},{*O_RETURN_CODE*})}`,\n      trans: true,\n      commit: false\n    });\n    obj = Json.parse(obj);\n    // Wb.send(obj)\n    if (obj.O_RETURN_CODE == '0') {\n      conn.commit();\n      let log = Wb.sql({ sql: `insert into thjs.t_tmp_exec_log(opt_user,opt_url,opt_params,opt_response)values({?opt_user?},{?opt_url?},{?opt_params?},{?opt_response?})`, contextParams: false, params: { opt_user: i_username, opt_url: 'p_th_client_info_s', opt_params: client_name + '客户信息' + op_flag, opt_response: params1 } });\n\n      let sentence = \"调用call_reback接口开始，i_key:\" + i_key + \";i_cert_no:\" + i_cert_no + \";i_usercode:\" + i_usercode + \";i_username:\" + i_username;\n      var log1 = Wb.sql({ sql: `insert into thjs.t_tmp_exec_log(opt_user,opt_url,opt_params,opt_response)values({?opt_user?},{?opt_url?},{?opt_params?},{?opt_response?})`, contextParams: false, params: { opt_user: i_usercode, opt_url: 'http://10.181.100.144:8097/micro/aml', opt_params: 'sentence', opt_response: sentence } });\n\n      Wb.invoke('m?xwl=sys/service/interface/http-post');\n      let params;\n      params = {\n        eventRecordId: i_key,\n        status: 'Y',\n        updator: i_usercode,\n        updateTime: DateUtil.format(new java.util.Date())\n      };\n\n      // 保存参数\n      var data2 = Wb.sql({ sql: `{call THJS.p_fxq_interface_log_s('1',{?i_cert_no?},{?i_key?},{?i_proj_type?},{?i_usercode?},{?@O_RETURN_MSG?},{?@INTEGER.O_RETURN_CODE?})}`, contextParams: false, params: { i_cert_no: i_cert_no, i_key: i_key, i_proj_type: '', i_usercode: i_usercode } });\n\n\n      //生产环境\n      let result = app.httppost('http://10.181.100.144:8097/micro/aml', 'POST',\n        Wb.encode(params).getBytes(\"utf-8\"), 500, 'application/json');\n\n      result = Wb.decode(new JavaString(result, 'utf-8'));\n      var log2 = Wb.sql({ sql: `insert into thjs.t_tmp_exec_log(opt_user,opt_url,opt_params,opt_response)values({?opt_user?},{?opt_url?},{?opt_params?},{?opt_response?})`, contextParams: false, params: { opt_user: i_usercode, opt_url: 'http://10.181.100.144:8097/micro/aml', opt_params: Wb.encode(params), opt_response: Wb.encode(result) } });\n      \n      if (result.code == '200') {\n        rs.O_RETURN_CODE = '0';\n        rs.O_RETURN_MSG = \"执行成功\";\n      } else {\n        rs.O_RETURN_CODE = '-1';\n        rs.O_RETURN_MSG = \"客户信息保存成功，工作室接口调用失败\";\n      }\n\n    }\n  } catch (e) {\n    rs.O_RETURN_CODE = '-1';\n    rs.O_RETURN_MSG = \"保存失败：\" + e;\n    conn.rollback();\n  } finally {\n    conn.close();\n  }\n}\nWb.send(rs);\n\n"},"_icon":"module"}