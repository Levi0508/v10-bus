{"title":"","icon":"","img":"","tags":"","hideInMenu":"true","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"let actions = {\n  //查询字典映射\n  selectDictMap() {\n    let result=Wb.sql({\n      sql: `select sql_str from app.vw_call_sp_sql_str where sp_name='APP.PR_DICT_MAP_Q'`, \n      db: 'dm8' \n    });\n    result = Wb.sql({\n      sql: result.items[0].sql_str, \n      params: {\n        i_dict_code: Params.i_dict_code,\n        i_data_source: Params.i_data_source,\n\n      }, \n      db: 'dm8' \n    })\n    if (result.o_return_code==0){\n      Wb.send(result.rt_cursor);\n    }else{\n      Wb.send({\n        o_return_code:result.o_return_code,\n        o_return_msg:result.o_return_msg\n      });\n    }\n  },\n  //查询数据源清单\n  selectSourceList() {\n    Wb.sendRows({\n      sql:`select source_code,source_code||'-'||source_name as source_name,remark,source_name as source_name_original \n           from app.tb_data_source a \n           where (a.source_code={?i_data_source?} or {?i_data_source?} is null)\n           and   (instr(upper(source_code||'-'||source_name) , upper({?query?}))>0 or {?query?} is null)\n           order by source_code`,\n      params: {\n        i_data_source: Params.i_data_source,\n        query:Params.query,\n      },\n      db:'dm8'\n    });\n  },\n  //查询源数据字典清单\n  selectSourceDictList() {\n    let sqlstr = `select distinct data_source,source_dict,source_dict||'-'||dict_name as source_dict_name from app.vw_source_dict \n                  where data_source={?i_data_source?}\n                  and   (source_dict={?i_source_dict?} or {?i_source_dict?} is null)\n                  and   (instr(upper(source_dict||'-'||dict_name) , upper({?query?}))>0 or {?query?} is null)`;\n\n    sqlstr += ' order by data_source';\n    Wb.sendRows({\n      sql:sqlstr,\n      params: {\n        i_data_source: Params.i_data_source,\n        i_source_dict: Params.i_source_dict,\n        query:Params.query,\n      },\n      db:'dm8'\n    });\n  },\n  //查询源数据字典key清单\n  selectSourceKeyList() {\n    let sqlstr='';\n    if (Params.i_source_key.contains(',')){\n      sqlstr = `select data_source,source_key,source_value,source_dict,source_dict_name,if_added from \n                (select data_source,source_key,source_value as source_value,source_dict,dict_name as source_dict_name,count(1) over(partition by source_dict) as cnt,if_added\n                 from app.vw_source_dict where data_source={?i_data_source?} \n                 and (instr(','||{?i_source_key?}||',',','||source_key||','))>0 \n                ) where cnt>=length({?i_source_key?})-length(replace({?i_source_key?},',',''))`;\n\n    }else{\n      sqlstr = `select distinct data_source,source_key,source_value as source_value,source_dict,dict_name as source_dict_name,if_added \n                from app.vw_source_dict where data_source={?i_data_source?} \n                and (source_dict={?i_source_dict?} or {?i_source_dict?} is null)\n                and (instr(upper(source_key||'-'||source_value),upper({?i_source_key?}))>0 or {?i_source_key?} is null) `;\n    }\n    \n\n    sqlstr += ' order by source_dict,source_key';\n    Wb.sendRows({\n      sql:sqlstr,\n      params: {\n        i_data_source: Params.i_data_source,\n        i_source_dict:Params.i_source_dict,\n        i_source_key: Params.i_source_key,\n      },\n      db:'dm8'\n    });\n  },\n  //查询字典清单\n  selectDictList() {\n    Wb.sendRows({\n      sql:`select distinct a.dict_code, a.dict_code||'-'||a.dict_name||'('||a.key_name||')' as dict_name,a.key_name,a.dict_name as dict_name_old,b.sid as key_id \n            from app.tb_dict a \n            left join basic_hg.wb_key_type b on a.key_name=b.key_name \n            where (a.dict_code={?i_dict_code?} or {?i_dict_code?} is null) \n            and (instr(upper(a.dict_code||'-'||a.dict_name||'-'||a.key_name) , upper({?query?}))>0 or {?query?} is null) \n            order by a.dict_code`,\n      params: {\n        i_dict_code:Params.i_dict_code,\n        query:Params.query,\n      },\n      db:'basic_hg'\n    });\n  },\n  //查询键值清单\n  selectKeyList() {\n    Wb.sendRows({\n      sql:\"select distinct key_name from basic_hg.wb_key_type where (key_name={?i_key_name?} or {?i_key_name?} is null) and (instr(upper(key_name),upper({?query?}))>0 or {?query?} is null)  order by key_name\",\n      params: {\n        i_key_name:Params.i_key_name,\n        query:Params.query,\n      },\n      db:'basic_hg'\n    });\n  },\n  //查询键值明细清单\n  selectKeyValueList() {\n    Wb.sendRows({\n      sql:`select distinct b.key_name,a.rid as key_id,a.sid as r_id,a.map_k as k,a.map_v as v \n            from basic_hg.wb_key a \n            inner join basic_hg.wb_key_type b on a.rid=b.sid \n            where b.key_name={?i_key_name?} \n            and (instr(upper(a.map_k||'-'||a.map_v),upper({?query?}))>0 or {?query?} is null)  \n            order by key_name,k`,\n      params: {\n        i_key_name:Params.i_key_name,\n        query:Params.query,\n      },\n      db:'basic_hg'\n    });\n  },\n  //查询键值排序设置\n  selectKeySeq() {\n    if (!Params.i_if_set_list=='1'){\n      Wb.sql({\n        sql: `insert into app.tb_key_seq(dict_code,map_k,set_no,key_seq,remark)\n              select a.dict_code,\n                    a.k,\n                    {?i_set_no?},\n                    null,\n                    c.remark\n              from  app.vw_dict a\n              left join  \n                    app.tb_key_seq b\n              on    a.dict_code=b.dict_code\n              and   a.k=b.map_k\n              and   b.set_no={?i_set_no?}\n              inner join \n                    (select distinct b.remark \n                     from  app.tb_key_seq b\n                     where b.dict_code={?i_dict_code?}\n                     and   b.set_no={?i_set_no?}\n                    ) c\n              on    1=1\n              where a.dict_code={?i_dict_code?}\n              and   b.map_k is null `,\n        params: {\n          i_set_no: Params.i_seq_set_no,\n          i_dict_code: Params.i_seq_dict_code\n        }, \n        db: 'dm8' \n      });\n    }\n    \n    Wb.sendRows({\n      sql:`select distinct a.dict_code,a.dict_name,a.key_name,\n                  case when {?i_if_set_list?}='1' then null else a.k end as k,\n                  case when {?i_if_set_list?}='1' then null else a.v end as v,\n                  a.seq_set_no,\n                  case when {?i_if_set_list?}='1' then null else a.key_seq end as key_seq,\n                  a.seq_remark\n            from app.vw_dict_with_seq a \n            where a.dict_code={?i_seq_dict_code?} \n            and (a.seq_set_no= {?i_seq_set_no?} or  {?i_seq_set_no?} is null)\n            and a.seq_set_no<>'default'\n            order by case when {?i_if_set_list?}='1' then null else a.key_seq end`,\n      params: {\n        i_seq_dict_code:Params.i_seq_dict_code,\n        i_seq_set_no:Params.i_seq_set_no,\n        i_if_set_list:Params.i_if_set_list\n      },\n      db:'dm8'\n    });\n  },\n\n  //查询数据字典key清单\n  selectDictKeyList() {\n    let sqlstr = \"select distinct k as dict_key,k||'-'||v as dict_value from app.vw_dict where dict_code={?i_dict_code?} and (instr(upper(k||'-'||v) , upper({?query?}))>0 or {?query?} is null)\";\n\n    sqlstr += ' order by dict_key';\n    Wb.sendRows({\n      sql:sqlstr,\n      params: {\n        i_dict_code: Params.i_dict_code,\n        query:Params.query,\n      },\n      db:'dm8'\n    });\n  },\n  //保存字典映射配置\n  saveDictMap() {\n    \n    Params.update?.forEach(function(row){\n      Wb.sql({\n        sql: `update app.tb_dict_map a `+\n             `set a.source_dict={?i_source_dict?},a.source_key={?i_source_key?},a.source_value={?i_source_value?},a.dict_key={?i_dict_key?},a.dict_value={?i_dict_value?} `+\n             `where a.dict_code={?i_dict_code?} and a.data_source={?i_data_source?} and source_key={?i_source_key?}` ,\n        params: {i_dict_code: row.$dict_code,\n                 i_data_source: row.$data_source,\n                 i_source_dict: \"source_dict\" in row?row.source_dict:row.$source_dict,\n                 i_source_key: \"source_key\" in row?row.source_key:row.$source_key,\n                 i_source_value: \"source_value\" in row?row.source_value:row.$source_value,\n                 i_dict_key: \"dict_key\" in row?row.dict_key:row.$dict_key,\n                 i_dict_value: \"dict_value\" in row?row.dict_value:row.$dict_value,\n        }, \n        db: 'dm8' \n      });\n    });\n\n  },\n  //保存字典映射配置\n  saveDict() {\n    \n    Params.update?.forEach(function(row){\n      Wb.sql({\n        sql: `update app.tb_dict a `+\n             `set a.dict_name={?i_dict_name?},a.key_name={?i_key_name?} `+\n             `where a.dict_code={?i_dict_code?}` ,\n        params: {\n          i_dict_code: row.$dict_code,\n          i_dict_name: \"dict_name_old\" in row?row.dict_name_old:row.$dict_name_old,\n          i_key_name: \"key_name\" in row?row.key_name:row.$key_name,\n        }, \n        db: 'dm8' \n      });\n    });\n  \n    Params.insert?.forEach(function(row){\n      Wb.sql({\n        sql: `insert into app.tb_dict(dict_code,dict_name,key_name) \n              select (select lpad(to_char(to_number(nvl(max(dict_code),0))+1),4,'0') from app.tb_dict),\n                     {?i_dict_name?},\n                     {?i_key_name?} \n              from dual`, \n        params: {\n          i_dict_name: \"dict_name_old\" in row?row.dict_name_old:row.$dict_name_old,\n          i_key_name: \"key_name\" in row?row.key_name:row.$key_name,\n        }, \n        db: 'dm8' \n      });\n    });\n\n  },\n  //保存键值配置\n  saveKeyValue() {\n    Params.del?.forEach(function(row){\n      Wb.sql({\n        sql: `delete from basic_hg.wb_key a where a.sid={?i_r_id?} `, \n        params: {\n          i_r_id: row.$r_id,\n        }, \n        db: 'basic_hg' \n      });\n    });\n    Params.update?.forEach(function(row){\n      Wb.sql({\n        sql: `update basic_hg.wb_key a `+\n             `set a.map_k={?i_k?},a.map_v={?i_v?} `+\n             `where a.sid={?i_r_id?}` ,\n        params: {\n          i_r_id: row.$r_id,\n          i_k: \"k\" in row?row.k:row.$k,\n          i_v: \"v\" in row?row.v:row.$v,\n        }, \n        db: 'basic_hg' \n      });\n    });\n    Params.insert?.forEach(function(row){\n      Wb.sql({\n        sql: `insert into basic_hg.wb_key(sid,rid,map_k,map_v) values({?i_r_id?},{?i_key_id?},{?i_k?},{?i_v?})`, \n        params: {\n          i_r_id: Wb.getId(),\n          i_key_id: \"key_id\" in row?row.key_id:row.$key_id,\n          i_k: \"k\" in row?row.k:row.$k,\n          i_v: \"v\" in row?row.v:row.$v,\n\n        }, \n        db: 'basic_hg' \n      });\n    });\n  },\n  //保存源键值\n  saveSourceKey() {\n    Params.del?.forEach(function(row){\n      Wb.sql({\n        sql: `delete from app.tb_source_dict_add a where a.data_source={?i_data_source?} and source_dict= {?i_source_dict?} and source_key={?i_source_key?} `, \n        params: {\n          i_data_source: row.$data_source,\n          i_source_dict: row.$source_dict,\n          i_source_key: row.$source_key,\n        }, \n        db: 'dm8' \n      });\n    });\n    Params.update?.forEach(function(row){\n      Wb.sql({\n        sql: `update app.tb_source_dict_add a \n              set a.source_value={?i_source_value?},\n                  a.source_key={?i_source_key?}\n              where a.data_source={?i_data_source?}\n              and   a.source_dict={?i_source_dict?}\n              and   a.source_key={?i_source_key_new?}` ,\n        params: {\n          i_data_source: row.$data_source,\n          i_source_dict: row.$source_dict,\n          i_source_key: \"source_key\" in row?row.source_key:row.$source_key,\n          i_source_key_new: row.$source_key,\n          i_source_value: \"source_value\" in row?row.source_value:row.$source_value,\n        }, \n        db: 'dm8' \n      });\n    });\n    Params.insert?.forEach(function(row){\n      Wb.sql({\n        sql: `insert into app.tb_source_dict_add(data_source,source_dict,dict_name,source_key,source_value) values({?i_data_source?},{?i_source_dict?},{?i_dict_name?},{?i_source_key?},{?i_source_value?})`, \n        params: {\n          i_data_source: \"data_source\" in row?row.data_source:row.$data_source,\n          i_source_dict: \"source_dict\" in row?row.source_dict:row.$source_dict,\n          i_dict_name: \"source_dict_name\" in row?row.source_dict_name:row.$source_dict_name,\n          i_source_key: \"source_key\" in row?row.source_key:row.$source_key,\n          i_source_value: \"source_value\" in row?row.source_value:row.$source_value,\n        }, \n        db: 'dm8' \n      });\n    });\n  },\n  //添加模块\n  addDictMap() {\n    let result=Wb.sql({\n      sql: `select sql_str from app.vw_call_sp_sql_str where sp_name='APP.PR_DICT_MAP_ADD'`, \n      db: 'dm8' \n    });\n    result = Wb.sql({\n      sql: result.items[0].sql_str, \n      params: {\n        i_dict_code: Params.i_dict_code_DM,\n        i_data_source: Params.i_data_source_DM,\n        i_source_dict: Params.i_source_dict_DM,\n      }, \n      db: 'dm8' \n    });\n    Wb.send({\n      o_return_code:result.o_return_code,\n      o_return_msg:result.o_return_msg\n    });\n  },\n  //添加新键\n  addKey() {\n    let result = Wb.sql({\n        sql: `insert into basic_hg.wb_key_type (SID,KEY_NAME,KEY_TYPE) values({?i_sid?},{?i_new_key_name?},'0')`, \n        params: {\n          i_sid: Wb.getId(),\n          i_new_key_name: Params.i_new_key_name,\n        }, \n        db: 'basic_hg' \n      });\n      Wb.send(result);\n  },\n  updateKeySeq() {\n    Wb.sql({\n      sql: `update app.tb_key_seq a\n            set a.key_seq={?i_key_seq?}\n            where a.dict_code={?i_dict_code?}\n            and   a.set_no={?i_set_no?}\n            and   a.map_k={?i_k?}`,\n      params: {\n        i_key_seq: Params.i_key_seq,\n        i_dict_code: Params.i_dict_code,\n        i_set_no: Params.i_set_no,\n        i_k: Params.i_k,\n      }, \n      db: 'dm8' \n    });\n  },\n  addKeySeq() {\n    Wb.sql({\n      sql: `insert into app.tb_key_seq(dict_code,map_k,set_no,key_seq,remark)\n            select a.dict_code,\n                   a.k,\n                   {?i_set_no?},\n                   row_number() over(partition by a.dict_code order by a.k),\n                   {?i_remark?}\n            from   app.vw_dict a\n            where  a.dict_code={?i_dict_code?}`,\n      params: {\n        i_set_no: Params.i_new_seq_set_no,\n        i_remark: Params.i_new_seq_remark,\n        i_dict_code: Params.i_new_seq_dict_code\n      }, \n      db: 'dm8' \n    });\n  },\n  delKeySeq() {\n    Wb.sql({\n      sql: `delete from app.tb_key_seq a\n            where  a.dict_code={?i_dict_code?}\n            and    a.set_no={?i_set_no?}`,\n      params: {\n        i_set_no: Params.i_del_seq_set_no,\n        i_dict_code: Params.i_del_seq_dict_code\n      }, \n      db: 'dm8' \n    });\n  },\n};\nactions[Params.xaction]();"},"_icon":"module"}