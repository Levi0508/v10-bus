{"title":"邮件模板管理","icon":"mail","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module"},"_icon":"module","_expanded":true,"events":{"initialize":"Wb.apply(app, {\n  onModelChange() {\n    app.btnSaveModel.disabled = false;\n    app.btnCancelModel.disabled = false;\n    app.btnSaveContent.disabled = true;\n  },\n  saveModel(callback) {\n    app.gridMain.sync({\n      url: xpath + '/actions&xaction=saveModel',\n      success() {\n        app.btnSaveModel.disabled = true;\n        app.btnCancelModel.disabled = true;\n        app.btnSaveContent.disabled = false;\n        callback?.();\n      },\n      failure(resp) {\n        Wb.error(resp);\n      }\n    });\n  },\n  saveText(callback) {\n    app.textListView.sync({\n      url: xpath + '/actions&xaction=saveModelText',\n      success(resp) {\n        \n        app.btnSaveText.disabled = true;\n        app.btnCancelText.disabled=true;\n        callback?.();\n      },\n      failure(resp) {\n        Wb.error(resp);\n      }\n    });\n  },\n  gridSort(me,colItem, td, e, name, sortType){\n    //排序执行3\n    if (name && me.columnsSortable && colItem.sortable) {\n      let sorter;\n      if (me.clickHeaderRipple)\n        td.rippleEffect(e.x, e.y);\n       sorter = me.sorterList?.find(item => item.name == name);\n      me.sorters = { name, desc: sorter?(!sorter.desc):false };\n      Wb.log('排序方式:'+sortType+',排序列:'+name);\n      if (sortType=='local'){\n        if (me.fireEvent('beforesort', me.data, me.sorters) !== false) {\n          let keys = [], desc = [];\n          keys.push(me.sorters.name);\n          desc.push(me.sorters.desc);\n          me.data = me.data.mixSort(keys, desc);\n        }\n      }else{\n        if (me.fireEvent('beforesort', me.data, me.sorters) !== false){\n          me.reload();\n        }\n      }\n    }\n  },\n});\nWb.Grid.prototype.onHeaderClick = function(e) {\n  //排序执行1\n  let me = this, td = e.target.closest('td'), colItem = td?.colItem, name = colItem?.fieldName;\n  me.fireEvent('headerclick', colItem, td, e, name);\n}","beforeunload":"if (!app.btnSaveModel.disabled)\n  return false;"},"items":[{"_icon":"viewport","text":"viewport1","cls":"Wb.Viewport","properties":{"cid":"viewport1","padding":".7em","gap":".7em","background":"true"},"_expanded":true,"items":[{"_icon":"label","text":"label1","cls":"Wb.Label","_expanded":true,"properties":{"cid":"label1","text":"邮件模板管理","titleType":"title3"},"hasDupCid":0},{"_icon":"panel","text":"panelOutput","cls":"Wb.Panel","properties":{"cid":"panelOutput","autoScroll":"true","layout":"column","flex":"1","border":"1","roundBorder":"true"},"_expanded":true,"hasDupCid":0,"items":[{"_icon":"panel","text":"panelOutputMain","cls":"Wb.Panel","properties":{"cid":"panelOutputMain","autoScroll":"true","border":"1","layout":"row","flex":"1"},"_expanded":true,"hasDupCid":0,"items":[{"_icon":"container","text":"containerMain","cls":"Wb.Container","properties":{"cid":"containerMain","border":"true","layout":"column","flex":"1"},"hasDupCid":0,"_expanded":true,"items":[{"_icon":"title","text":"msgTextTitle","cls":"Wb.Title","properties":{"cid":"msgTextTitle","title":"邮件模板"},"_expanded":true,"hasDupCid":1},{"_icon":"grid","text":"gridMain","cls":"Wb.Grid","properties":{"cid":"gridMain","url":"@xpath + '/actions&xaction=selectEmailModel'","columnsSortable":"true","multiSelect":"false","flex":"1","border":"1","autoLoad":"true","pageSize":"-1","textSelectable":"true","editable":"true","pagingBar":"false","autoSelect":"true"},"_expanded":true,"events":{"headerclick":"//排序执行2\ntd = e.target.closest('td') ;\ncolItem = td?.colItem;\nname = colItem?.fieldName;\napp.gridSort(this,colItem, td, e,name,'local');","select":"let data=app.gridMain.selectionData;\n//刷新模板的动态文本配置\napp.btnTQ.fireClick()\n\napp.editorContent.value=data.content?data.content:'';\napp.editorText.value='';\napp.btnSaveSql.disabled=true;\napp.btnSaveContent.disabled=!app.btnSaveModel.disabled;\n","beforeload":"let grid = this, saveBtn = app.btnSaveModel,cancelBtn=app.btnCancelModel;\n//saveBtn is null before initialized\nif (!cancelBtn.disabled && saveBtn && !saveBtn.disabled) {\n  Wb.choose(Str.modifiedConfirm.format(Str.list), btn => {\n    if (btn == 'yes')\n      app.saveModel(f => grid.reload());\n    else if (btn == 'no') {\n      saveBtn.disabled = true;\n      cancelBtn.disabled = true;\n      app.btnSaveContent.disabled=false;\n      grid.reload();\n    }\n  });\n  return false;\n}","editing":"app.onModelChange();","itemchange":"app.onModelChange();"},"hasDupCid":0,"items":[{"_icon":"toolbar","text":"tbar","cls":"Wb.Toolbar","properties":{"cid":"tbar","isProperty":"true"},"hasDupCid":0,"_expanded":true,"items":[{"_icon":"item","text":"btnAddModel","cls":"Wb.Item","_expanded":false,"properties":{"cid":"btnAddModel","text":"@Str.add","icon":"add"},"events":{"click":"let grid = app.gridMain;\n//表格选中的记录,是个数组\nlet recs = grid.selections;\n//没有选择记录,需进行提示\nif (!recs.length) {\n  Wb.tipSelect();\n  return;\n}\napp.onModelChange();\ngrid.addRecord({\n  \"project_id\":recs[0].data.project_id,\n  \"project_name\":recs[0].data.project_name,\n});\napp.btnSaveContent.disabled=true;\n\n\n\n"},"hasDupCid":0},{"_icon":"item","text":"btnSaveModel","cls":"Wb.Item","_expanded":false,"properties":{"cid":"btnSaveModel","icon":"save","text":"@Str.save","keys":"Ctrl+S","disabled":"true"},"events":{"click":"app.saveModel(f => app.btnQ.fireClick());\n"},"hasDupCid":0},{"_icon":"item","text":"btnCancelModel","cls":"Wb.Item","_expanded":false,"properties":{"cid":"btnCancelModel","text":"@Str.cancel","icon":"cancel","disabled":"true"},"events":{"click":"app.btnCancelModel.disabled = true;\napp.btnSaveModel.disabled=true;\napp.btnSaveContent.disabled = false;\napp.btnQ.fireClick();\n"},"hasDupCid":0},{"_icon":"divider","text":"divider1","cls":"Wb.Divider","properties":{"cid":"divider1"},"hasDupCid":0},{"_icon":"combo","text":"i_project_id","cls":"Wb.Select","properties":{"cid":"i_project_id","url":"@xpath + '