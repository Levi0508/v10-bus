eClick();\n  },\n});"},"hasDupCid":0},{"_icon":"file-html","text":"editorContent","cls":"Wb.HtmlEditor","properties":{"cid":"editorContent","height":"300","showEmptyLabel":"true","textSelectable":"true","toolbar":"true"},"_expanded":true,"events":{"change":"// //Wb.log('change'+this.value.htmlLine);\n// let content=this.value.replaceAll(' ','&nbsp;');\n// //content=content.replaceAll('class=\"ql-align-right\"','style=\"text-align: right;\"')\n// //content=content.replaceAll('class=\"ql-align-center\"','style=\"text-align: center;\"')\n// //Wb.log(app.gridMain.selectionData.content.htmlLine.replace('&amp;','&'));\n// let content_old=app.gridMain.selectionData.content;\n\n// Wb.log(this.value.htmlLine.replaceAll(' ','&nbsp;').equals(app.gridMain.selectionData.content.replaceAll('&nbsp;',' ').htmlLine.replaceAll(' ','&nbsp;')));\n// if (!this.value.htmlLine.replaceAll(' ','&nbsp;').equals(app.gridMain.selectionData.content.replaceAll('&nbsp;',' ').htmlLine.replaceAll(' ','&nbsp;'))){\n//   Wb.log('content:'+content);\n//   Wb.log('content_old:'+content_old);\n// }\n// if (!this.value.htmlLine.replaceAll(' ','&nbsp;').equals(app.gridMain.selectionData.content.replaceAll('&nbsp;',' ').htmlLine.replaceAll(' ','&nbsp;')) && content_old!='' && content!='<p></p>'){\n  \n//   app.onModelChange();\n//   app.gridMain.startEdit(app.gridMain.selection, 'content');\n//   let editor = Wb.Editor.activeEditor;\n//   editor.value=content.replaceAll(' ','&nbsp;');\n//   editor.select();\n// }\n"}}]},{"_icon":"splitter","text":"splitter1","cls":"Wb.Splitter","properties":{"cid":"splitter1"}},{"_icon":"container","text":"containerText","cls":"Wb.Container","properties":{"cid":"containerText","border":"1","layout":"column","width":"550"},"hasDupCid":0,"_expanded":true,"items":[{"_icon":"title","text":"msgTextTitle","cls":"Wb.Title","properties":{"cid":"msgTextTitle","title":"动态文本"},"_expanded":true,"hasDupCid":1},{"_icon":"toolbar","text":"tbar","cls":"Wb.Toolbar","properties":{"cid":"tbar","isProperty":"false","border":"true"},"hasDupCid":0,"_expanded":true,"items":[{"_icon":"item","text":"btnAddText","cls":"Wb.Item","_expanded":true,"properties":{"cid":"btnAddText","icon":"add","text":"添加"},"events":{"click":"let win = app.winEditText;\n\napp.i_position_flag.readonly=false;\napp.i_position_flag.required=true;\n\napp.i_model_id.value=app.gridMain.selectionData.model_id;\n//app.i_position_flag.value=app.textListView.selectionData.position_flag;\n//app.i_remark.value=app.app.textListView.selectionData.remark;\n\n\nwin.icon = 'add';\nwin.title = Str.add;\nwin.focusControl = null;\nwin.okHandler = (win, values) => {\n  Wb.ajax({\n    url: xpath + '/actions&xaction=addText',\n    params: values,\n    json: true,\n    success(resp) {\n      Wb.tip('添加成功');\n      win.hide();\n      app.btnTQ.fireClick();\n    },\n    failure(resp) { \n      Wb.error(resp);\n    }\n  });\n};\nwin.show();\nwin.scrollEl.scrollTop = win.scrollEl.scrollLeft = 0;\n\n"},"hasDupCid":0},{"_icon":"item","text":"btnEditText","cls":"Wb.Item","_expanded":true,"properties":{"cid":"btnEditText","icon":"edit","text":"修改"},"events":{"click":"if (!app.textListView.selectionData){\n  Wb.warn(\"请选择一条记录\");\n  return false;\n}\nlet win = app.winEditText;\n\napp.i_position_flag.readonly=true;\napp.i_position_flag.required=true;\n\napp.i_model_id.value=app.gridMain.selectionData.model_id;\napp.i_position_flag.value=app.textListView.selectionData.position_flag;\napp.i_remark.value=app.textListView.selectionData.remark;\n\n\nwin.icon = 'edit';\nwin.title = Str.edit;\nwin.focusControl = null;\nwin.okHandler = (win, values) => {\n  Wb.ajax({\n    url: xpath + '/actions&xaction=editText',\n    params: values,\n    json: true,\n    success(resp) {\n      Wb.tip('修改成功');\n      win.hide();\n      app.btnTQ.fireClick();\n    },\n    failure(resp) { \n      Wb.error(resp);\n    }\n  });\n};\nwin.show();\nwin.scrollEl.scrollTop = win.scrollEl.scrollLeft = 0;\n\n"},"hasDupCid":0},{"_icon":"divider","text":"divider2","cls":"Wb.Divider","properties":{"cid":"divider2"},"hasDupCid":0},{"_icon":"container","text":"container2","cls":"Wb.Container","_expanded":true,"properties":{"cid":"container2","justify":"end","flex":"1"},"hasDupCid":0,"items":[{"_icon":"button","text":"btnTQ","cls":"Wb.Button","properties":{"cid":"btnTQ","text":"查询","visible":"false","type":"primary","shrinkSelf":"false","icon":"search","alignSelf":"end","margin":"false","justifySelf":"end"},"events":{"click":"let selectedItem=app.textListView.selectionData?.position_flag;\nlet data=app.gridMain.selectionData;\n\napp.textListView.load({\n  params: {\n    i_model_id: data.model_id,\n  }, \n  success(){\n    app.textListView.data.forEach((item,index) => {\n      if (item.position_flag==selectedItem){\n        app.textListView.items[index].selected=true;\n      }\n    });\n  },\n});\n"},"_expanded":false,"hasDupCid":0}]}]},{"_icon":"list-view","text":"textListView","cls":"Wb.View","properties":{"cid":"textListView","itemTpl":"<div class=\"w-item w-border w-row w-padding w-align-center w-gapd5\">\n  <div class=\"w-column w-gapd2\">\n    <div class=\"w-name\">{position_flag}</div>\n  </div>\n  <div class=\"w-flex\"></div>\n  <div class=\"w-column w-sized8 w-gapd2\">\n    <div class=\"w-name\">{remark}</div>\n  </div>\n</div>","url":"@xpath + '/actions&xaction=selectEmailModelText'","pagingBar":"false","pageSize":"10","flex":"1","border":"true"},"_expanded":true,"events":{"select":"let content =app.editorContent.value;\n\napp.textListView.data.forEach((item,index) => {\n  content=content.replaceAll('<span style=\"color: red;\">'+item.position_flag+'</span>',item.position_flag);\n});\ncontent=content.replaceAll(app.textListView.selection.data.position_flag,'<span style=\"color: red;\">'+app.textListView.selection.data.position_flag+'</span>');\napp.editorContent.value=content;\n\napp.editorText.value=app.textListView.selection.data.sql_str;\napp.btnSaveSql.disabled=false;\n","itemdblclick":"Wb.log(this.data.