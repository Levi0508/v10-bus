{"title":"","icon":"","img":"","tags":"","hideInMenu":"true","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"let actions = {\n  //查询邮件模板\n  selectEmailModel() {\n    Wb.sendRows({\n      sql: `select * from flhgdb.vw_email_msg_model\n            where  (model_id={?i_model_id?} or {?i_model_id?} is null)\n            and    (project_id={?i_project_id?} or {?i_project_id?} is null)`, \n      params: {\n        i_model_id: Params.i_model_id,\n        i_project_id: Params.i_project_id,\n      },  \n      db: 'dm8' \n    });\n  },\n\n  //查询邮件模板动态文本配置\n  selectEmailModelText() {\n    Wb.sendRows({\n      sql: `select * from flhgdb.vw_email_msg_model_text\n            where  model_id={?i_model_id?} order by position_no`, \n      params: {\n        i_model_id: Params.i_model_id,\n      },  \n      db: 'dm8' \n    });\n  },\n  //保存邮件模板\n  saveModel() {\n    \n    Params.update?.forEach(function(row){\n      Wb.sql({\n        sql: `update flhgdb.tb_email_msg_model a \n              set a.project_id={?i_project_id?},\n                  a.title={?i_title?},\n                  a.remark={?i_remark?},\n                  a.update_time=sysdate   \n              where a.model_id={?i_model_id?}` ,\n        params: {\n          i_model_id: row.$model_id,\n          i_project_id: \"project_id\" in row?row.project_id:row.$project_id,\n          i_title: \"title\" in row?row.title:row.$title,\n          i_remark: \"remark\" in row?row.remark:row.$remark,\n        }, \n        db: 'dm8' \n      });\n    });\n    Params.insert?.forEach(function(row){\n      Wb.sql({\n        sql: `insert into flhgdb.tb_email_msg_model(project_id,remark,title,content,model_type) \n              select {?i_project_id?},\n                     {?i_remark?},\n                     {?i_title?},\n                     {?i_content?},\n                     '1'\n              from dual`, \n        params: {\n          i_project_id: \"project_id\" in row?row.project_id:row.$project_id,\n          i_remark: \"remark\" in row?row.remark:row.$remark,\n          i_title: \"title\" in row?row.title:row.$title,\n          i_content: Params.i_content,\n        }, \n        db: 'dm8' \n      });\n    });\n  },\n  //保存邮件模板内容\n  saveContent() {\n    \n    Wb.sql({\n      sql: `update flhgdb.tb_email_msg_model a\n            set    a.content=REGEXP_REPLACE(replace({?i_content?},'\\t','    '),          -- 要替换的字段\n                                            '>( +)',              -- 正则匹配规则：> 后接1个以上连续空格\n                                            REPLACE(REGEXP_SUBSTR(replace({?i_content?},'\\t','    '), '>( +)'), ' ', '&nbsp;')\n                                           )\n            where  a.model_id={?i_model_id?}`,\n      params: {\n        i_model_id: Params.i_model_id,\n        i_content: Params.i_content,\n      }, \n      db: 'dm8' \n    });\n  },\n  //添加动态文本\n  addText() {\n    \n    Wb.sql({\n      sql: `insert into flhgdb.tb_email_msg_model_text(model_id,position_flag,remark,position_no)\n            select {?i_model_id?},\n                   {?i_position_flag?},\n                   {?i_remark?},\n                   coalesce(max(position_no),0)+1\n            from   flhgdb.tb_email_msg_model_text\n            where  model_id={?i_model_id?}\n            `,\n      params: {\n        i_model_id: Params.i_model_id,\n        i_position_flag: Params.i_position_flag,\n        i_remark: Params.i_remark,\n      }, \n      db: 'dm8' \n    });\n  },\n  //修改动态文本\n  editText() {\n    \n    Wb.sql({\n      sql: `update flhgdb.tb_email_msg_model_text\n            set    remark=coalesce({?i_remark?},remark),\n                   sql_str=coalesce({?i_sql_str?},sql_str),\n                   update_time=sysdate\n            where  model_id={?i_model_id?}\n            and    position_flag={?i_position_flag?}\n            `,\n      params: {\n        i_model_id: Params.i_model_id,\n        i_position_flag: Params.i_position_flag,\n        i_remark: Params.i_remark,\n        i_sql_str: Params.i_sql_str\n      }, \n      db: 'dm8' \n    });\n  },\n};\nactions[Params.xaction]();"},"_icon":"module"}