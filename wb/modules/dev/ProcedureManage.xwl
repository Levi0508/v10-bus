napp.i_step_summary_c.value='';\napp.i_target_table_c.value='';\n\nlet next_step =app.i_step_seq_c.value;\nlet index =next_step.lastIndexOf('.');\nlet next_step_head='';\nlet next_step_tail='';\nif (index>0){\n  next_step =next_step.substring(0,index);\n  index =next_step.lastIndexOf('.');\n  if (index>0){\n      next_step_head =next_step.substring(0,index+1);\n  }else{\n      next_step_head='';\n  }\n  next_step_tail =next_step.substring(index+1);\n  if (parseFloat(next_step_tail)<9){\n    next_step_tail ='0'+(parseFloat(next_step_tail)+1);\n  }else{\n    next_step_tail =parseFloat(next_step_tail)+1;\n  }\n  next_step=next_step_head+next_step_tail;\n  app.i_step_seq_c.value=next_step;\n}\n\n"},"_expanded":true,"hasDupCid":0}]},{"_icon":"container","text":"container1_1_4","cls":"Wb.Container","properties":{"cid":"container1_1_4","layout":"row","align":"center","justify":"end"},"hasDupCid":0,"_expanded":true,"items":[{"_icon":"textarea","text":"i_step_summary_c","cls":"Wb.TextArea","properties":{"cid":"i_step_summary_c","required":"false","text":"注释","flex":"1","textAlign":"left","labelAlign":"right"},"hasDupCid":0,"_expanded":true}]},{"_icon":"container","text":"container1_1_5","cls":"Wb.Container","properties":{"cid":"container1_1_5","layout":"row","align":"center","justify":"end"},"hasDupCid":0,"_expanded":true,"items":[{"_icon":"combo","text":"i_step_type_c","cls":"Wb.Select","properties":{"cid":"i_step_type_c","text":"步骤类别","autoLoad":"all","value":"1","required":"true","flex":"1","textAlign":"left","labelAlign":"right","keyName":"STEP_TYPE"},"hasDupCid":0,"events":{"select":"if (/[123]/.test(app.i_step_type_c.value)){\n  app.i_target_table_c.required=true;\n}else{\n  app.i_target_table_c.required=false;\n}"}}]},{"_icon":"container","text":"container1_1_6","cls":"Wb.Container","properties":{"cid":"container1_1_6","layout":"row","align":"center","justify":"end"},"hasDupCid":0,"_expanded":true,"items":[{"cls":"Wb.Text","properties":{"cid":"i_target_table_c","required":"false","text":"操作目标表","flex":"1","textAlign":"left","labelAlign":"right"},"text":"i_target_table_c","_expanded":true,"_icon":"text","hasDupCid":0}]}]},{"_icon":"edit","text":"codeEditor","cls":"Wb.CodeEditor","properties":{"cid":"codeEditor","language":"sql","flex":"1","margin":"false"},"_expanded":true,"hasDupCid":0,"items":[{"cls":"Wb.Menu","properties":{"cid":"contextMenu","isProperty":"true"},"text":"contextMenu","_expanded":true,"_icon":"menu2","hasDupCid":0,"items":[{"_icon":"item","text":"btnToStep","cls":"Wb.Item","_expanded":true,"properties":{"cid":"btnToStep","text":"跳转到步骤","icon":"location"},"events":{"click":"let step_search=app.codeEditor.selectedText?app.codeEditor.selectedText:app.codeEditor.getCursorText(200).trim();\nWb.log(step_search);\nstep_search=step_search.contains('*/v_step_msg:=')?step_search.firstItem('v_step_msg:='):step_search;\nWb.log(step_search);\nWb.open({\n  url:xpath + '/../ProcedureManage',\n  container:true,\n  success(scope){\n    scope.i_etl_sp_name.value=app.i_etl_sp_name_c.value;\n    scope.i_version_status.value='';\n    scope.i_referenced_object.value='';\n    scope.i_version_id.value='-';\n    scope.i_summary.value='';\n    scope.i_if_check_change.value='1';\n    scope.i_if_exist.value='1';\n    scope.panelOutputMain.height=180;\n    scope.btnQ.fireClick();\n    scope.i_step_search.value=step_search;\n    \n  }\n});\n"},"hasDupCid":0},{"_icon":"item","text":"btnToObject","cls":"Wb.Item","_expanded":false,"properties":{"cid":"btnToObject","text":"跳转到对象","icon":"location"},"events":{"click":"let objectName=app.codeEditor.selectedText?app.codeEditor.selectedText:app.codeEditor.getCursorText(200).trim();\n//Wb.log(objectName);\nWb.ajax({\n    url: xpath + '/actions&xaction=getObjectType',\n    //传参数\n    params: { \n      i_object_name: objectName\n    },\n    json: true,\n    success(resp) {\n      //Wb.log(resp);\n      let object_type=resp.firstItem('-');\n      let object_name=resp.lastItem('-');\n      if (object_type=='TABLE' || object_type=='VIEW' || object_type=='SYNONYM'){\n        Wb.open({\n          url:xpath + '/../ColumnManage',\n          container:true,\n          success(scope){\n            scope.i_project_id.value='';\n            scope.i_table_search.value=object_name.lastItem('.');\n            scope.i_column_search.value='';\n            scope.i_table_type.value='';\n            scope.btnQ.fireClick();\n          }\n        });\n      }else{\n        Wb.open({\n          url:xpath + '/../ProcedureManage',\n          container:true,\n          success(scope){\n            scope.i_etl_sp_name.value=object_name;\n            scope.i_version_status.value='';\n            scope.i_referenced_object.value='';\n            scope.i_version_id.value='-';\n            scope.i_summary.value='';\n            scope.i_if_check_change.value='1';\n            scope.i_if_exist.value='1';\n            scope.panelOutputMain.height=180;\n            scope.btnQ.fireClick();\n          }\n        });\n      }\n    },  \n  });\n\n\n\n"},"hasDupCid":0},{"_icon":"item","text":"btnGetColumns","cls":"Wb.Item","_expanded":false,"properties":{"cid":"btnGetColumns","text":"获取字段清单","icon":"location"},"events":{"click":"let objectName=app.codeEditor.selectedText?app.codeEditor.selectedText:app.codeEditor.getCursorText(200).trim();\n//Wb.log(objectName);\nWb.ajax({\n    url: xpath + '/actions&xaction=getObjectType',\n    //传参数\n    params: { \n      i_object_name: objectName\n    },\n    json: true,\n    success(resp) {\n      //Wb.log(resp);\n      let object_type=resp.firstItem('-');\n      let object_name=resp.lastItem('-');\n      let blanks=app.codeEditor.getCursorText().toUpperCase().indexOf(object_name);\n      if (object_type=='TABLE' || object_type=='VIEW' || object_type=='SYNONYM'){\n        Wb.ajax({\n          url: xpath + '/actions&xaction=getColumnList',\n          //传参数\n          params: { \n            i_object_name: object_name,\n            i_blanks: blanks,\n          },\n          json: true,\n          success(resp) {\n            app.codeEditor.insertText(resp);\n          }\n        });\n      }else{\n        Wb.warn('非表或视图，获取失败！');\n      }\n    },  \n  });\n\n\n\n"},"hasDupCid":0},{"_icon":"item","text":"btnQueryData","cls":"Wb.Item","_expanded":false,"properties":{"cid":"btnQueryData","text":"查询数据","icon":"location"},"events":{"click":"let objectName=app.codeEditor.selectedText?app.codeEditor.selectedText:app.codeEditor.getCursorText(200).trim();\n//Wb.log(objectName);\nWb.ajax({\n    url: xpath + '/actions&xaction=getObjectType',\n    //传参数\n    params: { \n      i_object_name: objectName\n    },\n    json: true,\n    success(resp) {\n      //Wb.log(resp);\n      let object_type=resp.firstItem('-');\n      let object_name=resp.lastItem('-');\n      if (object_type=='TABLE' || object_type=='VIEW' || object_type=='SYNONYM'){\n        if (app.panelDB.items$.length==0){\n          Wb.run({ \n            url: 'dbe', \n            owner: 'viewport1', \n            success(scope) { \n              app.panelDB.add(scope.viewport1) ;\n              scope.addSql('select * from '+object_name,'dm8',true);\n              scope.tree.width='1em';\n            } \n          });\n          app.panelDB.height=640;\n          app.container1_1.hide();\n        }else{\n          app.panelDB.items[0].app$.addSql('select * from '+object_name,'dm8',true);\n          app.panelDB.height=640;\n          app.container1_1.hide();\n        }\n      }else{\n        Wb.warn('非表或视图，获取失败！');\n      }\n    },  \n  });\n\n\n\n"},"hasDupCid":0}]}]},{"_icon":"panel","text":"panelStepBtn","cls":"Wb.Panel","properties":{"cid":"panelStepBtn","layout":"row","align":"center","justify":"end","border":"false","gap":".7em"},"hasDupCid":0,"_expanded":true,"items":[{"_icon":"button","text":"btnDB","cls":"Wb.Button","_expanded":true,"properties":{"cid":"btnDB","justifySelf":"center","text":"数据库浏览器","type":"tool","width":"100","border":"true","alignSelf":"center","margin":"false"},"events":{"click":"if (app.panelDB.items$.length==0){\n  Wb.run({ \n    url: 'dbe', \n    owner: 'viewport1', \n    success(scope) { \n      app.panelDB.add(scope.viewport1) ;\n      scope.addSql('','dm8',true);\n      scope.tree.width='1em';\n    } \n  });\n  app.panelDB.height=640;\n  app.container1_1.hide();\n}else{\n  if(app.panelDB.height>=640){\n    app.panelDB.height=0;\n    app.container1_1.show();\n  }else{\n    app.panelDB.height=640;\n    app.container1_1.hide();\n  }\n}"}},{"_icon":"button","text":"btnStepType1","cls":"Wb.Button","properties":{"cid":"btnStepType1","alignSelf":"center","margin":"false","type":"tool","justifySelf":"center","border":"true","text":"识别","width":"100"},"events":{"click":"\n\n\nlet v_step_sql=app.codeEditor.value;\nlet v_target_table='';\nlet v_start_idx=0;\n\nv_start_idx=v_step_sql.search(/\\S/);\n\nif (v_step_sql.substring(v_start_idx,v_start_idx+11)=='delete from' || v_step_sql.substring(v_start_idx,v_start_idx+11)=='DELETE FROM'){\n  v_target_table=v_step_sql.substring(v_start_idx+11);\n  v_start_idx=v_target_table.search(/\\S/);\n  v_target_table=v_target_table.substring(v_start_idx);\n  v_start_idx=v_target_table.search(' ');\n  \n  if (v_start_idx==-1) v_start_idx=v_target_table.search(';');\n\n  if (v_start_idx==-1){\n    v_target_table=v_target_table.substring(0);\n  }else{\n    v_target_table=v_target_table.substring(0,v_start_idx);\n  }\n  app.i_step_type_c.value='1';\n  app.i_target_table_c.value=v_target_table;\n}else if (v_step_sql.substring(v_start_idx,v_start_idx+11)=='insert into' || v_step_sql.substring(v_start_idx,v_start_idx+11)=='INSERT INTO'){\n  \n  v_target_table=v_step_sql.substring(v_start_idx+11);\n  v_target_table=v_target_table.firstItem('(');\n  app.i_step_type_c.value='2';\n  app.i_target_table_c.value=v_target_table;\n}else if (v_step_sql.substring(v_start_idx,v_start_idx+7)=='update ' || v_step_sql.substring(v_start_idx,v_start_idx+7)=='UPDATE '){\n  v_target_table=v_step_sql.substring(v_start_idx+7);\n  v_start_idx=v_target_table.search(/\\S/);\n  v_target_table=v_target_table.substring(v_start_idx);\n  v_start_idx=v_target_table.search(' ');\n  \n  if (v_start_idx==-1) v_start_idx=v_target_table.search('\\n');\n  \n  if (v_start_idx==-1){\n    v_target_table=v_target_table.substring(0);\n  }else{\n    v_target_table=v_target_table.substring(0,v_start_idx);\n  }\n  app.i_step_type_c.value='3';\n  app.i_target_table_c.value=v_target_table;\n}else if (v_step_sql.indexOf(':=')>0 || v_step_sql.substring(v_start_idx,v_start_idx+7)=='select ' || v_step_sql.substring(v_start_idx,v_start_idx+7)=='SELECT '){\n  app.i_step_type_c.value='4';\n  app.i_target_table_c.value='';\n}else if (v_step_sql.indexOf('loop')>=0 || v_step_sql.indexOf('LOOP')>=0){\n  app.i_step_type_c.value='5';\n  app.i_target_table_c.value='';\n}else if (v_step_sql.substring(v_start_idx,v_start_idx+3)=='if ' || v_step_sql.substring(v_start_idx,v_start_idx+3)=='IF '){\n  app.i_step_type_c.value='6';\n  app.i_target_table_c.value='';\n}else{\n  app.i_step_type_c.value='9';\n  app.i_target_table_c.value='';\n}\n"},"_expanded":true,"hasDupCid":0},{"_icon":"button","text":"btnCodeEdit","cls":"Wb.Button","properties":{"cid":"btnCodeEdit","text":"保存","width":"100","alignSelf":"center","margin":"false","type":"primary","justifySelf":"center"},"events":{"click":"let win = app.winCode;\nWb.ajax({\n    url: xpath + (win.title=='程序代码-添加步骤' || win.title=='程序代码-步骤插入'?'/actions&xaction=addStep':'/actions&xaction=editStep'),\n    params: {\n      i_etl_sp_name:app.i_etl_sp_name_c.value,\n      i_version_id:app.i_version_id_c.value,\n      i_step_seq:app.i_step_seq_c.value,\n      i_step_summary:app.i_step_summary_c.value,\n      i_step_type:app.i_step_type_c.value,\n      i_step_sql:app.codeEditor.value,\n      i_target_table:app.i_target_table_c.value\n    },\n    json: true,\n    success(resp) {\n      if (resp.o_return_code=='0'){\n        Wb.tip(win.title=='程序代码-添加步骤' || win.title=='程序代码-步骤插入'?'添加成功':'修改成功');\n        //添加步骤可以接着添加,其他的操作完成后就关闭\n        if (win.title!='程序代码-添加步骤'){\n          win.hide();\n        }\n        //下一步骤序号自动生成\n        let next_step =app.i_step_seq_c.value;\n        //条件和循环步骤下一步直接跳转到下一级步骤\n        if (app.i_step_type_c.value==='5' || app.i_step_type_c.value==='6')\n        {\n          next_step=next_step+'.01';\n        }\n        //步骤序号往下增加\n        let index =next_step.lastIndexOf('.');\n        let next_step_head='';\n        let next_step_tail='';\n        if (index<0){\n          if (parseFloat(next_step)<9)\n            next_step_tail ='0'+(parseFloat(next_step)+1);\n          else\n            next_step_tail =parseFloat(next_step)+1;\n        }else{\n          next_step_head =next_step.substring(0,index+1);\n          next_step_tail =next_step.substring(index+1);\n\n          if (parseFloat(next_step_tail)<9)\n            next_step_tail ='0'+(parseFloat(next_step_tail)+1);\n          else \n            next_step_tail =parseFloat(next_step_tail)+1;\n        }\n        next_step=next_step_head+next_step_tail;\n        //步骤序号更新\n        app.i_step_seq_c.value=next_step;\n        app.i_step_type_c.value='';\n        app.i_step_summary_c.value='';\n        app.i_target_table_c.value='';\n        //刷新步骤表格\n        let selectedItem=app.gridStep.selectionData?.step_seq;\n        \n        app.gridStep.load({\n          params: {\n            i_etl_sp_name: app.gridStep.selectionData.etl_sp_name,\n            i_version_id: app.gridStep.selectionData.version_id,\n            i_step_search: app.i_step_search.value,\n          },\n          success(){\n            app.gridStep.data.forEach((item,index) => {\n              if (item.step_seq==selectedItem){\n                app.gridStep.items[index].selected=true;\n                Wb.log('selected');\n              }\n            });\n          },\n        });\n      }else{\n        Wb.error(resp.o_return_msg);\n      }\n    },\n    failure(resp) { \n      Wb.error(resp);\n    }\n});"}}]}]},{"