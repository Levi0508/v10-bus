{"title":"程序管理","icon":"console","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"// serverScript是页面初始化的时候就执行的代码\n// 这里的Params.queryObject是跳转页面点击跳转地址传递过来的 查询表名参数\nlet queryObject = Params.queryObject;\n//Wb.log(\"你好\");\n//Wb.log(queryObject);\n// Wb.set()方法将参数传递给了initialize方法中\nif(queryObject) {\n  Wb.set({ queryObject: Wb.encode(queryObject) });\n} else {\n  Wb.set({ queryObject: Wb.encode('') });\n}"},"_icon":"module","_expanded":true,"events":{"initialize":"Wb.apply(app, {\n  queryObject: _$queryObject$_,\n  onChangeColumn() {\n    app.btnSaveColumn.disabled = false;\n    app.btnCancelColumn.disabled = false;\n  },\n  onChangeJoin() {\n    app.btnSaveJoin.disabled = false;\n    app.btnCancelJoin.disabled = false;\n  },\n  saveColumn(callback) {\n    app.gridColumn.sync({                                           //把表格中未提交的增删改数据同步到后台url指定的地址。成功后将自动调用commit方法提交数据\n      url: xpath + '/actions&xaction=saveColumn',                 //调用方法是save\n      send:true,\n      success(resp) {\n        app.btnSaveColumn.disabled = true;\n        app.btnCancelColumn.disabled = true;\n        callback?.();\n        if (Wb.decode(resp).o_return_code!='0'){\n          Wb.error(Wb.decode(resp).o_return_msg);\n        }\n      },\n      failure(resp) {\n        Wb.error(resp);\n      }\n    });\n  },\n  saveJoin(callback) {\n    app.gridJoin.sync({                                           //把表格中未提交的增删改数据同步到后台url指定的地址。成功后将自动调用commit方法提交数据\n      url: xpath + '/actions&xaction=saveJoin',                 //调用方法是save\n      success(resp) {\n        app.btnSaveJoin.disabled = true;\n        app.btnCancelJoin.disabled = true;\n        callback?.();\n        if (Wb.decode(resp).o_return_code!='0'){\n          Wb.error(Wb.decode(resp).o_return_msg);\n        }\n      },\n      failure(resp) {\n        Wb.error(resp);\n      }\n    });\n  },\n  gridSort(me,colItem, td, e, name, sortType){\n    if (name && me.columnsSortable && colItem.sortable) {\n      let sorter;\n      if (me.clickHeaderRipple)\n        td.rippleEffect(e.x, e.y);\n        sorter = me.sorterList?.find(item => item.name == name);\n        me.sorters = { name, desc: sorter?(!sorter.desc):false };\n        Wb.log('排序方式:'+sortType+',排序列:'+name);\n      if (sortType=='local'){\n        if (me.fireEvent('beforesort', me.data, me.sorters) !== false) {\n          let keys = [], desc = [];\n          keys.push(me.sorters.name);\n          desc.push(me.sorters.desc);\n          me.data = me.data.mixSort(keys, desc);\n        }\n      }else{\n        if (me.fireEvent('beforesort', me.data, me.sorters) !== false){\n          me.reload();\n        }\n      }\n    }\n  },\n  itemColor(me,el){\n    el.cls = 'w-error-color';\n  },\n});\nWb.Grid.prototype.onHeaderClick = function(e) {\n  let me = this, td = e.target.closest('td'), colItem = td?.colItem, name = colItem?.fieldName;\n  me.fireEvent('headerclick', colItem, td, e, name);\n}","beforeunload":"if (!app.btnSaveColumn.disabled||!app.btnSaveJoin.disabled)\n  return false;","finalize":"if (app.queryObject!=''){\n  app.i_etl_sp_name.value=app.queryObject;\n  app.btnQ.fireClick();\n}"},"items":[{"_icon":"viewport","text":"viewport1","cls":"Wb.Viewport","properties":{"cid":"viewport1","autoContextMenu":"true","padding":"0.7em","background":"true","gap":"0.7em","layout":"column"},"_expanded":true,"items":[{"_icon":"label","text":"label1","cls":"Wb.Label","_expanded":true,"properties":{"cid":"label1","text":"程序管理","titleType":"title3"},"hasDupCid":1},{"_icon":"panel","text":"panelInput","cls":"Wb.Panel","properties":{"cid":"panelInput","layout":"row","roundBorder":"true","padding":"true","gap":"true","shrink":"true"},"_expanded":true,"hasDupCid":1,"items":[{"_icon":"combo","text":"i_if_check_change","cls":"Wb.Select","properties":{"cid":"i_if_check_change","text":"检查变动","clearButton":"false","value":"'0'","autoLoad":"all","border":"false","labelWidth":"80","data":"[{k:'0',v:'否'},{k:'1',v:'是'},]","textField":"v","valueField":"k","forceSelect":"true","width":"150"},"_expanded":false},{"_icon":"combo","text":"i_version_status","cls":"Wb.Select","properties":{"cid":"i_version_status","clearButton":"true","multiSelect":"true","labelWidth":"80","border":"false","tagWidth":"calc(100%-3em)","width":"200","data":"[{k:'1',v:'已发布'},{k:'2',v:'修订中'}]","textField":"v","valueField":"k","placeholder":"修订状态"},"_expanded":true},{"_icon":"combo","text":"i_if_exist","cls":"Wb.Select","properties":{"cid":"i_if_exist","text":"是否在库","clearButton":"false","labelWidth":"80","value":"'1'","autoLoad":"all","border":"false","data":"[{k:'0',v:'否'},{k:'1',v:'是'},]","valueField":"k","textField":"v","forceSelect":"true","width":"150"},"_expanded":true},{"_icon":"text","text":"i_referenced_object","cls":"Wb.Text","properties":{"cid":"i_referenced_object","labelWidth":"80","width":"400","clearButton":"true","text":"引用对象"},"_expanded":true},{"_icon":"text","text":"i_version_id","cls":"Wb.Text","properties":{"cid":"i_version_id","labelWidth":"80","value":"-","visible":"false","text":"版本"},"_expanded":true},{"_icon":"text","text":"i_summary","cls":"Wb.Text","properties":{"cid":"i_summary","labelWidth":"80","width":"300","text":"程序说明"},"_expanded":true,"hasDupCid":0}]},{"_icon":"panel","text":"panelOutput","cls":"Wb.Panel","properties":{"cid":"panelOutput","autoScroll":"true","layout":"column","flex":"1","border":"1","roundBorder":"true"},"_expanded":true,"hasDupCid":1,"items":[{"_icon":"panel","text":"panelOutputMain","cls":"Wb.Panel","properties":{"cid":"panelOutputMain","autoScroll":"true","height":"40vh","border":"1","layout":"row"},"_expanded":true,"items":[{"_icon":"panel","text":"panel2","cls":"Wb.Panel","properties":{"cid":"panel2","flex":"1","border":"1"},"hasDupCid":0,"_expanded":true,"items":[{"_icon":"grid","text":"gridProcedure","cls":"Wb.Grid","properties":{"cid":"gridProcedure","url":"@xpath + '/actions&xaction=selectProcedure'","columnsSortable":"true","multiSelect":"false","flex":"1","border":"false","autoLoad":"false","pageSize":"-1","autoSelect":"false"},"_expanded":true,"events":{"select":"let data=this.selectionData;\n\napp.gridVersion.load({\n  params: {\n    i_if_check_change: '0',\n    i_version_status: null,\n    i_if_exist: '0',\n    i_etl_sp_name: data.etl_sp_name,\n    i_referenced_object: null,\n    i_version_id: app.toggleVersionHis.value==true?'':data.version_id,\n    i_summary: null\n  }, \n  success(){\n  \n  },\n});","headerclick":"//排序执行2\ntd = e.target.closest('td') ;\ncolItem = td?.colItem;\nname = colItem?.fieldName;\napp.gridSort(this,colItem, td, e,name,'local');","success":"// if(this.data && this.data.length>0){\n//   this.firstItem.selected=true;\n// }else{\n//   app.gridVersion.setData(null);\n//   app.gridParams.setData(null);\n//   app.gridStep.setData(null);\n//   app.treeDepend.setData(null);\n// }\n"},"hasDupCid":0,"items":[{"_icon":"toolbar","text":"tbar","cls":"Wb.Toolbar","properties":{"cid":"tbar","isProperty":"true","layout":"row","justify":"start"},"hasDupCid":0,"_expanded":true,"items":[{"_icon":"item","text":"btnAdd","cls":"Wb.Item","_expanded":true,"properties":{"cid":"btnAdd","icon":"add","text":"添加"},"events":{"click":"\nlet win = app.winEditProcedure;\napp.i_etl_sp_name_m.visible=true;\napp.i_etl_sp_name_m.readonly=false;\napp.i_etl_sp_name_m.required=true;\napp.i_object_type_m.visible=true;\napp.i_object_type_m.readonly=false;\napp.i_object_type_m.required=true;\napp.i_summary_m.visible=true;\napp.i_summary_m.readonly=false;\napp.i_summary_m.required=true;\n\napp.i_version_id_m.visible=false;\napp.i_version_id_m.readonly=false;\napp.i_version_id_m.required=false;\napp.i_upgrade_summary_m.visible=false;\napp.i_upgrade_summary_m.readonly=false;\napp.i_upgrade_summary_m.required=false;\n\nwin.icon = 'add';\nwin.title = Str.add;\nwin.focusControl = null;\nwin.okHandler = (win, values) => {\n  Wb.ajax({\n    url: xpath + '/actions&xaction=add',\n    params: values,\n    json: true,\n    success(resp) {\n      if (resp.o_return_code=='0'){\n        Wb.tip('添加成功');\n        win.hide();\n        app.btnQ.fireClick();\n      }else{\n        Wb.error(resp.o_return_msg);\n      }\n    },\n    failure(resp) { \n      Wb.error(resp);\n    }\n  });\n};\nwin.show();\nwin.scrollEl.scrollTop = win.scrollEl.scrollLeft = 0;\n"},"hasDupCid":0},{"_icon":"item","text":"btnEdit","cls":"Wb.Item","_expanded":true,"properties":{"cid":"btnEdit","icon":"edit","text":"修改"},"events":{"click":"let data=app.gridProcedure.selectionData;\n\nif (data.version_status_k=='2'){\n  let win = app.winEditProcedure;\n  app.i_etl_sp_name_m.visible=true;\n  app.i_etl_sp_name_m.readonly=true;\n  app.i_etl_sp_name_m.required=true;\n  app.i_etl_sp_name_m.value=data.etl_sp_name;\n  app.i_version_id_m.visible=true;\n  app.i_version_id_m.readonly=true;\n  app.i_version_id_m.required=true;\n  app.i_version_id_m.value=data.version_id;\n  app.i_summary_m.visible=true;\n  app.i_summary_m.readonly=false;\n  app.i_summary_m.required=true;\n  app.i_summary_m.value=data.summary;\n  app.i_upgrade_summary_m.visible=true;\n  app.i_upgrade_summary_m.readonly=false;\n  app.i_upgrade_summary_m.required=true;\n  app.i_upgrade_summary_m.value=data.upgrade_summary;\n  app.i_object_type_m.visible=false;\n  app.i_object_type_m.required=false;\n  win.icon = 'edit';\n  win.title = Str.edit;\n  win.focusControl = null;\n  win.okHandler = (win, values) => {\n    Wb.ajax({\n      url: xpath + '/actions&xaction=edit',\n      params: values,\n      json: true,\n      success(resp) {\n        if (resp.o_return_code=='0'){\n          Wb.tip('修改成功');\n          win.hide();\n          app.btnQ.fireClick();\n        }else{\n          Wb.error(resp.o_return_msg);\n        }\n      },\n      failure(resp) { \n        Wb.error(resp);\n      }\n    });\n  };\n\n  win.show();\n  win.scrollEl.scrollTop = win.scrollEl.scrollLeft = 0;\n}else{\n  Wb.warn('程序状态已发布，不能操作');\n}"},"hasDupCid":0},{"_icon":"divider","text":"divider1","cls":"Wb.Divider","properties":{"cid":"divider1"},"hasDupCid":0},{"_icon":"item","text":"btnUpgrade","cls":"Wb.Item","_expanded":true,"properties":{"cid":"btnUpgrade","icon":"update","text":"升级"},"events":{"click":"let data=app.gridProcedure.selectionData;\n\nif (data.version_status_k=='1'){\n  let win = app.winEditProcedure;\n  app.i_etl_sp_name_m.visible=true;\n  app.i_etl_sp_name_m.readonly=true;\n  app.i_etl_sp_name_m.required=true;\n  app.i_etl_sp_name_m.setValue(data.etl_sp_name);\n  app.i_version_id_m.visible=true;\n  app.i_version_id_m.readonly=true;\n  app.i_version_id_m.required=true;\n  app.i_version_id_m.setValue(data.version_id);\n  app.i_summary_m.visible=true;\n  app.i_summary_m.readonly=true;\n  app.i_summary_m.required=true;\n  app.i_summary_m.setValue(data.summary);\n  app.i_upgrade_summary_m.visible=true;\n  app.i_upgrade_summary_m.readonly=false;\n  app.i_upgrade_summary_m.required=true;\n\n  app.i_object_type_m.visible=false;\n  app.i_object_type_m.required=false;\n  win.icon = 'update';\n  win.title = '升级';\n  win.focusControl = null;\n  win.okHandler = (win, values) => {\n    Wb.ajax({\n      url: xpath + '/actions&xaction=upgrade',\n      params: values,\n      json: true,\n      success(resp) {\n        if (resp.o_return_code=='0'){\n          Wb.tip('升级成功');\n          app.btnQ.fireClick();\n        }else{\n          Wb.error(resp.o_return_msg);\n        }\n        win.hide();\n      },\n      failure(resp) { \n        Wb.error(resp);\n      }\n    });\n  };\n\n  win.show();\n  win.scrollEl.scrollTop = win.scrollEl.scrollLeft = 0;\n}else{\n  Wb.warn('程序状态未发布，不能操作');\n}\n"},"hasDupCid":0},{"_icon":"item","text":"btnRelease","cls":"Wb.Item","_expanded":true,"properties":{"cid":"btnRelease","icon":"ok","text":"发布"},"events":{"click":"let data=app.gridProcedure.selectionData;\n\nif (data.version_status_k=='2'){\n  let win = app.winEditProcedure;\n  app.i_etl_sp_name_m.visible=true;\n  app.i_etl_sp_name_m.readonly=true;\n  app.i_etl_sp_name_m.required=true;\n  app.i_etl_sp_name_m.setValue(data.etl_sp_name);\n  app.i_version_id_m.visible=true;\n  app.i_version_id_m.readonly=true;\n  app.i_version_id_m.required=true;\n  app.i_version_id_m.setValue(data.version_id);\n  app.i_summary_m.visible=true;\n  app.i_summary_m.readonly=true;\n  app.i_summary_m.required=true;\n  app.i_summary_m.setValue(data.summary);\n  app.i_upgrade_summary_m.visible=true;\n  app.i_upgrade_summary_m.readonly=true;\n  app.i_upgrade_summary_m.required=true;\n  app.i_upgrade_summary_m.setValue(data.upgrade_summary);\n\n  app.i_object_type_m.visible=false;\n  app.i_object_type_m.required=false;\n  win.icon = 'ok';\n  win.title = '发布';\n  win.focusControl = null;\n  win.okHandler = (win, values) => {\n    Wb.ajax({\n      url: xpath + '/actions&xaction=release',\n      params: values,\n      json: true,\n      success(resp) {\n        if (resp.o_return_code=='0'){\n          Wb.tip('发布成功');\n          app.btnQ.fireClick();\n        }else{\n          Wb.error(resp.o_return_msg);\n        }\n        win.hide();\n      },\n      failure(resp) { \n        Wb.error(resp);\n      }\n    });\n  };\n\n  win.show();\n  win.scrollEl.scrollTop = win.scrollEl.scrollLeft = 0;\n}else{\n  Wb.warn('程序状态已发布，不能操作');\n}\n"},"hasDupCid":0},{"_icon":"item","text":"btnCompile","cls":"Wb.Item","_expanded":true,"properties":{"cid":"btnCompile","icon":"wrench","text":"编译"},"events":{"click":"let data=app.gridProcedure.selectionData;\n\nif (data.version_status_k=='2' ){\n  let win = app.winEditProcedure;\n  app.i_etl_sp_name_m.visible=true;\n  app.i_etl_sp_name_m.readonly=true;\n  app.i_etl_sp_name_m.required=true;\n  app.i_etl_sp_name_m.setValue(data.etl_sp_name);\n  app.i_version_id_m.visible=true;\n  app.i_version_id_m.readonly=true;\n  app.i_version_id_m.required=true;\n  app.i_version_id_m.setValue(data.version_id);\n  app.i_summary_m.visible=true;\n  app.i_summary_m.readonly=true;\n  app.i_summary_m.required=true;\n  app.i_summary_m.setValue(data.summary);\n  app.i_upgrade_summary_m.visible=true;\n  app.i_upgrade_summary_m.readonly=true;\n  app.i_upgrade_summary_m.required=false;\n  app.i_upgrade_summary_m.setValue(data.upgrade_summary);\n\n  app.i_object_type_m.visible=false;\n  app.i_object_type_m.required=false;\n  win.icon = 'wrench';\n  win.title = '编译';\n  win.focusControl = null;\n  win.okHandler = (win, values) => {\n    Wb.ajax({\n      url: xpath + '/actions&xaction=compile',\n      params: values,\n      json: true,\n      success(resp) {\n        if (resp.o_return_code=='0'){\n          Wb.tip('编译成功');\n          app.btnQ.fireClick();\n        }else{\n          Wb.error(resp.o_return_msg);\n        }\n        win.hide();\n      },\n      failure(resp) { \n        Wb.error(resp);\n      }\n    });\n  };\n\n  win.show();\n  win.scrollEl.scrollTop = win.scrollEl.scrollLeft = 0;\n}else{\n  Wb.warn('程序状态已发布，不能操作');\n}\n"},"hasDupCid":0},{"_icon":"divider","text":"divider2","cls":"Wb.Divider","properties":{"cid":"divider2"},"hasDupCid":1},{"_icon":"combo","text":"i_etl_sp_name","cls":"Wb.Select","properties":{"cid":"i_etl_sp_name","url":"@xpath + '/actions&xaction=selectProcedureList'","textField":"etl_sp_summary","valueField":"etl_sp_name","isProperty":"false","clearButton":"true","width":"400","placeholder":"搜索"},"events":{"select":"let me= this;\napp.i_if_exist.value = '0'; \napp.i_if_check_change.value = '1';\napp.panelOutputMain.height=180;\napp.btnQ.fireClick();","clearclick":"let me= this;\napp.i_if_exist.value = '1'; \napp.i_if_check_change.value = '0';\napp.i_step_search.value='';\napp.panelOutputMain.height = 300;\n\napp.btnQ.fireClick();"},"hasDupCid":0},{"_icon":"container","text":"containerQ","cls":"Wb.Container","_expanded":true,"properties":{"cid":"containerQ","flex":"1","justify":"end","layout":"row"},"hasDupCid":0,"items":[{"_icon":"switcher-on","text":"toggleVersionHis","cls":"Wb.Toggle","properties":{"cid":"toggleVersionHis","text":"版本历史","clickToggle":"true","visible":"true","justifySelf":"end"