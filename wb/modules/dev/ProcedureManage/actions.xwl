{"title":"","icon":"","img":"","tags":"","hideInMenu":"true","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"let actions = {\n  //查询程序\n  selectProcedure() {\n    let result=Wb.sql({\n      sql: `select sql_str from app.vw_call_sp_sql_str where sp_name='APP.P30000'`, \n      db: 'dm8' \n    });\n    result = Wb.sql({\n      sql: result.items[0].sql_str, \n      params: {\n        i_if_check_change: Params.i_if_check_change,\n        i_version_status: Params.i_version_status,\n        i_if_exist: Params.i_if_exist,\n        i_etl_sp_name: Params.i_etl_sp_name,\n        i_referenced_object: Params.i_referenced_object,\n        i_version_id: Params.i_version_id,\n        i_summary: Params.i_summary\n      }, \n      db: 'dm8' ,\n    });\n    Wb.send(result.rt_cursor);\n  },\n  //查询参数\n  selectParams() {\n    let result=Wb.sql({\n      sql: `select sql_str from app.vw_call_sp_sql_str where sp_name='APP.P30001'`, \n      db: 'dm8' \n    });\n    result = Wb.sql({\n      sql: result.items[0].sql_str, \n      params: {\n        i_etl_sp_name: Params.i_etl_sp_name,\n        i_version_id: Params.i_version_id,\n        i_params_type: Params.i_params_type\n      }, \n      db: 'dm8' \n    });\n    Wb.send(result.rt_cursor);\n  },\n  //查询步骤\n  selectStep() {\n      \n    let result=Wb.sql({\n      sql: `select sql_str from app.vw_call_sp_sql_str where sp_name='APP.P30002'`, \n      db: 'dm8' \n    });\n    result = Wb.sql({\n      sql: result.items[0].sql_str, \n      params: {\n        i_etl_sp_name: Params.i_etl_sp_name,\n        i_version_id: Params.i_version_id,\n        i_step_search: Params.i_step_search\n      },\n      db: 'dm8',\n      paging: true,\n      rs:10000\n    }); \n    Wb.send(result.rt_cursor);\n  },\n  //查询表关联(插入步骤)\n  selectStepJoin() {\n    let result=Wb.sql({\n      sql: `select sql_str from app.vw_call_sp_sql_str where sp_name='APP.P30003'`, \n      db: 'dm8' \n    });\n    result = Wb.sql({\n      sql: result.items[0].sql_str, \n      params: {\n        i_etl_sp_name: Params.i_etl_sp_name,\n        i_version_id: Params.i_version_id,\n        i_step_seq: Params.i_step_seq\n      }, \n      db: 'dm8' \n    });\n    Wb.send(result.rt_cursor);\n  },\n  //查询字段映射(插入步骤)\n  selectStepColumn() {\n    let result=Wb.sql({\n      sql: `select sql_str from app.vw_call_sp_sql_str where sp_name='APP.P30005'`, \n      db: 'dm8' \n    });\n    result = Wb.sql({\n      sql: result.items[0].sql_str, \n      params: {\n        i_etl_sp_name: Params.i_etl_sp_name,\n        i_version_id: Params.i_version_id,\n        i_step_seq: Params.i_step_seq,\n        i_target_table: Params.i_target_table,\n        i_user_code: Wb.username\n      }, \n      db: 'dm8' \n    });\n    Wb.send(result.rt_cursor);\n  },\n  //查询程序依赖\n  selectDepend() {\n    Params.sid ??= Params.i_etl_sp_name;\n    let result=Wb.sql({\n      sql: `select sql_str from app.vw_call_sp_sql_str where sp_name='APP.P30009'`, \n      db: 'dm8' \n    });\n    result = Wb.sql({\n      sql: result.items[0].sql_str, \n      params: {\n        i_etl_sp_name: Params.sid,\n        i_if_refresh: '1',\n        i_user_code: Wb.username\n      }, \n      db: 'dm8' \n    });\n    Wb.send(result.rt_cursor);\n  },\n  //查询字典码值\n  selectDictValue() {\n    Wb.sendRows({\n      sql: 'select * from app.VW_DICT where DICT_CODE={?I_DICT_CODE?} or {?I_DICT_CODE?} is null', \n        params: {\n          I_DICT_CODE: Params.I_DICT_CODE,\n          \n        },  \n        db: 'dm8' \n    });\n  },\n  //查询程序清单\n  selectProcedureList() {\n    Wb.sendRows({\n      sql:`select distinct etl_sp_name,etl_sp_name||'-'||summary as etl_sp_summary from APP.tb_etl_sp \n           where  (etl_sp_name={?i_etl_sp_name?} or {?i_etl_sp_name?} is null) and (instr(upper(etl_sp_name||'-'||summary) , upper({?query?}))>0 or {?query?} is null) order by etl_sp_name`,\n      params: {\n        i_etl_sp_name: Params.i_etl_sp_name,\n        query:Params.query,\n      },\n      db:'dm8'\n    });\n  },\n  //查询字典清单\n  selectDictList() {\n    Wb.sendRows({\n      sql:\"select distinct dict_code, dict_code||'-'||dict_name||'('||key_name||')' as dict_name from app.tb_dict order by dict_code\",\n      db:'dm8'\n    });\n  },\n  //获取对象类别\n  getObjectType() {\n    let result = Wb.sql({\n      sql:`select max(object_type) as object_type,max(owner||'.'||object_name) as object_name from all_objects \n           where  object_type in ('TABLE','VIEW','PROCEDURE','FUNCTION','SYNONYM') \n           and    owner||'.'||object_name in (select case when column_value like '%(%' then \n                                                               upper(substr(column_value,1,instr(column_value,'(')-1)) \n                                                          else upper(column_value) end\n                                              from   table(app.f_split({?i_object_name?},' '))\n                                              where  column_value like '%.%'\n                                             )`,\n      params: {\n        i_object_name:Params.i_object_name,\n      },\n      db:'dm8'\n    });\n    Wb.send(result.items[0].object_type+'-'+result.items[0].object_name);\n  },\n  //获取字段清单\n  getColumnList() {\n    let result = Wb.sql({\n      sql:`select chr(10)||listagg(lpad(' ',{?i_blanks?},' ')||column_name||','||lpad(' ',40-length(column_name),' ')||'--'||replace(replace(column_comments,')','）'),'(','（'),chr(10)) within group(order by column_id) as column_list\n           from   app.tb_columns  \n           where  table_full_name={?i_object_name?}`,\n      params: {\n        i_object_name:Params.i_object_name,\n        i_blanks:Params.i_blanks,\n      },\n      db:'dm8'\n    });\n    Wb.send(result.items[0].column_list);\n  },\n  saveJoin() {\n    let delete_rt_code=0;\n    let delete_rt_msg=Params.del?'删除执行成功':'';\n    let update_rt_code=0;\n    let update_rt_msg=Params.update?'更新执行成功':'';\n    let insert_rt_code=0;\n    let insert_rt_msg=Params.insert?'插入执行成功':'';\n    \n\n    //Params.del是后台记录的删除的记录数组\n    Params.del?.forEach(function(row){\n      let result=Wb.sql({\n        sql: `select sql_str from app.vw_call_sp_sql_str where sp_name='APP.PR_ETL_SP_STEP_JOIN_DELETE'`, \n        db: 'dm8' \n      });\n      result = Wb.sql({\n        sql: result.items[0].sql_str, \n        params: {\n          i_etl_sp_name: row.$etl_sp_name,\n          i_version_id: row.$version_id,\n          i_step_seq: row.$step_seq,\n          i_join_seq: row.$join_seq,\n          i_user_code: Wb.username\n        }, \n        db: 'dm8' \n      });\n      if (result.o_return_code!=0){\n        delete_rt_code=result.o_return_code;\n        delete_rt_msg='存在删除错误:'+result.o_return_msg;\n      }\n    });\n    \n    //Params.update是后台记录的添加的记录数组\n    Params.update?.forEach(function(row){\n      let result=Wb.sql({\n        sql: `select sql_str from app.vw_call_sp_sql_str where sp_name='APP.PR_ETL_SP_STEP_JOIN_UPDATE'`, \n        db: 'dm8' \n      });\n      result = Wb.sql({\n        sql: result.items[0].sql_str, \n        params: {\n          i_etl_sp_name: row.$etl_sp_name,\n          i_version_id: row.$version_id,\n          i_step_seq: row.$step_seq,\n          i_join_seq: row.$join_seq,\n          i_join_table: \"join_table\" in row?row.join_table:row.$join_table,\n          i_join_as: \"join_as\" in row?row.join_as:row.$join_as,\n          i_join_type: \"join_type\" in row?row.join_type:row.$join_type_k,\n          i_join_sql: \"join_sql\" in row?row.join_sql:row.$join_sql,\n          i_join_summary: \"join_summary\" in row?row.join_summary:row.$join_summary,\n          i_user_code: Wb.username\n        }, \n        db: 'dm8' \n      });\n      if (result.o_return_code!=0){\n        update_rt_code=result.o_return_code;\n        update_rt_msg='存在更新错误:'+result.o_return_msg;\n      }\n    });\n    //Params.insert是后台记录的添加的记录数组\n    Params.insert?.forEach(function(row){\n      let result=Wb.sql({\n        sql: `select sql_str from app.vw_call_sp_sql_str where sp_name='APP.PR_ETL_SP_STEP_JOIN_INSERT'`, \n        db: 'dm8' \n      });\n      result = Wb.sql({\n        sql: result.items[0].sql_str, \n        params: {\n          i_etl_sp_name: row.etl_sp_name,\n          i_version_id: row.version_id,\n          i_step_seq: row.step_seq,\n          i_join_table: row.join_table,\n          i_join_as: row.join_as,\n          i_join_type: row.join_type,\n          i_join_sql: row.join_sql,\n          i_join_summary: row.join_summary,\n          i_user_code: Wb.username\n        }, \n        db: 'dm8' \n      });\n      if (result.o_return_code!=0){\n        insert_rt_code=result.o_return_code;\n        insert_rt_msg='存在插入错误:'+result.o_return_msg;\n      }\n    });\n    Wb.send({\n      o_return_code:delete_rt_code==0&&update_rt_code==0&&insert_rt_code==0?'0':''+delete_rt_code+','+update_rt_code+','+insert_rt_code,\n      o_return_msg:delete_rt_code==0&&update_rt_code==0&&insert_rt_code==0?'执行成功':delete_rt_msg+'\\n'+update_rt_msg+'\\n'+insert_rt_msg\n    });\n  },\n  //update表格中修改的记录\n  saveColumn() {\n    //Params.update是后台记录的修改的记录数组,带$前缀的是记录原值,不带$的是修改后的值,且没有修改的话是不存在的\n    let rt_code=0;\n    let rt_msg='执行成功';\n    Params.update?.forEach(function(row){\n      let result=Wb.sql({\n        sql: `select sql_str from app.vw_call_sp_sql_str where sp_name='APP.PR_ETL_SP_STEP_INSERT_EDIT'`, \n        db: 'dm8' \n      });\n      result = Wb.sql({\n        sql: result.items[0].sql_str, \n        params: {\n          i_etl_sp_name: row.$etl_sp_name,\n          i_version_id: row.$version_id,\n          i_step_seq: row.$step_seq,\n          i_target_table: row.$target_table,\n          i_target_column: row.$target_column,\n          i_column_comments: \"column_comments\" in row?row.column_comments:row.$column_comments,\n          i_source_column: \"source_column\" in row?row.source_column:row.$source_column,\n          i_column_summary: \"column_summary\" in row?row.column_summary:row.$column_summary,\n          i_user_code: Wb.username\n        }, \n        db: 'dm8' \n      });\n      if (result.o_return_code!=0){\n        rt_code=result.o_return_code;\n        rt_msg=result.o_return_msg;\n      }\n    });\n    Wb.send({\n      o_return_code:rt_code,\n      o_return_msg:rt_msg\n    });\n  },\n  //添加程序\n  add() {\n    let result=Wb.sql({\n        sql: `select sql_str from app.vw_call_sp_sql_str where sp_name='APP.PR_ETL_SP_INSERT'`, \n        db: 'dm8' \n      });\n      result = Wb.sql({\n        sql: result.items[0].sql_str, \n        params: {\n          i_etl_sp_name: Params.i_etl_sp_name_m,\n          i_object_type: Params.i_object_type_m,\n          i_summary: Params.i_summary_m,\n          i_user_code: Wb.username\n        }, \n        db: 'dm8' \n      });\n      Wb.send({\n        o_return_code:result.o_return_code,\n        o_return_msg:result.o_return_msg\n      });\n  },\n  //添加程序参数\n  addParams() {\n    let result=Wb.sql({\n        sql: `select sql_str from app.vw_call_sp_sql_str where sp_name='APP.PR_ETL_SP_PARAMS_INSERT'`, \n        db: 'dm8' \n      });\n      result = Wb.sql({\n        sql: result.items[0].sql_str, \n        params: {\n          i_etl_sp_name: Params.i_etl_sp_name_p,\n          i_version_id: Params.i_version_id_p,\n          i_params_name: Params.i_params_name_p,\n          i_params_type: Params.i_params_type_p,\n          i_params_data_type: Params.i_params_data_type_p,\n          i_params_default_value: Params.i_params_default_value_p,\n          i_params_summary: Params.i_params_summary_p,\n          i_user_code: Wb.username\n        }, \n        db: 'dm8' \n      });\n      Wb.send({\n        o_return_code:result.o_return_code,\n        o_return_msg:result.o_return_msg\n      });\n  },\n  //添加程序步骤\n  addStep() {\n    let result=Wb.sql({\n        sql: `select sql_str from app.vw_call_sp_sql_str where sp_name='APP.PR_ETL_SP_STEP_INSERT'`, \n        db: 'dm8' \n      });\n      result = Wb.sql({\n        sql: result.items[0].sql_str, \n        params: {\n          i_etl_sp_name: Params.i_etl_sp_name,\n          i_version_id: Params.i_version_id,\n          i_step_seq: Params.i_step_seq,\n          i_step_summary: Params.i_step_summary,\n          i_step_type: Params.i_step_type,\n          i_step_sql: Params.i_step_sql,\n          i_target_table: Params.i_target_table,\n          i_user_code: Wb.username\n        }, \n        db: 'dm8' \n      });\n      Wb.send({\n        o_return_code:result.o_return_code,\n        o_return_msg:result.o_return_msg\n      });\n  },\n  //修改程序\n  edit() {\n    let result=Wb.sql({\n        sql: `select sql_str from app.vw_call_sp_sql_str where sp_name='APP.PR_ETL_SP_UPDATE'`, \n        db: 'dm8' \n      });\n      result = Wb.sql({\n        sql: result.items[0].sql_str, \n        params: {\n          i_etl_sp_name: Params.i_etl_sp_name_m,\n          i_version_id: Params.i_version_id_m,\n          i_summary: Params.i_summary_m,\n          i_upgrade_summary: Params.i_upgrade_summary_m,\n          i_user_code: Wb.username\n        }, \n        db: 'dm8' \n      });\n      Wb.send({\n        o_return_code:result.o_return_code,\n        o_return_msg:result.o_return_msg\n      }); \n  },\n //修改程序参数\n  editParams() {\n    let result=Wb.sql({\n        sql: `select sql_str from app.vw_call_sp_sql_str where sp_name='APP.PR_ETL_SP_PARAMS_UPDATE'`, \n        db: 'dm8' \n      });\n      result = Wb.sql({\n        sql: result.items[0].sql_str, \n        params: {\n          i_etl_sp_name: Params.i_etl_sp_name_p,\n          i_version_id: Params.i_version_id_p,\n          i_params_name: Params.i_params_name_p,\n          i_params_data_type: Params.i_params_data_type_p,\n          i_params_default_value: Params.i_params_default_value_p,\n          i_params_summary: Params.i_params_summary_p,\n          i_user_code: Wb.username\n        }, \n        db: 'dm8' \n      });\n      Wb.send({\n        o_return_code:result.o_return_code,\n        o_return_msg:result.o_return_msg\n      }); \n  },\n  //加载程序参数\n  loadParams() {\n    let result=Wb.sql({\n        sql: `select sql_str from app.vw_call_sp_sql_str where sp_name='APP.PR_ETL_SP_PARAMS_LOAD'`, \n        db: 'dm8' \n      });\n      result = Wb.sql({\n        sql: result.items[0].sql_str, \n        params: {\n          i_etl_sp_name: Params.i_etl_sp_name,\n          i_version_id: Params.i_version_id,\n          i_user_code: Wb.username\n        }, \n        db: 'dm8' \n      });\n      Wb.send({\n        o_return_code:result.o_return_code,\n        o_return_msg:result.o_return_msg\n      }); \n  },\n  //加载程序步骤\n  loadStep() {\n    let result=Wb.sql({\n        sql: `select sql_str from app.vw_call_sp_sql_str where sp_name='APP.PR_ETL_SP_STEP_LOAD'`, \n        db: 'dm8' \n      });\n      result = Wb.sql({\n        sql: result.items[0].sql_str, \n        params: {\n          i_etl_sp_name: Params.i_etl_sp_name,\n          i_user_code: Wb.username\n        }, \n        db: 'dm8' \n      });\n      Wb.send({\n        o_return_code:result.o_return_code,\n        o_return_msg:result.o_return_msg\n      }); \n  },\n  //修改程序步骤\n  editStep() {\n    let result=Wb.sql({\n        sql: `select sql_str from app.vw_call_sp_sql_str where sp_name='APP.PR_ETL_SP_STEP_UPDATE'`, \n        db: 'dm8' \n      });\n      result = Wb.sql({\n        sql: result.items[0].sql_str, \n        params: {\n          i_etl_sp_name: Params.i_etl_sp_name,\n          i_version_id: Params.i_version_id,\n          i_step_seq: Params.i_step_seq,\n          i_step_summary: Params.i_step_summary,\n          i_step_type: Params.i_step_type,\n          i_step_sql: Params.i_step_sql,\n          i_target_table: Params.i_target_table,\n          i_user_code: Wb.username\n        }, \n        db: 'dm8' \n      });\n      Wb.send({\n        o_return_code:result.o_return_code,\n        o_return_msg:result.o_return_msg\n      });  \n  },\n  //修改插入步骤字段映射\n  editColumn() {\n    let result=Wb.sql({\n        sql: `select sql_str from app.vw_call_sp_sql_str where sp_name='APP.PR_ETL_SP_STEP_INSERT_EDIT'`, \n        db: 'dm8' \n      });\n      result = Wb.sql({\n        sql: result.items[0].sql_str, \n        params: {\n          i_etl_sp_name: Params.i_etl_sp_name,\n          i_version_id: Params.i_version_id,\n          i_step_seq: Params.i_step_seq,\n          i_target_table: Params.i_target_table,\n          i_column_comments: Params.i_column_comments,\n          i_target_column: Params.i_target_column,\n          i_source_column: Params.i_source_column,\n          i_column_summary: Params.i_column_summary,\n          i_user_code: Wb.username\n        }, \n        db: 'dm8' \n      });\n      Wb.send({\n        o_return_code:result.o_return_code,\n        o_return_msg:result.o_return_msg\n      });  \n  },\n  //删除程序\n  del() {\n    let result=Wb.sql({\n        sql: `select sql_str from app.vw_call_sp_sql_str where sp_name='APP.PR_ETL_SP_DELETE'`, \n        db: 'dm8' \n      });\n      result = Wb.sql({\n        sql: result.items[0].sql_str, \n        params: {\n          i_etl_sp_name: Params.i_etl_sp_name,\n          i_version_id: Params.i_version_id,\n          i_user_code: Wb.username\n        }, \n        db: 'dm8' \n      });\n      Wb.send({\n        o_return_code:result.o_return_code,\n        o_return_msg:result.o_return_msg\n      });\n  },\n  //删除程序参数\n  delParams() {\n    let result=Wb.sql({\n        sql: `select sql_str from app.vw_call_sp_sql_str where sp_name='APP.PR_ETL_SP_PARAMS_DELETE'`, \n        db: 'dm8' \n      });\n      result = Wb.sql({\n        sql: result.items[0].sql_str, \n        params: {\n          i_etl_sp_name: Params.i_etl_sp_name,\n          i_version_id: Params.i_version_id,\n          i_params_name: Params.i_params_name,\n          i_user_code: Wb.username\n        }, \n        db: 'dm8' \n      });\n      Wb.send({\n        o_return_code:result.o_return_code,\n        o_return_msg:result.o_return_msg\n      }); \n  },\n  //删除程序步骤\n  delStep() {\n    let result=Wb.sql({\n        sql: `select sql_str from app.vw_call_sp_sql_str where sp_name='APP.PR_ETL_SP_STEP_DELETE'`, \n        db: 'dm8' \n      });\n      result = Wb.sql({\n        sql: result.items[0].sql_str, \n        params: {\n          i_etl_sp_name: Params.i_etl_sp_name,\n          i_version_id: Params.i_version_id,\n          i_step_seq: Params.i_step_seq,\n          i_user_code: Wb.username\n        }, \n        db: 'dm8' \n      });\n      Wb.send({\n        o_return_code:result.o_return_code,\n        o_return_msg:result.o_return_msg\n      }); \n  },\n  //升级程序\n  upgrade() {\n    let result=Wb.sql({\n        sql: `select sql_str from app.vw_call_sp_sql_str where sp_name='APP.PR_ETL_SP_UPGRADE'`, \n        db: 'dm8' \n      });\n      result = Wb.sql({\n        sql: result.items[0].sql_str, \n        params: {\n          i_etl_sp_name: Params.i_etl_sp_name_m,\n          i_upgrade_summary: Params.i_upgrade_summary_m,\n          i_user_code: Wb.username\n        }, \n        db: 'dm8' \n      });\n      Wb.send({\n        o_return_code:result.o_return_code,\n        o_return_msg:result.o_return_msg\n      }); \n  },\n  //发布程序\n  release() {\n    let result=Wb.sql({\n        sql: `select sql_str from app.vw_call_sp_sql_str where sp_name='APP.PR_ETL_SP_RELEASE'`, \n        db: 'dm8' \n      });\n      result = Wb.sql({\n        sql: result.items[0].sql_str, \n        params: {\n          i_etl_sp_name: Params.i_etl_sp_name_m,\n          i_version_id: Params.i_version_id_m,\n          i_user_code: Wb.username\n        }, \n        db: 'dm8' \n      });\n      Wb.send({\n        o_return_code:result.o_return_code,\n        o_return_msg:result.o_return_msg\n      }); \n  },\n  //编译程序\n  compile() {\n    let result=Wb.sql({\n        sql: `select sql_str from app.vw_call_sp_sql_str where sp_name='APP.PR_ETL_SP_COMPILE'`, \n        db: 'dm8' \n      });\n      result = Wb.sql({\n        sql: result.items[0].sql_str, \n        params: {\n          i_etl_sp_name: Params.i_etl_sp_name_m,\n          i_