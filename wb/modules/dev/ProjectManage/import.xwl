{"title":"","icon":"","img":"","tags":"","hideInMenu":"true","text":"module","cls":"Wb.Module","properties":{"cid":"module","remark":"Import data to table","serverScript":"function main() {\n  if (Params.if_delete=='1'){\n    Wb.sql({\n      sql: `delete from `+Params.tableName, \n      db: 'dm8' \n    })\n  }\n  \n  const Util = Wb.load('./util.mjs');\n  switch (Wb.getFileExt(Params.file.name)) {\n    case 'wbt':\n      Util.importWbTable();\n      break;\n    case 'xls':\n    case 'xlsx':\n      Util.importExcel();\n      break;\n    case 'txt':\n    case 'csv':\n      Util.importText();\n      break;\n  }\n}\nmain();"},"_icon":"module"}