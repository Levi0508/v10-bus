{"title":"","icon":"","img":"","tags":"","hideInMenu":"true","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"let actions = {\n  //查询转换记录\n  selectTableETL() {\n    let result=Wb.sql({\n      sql: `select sql_str from app.vw_call_sp_sql_str where sp_name='APP.PR_TABLE_ETL_Q'`, \n      db: 'dm8' \n    });\n    result = Wb.sql({\n      sql: result.items[0].sql_str, \n      params: {\n        i_begin_date: Params.i_begin_date,\n        i_end_date: Params.i_end_date,\n        i_data_source: Params.i_data_source,\n        i_target_table: Params.i_target_table,\n        i_etl_status: Params.i_etl_status,\n        i_exec_date: Params.i_exec_date,\n      }, \n      db: 'dm8' \n    })\n    if (result.o_return_code==0){\n      Wb.send(result.rt_cursor);\n    }else{\n      Wb.send({\n        o_return_code:result.o_return_code,\n        o_return_msg:result.o_return_msg\n      });\n    }\n  },\n  //查询转换表\n  selectETLTable() {\n    Wb.sendRows({\n      sql:`select target_table,data_source,remark,exec_seq,exec_sql,etl_no,enable_flag,etl_sp_name,if_required\n           from   app.tb_data_etl_table a\n           where  data_source={?i_data_source?}\n           and    (instr(upper(a.target_table) , upper({?query?}))>0 or {?query?} is null) \n           and    (a.target_table={?i_etl_table?} or {?i_etl_table?} is null)\n           order by data_source,exec_seq`,\n      params: {\n        i_data_source:Params.i_data_source,\n        i_etl_table:Params.i_etl_table_T,\n        query:Params.query,\n      },\n      db:'dm8'\n    });\n  },\n  save() {\n    Params.del?.forEach(function(row){\n      Wb.sql({\n        sql: `delete from app.tb_data_etl_table a where a.data_source={?i_data_source?} and a.etl_no={?i_etl_no?}\n                 and not exists(select 1 from app.tb_data_etl_log b where a.data_source=b.data_source and a.etl_no=b.etl_no)` ,\n        params: {\n          i_data_source: row.$data_source,\n          i_etl_no: row.$etl_no,\n        }, \n        db: 'dm8' \n      });\n      Wb.sql({\n        sql: `update app.tb_data_etl_table a \n              set    a.enable_flag='0'\n              where  a.data_source={?i_data_source?} and a.etl_no={?i_etl_no?}` ,\n        params: {\n          i_data_source: row.$data_source,\n          i_etl_no: row.$etl_no,\n        }, \n        db: 'dm8' \n      });\n    });\n    Params.update?.forEach(function(row){\n      Wb.sql({\n        sql: `update app.tb_data_etl_table a `+\n             `set a.target_table={?i_target_table?},a.remark={?i_remark?},a.exec_sql={?i_exec_sql?},a.enable_flag={?i_enable_flag?},a.if_required={?i_if_required?},a.etl_sp_name={?i_etl_sp_name?}   `+\n             `where a.data_source={?i_data_source?} and a.etl_no={?i_etl_no?}` ,\n        params: {\n          i_data_source: row.$data_source,\n          i_etl_no: row.$etl_no,\n          i_target_table: \"target_table\" in row?row.target_table:row.$target_table,\n          i_remark: \"remark\" in row?row.remark:row.$remark,\n          i_exec_sql: \"exec_sql\" in row?row.exec_sql:row.$exec_sql,\n          i_enable_flag: \"enable_flag\" in row?row.enable_flag:row.$enable_flag,\n          i_if_required: \"if_required\" in row?row.if_required:row.$if_required,\n          i_etl_sp_name: \"etl_sp_name\" in row?row.etl_sp_name:row.$etl_sp_name,\n        }, \n        db: 'dm8' \n      });\n    });\n  \n    Params.insert?.forEach(function(row){\n      Wb.sql({\n        sql: `insert into app.tb_data_etl_table(data_source,target_table,remark,exec_seq,exec_sql,etl_no,enable_flag,if_required,etl_sp_name) \n              select {?i_data_source?},\n                     {?i_target_table?},\n                     {?i_remark?},\n                     (select nvl(max(exec_seq),0)+1 from app.tb_data_etl_table where data_source={?i_data_source?}),\n                     {?i_exec_sql?},\n                     (select lpad(to_char(to_number(nvl(max(etl_no),0))+1),3,'0') from app.tb_data_etl_table where data_source={?i_data_source?}),\n                     {?i_enable_flag?},\n                     {?i_if_required?},\n                     {?i_etl_sp_name?}\n              from dual`, \n        params: {\n          i_data_source: \"data_source\" in row?row.data_source:row.$data_source,\n          i_target_table: \"target_table\" in row?row.target_table:row.$target_table,\n          i_remark: \"remark\" in row?row.remark:row.$remark,\n          i_exec_sql: \"exec_sql\" in row?row.exec_sql:row.$exec_sql,\n          i_enable_flag: \"enable_flag\" in row?row.enable_flag:row.$enable_flag,\n          i_if_required: \"if_required\" in row?row.if_required:row.$if_required,\n          i_etl_sp_name: \"etl_sp_name\" in row?row.etl_sp_name:row.$etl_sp_name,\n        }, \n        db: 'dm8' \n      });\n    });\n\n  },\n  updateExecSeq() {\n    Wb.sql({\n      sql: `update app.tb_data_etl_table a\n            set a.exec_seq={?i_exec_seq?}\n            where a.data_source={?i_data_source?} and a.etl_no={?i_etl_no?}`,\n      params: {\n        i_exec_seq: Params.i_exec_seq,\n        i_data_source: Params.i_data_source,\n        i_etl_no: Params.i_etl_no,\n      }, \n      db: 'dm8' \n    });\n  },\n  //重新执行转换\n  redoETL() {\n    let result=Wb.sql({\n      sql: `select sql_str from app.vw_call_sp_sql_str where sp_name='APP.PR_DATA_ETL'`, \n      db: 'dm8' \n    });\n    result = Wb.sql({\n      sql: result.items[0].sql_str, \n      params: {\n        i_busi_date: Params.i_busi_date,\n        i_data_source: Params.i_data_source,\n        i_target_table: Params.i_target_table,\n      }, \n      db: 'dm8' \n    });\n    Wb.send({\n      o_return_code:result.o_return_code,\n      o_return_msg:result.o_return_msg\n    });\n  },\n  \n  \n};\nactions[Params.xaction]();"},"_icon":"module"}