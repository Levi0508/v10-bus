{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","remark":"Add dictionary item","serverScript":"function main() {\n  const Util = Wb.load('./util.mjs');\n  let rec = { sid: Wb.getId() };\n\n  Util.checkDuplicate(Params.name, Params.group_name);\n  Wb.set(rec);\n  Wb.sync({ tableName: 'wb_dict', insert: Params });\n  Util.updateBuffer();\n  Wb.send(rec);\n}\nmain();"},"_icon":"module"}