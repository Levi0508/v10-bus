{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","remark":"Delete dictionary items","serverScript":"function main() {\n  const Util = Wb.load('./util.mjs');\n  let del = Wb.getObject('del'), rows = Wb.getAllRows('select name,alias,group_name from wb_dict where ' +\n    Wb.Query.make('sid', del.pluck('$sid')));\n\n  Wb.sync({ tableName: 'wb_dict', del });\n  Util.clearBuffer(rows);\n}\nmain();"},"_icon":"module"}