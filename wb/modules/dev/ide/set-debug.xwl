{"text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"Wb.checkDemo();\nfunction main() {\n  let files = Wb.getObject('files'),\n    type = Params.type, userid = Wb.userid,\n    types = Wb.has('types') ? Wb.getObject('types') : null;\n\n  files.forEach((file, index) => {\n    switch (types ? types[index] : type) {\n      case 'add':\n        DebugFiles.addDebugFile(userid, file);\n        break;\n      case 'remove':\n        DebugFiles.removeDebugFile(userid, file);\n        break;\n      case 'disable':\n        DebugFiles.setDebugStatus(userid, file, 0);\n        break;\n      case 'enable':\n        DebugFiles.setDebugStatus(userid, file, 1);\n        break;\n      case 'terminate':\n        DebugFiles.terminate(userid, file, true);\n        break;\n      case 'resume':\n        DebugFiles.terminate(userid, file, false);\n        break;\n    }\n  });\n}\nmain();","remark":"Set module debug status"},"_icon":"module","title":""}