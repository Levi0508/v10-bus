{"title":"@versionMng","icon":"form","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","remark":"File version management"},"_icon":"module","_expanded":true,"events":{"initialize":"Wb.apply(app,{checkOut(){let e=app.grid1.selections;if(!e.length){Wb.tipSelect();return}Wb.confirm(Wb.getActionHint(e,\"file_path\",Str.checkOut),(t=>{Wb.ajax({url:xpath+\"/check-out\",params:{ids:e.map((e=>e.data.sid))},success(){Wb.tipDone(Str.checkOut)}})})).showBy(app.checkOutBtn,\"br\")},load(){app.grid1.delayLoad({comps:app.viewport1.tbar})}});Wb.make(app,{cname:\"window\",layout:\"grid1\",dialog:true,icon:\"undo\",title:Str.back,cid:\"backWin\",events:{ok(e){let t=app.versionSelect.value;Wb.confirm(Str.actionConfirm.format(Str.back,t),(e=>{Wb.ajax({url:xpath+\"/rollback\",params:{version:t},success(){app.backWin.close()}})}))}},items:[{cname:\"select\",editable:false,text:Str.version,url:xpath+\"/select-version\",required:true,cid:\"versionSelect\"}]});Wb.make(app,{cname:\"viewport\",layout:\"fit\",cid:\"viewport1\",tbar:{cname:\"toolbar\",items:[{keys:\"Ctrl+E\",icon:\"logout\",text:Str.checkOut,cid:\"checkOutBtn\",events:{click(e,t){app.checkOut()}}},{icon:\"undo\",text:Str.back,cid:\"backBtn\",events:{click(e,t){app.backWin.show()}}},{cname:\"divider\",cid:\"divider1\"},{keys:\"Ctrl+D\",icon:\"delete\",text:Str.del,cid:\"delBtn\",events:{click(e,t){app.grid1.removeRecords(xpath+\"/del\",\"file_path\")}}},{cname:\"divider\",cid:\"divider2\"},{cname:\"select\",clearButton:true,editable:false,width:\"8em\",placeholder:Str.version,url:xpath+\"/select-version\",cid:\"searchVersion\",events:{select(e,t,c,a){app.load()},clearclick(e){app.load()}}},{cname:\"text\",clearButton:true,flex:1,minWidth:\"5em\",placeholder:Str.search,cid:\"searchFile\",maxWidth:\"20em\",events:{change(e,t,c){app.load()}}}]},items:[{cname:\"grid\",columnsSortable:true,keyFields:\"sid\",sorters:{name:\"sdate\",desc:true},url:xpath+\"/select\",cid:\"grid1\",multiSelect:true}]});"}}