{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","remark":"Check out files","serverScript":"Wb.checkDemo();\nfunction main() {\n  let sqlMap = Wb.Query.getArraySql(Wb.getObject('ids'), 'varchar');\n\n  Wb.sql({\n    sql: 'select file_path,file_content from wb_version where sid in (' + sqlMap.sql + ')',\n    params: sqlMap.params,\n    blob: true,\n    fn(row) {\n      new Wb.File(true, row.file_path).stream = row.file_content;\n    }\n  });\n}\nmain();"},"_icon":"module"}