{"title":"Leave Application","icon":"paper-plane","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module"},"_icon":"module","_expanded":true,"events":{"initialize":"Wb.make(app,{cname:\"window\",layout:\"grid1\",resetDialog:true,icon:\"paper-plane\",title:\"Leave application\",autoScroll:true,cid:\"window1\",items:[{cname:\"text\",text:\"Title\",required:true,cid:\"title\"},{cname:\"date\",text:\"Begin Date\",required:true,cid:\"begin_date\"},{cname:\"date\",text:\"End Date\",required:true,cid:\"end_date\"},{cname:\"number\",minValue:0,text:\"Leave days\",decimalCount:0,required:true,maxLength:5,cid:\"leave_days\"},{cname:\"text\",text:\"Reason\",required:true,cid:\"leave_reason\"}]});Wb.make(app,{cname:\"viewport\",layout:\"fit\",cid:\"viewport1\",tbar:{cname:\"toolbar\",items:[{keys:\"Ctrl+E\",icon:\"add\",text:Str.add,cid:\"addBtn\",events:{click(e,t){app.grid1.insertRecord(xpath+\"/add\",app.window1)}}},{keys:\"Ctrl+J\",icon:\"edit\",text:Str.edit,cid:\"editBtn\",events:{click(e,t){app.grid1.editRecord(xpath+\"/edit\",app.window1)}}},{keys:\"Ctrl+D\",icon:\"delete\",text:Str.del,cid:\"delBtn\",events:{click(e,t){app.grid1.removeRecords(xpath+\"/del\",\"title\")}}}]},bbar:{cname:\"displayField\",padding:true,icon:\"info1\",value:\"This module demonstrates workflow and multi-tables CRUD\"},items:[{cname:\"grid\",columnsSortable:true,sorters:{name:\"begin_date\",desc:true},url:xpath+\"/select\",cid:\"grid1\",columns:[{cname:\"column\",rowNum:true,cid:\"rowCol\"},{cname:\"column\",fieldName:\"begin_date\",text:\"Begin Date\",type:\"dateText\",cid:\"beginDateCol\"},{cname:\"column\",fieldName:\"end_date\",text:\"End Date\",type:\"dateText\",cid:\"endDateCol\"},{cname:\"column\",fieldName:\"title\",width:\"15em\",text:\"Title\",cid:\"titleCol\"},{cname:\"column\",fieldName:\"leave_days\",text:\"Leave Days\",cid:\"leaveDaysCol\"},{cname:\"column\",fieldName:\"node_text\",text:\"Approval Node\",cid:\"approvalNodeCol\"},{cna