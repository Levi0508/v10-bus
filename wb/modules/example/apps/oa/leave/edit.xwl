{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"function main() {\n  const Util = Wb.load('./util.mjs');\n  let flowId = Params.$flow_id, title;\n\n  Params.flowId = flowId;\n  Wb.startTrans();\n  Util.checkProcess();\n  title = Params.title;\n  if (title)\n    Wb.sync({ tableName: 'wb_flow', update: { $sid: flowId, title } });\n  Wb.sync({ tableName: 'wb_leave', update: Params });\n}\nmain();"},"_icon":"module"}