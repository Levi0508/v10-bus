{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"function main() {\n  let sql;\n\n  sql = 'select a.*,b.title,b.node_text from wb_leave a, wb_flow b where a.flow_id=b.sid and a.user_id={?sys.userid?}';\n  sql += Wb.getOrderSql({ title: 'b.title', node_text: 'b.node_text' });\n  Wb.sendRowx(sql);\n}\nmain();"},"_icon":"module"}