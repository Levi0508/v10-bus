{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"function main() {\n  let row = Wb.getRow({\n    sql: 'select photo from wb_staff where sid={?sid?}',\n    blob: true\n  });\n  if (row?.photo)\n    Wb.exportData(row.photo);\n  else\n    Wb.exportData(new Wb.File(true, 'wb/images/null.png').stream);\n}\nmain();"},"_icon":"module"}