{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module"},"_icon":"module","_expanded":true,"events":{"initialize":"Wb.make(app,{cname:\"card\",layout:\"grid1\",instanced:false,cid:\"cardTpl\",items:[{cname:\"text\",text:\"Text\",cid:\"text1\"},{cname:\"number\",text:\"Number\",cid:\"number1\"}]});Wb.make(app,{cname:\"tab\",cid:\"tab1\",full:true,tbar:{cname:\"toolbar\",items:[{icon:\"card\",text:\"Add New Card\",cid:\"addNewCardItem\",events:{click(a,e){let d=app.cardTpl;d.cid=Wb.getId();app.cardIndex??=0;app.cardIndex++;d.title=\"Card \"+app.cardIndex;d=app.tab1.add(app.cardTpl);d.down(\"text1\").value=\"text \"+app.cardIndex;d.show()}}}]}});"}}