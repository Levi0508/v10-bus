{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module"},"_icon":"module","_expanded":true,"events":{"initialize":"Wb.make(app,{cname:\"viewport\",layout:\"grid1\",cid:\"viewport1\",tbar:{cname:\"toolbar\",border:\"bottom\",items:[{keys:\"Ctrl+E\",icon:\"add\",text:Str.add,cid:\"addBtn\"},{keys:\"Ctrl+J\",icon:\"edit\",text:Str.edit,cid:\"editBtn\"},{keys:\"Ctrl+D\",icon:\"delete\",text:Str.del,cid:\"delBtn\"}]},items:[{cname:\"label\",text:\"Employee onboarding\",cls:\"w-title3\",cid:\"titleLabel\"},{cname:\"title\",title:\"Basic information\",cid:\"basicInfoTitle\"},{cname:\"text\",text:\"Name\",required:true,cid:\"name\"},{cname:\"select\",keyName:\"gender\",text:\"Gender\",required:true,cid:\"gender\"},{cname:\"date\",text:\"Birthdate\",required:true,cid:\"birthdate\"},{cname:\"title\",title:\"Education\",cid:\"eduInfoTitle\"},{cname:\"text\",text:\"Degree\",cid:\"degree\"},{cname:\"text\",text:\"University\",cid:\"university\"},{cname:\"text\",text:\"Major\",cid:\"major\"},{cname:\"title\",title:\"Department\",cid:\"deptTitle\"},{cname:\"text\",text:\"Department\",cid:\"department\"},{cname:\"text\",text:\"Duty\",cid:\"duty\"},{cname:\"text\",text:\"Probation period\",cid:\"period\"},{cname:\"date\",text:\"Entry Date\",cid:\"entryDate\"},{cname:\"text\",text:\"Project\",cid:\"project\"},{cname:\"number\",minValue:1e3,prefix:\"$\",text:\"Salary\",cid:\"salary\"},{cname:\"text\",text:\"Address\",cid:\"address\"},{cname:\"title\",title:\"Comments\",cid:\"commentTitle\"},{cname:\"textArea\",text:\"Office\",cid:\"office\",height:\"5em\"},{cname:\"textArea\",text:\"Manager\",cid:\"manager\",height:\"5em\"},{cname:\"textArea\",text:\"CEO\",cid:\"ceo\",height:\"5em\"},{cname:\"button\",icon:\"save\",text:\"Save Form\",type:\"primary\",cid:\"saveBtn\",events:{click(e,t){if(Wb.verify(app.viewport1)){Wb.ajax({url:xpath,comps:app.viewport1,success(){Wb.tipDone()}})}}}}]});"}}