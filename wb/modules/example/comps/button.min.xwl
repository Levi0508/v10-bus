{"title":"","icon":"button","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module"},"_icon":"module","_expanded":true,"events":{"initialize":"Wb.make(app,{cname:\"viewport\",layout:\"grid1\",cid:\"viewport1\",items:[{cname:\"label\",text:\"Button\",cls:\"w-title3\",cid:\"mainLabel\"},{cname:\"displayField\",htmlValue:true,icon:\"info\",value:'For a better learning experience, please review the examples in the <a href=\"ide?openExample=1\"   target=\"_blank\">WebBuilder IDE</a>',cid:\"useIdeTipField\"},{cname:\"title\",title:\"Button list\",cid:\"listTitle\"},{cname:\"container\",layout:\"form\",cid:\"listCt\",frame:true,items:[{cname:\"button\",text:\"Common Button\",cid:\"commonBtn\",events:{click(t,e){Wb.tip(this.cid+\" clicked\")}}},{cname:\"button\",icon:\"gear\",text:\"Icon Button\",cid:\"iconBtn\"},{cname:\"button\",img:\"cut\",text:\"Image Button\",cid:\"imgBtn\"},{cname:\"button\",icon:\"🌻\",tip:\"Any char as icon\",text:\"Char Icon\",cid:\"charIconBtn\"},{cname:\"button\",icon:\"bell\",tip:\"Badge text\",text:\"58\",badgeText:true,cid:\"badgeBtn\"},{cname:\"button\",icon:\"left4\",iconAlign:\"left\",text:\"Left\",cid:\"leftBtn\"},{cname:\"button\",icon:\"right4\",iconAlign:\"right\",text:\"Right\",cid:\"rightBtn\"},{cname:\"button\",icon:\"up4\",iconAlign:\"top\",text:\"Top\",cid:\"topBtn\"},{cname:\"button\",icon:\"down4\",iconAlign:\"bottom\",text:\"Bottom\",cid:\"bottomBtn\"},{cname:\"button\",keys:\"Ctrl+Shift+K\",icon:\"keyboard\",tip:\"Press Ctrl+Shift+K to fire click event\",text:\"Ctrl+Shift+K\",cid:\"keyBtn\",keysTextTip:false,events:{click(t,e){Wb.tip(this.cid+\" clicked\")}}},{cname:\"button\",icon:\"flower\",tabIndex:undefined,focusable:false,text:\"No Focus\",cid:\"noFocusBtn\"},{cname:\"button\",icon:\"menu\",text:\"menu\",cid:\"menuBtn\",menu:{cname:\"menu\",items:[{icon:\"calendar\",text:\"item 1\",cid:\"item1\"},{text:\"item 2\",cid:\"item2\"},{text:\"item 3\",cid:\"item3\"}]}},{cname:\"splitButton\",text:\"Split Button\",cid:\"splitButton1\",menu:{cname:\"menu\",items:[{icon:\"calendar\",text:\"item 1\",cid:\"item1\"},{text:\"item 2\",cid:\"item2\"},{text:\"item 3\",cid:\"item3\"}]},events:{click(t,e){Wb.tip(this.cid+\" clicked\")}}},{cname:\"button\",tapClick:true,text:\"MouseDown Click\",cid:\"tapBtn\",events:{click(t,e){Wb.tip(this.cid+\" clicked\")}}},{cname:\"button\",repeatInterval:true,text:\"Repeat Click\",cid:\"repeatBtn\",events:{click(t,e){app.repeatCt??=0;Wb.toast(this.cid+\" clicked \"+app.repeatCt++)}}},{cname:\"button\",icon:\"delete\",disabled:true,text:\"Disabled\",cid:\"button1\"}]},{cname:\"title\",title:\"Button style\",cid:\"styleTitle\"},{cname:\"label\",text:'Set the \"type\" property to set the button style',cid:\"styleLabel\"},{cname:\"container\",layout:\"form\",cid:\"styleCt\",frame:true,items:[{cname:\"button\",icon:\"address-book\",text:\"Primary\",type:\"primary\",cid:\"primary\"},{cname:\"button\",icon:\"delete\",tip:\"Plain Button\",type:\"plain\",cid:\"plain\"},{cname:\"button\",icon:\"cut\",tip:\"Text Tool Button\",text:\"cut\",type:\"tool\",cid:\"tool1\"},{icon:\"cut\",cname:\"tool\",tip:\"Text Tool Button no focus\",text:\"cut\",cid:\"noFocusTool1\"},{cname:\"button\",icon:\"add1\",tip:\"Tool Button\",type:\"tool\",cid:\"tool2\"},{icon:\"add1\",cname:\"tool\",tip:\"Tool Button no focus\",cid:\"noFocusTool2\"},{icon:\"database\",cname:\"iconButton\",tip:\"Icon Button no focus\",cid:\"icon\"},{icon:\"cube\",cname:\"lightButton\",tip:\"Light Button no focus\",cid:\"light\"}]},{cname:\"title\",title:\"Button shape\",cid:\"shapeTitle\"},{cname:\"label\",text:'Set the \"shape\" property to set the button shape',cid:\"shapeLabel\"},{cname:\"container\",layout:\"form\",cid:\"shapeCt\",frame:true,items:[{cname:\"button\",shape:\"circle\",icon:\"gear\",tip:\"Circle\",cid:\"circleBtn\"},{cname:\"button\",shape:\"rect\",icon:\"gear\",text:\"Rect\",cid:\"rectBtn\"},{cname:\"button\",shape:\"round\",icon:\"gear\",text:\"Round\",cid:\"roundBtn\"}]},{cname:\"title\",title:\"Grouping and toggle button\",cid:\"groupTitle\"},{cname:\"label\",text:'Set the \"groupName\" property for grouping and set the \"active\" property for toggle',cid:\"groupLabel\"},{cname:\"container\",layout:\"form\",cid:\"groupCt\",frame:true,events:{buttontoggle(t,e,n){Wb.tip(t.cid+\" is \"+e)}},items:[{cname:\"button\",groupName:\"group1\",active:false,text:\"Button 1\",cid:\"button1\"},{cname:\"button\",groupName:\"group1\",active:false,text:\"Button 2\",cid:\"button2\"},{cname:\"button\",groupName:\"group1\",active:false,text:\"Button 3\",cid:\"button3\"},{cname:\"divider\",cid:\"divider1\"},{cname:\"button\",groupName:\"group2\",active:false,text:\"Button 4\",cid:\"button4\"},{cname:\"button\",groupName:\"group2\",active:true,text:\"Button 5\",cid:\"button5\"},{cname:\"button\",groupName:\"group2\",active:false,text:\"Button 6\",cid:\"button6\"},{cname:\"space\",cid:\"space1\"},{cname:\"button\",active:false,text:\"Toggle\",cid:\"button7\"},{cname:\"space\",cid:\"space2\"},{cname:\"button\",activeBgColor:false,active:true,text:\"No Background\",cid:\"button8\"}]},{cname:\"title\",title:\"Button size\",cid:\"sizeTitle\"},{cname:\"label\",text:'Set \"fontSize\" property to set whole button size, and set \"iconSize\" property to set icon size only.',cid:\"sizeLabel\"},{cname:\"container\",layout:\"form\",cid:\"sizeCt\",frame:true,items:[{cname:\"button\",icon:\"gift\",fontSize:\".8em\",text:\"Button 1\",cid:\"button1\"},{cname:\"button\",icon:\"gift\",fontSize:\"1.5em\",text:\"Button 2\",cid:\"button2\"},{cname:\"button\",icon:\"gift\",iconSize:\"2em\",iconAlign:\"top\",text:\"Big icon only\",cid:\"button3\"},{cname:\"button\",icon:\"gift\",iconSize:\"2.5em\",iconAlign:\"top\",text:\"Big icon only\",cid:\"button4\"}]},{cname:\"title\",title:\"Button layout\",cid:\"layoutTitle\"},{cname:\"label\",text:'Set the \"Layout\" property to arrange buttons.',cid:\"layoutLabel\"},{cname:\"container\",layout:\"row\",cid:\"layoutCt\",frame:true,items:[{icon:\"setup\",cname:\"tool\",iconAlign:\"top\",iconSize:\"2.8em\",text:\"Setup\",cid:\"setupItem\"},{cname:\"divider\",cid:\"divider1\"},{cname:\"container\",layout:\"row\",cid:\"container1\",items:[{icon:\"paste\",cname:\"tool\",iconAlign:\"top\",iconSize:\"2.8em\",text:\"Paste\",cid:\"pasteItem\"},{cname:\"container\",layout:\"column\",align:\"start\",cid:\"container1\",items:[{icon:\"cut\",cname:\"tool\",text:\"Cut\",cid:\"cutItem\"},{icon:\"copy\",cname:\"tool\",text:\"Copy\",cid:\"copyItem\"},{icon:\"delete\",cname:\"tool\",text:\"Delete\",cid:\"deleteItem\"}]}]},{cname:\"divider\",cid:\"divider2\"},{cname:\"container\",layout:\"column\",align:\"center\",cid:\"container2\",items:[{icon:\"add\",cname:\"tool\",text:\"Add\",cid:\"addItem\"},{icon:\"edit\",cname:\"tool\",text:\"Edit\",cid:\"editItem\"},{cname:\"container\",layout:\"row\",cid:\"container1\",items:[{shape:\"circle\",icon:\"up4\",cname:\"tool\",cid:\"upItem\"},{shape:\"circle\",icon:\"right4\",cname:\"tool\",cid:\"rightItem\"},{shape:\"circle\",icon:\"down4\",cname:\"tool\",cid:\"downItem\"},{shape:\"circle\",icon:\"left4\",cname:\"tool\",cid:\"leftItem\"}]}]},{cname:\"splitButton\",icon:\"gear\",iconSize:\"2.8em\",cid:\"setItem\",menu:{cname:\"menu\",items:[{text:\"Item 1\",cid:\"item1\"},{text:\"Item 2\",cid:\"item2\"},{text:\"Item 3\",cid:\"item3\"}]}}]},{cname:\"title\",title:\"Events\",cid:\"eventTitle\"},{cname:\"container\",layout:\"form\",cid:\"eventCt\",frame:true,items:[{cname:\"button\",text:\"Click\",cid:\"button1\",events:{click(t,e){Wb.tip(\"click\")}}},{cname:\"button\",active:true,text:\"Toggle\",cid:\"button2\",events:{activate(t){Wb.tip(\"activate\")},toggle(t,e){Wb.tip(\"toggle: \"+t)},deactivate(t){Wb.tip(\"deactivate\")}}}]},{cname:\"title\",title:\"Coding\",cid:\"codingTitle\"},{cname:\"container\",layout:\"grid1\",cid:\"codingCt\",frame:true,items:[{cname:\"container\",layout:\"form-compact\",cid:\"demoCt\",items:[{cname:\"button\",text:\"Demo Button\",cid:\"demoButton\"}]},{cname:\"line\",dashed:true,dimTitle:true,title:\"Demonstrate\",cid:\"line1\"},{cname:\"container\",layout:\"form-compact\",cid:\"actionCt\",items:[{cname:\"button\",text:\"Add Button\",cid:\"addBtn\",events:{click(t,e){app.demoCt.add({cname:\"button\",icon:\"gear\",text:\"New Button\"})}}},{cname:\"button\",text:\"Set Text Icon\",cid:\"setTextIconBtn\",events:{click(t,e){let n=app.demoButton;if(n){n.text=\"Changed Text\";n.icon=\"earth\"}}}},{cname:\"button\",text:\"Set Disabled\",cid:\"disableBtn\",events:{click(t,e){app.demoButton?.setter(\"disabled\",true)}}},{cname:\"button\",text:\"Destroy\",cid:\"destroyBtn\",events:{click(t,e){app.demoButton?.destroy()}}},{cname:\"button\",text:\"Add Event\",cid:\"addEventBtn\",events:{click(t,e){app.demoBtnOnClick??=t=>Wb.tip(\"clicked\");app.demoButton?.on(\"click\",app.demoBtnOnClick);Wb.tip(\"Please click Demo Button\")}}},{cname:\"button\",text:\"Remove Event\",cid:\"removeEventBtn\",events:{click(t,e){app.demoButton?.un(\"click\",app.demoBtnOnClick);Wb.tip(\"Please click Demo Button (Event removed)\")}}},{cname:\"button\",text:\"Add Listener\",cid:\"addListenerBtn\",events:{click(t,e){app.demoBtnOnMouseEnter??=t=>Wb.tip(\"entered\");app.demoButton?.mon(\"mouseenter\",app.demoBtnOnMouseEnter);Wb.tip(\"Please move mouse to Demo Button\")}}},{cname:\"button\",text:\"Remove Listener\",cid:\"removeListenerBtn\",events:{click(t,e){app.demoButton?.mun(\"mouseenter\",app.demoBtnOnMouseEnter);Wb.tip(\"Please move mouse to Demo Button (Listener removed)\")}}}]}]}]});app.useIdeTipField.highlight();"}}