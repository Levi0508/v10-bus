{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"function main() {\n  Wb.send({\n    xAxis: {\n      type: 'category',\n      data: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun']\n    },\n    yAxis: {\n      type: 'value'\n    },\n    series: [\n      {\n        data: [120, 200, 150, 80, 70, 110, 130],\n        type: 'line',\n        symbol: 'triangle',\n        symbolSize: 20,\n        lineStyle: {\n          color: '#5470C6',\n          width: 4,\n          type: 'dashed'\n        },\n        itemStyle: {\n          borderWidth: 3,\n          borderColor: '#EE6666',\n          color: 'yellow'\n        }\n      }\n    ]\n  });\n}\nmain();"},"_icon":"module"}