{"title":"","icon":"check6","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module"},"_icon":"module","_expanded":true,"events":{"initialize":"Wb.make(app,{cname:\"viewport\",layout:\"grid1\",cid:\"viewport1\",items:[{cname:\"label\",text:\"Check, radio, toggle and slider\",cls:\"w-title3\",cid:\"mainLabel\"},{cname:\"title\",title:\"Check\",cid:\"checkTitle\"},{cname:\"container\",layout:\"grid1\",cid:\"checkCt\",frame:true,items:[{cname:\"check\",text:\"Common check\",cid:\"commonCheck\",events:{change(e,t,a){Wb.tip(this.cid+\" value is \"+e)}}},{cname:\"check\",text:\"With label\",label:\"Label check\",value:true,cid:\"labelCheck\"},{cname:\"check\",label:\"Only label check\",cid:\"onlyLabelCheck\"},{cname:\"check\",showEmptyLabel:true,label:\"Only label check with empty text\",cid:\"onlyLabelEmptyTextCheck\"},{cname:\"controlCt\",gap:\"1em\",showEmptyLabel:true,cid:\"intValueCt\",items:[{cname:\"check\",label:\"return int value\",returnType:\"int\",cid:\"intValueCheck\"},{cname:\"button\",text:\"Get value\",cid:\"getValueBtn\",events:{click(e,t){Wb.tip(\"The value is \"+this.previousSibling.value)}}}]}]},{cname:\"title\",title:\"CheckGroup\",cid:\"checkGroupTitle\"},{cname:\"container\",layout:\"grid1\",cid:\"checkGroupCt\",frame:true,items:[{cname:\"label\",text:\"Common checkGroup\",cid:\"commonCheckGroupLabel\"},{cname:\"container\",layout:\"row\",gap:\"1em\",cid:\"commonCheckCt\",items:[{cname:\"checkGroup\",cid:\"commonCheckGroup\",items:[{cname:\"check\",label:\"item 1\",cid:\"check1\"},{cname:\"check\",label:\"item 2\",value:true,cid:\"check2\"},{cname:\"check\",label:\"item 3\",value:true,cid:\"check3\"}]},{cname:\"button\",text:\"Get value\",cid:\"getValueBtn\",events:{click(e,t){Wb.tip(Wb.encode(app.commonCheckGroup.value))}}},{cname:\"button\",text:\"Set value\",cid:\"setValueBtn\",events:{click(e,t){app.commonCheckGroup.setValue({check1:true,check3:true})}}}]},{cname:\"label\",text:\"Return all and return array value checkGroup\",cid:\"allCheckGroupLabel\"},{cname:\"container\",layout:\"row\",gap:\"1em\",cid:\"allCheckCt\",items:[{cname:\"checkGroup\",returnAll:true,returnArray:true,cid:\"allCheckGroup\",items:[{cname:\"check\",label:\"item 1\",cid:\"check1\"},{cname:\"check\",label:\"item 2\",value:true,cid:\"check2\"},{cname:\"check\",label:\"item 3\",value:true,cid:\"check3\"}]},{cname:\"button\",text:\"Get value\",cid:\"getValueBtn\",events:{click(e,t){Wb.tip(Wb.encode(app.allCheckGroup.value))}}},{cname:\"button\",text:\"Set value by object\",cid:\"setValueObjectBtn\",events:{click(e,t){app.allCheckGroup.setValue({check1:true,check3:\"true\"})}}},{cname:\"button\",text:\"Set value by array\",cid:\"setValueArrayBtn\",events:{click(e,t){app.allCheckGroup.setValue([false,1,\"true\"])}}},{cname:\"button\",text:\"Set value by cids\",cid:\"setValueCidsBtn\",events:{click(e,t){app.allCheckGroup.setValue([\"check1\",\"check3\"])}}}]}]},{cname:\"title\",title:\"Radio\",cid:\"radioTitle\"},{cname:\"container\",layout:\"form\",cid:\"radioCt\",frame:true,items:[{cname:\"radio\",label:\"item 1\",cid:\"radio1\",group:\"group1\"},{cname:\"radio\",label:\"item 2\",cid:\"radio2\",group:\"group1\"},{cname:\"divider\",cid:\"divider1\"},{cname:\"radio\",label:\"item 3\",cid:\"radio3\",group:\"group2\"},{cname:\"radio\",label:\"item 4\",value:true,cid:\"radio4\",group:\"group2\"},{cname:\"radio\",label:\"item 5\",cid:\"radio5\",group:\"group2\"}]},{cname:\"title\",title:\"RadioGroup\",cid:\"radioGroupTitle\"},{cname:\"container\",layout:\"grid1\",cid:\"radioGroupCt\",frame:true,items:[{cname:\"label\",text:\"Common radioGroup\",cid:\"commonRadioGroupLabel\"},{cname:\"container\",layout:\"row\",gap:\"1em\",cid:\"commonRadioCt\",items:[{cname:\"radioGroup\",cid:\"commonRadioGroup\",items:[{cname:\"radio\",label:\"item 1\",cid:\"radio1\"},{cname:\"radio\",label:\"item 2\",cid:\"radio2\"},{cname:\"radio\",label:\"item 3\",cid:\"radio3\"}]},{cname:\"button\",text:\"Get value\",cid:\"getValueBtn\",events:{click(e,t){Wb.tip(app.commonRadioGroup.value)}}},{cname:\"button\",text:\"Set value\",cid:\"setValueBtn\",events:{click(e,t){app.commonRadioGroup.setValue(2)}}}]},{cname:\"label\",text:\"Return cid as value radioGroup\",cid:\"returnCidRadioGroupLabel\"},{cname:\"container\",layout:\"row\",gap:\"1em\",cid:\"returnNameRadioCt\",items:[{cname:\"radioGroup\",returnName:true,cid:\"returnNameRadioGroup\",items:[{cname:\"radio\",label:\"item 1\",value:true,cid:\"radio1\"},{cname:\"radio\",label:\"item 2\",cid:\"radio2\"},{cname:\"radio\",label:\"item 3\",cid:\"radio3\"}]},{cname:\"button\",text:\"Get value\",cid:\"getValueBtn\",events:{click(e,t){Wb.tip(app.returnNameRadioGroup.value)}}},{cname:\"button\",text:\"Set value by index\",cid:\"setValueByIndexBtn\",events:{click(e,t){app.returnNameRadioGroup.setValue(2)}}},{cname:\"button\",text:\"Set value by cid\",cid:\"setValueByCidBtn\",events:{click(e,t){app.returnNameRadioGroup.setValue(\"radio2\")}}}]}]},{cname:\"title\",title:\"Toggle\",cid:\"toggleTitle\"},{cname:\"container\",layout:\"grid1\",cid:\"toggleCt\",frame:true,items:[{cname:\"toggle\",text:\"Common toggle\",cid:\"commonToggle\",events:{change(e,t,a){Wb.tip(this.cid+\" is \"+e)}}},{cname:\"toggle\",prefix:\"Prefix text\",text:\"Prefix suffix\",suffix:\"Suffix text\",cid:\"prefixSuffixToggle\"},{cname:\"toggle\",text:\"Drag to toggle\",clickToggle:false,cid:\"dragToToggle\"},{cname:\"toggle\",toggleAlign:\"end\",text:\"Align right toggle\",cid:\"alignRightToggle\"},{cname:\"toggle\",vertical:true,text:\"Vertical toggle\",cid:\"verticalToggle\"},{cname:\"controlCt\",gap:\"1em\",text:\"Return int value\",cid:\"returnIntCt\",items:[{cname:\"toggle\",returnType:\"int\",cid:\"returnIntToggle\"},{cname:\"button\",text:\"Get value\",cid:\"getValue\",events:{click(e,t){Wb.tip(this.cid+\" value is \"+this.previousSibling.value)}}}]}]},{cname:\"title\",title:\"Slider\",cid:\"sliderTitle\"},{cname:\"container\",layout:\"grid1\",cid:\"sliderCt\",frame:true,items:[{cname:\"slider\",text:\"Common slider\",value:30,cid:\"commonSlider\",events:{enddrag(e,t){Wb.tip(\"End drag at \"+e)},startdrag(e,t){Wb.tip(\"Start drag at \"+e)}}},{cname:\"slider\",prefix:\"Prefix\",text:\"Multi slider\",suffix:\"Suffix\",value:[10,50,80],cid:\"multiSlider\",events:{enddrag(e,t){Wb.tip(\"The values are \"+Wb.encode(e))}}},{cname:\"controlCt\",layout:\"row\",gap:\"2em\",text:\"Vertical slider\",align:\"stretch\",cid:\"verticalSliderCt\",height:\"10em\",items:[{cname:\"slider\",labelUp:true,labelAlign:\"center\",labelSeparator:false,vertical:true,text:\"Text\",value:20,cid:\"verticalSlider\"},{cname:\"slider\",labelUp:true,prefix:\"Prefix\",vertical:true,suffix:\"Suffix\",value:[30,70],cid:\"verticalMulSlider\",events:{enddrag(e,t){Wb.tip(\"The values are \"+Wb.encode(e))}}}]},{cname:\"slider\",justifySelf:\"start\",vertical:true,text:\"Justify left\",value:20,cid:\"justifyLeftVerticalSlider\",height:\"6em\"},{cname:\"slider\",maxValue:100,text:\"Volume\",suffix:true,suffixWidth:\"3em\",value:50,cid:\"volumeSlider\",events:{change(e,t,a){Wb.toast(\"Volumn is \"+e)}}},{cname:\"slider\",minValue:100,prefix:\"100\",maxValue:500,tipRender(e){return\"Custom render \"+e},step:10,text:\"Misc slider\",suffix:500,value:200,cid:\"miscSlider\"},{cname:\"areaSlider\",maxValue:[300,200],width:\"30em\",text:\"Area slider\",value:[20,30],cid:\"areaSlider1\",height:\"10em\",events:{enddrag(e,t){Wb.toast(\"The value is \"+Wb.encode(e))}}}]}]});"}}