Menu:{cname:\"menu\",items:[{icon:\"grid\",text:\"Show row column\",cid:\"showRowColumnItem\",events:{click(e,t){let a,i,l;a=this.contextTarget;i=app.miscGrid.findItemByEl(a);l=app.miscGrid.findColumnByEl(a);if(i&&l)Wb.tip(\"Row code is \"+i.data.code+\" and column field name is \"+l.fieldName)}}},{text:\"Other item\",cid:\"item2\"}]},events:{itemdblclick(e,t,a){Wb.tip(e.data.full_name+\" row double clicked\")},beforesort(e,t,a){},click(e,t){let a=e.target.closest(\".my-link\");if(a){let e=this.findItemByEl(a);Wb.tip(a.textContent+\" clicked at \"+e.data.full_name)}}}},{cname:\"container\",layout:\"form\",padding:false,cid:\"container1\",items:[{cname:\"button\",text:\"Test frozen columns\",cid:\"testfrozenBtn\",events:{click(e,t){app.fullNameCol.width=app.miscGrid.width;Wb.toast(\"Now please scroll horizontally to test the left and right frozen columns.\")}}},{cname:\"button\",text:\"Sort Data\",cid:\"sortDataBtn\",events:{click(e,t){app.miscGrid.sort({name:\"code\",desc:true})}}},{cname:\"button\",text:\"Sort Items\",cid:\"sortItemsBtn\",events:{click(e,t){app.miscGrid.sortItems(((e,t)=>Wb.mixCompare(e.data.code,t.data.code)))}}}]},{cname:\"component\",textSelectable:false,html:\"<div>Feature List:</div>\\n<ul>\\n  <li>Columns sortable, resizable, draggable and freezable.</li>\\n  <li>Arbitrary multi-Level Headers.</li>\\n  <li>Customize cell rendering.</li>\\n  <li>Rows and columns highlighing.</li>\\n  <li>Local data pagination.</li>\\n  <li>Bind buttons or any controls to cells.</li>\\n  <li>Multiple styles of check columns.</li>\\n  <li>Customize columns and persistence to the database.</li>\\n  <li>Summary row.</li>\\n</ul>\",cid:\"miscDescComp\"},{cname:\"title\",title:\"Editable grid\",cid:\"editableGridTitle\"},{cname:\"grid\",enterAppend:true,columnsSortable:true,arrowDownAppend:true,editable:true,pageSize:10,enterAsTab:true,sorters:[{name:\"gender\",desc:true},\"salary\"],url:\"demo-source?xaction=staffAllDict\",cid:\"editableGrid\",height:\"15em\",multi