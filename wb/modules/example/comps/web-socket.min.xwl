{"title":"","icon":"plug","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module"},"_icon":"module","_expanded":true,"events":{"initialize":"Wb.make(app,{cname:\"socket\",name:\"wb.ws.commonSocket\",cid:\"commonSocket\",events:{message(e,t){Wb.tip(\"Received: \"+e.data)}}});Wb.make(app,{cname:\"socket\",name:\"wb.ws.xwlSocket\",xwl:xpath+\"/actions {xaction: 'receiveData'}\",cid:\"xwlSocket\",events:{message(e,t){Wb.tip(\"Received: \"+e.data)}}});Wb.make(app,{cname:\"socket\",name:\"wb.ws.binarySocket\",cid:\"binarySocket\",events:{message(e,t){let a=e.data;Wb.readBlob(a,(e=>{Wb.tip('<img src=\"data:image/png;base64,'+e+'\">',true)}))}}});Wb.make(app,{cname:\"viewport\",layout:\"grid1\",cid:\"viewport1\",items:[{cname:\"label\",text:\"WebSocket\",cls:\"w-title3\",cid:\"mainLabel\"},{cname:\"label\",text:\"Send text to the specified web socket of current user\",cid:\"sendTextToCurrentUserLabel\"},{cname:\"button\",text:\"Send text to current user\",type:\"primary\",cid:\"sendTextToCurrentUserBtn\",events:{click(e,t){Wb.ajax({url:xpath+\"/actions&xaction=sendTextToCurrentUser\",params:{text:\"text message\"}})}}},{cname:\"label\",text:\"Send binary to the specified web socket of current user\",cid:\"sendBinaryToCurrentUserLabel\"},{cname:\"button\",text:\"Send binary to current user\",type:\"primary\",cid:\"sendBinaryToCurrentUserBtn\",events:{click(e,t){Wb.ajax({url:xpath+\"/actions&xaction=sendBinaryToCurrentUser\"})}}},{cname:\"label\",text:\"Send text to the specified web socket of the specified user\",cid:\"sendTextToSpecifyUserLabel\"},{cname:\"button\",text:'Send text to \"admin\" user',type:\"primary\",cid:\"sendTextToSpecifiedUserBtn\",events:{click(e,t){Wb.ajax({url:xpath+\"/actions&xaction=sendTextToSpecifiedUser\",params:{text:\"text message\"}})}}},{cname:\"label\",text:\"Broadcast JSON to the specified web socket of all users\",cid:\"broadcastJsonToAllUsersLabel\"},{cname:\"button\",text:\"Broadcast JSON to all users\",type:\"primary\",cid:\"broadcastJsonToAllUsersBtn\",events:{click(e,t){Wb.ajax({url:xpath+\"/actions&xaction=broadcastJSONToSpecifiedUser\"})}}},{cname:\"label\",text:\"Send text to the specified xwl module by xwlSocket\",cid:\"sendTextBySocketLabel\"},{cname:\"button\",text:\"Send text by socket\",type:\"primary\",cid:\"sendTextBySocketBtn\",events:{click(e,t){app.xwlSocket.send(\"text\")}}},{cname:\"label\",text:\"Send binary to the specified xwl module by xwlSocket\",cid:\"sendBinaryBySocketLabel\"},{cname:\"button\",text:\"Send binary by socket\",type:\"primary\",cid:\"sendBinaryBySocketBtn\",events:{click(e,t){let a=new Blob([Wb.encode({foo:\"bar\"})],{type:\"application/json\"});app.xwlSocket.send(a)}}}]});"}}