{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module"},"_icon":"module","_expanded":true,"events":{"initialize":"Wb.apply(app,{init(){}});Wb.make(app,{cname:\"panel\",layout:\"grid1\",cid:\"panel1\",items:[{cname:\"label\",text:\"This card from card.xwl\",cid:\"label1\"},{cname:\"text\",text:\"Text\",cid:\"text1\"},{cname:\"date\",text:\"Date\",cid:\"date1\"},{cname:\"button\",width:\"20em\",justifySelf:\"center\",text:\"Set text value\",cid:\"setValueBtn\",events:{click(e,t){app.text1.value=\"card value\"}}},{cname:\"button\",width:\"20em\",justifySelf:\"center\",text:\"Set parent module tab title\",cid:\"setParentTitleBtn\",events:{click(e,t){parentApp.runModuleCardTab.title=\"New Title\"}}}]});Wb.make(app,{cname:\"window\",cid:\"thisWinAutoDestroyedAfterOwnerDestroyed\"});"}}