{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module"},"_icon":"module","_expanded":true,"events":{"initialize":"Wb.make(app,{cname:\"viewport\",layout:\"grid1\",cid:\"viewport1\",items:[{cname:\"label\",text:\"Client side web request\",cls:\"w-title3\",cid:\"mainLabel\"},{cname:\"title\",title:\"Send GET request with parameters.\",cid:\"getTitle\"},{cname:\"button\",text:\"Send request\",type:\"primary\",cid:\"getBtn\",events:{click(t,e){Wb.ajax({url:xpath+\"/actions&xaction=get\",params:{string:\"abc\",int:123,float:123.4,date:new Date,bool:true,object:{foo:\"bar\"},array:[1,2,3]},method:\"GET\",success(t){Wb.tipSucc(t)}})}}},{cname:\"title\",title:\"Send POST request with parameters, files and blobs.\",cid:\"postTitle\"},{cname:\"button\",text:\"Send request\",type:\"primary\",cid:\"postBtn\",events:{click(t,e){Wb.ajax({url:xpath+\"/actions&xaction=post\",params:{foo:\"bar\"},success(t){Wb.tipSucc(t)}})}}},{cname:\"title\",title:\"Send POST request with large parameters\",cid:\"useFormTitle\"},{cname:\"button\",text:\"Send request\",type:\"primary\",cid:\"useFormPostBtn\",events:{click(t,e){Wb.ajax({url:xpath+\"/actions&xaction=post\",form:true,params:{foo:\"large text...\"},success(t){Wb.tipSucc(t)}})}}},{cname:\"title\",title:\"Send request using object\",cid:\"deserializeObjectTitle\"},{cname:\"label\",text:\"It can serialize object before sending and auto deserialize all original values on the server side.\",cid:\"deserializeObjectLabel\"},{cname:\"button\",text:\"Send request\",type:\"primary\",cid:\"deserializeObjectBtn\",events:{click(t,e){Wb.ajax({url:xpath+\"/actions&xaction=deserializeObject\",object:{string:\"abc\",int:123,float:123.4,date:new Date,bool:true,object:{foo:\"bar\"},array:[1,2,3]},success(){Wb.tipDone()}})}}},{cname:\"title\",title:\"Post multiple parameters with the same name\",cid:\"postMultipleTitle\"},{cname:\"button\",text:\"Send request\",type:\"primary\",cid:\"postMultipleBtn\",events:{click(t,e){Wb.ajax({url:xpath+\"/actions&xaction=postMultipleParams\",params:{myParam:Wb.markParams([1,\"abc\",new Date])},success(){Wb.tipDone()}})}}},{cname:\"title\",title:\"Send request with payload data and specific header\",cid:\"postPayloadDataTitle\"},{cname:\"button\",text:\"Send request\",type:\"primary\",cid:\"postPayloadDataBtn\",events:{click(t,e){Wb.ajax({url:xpath+\"/actions&xaction=postPayload\",data:\"large text...\",header:{\"Content-Type\":\"text/html;charset=utf-8\"},success(){Wb.tipDone()}})}}},{cname:\"title\",title:\"Send request with payload json data\",cid:\"postPayloadJsonTitle\"},{cname:\"button\",text:\"Send request\",type:\"primary\",cid:\"postPayloadJsonBtn\",events:{click(t,e){Wb.ajax({url:xpath+\"/actions&xaction=postPayloadJson\",data:{foo:\"abc\",bar:123},success(){Wb.tipDone()}})}}},{cname:\"title\",title:\"Submit a regular HTTP request\",cid:\"submitTitle\"},{cname:\"button\",text:\"Regular submit\",type:\"primary\",cid:\"submitBtn\",events:{click(t,e){Wb.submit(xpath+\"/actions&xaction=postSubmit\",{foo:\"abc\",bar:123})}}},{cname:\"title\",title:\"Browse url\",cid:\"browseTitle\"},{cname:\"button\",text:\"Browse url\",type:\"primary\",cid:\"browseBtn\",events:{click(t,e){Wb.browse({url:\"https://www.geejing.com\",title:\"Geejing\",icon:\"earth\",params:{foo:\"abc\",bar:123}})}}},{cname:\"title\",title:\"Open window\",cid:\"openWinTitle\"},{cname:\"button\",text:\"Open window\",type:\"primary\",cid:\"openWinBtn\",events:{click(t,e){Wb.openWin(\"https://www.geejing.com\")}}}]});"}}