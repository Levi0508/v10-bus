{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module"},"_icon":"module","_expanded":true,"events":{"initialize":"Wb.make(app,{cname:\"viewport\",layout:\"grid1\",cid:\"viewport1\",items:[{cname:\"label\",text:\"Server load module, js and mjs\",cls:\"w-title3\",cid:\"mainLabel\"},{cname:\"title\",title:\"Run module\",cid:\"runModuleTitle\"},{cname:\"label\",text:\"Run the module at serverside and call function of the module.\",cid:\"runModuleLabel\"},{cname:\"button\",text:\"Run module\",type:\"primary\",cid:\"runModuleBtn\",events:{click(e,t){Wb.ajax({url:xpath+\"/execute&xaction=runXwl\",params:{value1:12,value2:34},success(e){Wb.tip(\"The result is \"+e)}})}}},{cname:\"title\",title:\"Invoke module\",cid:\"invokeModuleTitle\"},{cname:\"label\",text:\"Call the module and obtain the HTML or script returned by the module.\",cid:\"InvokeModuleLabel\"},{cname:\"button\",text:\"Invoke module\",type:\"primary\",cid:\"invokeModuleBtn\",events:{click(e,t){Wb.ajax({url:xpath+\"/execute&xaction=invokeXwl\",success(e){app.invokeModuleViewer.text=e;console.table(Wb.decode(e))}})}}},{cname:\"viewer\",cid:\"invokeModuleViewer\",height:\"10em\"},{cname:\"title\",title:\"Load Javascript\",cid:\"loadJSTitle\"},{cname:\"label\",text:\"Load Javascript library at serverside.\",cid:\"loadJSLabel\"},{cname:\"button\",text:\"Load js\",type:\"primary\",cid:\"loadJSBtn\",events:{click(e,t){Wb.ajax({url:xpath+\"/execute&xaction=loadJs\",params:{value1:12,value2:34},success(e){Wb.tip(\"The result is \"+e)}})}}},{cname:\"title\",title:\"Load mjs\",cid:\"loadMJSTitle\"},{cname:\"label\",text:\"Load Javascript module at serverside by Wb.load(recommended).\",cid:\"loadMJSLabel\"},{cname:\"button\",text:\"Load mjs\",type:\"primary\",cid:\"loadMJSBtn\",events:{click(e,t){Wb.ajax({url:xpath+\"/execute&xaction=loadMjs\",params:{value1:12,value2:34},success(e){Wb.tip(\"The result is \"+e)}})}}},{cname:\"label\",text:\"Import Javascript module at serverside by import(not recommended).\",cid:\"importMJSLabel\"},{cname:\"button\",text:\"Import mjs\",type:\"primary\",cid:\"importMJSBtn\",events:{click(e,t){Wb.ajax({url:xpath+\"/execute&xaction=importMjs\",params:{value1:12,value2:34},success(e){Wb.tip(\"The result is \"+e)}})}}}]});"}}