{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module"},"_icon":"module","_expanded":true,"events":{"initialize":"Wb.make(app,{cname:\"viewport\",layout:\"grid1\",cid:\"viewport1\",items:[{cname:\"label\",text:\"Server side web request\",cls:\"w-title3\",cid:\"mainLabel\"},{cname:\"title\",title:\"Get mozilla.org site html\",cid:\"getHtmlTitle\"},{cname:\"viewer\",cid:\"htmlSourceViewer\",height:\"8em\"},{cname:\"button\",text:\"Get html\",type:\"primary\",cid:\"getHtmlBtn\",events:{click(t,e){Wb.ajax({url:xpath+\"/actions&xaction=getHtml\",success(t){app.htmlSourceViewer.text=t}})}}},{cname:\"title\",title:\"Send post request with params\",cid:\"postParamsTitle\"},{cname:\"button\",text:\"Post params\",type:\"primary\",cid:\"postParamsBtn\",events:{click(t,e){Wb.ajax({url:xpath+\"/actions&xaction=postParams\",success(t){Wb.tipDone()}})}}},{cname:\"title\",title:\"Send post request with payload data\",cid:\"postPayloadDataTitle\"},{cname:\"button\",text:\"Post payload data\",type:\"primary\",cid:\"postPayloadDataBtn\",events:{click(t,e){Wb.ajax({url:xpath+\"/actions&xaction=postPayload\",success(t){Wb.tipDone()}})}}},{cname:\"title\",title:\"Send post request with files\",cid:\"postFileTitle\"},{cname:\"button\",text:\"Post files\",type:\"primary\",cid:\"postFilesBtn\",events:{click(t,e){Wb.ajax({url:xpath+\"/actions&xaction=postFiles\",success(t){Wb.tipDone()}})}}},{cname:\"title\",title:\"Login to the system, access modules and logout.\",cid:\"loginTitle\"},{cname:\"button\",text:\"Login and Access\",type:\"primary\",cid:\"loginAccessBtn\",events:{click(t,e){Wb.ajax({url:xpath+\"/actions&xaction=loginAndLogout\",success(t){Wb.tipDone()}})}}}]});"}}