{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"let actions = {\n  /**\n   * Select data.\n   */\n  select() {\n    Wb.sendDict('select * from wb_staff', 'wb,');\n  },\n  /**\n   * Get form.\n   */\n  getForm() {\n    Wb.send(Wb.getExcelHtml('form.xlsx', { now: new Date().dateText }));\n  },\n  /**\n   * Export data.\n   */\n  export() {\n    let data = Wb.getObject('data');\n    data.gender = data.gender$; // display text\n    Wb.getExcelFile('my-form.xlsx', 'form.xlsx', data);\n  }\n};\nactions[Params.xaction]();"},"_icon":"module"}