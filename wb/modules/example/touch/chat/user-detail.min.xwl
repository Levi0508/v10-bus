{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module"},"_icon":"module","_expanded":true,"events":{"initialize":"Wb.make(app,{cname:\"dialog\",autoScroll:true,cid:\"main\",tools:[{icon:\"menu\",plainIcon:true,cid:\"menuItem\",menu:{cname:\"menu\",items:[{icon:\"add\",text:Str.add,cid:\"addItem\"},{icon:\"edit\",text:Str.edit,cid:\"editItem\"},{cname:\"divider\",cid:\"divider1\"},{icon:\"delete\",text:Str.del,cid:\"delItem\"}]}}],events:{hidden(e){this.destroy()}},items:[{cname:\"component\",tpl:'<div class=\"w-row w-gap1\">\\n  <div class=\"w-icon icon-user2 w-size3 w-aligns-center\"></div>\\n  <div class=\"w-column w-gap\">\\n    <div class=\"w-row w-gap\">\\n      <div class=\"w-title4\">{display_name}</div>\\n      <div class=\"w-icon icon-user3 w-aligns-center\"></div>\\n    </div>\\n    <div>User name: {user_name}</div>\\n    <div>User id: {sid}</div>\\n    <div>E-mail: {email}</div>\\n  </div>\\n</div>',padding:\"1em\",cid:\"summaryComp\"},{cname:\"line\",margin:\"top\",cid:\"line1\"},{cname:\"option\",buttonStyle:true,icon:\"message\",text:\"Send message\",cid:\"sendMsgOption\",events:{click(e,i){let t=app.chatApp,n=t.openUserData;app.main.close(true);t.openChat({userid:n.sid,display_name:n.display_name})}}},{cname:\"gap\",cid:\"gap1\"},{cname:\"option\",border:\"bottom\",text:\"Set notes and labels\",cid:\"noteOption\",events:{click(e,i){Wb.tip(this.text)}}},{cname:\"option\",text:\"Friend permissions\",cid:\"permOption\",events:{click(e,i){Wb.tip(this.text)}}},{cname:\"gap\",cid:\"gap2\"},{cname:\"option\",border:\"bottom\",text:\"Moments\",cid:\"momentOption\",height:\"5em\",events:{click(e,i){Wb.tip(this.text)}}},{cname:\"option\",text:\"More information\",cid:\"moreOption\",events:{click(e,i){Wb.tip(this.text)}}},{cname:\"gap\",flex:1,cid:\"gap3\"}]});"}}