{"title":"","icon":"","img":"","tags":"","hideInMenu":"true","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"let actions = {\n  /**\n   * Select leave data.\n   */\n  selectLeave() {\n    let result = Wb.getRow('select * from wb_leave where flow_id={?flowId?}');\n    result.flowTitle = new Wb.Workflow({ flowId: Params.flowId }).title;\n    Wb.send(result);\n  }\n};\nactions[Params.xaction]();"},"_icon":"module"}