{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"function main(){let e,a;e=new Wb.Workflow({flowId:Params.flowId});Params.userid=e.userid;a=Wb.getRow(\"select * from wb_leave where flow_id={?flowId?} and user_id={?userid?}\");a.applicant=e.getInitUser().displayName;Params.leaveData=Wb.encode(a)}main();"},"_icon":"module","_expanded":true,"events":{"initialize":"Wb.apply(app,{hideActionButtons:true,leaveData:_$leaveData$_,init(e,a,t){Wb.setValue(app.main,app.leaveData);app.radioGroup1.visible=a==\"handle\";Wb.log(t.data.node_name)},onAction(){let e;switch(app.radioGroup1.value){case 0:app.doPass();break;case 1:e=app.nodeSelect.value;if(e)app.doBack(e);else{app.nodeSelect.focus();Wb.tipSelect()}break;case 2:e=app.userSelect.value;if(e)app.doTransfer(e);else{app.userSelect.focus();Wb.tipSelect()}break;case 3:app.doReject();break;case 4:e=app.userSelect.value;if(e)app.doSignBefore(e);else{app.userSelect.focus();Wb.tipSelect()}break;case 5:e=app.userSelect.value;if(e)app.doSignAfter(e);else{app.userSelect.focus();Wb.tipSelect()}break}}});Wb.make(app,{cname:\"window\",layout:\"column\",padding:true,visible:true,icon:\"paper-plane\",width:\"80em\",title:\"Leave application\",autoScroll:true,cid:\"main\",items:[{cname:\"radioGroup\",cid:\"radioGroup1\",events:{change(e){let a=this.value;if(a==3)a=0;else if(a==4||a==5)a=2;app.cardCt1.activeIndex=a;if(a==1&&!app.nodeSelect.value){app.nodeSelect.picker.load({success(){this.parent.valueIndex=0}})}}},items:[{cname:\"radio\",label:Str.pass,value:true,cid:\"passRadio\"},{cname:\"radio\",label:Str.back1,cid:\"backRadio\"},{cname:\"radio\",label:Str.transfer,cid:\"transferRadio\"},{cname:\"radio\",label:Str.reject,cid:\"rejectRadio\"},{cname:\"radio\",label:Str.signBefore,cid:\"signBeforeRadio\"},{cname:\"radio\",label:Str.signAfter,cid:\"signAfterRadio\"}]},{cname:\"cardCt\",border:false,cid:\"cardCt1\",items:[{cname:\"container\",layout:\"grid1\",cid:\"container1\",items:[{cname:\"text\",readonly:true,text:\"Applicant\",cid:\"applicant\"},{cname:\"date\",readonly:true,text:\"Begin Date\",cid:\"begin_date\"},{cname:\"date\",readonly:true,text:\"End Date\",cid:\"end_date\"},{cname:\"number\",readonly:true,text:\"Leave Days\",cid:\"leave_days\"},{cname:\"text\",readonly:true,text:\"Leave Reason\",cid:\"leave_reason\"}]},{cname:\"container\",layout:\"grid1\",cid:\"container2\",items:[{cname:\"select\",forceSelect:true,text:\"Select node\",url:\"m?xwl=my/my-flow/get-his-nodes\",cid:\"nodeSelect\",events:{beforeload(e,a,t){a.flowId=app.flowId}}}]},{cname:\"container\",layout:\"grid1\",cid:\"container3\",items:[{cname:\"select\",forceSelect:true,text:\"Select user\",valueField:\"sid\",url:\"m?xwl=sys/dialog/user-selector/select\",cid:\"userSelect\",textField:\"display_name\",subtextField:\"user_name\"}]}]}]});"}}