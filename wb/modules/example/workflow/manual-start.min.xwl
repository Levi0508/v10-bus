{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module"},"_icon":"module","_expanded":true,"events":{"initialize":"Wb.make(app,{cname:\"viewport\",layout:\"grid1\",cid:\"viewport1\",items:[{cname:\"title\",title:\"Manual start a new workflow\",cid:\"title1\"},{cname:\"button\",text:\"Start a new workflow\",type:\"primary\",cid:\"button1\",events:{click(t,e){Wb.ajax({url:xpath+\"/start\",success(){Wb.tip(\"The workflow started, click to view it.\",null,(t=>Wb.openNormal({url:\"my-flow\",success(t){t.grid1.reload()}})))}})}}}]});"}}