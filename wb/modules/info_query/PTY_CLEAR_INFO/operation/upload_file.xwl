{"title":"仅上传磁盘 不存服务器","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"let file1 = Wb.get('file1'),\n  clientId = Wb.get('client_id'),\n  fileTypeNo = Wb.get('file_type_no'),\n  objectId = Wb.get('objectId');\n\nlet path = '/data/thfxqfiles/' + clientId + '/';\nlet file = new File(path, file1.name);\nlet parent = file.getParentFile();\nlet userName = Wb.get('sys.username');\nlet id = SysUtil.getId();\n\nvar conn = DataSource.getConnection(), pstmt;\nvar content = file1.stream;\n\nif (!parent.exists()) { parent.mkdirs(); }\n\nlet os = new java.io.FileOutputStream(new File(path, file1.name));\ntry {\n  IOUtils.copy(file1.stream, os); // 文件内容存磁盘\n} catch (e) {\n  conn.rollback();\n  throw e;\n} finally {\n  conn.commit();\n  conn.close();\n  os.close();\n}"},"_icon":"module"}