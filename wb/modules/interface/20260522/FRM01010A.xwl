olor: #1C65DD;cursor: pointer;visibility: {show_more};\" onclick=\"Wb.info('{BUSI_SCOPE}');\">查看全部</span>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>","tplData":"{}","cid":"relation_jg_tplComponent"}}],"properties":{"minHeight":"2em","border":"false","cid":"relation_jg_container"}}],"properties":{"border":"false","padding":"1em 0 0 1em","visible":"false","cid":"relation_JG"},"events":{"ready":"if('_$ORGAN_FLAG$_' == '1') {\n  Wb.ajax({\n    url: 'm?xwl=aml_monitor/workflow_v8pro/prs01/datasource/select_other_info',\n    json: true,\n    params: {\n      PROCESS_ID: '_$xprocessid$_',\n      UNIQUE_ID: '_$UNIQUE_ID$_',\n      FLOW_DEPT: '_$FLOW_DEPT$_'\n    },\n    success(resp) {\n      if(resp.total > 0) {\n        resp.items.forEach(function(item){ item.ID_TIME = item.ID_BEGINDATE + ' - ' + item.ID_ENDDATE; });\n        var relationClientsList = resp.items;\n        app.relationClientsView.data = relationClientsList;\n        if(relationClientsList.length) { app.relationClientsView.items$[0].selected = true; } // 设置第一个viewitem的selected\n      }\n    }\n  });\n}"}},{"_icon":"panel","_expanded":false,"text":"compare_JG","cls":"Wb.Panel","items":[{"hasDupCid":1,"_icon":"container","_expanded":false,"text":"title","cls":"Wb.Container","properties":{"padding":"0.5em 0","html":"<div style=\"display: flex;align-items: center;\">\n  <div style=\"display: inline-block;width: 3px; height: 1.2em;background-color: rgb(39, 119, 252);\"></div>\n  <div style=\"display: inline-block;color: rgb(39, 119, 252);margin-left: 0.5em;\">身份信息比对结果(包含与工商信息比对)</div>\n</div>","cid":"title"}},{"hasDupCid":0,"_icon":"grid","_expanded":true,"text":"compare_JG_grid","cls":"Wb.Grid","properties":{"pagingBar":"false","fontSize":"0.9em","cid":"compare_JG_grid"}}],"properties":{"border":"false","padding":"1em 1em 0 1em","visible":"false","cid":"compare_JG"},"events":{"ready":"if('_$ORGAN_FLAG$_' == '1') {\n  Wb.ajax({\n    url: 'm?xwl=aml_monitor/workflow_v8pro/prs01/datasource/select_other_info',\n    json: true,\n    params: {\n      PROCESS_ID: '_$xprocessid$_',\n      UNIQUE_ID: '_$UNIQUE_ID$_',\n      FLOW_DEPT: '_$FLOW_DEPT$_'\n    },\n    success(resp) {\n      if(resp.total > 0) {\n        resp.items.forEach(function(item){ item.ID_TIME = item.ID_BEGINDATE + ' - ' + item.ID_ENDDATE; });\n        // let compare_JG_data = [app.baseInfo];\n        // compare_JG_data = compare_JG_data.concat(resp.items);\n        Wb.ajax({\n          url: 'm?xwl=aml_monitor/workflow_v8pro/prs01/datasource/select_CIF_CDI_CHECK_RESULT',\n          json: true,\n          params: {\n            PROCESS_ID: '_$xprocessid$_',\n            UNIQUE_ID: '_$UNIQUE_ID$_',\n            FLOW_DEPT: '_$FLOW_DEPT$_'\n          },\n          success(resp1) {\n            if(resp1.total > 0) {\n              // compare_JG_data[0].BUSI_DATE = String(resp1.items[0].ETL_DATE);\n              let compare_JG_data = [app.baseInfo];\n              compare_JG_data = compare_JG_data.concat(resp.items);\n              var compare_JG_grid_data = resp1.items;\n              compare_JG_grid_data.forEach(function(item, index){\n                item.BUSI_DATE = String(item.ETL_DATE);\n                item.COLUMNS = item.CHECK_ITEM_NAME;\n                item.RESULT = true;\n                if(item.CHECK_ITEM_NAME == '客户名称') { item.COLUMN_PROP = 'CLIENT_NAME';  }\n                if(item.CHECK_ITEM_NAME == '证件类型') { item.COLUMN_PROP = 'ID_TYPE_NAME';  }\n                if(item.CHECK_ITEM_NAME == '证件号码') { item.COLUMN_PROP = 'ID_NO';  }\n                if(item.CHECK_ITEM_NAME == '注册资本') { item.COLUMN_PROP = 'REGISTER_FUND';  }\n                if(item.CHECK_ITEM_NAME == '证件有效期') { item.COLUMN_PROP = 'ID_TIME';  }\n                if(item.CHECK_ITEM_NAME == '证件地址') { item.COLUMN_PROP = 'ID_ADDRESS';  }\n                if(item.CHECK_ITEM_NAME == '经营范围') { item.COLUMN_PROP = 'BUSI_SCOPE';  }\n                if(item.CHECK_ITEM_NAME == '联系方式') { item.COLUMN_PROP = 'MOBILE';  }\n                if(item.CHECK_ITEM_NAME == '注册资本币种') { item.COLUMN_PROP = 'REGISTER_MONEY_TYPE_NAME';  }\n                if(item.CHECK_ITEM_NAME == '法人代表姓名') { item.COLUMN_PROP = 'INSTREPR_NAME';  }\n              });\n              app.initDynamicJGTable(compare_JG_data, compare_JG_grid_data);\n            }\n          }\n        });\n      }\n    }\n  });\n}"}},{"_icon":"panel","_expanded":false,"text":"newBaseInfoPanel_JG","cls":"Wb.Panel","items":[{"hasDupCid":1,"_icon":"container","text":"title","cls":"Wb.Container","properties":{"padding":"0.5em 0","html":"<div style=\"display: flex;align-items: center;\">\n  <div style=\"display: inline-block;width: 3px; height: 1.2em;background-color: rgb(39, 119, 252);\"></div>\n  <div style=\"display: inline-block;color: rgb(39, 119, 252);margin-left: 0.5em;\">核查后有效身份信息</div>\n</div>","cid":"title"}},{"hasDupCid":0,"_icon":"panel","_expanded":true,"text":"newBaseInfo_JG","cls":"Wb.Panel","items":[{"hasDupCid":1,"_icon":"text","_expanded":true,"text":"CLIENT_NAME","cls":"Wb.Text","properties":{"readonly":"false","labelWidth":"12em","fontSize":"0.8em","text":"客户名称","required":"true","cid":"CLIENT_NAME"},"events":{"blur":"Wb.setValue(app.frmInfo, {\n  I_CLIENT_NAME: e.currentTarget.value\n});"}},{"hasDupCid":1,"_icon":"combo","text":"ID_TYPE","cls":"Wb.Select","properties":{"readonly":"false","autoLoad":"true","labelWidth":"12em","fontSize":"0.8em","text":"证件类型","valueField":"SUBENTRY","required":"true","url":"m?xwl=aml_monitor/workflow_v8pro/prs01/datasource/getDictSubentry","matchMode":"includesIC","cid":"ID_TYPE","textField":"COMMENTS"},"events":{"loadsuccess":"if(this.rawValue) { this.setValue(this.rawValue); }","beforeload":"params.ENTRY_NO = '1041';\nparams.DATA_SOURCE = 'CT11';","blur":"if(this.rawValue) {\n  Wb.setValue(app.frmInfo, {\n    I_ID_TYPE: this.rawValue\n  });\n} else {\n  this.clear();\n}"}},{"hasDupCid":1,"_icon":"text","text":"ID_NO","cls":"Wb.Text","properties":{"readonly":"false","labelWidth":"12em","fontSize":"0.8em","text":"证件号码","required":"true","cid":"ID_NO"},"events":{"blur":"Wb.setValue(app.frmInfo, {\n  I_ID_NO: e.currentTarget.value\n});"}},{"hasDupCid":0,"_icon":"text","text":"INSTREPR_NAME","cls":"Wb.Text","properties":{"readonly":"false","labelWidth":"12em","fontSize":"0.8em","text":"法人代表姓名","required":"true","cid":"INSTREPR_NAME"},"events":{"blur":"Wb.setValue(app.frmInfo, {\n  I_INSTREPR_NAME: e.currentTarget.value\n});"}},{"hasDupCid":1,"_icon":"calendar","_expanded":true,"text":"ID_BEGINDATE","cls":"Wb.Date","properties":{"readonly":"false","editable":"true","fontSize":"0.8em","labelWidth":"12em","text":"证件有效期起始日","required":"true","cid":"ID_BEGINDATE"},"events":{"blur":"Wb.setValue(app.frmInfo, {\n  I_ID_BEGINDATE: Wb.format(this.value, 'yMMdd')\n});"}},{"hasDupCid":1,"_icon":"calendar","text":"ID_ENDDATE","cls":"Wb.Date","properties":{"readonly":"false","editable":"true","fontSize":"0.8em","labelWidth":"12em","text":"证件有效期截至日","cid":"ID_ENDDATE"},"events":{"blur":"Wb.setValue(app.frmInfo, {\n  I_ID_ENDDATE: Wb.format(this.value, 'yMMdd')\n});"}},{"hasDupCid":1,"_icon":"text","text":"ID_ADDRESS","cls":"Wb.Text","properties":{"readonly":"false","gridColumn":"span 2","labelWidth":"12em","fontSize":"0.8em","text":"证件地址","required":"true","cid":"ID_ADDRESS"},"events":{"blur":"Wb.setValue(app.frmInfo, {\n  I_ID_ADDRESS: e.currentTarget.value\n});"}},{"hasDupCid":0,"_icon":"combo","text":"REGISTER_MONEY_TYPE","cls":"Wb.Select","properties":{"readonly":"false","autoLoad":"true","labelWidth":"12em","fontSize":"0.8em","text":"注册资本币种","valueField":"SUBENTRY","required":"true","matchMode":"includesIC","url":"m?xwl=aml_monitor/workflow_v8pro/prs01/datasource/getDictSubentry","cid":"REGISTER_MONEY_TYPE","textField":"COMMENTS"},"events":{"loadsuccess":"if(this.rawValue) { this.setValue(this.rawValue); }","beforeload":"params.ENTRY_NO = '1101';\nparams.DATA_SOURCE = 'CT11';","blur":"if(this.rawValue) {\n  Wb.setValue(app.frmInfo, {\n    I_REGISTER_MONEY_TYPE: this.rawValue\n  });\n} else {\n  this.clear();\n}"}},{"hasDupCid":1,"_icon":"number-edit","_expanded":true,"text":"REGISTER_FUND","cls":"Wb.Number","properties":{"minValue":"0","readonly":"false","labelWidth":"12em","fontSize":"0.8em","text":"注册资本金","required":"true","cid":"REGISTER_FUND"},"events":{"blur":"Wb.setValue(app.frmInfo, {\n  I_REGISTER_FUND: e.currentTarget.value\n});"}},{"hasDupCid":1,"_icon":"textarea","text":"BUSI_SCOPE","cls":"Wb.TextArea","properties":{"readonly":"false","gridColumn":"span 2","fontSize":"0.8em","labelWidth":"12em","autoResize":"true","text":"经营范围","rows":"5","required":"true","cid":"BUSI_SCOPE"},"events":{"blur":"Wb.setValue(app.frmInfo, {\n  I_BUSI_SCOPE: e.currentTarget.value\n});"}}],"properties":{"border":"false","layout":"grid2","cid":"newBaseInfo_JG"},"events":{"ready":"if('_$ORGAN_FLAG$_' == '1') {\n  Wb.ajax({\n    url: 'm?xwl=aml_monitor/workflow_v8pro/prs01/datasource/select_deal_info',\n    json: true,\n    params: {\n      PROCESS_ID: '_$xprocessid$_',\n      UNIQUE_ID: '_$UNIQUE_ID$_',\n      ETL_DATE: '_$ETL_DATE$_',\n      BRANCH_NO: '_$BRANCH_NO$_'\n    },\n    success(resp) {\n      if(resp.total > 0) {\n        Wb.setValue(app.newBaseInfo_JG, resp.items[0]);\n        Wb.setValue(app.frmInfo, {\n          I_CLIENT_NAME: resp.items[0].CLIENT_NAME,\n          I_ID_TYPE: resp.items[0].ID_TYPE,\n          I_ID_NO: resp.items[0].ID_NO,\n          I_INSTREPR_NAME: resp.items[0].INSTREPR_NAME,\n          I_ID_BEGINDATE: resp.items[0].ID_BEGINDATE,\n          I_ID_ENDDATE: resp.items[0].ID_ENDDATE,\n          I_ID_ADDRESS: resp.items[0].ID_ADDRESS,\n          I_REGISTER_MONEY_TYPE: resp.items[0].REGISTER_MONEY_TYPE,\n          I_REGISTER_FUND: resp.items[0].REGISTER_FUND,\n          I_BUSI_SCOPE: resp.items[0].BUSI_SCOPE,\n        });\n      }\n    }\n  });\n}"}}],"properties":{"border":"false","padding":"1em 0 0 1em","visible":"false","cid":"newBaseInfoPanel_JG"}},{"_icon":"panel","_expanded":false,"text":"filePanel","cls":"Wb.Panel","items":[{"hasDupCid":1,"_icon":"container","_expanded":true,"text":"title","cls":"Wb.Container","properties":{"padding":"0.5em 0","html":"<div style=\"display: flex;align-items: center;\">\n  <div style=\"display: inline-block;width: 3px; height: 1.2em;background-color: rgb(39, 119, 252);\"></div>\n  <div style=\"display: inline-block;color: rgb(39, 119, 252);margin-left: 0.5em;\">证明材料上传</div>\n</div>","cid":"title"}},{"hasDupCid":0,"_icon":"grid","_expanded":false,"text":"fileGrid","cls":"Wb.Grid","items":[{"hasDupCid":1,"_icon":"array","_expanded":true,"text":"columns","cls":"Wb.Array","items":[{"hasDupCid":0,"_icon":"column","text":"NAME","cls":"Wb.Column","properties":{"fieldName":"NAME","width":"-3","text":"文件名","autoWrap":"pre-wrap","align":"left","cid":"NAME","titleAlign":"center"}},{"hasDupCid":0,"_icon":"column","text":"EXTENSION","cls":"Wb.Column","properties":{"fieldName":"EXTENSION","width":"-1","text":"类型","autoWrap":"pre-wrap","align":"center","cid":"EXTENSION","titleAlign":"center"}},{"hasDupCid":0,"_icon":"column","text":"CREATE_TIME","cls":"Wb.Column","properties":{"fieldName":"CREATE_TIME","width":"-1","text":"上传时间","autoWrap":"pre-wrap","align":"center","cid":"CREATE_TIME","titleAlign":"center"}},{"hasDupCid":0,"_icon":"column","text":"CREATE_BY","cls":"Wb.Column","properties":{"fieldName":"CREATE_BY","width":"-1","text":"上传人员","autoWrap":"pre-wrap","align":"center","cid":"CREATE_BY","titleAlign":"center"}},{"hasDupCid":0,"_icon":"column","text":"FILE_SIZE","cls":"Wb.Column","properties":{"fieldName":"FILE_SIZE","width":"-1","text":"大小","autoWrap":"pre-wrap","align":"right","cid":"FILE_SIZE","titleAlign":"center"}},{"hasDupCid":0,"_icon":"column","_expanded":false,"text":"opt","cls":"Wb.Column","items":[{"hasDupCid":0,"_icon":"array","_expanded":true,"cls":"Wb.Array","text":"buttons","items":[{"hasDupCid":0,"_icon":"item","_expanded":false,"text":"downloadItem","cls":"Wb.Item","properties":{"icon":"download","tip":"下载","cid":"downloadItem"},"events":{"click":"var ID = this.data.ID;\nWb.ajax({\n  url: 'm?xwl=aml_monitor/workflow_v8pro/prs01/datasource/getFileContent',\n  download: true,\n  params: { ID: ID },\n  onDownload(percent) {\n    Wb.progress(percent);\n  }\n});"}},{"hasDupCid":0,"_icon":"item","_expanded":false,"text":"deleteItem","cls":"Wb.Item","properties":{"icon":"delete4","tip":"删除","cid":"deleteItem"},"events":{"click":"var ID = this.data.ID;\nWb.confirm('确定删除该附件吗？', function() {\n  debugger;\n  Wb.ajax({\n    url: 'm?xwl=aml_monitor/workflow_v8pro/prs01/datasource/deleteFile',\n    json: true,\n    params: { ID: ID },\n    success(resp) {\n      Wb.toast('删除成功！');\n      app.fileGrid.reload();\n    }\n  });\n});"}}],"properties":{"cid":"buttons"}}],"properties":{"width":"8em","autoWrap":"pre-wrap","text":"操作","align":"center","cid":"opt","titleAlign":"center"}}],"properties":{"cid":"columns"}}],"properties":{"visible":"false","pagingBar":"true","fontSize":"0.9em","url":"m?xwl=aml_monitor/workflow_v8pro/prs01/datasource/selectFile","cid":"fileGrid"},"events":{"beforeload":"params.PROCESS_ID = '_$PROCESS_ID$_'","success":"if(items.length > 0) { \n  parent.setVisible(true);\n} else {\n  parent.setVisible(false);\n}"}},{"hasDupCid":0,"_icon":"panel","_expanded":true,"text":"toolBarPanel","cls":"Wb.Panel","items":[{"hasDupCid":0,"_icon":"label","_expanded":true,"text":"label1","cls":"Wb.Label","properties":{"margin":"0.5em 0 0 0.5em","fontSize":"0.8em","text":"上传附件：","cid":"label1"}},{"hasDupCid":0,"_icon":"button","text":"chooseFileBtn","cls":"Wb.Button","properties":{"border":"false","padding":"0.5em 1em","color":"#FFFFFF","background":"#409EFF","width":"7em","fontSize":"0.8em","text":"选择文件","cid":"chooseFileBtn"},"events":{"click":"app.multiFileInput.onInputClick();"}},{"hasDupCid":0,"_icon":"button","text":"uploadFileBtn","cls":"Wb.Button","properties":{"border":"false","padding":"0.5em 1em","color":"#FFFFFF","background":"#19BE6B","width":"7em","fontSize":"0.8em","text":"开始上传","cid":"uploadFileBtn"},"events":{"click":"/**\n * 文件列表校验\n * Example:\n *\n *     app.verifyFiles({filesList: []); // 上传文件，且没有限制\n *     app.verifyFiles({filesList: app.multiFileInput.getFiles(), acceptTypeList: ['zip', 'txt'], acceptSize: 20971520 });  // 只能上传20MB的zip文件、txt文件\n *\n * @param {Object} params 配置file文件列表以及验证信息。\n * @param {Array} [.filesList] 文件列表，默认为[]。size： 文件大小，单位为B；name：文件名称。\n * @param {Array} [.acceptTypeList] 能通过验证的文件类型。默认为[], 不进行类型校验。文件类型不区分大小写\n * @param {Number} [.acceptSize] 能通过验证的文件size，单位为B。默认不进行size校验。\n * @return {Number} 0全部通过校验，1至少有一个文件大小未通过校验，2至少有一个文件类型未通过校验。\n */\napp.verifyFiles = function(params) {\n  var filesList = params.filesList || [];\n  var acceptTypeList = params.acceptTypeList || [];\n  var acceptSize = params.acceptSize || null;\n  var verifyResult = 0;\n  if(filesList.length === 0) { return 0; } // 文件列表为空，直接通过校验\n  for(var fileIndex = 0; fileIndex < filesList.length; fileIndex++) {\n    var file = filesList[fileIndex];\n    if(acceptSize && file.size > acceptSize) { verifyResult = 1; break; }\n    if(acceptTypeList.length && file.name.indexOf('.') > -1) {\n      var fileType = file.name.toUpperCase().split('.').lastItem;\n      if(acceptTypeList.filter(i=>i.toUpperCase() === fileType).length === 0) { verifyResult = 2; break; }\n    }\n  }\n  return verifyResult;\n};\n/**\n * 单个文件上传 （severscript无法接收到多个文件的流，原因不明，暂时拆分成单个文件的上传）\n * Example:\n *\n *     app.uploadFile(app.multiFileInput.getFiles()[0], '001'); // 上传文件，并设置OBJECT_ID\n *\n * @param {File} file 文件组件的值\n * @param {String} OBJECT_ID 文件标识\n * @return {Number} 0全部通过校验，1至少有一个文件大小未通过校验，2至少有一个文件类型未通过校验。\n */\napp.uploadFile = function(file, OBJECT_ID) {\n  var name = file.name;\n  var size = file.size;\n  Wb.ajax({\n    url: 'm?xwl=aml_monitor/workflow_v8pro/prs01/datasource/uploadFile&xaction=upload',\n    async: false,\n    params: { content: file, size: size, name: name.slice(0, name.lastIndexOf('.')), extension: name.split('.').lastItem, OBJECT_ID: OBJECT_ID },\n    success(resp) {\n    }\n  });\n};\n\nvar files = app.multiFileInput.getFiles();\nif(files) {\n  var fileVerify = app.verifyFiles({ filesList: files, acceptTypeList: ['txt', 'rar', 'zip', 'doc', 'docx', 'pdf'], acceptSize: 20971520 });\n  if(fileVerify === 1) { Wb.toast('校验到有文件的大小超过20MB,请确认后再上传。'); return; }\n  if(fileVerify === 2) { Wb.toast('校验到有文件的类型不在rar zip doc docx pdf的范围中,请确认后再上传。'); return; }\n  for(var i = 0; i < files.length; i++) {\n    app.uploadFile(files[i], '_$UPLOADFILE_ID$_');\n  }\n  app.fileGrid.reload();\n  app.multiFileInput.reset();\n} else {\n  // 没有选择文件\n  Wb.toast('请先选择文件后，再点击上传文件按钮。');\n}"}}],"properties":{"layout":"row","border":"false","margin":"0.5em","gap":"1em","justifySelf":"center","cid":"toolBarPanel"}},{"_icon":"label","text":"label2","cls":"Wb.Label","properties":{"margin":"0 0 0.5em 9em","color":"#999999","fontSize":"0.7em","text":"支持格式：.rar .zip .doc .docx .pdf，单个文件不能超过20MB","cid":"label2"}},{"hasDupCid":0,"_icon":"search-file","_expanded":true,"text":"multiFileInput","cls":"Wb.FileInput","properties":{"browseMode":"true","multiple":"true","browseHeight":"6em","cid":"multiFileInput","accept":".txt,.rar,.zip,.doc,.docx,.pdf"}}],"properties":{"border":"false","padding":"1em 1em 0 1em","cid":"filePanel"}},{"_icon":"panel","_expanded":true,"text":"infoOptPanel","cls":"Wb.Panel","items":[{"hasDupCid":1,"_icon":"container","_expanded":false,"text":"title","cls":"Wb.Container","properties":{"padding":"0.5em 0","html":"<div style=\"display: flex;align-items: center;\">\n  <div style=\"display: inline-block;width: 3px; height: 1.2em;background-color: rgb(39, 119, 252);\"></div>\n  <div style=\"display: inline-block;color: rgb(39, 119, 252);margin-left: 0.5em;\">处理方式</div>\n</div>","cid":"title"}},{"hasDupCid":0,"_icon":"radios","_expanded":true,"text":"DEAL_WAY","cls":"Wb.RadioGroup","items":[{"hasDupCid":0,"_icon":"check2","text":"radio1","cls":"Wb.Radio","properties":{"label":"信息修正并同步给其他部门","cid":"radio1"},"events":{"change":"if(value) {\n  app.I_DEAL_WAY.setValue('0');\n}"}},{"hasDupCid":0,"_icon":"check2","text":"radio2","cls":"Wb.Radio","properties":{"visible":"true","label":"采取限制措施","cid":"radio2"},"events":{"change":"if(value) {\n  app.I_DEAL_WAY.setValue('1');\n}"}},{"hasDupCid":0,"_icon":"check2","_expanded":true,"text":"radio3","cls":"Wb.Radio","properties":{"visible":"true","label":"提交至信息技术部修改数据","cid":"radio3"},"events":{"change":"if(value) {\n  app.I_DEAL_WAY.setValue('2');\n}"}},{"hasDupCid":0,"_icon":"check2","text":"radio4","cls":"Wb.Radio","properties":{"visible":"false","label":"信息归档","cid":"radio4"},"events":{"change":"if(value) {\n  app.I_DEAL_WAY.setValue('3');\n}"}}],"properties":{"value":"''","required":"true","cid":"DEAL_WAY"}}],"properties":{"border":"false","padding":"1em 1em 0 1em","cid":"infoOptPanel"}},{"_icon":"panel","_expanded":false,"text":"commentPanel","cls":"Wb.Panel","items":[{"hasDupCid":1,"_icon":"container","_expanded":true,"text":"title","cls":"Wb.Container","properties":{"padding":"0.5em 0","html":"<div style=\"display: flex;align-items: center;\">\n  <div style=\"display: inline-block;width: 3px; height: 1.2em;background-color: rgb(39, 119, 252);\"></div>\n  <div style=\"display: inline-block;color: rgb(39, 119, 252);margin-left: 0.5em;\">审查意见与处理说明</div>\n</div>","cid":"title"}},{"hasDupCid":0,"_icon":"textarea","text":"REMARK","cls":"Wb.TextArea","properties":{"margin":"0.5em 0 0","readonly":"false","autoResize":"true","rows":"5","required":"true","cid":"REMARK"}}],"properties":{"border":"false","padding":"1em 1em 0 1em","cid":"commentPanel"}},{"_icon":"panel","_expanded":true,"text":"commentHisPanel","cls":"Wb.Panel","items":[{"hasDupCid":1,"_icon":"container","_expanded":false,"text":"title","cls":"Wb.Container","properties":{"padding":"0.5em 0","html":"<div style=\"display: flex;align-items: center;\">\n  <div style=\"display: inline-block;width: 3px; height: 1.2em;background-color: rgb(39, 119, 252);\"></div>\n  <div style=\"display: inline-block;color: rgb(39, 119, 252);margin-left: 0.5em;\">历史审查意见</div>\n</div>","cid":"title"}},{"hasDupCid":0,"_icon":"grid","_expanded":false,"text":"commentHisGrid","cls":"Wb.Grid","items":[{"hasDupCid":1,"_icon":"array","_expanded":true,"text":"columns","cls":"Wb.Array","items":[{"hasDupCid":0,"_icon":"column","text":"PROCESS_STEP_NAME","cls":"Wb.Column","properties":{"fieldName":"PROCESS_STEP_NAME","text":"审核节点","autoWrap":"pre-wrap","align":"center","cid":"PROCESS_STEP_NAME","titleAlign":"center"}},{"hasDupCid":0,"_icon":"column","text":"OP_USER","cls":"Wb.Column","properties":{"fieldName":"OP_USER","text":"审核人员","autoWrap":"pre-wrap","align":"center","cid":"OP_USER","titleAlign":"center"}},{"hasDupCid":0,"_icon":"column","text":"OP_FLAG_NAME","cls":"Wb.Column","properties":{"fieldName":"OP_FLAG_NAME","text":"处理方式","autoWrap":"pre-wrap","align":"center","cid":"OP_FLAG_NAME","titleAlign":"center"}},{"hasDupCid":0,"_icon":"column","text":"REMARK1","cls":"Wb.Column","properties":{"fieldName":"REMARK","width":"20em","text":"审核意见","autoWrap":"pre-wrap","align":"center","cid":"REMARK1","titleAlign":"center"}},{"hasDupCid":0,"_icon":"column","text":"OP_TIME","cls":"Wb.Column","properties":{"fieldName":"OP_TIME","text":"审核时间","autoWrap":"pre-wrap","align":"center","cid":"OP_TIME","titleAlign":"center"}}],"properties":{"cid":"columns"}}],"properties":{"visible":"false","pagingBar":"true","fontSize":"0.9em","url":"m?xwl=aml_monitor/workflow_v8pro/prs01/datasource/getCommentHis","cid":"commentHisGrid"},"events":{"beforeload":"params.PROCESS_ID = '_$PROCESS_ID$_'","success":"if(response.items.length > 0) { \n  parent.setVisible(true);\n  app.commentHisGrid.setVisible(true);\n  app.commentHisPanel.setVisible(true);\n  var dealWayList = response.items.filter(i => i.DEAL_WAY == 0 || i.DEAL_WAY == 1 || i.DEAL_WAY == 2);\n  if(dealWayList.length > 0) {\n    app.DEAL_WAY.setValue(Number(dealWayList[dealWayList.length - 1].DEAL_WAY));\n    app.I_DEAL_WAY.setValue(Number(dealWayList[dealWayList.length - 1].DEAL_WAY));\n  } else {\n    app.DEAL_WAY.setValue(-1);\n    app.I_DEAL_WAY.setValue('');\n  }\n} else {\n  parent.setVisible(false);\n  app.commentHisGrid.setVisible(false);\n  app.commentHisPanel.setVisible(false);\n}"}}],"properties":{"border":"false","padding":"1em 1em 0 1em","visible":"false","cid":"commentHisPanel"}}],"properties":{"padding":"1em 0 2em","autoScroll":"true","cid":"frmPanel","height":"calc(100% - 38px)"}}],"properties":{"minHeight":"30em","visible":"true","maximized":"true","width":"93em","minWidth":"80em","title":"_$title$_","cid":"main","height":"80%","maximizable":"true"},"events":{"ready":"Wb.apply(app, {\n  onLoad() {\n    app.procSql = \"{call AMLDATA.P_FLW_DWM_CIF_CDI_CHECK_COMMENTS({?PROCESS_ID?},{?PROCESS_STEP?},{?OP_FLAG?},{?UPLOADFILE_ID?},{?I_DEAL_WAY?},{?REMARK?},{?sys.username?},{?UNIQUE_ID?},{?I_CLIENT_NAME?},{?BRANCH_NO?},{?FLOW_DEPT?},{?I_ID_TYPE?},{?I_ID_NO?},{?I_ID_BEGINDATE?},{?I_ID_ENDDATE?},{?I_ID_ADDRESS?},{?I_PROFESSION_CODE?},{?I_INSTREPR_NAME?},{?I_REGISTER_MONEY_TYPE?},{?I_REGISTER_FUND?},{?I_BUSI_SCOPE?},{?@O_RETURN_MSG?},{?@integer.O_RETURN_CODE?})\";\n    // 个人户表单内容\n    if('_$ORGAN_FLAG$_' == '0') {\n      app.baseInfo_GR.setVisible(true); // 基本信息\n      app.relation_GR.setVisible(true); // 客户业务关系\n      app.compare_GR.setVisible(true); // 身份信息比对结果\n      app.newBaseInfoPanel_GR.setVisible(true); // 核查后有效身份信息\n\n      for(var i=0; i < app.newBaseInfo_GR.items.length; i++) { app.newBaseInfo_GR.items[i].required = false; }\n\n    }\n    // 机构户表单内容\n    if('_$ORGAN_FLAG$_' == '1') {\n      app.baseInfo_JG.setVisible(true); // 基本信息\n      app.legalPerson_JG.setVisible(true); // 法定代表人或负责人\n      app.relation_JG.setVisible(true); // 客户业务关系\n      app.compare_JG.setVisible(true); // 身份信息比对结果\n      app.newBaseInfoPanel_JG.setVisible(true); // 核查后有效身份信息\n\n      for(var i=0; i < app.newBaseInfo_JG.items.length; i++) { app.newBaseInfo_JG.items[i].required = false; }\n\n    }\n    // 个人户 身份信息比对动态表格\n    app.initDynamicGRTable = function(compare_GR_data) {\n      var compare_GR_columns = [\n        {rowNum: true},\n        { text: \"业务日期\", fieldName: \"BUSI_DATE\", typeName: \"VARCHAR2\", width: \"7.5em\", titleAlign: 'center', align: 'center' },\n        { text: \"比对字段\", fieldName: \"COLUMNS\", typeName: \"VARCHAR2\", width: \"10.4em\", titleAlign: 'center', align: 'center' },\n      ];\n      var addColumns = compare_GR_data.map(i => { return { text: i.BRANCH_NAME, fieldName: i.CLIENT_ID, typeName: \"VARCHAR2\", width: \"15em\", autoWrap: 'pre-wrap', titleAlign: 'center', align: 'center' }; });\n      compare_GR_columns = compare_GR_columns.concat(addColumns);\n      compare_GR_columns.push({ text: \"比对结果\", fieldName: \"RESULT\", typeName: \"VARCHAR2\", width: \"8em\", titleAlign: 'center', align: 'center', \n        freeze: addColumns.length >= 5 ? true : false,\n        render(value, data, column, el){\n          if(value) {\n            el.insertCellIcon('succ', '一致');\n          } else { \n            el.insertCellIcon('warn', '不一致');\n            // el.addEl({cname: \"iconView\", icon: \"warn\", iconColor: \"red\"});\n          }\n        }\n      });\n      app.compare_GR_grid.columns = compare_GR_columns;\n      console.log(compare_GR_data);\n      var compare_GR_grid_data = [\n        { BUSI_DATE: compare_GR_data[0].BUSI_DATE, RESULT: true, COLUMNS: '客户姓名', COLUMN_PROP: 'CLIENT_NAME'  },\n        { BUSI_DATE: compare_GR_data[0].BUSI_DATE, RESULT: true, COLUMNS: '证件类型', COLUMN_PROP: 'ID_TYPE_NAME'  },\n        { BUSI_DATE: compare_GR_data[0].BUSI_DATE, RESULT: true, COLUMNS: '职业', COLUMN_PROP: 'PROFESSION_CODE_NAME'  },\n        { BUSI_DATE: compare_GR_data[0].BUSI_DATE, RESULT: true, COLUMNS: '证件有效期', COLUMN_PROP: 'ID_TIME'  },\n        { BUSI_DATE: compare_GR_data[0].BUSI_DATE, RESULT: true, COLUMNS: '证件地址', COLUMN_PROP: 'ID_ADDRESS'  },\n      ];\n      for(var columnIndex = 0; columnIndex < addColumns.length; columnIndex++) {\n        var columnItem = addColumns[columnIndex];\n        for(var dataIndex = 0; dataIndex < compare_GR_grid_data.length; dataIndex++) {\n          var prop = compare_GR_grid_data[dataIndex].COLUMN_PROP;\n          compare_GR_grid_data[dataIndex][columnItem.fieldName] = compare_GR_data[columnIndex][prop] || '';\n          if(compare_GR_grid_data[dataIndex].RESULT && compare_GR_data[0][prop] !== compare_GR_data[columnIndex][prop]) { \n            compare_GR_grid_data[dataIndex].RESULT = false;\n          }\n        }\n      }\n      app.compare_GR_grid.data = compare_GR_grid_data;\n    };\n    // 机构户 身份信息比对动态表格\n    app.initDynamicJGTable = function(compare_JG_data, compare_JG_grid_data) {\n      var compare_JG_columns = [\n        {rowNum: true},\n        { text: \"业务日期\", fieldName: \"BUSI_DATE\", typeName: \"VARCHAR2\", width: \"7.5em\", titleAlign: 'center', align: 'center' },\n        { text: \"比对字段\", fieldName: \"COLUMNS\", typeName: \"VARCHAR2\", width: \"10.4em\", titleAlign: 'center', align: 'center' },\n      ];\n      var addColumns = compare_JG_data.map(i => { return { text: i.BRANCH_NAME, fieldName: i.CLIENT_ID, typeName: \"VARCHAR2\", autoWrap: 'pre-wrap', width: \"15em\", titleAlign: 'center', align: 'center' }; });\n      compare_JG_columns = compare_JG_columns.concat(addColumns);\n      compare_JG_columns.push({ text: \"工商信息\", fieldName: \"MONITOR_FILED_CONTENT_BUSINESS\", typeName: \"VARCHAR2\", autoWrap: 'pre-wrap', width: \"15em\", titleAlign: 'center', align: 'center' });\n      compare_JG_columns.push({ text: \"比对结果\", fieldName: \"CHECK_RESULT\", typeName: \"VARCHAR2\", width: \"8em\", titleAlign: 'center', align: 'center', \n        freeze: addColumns.length >= 4 ? true : false,\n        render(value, data, column, el){\n          if(value == '一致') {\n            el.insertCellIcon('succ', '一致');\n          } else { \n            el.insertCellIcon('warn', '不一致');\n            // el.addEl({cname: \"iconView\", icon: \"warn\", iconColor: \"red\"});\n          }\n        }\n      });\n      app.compare_JG_grid.columns = compare_JG_columns;\n      console.log(compare_JG_data);\n      // var compare_JG_grid_data = [\n      //   { BUSI_DATE: compare_JG_data[0].BUSI_DATE, RESULT: true, COLUMNS: '客户姓名', COLUMN_PROP: 'CLIENT_NAME'  },\n      //   { BUSI_DATE: compare_JG_data[0].BUSI_DATE, RESULT: true, COLUMNS: '证件类型', COLUMN_PROP: 'ID_TYPE_NAME'  },\n      //   { BUSI_DATE: compare_JG_data[0].BUSI_DATE, RESULT: true, COLUMNS: '注册资本', COLUMN_PROP: 'REGISTER_FUND'  },\n      //   { BUSI_DATE: compare_JG_data[0].BUSI_DATE, RESULT: true, COLUMNS: '证件有效期', COLUMN_PROP: 'ID_TIME'  },\n      //   { BUSI_DATE: compare_JG_data[0].BUSI_DATE, RESULT: true, COLUMNS: '证件地址', COLUMN_PROP: 'ID_ADDRESS'  },\n      //   { BUSI_DATE: compare_JG_data[0].BUSI_DATE, RESULT: true, COLUMNS: '联系方式', COLUMN_PROP: 'MOBILE'  },\n      //   { BUSI_DATE: compare_JG_data[0].BUSI_DATE, RESULT: true, COLUMNS: '注册资本币种', COLUMN_PROP: 'REGISTER_MONEY_TYPE_NAME'  },\n      //   { BUSI_DATE: compare_JG_data[0].BUSI_DATE, RESULT: true, COLUMNS: '法人代表人姓名', COLUMN_PROP: 'LEGAL_NAME'  },\n      // ];\n      for(var columnIndex = 0; columnIndex < addColumns.length; columnIndex++) {\n        var columnItem = addColumns[columnIndex];\n        for(var dataIndex = 0; dataIndex < compare_JG_grid_data.length; dataIndex++) {\n          var prop = compare_JG_grid_data[dataIndex].COLUMN_PROP;\n          compare_JG_grid_data[dataIndex][columnItem.fieldName] = compare_JG_data[columnIndex][prop] || '';\n          // 每一列信息都和工商信息做比对\n          if(compare_JG_grid_data[dataIndex].RESULT && compare_JG_data[0].MONITOR_FILED_CONTENT_BUSINESS !== compare_JG_data[columnIndex][prop]) { \n            compare_JG_grid_data[dataIndex].RESULT = false;\n          }\n        }\n      }\n      app.compare_JG_grid.data = compare_JG_grid_data;\n    };\n  }\n});"}},{"_icon":"window","_expanded":false,"text":"transferWin","cls":"Wb.Window","items":[{"hasDupCid":0,"_icon":"panel","_expanded":true,"text":"panel4","cls":"Wb.Panel","items":[{"hasDupCid":0,"_icon":"toolbar","_expanded":true,"text":"tbar","cls":"Wb.Toolbar","items":[{"_icon":"text","_expanded":true,"text":"inputUserName","cls":"Wb.Text","properties":{"placeholder":"查询用户","cid":"inputUserName"}},{"_icon":"button","text":"button1","cls":"Wb.Button","properties":{"text":"查询","cid":"button1"},"events":{"click":"app.userListGrid.reload({\n  params: {\n    inputUserName: app.inputUserName.getValue()\n  }\n});"}}],"properties":{"layout":"row","gap":"true","cid":"tbar"}},{"hasDupCid":0,"_icon":"grid","_expanded":true,"text":"userListGrid","cls":"Wb.Grid","items":[{"hasDupCid":1,"_icon":"array","_expanded":true,"text":"columns","cls":"Wb.Array","items":[{"hasDupCid":1,"_icon":"column","text":"USER_ID","cls":"Wb.Column","properties":{"fieldName":"USER_ID","visible":"false","text":"用户ID","autoWrap":"pre-wrap","align":"center","cid":"USER_ID","titleAlign":"center"}},{"hasDupCid":1,"_icon":"column","text":"USER_NAME","cls":"Wb.Column","properties":{"fieldName":"USER_NAME","width":"-1","text":"用户名","autoWrap":"pre-wrap","align":"center","cid":"USER_NAME","titleAlign":"center"}}],"properties":{"cid":"columns"}}],"properties":{"visible":"true","flex":"1","pagingBar":"true","autoLoad":"true","fontSize":"0.9em","url":"m?xwl=aml_monitor/workflow_v8pro/prs01/datasource/select_transfer_user","cid":"userListGrid","height":"'90%'"},"events":{"beforeload":"// params.PROCESS_ID = '_$PROCESS_ID$_'","success":"// if(response.items.length > 0) { \n//   parent.setVisible(true);\n//   app.commentHisGrid.setVisible(true);\n//   app.commentHisPanel.setVisible(true);\n//   app.DEAL_WAY.setValue(Number(response.items[response.items.length - 1].DEAL_WAY));\n// } else {\n//   parent.setVisible(false);\n//   app.commentHisGrid.setVisible(false);\n//   app.commentHisPanel.setVisible(false);\n// }"}}],"properties":{"margin":"24px 0px 24px 24px","flex":"1","title":"转办可选人员","cid":"panel4"}},{"hasDupCid":0,"_icon":"container","_expanded":true,"text":"container2","cls":"Wb.Container","items":[{"_icon":"button","_expanded":true,"text":"confirmBtn1","cls":"Wb.Button","properties":{"icon":"right2","iconAlign":"right","text":"添加","type":"primary","cid":"confirmBtn1"},"events":{"click":"var data = app.userListGrid.selectionData;\nif(data) {\n  if(app.selectedUserList.filter(i=>i.USER_ID === data.USER_ID).length > 0) { Wb.toast('该用户已被添加，请勿重复选择');return; }\n  app.selectedUserList.push(data);\n  app.selectedUserListGrid.data = app.selectedUserList;\n}"}},{"_icon":"button","text":"cansolefirmBtn","cls":"Wb.Button","properties":{"icon":"left2","iconAlign":"left","text":"取消","cid":"cansolefirmBtn"},"events":{"click":"var data = app.selectedUserListGrid.selectionData;\nif(data) {\n  app.selectedUserList = app.selectedUserList.filter(i => i.USER_ID !== data.USER_ID);\n  app.selectedUserListGrid.data = app.selectedUserList;\n}"}}],"properties":{"layout":"column","alignSelf":"center","gap":"true","width":"120px","align":"center","cid":"container2"}},{"hasDupCid":0,"_icon":"panel","_expanded":false,"text":"panel1","cls":"Wb.Panel","items":[{"hasDupCid":0,"_icon":"grid","_expanded":true,"text":"selectedUserListGrid","cls":"Wb.Grid","items":[{"hasDupCid":1,"_icon":"array","_expanded":true,"text":"columns","cls":"Wb.Array","items":[{"hasDupCid":1,"_icon":"column","text":"USER_ID","cls":"Wb.Column","properties":{"fieldName":"USER_ID","visible":"false","text":"用户ID","autoWrap":"pre-wrap","align":"center","cid":"USER_ID","titleAlign":"center"}},{"hasDupCid":1,"_icon":"column","text":"USER_NAME","cls":"Wb.Column","properties":{"fieldName":"USER_NAME","width":"-1","text":"用户名","autoWrap":"pre-wrap","align":"center","cid":"USER_NAME","titleAlign":"center"}}],"properties":{"cid":"columns"}}],"properties":{"visible":"true","flex":"1","pagingBar":"true","autoLoad":"true","fontSize":"0.9em","cid":"selectedUserListGrid","height":"'90%'"},"events":{"ready":"app.selectedUserList = [];"}}],"properties":{"margin":"24px 24px 24px 0px","flex":"1","title":"已选转办人员列表","cid":"panel1"}}],"properties":{"layout":"row","dialog":"true","visible":"false","cid":"transferWin","maximizable":"null","height":"50em"},"events":{"ok":"Wb.request({\n  url: 'm?xwl=aml_monitor/workflow_v8pro/prs01/datasource/insert_user',\n  params: {\n    PROCESS_ID: '_$xprocessid$_',\n    I_USER_IDS: app.selectedUserListGrid.data.map(i=>i.USER_ID).join(',')\n  },\n  success: function(res) {\n    app.transferWin.hide();\n  }\n});"}}],"inframe":false,"properties":{"serverScript":"Wb.apply(app, {\n  beforeAction(action, flow) {\n    Wb.log(action);\n    Wb.log(flow);\n    Wb.log('beforeAction');\n  },\n  afterAction(action, flow) {Wb.log(action);\n    Wb.log(flow);\n    Wb.log('afterAction');\n  },\n});\n\nvar mainRouteId = Wb.get('xMainRouteId');\nif (mainRouteId) {\n  Wb.set({\n    subRouteId: Wb.get('flowInstId'),\n    mainRouteId: Wb.get('PROCESS_ID')\n  });\n} else {\n  Wb.set({\n    subRouteId: '',\n    mainRouteId: Wb.get('PROCESS_ID')\n  });\n}\n\nvar upload_id=Wb.getId();\n\nWb.set({\n  PROCESS_STEP: '101',   //和后台规定写死数据\n  xprocessid:Wb.get('xprocessid'),//子流程id（一人一户，主子流程和Wb.get('PROCESS_ID')相同，一人多户不同，）\n  PROCESS_ID:Wb.get('PROCESS_ID') || Wb.get('xprocessid'),//主流程id\n  UPLOADFILE_ID: Wb.get('xprocessid')+'101'+upload_id,  //上传附件ID 流程id+PROCESS_STEP+随机ID\n  CLIENT_ID:Wb.get('CLIENT_ID'),\n  ORGAN_FLAG:Wb.get('ORGAN_FLAG'),\n  UNIQUE_ID:Wb.get('UNIQUE_ID'),\n  BRANCH_NO:Wb.get('BRANCH_NO'),\n  PK_IDS:Wb.get('PK_IDS'),\n  FLOW_DEPT:Wb.get('FLOW_DEPT'),  //责任方\n  CLIENT_IDS:Wb.get('CLIENT_IDS'),\n  ETL_DATE:Wb.get('ETL_DATE'),  //业务日期\n});\n//没有营业部的值取责任方\nvar BRANCH_NO = Wb.get('BRANCH_NO');\nif(BRANCH_NO){\n  Wb.set({\n    BRANCH_NO: Wb.get('BRANCH_NO'),\n  });\n}else{\n  Wb.set({\n    BRANCH_NO: Wb.get('FLOW_DEPT'),\n  });\n}","cid":"module"},"events":{"initialize":"Wb.apply(app, {\n  autoShow: true,\n  beforSubmit() {\n    if(app.I_DEAL_WAY.getValue() == -1) {\n      app.I_DEAL_WAY.setValue('');\n    }\n    if(app.multiFileInput.getFiles() !== null) {\n      Wb.info('检测到有文件未上传，请点击上传文件按钮');\n      return false;\n    }\n    return true;\n  },\n  beforeTransfer() {\n    if(app.I_DEAL_WAY.getValue() == -1) {\n      app.I_DEAL_WAY.setValue('');\n    }\n    if(app.selectedUserList.length == 0) { app.transferWin.show(); return false;}\n    else {\n      return true;\n    }\n  }\n});"},"pageLink":""}