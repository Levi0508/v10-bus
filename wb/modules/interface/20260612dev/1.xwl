{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"var a = [\n    {\n        \"ROLE_ID\": \"test260617\",\n        \"ROLE_NAME\": \"临时清单测试\",\n        \"REMARK\": \"20260617测试\"\n    },\n    {\n        \"ROLE_ID\": \"fxqrhjc\",\n        \"ROLE_NAME\": \"反洗钱人行检查角色\",\n        \"REMARK\": \"反洗钱人行检查角色\"\n    },\n    {\n        \"ROLE_ID\": \"fxqwh-th\",\n        \"ROLE_NAME\": \"反洗钱参数维护-投行\",\n        \"REMARK\": \"负责维护参数字段，如国家地区等\"\n    },\n    {\n        \"ROLE_ID\": \"fxqtb-th\",\n        \"ROLE_NAME\": \"反洗钱填报-投行合规人员\",\n        \"REMARK\": \"投行部具有反洗钱填报权限的合规业务人员\"\n    },\n    {\n        \"ROLE_ID\": \"fxqcustexport\",\n        \"ROLE_NAME\": \"反洗钱客户导出查询角色-孔娟娟\",\n        \"REMARK\": \"反洗钱客户导出查询角色-孔娟娟\"\n    },\n    {\n        \"ROLE_ID\": \"FXQKHTB\",\n        \"ROLE_NAME\": \"反洗钱查询客户维护人角色\",\n        \"REMARK\": \"查询所有反洗钱客户维护人员\"\n    },\n    {\n        \"ROLE_ID\": \"fxqgl_sh\",\n        \"ROLE_NAME\": \"反洗钱管理-审核角色\",\n        \"REMARK\": \"具有反洗钱管理菜单审核按钮权限的人员\"\n    },\n    {\n        \"ROLE_ID\": \"fxqgl\",\n        \"ROLE_NAME\": \"反洗钱管理角色\",\n        \"REMARK\": \"具有反洗钱客户管理功能权限\"\n    },\n    {\n        \"ROLE_ID\": \"fxqrisk-th\",\n        \"ROLE_NAME\": \"反洗钱风险核查-投行\",\n        \"REMARK\": \"具有查看反洗钱客户风险登记及筛查结果权限的人员（前提具有反洗钱客户维护或管理权限）\"\n    },\n    {\n        \"ROLE_ID\": \"bus-hg\",\n        \"ROLE_NAME\": \"合规业务人员\",\n        \"REMARK\": \"拥有合规功能数据查询及操作权限\"\n    },\n    {\n        \"ROLE_ID\": \"qdcx-hg\",\n        \"ROLE_NAME\": \"合规管理清单列表查询角色\",\n        \"REMARK\": \"可点击我管理的清单列表，查看所有清单数据\"\n    },\n    {\n        \"ROLE_ID\": \"xzqddccx-hg\",\n        \"ROLE_NAME\": \"合规限制清单导出查询角色\",\n        \"REMARK\": \"查询限制清单所有关联证券，导出使用\"\n    },\n    {\n        \"ROLE_ID\": \"basic\",\n        \"ROLE_NAME\": \"基本\",\n        \"REMARK\": \"只具有最基本功能的角色。\"\n    },\n    {\n        \"ROLE_ID\": \"developer\",\n        \"ROLE_NAME\": \"开发人员\",\n        \"REMARK\": \"具有开发相关模块的使用权限。\"\n    },\n    {\n        \"ROLE_ID\": \"bus-th\",\n        \"ROLE_NAME\": \"投行业务角色\",\n        \"REMARK\": \"投行业务角色\"\n    },\n    {\n        \"ROLE_ID\": \"thhgz\",\n        \"ROLE_NAME\": \"投行合规组\",\n        \"REMARK\": \"投行合规组人员，具有所有投行项目信息查询权限\"\n    },\n    {\n        \"ROLE_ID\": \"admin-th\",\n        \"ROLE_NAME\": \"投行管理员角色\",\n        \"REMARK\": \"拥有所有业务功能及数据权限\"\n    },\n    {\n        \"ROLE_ID\": \"hhhh\",\n        \"ROLE_NAME\": \"查询角色\",\n        \"REMARK\": \"辅导辅导\"\n    },\n    {\n        \"ROLE_ID\": \"flhgb\",\n        \"ROLE_NAME\": \"法律合规部\",\n        \"REMARK\": \"法律合规部指定人员，具有所有投行项目信息查询权限\"\n    },\n    {\n        \"ROLE_ID\": \"eee\",\n        \"ROLE_NAME\": \"清单查询权限\",\n        \"REMARK\": \"清单查询功能\"\n    },\n    {\n        \"ROLE_ID\": \"QDGLJS\",\n        \"ROLE_NAME\": \"清单管理角色\",\n        \"REMARK\": \"清单栏目权限\"\n    },\n    {\n        \"ROLE_ID\": \"demo\",\n        \"ROLE_NAME\": \"演示\",\n        \"REMARK\": \"只具有查看功能，不能对数据进行修改。\"\n    },\n    {\n        \"ROLE_ID\": \"admin\",\n        \"ROLE_NAME\": \"管理员\",\n        \"REMARK\": \"拥有对系统进行完全访问的所有权限。\"\n    },\n    {\n        \"ROLE_ID\": \"admin-prv\",\n        \"ROLE_NAME\": \"系统权限管理员\",\n        \"REMARK\": \"具有角色及用户账户管理权限\"\n    },\n    {\n        \"ROLE_ID\": \"mail_zyzs\",\n        \"ROLE_NAME\": \"自营做市清单邮件\",\n        \"REMARK\": \"自营做市清单邮件接收人员\"\n    },\n    {\n        \"ROLE_ID\": \"zy_mail_recv\",\n        \"ROLE_NAME\": \"自营大额持仓清单邮件接收人\",\n        \"REMARK\": \"自营大额持仓清单邮件接收人\"\n    },\n    {\n        \"ROLE_ID\": \"projlist_o\",\n        \"ROLE_NAME\": \"观察清单查询角色\",\n        \"REMARK\": \"只能查看处于“入观察清单”状态的项目清单信息；此角色优先作用于数据权限，用户即使属于其他查看全部清单权限的角色，也无法生效\"\n    },\n    {\n        \"ROLE_ID\": \"manager\",\n        \"ROLE_NAME\": \"负责人\",\n        \"REMARK\": \"用户所在部门的负责人。\"\n    },\n    {\n        \"ROLE_ID\": \"rl2_mail_recv\",\n        \"ROLE_NAME\": \"限制清单变动邮件接收人\",\n        \"REMARK\": \"限制清单变动邮件接收人\"\n    },\n    {\n        \"ROLE_ID\": \"projlist_l\",\n        \"ROLE_NAME\": \"限制清单查询角色\",\n        \"REMARK\": \"只能查看处于“入限制清单”状态的项目清单信息；此角色优先作用于数据权限，用户即使属于其他查看全部清单权限的角色，也无法生效\"\n    },\n    {\n        \"ROLE_ID\": \"rl_mail_recv\",\n        \"ROLE_NAME\": \"限制清单邮件接收人\",\n        \"REMARK\": \"限制清单邮件接收人\"\n    },\n    {\n        \"ROLE_ID\": \"llb\",\n        \"ROLE_NAME\": \"静默期\",\n        \"REMARK\": \"查询静默期信息权限\"\n    },\n    {\n        \"ROLE_ID\": \"projlist_q\",\n        \"ROLE_NAME\": \"静默期查询角色\",\n        \"REMARK\": \"只能查看处于“入静默期”状态的项目清单信息；此角色优先作用于数据权限，用户即使属于其他查看全部清单权限的角色，也无法生效\"\n    },\n    {\n        \"ROLE_ID\": \"rq_mail_recv\",\n        \"ROLE_NAME\": \"静默期邮件接收人\",\n        \"REMARK\": \"静默期邮件接收人\"\n    }\n];\n\nfor(var i = 0; i < a.length; i++) {\n  var sql = `update wb_role set remark = {?REMARK?} WHERE ROLE_NAME = {?ROLE_NAME?}`;\n  Wb.sql({\n    sql: sql,\n    params: { REMARK: a[i].REMARK, ROLE_NAME: a[i].ROLE_NAME  }\n  })\n}"},"_icon":"module"}