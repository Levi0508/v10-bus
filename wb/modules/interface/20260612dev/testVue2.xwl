{"pkId":"2ad418a325b64d79ac386ce3710a07ab","isDefaultRole":false,"roles":{"admin":1},"icon":"","_expanded":true,"cls":"Wb.Module","title":"","hideInMenu":"false","_icon":"module","systemType":"v8pro","text":"module","lastModified":1781270731750,"items":[{"_icon":"panel","text":"ComponentSearchBoxPanel","cls":"Wb.Panel","properties":{"visible":"false","html":"<style>\n  .search-section {\n    display: flex;\n    justify-content: space-between;\n    align-items: flex-start;\n    margin-bottom: 20px;\n    padding-bottom: 16px;\n    border-bottom: 1px solid #ebeef5;\n  }\n\n  .search-left {\n    flex: 1;\n  }\n\n  .search-right {\n    flex-shrink: 0;\n    margin-left: 20px;\n    white-space: nowrap;\n    padding-top: 4px;\n  }\n</style>\n\n<div id=\"search-box\">\n  <div class=\"search-section\">\n    <div class=\"search-left\">\n      <el-form :model=\"queryForm\" inline>\n        <el-form-item label=\"客户号\">\n          <el-input v-model=\"queryForm.customerNo\" placeholder=\"请输入客户号\" clearable />\n        </el-form-item>\n        <el-form-item label=\"客户名称\">\n          <el-input v-model=\"queryForm.customerName\" placeholder=\"请输入客户名称\" clearable />\n        </el-form-item>\n      </el-form>\n    </div>\n    <div class=\"search-right\">\n      <el-button type=\"primary\" icon=\"el-icon-search\" @click=\"handleQuery\">查询</el-button>\n      <el-button icon=\"el-icon-refresh\" @click=\"handleReset\">重置</el-button>\n    </div>\n  </div>\n</div>","cid":"ComponentSearchBoxPanel"},"events":{"ready":"/**\n * app.components.SearchBox 查询条件组件\n * \n * 功能 提供查询和重置按钮\n * \n * @events\n *  search  - 点击查询按钮时触发 向外传递当前查询对象\n *  reset   - 点击重置按钮时触发 清空表单后向外传递重置后的查询条件对象\n */\nif (!app.components) { app.components = {}; }\napp.components.SearchBox = {\n  template: this.app.ComponentSearchBoxPanel.bodyEl.query('#search-box'),\n  props: {\n    message: { type: String, default: '11122233344' }\n  },\n  data: function () {\n    return {\n      queryForm: {\n        customerNo: '',\n        customerName: ''\n      }\n    };\n  },\n  methods: {\n    handleQuery() {\n      this.$emit('search', { ...this.queryForm })\n    },\n    handleReset() {\n      this.queryForm = {\n        customerNo: '',\n        customerName: ''\n      }\n      this.$emit('reset', { ...this.queryForm })\n    }\n  }\n};"}},{"_icon":"panel","text":"ComponentTableBoxPanel","cls":"Wb.Panel","properties":{"visible":"false","html":"<style>\n  #table-box {\n    width: 100%;\n  }\n\n</style>\n\n<div id=\"table-box\">\n  <div class=\"customer-table\">\n    <!-- 表格 -->\n    <el-table ref=\"table\" :data=\"tableData\" border stripe style=\"width: 100%\" v-loading=\"loading\" :height=\"tableHeight\">\n      <el-table-column type=\"index\" label=\"序号\" width=\"60\"></el-table-column>\n      <el-table-column prop=\"customerNo\" label=\"客户号\" width=\"120\"></el-table-column>\n      <el-table-column prop=\"customerName\" label=\"客户名称\" width=\"150\"></el-table-column>\n      <el-table-column prop=\"phone\" label=\"联系电话\" width=\"120\"></el-table-column>\n      <el-table-column prop=\"address\" label=\"地址\" width=\"200\"></el-table-column>\n      <el-table-column prop=\"createTime\" label=\"创建时间\" width=\"160\"></el-table-column>\n      <el-table-column label=\"操作\" width=\"200\">\n        <template slot-scope=\"scope\">\n          <el-button type=\"text\" size=\"small\" @click=\"$emit('detail', scope.row)\">详情</el-button>\n          <el-button type=\"text\" size=\"small\" @click=\"$emit('edit', scope.row)\">编辑</el-button>\n          <el-button type=\"text\" size=\"small\" style=\"color: #f56c6c\" @click=\"$emit('delete', scope.row)\">删除</el-button>\n        </template>\n      </el-table-column>\n    </el-table>\n\n    <!-- 分页 -->\n    <div ref=\"paginationWrap\" class=\"pagination-section\">\n      <el-pagination :current-page=\"pagination.pageNum\" :page-sizes=\"pageSizes\" :page-size=\"pagination.pageSize\"\n        :total=\"pagination.total\" layout=\"total, sizes, prev, pager, next, jumper\" @size-change=\"handleSizeChange\"\n        @current-change=\"handleCurrentChange\" />\n    </div>\n  </div>\n</div>","cid":"ComponentTableBoxPanel"},"events":{"ready":"/**\n * app.components.TableBox - 客户表格与分页组件\n *\n * 功能：渲染客户数据表格，支持加载状态、固定操作列，以及底部分页条\n *       表格高度自动撑满父容器剩余空间，窗口 resize 时自适应\n *\n * @props\n *   tableData  {Array}   表格数据源，默认 []\n *   loading    {Boolean} 表格加载状态，默认 false\n *   pagination {Object}  分页参数 { pageNum, pageSize, total }，默认 { pageNum:1, pageSize:10, total:0 }\n *   pageSizes  {Array}   每页条数选项，默认 [10, 20, 50, 100]\n *\n * @events\n *   size-change     - 切换每页条数时触发，参数：新条数\n *   current-change  - 切换页码时触发，参数：新页码\n *   detail          - 点击详情按钮时触发，参数：当前行数据\n *   edit            - 点击编辑按钮时触发，参数：当前行数据\n *   delete          - 点击删除按钮时触发，参数：当前行数据\n *\n * @refs\n *   table          - el-table 实例，可调用 doLayout() 强制刷新布局\n *   paginationWrap - 分页栏容器 DOM，用于计算表格高度\n */\nif (!app.components) { app.components = {}; }\napp.components.TableBox = {\n  template: this.app.ComponentTableBoxPanel.bodyEl.query('#table-box'),\n  props: {\n    // 表格数据\n    tableData: {\n      type: Array,\n      default: () => []\n    },\n    // 加载状态\n    loading: {\n      type: Boolean,\n      default: false\n    },\n    // 分页参数\n    pagination: {\n      type: Object,\n      default: () => ({\n        pageNum: 1,\n        pageSize: 10,\n        total: 0\n      })\n    },\n    // 每页条数选项\n    pageSizes: {\n      type: Array,\n      default: () => [10, 20, 50, 100]\n    }\n  },\n  data: function () {\n    return {\n      tableHeight: 500\n    };\n  },\n  mounted() {\n    var that = this;\n    that.calcTableHeight();\n    \n  },\n  methods: {\n    calcTableHeight() {\n      var that = this;\n      that.$nextTick(() => {\n        const el = that.$el;\n        if (!el) return\n        const containerHeight = el.clientHeight;\n        const paginationEl = that.$refs.paginationWrap;\n        const paginationHeight = paginationEl ? paginationEl.offsetHeight : 52;\n        that.tableHeight = containerHeight - paginationHeight - 16; // 表格可用高度 = 容器总高度 - 分页栏高度\n      })\n    },\n    handleSizeChange(val) {\n      this.$emit('size-change', val)\n    },\n    handleCurrentChange(val) {\n      this.$emit('current-change', val)\n    }\n  }\n};"}},{"_icon":"viewport","_expanded":true,"text":"viewport1","cls":"Wb.Viewport","properties":{"html":"<style>\n  #app_$randomStr$_ {\n    width: 100%;\n    height: 100%;\n    box-sizing: border-box;\n    overflow-y: scroll;\n  }\n\n  #app_$randomStr$_>.container {\n    width: 100%;\n    height: 100%;\n    max-Width: 1200px;\n    min-width: 640px;\n    margin: 0 auto;\n    padding: 0 16px;\n\n    display: flex;\n    flex-direction: column;\n  }\n\n  #app_$randomStr$_>.container .center-box {\n    flex: 1;\n  }\n</style>\n\n<div id=\"app_$randomStr$_\">\n  <div class=\"container\">\n    <search-box @search=\"handleSearch\" @reset=\"handleReset\" class=\"search-box\"></search-box>\n\n    <table-box :table-data=\"tableData\" :loading=\"loading\" :pagination=\"pagination\" @size-change=\"handleSizeChange\"\n      @current-change=\"handleCurrentChange\" @detail=\"handleDetail\" @edit=\"handleEdit\" @delete=\"handleDelete\" class=\"center-box\">\n    </table-box>\n\n  </div>\n</div>","cid":"viewport1"},"events":{"ready":"app.vm = new Vue({\n  el: this.bodyEl.query('#app_$randomStr$_'),\n  components:{\n    'search-box': app.components.SearchBox,\n    'table-box': app.components.TableBox\n  },\n  watch:{\n\n  },\n  data:function(){\n    return {\n      loading: false,\n      queryParams: {\n        customerNo: '',\n        customerName: ''\n      },\n      tableData: [],\n      pagination: {\n        pageNum: 1,\n        pageSize: 10,\n        total: 0\n      }\n    };\n  },\n  computed: {\n    \n  },\n  methods: {\n    handleSearch(params) {\n      this.queryParams = params\n      this.pagination.pageNum = 1\n      this.fetchTableData()\n    },\n    handleReset(params) {\n      this.queryParams = params\n      this.pagination.pageNum = 1\n      this.fetchTableData()\n    },\n    handleSizeChange(val) {\n      this.pagination.pageSize = val\n      this.pagination.pageNum = 1\n      this.fetchTableData()\n    },\n    handleCurrentChange(val) {\n      this.pagination.pageNum = val\n      this.fetchTableData()\n    },\n    fetchTableData() {\n      this.loading = true\n      const params = {\n        ...this.queryParams,\n        pageNum: this.pagination.pageNum,\n        pageSize: this.pagination.pageSize\n      }\n      console.log('请求参数：', params)\n      // TODO: 替换为实际接口\n      setTimeout(() => {\n        this.tableData = [\n          { customerNo: 'C001', customerName: '张三科技公司', phone: '13800001111', address: '北京市朝阳区xxx路1号', createTime: '2024-01-15 10:30:00' },\n          { customerNo: 'C002', customerName: '李四贸易公司', phone: '13800002222', address: '上海市浦东新区xxx路2号', createTime: '2024-02-20 14:20:00' },\n          { customerNo: 'C003', customerName: '王五实业集团', phone: '13800003333', address: '广州市天河区xxx路3号', createTime: '2024-03-10 09:15:00' }\n        ]\n        this.pagination.total = 30\n        this.loading = false\n      }, 500)\n    },\n    handleDetail(row) {\n      console.log('查看详情', row)\n    },\n    handleEdit(row) {\n      console.log('编辑', row)\n    },\n    handleDelete(row) {\n      this.$confirm('确定删除该客户吗？', '提示', { type: 'warning' })\n        .then(() => {\n          console.log('删除', row)\n          this.$message.success('删除成功')\n          this.fetchTableData()\n        })\n        .catch(() => {})\n    }\n\n  }\n});\n"}}],"inframe":false,"properties":{"serverScript":"Wb.set(\"randomStr\", String(java.lang.System.currentTimeMillis()));","links":"[\n  \"wb/vue/vue.js\",\n  'wb/vue/element.js',\n  'wb/vue/element.css',\n  xpath + '/../testVue2'\n]","cid":"module"},"pageLink":""}