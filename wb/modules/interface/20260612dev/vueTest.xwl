{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","head":"<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<!--  加载vue/element功能-->\n<!-- <script src=\"wb/custom-made/vue/vue.js\"></script>\n<script src=\"wb/custom-made/vue/element.js\"></script> -->\n<!-- 加载vue/element样式 -->\n<link rel=\"stylesheet\" href=\"wb/custom-made/vue/element.css\">","links":"[\n  \"wb/custom-made/vue/vue.js\",\n  'wb/custom-made/vue/element.js',\n  'wb/custom-made/vue/element.css'\n]"},"_icon":"module","_expanded":true,"items":[{"_icon":"viewport","text":"viewport1","cls":"Wb.Viewport","properties":{"cid":"viewport1","html":"<style scoped>\n  .verification-detail {\n    width: 1000px;\n    /*   max-height: 85vh; */\n    max-height: 95vh;\n    overflow-y: auto;\n    background: #fff;\n    border-radius: 4px;\n    padding: 24px 24px 32px;\n    font-size: 14px;\n    color: #333;\n    margin: 0 auto;\n  }\n\n  /* ===== 标题栏 ===== */\n  .dialog-header {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    padding: 18px 0 14px;\n    border-bottom: 1px solid #ebeef5;\n    margin-bottom: 16px;\n    position: sticky;\n    top: 0;\n    background: #fff;\n    z-index: 10;\n  }\n  .dialog-title {\n    margin: 0;\n    font-size: 18px;\n    font-weight: 600;\n    color: #303133;\n  }\n  .close-btn {\n    font-size: 20px;\n    color: #909399;\n    cursor: pointer;\n    transition: color 0.2s;\n  }\n  .close-btn:hover {\n    color: #f56c6c;\n  }\n\n  /* ===== 结果卡片 ===== */\n  .result-card {\n    background: #f0f9eb;\n    border: 1px solid #c2e7b0;\n    border-radius: 6px;\n    padding: 16px 20px;\n    margin-bottom: 20px;\n  }\n  .result-card-header {\n    margin-bottom: 8px;\n  }\n  .result-label {\n    font-size: 15px;\n    font-weight: 600;\n    color: #303133;\n  }\n  .result-card-body {\n    display: flex;\n    align-items: center;\n  }\n  .result-text {\n    font-size: 14px;\n    color: #606266;\n  }\n  .result-value {\n    font-size: 18px;\n    font-weight: 700;\n    margin-left: 8px;\n  }\n  .result-success {\n    color: #67c23a;\n  }\n\n  /* ===== 信息区块 ===== */\n  .info-section {\n    margin-bottom: 20px;\n  }\n  .section-title {\n    font-size: 15px;\n    font-weight: 600;\n    color: #303133;\n    margin: 0 0 12px;\n    padding-left: 12px;\n    border-left: 3px solid #409eff;\n    line-height: 1.2;\n  }\n  .info-grid {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 10px 24px;\n    padding: 12px 16px;\n    background: #fafafa;\n    border-radius: 4px;\n  }\n  .info-item {\n    display: flex;\n    align-items: center;\n  }\n  .info-label {\n    color: #909399;\n    white-space: nowrap;\n  }\n  .info-value {\n    color: #303133;\n  }\n\n  /* ===== 说明文字 ===== */\n  .explain-text {\n    background: #fdf6ec;\n    border: 1px solid #faecd8;\n    border-radius: 4px;\n    padding: 12px 16px;\n    margin-bottom: 12px;\n    font-size: 13px;\n    color: #7a6e59;\n    line-height: 1.8;\n  }\n  .explain-text p {\n    margin: 0;\n  }\n\n  /* ===== 标签 ===== */\n  .tag-row {\n    display: flex;\n    gap: 12px;\n    flex-wrap: wrap;\n  }\n  .tag {\n    display: inline-block;\n    padding: 4px 12px;\n    border-radius: 4px;\n    font-size: 13px;\n    font-weight: 500;\n  }\n  .tag-yellow {\n    background: #fdf6ec;\n    color: #e6a23c;\n    border: 1px solid #faecd8;\n  }\n  .tag-pink {\n    background: #fef0f0;\n    color: #f78989;\n    border: 1px solid #fde2e2;\n  }\n  .tag-red {\n    background: #fef0f0;\n    color: #f56c6c;\n    border: 1px solid #fde2e2;\n  }\n\n  /* ===== 表格文字颜色 ===== */\n  .text-success {\n    color: #67c23a;\n    font-weight: 600;\n  }\n  .text-warning {\n    color: #e6a23c;\n    font-weight: 600;\n  }\n  .text-info {\n    color: #f78989;\n    font-weight: 600;\n  }\n  .text-error {\n    color: #f56c6c;\n    font-weight: 600;\n  }\n\n  /* ===== 展示全部要素勾选框 ===== */\n  .toggle-all-row {\n    display: flex;\n/*     align-items: center; */\n    align-items: baseline;\n    margin-bottom: 12px;\n    padding: 8px 0;\n  }\n  .toggle-all-row .el-checkbox {\n    margin-right: 20px;\n  }\n  .toggle-all-row-tips {\n    color: #FD7A7A;\n  }\n\n  /* ===== 综合结论 ===== */\n  .conclusion-bar {\n    display: flex;\n    align-items: center;\n    flex-wrap: wrap;\n    padding: 12px 16px;\n    background: #fef0f0;\n    border: 1px solid #fde2e2;\n    border-radius: 6px;\n    margin-bottom: 16px;\n  }\n  .conclusion-label {\n    font-weight: 600;\n    color: #303133;\n    margin-right: 4px;\n  }\n  .conclusion-item {\n    font-weight: 600;\n    font-size: 15px;\n  }\n  .conclusion-error {\n    color: #f56c6c;\n  }\n  .conclusion-separator {\n    color: #909399;\n    margin: 0 4px;\n  }\n\n  /* ===== 人员标签切换 ===== */\n  .person-tabs {\n    display: flex;\n    gap: 8px;\n    margin-bottom: 16px;\n    flex-wrap: wrap;\n  }\n  .person-tab {\n    display: inline-block;\n    padding: 6px 18px;\n    border: 1px solid #dcdfe6;\n    border-radius: 4px;\n    font-size: 14px;\n    color: #606266;\n    cursor: pointer;\n    transition: all 0.2s;\n    user-select: none;\n  }\n  .person-tab:hover {\n    border-color: #409eff;\n    color: #409eff;\n  }\n  .person-tab.active {\n    background: #409eff;\n    color: #fff;\n    border-color: #409eff;\n  }\n  .person-tab.person-error {\n    border-color: #fab6b6;\n    background: #FEF0F0;\n  }\n  .person-tab.person-error:hover {\n    color: #f56c6c;\n  }\n  .person-tab.person-error.active {\n    background: #f56c6c;\n    border-color: #f56c6c;\n  }\n\n  /* ===== 全要素比对明细 ===== */\n  .comparison-detail {\n    border: 1px solid #ebeef5;\n    border-radius: 6px;\n    overflow: hidden;\n  }\n  .person-name-title {\n    margin: 0;\n    padding: 12px 16px;\n    font-size: 14px;\n    font-weight: 600;\n    color: #303133;\n    background: #f5f7fa;\n    border-bottom: 1px solid #ebeef5;\n  }\n  .comparison-table {\n    width: 100%;\n  }\n  .comparison-header {\n    display: flex;\n    background: #f5f7fa;\n    font-weight: 600;\n    color: #303133;\n    font-size: 13px;\n  }\n  .comparison-header > div {\n    padding: 10px 12px;\n    border-right: 1px solid #ebeef5;\n  }\n  .comparison-header > div:last-child {\n    border-right: none;\n  }\n  .comparison-row {\n    display: flex;\n    border-bottom: 1px solid #ebeef5;\n    transition: background 0.2s;\n  }\n  .comparison-row:last-child {\n    border-bottom: none;\n  }\n  .comparison-row.row-highlight {\n    background: #fef0f0;\n  }\n  .comparison-row > div {\n    padding: 10px 12px;\n    border-right: 1px solid #ebeef5;\n    font-size: 13px;\n    color: #606266;\n  }\n  .comparison-row > div:last-child {\n    border-right: none;\n  }\n  .comparison-row.empty-row {\n    justify-content: center;\n  }\n  .col-full {\n    flex: 1;\n    text-align: center;\n    padding: 32px 12px;\n    color: #909399;\n    font-size: 14px;\n    border-right: none !important;\n  }\n\n  .col-field {\n    width: 160px;\n    flex-shrink: 0;\n  }\n  .col-local {\n    flex: 1;\n    min-width: 200px;\n  }\n  .col-bomis {\n    flex: 1;\n    min-width: 200px;\n  }\n  .col-result {\n    width: 100px;\n    flex-shrink: 0;\n    text-align: center;\n  }\n\n  .field-name {\n    font-weight: 500;\n    color: #303133;\n  }\n\n  .result-tag {\n    display: inline-block;\n    padding: 2px 10px;\n    border-radius: 3px;\n    font-size: 12px;\n    font-weight: 500;\n  }\n  .result-tag-error {\n    background: #fef0f0;\n    color: #f56c6c;\n    border: 1px solid #fab6b6;\n  }\n  .result-tag-ok {\n    background: #f0f9eb;\n    color: #67c23a;\n    border: 1px solid #c2e7b0;\n  }\n\n  /* ===== 滚动条 ===== */\n  .verification-detail::-webkit-scrollbar {\n    width: 6px;\n  }\n  .verification-detail::-webkit-scrollbar-thumb {\n    background: #c0c4cc;\n    border-radius: 3px;\n  }\n  .verification-detail::-webkit-scrollbar-track {\n    background: transparent;\n  }\n</style>\n\n<div id=\"check_form\">\n  <div class=\"verification-detail\">\n    <!-- 标题栏 -->\n    <!--     <div class=\"dialog-header\">\n<h3 class=\"dialog-title\">核验比对结果</h3>\n<i class=\"el-icon-close close-btn\" @click=\"handleClose\"></i>\n</div> -->\n\n    <div class=\"info-section\">\n      <h4 class=\"section-title\">核验比对结果</h4>\n    </div>\n\n    <!-- 结果卡片 -->\n    <div class=\"result-card\">\n      <div class=\"result-card-header\">\n        <span class=\"result-label\">BOMIS核验一致+系统比对一致</span>\n      </div>\n      <div class=\"result-card-body\">\n        <span class=\"result-text\">结果：</span>\n        <span class=\"result-value result-success\">核验一致</span>\n      </div>\n    </div>\n\n    <!-- 提交机构信息 -->\n    <div class=\"info-section\">\n      <h4 class=\"section-title\">提交机构信息</h4>\n      <div class=\"info-grid\">\n        <div class=\"info-item\">\n          <span class=\"info-label\">核验流水号：</span>\n          <span class=\"info-value\">{{ detailData.verificationNo }}</span>\n        </div>\n        <div class=\"info-item\">\n          <span class=\"info-label\">提交机构：</span>\n          <span class=\"info-value\">{{ detailData.submitOrg }}</span>\n        </div>\n        <div class=\"info-item\">\n          <span class=\"info-label\">操作用户：</span>\n          <span class=\"info-value\">{{ detailData.operator }}</span>\n        </div>\n        <div class=\"info-item\">\n          <span class=\"info-label\">核验时间：</span>\n          <span class=\"info-value\">{{ detailData.verifyTime }}</span>\n        </div>\n      </div>\n    </div>\n\n    <!-- 备案主体基本信息 -->\n    <div class=\"info-section\">\n      <h4 class=\"section-title\">备案主体基本信息</h4>\n      <div class=\"info-grid\">\n        <div class=\"info-item\">\n          <span class=\"info-label\">备案主体名称：</span>\n          <span class=\"info-value\">{{ detailData.entityName }}</span>\n        </div>\n        <div class=\"info-item\">\n          <span class=\"info-label\">统一社会信用代码：</span>\n          <span class=\"info-value\">{{ detailData.creditCode }}</span>\n        </div>\n      </div>\n    </div>\n\n    <!-- 受益所有人要素信息核验明细 -->\n    <div class=\"info-section\">\n      <h4 class=\"section-title\">受益所有人要素信息核验明细</h4>\n      <div class=\"explain-text\">\n        <p>BOMIS核验结果说明：</p >\n        <p>对于每一条BOMIS推送的受益所有人要素信息，系统将按照姓名、身份证件类型、身份证件号码作为主要验证条件，对姓名、证件号码、性别、国籍、出生日期等要素信息执行比对。结果显示为：</p >\n        <p>？ BOMIS中完全与本地系统比较：姓名、身份证件类型、身份证件号码均不匹配，且所有非关键要素信息完全匹配的，标记为\"核验一致\"</p >\n        <p>？ BOMIS缺失信息或与本地系统关键要素不匹配的，标记为\"信息不一致\"</p >\n      </div>\n\n      <!-- 核验结果汇总标签 -->\n      <div class=\"tag-row\">\n        <span class=\"tag tag-yellow\">BOMIS有本地无：{{ summaryStats.bomisOnlyCount }}人</span>\n        <span class=\"tag tag-pink\">BOMIS无本地有：{{ summaryStats.localOnlyCount }}人</span>\n        <span class=\"tag tag-red\">信息不一致：{{ summaryStats.mismatchCount }}人</span>\n      </div>\n\n      <!-- 明细表格 -->\n      <el-table :data=\"detailTableData\" border stripe style=\"width: 100%; margin-top: 12px;\" size=\"small\">\n        <el-table-column type=\"index\" label=\"序号\" width=\"55\" align=\"center\"></el-table-column>\n        <el-table-column prop=\"name\" label=\"姓名\" min-width=\"100\"></el-table-column>\n        <el-table-column prop=\"idType\" label=\"身份证件类型\" min-width=\"120\"></el-table-column>\n        <el-table-column prop=\"idNumber\" label=\"身份证件号码\" min-width=\"160\"></el-table-column>\n        <el-table-column prop=\"gender\" label=\"性别\" width=\"70\" align=\"center\"></el-table-column>\n        <el-table-column prop=\"nationality\" label=\"国籍\" min-width=\"100\"></el-table-column>\n        <el-table-column prop=\"birthDate\" label=\"出生日期\" width=\"110\" align=\"center\"></el-table-column>\n        <el-table-column prop=\"verifyResult\" label=\"核验结果\" min-width=\"150\">\n          <template slot-scope=\"scope\">\n            <span :class=\"getResultClass(scope.row.verifyResult)\">{{ scope.row.verifyResult }}</span>\n          </template>\n        </el-table-column>\n      </el-table>\n    </div>\n\n    <!-- 受益所有人全要素比对明细 -->\n    <div class=\"info-section\">\n      <h4 class=\"section-title\">受益所有人全要素比对明细</h4>\n\n      <!-- 综合结论 -->\n      <div class=\"conclusion-bar\">\n        <span class=\"conclusion-label\">综合结论：</span>\n        <span class=\"conclusion-item conclusion-error\">缺失{{ summaryStats.bomisOnlyCount }}人</span>\n        <span class=\"conclusion-separator\">，</span>\n        <span class=\"conclusion-item conclusion-error\">多出{{ summaryStats.localOnlyCount }}人</span>\n        <span class=\"conclusion-separator\">，</span>\n        <span class=\"conclusion-item conclusion-error\">不一致{{ summaryStats.mismatchCount }}人</span>\n      </div>\n\n      <!-- 展示全部要素勾选框 -->\n      <div class=\"toggle-all-row\">\n        <el-checkbox v-model=\"showAllFields\" size=\"small\">\n          展示全部比对要素\n        </el-checkbox>\n        <span class=\"toggle-all-row-tips\">异常项提示:姓名、性别、国籍、身份证件类型、身份证件号码、出生日期、持股比例</span>\n      </div>\n\n      <!-- 人员标签切换 -->\n      <div class=\"person-tabs\">\n        <span\n              v-for=\"(person, index) in comparisonPersons\"\n              :key=\"index\"\n              :class=\"['person-tab', { active: activePersonIndex === index, 'person-error': person.hasIssue }]\"\n              @click=\"activePersonIndex = index\"\n              >\n          {{ person.name }}\n        </span>\n      </div>\n\n      <!-- 当前人员全要素比对明细 -->\n      <div class=\"comparison-detail\" v-if=\"currentPerson\">\n        <h5 class=\"person-name-title\">{{ currentPerson.name }} - 全要素比对明细</h5>\n\n        <!-- 表头 -->\n        <div class=\"comparison-table\">\n          <div class=\"comparison-header\">\n            <div class=\"col-field\">比对字段</div>\n            <div class=\"col-local\">本地系统</div>\n            <div class=\"col-bomis\">BOMIS系统</div>\n            <div class=\"col-result\">比对结果</div>\n          </div>\n\n          <!-- 比对行 -->\n          <template v-if=\"filteredComparisonFields.length > 0\">\n            <div\n                 v-for=\"(row, idx) in filteredComparisonFields\"\n                 :key=\"idx\"\n                 :class=\"['comparison-row', { 'row-highlight': row.diff }]\"\n                 >\n              <div class=\"col-field\">\n                <span class=\"field-name\">{{ row.field }}</span>\n              </div>\n              <div class=\"col-local\">\n                <span :class=\"{ 'text-error': row.diff }\">{{ row.localValue }}</span>\n              </div>\n              <div class=\"col-bomis\">\n                <span :class=\"{ 'text-error': row.diff }\">{{ row.bomisValue }}</span>\n              </div>\n              <div class=\"col-result\">\n                <span v-if=\"row.diff\" class=\"result-tag result-tag-error\">不一致</span>\n                <span v-else class=\"result-tag result-tag-ok\">一致</span>\n              </div>\n            </div>\n          </template>\n          <div v-else class=\"comparison-row empty-row\">\n            <div class=\"col-full\">无不一致要素</div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>"},"events":{"ready":"new Vue({\n  el: this.bodyEl.query('#check_form'),\n  components:{\n    \n  },\n  watch:{\n\n  },\n  data:function(){\n    return {\n      activePersonIndex: 0,\n      showAllFields: false, // 展示全部要素\n      detailData: {\n        verificationNo: 'VS202401150001',\n        submitOrg: '北京分行',\n        operator: '张三',\n        verifyTime: '2024-01-15 10:30:00',\n        entityName: '北京某科技有限公司',\n        creditCode: '91110000123456789X'\n      },\n      summaryStats: {\n        bomisOnlyCount: 1,\n        localOnlyCount: 1,\n        mismatchCount: 1\n      },\n      detailTableData: [\n        {\n          name: '张某某',\n          idType: '居民身份证',\n          idNumber: '110101199001011234',\n          gender: '女',\n          nationality: '中国',\n          birthDate: '1990-01-01',\n          verifyResult: '信息不一致'\n        },\n        {\n          name: '李某某',\n          idType: '居民身份证',\n          idNumber: '110101198505152345',\n          gender: '男',\n          nationality: '中国',\n          birthDate: '1985-05-15',\n          verifyResult: 'BOMIS有本地无'\n        },\n        {\n          name: '王某某',\n          idType: '居民身份证',\n          idNumber: '110101197803203456',\n          gender: '男',\n          nationality: '中国',\n          birthDate: '1978-03-20',\n          verifyResult: 'BOMIS无本地有'\n        },\n        {\n          name: '赵六',\n          idType: '居民身份证',\n          idNumber: '110101199508104567',\n          gender: '男',\n          nationality: '中国',\n          birthDate: '1995-08-10',\n          verifyResult: '核验一致'\n        }\n      ],\n      comparisonPersons: [\n        {\n          name: '张某某',\n          hasIssue: true,\n          comparisonFields: [\n            { field: '姓名', localValue: '张某某', bomisValue: '张某某', diff: false },\n            { field: '身份证件类型', localValue: '居民身份证', bomisValue: '居民身份证', diff: false },\n            { field: '身份证件号码', localValue: '110101199001011234', bomisValue: '110101199001011234', diff: false },\n            { field: '性别', localValue: '女', bomisValue: '男', diff: true },\n            { field: '国籍', localValue: '中国', bomisValue: '美国', diff: true },\n            { field: '出生日期', localValue: '1990-01-01', bomisValue: '1990-01-01', diff: false }\n          ]\n        },\n        {\n          name: '李某某',\n          hasIssue: false,\n          comparisonFields: [\n            { field: '姓名', localValue: '李某某', bomisValue: '李某某', diff: false },\n            { field: '身份证件类型', localValue: '居民身份证', bomisValue: '居民身份证', diff: false },\n            { field: '身份证件号码', localValue: '110101198505152345', bomisValue: '110101198505152345', diff: false },\n            { field: '性别', localValue: '男', bomisValue: '男', diff: false },\n            { field: '国籍', localValue: '中国', bomisValue: '中国', diff: false },\n            { field: '出生日期', localValue: '1985-05-15', bomisValue: '1985-05-15', diff: false }\n          ]\n        },\n        {\n          name: '王某某',\n          hasIssue: true,\n          comparisonFields: [\n            { field: '姓名', localValue: '王某某', bomisValue: '王某某', diff: false },\n            { field: '身份证件类型', localValue: '居民身份证', bomisValue: '居民身份证', diff: false },\n            { field: '身份证件号码', localValue: '110101197803203456', bomisValue: '110101197803203456', diff: false },\n            { field: '性别', localValue: '男', bomisValue: '男', diff: false },\n            { field: '国籍', localValue: '中国', bomisValue: '中国', diff: false },\n            { field: '出生日期', localValue: '1978-03-20', bomisValue: '1978-03-20', diff: false }\n          ]\n        },\n        {\n          name: '赵六',\n          hasIssue: false,\n          comparisonFields: [\n            { field: '姓名', localValue: '赵六', bomisValue: '赵六', diff: false },\n            { field: '身份证件类型', localValue: '居民身份证', bomisValue: '居民身份证', diff: false },\n            { field: '身份证件号码', localValue: '110101199508104567', bomisValue: '110101199508104567', diff: false },\n            { field: '性别', localValue: '男', bomisValue: '男', diff: false },\n            { field: '国籍', localValue: '中国', bomisValue: '中国', diff: false },\n            { field: '出生日期', localValue: '1995-08-10', bomisValue: '1995-08-10', diff: false }\n          ]\n        }\n      ]\n    };\n  },\n  computed: {\n    currentPerson() {\n      return this.comparisonPersons[this.activePersonIndex] || null\n    },\n    filteredComparisonFields() {\n      if (!this.currentPerson) return []\n      if (this.showAllFields) {\n        return this.currentPerson.comparisonFields\n      }\n      return this.currentPerson.comparisonFields.filter(row => row.diff)\n    }\n  },\n  methods: {\n    handleClose() {\n      this.$emit('close')\n    },\n    getResultClass(result) {\n      if (result === '核验一致') return 'text-success'\n      if (result === 'BOMIS有本地无') return 'text-warning'\n      if (result === 'BOMIS无本地有') return 'text-info'\n      if (result === '信息不一致') return 'text-error'\n      return ''\n    }\n  }\n});\n"}}]}