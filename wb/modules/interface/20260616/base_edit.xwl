{"title":"客户信息编辑","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","links":"[\n  \"wb/custom-made/js/prs01.js\",\n  \"wb/libs/exportPdf/html2canvas.js\",\n  \"wb/libs/exportPdf/jspdf.debug.js\"\n]"},"_icon":"module","_expanded":true,"events":{"initialize":"let rules = getRules();// 主表单填写规则\nlet rules1 = getRules1();// 关联人弹窗填写规则（因与主表单有同名字段需区分开）\nlet forms = getRuleForm();\nlet directory = getDirConfig();\nlet selectKey = getSelectKey();\n\n// 定义全局变量\nlet data = {\n  rules: rules,// 表单校验规则\n  rules1: rules1,\n  forms: forms,// 表单\n  list: selectKey.list,\n  dict: selectKey.dict,\n  directory: directory,// 附件目录\n  selectList: {},\n  fileDialogVisible: false,\n  // 客户基本信息\n  basicInfo: {},\n  relatedInfo1: [],// 法定代表人\n  relatedInfo2: [],// 控股股东\n  relatedInfo3: [],// 实际控制人\n  relatedInfo4: [],// 授权代表人\n  relatedInfo5: [],// 受益所有人\n\n}\n\nWb.apply(app, {\n  data: data,\n  loadSelectList(item) {\n    if (!Wb.isEmpty(item.KEY_NAME)) {\n      Wb.ajax({\n        url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/select_key',\n        params: {\n          I_KEY_NAME: item.KEY_NAME\n        },\n        success(resp) {\n          let arr = Wb.decode(resp).items;\n          app.data.selectList[item.BIND_DATA + \"_list\"] = arr;\n        }\n      });\n    }\n  },\n  getDictMap(item) {\n    Wb.ajax({\n      url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/select_dict',\n      params: {\n        I_ENTRY_NO: item.ENTRY_NO\n      },\n      success(resp) {\n        let arr = Wb.decode(resp).items;\n        app.data.selectList[item.BIND_DATA + \"_list\"] = arr;\n      }\n    })\n  },\n  // 页面展示数据字典转换\n  formatDictMap(dictType, key) {\n    const dictData = this.selectList[dictType];\n    const item = dictData.find(item => item.k === key);\n    return item ? item.v : '-';\n  },\n  formatMoneyType(dict, key) {\n    const item = dict.find(item => item.k === key);\n    return item ? item.v : '-';\n  },\n  // 省市区键值转换\n  formatAddress(dict, key) {\n    const item = dict.find(item => item.value === key);\n    return item ? item.label : key;\n  },\n  // 查询客户基本信息\n  getBasicInfo(client_id, data_type) {\n    Wb.ajax({\n      url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/select_basic_info',\n      params: {\n        CLIENT_ID: client_id,\n        DATA_TYPE: data_type\n      },\n      success(resp) {\n        let res = Wb.decode(resp).items;\n        if (res[0]) {\n          app.data.basicInfo = res[0];\n        }\n        console.log(\"客户基本信息resp\", res[0]);\n      }\n    });\n  }\n});\n\n"},"items":[{"_icon":"viewport","text":"viewport1","cls":"Wb.Viewport","properties":{"cid":"viewport1"},"_expanded":true,"events":{"ready":"app.data.list.forEach(item => {\n  app.loadSelectList(item);\n});\n\napp.data.dict.forEach(item => {\n  app.getDictMap(item);\n});\n\n// 编辑正式客户时隐藏“保存”按钮，避免将正式客户变为草稿客户\n// if('_$data_type$_'=='1'||'_$data_type$_'=='正式'){\n//   app.saveBtn1.hide();\n// }\n"},"items":[{"_icon":"tab","text":"tab1","cls":"Wb.Tab","_expanded":true,"properties":{"cid":"tab1","full":"true","border":"false","tabPosition":"top","tabSortable":"false","cls":"tabcls"},"items":[{"_icon":"card","text":"card1","cls":"Wb.Card","properties":{"cid":"card1","title":"客户基本信息维护","closable":"null","layout":"column"},"_expanded":true,"hasDupCid":0,"items":[{"_icon":"toolbar","text":"tbar","cls":"Wb.Toolbar","properties":{"cid":"tbar","gap":"true","padding":"0 0 10px 0"},"_expanded":true,"items":[{"_icon":"right1","text":"fill1","cls":"Wb.Fill","properties":{"cid":"fill1"}},{"_icon":"button","text":"cancelBtn","cls":"Wb.Button","properties":{"cid":"cancelBtn","text":"返回","visible":"false"},"_expanded":true,"events":{"click":"const cid = app.parentApp.parentContainer.cid$;\nWb.open({\n  url: 'm?xwl=aml_monitor/KYC01010/client_preview',\n  params: {\n    CLIENT_ID: '_$client_id$_',\n    ORGAN_FLAG: '_$organ_flag$_',\n    CLIENT_STATUS: '_$client_status$_',\n    CLIENT_NAME: '_$client_name$_',\n    CLIENT_BELONG: '_$client_belong$_',\n    FK_FLAG: '_$fk_flag$_',\n    FLOW_CODE: '1'\n  },\n  title: '客户基本信息预览',\n  success(scope) {\n    //关闭当前预览窗口\n    scope.parentApp[cid].close();\n  }\n});\n"}},{"_icon":"button","text":"saveBtn","cls":"Wb.Button","properties":{"cid":"saveBtn","text":"提交","type":"primary"},"hasDupCid":0,"events":{"click":"// 提交\nconsole.log(\"app.mainContainer.vue.basicInfo\", app.mainContainer.vue.basicInfo);\n\nlet succ = app.mainContainer.vue.submit();// 先校验\nlet fileList1 = app.mainContainer.vue.attachmentList.communication;\nlet fileList2 = app.mainContainer.vue.attachmentList.agree;\nlet fileList3 = app.mainContainer.vue.attachmentList.other;\n\n// 调用投行数据接口\nfunction call_reback(key, certNo) {\n  console.log(\"调用了call_reback,key:\", '_$key$_');\n  Wb.ajax({\n    url: 'm?xwl=interface/customerInfoCheck/call_reback',\n    params: {\n      i_key: key,\n      i_cert_no: certNo,\n      i_usercode: '_$cur_user$_'\n    },\n    success(resp) {\n    }\n  });\n}\n\nif (succ) {\n  // 个人\n  if ('_$organ_flag$_' === '0') {\n    console.log(\"app.mainContainer.vue.ruleForm2\", app.mainContainer.vue.ruleForm2);\n    console.log(\"app.mainContainer.vue.ruleForm3\", app.mainContainer.vue.ruleForm3);\n    let form1 = app.mainContainer.vue.ruleForm2;\n    let form2 = app.mainContainer.vue.ruleForm3;\n    Wb.ajax({\n      url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/update_client',\n      params: {\n        // ruleForm2\n        CLIENT_ID: '_$client_id$_',\n        CLIENT_NAME: form1.client_name,\n        ORGAN_FLAG: '_$organ_flag$_',\n        ID_TYPE: form1.id_type,\n        ID_NO: form1.id_no,\n        ID_BEGINDATE: form1.id_begindate ? String(form1.id_begindate).replace(/\\s.*$/, '') : '',\n        ID_ENDDATE: form1.id_enddate ? String(form1.id_enddate).replace(/\\s.*$/, '') : '',\n        CLIENT_BELONG: ('_$client_belong$_' == '融资端' || '_$client_belong$_' == '1') ? '1' : '2',\n        NATIONALITY: form1.nationality,\n        BIRTHDAY: form1.birthday,\n        INDUSTRY_TYPE: form1.industry_type,\n        INDUSTRY_NAME: form1.industry_name,\n        TEL: form1.tel,\n        IS_OBJECT_REPORT: '工作室主体',//工作室主体/非工作室主体填报（默认为工作室主体）\n        ASSOCIATED_DATE: form1.associated_date,\n        REMARK: form1.remark,\n        CREATE_USER: '_$sys.username$_',\n        CREATE_TIME: '',\n        UPDATE_USER: '_$sys.username$_',\n        UPDATE_TIME: '',\n        WORK_TYPE: '1',// 0创建 1更新 2确认\n        CLIENT_STATUS: app.mainContainer.vue.basicInfo.client_status,// 0正常 1失效 2强限制 3弱限制\n        DATA_STATUS: '1',//'_$data_type$_',// 0草稿 1正式\n        GENDER: form1.gender,\n        INCOME: form1.income,\n        PROFESSION_CODE: form1.profession_code,// 职业分类\n        ID_ADDRESS: form1.id_address,// 证件地址\n        PROVINCE1: app.formatAddress(app.mainContainer.vue.proOptions, form1.province1),\n        CITY1: app.formatAddress(app.mainContainer.vue.cityOptions1, form1.city1),\n        DISTRICT1: app.formatAddress(app.mainContainer.vue.districtOptions1, form1.district1),\n        ADDRESS: form1.address,// 联系地址\n        PROVINCE2: app.formatAddress(app.mainContainer.vue.proOptions, form1.province2),\n        CITY2: app.formatAddress(app.mainContainer.vue.cityOptions2, form1.city2),\n        DISTRICT2: app.formatAddress(app.mainContainer.vue.districtOptions2, form1.district2),\n        // ruleForm3\n        IS_SPECIAL: form2.is_special,\n        CLIENT_TYPE: form2.client_type ? form2.client_type.join(',') : null,\n        CLIENT_TYPE_OTHER: form2.client_type_other,\n        SPECIAL_MATTERS: form2.special_matters ? form2.special_matters.join(',') : null,\n        MISSING_INFORMATION: form2.missing_information,\n        MISSING_DRAFT: form2.missing_draft,\n        SPECIAL_MATTERS_OTHER: form2.special_matters_other,\n        SPECIAL_REASON: form2.special_reason,\n        COMPLETED_CDD: form2.completed_cdd,\n        LOW_RISK_EXPLANATION: form2.low_risk_explanation,\n        TAKE_MEASURES: form2.take_measures,\n        // 反洗钱特殊情况部分附件object_id\n        COMMUNICATION_RECORDS: (fileList1.length > 0) ? ('_$client_id$_' + 'communication') : '',\n        AGREE_RECORDS: (fileList2.length > 0) ? ('_$client_id$_' + 'agree') : '',\n        OTHER_RECORDS: (fileList3.length > 0) ? ('_$client_id$_' + 'other') : '',\n      },\n      success(resp) {\n        let res = Wb.decode(resp);\n        if (res.O_RETURN_CODE === '0') {\n          Wb.tipSucc(\"保存成功\");\n        } else {\n          Wb.tipError(res.O_RETURN_MSG);\n        }\n        // 如果是从工作室打开的填报表的，提交后需要调用工作室接口\n        let key = '_$key$_';\n        if (key) {\n          call_reback('_$key$_', form1.id_no)\n        }\n        app.parentApp.parentContainer.close();\n        // 更新维护人\n      }\n    });\n  } else {\n    // 机构\n    console.log(\"app.mainContainer.vue.ruleForm1\", app.mainContainer.vue.ruleForm1);\n    let form1 = app.mainContainer.vue.ruleForm1;\n    let form2 = app.mainContainer.vue.ruleForm3;\n    Wb.ajax({\n      url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/update_client',\n      params: {\n        CLIENT_ID: '_$client_id$_',\n        CLIENT_NAME: form1.client_name,\n        ORGAN_FLAG: '_$organ_flag$_',\n        ID_TYPE: form1.id_type,\n        ID_NO: form1.id_no,\n        ID_BEGINDATE: form1.id_begindate ? String(form1.id_begindate).replace(/\\s.*$/, '') : '',\n        ID_ENDDATE: form1.id_enddate ? String(form1.id_enddate).replace(/\\s.*$/, '') : '',\n        CLIENT_BELONG: ('_$client_belong$_' == '融资端' || '_$client_belong$_' == '1') ? '1' : '2',\n        OFFICE_ADDRESS: form1.office_address,// 办公地址\n        PROVINCE: app.formatAddress(app.mainContainer.vue.proOptions, form1.province),\n        CITY: app.formatAddress(app.mainContainer.vue.cityOptions, form1.city),\n        DISTRICT: app.formatAddress(app.mainContainer.vue.districtOptions, form1.district),\n        REGISTER_COUNTRY: form1.register_country,\n        REGISTER_MONEY_TYPE: !isNaN(form1.register_money_type.trim()) ? app.formatMoneyType(app.data.selectList.register_money_type_list, form1.register_money_type) : form1.register_money_type,//form1.register_money_type,//!isNaN(form1.register_money_type.trim()) ? app.formatMoneyType(app.data.selectList.register_money_type_list,form1.register_money_type) : form1.register_money_type,\n        REGISTER_FUND: String(form1.register_fund).replace(/,/g, ''),\n        INDUSTRY_TYPE: form1.industry_type,\n        INDUSTRY_NAME: form1.industry_name,\n        TEL: form1.tel,\n        SETUP_DATE: form1.setup_date ? String(form1.setup_date).replace(/\\s.*$/, '') : '',\n        BUSI_SCOPE: form1.busi_scope,\n        IS_OBJECT_REPORT: '工作室主体',// 工作室主体/非主体填报（默认工作室主体）\n        ASSOCIATED_DATE: form1.associated_date,// 建立业务关系日期\n        REMARK: form1.remark,// 备注\n        CREATE_USER: '_$sys.username$_',\n        CREATE_TIME: '',\n        UPDATE_USER: '_$sys.username$_',\n        UPDATE_TIME: '',\n        WORK_TYPE: '1',// 0创建 1更新 2确认\n        CLIENT_STATUS: app.mainContainer.vue.basicInfo.client_status,// 0正常 1失效 2强限制 3弱限制\n        DATA_STATUS: '1',//'_$data_type$_',// 0草稿 1正式\n        // ruleForm3\n        IS_SPECIAL: form2.is_special,\n        CLIENT_TYPE: form2.client_type ? form2.client_type.join(',') : null,\n        CLIENT_TYPE_OTHER: form2.client_type_other,\n        SPECIAL_MATTERS: form2.special_matters ? form2.special_matters.join(',') : null,\n        MISSING_INFORMATION: form2.missing_information,\n        MISSING_DRAFT: form2.missing_draft,\n        SPECIAL_MATTERS_OTHER: form2.special_matters_other,\n        SPECIAL_REASON: form2.special_reason,\n        COMPLETED_CDD: form2.completed_cdd,\n        LOW_RISK_EXPLANATION: form2.low_risk_explanation,\n        TAKE_MEASURES: form2.take_measures,\n        // 反洗钱特殊情况部分附件object_id\n        COMMUNICATION_RECORDS: (fileList1.length > 0) ? ('_$client_id$_' + 'communication') : '',\n        AGREE_RECORDS: (fileList2.length > 0) ? ('_$client_id$_' + 'agree') : '',\n        OTHER_RECORDS: (fileList3.length > 0) ? ('_$client_id$_' + 'other') : '',\n      },\n      success(resp) {\n        let res = Wb.decode(resp);\n        if (res.O_RETURN_CODE === '0') {\n          Wb.tipSucc(\"保存成功\");\n        } else {\n          Wb.tipError(res.O_RETURN_MSG);\n        }\n        // 如果是从工作室打开的填报表的，提交后需要调用工作室接口\n        let key = '_$key$_';\n        console.log(\"key\", '_$key$_');\n        console.log(\"cur_user\", '_$cur_user$_');\n        if (key) {\n          console.log('111')\n          call_reback('_$key$_', form1.id_no)\n        }\n        app.parentApp.parentContainer.close();\n      }\n    });\n  }\n}\n"}},{"_icon":"button","text":"saveBtn1","cls":"Wb.Button","properties":{"cid":"saveBtn1","text":"保存","type":"primary"},"hasDupCid":0,"events":{"click":"// 保存\nconsole.log(\"app.mainContainer.vue.basicInfo\", app.mainContainer.vue.basicInfo);\n// 调用投行数据接口\nfunction call_reback(key, certNo) {\n  Wb.ajax({\n    url: 'm?xwl=interface/customerInfoCheck/call_reback',\n    params: {\n      i_key: key,\n      i_cert_no: certNo,\n      i_usercode: '_$sys.username$_'\n    },\n    success(resp) {\n    }\n  });\n}\n\nlet fileList1 = app.mainContainer.vue.attachmentList.communication;\nlet fileList2 = app.mainContainer.vue.attachmentList.agree;\nlet fileList3 = app.mainContainer.vue.attachmentList.other;\n\n// 个人\nif ('_$organ_flag$_' === '0') {\n  let form1 = app.mainContainer.vue.ruleForm2;\n  let form2 = app.mainContainer.vue.ruleForm3;\n  Wb.ajax({\n    url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/update_client',\n    params: {\n      // ruleForm2\n      CLIENT_ID: '_$client_id$_',\n      CLIENT_NAME: form1.client_name,\n      ORGAN_FLAG: '_$organ_flag$_',\n      ID_TYPE: form1.id_type,\n      ID_NO: form1.id_no,\n      ID_BEGINDATE: form1.id_begindate,\n      ID_ENDDATE: form1.id_enddate,\n      CLIENT_BELONG: ('_$client_belong$_' == '融资端' || '_$client_belong$_' == '1') ? '1' : '2',\n      NATIONALITY: form1.nationality,\n      BIRTHDAY: form1.birthday,\n      INDUSTRY_TYPE: form1.industry_type,\n      INDUSTRY_NAME: form1.industry_name,\n      TEL: form1.tel,\n      IS_OBJECT_REPORT: '工作室主体',//工作室主体/非工作室主体填报（默认为工作室主体）\n      ASSOCIATED_DATE: form1.associated_date,\n      REMARK: form1.remark,\n      CREATE_USER: '_$sys.username$_',\n      CREATE_TIME: '',\n      UPDATE_USER: '_$sys.username$_',\n      UPDATE_TIME: '',\n      WORK_TYPE: '1',// 0创建 1确认 2更新\n      CLIENT_STATUS: app.mainContainer.vue.basicInfo.client_status, //'_$client_status$_',// 0正常 1失效 2强限制 3弱限制\n      DATA_STATUS: '_$data_type$_' || '1',// 0草稿 1正式\n      GENDER: form1.gender,\n      INCOME: form1.income,\n      PROFESSION_CODE: form1.profession_code,// 职业分类\n      ID_ADDRESS: form1.id_address,// 证件地址\n      PROVINCE1: form1.province1 ? app.formatAddress(app.mainContainer.vue.proOptions, form1.province1) : form1.province1,\n      CITY1: form1.city1 ? app.formatAddress(app.mainContainer.vue.cityOptions1, form1.city1) : form1.city1,\n      DISTRICT1: form1.district1 ? app.formatAddress(app.mainContainer.vue.districtOptions1, form1.district1) : form1.district1,\n      ADDRESS: form1.address,// 联系地址\n      PROVINCE2: form1.province2 ? app.formatAddress(app.mainContainer.vue.proOptions, form1.province2) : form1.province2,\n      CITY2: form1.city2 ? app.formatAddress(app.mainContainer.vue.cityOptions2, form1.city2) : form1.city2,\n      DISTRICT2: form1.district2 ? app.formatAddress(app.mainContainer.vue.districtOptions2, form1.district2) : form1.district2,\n      // ruleForm3\n      IS_SPECIAL: form2.is_special,\n      CLIENT_TYPE: form2.client_type ? form2.client_type.join(',') : null,\n      CLIENT_TYPE_OTHER: form2.client_type_other,\n      SPECIAL_MATTERS: form2.special_matters ? form2.special_matters.join(',') : null,\n      MISSING_INFORMATION: form2.missing_information,\n      MISSING_DRAFT: form2.missing_draft,\n      SPECIAL_MATTERS_OTHER: form2.special_matters_other,\n      SPECIAL_REASON: form2.special_reason,\n      COMPLETED_CDD: form2.completed_cdd,\n      LOW_RISK_EXPLANATION: form2.low_risk_explanation,\n      TAKE_MEASURES: form2.take_measures,\n      // 反洗钱特殊情况部分附件object_id\n      COMMUNICATION_RECORDS: (fileList1.length > 0) ? ('_$client_id$_' + 'communication') : '',\n      AGREE_RECORDS: (fileList2.length > 0) ? ('_$client_id$_' + 'agree') : '',\n      OTHER_RECORDS: (fileList3.length > 0) ? ('_$client_id$_' + 'other') : '',\n    },\n    success(scope) {\n      Wb.tipSucc(\"保存成功\");\n      // 如果是从工作室打开的填报表的，提交后需要调用工作室接口\n      let key = '_$key$_';\n      // if (key) {\n      //   call_reback('_$key$_', form1.id_no)\n      // }\n    }\n  });\n} else {\n  // 机构\n  let form1 = app.mainContainer.vue.ruleForm1;\n  let form2 = app.mainContainer.vue.ruleForm3;\n  Wb.ajax({\n    url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/update_client',\n    params: {\n      CLIENT_ID: '_$client_id$_',\n      CLIENT_NAME: form1.client_name,\n      ORGAN_FLAG: '_$organ_flag$_',\n      ID_TYPE: form1.id_type,\n      ID_NO: form1.id_no,\n      ID_BEGINDATE: form1.id_begindate,\n      ID_ENDDATE: form1.id_enddate,\n      CLIENT_BELONG: ('_$client_belong$_' == '融资端' || '_$client_belong$_' == '1') ? '1' : '2',\n      OFFICE_ADDRESS: form1.office_address,// 办公地址\n      PROVINCE: form1.province ? app.formatAddress(app.mainContainer.vue.proOptions, form1.province) : form1.province,\n      CITY: form1.city ? app.formatAddress(app.mainContainer.vue.cityOptions, form1.city) : form1.city,\n      DISTRICT: form1.district ? app.formatAddress(app.mainContainer.vue.districtOptions, form1.district) : form1.district,\n      REGISTER_COUNTRY: form1.register_country,\n      REGISTER_MONEY_TYPE: form1.register_money_type,\n      REGISTER_FUND: form1.register_fund ? String(form1.register_fund).replace(/,/g, '') : form1.register_fund,\n      INDUSTRY_TYPE: form1.industry_type,\n      INDUSTRY_NAME: form1.industry_name,\n      TEL: form1.tel,\n      SETUP_DATE: form1.setup_date,\n      BUSI_SCOPE: form1.busi_scope,\n      IS_OBJECT_REPORT: '工作室主体',// 工作室主体/非主体填报（默认工作室主体）\n      ASSOCIATED_DATE: form1.associated_date,// 建立业务关系日期\n      REMARK: form1.remark,// 备注\n      CREATE_USER: '_$sys.username$_',\n      CREATE_TIME: '',\n      UPDATE_USER: '_$sys.username$_',\n      UPDATE_TIME: '',\n      WORK_TYPE: '1',// 0创建 1更新 2确认\n      CLIENT_STATUS: app.mainContainer.vue.basicInfo.client_status,// 0正常 1失效 2强限制 3弱限制\n      DATA_STATUS: '_$data_type$_' || '1',// 0草稿 1正式\n      // ruleForm3\n      IS_SPECIAL: form2.is_special,\n      CLIENT_TYPE: form2.client_type ? form2.client_type.join(',') : null,\n      CLIENT_TYPE_OTHER: form2.client_type_other,\n      SPECIAL_MATTERS: form2.special_matters ? form2.special_matters.join(',') : null,\n      MISSING_INFORMATION: form2.missing_information,\n      MISSING_DRAFT: form2.missing_draft,\n      SPECIAL_MATTERS_OTHER: form2.special_matters_other,\n      SPECIAL_REASON: form2.special_reason,\n      COMPLETED_CDD: form2.completed_cdd,\n      LOW_RISK_EXPLANATION: form2.low_risk_explanation,\n      TAKE_MEASURES: form2.take_measures,\n      // 反洗钱特殊情况部分附件object_id\n      COMMUNICATION_RECORDS: (fileList1.length > 0) ? ('_$client_id$_' + 'communication') : '',\n      AGREE_RECORDS: (fileList2.length > 0) ? ('_$client_id$_' + 'agree') : '',\n      OTHER_RECORDS: (fileList3.length > 0) ? ('_$client_id$_' + 'other') : '',\n    },\n    success(scope) {\n      Wb.tipSucc(\"保存成功\");\n      // 如果是从工作室打开的填报表的，提交后需要调用工作室接口\n      let key = '_$key$_';\n      // if (key) {\n      //   call_reback('_$key$_', form1.id_no)\n      // }\n    }\n  });\n}"},"_expanded":true},{"_icon":"button","text":"exportBtn","cls":"Wb.Button","properties":{"cid":"exportBtn","text":"PDF导出"},"_expanded":true,"events":{"click":"app.mainContainer.vue.downloadPdf();\n"}}]},{"_icon":"container","text":"mainContainer","cls":"Wb.Container","properties":{"cid":"mainContainer","autoScroll":"true","layout":"fit","html":"<div id=\"cus_page\" style=\"height:100%\">\n  <div class=\"main-container\" style=\"display:flex\">\n    <div class=\"left-panel\">\n      <el-tabs v-model=\"activeNav\" @tab-click=\"handleClick\" tab-position=\"left\">\n        <el-tab-pane v-for=\"(item, index) in navList\" :label=\"item.label\" :name=\"item.value\"></el-tab-pane>\n      </el-tabs>\n    </div>\n    <div v-if=\"loading\" class=\"right-panel\">\n      <el-loading v-loading=\"loading\" element-loading-text=\"页面加载中，若长时间无响应，请关闭后重试\"\n        element-loading-spinner=\"el-icon-loading\" style=\"display:inline-block;height:100%;width:100%\"></el-loading>\n    </div>\n    <div v-else class=\"right-panel\" @scroll=\"onScroll\" style=\"overflow-y:scroll;\">\n      <p style=\"color:#F56C6C;padding-left:20px;\">\n        注1：证照、身份证等有效期如果为“长期”、“永久”等，请在证照/身份证有效期截止选择“2100-12-31”。<br/>\n        注2：如果没有相关信息需要填写，请留白，不需要填写“不适用”、“无”等字段。\n      </p>\n      <!--客户基本信息-->\n      <el-card class=\"box-card\" :name=\"'basicInfo'+this._uid\">\n        <div slot=\"header\" class=\"clearfix\">\n          <span>客户基本信息</span>\n        </div>\n        <div>\n          <!--个人-->\n          <el-form v-if=\"organ_flag==='0'\" :model=\"ruleForm2\" :rules=\"rules\" ref=\"ruleForm2\" label-position=\"top\"\n            style=\"padding:20px;\" :class=\"{'hide-required-mark': shouldHideRequiredMark}\"\n            :hide-required-asterisk=\"true\">\n            <el-row :gutter=\"20\">\n              <el-col :span=\"8\">\n                <el-form-item prop=\"client_name\" label-position=\"top\">\n                  <template slot=\"label\">\n                    <div style=\"display: flex; align-items: center;\">\n                      <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                        <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>姓名\n                      </div>\n                    </div>\n                  </template>\n                  <el-input size=\"medium\" v-model=\"ruleForm2.client_name\" placeholder=\"请输入客户名称\" readonly />\n                </el-form-item>\n              </el-col>\n              <el-col :span=\"16\">\n                <el-form-item label=\"联系地址\" prop=\"address\">\n                  <template slot=\"label\">\n                    <div style=\"display: flex; align-items: center;\">\n                      <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                        <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>联系地址\n                      </div>\n                    </div>\n                  </template>\n                  <div style=\"display:flex;width:100%;gap:8px;\">\n                    <div style=\"flex:3;display:flex;gap:8px;\">\n                      <el-select size=\"medium\" v-model=\"ruleForm2.province2\" placeholder=\"省\" style=\"flex:1;\"\n                        @change=\"handleProvinceChg('2')\" clearable>\n                        <el-option v-for=\"item in proOptions\" :key=\"item.value\" :label=\"item.label\" :value=\"item.value\">\n                        </el-option>\n                      </el-select>\n                      <el-select size=\"medium\" v-model=\"ruleForm2.city2\" placeholder=\"市\" style=\"flex:1;\"\n                        @change=\"handleCityChg('2')\" clearable>\n                        <el-option v-for=\"item in cityOptions2\" :key=\"item.value\" :label=\"item.label\"\n                          :value=\"item.value\">\n                        </el-option>\n                      </el-select>\n                      <el-select size=\"medium\" v-model=\"ruleForm2.district2\" placeholder=\"区\" style=\"flex:1;\" clearable>\n                        <el-option v-for=\"item in districtOptions2\" :key=\"item.value\" :label=\"item.label\"\n                          :value=\"item.value\">\n                        </el-option>\n                      </el-select>\n                    </div>\n                    <el-input size=\"medium\" v-model=\"ruleForm2.address\" placeholder=\"详细地址\" style=\"flex:2;\"></el-input>\n                  </div>\n                </el-form-item>\n              </el-col>\n            </el-row>\n            <el-row :gutter=\"20\">\n              <el-col :span=\"8\">\n                <el-form-item prop=\"nationality\">\n                  <template slot=\"label\">\n                    <div style=\"display: flex; align-items: center;\">\n                      <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                        <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>国籍\n                      </div>\n                    </div>\n                  </template>\n                  <el-select size=\"medium\" v-model=\"ruleForm2.nationality\" placeholder=\"请选择\">\n                    <el-option v-for=\"item in selectList.nationality_list\" :key=\"item.k\" :label=\"item.v\"\n                      :value=\"item.k\">\n                    </el-option>\n                  </el-select>\n                </el-form-item>\n              </el-col>\n              <el-col :span=\"8\">\n                <el-form-item prop=\"gender\">\n                  <template slot=\"label\">\n                    <div style=\"display: flex; align-items: center;\">\n                      <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                        <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>性别\n                      </div>\n                    </div>\n                  </template>\n                  <el-select size=\"medium\" v-model=\"ruleForm2.gender\" placeholder=\"请选择\">\n                    <el-option label=\"男\" value=\"1\" />\n                    <el-option label=\"女\" value=\"2\" />\n                    <el-option label=\"未知\" value=\"3\" />\n                  </el-select>\n                </el-form-item>\n              </el-col>\n              <el-col :span=\"8\">\n                <el-form-item prop=\"birthday\">\n                  <template slot=\"label\">\n                    <div style=\"display: flex; align-items: center;\">\n                      <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                        <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>出生年月\n                      </div>\n                      <el-tooltip class=\"item\" effect=\"dark\" content=\"如需手动填写，请按照“1990-01-01”的格式填写\" placement=\"top\">\n                        <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n                      </el-tooltip>\n                    </div>\n                  </template>\n                  <el-date-picker v-model=\"ruleForm2.birthday\" type=\"date\" placeholder=\"选择日期\" style=\"width: 100%;\"\n                    format=\"yyyy-MM-dd\" clearable editable />\n                </el-form-item>\n              </el-col>\n            </el-row>\n            <el-row :gutter=\"20\">\n              <el-col :span=\"8\">\n                <el-form-item prop=\"tel\">\n                  <template slot=\"label\">\n                    <div style=\"display: flex; align-items: center;\">\n                      <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                        <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>联系电话\n                      </div>\n                    </div>\n                  </template>\n                  <el-input size=\"medium\" v-model=\"ruleForm2.tel\" placeholder=\"请输入联系电话\" />\n                </el-form-item>\n              </el-col>\n              <el-col :span=\"8\">\n                <el-form-item prop=\"income\" label-width=\"auto\">\n                  <template slot=\"label\">\n                    <div style=\"display: flex; align-items: center;\">\n                      <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                        <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>年收入（单位：人民币）\n                      </div>\n                    </div>\n                  </template>\n                  <el-select size=\"medium\" v-model=\"ruleForm2.income\" placeholder=\"请选择\">\n                    <el-option v-for=\"item in selectList.year_income_list\" :key=\"item.k\" :label=\"item.v\"\n                      :value=\"item.k\">\n                    </el-option>\n                  </el-select>\n                </el-form-item>\n              </el-col>\n              <el-col :span=\"8\">\n                <el-form-item prop=\"profession_code\">\n                  <template slot=\"label\">\n                    <div style=\"display: flex; align-items: center;\">\n                      <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                        <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>职业分类\n                      </div>\n                    </div>\n                  </template>\n                  <el-select size=\"medium\" v-model=\"ruleForm2.profession_code\" placeholder=\"请选择\">\n                    <el-option v-for=\"item in selectList.profession_code_list\" :key=\"item.k\" :label=\"item.v\"\n                      :value=\"item.k\">\n                    </el-option>\n                  </el-select>\n                </el-form-item>\n              </el-col>\n            </el-row>\n            <el-row :gutter=\"20\">\n              <el-col :span=\"8\">\n                <el-form-item prop=\"id_type\">\n                  <template slot=\"label\">\n                    <div style=\"display: flex; align-items: center;\">\n                      <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                        <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>身份证件类型\n                      </div>\n                    </div>\n                  </template>\n                  <el-select size=\"medium\" v-model=\"ruleForm2.id_type\" placeholder=\"请选择\"\n                    @change=\"clearIdNoValidate('ruleForm2')\">\n                    <el-option v-for=\"item in selectList.id_type_gr_list\" :key=\"item.k\" :label=\"item.v\" :value=\"item.k\">\n                    </el-option>\n                  </el-select>\n                </el-form-item>\n              </el-col>\n              <el-col :span=\"8\">\n                <el-form-item prop=\"id_no\">\n                  <template slot=\"label\">\n                    <div style=\"display: flex; align-items: center;\">\n                      <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                        <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>证件号码\n                      </div>\n                    </div>\n                  </template>\n                  <el-input size=\"medium\" v-model=\"ruleForm2.id_no\" placeholder=\"请输入证件号码\" />\n                </el-form-item>\n              </el-col>\n            </el-row>\n            <el-row :gutter=\"20\">\n              <el-col :span=\"16\">\n                <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                  <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right:4px\" v-if=\"ruleForm3.is_special==='0'\">*</span>证件有效期\n                  <el-tooltip class=\"item\" effect=\"dark\" content=\"如需手动填写，请按照“1990-01-01”的格式填写\" placement=\"top\">\n                    <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n                  </el-tooltip>\n                </div>\n                <div style=\"display:flex;width:100%;gap:8px;\">\n                  <el-form-item prop=\"id_begindate\">\n                    <el-date-picker v-model=\"ruleForm2.id_begindate\" type=\"date\" placeholder=\"开始日期\" style=\"flex:1;\"\n                      format=\"yyyy-MM-dd\" clearable>\n                    </el-date-picker>\n                  </el-form-item>\n                  <div style=\"height:40px;line-height:40px;\">至</div>\n                  <el-form-item prop=\"id_enddate\">\n                    <el-date-picker v-model=\"ruleForm2.id_enddate\" type=\"date\" placeholder=\"结束日期\" style=\"flex:1;\"\n                      format=\"yyyy-MM-dd\" align=\"right\" :picker-options=\"pickerOptions\" clearable>\n                    </el-date-picker>\n                  </el-form-item>\n                </div>\n              </el-col>\n            </el-row>\n            <el-row :gutter=\"20\">\n              <el-col :span=\"16\">\n                <el-form-item prop=\"id_address\">\n                  <template slot=\"label\">\n                    <div style=\"display: flex; align-items: center;\">\n                      <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                        <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>证件地址\n                      </div>\n                    </div>\n                  </template>\n                  <div style=\"display:flex;width:100%;gap:8px;\">\n                    <div style=\"flex:3;display:flex;gap:8px;\">\n                      <el-select size=\"medium\" v-model=\"ruleForm2.province1\" placeholder=\"省\" style=\"flex:1;\"\n                        @change=\"handleProvinceChg('1')\" clearable>\n                        <el-option v-for=\"item in proOptions\" :key=\"item.value\" :label=\"item.label\" :value=\"item.value\">\n                        </el-option>\n                      </el-select>\n                      <el-select size=\"medium\" v-model=\"ruleForm2.city1\" placeholder=\"市\" style=\"flex:1;\"\n                        @change=\"handleCityChg('1')\" clearable>\n                        <el-option v-for=\"item in cityOptions1\" :key=\"item.value\" :label=\"item.label\"\n                          :value=\"item.value\">\n                        </el-option>\n                      </el-select>\n                      <el-select size=\"medium\" v-model=\"ruleForm2.district1\" placeholder=\"区\" style=\"flex:1;\" clearable>\n                        <el-option v-for=\"item in districtOptions1\" :key=\"item.value\" :label=\"item.label\"\n                          :value=\"item.value\">\n                        </el-option>\n                      </el-select>\n                    </div>\n                    <el-input size=\"medium\" v-model=\"ruleForm2.id_address\" placeholder=\"详细地址\" style=\"flex:2;\">\n                    </el-input>\n                  </div>\n                </el-form-item>\n              </el-col>\n            </el-row>\n          </el-form>\n          <!--机构-->\n          <el-form v-else :model=\"ruleForm1\" :rules=\"rules\" ref=\"ruleForm1\" label-position=\"top\" style=\"padding:20px;\"\n            :class=\"{'hide-required-mark': shouldHideRequiredMark}\" :hide-required-asterisk=\"true\">\n            <el-row :gutter=\"20\">\n              <el-col :span=\"8\">\n                <el-form-item prop=\"client_name\">\n                  <template slot=\"label\">\n                    <div style=\"display: flex; align-items: center;\">\n                      <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                        <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>客户名称\n                      </div>\n                    </div>\n                  </template>\n                  <el-input size=\"medium\" v-model=\"ruleForm1.client_name\" placeholder=\"请输入客户名称\" readonly />\n                </el-form-item>\n              </el-col>\n              <el-col :span=\"16\">\n                <el-form-item prop=\"office_address\">\n                  <template slot=\"label\">\n                    <div style=\"display: flex; align-items: center;\">\n                      <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                        <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>办公住所\n                      </div>\n                    </div>\n                  </template>\n                  <div style=\"display:flex;width:100%;gap:8px;\">\n                    <div style=\"flex:3;display:flex;gap:8px;\">\n                      <el-select size=\"medium\" v-model=\"ruleForm1.province\" placeholder=\"省\" style=\"flex:1;\"\n                        @change=\"handleProvinceChg('0')\" clearable>\n                        <el-option v-for=\"item in proOptions\" :key=\"item.value\" :label=\"item.label\" :value=\"item.value\">\n                        </el-option>\n                      </el-select>\n                      <el-select size=\"medium\" v-model=\"ruleForm1.city\" placeholder=\"市\" style=\"flex:1;\"\n                        @change=\"handleCityChg('0')\" clearable>\n                        <el-option v-for=\"item in cityOptions\" :key=\"item.value\" :label=\"item.label\"\n                          :value=\"item.value\">\n                        </el-option>\n                      </el-select>\n                      <el-select size=\"medium\" v-model=\"ruleForm1.district\" placeholder=\"区\" style=\"flex:1;\" clearable>\n                        <el-option v-for=\"item in districtOptions\" :key=\"item.value\" :label=\"item.label\"\n                          :value=\"item.value\">\n                        </el-option>\n                      </el-select>\n                    </div>\n                    <el-input size=\"medium\" v-model=\"ruleForm1.office_address\" placeholder=\"详细地址\" style=\"flex:2;\">\n                    </el-input>\n                  </div>\n                </el-form-item>\n              </el-col>\n            </el-row>\n            <el-row :gutter=\"20\">\n              <el-col :span=\"8\">\n                <el-form-item prop=\"register_country\">\n                  <template slot=\"label\">\n                    <div style=\"display: flex; align-items: center;\">\n                      <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                        <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>注册国家地区\n                      </div>\n                    </div>\n                  </template>\n                  <el-select filterable size=\"medium\" v-model=\"ruleForm1.register_country\" placeholder=\"请选择\" clearable>\n                    <el-option v-for=\"item in selectList.nationality_list\" :key=\"item.k\" :label=\"item.v\"\n                      :value=\"item.k\">\n                    </el-option>\n                  </el-select>\n                </el-form-item>\n              </el-col>\n              <el-col :span=\"8\">\n                <el-form-item prop=\"register_fund\">\n                  <template slot=\"label\">\n                    <div style=\"display: flex; align-items: center;\">\n                      <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                        <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>注册资本金（单位：万元）\n                      </div>\n                    </div>\n                  </template>\n                  <el-input size=\"medium\" v-model=\"ruleForm1.register_fund\" placeholder=\"万元\"\n                    @blur=\"ruleForm1.register_fund = formatMoney(ruleForm1.register_fund,'4')\" />\n                </el-form-item>\n              </el-col>\n              <el-col :span=\"8\">\n                <el-form-item prop=\"register_money_type\">\n                  <template slot=\"label\">\n                    <div style=\"display: flex; align-items: center;\">\n                      <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                        <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>注册资本币种\n                      </div>\n                    </div>\n                  </template>\n                  <el-select size=\"medium\" v-model=\"ruleForm1.register_money_type\" placeholder=\"请选择\" clearable>\n                    <el-option v-for=\"item in selectList.register_money_type_list\" :key=\"item.k\" :label=\"item.v\"\n                      :value=\"item.k\">\n                    </el-option>\n                  </el-select>\n                </el-form-item>\n              </el-col>\n            </el-row>\n            <el-row :gutter=\"20\">\n              <el-col :span=\"8\">\n                <el-form-item prop=\"industry_type\">\n                  <template slot=\"label\">\n                    <div style=\"display: flex; align-items: center;\">\n                      <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                        <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>行业分类\n                      </div>\n                    </div>\n                  </template>\n                  <el-select size=\"medium\" v-model=\"ruleForm1.industry_type\" placeholder=\"请选择\" clearable>\n                    <el-option v-for=\"item in selectList.industry_type_list\" :key=\"item.k\" :label=\"item.v\"\n                      :value=\"item.k\">\n                    </el-option>\n                  </el-select>\n                </el-form-item>\n              </el-col>\n              <el-col :span=\"8\" v-show=\"ruleForm1.industry_type=='26'\">\n                <el-form-item prop=\"industry_name\">\n                  <template slot=\"label\">\n                    <div style=\"display: flex; align-items: center;\">\n                      <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                        <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"ruleForm3.is_special==='0'&&ruleForm1.industry_type=='26'\">*</span>行业注明\n                      </div>\n                    </div>\n                  </template>\n                  <el-input size=\"medium\" v-model=\"ruleForm1.industry_name\" placeholder=\"请输入行业注明\" />\n                </el-form-item>\n              </el-col>\n              <el-col :span=\"8\">\n                <el-form-item prop=\"tel\">\n                  <template slot=\"label\">\n                    <div style=\"display: flex; align-items: center;\">\n                      <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                        <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>联系电话\n                      </div>\n                    </div>\n                  </template>\n                  <el-input size=\"medium\" v-model=\"ruleForm1.tel\" placeholder=\"请输入联系电话\" />\n                </el-form-item>\n              </el-col>\n              <el-col :span=\"8\">\n                <el-form-item prop=\"setup_date\">\n                  <template slot=\"label\">\n                    <div style=\"display: flex; align-items: center;\">\n                      <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                        <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>成立日期\n                      </div>\n                      <el-tooltip class=\"item\" effect=\"dark\" content=\"如需手动填写，请按照“1990-01-01”的格式填写\" placement=\"top\">\n                        <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n                      </el-tooltip>\n                    </div>\n                  </template>\n                  <el-date-picker v-model=\"ruleForm1.setup_date\" type=\"date\" placeholder=\"选择日期\" style=\"width: 100%;\"\n                    format=\"yyyy-MM-dd\" clearable editable />\n                </el-form-item>\n              </el-col>\n            </el-row>\n            <el-row :gutter=\"20\">\n              <el-col :span=\"8\">\n                <el-form-item prop=\"id_type\">\n                  <template slot=\"label\">\n                    <div style=\"display: flex; align-items: center;\">\n                      <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                        <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>证照类型\n                      </div>\n                    </div>\n                  </template>\n                  <el-select size=\"medium\" v-model=\"ruleForm1.id_type\" placeholder=\"请选择\" clearable\n                    @change=\"clearIdNoValidate('ruleForm1')\">\n                    <el-option v-for=\"item in selectList.id_type_jg_list\" :key=\"item.k\" :label=\"item.v\" :value=\"item.k\">\n                    </el-option>\n                  </el-select>\n                </el-form-item>\n              </el-col>\n              <el-col :span=\"8\">\n                <el-form-item prop=\"id_no\">\n                  <template slot=\"label\">\n                    <div style=\"display: flex; align-items: center;\">\n                      <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                        <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>证照号码\n                      </div>\n                    </div>\n                  </template>\n                  <el-input size=\"medium\" v-model=\"ruleForm1.id_no\" placeholder=\"请输入证照号码\" />\n                </el-form-item>\n              </el-col>\n            </el-row>\n            <el-row :gutter=\"20\">\n              <el-col :span=\"16\">\n                <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                  <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right:4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>证件有效期\n                  <el-tooltip class=\"item\" effect=\"dark\" content=\"如需手动填写，请按照“1990-01-01”的格式填写\" placement=\"top\">\n                    <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n                  </el-tooltip>\n                </div>\n                <div style=\"display:flex;width:100%;gap:8px;\">\n                  <el-form-item prop=\"id_begindate\">\n                    <el-date-picker v-model=\"ruleForm1.id_begindate\" type=\"date\" placeholder=\"开始日期\" style=\"flex:1;\"\n                      format=\"yyyy-MM-dd\" clearable>\n                    </el-date-picker>\n                  </el-form-item>\n                  <div style=\"height:40px;line-height:40px;\">至</div>\n                  <el-form-item prop=\"id_enddate\">\n                    <el-date-picker v-model=\"ruleForm1.id_enddate\" type=\"date\" placeholder=\"结束日期\" style=\"flex:1;\"\n                      format=\"yyyy-MM-dd\" align=\"right\" :picker-options=\"pickerOptions\" clearable>\n                    </el-date-picker>\n                  </el-form-item>\n                </div>\n              </el-col>\n            </el-row>\n            <el-row>\n              <el-col :span=\"24\">\n                <el-form-item prop=\"busi_scope\">\n                  <template slot=\"label\">\n                    <div style=\"display: flex; align-items: center;\">\n                      <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                        <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>经营范围\n                      </div>\n                    </div>\n                  </template>\n                  <el-input size=\"medium\" v-model=\"ruleForm1.busi_scope\" type=\"textarea\" :rows=\"3\"\n                    placeholder=\"请输入经营范围\" />\n                </el-form-item>\n              </el-col>\n            </el-row>\n          </el-form>\n        </div>\n        <div class=\"attachment-section\">\n          <span>附件信息</span>\n          <el-tooltip class=\"item\" effect=\"dark\" content=\"请上传基本信息表签章版、客户营业执照复印件、客户公司章程复印件、在工商外部数据库（如“企查查”）查验的报告。\"\n            placement=\"right\">\n            <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n          </el-tooltip>\n          <el-table :data=\"attachmentList.basicInfo\" border style=\"width: 100%; margin-top: 10px;\"\n            :default-sort=\"{prop: 'date', order: 'descending'}\">\n            <el-table-column prop=\"name\" label=\"附件名称\" sortable>\n              <template slot-scope=\"scope\">\n                <el-button type=\"text\" @click=\"handlePreview(scope.row)\" class=\"attachment-btn\">\n                  {{ scope.row.name }}\n                </el-button>\n              </template>\n            </el-table-column>\n            <el-table-column prop=\"extension\" label=\"附件类型\" width=\"120\"></el-table-column>\n            <el-table-column prop=\"create_time\" label=\"上传时间\" width=\"160\" sortable></el-table-column>\n            <el-table-column prop=\"file_size\" label=\"附件大小\" width=\"120\" sortable>\n              <template slot-scope=\"scope\">\n                {{ formatSize(scope.row.file_size) }}\n              </template>\n            </el-table-column>\n            <el-table-column prop=\"create_by\" label=\"上传人\" width=\"120\" sortable></el-table-column>\n            <el-table-column prop=\"create_time\" label=\"操作\" width=\"150\">\n              <template slot-scope=\"scope\">\n                <div class=\"operation-buttons\">\n                  <el-tooltip content=\"预览\">\n                    <el-button type=\"text\" class=\"el-icon-view\" @click=\"handlePreview(scope.row)\"></el-button>\n                  </el-tooltip>\n                  <el-tooltip content=\"下载\">\n                    <el-button type=\"text\" class=\"el-icon-download\" @click=\"handleDownload(scope.row)\"></el-button>\n                  </el-tooltip>\n                </div>\n              </template>\n            </el-table-column>\n          </el-table>\n          <!-- 上传按钮 -->\n          <div class=\"upload-add\">\n            <div class=\"upload-demo\">\n              <el-button type=\"text\" icon=\"el-icon-plus\" @click=\"openFileDialog(1)\">添加</el-button>\n            </div>\n          </div>\n        </div>\n      </el-card>\n      <!--反洗钱特殊情况申请-->\n      <el-card class=\"box-card\" :name=\"'fxqSpecial'+this._uid\">\n        <div slot=\"header\" class=\"clearfix\">\n          <span>反洗钱特殊情况</span>\n        </div>\n        <el-form :model=\"ruleForm3\" :rules=\"rules\" ref=\"ruleForm3\" style=\"padding:20px;\" label-position=\"top\">\n          <el-form-item label=\"是否存在反洗钱特殊情况申请\" prop=\"is_special\" label-width=\"200\">\n            <el-radio-group v-model=\"ruleForm3.is_special\">\n              <el-radio label=\"1\">是</el-radio>\n              <el-radio label=\"0\">否</el-radio>\n            </el-radio-group>\n            <div style=\"color:#f56c6c;\">如目前存在未获取的反洗钱信息或底稿材料，请选择“是”</div>\n          </el-form-item>\n          <!--表单内容-->\n          <div v-if=\"ruleForm3.is_special=='1'\">\n            <el-row :gutter=\"20\">\n              <el-col :span=\"12\">\n                <!--<el-form-item label=\"客户类型\" prop=\"client_type\">\n                  <el-select size=\"medium\" v-model=\"ruleForm3.client_type\" multiple placeholder=\"请选择\">\n                    <el-option v-for=\"item in selectList.client_type_list\" :key=\"item.k\" :label=\"item.v\"\n                      :value=\"item.k\">\n                    </el-option>\n                  </el-select>\n                </el-form-item>-->\n                <el-form-item label=\"客户类型\" prop=\"client_type\">\n                  <el-checkbox-group v-model=\"ruleForm3.client_type\">\n                    <el-checkbox v-for=\"item in selectList.client_type_list\" :key=\"item.k\" :label=\"item.k\">\n                      {{ item.v }}\n                    </el-checkbox>\n                  </el-checkbox-group>\n                </el-form-item>\n              </el-col>\n              <el-col :span=\"12\">\n                <el-form-item label=\"具体说明\" prop=\"client_type_other\" v-if=\"ruleForm3.client_type.indexOf('99')!==-1\">\n                  <el-input size=\"medium\" v-model=\"ruleForm3.client_type_other\">\n                  </el-input>\n                </el-form-item>\n              </el-col>\n            </el-row>\n            <el-row :gutter=\"20\">\n              <el-col :span=\"12\">\n                <!--<el-form-item label=\"特殊事项\" prop=\"special_matters\">\n                  <el-select size=\"medium\" v-model=\"ruleForm3.special_matters\" multiple placeholder=\"请选择\">\n                    <el-option v-for=\"item in selectList.special_matters_list\" :key=\"item.k\" :label=\"item.v\"\n                      :value=\"item.k\">\n                    </el-option>\n                  </el-select>\n                </el-form-item>-->\n                <el-form-item label=\"特殊事项\" prop=\"special_matters\">\n                  <el-checkbox-group v-model=\"ruleForm3.special_matters\">\n                    <el-checkbox v-for=\"item in selectList.special_matters_list\" :key=\"item.k\" :label=\"item.k\">\n                      {{ item.v }}\n                    </el-checkbox>\n                  </el-checkbox-group>\n                </el-form-item>\n              </el-col>\n              <el-col :span=\"12\">\n              </el-col>\n            </el-row>\n            <el-form-item label=\"具体说明缺失的信息\" prop=\"missing_information\"\n              v-if=\"ruleForm3.special_matters.indexOf('1')!==-1\">\n              <el-input size=\"medium\" v-model=\"ruleForm3.missing_information\">\n              </el-input>\n            </el-form-item>\n            <el-form-item label=\"具体说明缺失的底稿\" prop=\"missing_draft\" v-if=\"ruleForm3.special_matters.indexOf('2')!==-1\">\n              <el-input size=\"medium\" v-model=\"ruleForm3.missing_draft\">\n              </el-input>\n            </el-form-item>\n            <el-form-item label=\"具体说明\" prop=\"special_matters_other\" v-if=\"ruleForm3.special_matters.indexOf('99')!==-1\">\n              <el-input size=\"medium\" v-model=\"ruleForm3.special_matters_other\">\n              </el-input>\n            </el-form-item>\n            <el-form-item label=\"特殊事项原因\" prop=\"special_reason\">\n              <el-input size=\"medium\" type=\"textarea\" v-model=\"ruleForm3.special_reason\">\n              </el-input>\n            </el-form-item>\n            <el-form-item label=\"已开展的反洗钱尽职调查工作\" prop=\"completed_cdd\">\n              <el-input size=\"medium\" type=\"textarea\" v-model=\"ruleForm3.completed_cdd\">\n              </el-input>\n            </el-form-item>\n            <el-form-item label=\"客户洗钱风险较低的评估说明\" prop=\"low_risk_explanation\">\n              <el-input size=\"medium\" type=\"textarea\" v-model=\"ruleForm3.low_risk_explanation\">\n              </el-input>\n            </el-form-item>\n            <el-form-item label=\"后续措施\" prop=\"take_measures\">\n              <el-input size=\"medium\" type=\"textarea\" v-model=\"ruleForm3.take_measures\">\n              </el-input>\n            </el-form-item>\n          </div>\n          <!--附件内容-->\n          <div v-if=\"ruleForm3.is_special=='1'\">\n            <div style=\"font-weight:blod;font-size:15px;padding-bottom:20px;\">附件</div>\n            <el-row :gutter=\"20\" style=\"padding-bottom:20px;\">\n              <el-col :span=\"8\">\n                <font color=\"#F56C6C\">*&nbsp;</font>与客户沟通记录\n              </el-col>\n              <el-col :span=\"16\">\n                <el-upload class=\"upload-demo\" ref=\"upload\"\n                  action=\"m?xwl=aml_monitor/workflow/prs01/dataSource/files/upload_file1\" name=\"file1\"\n                  header=\"{content-type:'text/html'}\" :data=\"uploadParams1\" :file-list=\"attachmentList.communication\"\n                  :auto-upload=\"true\" :on-change=\"handleChange1\" :on-remove=\"handleRemove1\" multiple>\n                  <el-button slot=\"trigger\" size=\"mini\" icon=\"el-icon-upload2\">上传文件</el-button>\n                  <div slot=\"tip\" class=\"el-upload__tip\">支持扩展名 .zip .rar .xlsx .xls .doc .docx .pdf .jpg .jpeg .svg .gif\n                    .png .txt .mp3 .mp4</div>\n              </el-col>\n              </el-upload>\n            </el-row>\n            <el-row :gutter=\"20\" style=\"padding-bottom:20px;\">\n              <el-col :span=\"8\">\n                <font color=\"#F56C6C\">*&nbsp;</font>二级部门负责人同意的记录\n              </el-col>\n              <el-col :span=\"16\">\n                <el-upload class=\"upload-demo\" ref=\"upload\"\n                  action=\"m?xwl=aml_monitor/workflow/prs01/dataSource/files/upload_file1\" name=\"file1\"\n                  header=\"{content-type:'text/html'}\" :data=\"uploadParams2\" :file-list=\"attachmentList.agree\"\n                  :auto-upload=\"true\" :on-change=\"handleChange2\" :on-remove=\"handleRemove2\" multiple>\n                  <el-button slot=\"trigger\" size=\"mini\" icon=\"el-icon-upload2\">上传文件</el-button>\n                  <div slot=\"tip\" class=\"el-upload__tip\">支持扩展名 .zip .rar .xlsx .xls .doc .docx .pdf .jpg .jpeg .svg .gif\n                    .png .txt .mp3 .mp4</div>\n              </el-col>\n              </el-upload>\n            </el-row>\n            <el-row :gutter=\"20\" style=\"padding-bottom:20px;\">\n              <el-col :span=\"8\">\n                <font>&nbsp;&nbsp;</font>其他底稿\n              </el-col>\n              <el-col :span=\"16\">\n                <el-upload class=\"upload-demo\" ref=\"upload\"\n                  action=\"m?xwl=aml_monitor/workflow/prs01/dataSource/files/upload_file1\" name=\"file1\"\n                  header=\"{content-type:'text/html'}\" :data=\"uploadParams3\" :file-list=\"attachmentList.other\"\n                  :auto-upload=\"true\" :on-change=\"handleChange3\" :on-remove=\"handleRemove3\" multiple>\n                  <el-button slot=\"trigger\" size=\"mini\" icon=\"el-icon-upload2\">上传文件</el-button>\n                  <div slot=\"tip\" class=\"el-upload__tip\">支持扩展名 .zip .rar .xlsx .xls .doc .docx .pdf .jpg .jpeg .svg .gif\n                    .png .txt .mp3 .mp4</div>\n              </el-col>\n              </el-upload>\n            </el-row>\n          </div>\n        </el-form>\n      </el-card>\n      <!--法定代表人-->\n      <el-card class=\"box-card\" :name=\"'LegalRep'+this._uid\" v-if=\"organ_flag=='1'\">\n        <div slot=\"header\" class=\"clearfix\">\n          <span>法定代表人相关信息</span>\n          <el-button type=\"text\" icon=\"el-icon-plus\" class=\"add-btn\" @click=\"showDialog('1',{},'1')\"\n            v-if=\"relatedInfo1.length==0\">添加</el-button>\n        </div>\n        <div v-if=\"relatedInfo1.length==0\" style=\"color:#8d8b8b;text-align:center\">暂无数据</div>\n        <el-card v-for=\"item in relatedInfo1\" :key=\"item.related_id\" style=\"margin-bottom:10px;\">\n          <div class=\"client-info\">\n            <div class=\"client-title\">\n              <span>{{item.related_name}}</span>\n              <el-tag type=\"success\" effect=\"dark\" size=\"mini\" style=\"margin-left: 10px;\" v-if=\"item.organ_flag==='0'\">\n                自然人</el-tag>\n              <el-tag type=\"\" effect=\"dark\" size=\"mini\" style=\"margin-left: 10px;\" v-if=\"item.organ_flag==='1'\">法人\n              </el-tag>\n            </div>\n\n            <el-row :gutter=\"10\" class=\"info-row\">\n              <div class=\"info-row-flex\" v-if=\"item.organ_flag==='1'\"><label>国家或地区</label>\n                <div>{{formatDictMap('nationality_list',item.nationality)|| '-'}}</div>\n              </div>\n              <div class=\"info-row-flex\" v-if=\"item.organ_flag==='0'\"><label>国籍</label>\n                <div>{{formatDictMap('nationality_list',item.nationality)|| '-'}}</div>\n              </div>\n              <div class=\"info-row-flex\"><label>证件类型</label>\n                <div>{{formatDictMap('id_type_list',item.id_type)|| '-'}}</div>\n              </div>\n              <div class=\"info-row-flex\"><label>证件号码</label>\n                <div>{{item.id_no|| '-'}}</div>\n              </div>\n            </el-row>\n\n            <el-row :gutter=\"10\" class=\"info-row\">\n              <div class=\"info-row-flex\"><label>证件有效期起始</label>\n                <div>{{item.id_begindate|| '-'}}</div>\n              </div>\n              <div class=\"info-row-flex\"><label>证件有效期截止</label>\n                <div>{{item.id_enddate|| '-'}}</div>\n              </div>\n              <div class=\"info-row-flex\"><label>出生年月</label>\n                <div>{{item.birthday|| '-'}}</div>\n              </div>\n            </el-row>\n          </div>\n          <!-- 操作按钮 -->\n          <div class=\"attachment-footer\">\n            <el-button type=\"text\" @click=\"deleteRalated(item)\">删除</el-button>\n            <el-button type=\"text\" @click=\"showDialog('2',item,'1')\">编辑</el-button>\n          </div>\n        </el-card>\n        <!-- 附件信息表 -->\n        <div style=\"padding-top:10px;\">\n          <span>附件信息</span>\n          <el-tooltip class=\"item\" effect=\"dark\" content=\"请上传法定代表人身份证明文件的复印件\" placement=\"right\">\n            <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n          </el-tooltip>\n          <el-table :data=\"attachmentList.LegalRep\" border style=\"width: 100%;margin-top:10px;\"\n            :default-sort=\"{prop: 'date', order: 'descending'}\">\n            <el-table-column prop=\"name\" label=\"附件名称\" sortable>\n              <template slot-scope=\"scope\">\n                <el-button type=\"text\" @click=\"handlePreview(scope.row)\" class=\"attachment-btn\">\n                  {{ scope.row.name }}\n                </el-button>\n              </template>\n            </el-table-column>\n            <el-table-column prop=\"extension\" label=\"附件类型\" width=\"120\" />\n            <el-table-column prop=\"create_time\" label=\"上传时间\" width=\"160\" sortable />\n            <el-table-column prop=\"file_size\" label=\"附件大小\" width=\"120\" sortable>\n              <template slot-scope=\"scope\">\n                {{ formatSize(scope.row.file_size) }}\n              </template>\n            </el-table-column>\n            <el-table-column prop=\"create_by\" label=\"上传人\" width=\"120\" sortable />\n            <el-table-column label=\"操作\" width=\"150\" fixed=\"right\">\n              <template slot-scope=\"scope\">\n                <div class=\"operation-buttons\">\n                  <el-tooltip content=\"预览\">\n                    <el-button type=\"text\" class=\"el-icon-view\" @click=\"handlePreview(scope.row)\"></el-button>\n                  </el-tooltip>\n                  <el-tooltip content=\"下载\">\n                    <el-button type=\"text\" class=\"el-icon-download\" @click=\"handleDownload(scope.row)\"></el-button>\n                  </el-tooltip>\n                </div>\n              </template>\n            </el-table-column>\n          </el-table>\n          <!-- 上传按钮 -->\n          <div class=\"upload-add\">\n            <div class=\"upload-demo\">\n              <el-button type=\"text\" icon=\"el-icon-plus\" @click=\"openFileDialog(23)\">添加</el-button>\n            </div>\n          </div>\n        </div>\n      </el-card>\n      <!--控股股东-->\n      <el-card class=\"box-card\" :name=\"'controllingShareholder'+this._uid\" v-if=\"organ_flag=='1'\">\n        <div slot=\"header\" class=\"clearfix\">\n          <span>控股股东相关信息</span>\n          <el-button type=\"text\" icon=\"el-icon-plus\" class=\"add-btn\" @click=\"showDialog('1',{},'2')\">添加</el-button>\n        </div>\n        <div v-if=\"relatedInfo2.length==0\" style=\"color:#8d8b8b;text-align:center\">暂无数据</div>\n        <el-card v-for=\"item in relatedInfo2\" :key=\"item.related_id\" style=\"margin-bottom:10px;\">\n          <div class=\"client-info\">\n            <div class=\"client-title\">\n              <span>{{item.related_name}}</span>\n              <el-tag type=\"success\" effect=\"dark\" size=\"mini\" style=\"margin-left: 10px;\" v-if=\"item.organ_flag==='0'\">\n                自然人</el-tag>\n              <el-tag type=\"\" effect=\"dark\" size=\"mini\" style=\"margin-left: 10px;\" v-if=\"item.organ_flag==='1'\">法人\n              </el-tag>\n            </div>\n\n            <el-row :gutter=\"10\" class=\"info-row\">\n              <div class=\"info-row-flex\" v-if=\"item.organ_flag==='1'\"><label>国家或地区</label>\n                <div>{{formatDictMap('nationality_list',item.nationality)|| '-'}}</div>\n              </div>\n              <div class=\"info-row-flex\" v-if=\"item.organ_flag==='0'\"><label>国籍</label>\n                <div>{{formatDictMap('nationality_list',item.nationality)|| '-'}}</div>\n              </div>\n              <div class=\"info-row-flex\"><label>证件类型</label>\n                <div>{{formatDictMap('id_type_list',item.id_type)|| '-'}}</div>\n              </div>\n              <div class=\"info-row-flex\"><label>证件号码</label>\n                <div>{{item.id_no|| '-'}}</div>\n              </div>\n            </el-row>\n\n            <el-row :gutter=\"10\" class=\"info-row\">\n              <div class=\"info-row-flex\"><label>证件