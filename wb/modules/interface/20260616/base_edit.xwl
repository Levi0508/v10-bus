"8\" v-show=\"editForm1.actctrlcpny === '3'\">\n            <el-form-item prop=\"actotherforms\">\n              <template slot=\"label\">\n                <div style=\"display: flex; align-items: center;\">\n                  <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                    <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>实际控制其他形式\n                  </div>\n                </div>\n              </template>\n              <el-input v-model=\"editForm1.actotherforms\" type=\"number\" :max=\"100\" :min=\"0\">\n              </el-input>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\" v-show=\"editForm1.actctrlcpny === '2'\">\n            <el-form-item prop=\"actconuppermarket\">\n              <template slot=\"label\">\n                <div style=\"display: flex; align-items: center;\">\n                  <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                    <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>是否存在上一层备案主体\n                  </div>\n                </div>\n              </template>\n              <el-select v-model=\"editForm1.actconuppermarket\" filterable placeholder=\"请选择\" clearable\n                style=\"width:100%\">\n                <el-option v-for=\"item in selectList.benefit_yesno_list\" :key=\"item.k\" :label=\"item.v\" :value=\"item.k\">\n                </el-option>\n              </el-select>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\" v-show=\"editForm1.actctrlcpny === '2' && editForm1.actconuppermarket === 'Y'\">\n            <el-form-item prop=\"actconupperentname\">\n              <template slot=\"label\">\n                <div style=\"display: flex; align-items: center;\">\n                  <div style=\"height:40px;line-height:40px;font