       </div>\n                </div>\n              </template>\n              <el-input v-model=\"editForm1.actdailymgmtpostother\"></el-input>\n            </el-form-item>\n          </el-col>\n        </el-row>\n        <el-row :gutter=\"24\" v-show=\"editForm1.related_type=='5' && ((editForm1.bnf_type || '').includes('NA5'))\">\n          <el-col :span=\"8\">\n            <el-form-item prop=\"seniormgrposcn\">\n              <template slot=\"label\">\n                <div style=\"display: flex; align-items: center;\">\n                  <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                    <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>在华最高层级的高级管理人员职位\n                  </div>\n                </div>\n              </template>\n              <el-select v-model=\"editForm1.seniormgrposcn_array\" filterable placeholder=\"请选择\" multiple clearable\n                style=\"width:100%\" @change=\"(val) => editForm1.seniormgrposcn = val.join(',')\">\n                <el-option v-for=\"item in selectList.benefit_seniormgrposcn_list\" :key=\"item.k\" :label=\"item.v\"\n                  :value=\"item.k\">\n                </el-option>\n              </el-select>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"16\" v-show=\"(editForm1.seniormgrposcn || '').includes('1')\">\n            <el-form-item prop=\"ownerrightmgmtpostother\">\n              <template slot=\"label\">\n                <div style=\"display: flex; align-items: center;\">\n                  <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                    <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>在华最高层级的高级管理其他职位\n                  </div>\n                </div>\n              </template>\n              <el-input v-model=\"editForm1.ownerrightmgmtpostother\"></el-input>\n            </el-form-item>\n          </el-col>\n        </el-row>\n      </el-form>\n    </div>\n    <div slot=\"footer\" class=\"dialog-footer\">\n      <el-button @click=\"closeDialog('2')\">取消</el-button>\n      <el-button type=\"primary\" @click=\"saveEditForm('1','2')\"\n        v-if=\"editForm1.related_type!=='1'&&editForm1.related_type!=='4'\">提交并录入下一条</el-button>\n      <el-button type=\"primary\" @click=\"saveEditForm('2','2')\">提交</el-button>\n    </div>\n  </el-dialog>\n</div>"},"_expanded":true,"hasDupCid":0,"events":{"ready":"let comp = this;\ncomp.vue = new Vue({\n  el: this.bodyEl.query('#cus_page'),\n  // el: comp.el.addEl(),\n  // template: ``,\n  data() {\n    return {\n      organ_flag: '_$organ_flag$_',\n      client_id: '_$client_id$_',\n      client_belong: '_$client_belong$_',// 客户归属\n      data_type: '_$data_type$_',\n      selectList: app.data.selectList,\n      isScroll: true,\n      navList: [\n        {\n          label: '客户基本信息',\n          value: 'basicInfo',\n          name: '#basicInfo'\n        }, {\n          label: '反洗钱特殊情况',\n          value: 'fxqSpecial',\n          name: '#fxqSpecial'\n        }, {\n          label: '法定代表人',\n          value: 'LegalRep',\n          name: '#LegalRep'\n        }, {\n          label: '控股股东',\n          value: 'controllingShareholder',\n          name: '#controllingShareholder'\n        }, {\n          label: '实际控制人',\n          value: 'actualController',\n          name: '#actualController'\n        }, {\n          label: '授权代表人',\n          value: 'authorizedRep',\n          name: '#authorizedRep'\n        }, {\n          label: '受益所有人',\n          value: 'beneficialOwner',\n          name: '#beneficialOwner'\n        },\n      ],\n      attachmentList: {\n        'basicInfo': [],\n        'LegalRep': [],\n        'controllingShareholder': [],\n        'actualController': [],\n        'authorizedRep': [],\n        'beneficialOwner': [],\n        'communication': [],// 与客户沟通记录\n        'agree': [],// 二级部门负责人同意的记录\n        'other': [] // 其他底稿\n      },\n      activeNav: 'basicInfo',\n      basicInfo: app.data.basicInfo,\n      relatedInfo1: app.data.relatedInfo1,// 法定代表人\n      relatedInfo2: app.data.relatedInfo2,// 控股股东\n      relatedInfo3: app.data.relatedInfo3,// 实际控制人\n      relatedInfo4: app.data.relatedInfo4,// 授权代表人\n      relatedInfo5: app.data.relatedInfo5,// 受益所有人\n      ruleForm1: {},\n      ruleForm2: {},\n      ruleForm3: {\n        is_special: '0',\n        client_type: [],\n        client_type_other: '',\n        special_matters: [],\n        missing_information: '',\n        missing_draft: '',\n        special_matters_other: '',\n        special_reason: '',\n        completed_cdd: '',\n        low_risk_explanation: '',\n        take_measures: ''\n      },\n      editForm: {\n        related_name: '',\n        organ_flag: '0',\n        nationality: '',\n        id_type: '',\n        id_no: '',\n        id_begindate: '',\n        id_enddate: '',\n        birthday: '',\n        is_government_dept: '',\n        beneficiary: '',\n        shareholding_ratio: '',\n        address: '',\n        related_type: '',\n        title: '',\n        new_flag: null,\n      },\n      editForm1: {\n        related_name: '',\n        organ_flag: '0',\n        nationality: '',\n        id_type: '',\n        id_no: '',\n        id_begindate: '',\n        id_enddate: '',\n        birthday: '',\n        is_government_dept: '',\n        related_type: '',\n        title: '',\n        beneficiary: '',\n        shareholding_ratio: '',\n        address: '',\n        new_flag: null,\n      },\n      curRelaOptions: [],//当前关联人弹窗能选择的关联人\n      rules: app.data.rules,\n      rules1: app.data.rules1,\n      associated_date: '',//建立业务关系日期\n      remark: '',//备注\n      // 省市区\n      proOptions: [], // 省\n      cityOptions: [],// 办公地址市\n      districtOptions: [],// 办公地址区\n      cityOptions1: [],// 证件地址市\n      districtOptions1: [],// 证件地址区\n      cityOptions2: [],// 联系地址市\n      districtOptions2: [],// 联系地址区\n\n      attachments: [],\n      // 非自然人附件目录\n      directoryConfig1: app.data.directory.directoryConfig1,\n      // 自然人附件目录\n      directoryConfig2: app.data.directory.directoryConfig2,\n      fileList: [],\n      fileDialogVisible: false,\n      dialogFormVisible: false,//关联主体登记弹窗\n      dialogFormVisible1: false,\n      selectedMenu: 1,//选中的目录\n      uploadParams: {\n        objectId: Wb.getId(),\n        client_id: '_$client_id$_'\n      },\n      uploadParams1: {\n        objectId: '_$client_id$_' + 'communication',\n        client_id: '_$client_id$_'\n      },\n      uploadParams2: {\n        objectId: '_$client_id$_' + 'agree',\n        client_id: '_$client_id$_'\n      },\n      uploadParams3: {\n        objectId: '_$client_id$_' + 'other',\n        client_id: '_$client_id$_'\n      },\n      previewUrl: '',\n      pickerOptions: {\n        shortcuts: [{\n          text: '长期',\n          onClick(picker) {\n            picker.$emit('pick', '2100-12-31')\n          }\n        }]\n      },\n      loading: true\n    };\n  },\n  computed: {\n    // 是否隐藏表单项必填标记（*号）\n    shouldHideRequiredMark() {\n      return (this.ruleForm3 && this.ruleForm3.is_special === '1') || (this.editForm.is_government_dept === '1');\n    }\n  },\n  methods: {\n    handleDateBlur(event) {\n      console.log(\"handleDateBlur\", event);\n      // 1. 从原生事件中获取用户输入的原始文本 (例如: \"20260601\")\n      // const inputVal = event.target.value;\n\n      // // 2. 校验是否是8位纯数字\n      // if (inputVal && /^\\d{8}$/.test(inputVal.trim())) {\n      //   // 3. 截取拼接成标准格式\n      //   const formattedDate = `${inputVal.slice(0, 4)}-${inputVal.slice(4, 6)}-${inputVal.slice(6, 8)}`;\n\n      //   // 4. 验证是否为合法日期（防止输入 20269999）\n      //   const dateObj = new Date(formattedDate);\n      //   if (!isNaN(dateObj.getTime())) {\n      //     // 5. 强制更新绑定的数据模型\n      //     this.ruleForm1.setup_date = formattedDate;\n      //   }\n      // }\n    },\n    // 清空证件号码的校验提示（当证件类型改变时）\n    clearIdNoValidate(formType) {\n      // 根据表单类型获取对应的表单引用\n      let formRef;\n      if (formType === 'ruleForm1') {\n        formRef = this.$refs.ruleForm1;\n      } else if (formType === 'ruleForm2') {\n        formRef = this.$refs.ruleForm2;\n      } else if (formType === 'editForm') {\n        formRef = this.$refs.editForm;\n      } else if (formType === 'editForm1') {\n        formRef = this.$refs.editForm1;\n      }\n\n      // 清空证件号码字段的校验提示\n      if (formRef) {\n        formRef.clearValidate('id_no');\n      }\n    },\n    // 校验身份证格式\n    validateIdCard(rule, value, callback) {\n      if (!value) {\n        callback();\n        return;\n      }\n      // 15位或18位身份证号码正则\n      const reg = /^[1-9]\\d{5}(18|19|([23]\\d))\\d{2}((0[1-9])|(10|11|12))(([0-2][1-9])|10|20|30|31)\\d{3}[0-9Xx]$/;\n      if (reg.test(value)) {\n        callback();\n      } else {\n        callback(new Error('请输入正确的身份证号码格式'));\n      }\n    },\n    // 校验营业执照格式（统一社会信用代码）\n    validateBusinessLicense(rule, value, callback) {\n      if (!value) {\n        callback();\n        return;\n      }\n      // 统一社会信用代码为18位，由数字和大写字母组成\n      const reg = /^[0-9A-HJ-NPQRTUWXY]{2}\\d{6}[0-9A-HJ-NPQRTUWXY]{10}$/;\n      if (reg.test(value)) {\n        callback();\n      } else {\n        callback(new Error('请输入正确的统一社会信用代码格式'));\n      }\n    },\n    // 校验证件号码（客户基本信息表单 - 机构户/个人户）\n    validateIdNoForBasicInfo() {\n      return (rule, value, callback) => {\n        if (!value) {\n          callback(new Error('请输入\"证件号码\"'));\n          return;\n        }\n        // 根据主体类型判断是机构户还是个人户\n        const idType = this.organ_flag === '1' ? this.ruleForm1.id_type : this.ruleForm2.id_type;\n\n        // 根据证件类型进行格式校验\n        if (idType === '1') {\n          // 身份证\n          const reg = /^[1-9]\\d{5}(18|19|([23]\\d))\\d{2}((0[1-9])|(10|11|12))(([0-2][1-9])|10|20|30|31)\\d{3}[0-9Xx]$/;\n          if (reg.test(value)) {\n            callback();\n          } else {\n            callback(new Error('请输入正确的身份证号码格式'));\n          }\n        } else if (idType === '3') {\n          // 营业执照（统一社会信用代码）\n          const reg = /^[0-9A-HJ-NPQRTUWXY]{2}\\d{6}[0-9A-HJ-NPQRTUWXY]{10}$/;\n          if (reg.test(value)) {\n            callback();\n          } else {\n            callback(new Error('请输入正确的统一社会信用代码格式'));\n          }\n        } else {\n          callback();\n        }\n      };\n    },\n    // 校验证件号码（关联人弹窗）\n    validateIdNoForRelated() {\n      return (rule, value, callback) => {\n        if (!value) {\n          callback(new Error('请输入\"证件号码\"'));\n          return;\n        }\n        // 判断当前是哪个弹窗（editForm 或 editForm1）\n        const currentForm = this.dialogFormVisible ? this.editForm : this.editForm1;\n        const idType = currentForm.id_type;\n\n        // 根据证件类型进行格式校验\n        if (idType === '1') {\n          // 身份证\n          const reg = /^[1-9]\\d{5}(18|19|([23]\\d))\\d{2}((0[1-9])|(10|11|12))(([0-2][1-9])|10|20|30|31)\\d{3}[0-9Xx]$/;\n          if (reg.test(value)) {\n            callback();\n          } else {\n            callback(new Error('请输入正确的身份证号码格式'));\n          }\n        } else if (idType === '3') {\n          // 营业执照（统一社会信用代码）\n          const reg = /^[0-9A-HJ-NPQRTUWXY]{2}\\d{6}[0-9A-HJ-NPQRTUWXY]{10}$/;\n          if (reg.test(value)) {\n            callback();\n          } else {\n            callback(new Error('请输入正确的统一社会信用代码格式'));\n          }\n        } else {\n          callback();\n        }\n      };\n    },\n    // 校验时的提示（需换行）\n    showMessage(msg, time, type) {\n      this.$message({\n        showClose: true,\n        dangerouslyUseHTMLString: true,\n        message: msg,\n        duration: time ? time : 0,\n        type: type ? type : 'success'\n      })\n    },\n    handleClick(tab, event) {\n      this.isScroll = false;\n      let that = this;\n      let element = document.getElementsByName(tab.name)[0];\n      element.scrollIntoView({\n        behavior: 'smooth',\n        block: 'start'\n      });\n      setTimeout(() => {\n        that.isScroll = true;\n      }, 500);\n      console.log(\"滚动监听中...\");\n    },\n    // 滚动监听\n    onScroll(e) {\n      if (!this.isScroll) return;\n      var scrollItems = [];\n      this.navList.forEach(ele => {\n        var element = document.getElementsByName(ele.value)[0];\n        scrollItems.push(element);\n      });\n      var scrollTop = e.target.scrollTop;\n      var foundIndex = -1;\n      for (var i = 0; i < scrollItems.length; i++) {\n        var item = scrollItems[i];\n        var threshold = item.offsetTop - scrollItems[0].offsetTop;\n        if (scrollTop >= threshold) {\n          foundIndex = i;\n        } else {\n          break;\n        }\n      }\n      if (foundIndex !== -1) {\n        this.activeNav = this.navList[foundIndex.toString()].value;\n      }\n    },\n    // 页面展示数据字典转换\n    formatDictMap(dictType, key) {\n      const dictData = this.selectList[dictType];\n      const item = dictData?.find(item => item.k === key);\n      return item ? item.v : '-';\n    },\n    // 页面展示数据字典转换 多选\n    formatMultipleDictMap(dictType, key) {\n      var c_key = key || '';\n      if (c_key === '') { return '-'; }\n      const keyList = c_key.split(',');\n      const dictData = this.selectList[dictType];\n      const item = [];\n      for (let index = 0; index < keyList.length; index++) {\n        item.push(dictData?.find(item => item.k === keyList[index]));\n      }\n      return item.length && !!item[0] ? item.map(i => i.v).join('；') : '-';\n    },\n    formatMoney(s, n) {\n      if (!s && s !== 0) return '';\n      let str = String(s);\n      let cleaned = str.replace(/[^\\d\\.]/g, \"\") // 移除所有非数字、非小数点的字符\n        .replace(/\\.{2,}/g, '.') // 多个小数点合并为一个\n        .replace(/^\\./, \"\"); // 移除开头的小数点\n\n      if (!cleaned) return \"\";\n      let num = parseFloat(cleaned);\n      if (isNaN(num)) return \"\";\n      let fixedNum = num.toFixed(n);\n      let [integerPart, decimalPart] = fixedNum.split('.');\n      let integerWithComma = integerPart.replace(/(?=(\\B)(\\d{3})+$)/g, ',');\n      return decimalPart ? `${integerWithComma}.${decimalPart}` : integerWithComma;\n    },\n    // 格式化附件大小\n    formatSize(bytes) {\n      if (!bytes && bytes !== 0) {\n        return '';\n      } else if (bytes === 0) {\n        return '0 B'\n      };\n\n      const k = 1024;\n      const sizes = ['B', 'KB', 'MB', 'GB', 'TB'];\n      const i = Math.floor(Math.log(bytes) / Math.log(k));\n\n      return (bytes / Math.pow(k, i)).toFixed(2) + ' ' + sizes[i];\n    },\n    // 查询省\n    getProvince() {\n      let that = this;\n      Wb.ajax({\n        url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/select_province',\n        success: function (resp) {\n          let rec = Wb.decode(resp).items;\n          that.proOptions = rec.map(item => ({\n            label: item.pro_name,\n            value: item.pro_code\n          }));\n        }\n      });\n    },\n    handleProvinceChg(val) {\n      if (val == '0') {\n        this.ruleForm1.city = '';\n        this.ruleForm1.district = '';\n        this.ruleForm1.office_address = '';\n      } else if (val == '1') {\n        this.ruleForm2.city1 = '';\n        this.ruleForm2.district1 = '';\n        this.ruleForm2.id_address = '';\n      } else if (val == '2') {\n        this.ruleForm2.city2 = '';\n        this.ruleForm2.district2 = '';\n        this.ruleForm2.address = '';\n      }\n      this.getCity(val);\n    },\n    // 查询市\n    getCity(val) {\n      let that = this;\n      let province;\n      if (val == '0') {\n        province = this.ruleForm1.province;\n      } else if (val == '1') {\n        province = this.ruleForm2.province1;\n      } else if (val == '2') {\n        province = this.ruleForm2.province2;\n      }\n      if (province) {\n        Wb.ajax({\n          url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/select_city',\n          params: {\n            I_PRO_CODE: province\n          },\n          success: function (resp) {\n            let rec = Wb.decode(resp).items;\n            console.log(\"市\", rec);\n            if (val == '0') {\n              that.cityOptions = rec.map(item => ({\n                label: item.area_name,\n                value: item.area_code\n              }));\n            } else if (val == '1') {\n              that.cityOptions1 = rec.map(item => ({\n                label: item.area_name,\n                value: item.area_code\n              }));\n            } else if (val == '2') {\n              that.cityOptions2 = rec.map(item => ({\n                label: item.area_name,\n                value: item.area_code\n              }));\n            }\n          }\n        });\n      }\n    },\n    handleCityChg(val) {\n      if (val == '0') {\n        this.ruleForm1.district = '';\n        this.ruleForm1.office_address = '';\n      } else if (val == '1') {\n        this.ruleForm2.district1 = '';\n        this.ruleForm2.id_address = '';\n      } else if (val == '2') {\n        this.ruleForm2.district2 = '';\n        this.ruleForm2.address = '';\n      }\n      this.getDistrict(val);\n    },\n    // 查询区\n    getDistrict(val) {\n      let that = this;\n      let province, city;\n      if (val == '0') {\n        province = this.ruleForm1.province;\n        city = this.ruleForm1.city;\n      } else if (val == '1') {\n        province = this.ruleForm2.province1;\n        city = this.ruleForm2.city1;\n      } else if (val == '2') {\n        province = this.ruleForm2.province2;\n        city = this.ruleForm2.city2;\n      }\n      Wb.ajax({\n        url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/select_district',\n        params: {\n          I_PRO_CODE: province,\n          I_AREA_CODE: city ? city.substring(0, 4) : ''\n        },\n        success: function (resp) {\n          let rec = Wb.decode(resp).items;\n          console.log(\"区\", rec);\n          if (val == '0') {\n            that.districtOptions = rec.map(item => ({\n              label: item.area_name,\n              value: item.area_code\n            }));\n          } else if (val == '1') {\n            that.districtOptions1 = rec.map(item => ({\n              label: item.area_name,\n              value: item.area_code\n            }));\n          } else if (val == '2') {\n            that.districtOptions2 = rec.map(item => ({\n              label: item.area_name,\n              value: item.area_code\n            }));\n          }\n\n        }\n      });\n    },\n    // 关联人弹窗 自然人/法人切换时重置弹窗数据\n    resetForm(form) {\n      this.editForm.birthday = '';\n      this.editForm.is_government_dept = '';\n      this.editForm.id_type = '';\n      this.editForm.id_no = '';\n    },\n    // 查询所有关联主体附件信息\n    selectFile() {\n      console.log(\"执行了selectFile\")\n      let that = this;\n      // 机构户附件\n      let fileType1 = {\n        'basicInfo': '1,2,21,22',\n        'LegalRep': '23',\n        'controllingShareholder': '3,31,32',\n        'actualController': '4,41,42',\n        'authorizedRep': '5,51',\n        'beneficialOwner': '6,61,62,63',\n      }\n      // 个人户附件\n      let fileType2 = {\n        'basicInfo': '1,2'\n      }\n      if (this.organ_flag == '1') {\n        for (const key in fileType1) {\n          Wb.ajax({\n            url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/files/select_file',\n            params: {\n              I_CLIENT_ID: '_$client_id$_',\n              I_FILE_TYPE_NO: fileType1[key]\n            },\n            success(resp) {\n              let rows = Wb.decode(resp).items\n              that.attachmentList[key] = rows;\n            }\n          })\n        }\n      } else {\n        for (const key in fileType2) {\n          Wb.ajax({\n            url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/files/select_file',\n            params: {\n              I_CLIENT_ID: '_$client_id$_',\n              I_FILE_TYPE_NO: fileType2[key]\n            },\n            success(resp) {\n              let rows = Wb.decode(resp).items\n              that.attachmentList[key] = rows;\n              console.log(\"that.attachmentList.\" + key, that.attachmentList[key])\n            }\n          })\n        }\n      }\n      // 反洗钱特殊情况 对文件细致分类过的回显时单独用object_id查询\n      const fxq_special_arr = ['communication', 'agree', 'other']\n      fxq_special_arr.forEach(item => {\n        Wb.ajax({\n          url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/files/select_file',\n          params: {\n            I_CLIENT_ID: '_$client_id$_',\n            I_OBJECT_ID: '_$client_id$_' + item\n          },\n          success(resp) {\n            let rows = Wb.decode(resp).items\n            that.attachmentList[item] = rows;\n          }\n        })\n      })\n    },\n    // 查询所有维护过的自然人/机构主体名称\n    selectRelaOptions(organ_flag) {\n      let that = this;\n      Wb.ajax({\n        url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/select_organ_entity',\n        params: {\n          CLIENT_ID: '_$client_id$_',\n          ORGAN_FLAG: organ_flag\n        },\n        success(resp) {\n          let res = Wb.decode(resp).items;\n          if (res && res.length > 0) {\n            const uniqueMap = new Map();\n            res.forEach(item => {\n              const key = item.related_name + '_' + item.id_no + '_' + item.id_type;\n              if (!uniqueMap.has(key)) {\n                uniqueMap.set(key, item);\n              }\n            });\n            that.curRelaOptions = Array.from(uniqueMap.values());\n          } else {\n            that.curRelaOptions = [];\n          }\n        }\n      })\n    },\n    setRelaValue(related_name, form) {\n      const exist = this.curRelaOptions.find(item => item.related_name === related_name);\n      if (exist && form == 'form') {\n        const selectedRela = this.curRelaOptions.find(item => item.related_name === this.editForm.related_name);\n        this.editForm.birthday = selectedRela.birthday;\n        this.editForm.is_government_dept = selectedRela.is_government_dept;\n        this.editForm.id_type = selectedRela.id_type;\n        this.editForm.id_no = selectedRela.id_no;\n        this.editForm.id_begindate = selectedRela.id_begindate;\n        this.editForm.id_enddate = selectedRela.id_enddate;\n        this.editForm.nationality = selectedRela.nationality;\n      } else if (exist && form == 'form1') {\n        const selectedRela = this.curRelaOptions.find(item => item.related_name === this.editForm1.related_name);\n        this.editForm1.birthday = selectedRela.birthday;\n        this.editForm1.is_government_dept = selectedRela.is_government_dept;\n        this.editForm1.id_type = selectedRela.id_type;\n        this.editForm1.id_no = selectedRela.id_no;\n        this.editForm1.id_begindate = selectedRela.id_begindate;\n        this.editForm1.id_enddate = selectedRela.id_enddate;\n        this.editForm1.nationality = selectedRela.nationality;\n      }\n    },\n    // 删除关联人\n    deleteRalated(item) {\n      console.log(\"点击了删除item\", item);\n      let that = this;\n      Wb.ajax({\n        url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/delete_single_entity',\n        params: {\n          CLIENT_ID: '_$client_id$_',\n          ORGAN_FLAG: item.organ_flag,\n          RELATED_TYPE: item.related_type,\n          RELATED_ID: item.related_id,\n          DATA_STATUS: item.data_status\n        },\n        success(resp) {\n          Wb.tipSucc(\"删除成功\");\n          that.getRelatedInfo('_$client_id$_', item.related_type);\n        }\n      });\n    },\n    downloadPdf() {\n      this.getBasicInfo('_$client_id$_');\n      const htmlContent = document.getElementById('pdf-container' + this._uid);\n      const clone = htmlContent.cloneNode(true);\n      clone.style.backgroundColor = '#ffffff'; // 确保背景白色\n      clone.style.padding = '20px';\n      clone.style.width = '1800px';\n      clone.style.maxWidth = 'none';\n\n      document.body.appendChild(clone);\n\n      setTimeout(() => {\n        html2canvas(clone, {\n          scale: window.devicePixelRatio,//2,\n          useCORS: true,\n          allowTaint: false,\n          backgroundColor: \"#ffffff\",\n          fontSize: '24px',\n          boxSizing: 'border-box',\n          // scrollX: 0,\n          // scrollY: -window.scrollY\n        }).then(canvas => {\n          const contentWidth = canvas.width;\n          const contentHeight = canvas.height;\n\n          const pageWidth = 595.28; // A4 pt 宽度\n          const pageHeight = 841.89; // A4 pt 高度\n          const imgWidth = pageWidth - 40; // 两边各留 20pt 边距\n          const imgHeight = (imgWidth / contentWidth) * contentHeight;\n\n          const pageData = canvas.toDataURL('image/jpeg', 1.0);\n          console.log(\"pageData.length\", pageData.length / (1024 * 1024) + \"MB\");\n          const pdf = new jsPDF('', 'pt', 'a4');\n\n          let leftHeight = imgHeight;\n          let position = 0;\n\n          if (leftHeight < pageHeight) {\n            pdf.addImage(pageData, 'JPEG', 20, 0, imgWidth, imgHeight);\n          } else {\n            while (leftHeight > 0) {\n              pdf.addImage(pageData, 'JPEG', 20, position, imgWidth, imgHeight);\n              leftHeight -= pageHeight;\n              position -= pageHeight;\n\n              if (leftHeight > 0) {\n                pdf.addPage();\n              }\n            }\n          }\n          // pdf.save(\"客户基本信息表-【\" + '_$client_name$_' + '(' + '_$client_id$_' + ')' + \"】\" + \".pdf\");\n          pdf.save(\"客户基本信息表-【\" + ('_$organ_flag$_' === '1' ? this.ruleForm1.client_name : this.ruleForm2.client_name) + '(' + '_$client_id$_' + ')' + \"】\" + \".pdf\");\n          document.body.removeChild(clone);\n        }).catch(err => {\n          console.error('PDF导出失败', err);\n          document.body.removeChild(clone);\n        });\n      }, 500);\n    },\n    openFileDialog(menu) {\n      this.fileList = [];\n      this.selectedMenu = menu;\n      let curMenu = Number(String(menu)[0]);\n      let directoryConfig = this.organ_flag == '1' ? this.directoryConfig1 : this.directoryConfig2;\n      directoryConfig.forEach(item => {\n        item.disabled = true;\n      });\n      let targetItem = directoryConfig.find(item => item.value === curMenu);\n      if (targetItem) {\n        targetItem.disabled = false;\n      }\n      this.fileDialogVisible = true;\n    },\n    handleChange(file, fileList) {\n      this.fileList = fileList\n    },\n    handleChange1(file, fileList) {\n      this.attachmentList.communication = fileList\n    },\n    handleChange2(file, fileList) {\n      this.attachmentList.agree = fileList\n    },\n    handleChange3(file, fileList) {\n      this.attachmentList.other = fileList\n    },\n    handleDelete(index) {\n\n    },\n    // 下载附件\n    handleDownload(row) {\n      console.log(\"当前文件row\", row);\n      Wb.download({\n        url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/files/download_file',\n        params: {\n          id: row.id,\n          full_name: row.name + '.' + row.extension\n        }\n      })\n      // this.$message.success(`开始下载：${row.name}`);\n    },\n    uploadFile(file) {\n      let that = this;\n      return new Promise((resolve) => {\n        Wb.ajax({\n          url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/files/upload_file1',\n          params: this.uploadParams,\n          success(resp) {\n            that.$message.success('上传成功');;\n            resolve(); // 上传完成时resolve\n          },\n          error() {\n            resolve(); // 即使出错也要resolve，确保计数器能继续\n          }\n        });\n      });\n    },\n    submitUpload() {\n      console.log(\"this.fileList\", this.fileList);\n      console.log(\"this.selectedMenu\", this.selectedMenu);\n      if (this.fileList.length === 0) {\n        this.$message.warning(\"请至少选择一个文件\");\n        return;\n      }\n      if (this.selectedMenu.length === 0) {\n        this.$message.warning(\"请选择附件类型\");\n        return;\n      }\n\n      // this.uploadParams.file_type_no = this.selectedMenu;\n      this.uploadParams.file_type_no = Array.isArray(this.selectedMenu) ? this.selectedMenu[this.selectedMenu.length - 1] : this.selectedMenu;\n\n      // 使用计数器跟踪上传完成情况\n      let completedCount = 0;\n      const totalFiles = this.fileList.length;\n\n      const checkAllCompleted = () => {\n        completedCount++;\n        if (completedCount === totalFiles) {\n          // 所有文件都上传完成后，设置弹窗不可见\n          // this.loadAttachments(this.selectedMenu.value);\n          this.selectFile();\n          this.fileDialogVisible = false;\n        }\n      };\n\n      for (const file of this.fileList) {\n        this.uploadParams.file1 = file.raw;\n        this.uploadFile(file).then(() => {\n          // 使用setTimeout确保异步执行，避免阻塞\n          setTimeout(checkAllCompleted, 0);\n        });\n      }\n      // console.log(\"this.fileList\", this.fileList);\n      // console.log(\"this.selectedMenu\", this.selectedMenu);\n      // if (this.fileList.length === 0) {\n      //   Wb.tipWarn(\"请至少选择一个文件\");\n      //   return;\n      // }\n      // if (this.selectedMenu.length === 0) {\n      //   Wb.tipWarn(\"请选择附件类型\");\n      //   return;\n      // }\n      // this.uploadParams.file_type_no = this.selectedMenu\n      // this.$refs.upload.submit();\n      // this.selectFile();\n      // this.fileDialogVisible = false;\n\n    },\n    closeDialog(form) {\n      if (form == '1') {\n        // 清除校验提示\n        this.$refs.editForm.clearValidate();\n        // 关闭弹窗\n        this.dialogFormVisible = false;\n      } else if (form == '2') {\n        // 清除校验提示\n        this.$refs.editForm1.clearValidate();\n        // 关闭弹窗\n        this.dialogFormVisible1 = false;\n      } else if (form == '3') {\n        this.fileDialogVisible = false;\n      }\n\n    },\n    // 显示弹窗\n    showDialog(op_flag, item, related_type) {\n      let title = this.formatDictMap('related_type_list', related_type);\n\n      let initFormCommon = (formObj, newItem, isNew) => {\n        formObj.related_name = newItem ? newItem.related_name : '';\n        formObj.organ_flag = newItem ? newItem.organ_flag : '0';\n        formObj.nationality = newItem ? newItem.nationality : '';\n        formObj.id_type = newItem ? newItem.id_type : '';\n        formObj.id_no = newItem ? newItem.id_no : '';\n        formObj.id_begindate = newItem ? newItem.id_begindate : '';\n        formObj.id_enddate = newItem ? newItem.id_enddate : '';\n        formObj.is_government_dept = newItem ? newItem.is_government_dept : '';\n        formObj.birthday = newItem ? newItem.birthday : '';\n        formObj.related_type = related_type; // 当前操作的类型\n        formObj.data_status = newItem ? newItem.data_status : '0';\n        formObj.title = title;\n        formObj.new_flag = isNew;\n        formObj.beneficiary = (related_type == '5' && newItem) ? newItem.beneficiary : '';\n        formObj.shareholding_ratio = (related_type == '5' && newItem) ? newItem.shareholding_ratio : '';\n        formObj.address = (related_type == '5' && newItem) ? newItem.address : '';\n        // formObj.beneficiary = related_type == '5' ? newItem.beneficiary : '';\n        // formObj.shareholding_ratio = related_type == '5' ? newItem.shareholding_ratio : '';\n        // formObj.address = related_type == '5' ? newItem.address : '';\n        // 用于存储编辑时的完整 batchList 数据\n        formObj._tempBatchList = [];\n      };\n\n      // 1. 控股股东 (2) 和 实控人 (3) - 使用 editForm\n      if ((related_type == '2' || related_type == '3')) {\n        if (op_flag == '1') {\n          console.log(\"新增 - 控股股东/实控人\");\n          initFormCommon(this.editForm, null, true);\n\n          this.dialogFormVisible = true;\n        } else if (op_flag == '2') {\n          console.log(\"编辑 - 控股股东/实控人，正在查询全量类型...\");\n          let that = this;\n          Wb.ajax({\n            url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/select_organ_entity',\n            params: {\n              CLIENT_ID: '_$client_id$_',\n              ORGAN_FLAG: item.organ_flag,\n              RELATED_NAME: item.related_name\n            },\n            success: function (resp) {\n              let res = Wb.decode(resp).items || [];\n              let batchList = [];\n\n              for (let i = 0; i < res.length; i++) {\n                let pItem = res[i];\n                let dataObj = {\n                  CLIENT_ID: '_$client_id$_',\n                  RELATED_TYPE: String(pItem.related_type),\n                  RELATED_NAME: pItem.related_name,\n                  ORGAN_FLAG: pItem.organ_flag,\n                  ID_TYPE: pItem.id_type,\n                  ID_NO: pItem.id_no,\n                  ID_BEGINDATE: pItem.id_begindate,\n                  ID_ENDDATE: pItem.id_enddate,\n                  NATIONALITY: pItem.nationality,\n                  BIRTHDAY: pItem.birthday,\n                  IS_GOVERNMENT_DEPT: pItem.is_government_dept,\n                  DATA_STATUS: pItem.data_status,\n                  OBJECT_ID: '',\n                  BENEFICIARY: pItem.beneficiary || '',\n                  SHAREHOLDING_RATIO: pItem.shareholding_ratio || '',\n                  ADDRESS: pItem.address || ''\n                };\n                batchList.push(dataObj);\n              }\n\n              initFormCommon(that.editForm, item, false);\n              that.editForm._tempBatchList = batchList;\n              that.editForm.related_id = item.related_id;\n\n              console.log(\"编辑初始化完成，batchList:\", batchList);\n              that.dialogFormVisible = true;\n            }\n          });\n          return;\n        }\n      }\n      // 2. 法定代表人 (1)、授权代表人 (4)、受益所有人 (5) - 使用 editForm1\n      else if (related_type !== '2' && related_type !== '3') {\n        if (op_flag == '1') {\n          console.log(\"新增 - 法人/授权/受益人\");\n          // Object.assign(this.editForm1, {\n          //   related_name: '',\n          //   organ_flag: '0',\n          //   nationality: '',\n          //   id_type: '',\n          //   id_no: '',\n          //   id_begindate: '',\n          //   id_enddate: '',\n          //   birthday: '',\n          //   related_type: related_type,\n          //   data_status: '0',\n          //   title: title,\n          //   new_flag: true,\n          //   _tempBatchList: [],\n          //   beneficiary: '',\n          //   shareholding_ratio: '',\n          //   address: ''\n          // });\n          initFormCommon(this.editForm1, null, true);\n          // this.editForm1.beneficiary = '';\n          // this.editForm1.shareholding_ratio = '';\n          // this.editForm1.address = '';\n          this.dialogFormVisible1 = true;\n        } else if (op_flag == '2') {\n          console.log(\"编辑 - 法人/授权/受益人，正在查询全量类型...\");\n          let that = this;\n          Wb.ajax({\n            url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/select_organ_entity',\n            params: {\n              CLIENT_ID: '_$client_id$_',\n              ORGAN_FLAG: item.organ_flag,\n              RELATED_NAME: item.related_name\n            },\n            success: function (resp) {\n              let res = Wb.decode(resp).items || [];\n              let batchList = [];\n\n              for (let i = 0; i < res.length; i++) {\n                let pItem = res[i];\n                let dataObj = {\n                  CLIENT_ID: '_$client_id$_',\n                  RELATED_TYPE: String(pItem.related_type),\n                  RELATED_NAME: pItem.related_name,\n                  ORGAN_FLAG: pItem.organ_flag,\n                  ID_TYPE: pItem.id_type,\n                  ID_NO: pItem.id_no,\n                  ID_BEGINDATE: pItem.id_begindate,\n                  ID_ENDDATE: pItem.id_enddate,\n                  NATIONALITY: pItem.nationality,\n                  BIRTHDAY: pItem.birthday,\n                  IS_GOVERNMENT_DEPT: pItem.is_government_dept,\n                  DATA_STATUS: pItem.data_status,\n                  OBJECT_ID: pItem.related_id || '',\n                  BENEFICIARY: pItem.beneficiary || '',\n                  SHAREHOLDING_RATIO: pItem.shareholding_ratio || '',\n                  ADDRESS: pItem.address || ''\n                };\n                batchList.push(dataObj);\n              }\n\n              that.$set(that.editForm1, 'related_name', item.related_name);\n              that.$set(that.editForm1, 'organ_flag', item.organ_flag || '0');\n              that.$set(that.editForm1, 'nationality', item.nationality || '');\n              that.$set(that.editForm1, 'id_type', item.id_type || '');\n              that.$set(that.editForm1, 'id_no', item.id_no || '');\n              that.$set(that.editForm1, 'id_begindate', item.id_begindate || '');\n              that.$set(that.editForm1, 'id_enddate', item.id_enddate || '');\n              that.$set(that.editForm1, 'birthday', item.birthday || '');\n              that.$set(that.editForm1, 'is_government_dept', item.is_government_dept || '');\n              that.$set(that.editForm1, 'related_type', related_type); // 确保是当前的 type\n              that.$set(that.editForm1, 'data_status', item.data_status || '0');\n              that.$set(that.editForm1, 'title', title);\n              that.$set(that.editForm1, 'new_flag', false);\n              that.$set(that.editForm1, 'related_id', item.related_id);\n              that.$set(that.editForm1, '_tempBatchList', batchList);\n\n              // 受益所有人特有字段\n              if (String(item.related_type) === '5') {\n                that.$set(that.editForm1, 'beneficiary', item.beneficiary || '');\n                that.$set(that.editForm1, 'shareholding_ratio', item.shareholding_ratio || null);\n                that.$set(that.editForm1, 'address', item.address || '');\n\n                // 受益所有权相关新增字段\n                that.$set(that.editForm1, 'gender', item.gender || '');\n                that.$set(that.editForm1, 'mobno1', item.mobno1 || '');\n                that.$set(that.editForm1, 'mobno2', item.mobno2 || '');\n                that.$set(that.editForm1, 'bnf_type', item.bnf_type || '');// TODO 这个是多选，select值是数组\n                that.$set(that.editForm1, 'bnf_type_array', (item.bnf_type || '') ? (item.bnf_type || '').split(',') : []);\n                that.$set(that.editForm1, 'acthdrat', item.acthdrat || '');\n                that.$set(that.editForm1, 'shareratiostartdate', item.shareratiostartdate || '');\n                that.$set(that.editForm1, 'shareratioenddate', item.shareratioenddate || '');\n                that.$set(that.editForm1, 'actctrlcpny', item.actctrlcpny || '');\n                that.$set(that.editForm1, 'actctrltype', item.actctrltype || ''); // TODO 这个是多选，select值是数组\n                that.$set(that.editForm1, 'actctrltype_array', (item.actctrltype || '') ? (item.actctrltype || '').split(',') : []);\n                that.$set(that.editForm1, 'obtainactdate', item.obtainactdate || '');\n                that.$set(that.editForm1, 'terminationactdate', item.terminationactdate || '');\n                that.$set(that.editForm1, 'actotherforms', item.actotherforms || '');\n                that.$set(that.editForm1, 'actconuppermarket', item.actconuppermarket || '');\n                that.$set(that.editForm1, 'actconupperentname', item.actconupperentname || '');\n                that.$set(that.editForm1, 'actconuniscid', item.actconuniscid || '');\n                that.$set(that.editForm1, 'actownerprofitratio', item.actownerprofitratio || '');\n                that.$set(that.editForm1, 'profitratiostartdate', item.profitratiostartdate || '');\n                that.$set(that.editForm1, 'profitratioenddate', item.profitratioenddate || '');\n                that.$set(that.editForm1, 'actownerprofitratiovote', item.actownerprofitratiovote || '');\n                that.$set(that.editForm1, 'profitratiovotestartdate', item.profitratiovotestartdate || '');\n                that.$set(that.editForm1, 'profitratiovoteenddate', item.profitratiovoteenddate || '');\n                that.$set(that.editForm1, 'seniormgrpos', item.seniormgrpos || ''); // // TODO 这个是多选，select值是数组\n                that.$set(that.editForm1, 'seniormgrpos_array', (item.seniormgrpos || '') ? (item.seniormgrpos || '').split(',') : []);\n                that.$set(that.editForm1, 'actdailymgmtpostother', item.actdailymgmtpostother || '');\n                that.$set(that.editForm1, 'seniormgrposcn', item.seniormgrposcn || ''); // // TODO 这个是多选，select值是数组\n                that.$set(that.editForm1, 'seniormgrposcn_array', (item.seniormgrposcn || '') ? (item.seniormgrposcn || '').split(',') : []);\n                that.$set(that.editForm1, 'ownerrightmgmtpostother', item.ownerrightmgmtpostother || '');\n              }\n\n              console.log(\"编辑初始化完成，batchList:\", batchList);\n              that.dialogFormVisible1 = true;\n            }\n          });\n          return;\n        }\n      }\n    },\n\n    // 提交关联主体弹窗\n    saveEditForm(op_flag, form) {\n      let that = this;\n\n      // 1. 表单校验\n      let validSucc = this.submitForm(form);\n      if (!validSucc) {\n        return;\n      }\n\n      let currentForm = (form == '1') ? this.editForm : this.editForm1;\n      let dialogVisibleProp = (form == '1') ? 'dialogFormVisible' : 'dialogFormVisible1';\n      let currentRelatedType = String(currentForm.related_type);\n\n      // 公共字段\n      let baseParams = {\n        CLIENT_ID: '_$client_id$_',\n        RELATED_NAME: currentForm.related_name,\n        ORGAN_FLAG: currentForm.organ_flag,\n        ID_TYPE: currentForm.id_type,\n        ID_NO: currentForm.id_no,\n        ID_BEGINDATE: currentForm.id_begindate,\n        ID_ENDDATE: currentForm.id_enddate,\n        NATIONALITY: currentForm.nationality,\n        BIRTHDAY: currentForm.birthday,\n        IS_GOVERNMENT_DEPT: currentForm.is_government_dept,\n        DATA_STATUS: currentForm.data_status || '0'\n      };\n\n      // 受益人特有参数 (仅当当前正在编辑受益人弹窗时才取新值，否则留空待处理)\n      let newBeneficiaryParams = {};\n      console.log(\"currentRelatedType\", currentRelatedType)\n      if (currentRelatedType === '5') {\n        newBeneficiaryParams.BENEFICIARY = currentForm.beneficiary || '';\n        newBeneficiaryParams.SHAREHOLDING_RATIO = currentForm.shareholding_ratio || '';\n        newBeneficiaryParams.ADDRESS = currentForm.address || '';\n\n        // 受益所有权相关新增字段\n        newBeneficiaryParams.ACTHDRAT = currentForm.acthdrat || '';\n        newBeneficiaryParams.GENDER = currentForm.gender || '';\n        newBeneficiaryParams.MOBNO1 = currentForm.mobno1 || '';\n        newBeneficiaryParams.MOBNO2 = currentForm.mobno2 || '';\n        newBeneficiaryParams.BNF_TYPE = (currentForm.bnf_type_array || []).join(',');\n        newBeneficiaryParams.SHARERATIOSTARTDATE = currentForm.shareratiostartdate || '';\n        newBeneficiaryParams.SHARERATIOENDDATE = currentForm.shareratioenddate || '';\n        newBeneficiaryParams.ACTCTRLCPNY = currentForm.actctrlcpny || '';\n        newBeneficiaryParams.ACTCTRLTYPE = (currentForm.actctrltype_array || []).join(',');\n        newBeneficiaryParams.OBTAINACTDATE = currentForm.obtainactdate || '';\n        newBeneficiaryParams.TERMINATIONACTDATE = currentForm.terminationactdate || '';\n        newBeneficiaryParams.ACTOTHERFORMS = currentForm.actotherforms || '';\n        newBeneficiaryParams.ACTCONUPPERMARKET = currentForm.actconuppermarket || '';\n        newBeneficiaryParams.ACTCONUPPERENTNAME = currentForm.actconupperentname || '';\n        newBeneficiaryParams.ACTCONUNISCID = currentForm.actconuniscid || '';\n        newBeneficiaryParams.ACTOWNERPROFITRATIO = currentForm.actownerprofitratio || '';\n        newBeneficiaryParams.PROFITRATIOSTARTDATE = currentForm.profitratiostartdate || '';\n        newBeneficiaryParams.PROFITRATIOENDDATE = currentForm.profitratioenddate || '';\n        newBeneficiaryParams.ACTOWNERPROFITRATIOVOTE = currentForm.actownerprofitratiovote || '';\n        newBeneficiaryParams.PROFITRATIOVOTESTARTDATE = currentForm.profitratiovotestartdate || '';\n        newBeneficiaryParams.PROFITRATIOVOTEENDDATE = currentForm.profitratiovoteenddate || '';\n        newBeneficiaryParams.SENIORMGRPOS = (currentForm.seniormgrpos_array || []).join(',');\n        newBeneficiaryParams.ACTDAILYMGMTPOSTOTHER = currentForm.actdailymgmtpostother || '';\n        newBeneficiaryParams.SENIORMGRPOSCN = (currentForm.seniormgrposcn_array || []).join(',');\n        newBeneficiaryParams.OWNERRIGHTMGMTPOSTOTHER = currentForm.ownerrightmgmtpostother || '';\n      }\n\n      // 2. 新增\n      if (currentForm.new_flag) {\n        let targetRelatedType = currentForm.related_type;\n        let targetTitle = that.formatDictMap('related_type_list', targetRelatedType);\n\n        Wb.ajax({\n          url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/select_organ_entity',\n          params: {\n            CLIENT_ID: '_$client_id$_',\n            ORGAN_FLAG: baseParams.ORGAN_FLAG,\n            RELATED_NAME: baseParams.RELATED_NAME\n          },\n          success: function (resp) {\n            let res = Wb.decode(resp).items || [];\n            let hasDuplicate = false;\n\n            for (let i = 0; i < res.length; i++) {\n              if (String(res[i].related_name) === String(baseParams.RELATED_NAME) &&\n                String(res[i].related_type) === String(targetRelatedType)) {\n                hasDuplicate = true;\n                break;\n              }\n            }\n\n            if (hasDuplicate) {\n              Wb.error(\"已存在主体名称为“\" + baseParams.RELATED_NAME + \"”的【\" + targetTitle + \"】信息，请勿重复添加！\");\n              return;\n            }\n\n            let saveData = {};\n            for (let key in baseParams) { saveData[key] = baseParams[key]; }\n            saveData.RELATED_TYPE = targetRelatedType;\n            saveData.OBJECT_ID = '';\n            saveData.CREATE_USER = '_$sys.username$_';\n            saveData.UPDATE_USER = '_$sys.username$_';\n\n            // 如果是新增受益人，加上特有字段\n            if (String(targetRelatedType) === '5') {\n              saveData.BENEFICIARY = newBeneficiaryParams.BENEFICIARY;\n              saveData.SHAREHOLDING_RATIO = newBeneficiaryParams.SHAREHOLDING_RATIO;\n              saveData.ADDRESS = newBeneficiaryParams.ADDRESS;\n\n              // 受益所有权相关新增字段\n              saveData.ACTHDRAT = newBeneficiaryParams.ACTHDRAT || '';\n              saveData.GENDER = newBeneficiaryParams.GENDER || '';\n              saveData.MOBNO1 = newBeneficiaryParams.MOBNO1 || '';\n              saveData.MOBNO2 = newBeneficiaryParams.MOBNO2 || '';\n              saveData.BNF_TYPE = newBeneficiaryParams.BNF_TYPE || '';\n              saveData.SHARERATIOSTARTDATE = newBeneficiaryParams.SHARERATIOSTARTDATE || '';\n              saveData.SHARERATIOENDDATE = newBeneficiaryParams.SHARERATIOENDDATE || '';\n              saveData.ACTCTRLCPNY = newBeneficiaryParams.ACTCTRLCPNY || '';\n              saveData.ACTCTRLTYPE = newBeneficiaryParams.ACTCTRLTYPE || '';\n              saveData.OBTAINACTDATE = newBeneficiaryParams.OBTAINACTDATE || '';\n              saveData.TERMINATIONACTDATE = newBeneficiaryParams.TERMINATIONACTDATE || '';\n              saveData.ACTOTHERFORMS = newBeneficiaryParams.ACTOTHERFORMS || '';\n              saveData.ACTCONUPPERMARKET = newBeneficiaryParams.ACTCONUPPERMARKET || '';\n              saveData.ACTCONUPPERENTNAME = newBeneficiaryParams.ACTCONUPPERENTNAME || '';\n              saveData.ACTCONUNISCID = newBeneficiaryParams.ACTCONUNISCID || '';\n              saveData.ACTOWNERPROFITRATIO = newBeneficiaryParams.ACTOWNERPROFITRATIO || '';\n              saveData.PROFITRATIOSTARTDATE = newBeneficiaryParams.PROFITRATIOSTARTDATE || '';\n              saveData.PROFITRATIOENDDATE = newBeneficiaryParams.PROFITRATIOENDDATE || '';\n              saveData.ACTOWNERPROFITRATIOVOTE = newBeneficiaryParams.ACTOWNERPROFITRATIOVOTE || '';\n              saveData.PROFITRATIOVOTESTARTDATE = newBeneficiaryParams.PROFITRATIOVOTESTARTDATE || '';\n              saveData.PROFITRATIOVOTEENDDATE = newBeneficiaryParams.PROFITRATIOVOTEENDDATE || '';\n              saveData.SENIORMGRPOS = newBeneficiaryParams.SENIORMGRPOS || '';\n              saveData.ACTDAILYMGMTPOSTOTHER = newBeneficiaryParams.ACTDAILYMGMTPOSTOTHER || '';\n              saveData.SENIORMGRPOSCN = newBeneficiaryParams.SENIORMGRPOSCN || '';\n              saveData.OWNERRIGHTMGMTPOSTOTHER = newBeneficiaryParams.OWNERRIGHTMGMTPOSTOTHER || '';\n            }\n\n            let batchList = [saveData];\n\n            Wb.ajax({\n              url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/save_organ_entity',\n              params: { batchList: batchList },\n              success: function (saveResp) {\n                Wb.tipSucc(\"添加成功\");\n                that.getRelatedInfo('_$client_id$_', targetRelatedType);\n\n                if (op_flag == '2') {\n                  that[dialogVisibleProp] = false;\n                }\n\n                let relaType = currentForm.related_type;\n                if (form == '1') {\n                  that.editForm = {\n                    related_name: '', organ_flag: '0', nationality: '', id_type: '', id_no: '',\n                    id_begindate: '', id_enddate: '', is_government_dept: '', birthday: '',\n                    related_type: relaType, data_status: '0', title: that.formatDictMap('related_type_list', relaType),\n                    new_flag: true, _tempBatchList: []\n                  };\n                  if (that.$refs.editForm) that.$refs.editForm.clearValidate();\n                } else {\n                  that.editForm1 = {\n                    related_name: '', organ_flag: '0', nationality: '', id_type: '', id_no: '',\n                    id_begindate: '', id_enddate: '', is_government_dept: '', birthday: '',\n                    beneficiary: '', shareholding_ratio: '', address: '',\n                    related_type: relaType, data_status: '0', title: that.formatDictMap('related_type_list', relaType),\n                    new_flag: true, _tempBatchList: []\n                  };\n                }\n              }\n            });\n          }\n        });\n\n      }\n      // 3. 编辑\n      else {\n        let batchList = currentForm._tempBatchList || [];\n\n        if (batchList.length === 0) {\n          Wb.error(\"编辑数据异常，未找到关联信息，请重新打开弹窗。\");\n          return;\n        }\n\n        // 更新 batchList\n        for (let i = 0; i < batchList.length; i++) {\n          let item = batchList[i];\n          console.log(\"batchList[i]\", batchList[i])\n          let itemType = String(item.RELATED_TYPE);\n\n          // 1. 更新公共字段\n          item.RELATED_NAME = baseParams.RELATED_NAME;\n          item.ORGAN_FLAG = baseParams.ORGAN_FLAG;\n          item.ID_TYPE = baseParams.ID_TYPE;\n          item.ID_NO = baseParams.ID_NO;\n          item.ID_BEGINDATE = baseParams.ID_BEGINDATE;\n          item.ID_ENDDATE = baseParams.ID_ENDDATE;\n          item.NATIONALITY = baseParams.NATIONALITY;\n          item.BIRTHDAY = baseParams.BIRTHDAY;\n          item.IS_GOVERNMENT_DEPT = baseParams.IS_GOVERNMENT_DEPT;\n          item.DATA_STATUS = baseParams.DATA_STATUS;\n\n          // 2. 受益所有人特有字段\n          if (itemType === '5') {\n            // 判断：只有当当前正在编辑的弹窗也是“受益所有人”(type 5) 时，才更新这三个字段\n            // 如果当前是在编辑其他类型则保留 item 中原有的值，不要用空值覆盖\n            if (currentRelatedType === '5') {\n              item.BENEFICIARY = newBeneficiaryParams.BENEFICIARY;\n              item.SHAREHOLDING_RATIO = newBeneficiaryParams.SHAREHOLDING_RATIO;\n              item.ADDRESS = newBeneficiaryParams.ADDRESS;\n\n              // 受益所有权相关新增字段\n              item.ACTHDRAT = newBeneficiaryParams.ACTHDRAT || '';\n              item.GENDER = newBeneficiaryParams.GENDER || '';\n              item.MOBNO1 = newBeneficiaryParams.MOBNO1 || '';\n              item.MOBNO2 = newBeneficiaryParams.MOBNO2 || '';\n              item.BNF_TYPE = newBeneficiaryParams.BNF_TYPE || '';\n              item.SHARERATIOSTARTDATE = newBeneficiaryParams.SHARERATIOSTARTDATE || '';\n              item.SHARERATIOENDDATE = newBeneficiaryParams.SHARERATIOENDDATE || '';\n              item.ACTCTRLCPNY = newBeneficiaryParams.ACTCTRLCPNY || '';\n              item.ACTCTRLTYPE = newBeneficiaryParams.ACTCTRLTYPE || '';\n              item.OBTAINACTDATE = newBeneficiaryParams.OBTAINACTDATE || '';\n              item.TERMINATIONACTDATE = newBeneficiaryParams.TERMINATIONACTDATE || '';\n              item.ACTOTHERFORMS = newBeneficiaryParams.ACTOTHERFORMS || '';\n              item.ACTCONUPPERMARKET = newBeneficiaryParams.ACTCONUPPERMARKET || '';\n              item.ACTCONUPPERENTNAME = newBeneficiaryParams.ACTCONUPPERENTNAME || '';\n              item.ACTCONUNISCID = newBeneficiaryParams.ACTCONUNISCID || '';\n              item.ACTOWNERPROFITRATIO = newBeneficiaryParams.ACTOWNERPROFITRATIO || '';\n              item.PROFITRATIOSTARTDATE = newBeneficiaryParams.PROFITRATIOSTARTDATE || '';\n              item.PROFITRATIOENDDATE = newBeneficiaryParams.PROFITRATIOENDDATE || '';\n              item.ACTOWNERPROFITRATIOVOTE = newBeneficiaryParams.ACTOWNERPROFITRATIOVOTE || '';\n              item.PROFITRATIOVOTESTARTDATE = newBeneficiaryParams.PROFITRATIOVOTESTARTDATE || '';\n              item.PROFITRATIOVOTEENDDATE = newBeneficiaryParams.PROFITRATIOVOTEENDDATE || '';\n              item.SENIORMGRPOS = newBeneficiaryParams.SENIORMGRPOS || '';\n              item.ACTDAILYMGMTPOSTOTHER = newBeneficiaryParams.ACTDAILYMGMTPOSTOTHER || '';\n              item.SENIORMGRPOSCN = newBeneficiaryParams.SENIORMGRPOSCN || '';\n              item.OWNERRIGHTMGMTPOSTOTHER = newBeneficiaryParams.OWNERRIGHTMGMTPOSTOTHER || '';\n            }\n          }\n        }\n\n        Wb.ajax({\n          url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/update_organ_entity',\n          params: {\n            batchList: batchList\n          },\n          success: function (resp) {\n            let rs = Wb.decode(resp);\n            if (rs.O_RETURN_CODE == '0') {\n              Wb.tipSucc(\"修改成功\");\n              that.getRelatedInfo('_$client_id$_', '1');\n              that.getRelatedInfo('_$client_id$_', '2');\n              that.getRelatedInfo('_$client_id$_', '3');\n              that.getRelatedInfo('_$client_id$_', '4');\n              that.getRelatedInfo('_$client_id$_', '5');\n\n              if (op_flag == '2') {\n                that[dialogVisibleProp] = false;\n              }\n\n              let relaType = currentForm.related_type;\n              if (form == '1') {\n                that.editForm = {\n                  related_name: '', organ_flag: '0', nationality: '', id_type: '', id_no: '',\n                  id_begindate: '', id_enddate: '', is_government_dept: '', birthday: '',\n                  related_type: relaType, data_status: '0', title: that.formatDictMap('related_type_list', relaType),\n                  new_flag: true, _tempBatchList: []\n                };\n                if (that.$refs.editForm) that.$refs.editForm.clearValidate();\n              } else {\n                that.editForm1 = {\n                  related_name: '', organ_flag: '0', nationality: '', id_type: '', id_no: '',\n                  id_begindate: '', id_enddate: '', is_government_dept: '', birthday: '',\n                  beneficiary: '', shareholding_ratio: '', address: '',\n                  related_type: relaType, data_status: '0', title: that.formatDictMap('related_type_list', relaType),\n                  new_flag: true, _tempBatchList: []\n                };\n              }\n            } else {\n              Wb.tipError(rs.O_RETURN_MSG);\n            }\n          }\n        });\n      }\n    },\n\n    // 校验关联主体弹窗\n    submitForm(form) {\n      let props = [];\n      let bool = true;\n      let msg = '';\n\n      // 获取当前表单对象\n      let currentFormObj = (form == '1') ? this.editForm : this.editForm1;\n      let refName = (form == '1') ? 'editForm' : 'editForm1';\n\n      // 如果是反洗钱特殊情况选择了“是”，关联人只校验1法定代表人、4授权代表人和 5受益所有人的姓名（如果打开了实际控制人、控股股东的弹窗则名称还是必填）。\n      if (this.ruleForm3 && this.ruleForm3.is_special == '1') {\n        // if (currentFormObj.related_type == '1' || currentFormObj.related_type == '4' || currentFormObj.related_type == '5') {\n        props = ['related_name'];\n        this.$refs[refName].validateField(props, function (valid) {\n          if (valid) {\n            bool = false;\n            msg += valid + '<br>';\n          }\n        });\n        // }\n      } else {\n        // 如果是反洗钱特殊情况选择了“否”，1法定代表人、4授权代表人和 5受益所有人所有表单项必填 （控股股东和实控人可以为无）\n        if (form == '2' && (currentFormObj.related_type == '1' || currentFormObj.related_type == '4' || currentFormObj.related_type == '5')) {\n          props = ['related_name', 'nationality', 'id_begindate', 'id_enddate', 'id_type', 'id_no'];\n          if (currentFormObj.organ_flag == '1') {\n            props.push('is_government_dept');\n          } else if (currentFormObj.organ_flag == '0') {\n            props.push('birthday');\n          }\n          if (currentFormObj.related_type == '5') {\n            props.push('beneficiary');\n            //props.push('shareholding_ratio');\n            props.push('address');\n            if (currentFormObj.beneficiary == 'A1' || currentFormObj.beneficiary == 'A2' || currentFormObj.beneficiary == 'B1' || currentFormObj.beneficiary == 'D1') {\n              props.push('shareholding_ratio');\n            }\n          }\n          this.$refs[refName].validateField(props, function (valid) {\n            if (valid) { bool = false; msg += valid + '<br>'; }\n          });\n        }\n\n        if (form == '1' && (currentFormObj.related_type == '2' || currentFormObj.related_type == '3')) {\n          props = ['related_name'];\n          if (currentFormObj.organ_flag == '0') {\n            props.push('birthday', 'id_type', 'id_no', 'id_begindate', 'id_enddate', 'nationality');\n          } else if (currentFormObj.organ_flag == '1' && currentFormObj.is_government_dept == '0') {\n            props.push('id_type', 'id_no', 'id_begindate', 'id_enddate', 'nationality');\n          }\n          this.$refs[refName].validateField(props, function (valid) {\n            if (valid) { bool = false; msg += valid + '<br>'; }\n          });\n        }\n      }\n\n      if (!bool && msg) {\n        this.showMessage(msg, 5000, 'error');\n      }\n      return bool;\n    },\n    // 客户基本信息查询\n    getBasicInfo(client_id, data_type) {\n      let that = this;\n      Wb.ajax({\n        url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/select_basic_info',\n        params: {\n          CLIENT_ID: client_id,\n          DATA_TYPE: data_type\n        },\n        success(resp) {\n          let res = Wb.decode(resp).items;\n          console.log(\"getBasicInfo===\", res[0])\n          if (res[0]) {\n            that.basicInfo = res[0];\n            if ('_$organ_flag$_' == '1') {\n              that.ruleForm1 = { ...that.basicInfo };//机构户基本信息数据回显\n              if (that.ruleForm1.register_fund) {\n                that.ruleForm1.register_fund = that.formatMoney(that.ruleForm1.register_fund, '4');\n              }\n              that.uploadParams1.file_type_no = 72;// 与客户沟通记录\n              that.uploadParams2.file_type_no = 73;// 二级部门负责人同意的记录\n              that.uploadParams3.file_type_no = 73;// 其他底稿\n              console.log(\"that.ruleForm1\", that.ruleForm1);\n            } else {\n              that.ruleForm2 = { ...that.basicInfo };//个人户基本信息数据回显\n              that.uploadParams1.file_type_no = 3;// 与客户沟通记录\n              that.uploadParams2.file_type_no = 3;// 二级部门负责人同意的记录\n              that.uploadParams3.file_type_no = 3;// 其他底稿\n              console.log(\"that.ruleForm2\", that.ruleForm2);\n            }\n            that.ruleForm3 = {\n              is_special: that.basicInfo.is_special ? that.basicInfo.is_special : '0',\n              client_type: that.basicInfo.client_type ? that.basicInfo.client_type.split(',') : [],\n              client_type_other: that.basicInfo.client_type_other ? that.basicInfo.client_type_other : '',\n              special_matters: that.basicInfo.special_matters ? that.basicInfo.special_matters.split(',') : [],\n              missing_information: that.basicInfo.missing_information ? that.basicInfo.missing_information : '',\n              missing_draft: that.basicInfo.missing_draft ? that.basicInfo.missing_draft : '',\n              special_matters_other: that.basicInfo.special_matters_other ? that.basicInfo.special_matters_other : '',\n              special_reason: that.basicInfo.special_reason ? that.basicInfo.special_reason : '',\n              completed_cdd: that.basicInfo.completed_cdd ? that.basicInfo.completed_cdd : '',\n              low_risk_explanation: that.basicInfo.low_risk_explanation ? that.basicInfo.low_risk_explanation : '',\n              take_measures: that.basicInfo.take_measures ? that.basicInfo.take_measures : ''\n            };\n          }\n        }\n      });\n    },\n    // 关联主体查询\n    getRelatedInfo(client_id, rela_type) {\n      let that = this;\n      Wb.ajax({\n        url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/select_related_info',\n        params: {\n          CLIENT_ID: client_id,\n          RELATED_TYPE: rela_type,\n          DATA_TYPE: '_$data_type$_'\n        },\n        success(resp) {\n          let res = Wb.decode(resp).items;\n          if (rela_type == '1') {\n            that.relatedInfo1 = res;\n            console.log(\"法定代表人信息\", res);\n          } else if (rela_type == '2') {\n            that.relatedInfo2 = res;\n            console.log(\"控股股东信息\", res);\n          } else if (rela_type == '3') {\n            that.relatedInfo3 = res;\n            console.log(\"实际控制人信息\", res);\n          } else if (rela_type == '4') {\n            that.relatedInfo4 = res;\n            console.log(\"授权代表人信息\", res);\n          } else if (rela_type == '5') {\n            that.relatedInfo5 = res;\n            console.log(\"受益所有人信息\", res);\n          }\n        }\n      });\n    },\n    handleRemove(file, fileList) {\n      let that = this;\n      Wb.ajax({\n        url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/files/delete_file',\n        params: {\n          file_pk_id: file.response\n        },\n        success() {\n          that.fileList = fileList;\n        }\n      })\n    },\n    handleRemove1(file, fileList) {\n      let that = this;\n      Wb.ajax({\n        url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/files/delete_file',\n        params: {\n          file_pk_id: file.id\n        },\n        success() {\n          that.attachmentList.communication = fileList;\n        }\n      })\n    },\n    handleRemove2(file, fileList) {\n      let that = this;\n      Wb.ajax({\n        url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/files/delete_file',\n        params: {\n          file_pk_id: file.id\n        },\n        success() {\n          that.attachmentList.agree = fileList;\n        }\n      })\n    },\n    handleRemove3(file, fileList) {\n      let that = this;\n      Wb.ajax({\n        url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/files/delete_file',\n        params: {\n          file_pk_id: file.id\n        },\n        success() {\n          that.attachmentList.other = fileList;\n        }\n      })\n    },\n    handlePreview(file) {\n      let that = this;\n      params_file = {\n        'id': file.id,\n        'clientId': file.client_id,\n        'fileTypeNo': this.organ_flag == '1' ? '1,2,21,22' : '1,2',\n        'fileName': file.name + '.' + file.extension,\n        'extension': file.extension\n      },\n        Wb.ajax({\n          url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/files/preview_file',\n          params: {\n            id: file.id,\n            clientId: file.client_id,\n            fileTypeNo: this.organ_flag == '1' ? '1,2,21,22' : '1,2',\n            fileName: file.name + '.' + file.extension,\n            extension: file.extension\n          },\n          success(resp) {\n            console.log(\"resp\", resp);\n            let res = Wb.decode(resp);\n            let serverIp = '10.116.131.13';\n            if (res.code == '200') {\n              let previewUrl = res.data.previewUrl;\n              if (previewUrl.indexOf(serverIp) != -1) {\n                previewUrl = res.data.previewUrl.replace(/10\\.116\\.131\\.13:8090/g, '10.181.135.22:8080/ibcm_flow')\n              }\n              window.open(previewUrl, '_blank', 'width=800,height=600')\n            } else {\n              that.$message.error(\"当前文件类型不支持预览\")\n            }\n          }\n        });\n    },\n    handleResizeMouseDown() { },\n    uploadSuccess() {\n      Wb.tipSucc(\"上传成功\");\n      this.fileDialogVisible = false;\n    },\n    uploadError() {\n      app.uploadError();\n    },\n    beforeRemove() {\n      app.beforeRemove();\n    },\n    // 校验主表单\n    submit() {\n      console.log(\"进入了submit方法--------必填校验\");\n      let props = [];\n      let bool = true;\n      let msg = '';\n      // 1.如果是反洗钱特殊情况选择了“是”，则客户基本信息中的字段非必填，只校验ruleForm3反洗钱特殊情况模块，关联人只校验法定代表人、受益所有人和授权代表人的姓名。\n      if (this.ruleForm3.is_special == '1') {\n        console.log(\"this.attachmentList.communication\", this.attachmentList.communication);\n        console.log(\"this.attachmentList.agree\", this.attachmentList.agree);\n        // 1-1 关联人信息 只有机构类型客户（organ_flag='1'）需要维护关联人信息，自然人客户（organ_flag='0'）没有关联人信息\n        const emptyItem1 = this.relatedInfo1.find(item => {\n          return !item || item.related_name === null || item.related_name === undefined || item.related_name === '';\n        });\n        const emptyItem2 = this.relatedInfo4.find(item => {\n          return !item || item.related_name === null || item.related_name === undefined || item.related_name === '';\n        });\n        const emptyItem3 = this.relatedInfo5.find(item => {\n          return !item || item.related_name === null || item.related_name === undefined || item.related_name === '';\n        });\n        if ((emptyItem1 || this.relatedInfo1.length == 0) && this.organ_flag == '1') {\n          this.showMessage(\"请填写法定代表人姓名！\", 3000, 'error');\n          return;\n        }\n        if ((emptyItem2 || this.relatedInfo4.length == 0) && this.organ_flag == '1') {\n          this.showMessage(\"请填写授权代表人姓名！\", 3000, 'error');\n          return;\n        }\n        if ((emptyItem3 || this.relatedInfo5.length == 0) && this.organ_flag == '1') {\n          this.showMessage(\"请填写受益所有人姓名！\", 3000, 'error');\n          return;\n        }\n        // 1-2 附件信息\n        if (this.attachmentList.communication.length == 0) {\n          this.showMessage(\"请上传“与客户沟通记录”文件\", 3000, 'error');\n          return;\n        }\n        if (this.attachmentList.agree.length == 0) {\n          this.showMessage(\"请上传“二级部门负责人同意的记录”文件\", 3000, 'error');\n          return;\n        }\n        // 1-3 特殊情况表单信息\n        props = ['client_type', 'special_matters', 'special_reason', 'completed_cdd', 'low_risk_explanation', 'take_measures', 'communication_records', 'agree_records']\n        if (this.ruleForm3.client_type.indexOf('99') !== -1) {\n          props.push('client_type_other')\n        }\n        if (this.ruleForm3.special_matters.indexOf('1') !== -1) {\n          props.push('missing_information')\n        }\n        if (this.ruleForm3.special_matters.indexOf('2') !== -1) {\n          props.push('missing_draft')\n        }\n        if (this.ruleForm3.special_matters.indexOf('99') !== -1) {\n          props.push('special_matters_other')\n        }\n        this.$refs['ruleForm3'].validateField(props, function (valid) {\n          if (valid) {\n            bool = false;\n            msg += valid + '<br>';\n          } else {\n          }\n        });\n\n      } else {\n        const keys = Object.keys(this.ruleForm3);\n        for (const key of keys) {\n          if (key !== 'is_special') {\n            this.ruleForm3[key] = ''; // 除了is_special字段外，所有字段都清空为空字符串\n          }\n        }\n        // 2.若选择了“否”，则所有表单必填，控股股东与实控人表单允许为无\n        //   只有机构类型客户（organ_flag='1'）需要维护关联人信息，自然人客户（organ_flag='0'）没有关联人信息\n        if (this.relatedInfo1.length == 0 && this.organ_flag == '1') {\n          this.showMessage(\"请添加法定代表人信息！\", 3000, 'error');\n          return;\n        }\n        if (this.relatedInfo4.length == 0 && this.organ_flag == '1') {\n          this.showMessage(\"请添加授权代表人信息！\", 3000, 'error');\n          return;\n        }\n        if (this.relatedInfo5.length == 0 && this.organ_flag == '1') {\n          this.showMessage(\"请添加受益所有人信息！\", 3000, 'error');\n          return;\n        }\n        // if ((this.organ_flag === '1' && !this.ruleForm1.associated_date) ||\n        //   (this.organ_flag === '0' && !this.ruleForm2.associated_date)) {\n        //   this.showMessage(\"请填写“建立业务关系日期”\", 3000, 'error');\n        //   return;\n        // }\n        if (this.organ_flag == '1') {\n          // formNameArr = ['ruleForm1']; - 机构客户基本表单\n          props = ['client_name', 'office_address', 'register_country', 'register_money_type', 'register_fund',\n            'industry_type', 'tel', 'setup_date', 'id_type', 'id_no', 'id_begindate', 'id_enddate', 'busi_scope', 'associated_date'];\n          if (this.ruleForm1.register_country == '00CN') { //只有境内地区要校验省市区\n            props.push('province');\n            props.push('city');\n            props.push('district');\n          }\n          if (this.ruleForm1.industry_type == '26') {\n            props.push('industry_name');\n          }\n          this.$refs['ruleForm1'].validateField(props, function (valid) {\n            if (valid) {\n              bool = false;\n              msg += valid + '<br>';\n            } else {\n            }\n          });\n          // 关联人必填校验\n          const validateRelatedPerson = (infoArray, typeName) => {\n            const isEmpty = (val) => val === null || val === undefined || String(val).trim() === '';\n            const beneficiaryTypesNeedRatio = ['A1', 'A2', 'B1', 'D1'];\n\n            for (let i = 0; i < infoArray.length; i++) {\n              const item = infoArray[i];\n              const index = i + 1;\n\n              // 如果是政府部门，只校验姓名和是否政府部门字段\n              if (item.is_government_dept === '1') {\n                if (isEmpty(item.related_name)) {\n                  bool = false;\n                  msg += `${typeName}的姓名不能为空<br>`;\n                }\n                continue;\n              }\n\n              // 普通必填字段校验\n              if (isEmpty(item.related_name)) {\n                bool = false;\n                msg += `${typeName}的姓名不能为空<br>`;\n              }\n              if (isEmpty(item.nationality)) {\n                bool = false;\n                msg += `${typeName}${item.related_name}的国籍不能为空<br>`;\n              }\n              if (isEmpty(item.id_type)) {\n                bool = false;\n                msg += `${typeName}${item.related_name}的证件类型不能为空<br>`;\n              }\n              if (isEmpty(item.id_no)) {\n                bool = false;\n                msg += `${typeName}${item.related_name}的证件号码不能为空<br>`;\n              }\n              if (isEmpty(item.id_begindate)) {\n                bool = false;\n                msg += `${typeName}${item.related_name}的证件开始日期不能为空<br>`;\n              }\n              if (isEmpty(item.id_enddate)) {\n                bool = false;\n                msg += `${typeName}${item.related_name}的证件结束日期不能为空<br>`;\n              }\n\n              // 如果是机构（organ_flag='1'），校验是否政府部门字段\n              if (item.organ_flag === '1') {\n                if (item.is_government_dept !== '0' && item.is_government_dept !== '1') {\n                  bool = false;\n                  msg += `${typeName}${item.related_name}的是否政府部门不能为空<br>`;\n                }\n              }\n\n              // 如果是个人（organ_flag='0'），校验出生日期字段\n              if (item.organ_flag === '0') {\n                if (isEmpty(item.birthday)) {\n                  bool = false;\n                  msg += `${typeName}${item.related_name}的出生日期不能为空<br>`;\n                }\n              }\n\n              // 受益所有人特殊校验（related_type='5'）\n              if (item.related_type === '5') {\n                if (isEmpty(item.beneficiary)) {\n                  bool = false;\n                  msg += `${typeName}${item.related_name}的受益所有人类型不能为空<br>`;\n                }\n                if (isEmpty(item.address)) {\n                  bool = false;\n                  msg += `${typeName}${item.related_name}的地址不能为空<br>`;\n                }\n                // 如果受益所有人类型是A1/A2/B1/D1，校验股权比例\n                if (beneficiaryTypesNeedRatio.includes(item.beneficiary)) {\n                  if (isEmpty(item.shareholding_ratio)) {\n                    bool = false;\n                    msg += `${typeName}${item.related_name}的股权/表决权比例不能为空<br>`;\n                  }\n                }\n              }\n            }\n          };\n\n          // 校验五种类型的关联人数据\n          validateRelatedPerson(this.relatedInfo1, '法定代表人');\n          validateRelatedPerson(this.relatedInfo2, '控股股东');\n          validateRelatedPerson(this.relatedInfo3, '实际控制人');\n          validateRelatedPerson(this.relatedInfo4, '授权代表人');\n          validateRelatedPerson(this.relatedInfo5, '受益所有人');\n        } else {\n          // formNameArr = ['ruleForm2']; - 自然人客户基本表单\n          props = ['client_name', 'birthday', 'id_address', 'address', 'nationality', 'gender', 'income',\n            'profession_code', 'id_type', 'id_no', 'id_begindate', 'id_enddate', 'associated_date'];\n          if (this.ruleForm2.nationality == '00CN') {\n            props.push('province1');\n            props.push('city1');\n            props.push('district1');\n            props.push('province2');\n            props.push('city2');\n            props.push('district2');\n          }\n          this.$refs['ruleForm2'].validateField(props, function (valid) {\n            if (valid) {\n              bool = false;\n              msg += valid + '<br>';\n            } else {\n\n            }\n          });\n        }\n      }\n      if (!bool && msg) {\n        this.showMessage(msg, 5000, 'error')\n      }\n      return bool;\n    },\n    loadSelectList(item) {\n      let that = this;\n      if (!Wb.isEmpty(item.KEY_NAME)) {\n        Wb.ajax({\n          url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/select_key',\n          params: {\n            I_KEY_NAME: item.KEY_NAME\n          },\n          success(resp) {\n            let arr = Wb.decode(resp).items;\n            that.selectList[item.BIND_DATA + \"_list\"] = arr;\n            console.log(that.selectList, '===that.selectList===');\n          }\n        });\n      }\n    },\n    getDictMap(item) {\n      let that = this;\n      Wb.ajax({\n        url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/select_dict',\n        params: {\n          I_ENTRY_NO: item.ENTRY_NO\n        },\n        success(resp) {\n          let arr = Wb.decode(resp).items;\n          that.selectList[item.BIND_DATA + \"_list\"] = arr;\n          console.log(that.selectList, '===that.selectList===');\n        }\n      })\n    },\n  },\n  watch: {\n  },\n  created: async function () {\n    let that = this;\n    this.activeNav += this._uid;\n    let navList_jg = [\n      {\n        label: '客户基本信息',\n        value: 'basicInfo',\n        name: '#basicInfo'\n      }, {\n        label: '反洗钱特殊情况',\n        value: 'fxqSpecial',\n        name: '#fxqSpecial'\n      }, {\n        label: '法定代表人',\n        value: 'LegalRep',\n        name: '#LegalRep'\n      }, {\n        label: '控股股东',\n        value: 'controllingShareholder',\n        name: '#controllingShareholder'\n      }, {\n        label: '实际控制人',\n        value: 'actualController',\n        name: '#actualController'\n      }, {\n        label: '授权代表人',\n        value: 'authorizedRep',\n        name: '#authorizedRep'\n      }, {\n        label: '受益所有人',\n        value: 'beneficialOwner',\n        name: '#beneficialOwner'\n      },\n    ];\n    let navList_gr = [\n      {\n        label: '客户基本信息',\n        value: 'basicInfo',\n        name: '#basicInfo'\n      }, {\n        label: '反洗钱特殊情况',\n        value: 'fxqSpecial',\n        name: '#fxqSpecial'\n      }\n    ];\n    this.navList = '_$organ_flag$_' === '1' ? navList_jg : navList_gr;\n    this.navList.forEach(ele => {\n      ele.value += that._uid;\n    });\n    // app.data.list.forEach(async item => {\n    //   await this.loadSelectList(item);\n    // });\n\n    // app.data.dict.forEach(async item => {\n    //   await this.getDictMap(item);\n    // });\n    this.getProvince();\n    // 查询客户基本信息\n    await this.getBasicInfo('_$client_id$_', '_$data_type$_');\n    // 获取法定代表人信息\n    await this.getRelatedInfo('_$client_id$_', '1');\n    // 获取控股股东信息\n    await this.getRelatedInfo('_$client_id$_', '2');\n    // 获取实际控制人信息\n    await this.getRelatedInfo('_$client_id$_', '3');\n    // 获取授权代表人信息\n    await this.getRelatedInfo('_$client_id$_', '4');\n    // 获取受益所有人信息\n    await this.getRelatedInfo('_$client_id$_', '5');\n    await this.selectFile();\n\n    // 从全局获取数据\n    console.log('====app.data.dict====', app.data.selectList);\n    console.log('====key====', '_$key$_');\n    console.log('====cur_user====', '_$cur_user$_');\n\n    // this.selectList = { ...app.data.selectList }\n    this.rules = app.data.rules;\n    this.rules1 = app.data.rules1;\n\n    // 为客户基本信息表单添加证件号码格式校验\n    // 需要复制一份 rules，避免影响其他表单\n    this.rules = JSON.parse(JSON.stringify(app.data.rules));\n    if (this.rules.id_no) {\n      this.rules.id_no.push({\n        validator: this.validateIdNoForBasicInfo(),\n        trigger: 'change'\n      });\n    }\n\n    // 为关联人弹窗添加证件号码格式校验\n    this.rules1 = JSON.parse(JSON.stringify(app.data.rules1));\n    if (this.rules1.id_no) {\n      this.rules1.id_no.push({\n        validator: this.validateIdNoForRelated(),\n        trigger: 'change'\n      });\n    }\n    this.loading = false;\n  },\n  mounted: function () {\n  },\n});"}}]},{"_icon":"card","text":"card2","cls":"Wb.Card","properties":{"cid":"card2","title":"附件导入","closable":"null","layout":"fit"},"_expanded":true,"items":[{"_icon":"container","text":"fileManage","cls":"Wb.Container","properties":{"cid":"fileManage"},"events":{"ready":"let comp = this;\ncomp.vue = new Vue({\n  el: comp.el.addEl(),\n  template: `\n<div class=\"file-container\">\n  <!-- 左侧目录树 -->\n  <div class=\"left-panel\" ref=\"leftPanel\">\n    <div class=\"panel-title\">附件类型目录</div>\n    <div class=\"search-box\">\n      <el-input placeholder=\"输入关键字进行过滤\" v-model.trim=\"filterText\" clearable>\n        <i slot=\"prefix\" class=\"el-input__icon el-icon-search\"></i>\n      </el-input>\n    </div>\n\n    <el-tree class=\"filter-tree\" ref=\"tree\" :data=\"organ_flag==='0'?directoryConfig2:directoryConfig1\"\n      :props=\"defaultProps\" default-expand-all :filter-node-method=\"filterNode\" :expand-on-click-node=\"false\"\n      @node-click=\"handleNodeClick\" highlight-current>\n      <span class=\"custom-tree-node\" slot-scope=\"{ node, data }\"\n          :data-node-key=\"data.value\"\n          @dragenter=\"handleTreeDragEnter($event, node, data)\"\n          @dragover=\"handleTreeDragOver($event, node, data)\"\n          @drop=\"handleTreeDrop($event, node, data)\">\n            <span>{{ node.label }}</span>\n      </span>\n    </el-tree>\n  </div>\n\n  <!-- 右侧附件列表 -->\n  <div class=\"right-panel\" style=\"overflow-y:auto\">\n    <div style=\"color:#F56C6C;padding-left:0 0 40px 0;\">【*附件上传后即为保存，将不允许修改和删除，如有错误可用新的同名文件更新替换】</div>\n    <div v-if=\"!selectedMenu\" style=\"display: flex; justify-content: center; align-items: center; height: 100%; color: #909399; font-size: 14px;\">请先从左侧选择目录</div>\n    <div v-else>\n      <div class=\"panel-title\">附件清单 - {{ selectedMenu.label }}</div>\n      <el-table :data=\"attachmentList\" stripe border class=\"attachment-table\" v-loading=\"loading\" :default-sort = \"{prop: 'date', order: 'descending'}\">\n        <el-table-column prop=\"name\" label=\"附件名称\" min-width=\"180\" sortable>\n          <template slot-scope=\"scope\">\n            <el-button type=\"text\" @click=\"handleDownload(scope.row)\" class=\"attachment-btn\" draggable=\"true\"\n              native-type=\"button\" @dragstart.native=\"handleDragStart(scope.row)\">\n              {{ scope.row.name }}\n            </el-button>\n          </template>\n        </el-table-column>\n        <el-table-column prop=\"extension\" label=\"附件类型\" width=\"120\"></el-table-column>\n        <el-table-column prop=\"create_time\" label=\"上传时间\" width=\"160\" sortable></el-table-column>\n        <el-table-column prop=\"file_size\" label=\"附件大小\" width=\"120\">\n          <template slot-scope=\"scope\">\n            {{ formatSize(scope.row.file_size) }}\n          </template>\n        </el-table-column>\n        <el-table-column prop=\"create_by\" label=\"上传人\" width=\"120\" sortable></el-table-column>\n        <el-table-column label=\"操作\" width=\"150\" fixed=\"right\">\n          <template slot-scope=\"scope\">\n            <div class=\"operation-buttons\">\n              <el-tooltip content=\"预览\">\n                <el-button type=\"text\" class=\"el-icon-view\" @click=\"handlePreview(scope.row)\"></el-button>\n              </el-tooltip>\n              <el-tooltip content=\"下载\">\n                <el-button type=\"text\" class=\"el-icon-download\" @click=\"handleDownload(scope.row)\"></el-button>\n              </el-tooltip>\n              <!--<el-tooltip content=\"删除\">\n                <el-button type=\"text\" class=\"el-icon-delete\" @click=\"handleDelete(scope.row)\"></el-button>\n              </el-tooltip>-->\n            </div>\n          </template>\n        </el-table-column>\n      </el-table>\n      <div style=\"display:flex;width:100%\" v-if=\"this.selectedMenu.label!='全部'\">\n        <el-upload class=\"upload-demo-drag\" ref=\"upload\" drag\n          action=\"m?xwl=aml_monitor/workflow/prs01/dataSource/files/upload_file1\" name=\"file1\"\n          header=\"{content-type:'text/html'}\" :data=\"uploadParams\" :auto-upload=\"true\" :on-change=\"handleChange\"\n          :on-remove=\"handleRemove\" :on-success=\"handleSuccess\" :show-file-list=\"false\" multiple style=\"flex:1\">\n          <i class=\"el-icon-upload\"></i>\n          <div class=\"el-upload__text\">将文件拖到此处，或<em>点击上传</em></div>\n        </el-upload>\n      </div>\n    </div>\n  </div>\n</div>\n`,\n  data() {\n    return {\n      filterText: '',\n      organ_flag: '_$organ_flag$_',\n      // 非自然人附件目录\n      directoryConfig1: app.data.directory.directoryConfig1,\n      // 自然人附件目录\n      directoryConfig2: app.data.directory.directoryConfig2,\n      defaultProps: {\n        children: 'children',\n        label: 'label'\n      },\n      uploadParams: {\n        objectId: Wb.getId(),\n        client_id: '_$client_id$_'\n      },\n      selectedMenu: null,\n      attachmentList: [],\n      loading: false,\n      fileList: [],\n      dropTargetNode: null, // 接收拖拽的树节点\n      draggingFile: null, // 当前拖拽的文件\n    };\n  },\n  // 新增 watch：监听 filterText 变化并触发 tree 过滤\n  watch: {\n    filterText(val) {\n      // 必须等 DOM 更新后才能调用 $refs.tree\n      this.$nextTick(() => {\n        if (this.$refs.tree) {\n          this.$refs.tree.filter(val);\n        }\n      });\n    }\n  },\n  methods: {\n    // 过滤方法\n    filterNode(value, data) {\n      if (!value) return true;\n      // 支持模糊搜索（不区分大小写）\n      return data.label.toLowerCase().includes(value.toLowerCase());\n    },\n\n    // 处理节点点击\n    handleNodeClick(data) {\n      this.selectedMenu = data;\n      console.log(\"selectedMenu\", this.selectedMenu);\n      this.uploadParams.file_type_no = this.selectedMenu.value;\n      this.loadAttachments(this.selectedMenu.value);\n    },\n    // 格式化附件大小\n    formatSize(bytes) {\n      if (!bytes && bytes !== 0) {\n        return '';\n      } else if (bytes === 0) {\n        return '0 B'\n      };\n\n      const k = 1024;\n      const sizes = ['B', 'KB', 'MB', 'GB', 'TB'];\n      const i = Math.floor(Math.log(bytes) / Math.log(k));\n\n      return (bytes / Math.pow(k, i)).toFixed(2) + ' ' + sizes[i];\n    },\n    // 加载附件列表\n    loadAttachments(directoryId) {\n      let that = this;\n      Wb.ajax({\n        url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/files/select_file',\n        params: {\n          I_CLIENT_ID: '_$client_id$_',\n          I_FILE_TYPE_NO: String(directoryId)\n        },\n        success(resp) {\n          let res = Wb.decode(resp).items;\n          that.attachmentList = res;\n        }\n      });\n    },\n    // 下载附件\n    handleDownload(row) {\n      console.log(\"当前文件row\", row);\n      if (row.file_size!==0) {\n        Wb.download({\n          url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/files/download_file',\n          params: {\n            id: row.id,\n            full_name: row.name + '.' + row.extension\n          }\n        })\n      } else {\n        this.$message.error('当前文件为空！请确认上传是否无误');\n      }\n    },\n    handleChange(file, fileList) {\n      this.fileList = fileList\n      app.mainContainer.vue.selectFile();\n    },\n    // 删除附件\n    handleDelete(row) {\n      this.$confirm(`确定要删除\"${row.name}\"吗?`, '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(() => {\n        console.log(row)\n        let that = this;\n        Wb.ajax({\n          url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/files/delete_file',\n          params: {\n            file_pk_id: row.id\n          },\n          success() {\n            that.$message.success('删除成功');\n            that.loadAttachments(that.selectedMenu.value);\n            app.mainContainer.vue.selectFile();\n            console.log(\"app.basicInfo.vue\", app.basicInfo.vue);\n          }\n        })\n      }).catch(() => { });\n    },\n    handleSuccess() {\n      Wb.tipSucc(\"上传成功\");\n      this.loadAttachments(this.selectedMenu.value);\n    },\n    // 上传相关方法\n    handleRemove(file, fileList) {\n      console.log(file, fileList);\n    },\n    handlePreview(file) {\n      let that = this;\n      params_file = {\n        'id': file.id,\n        'clientId': file.client_id,\n        'fileTypeNo': this.organ_flag == '1' ? '1,2,21,22' : '1,2',\n        'fileName': file.name + '.' + file.extension,\n        'extension': file.extension\n      },\n        Wb.ajax({\n          url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/files/preview_file',\n          params: {\n            id: file.id,\n            clientId: file.client_id,\n            fileTypeNo: this.organ_flag == '1' ? '1,2,21,22' : '1,2',\n            fileName: file.name + '.' + file.extension,\n            extension: file.extension\n          },\n          success(resp) {\n            console.log(\"resp\", resp);\n            let res = Wb.decode(resp);\n            let serverIp = '10.116.131.13';\n            if (res.code == '200') {\n              let previewUrl = res.data.previewUrl;\n              if (previewUrl.indexOf(serverIp) != -1) {\n                previewUrl = res.data.previewUrl.replace(/10\\.116\\.131\\.13:8090/g, '10.181.135.22:8080/ibcm_flow')\n              }\n              window.open(previewUrl, '_blank', 'width=800,height=600')\n            } else {\n              that.$message.error(\"当前文件类型不支持预览\")\n            }\n          }\n        });\n    },\n    handleExceed(files, fileList) {\n      this.$message.warning(`当前限制选择 3 个文件，本次选择了 ${files.length} 个文件，共选择了 ${files.length + fileList.length} 个文件`);\n    },\n    beforeRemove(file, fileList) {\n      return this.$confirm(`确定移除 ${file.name}？`);\n    },\n\n    // 文件拖拽开始\n    handleDragStart(file) {\n      this.draggingFile = file;\n      console.log(\"dragfile:\", this.draggingFile);\n    },\n\n    // 树节点拖拽进入\n    handleTreeDragEnter(event, node, data) {\n      event.preventDefault();\n      this.dropTargetNode = node;\n    },\n    // 树节点经过\n    handleTreeDragOver(event, node, data) {\n      console.log(\"handleTreeDragOver\", node.data);\n      event.preventDefault(); // 必须，否则 drop 不生效\n      this.dropTargetNode = node;\n    },\n    // 树节点 drop 事件\n    handleTreeDrop(event) {\n      let that = this;\n      console.log(\"handleTreeDrop\");\n      event.preventDefault();\n      event.stopPropagation();\n\n      if (!this.draggingFile || !this.dropTargetNode) return;\n\n      const file = this.draggingFile;\n      const targetNode = this.dropTargetNode;\n\n      let tip = '确定要把 “' + file.name + '” 移动到 “' + targetNode.label + '” 目录下吗？'\n      Wb.confirm(tip, function () {\n        Wb.ajax({\n          url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/files/update_file_dir',\n          params: {\n            I_FILE_TYPE_NO: targetNode.data.value,\n            I_ID: file.id\n          },\n          success(resp) {\n            that.loadAttachments(that.selectedMenu.value);\n            that.$message.success(\"操作成功\");\n            app.mainContainer.vue.selectFile();\n          }\n        })\n      });\n      // 清理数据\n      this.draggingFile = null;\n      this.dropTargetNode = null;\n    },\n  },\n  mounted: function () {\n    // 实现左侧面板宽度可调节\n    const leftPanel = this.$refs.leftPanel;\n    let isResizing = false;\n    leftPanel.addEventListener('mouseenter', (e) => {\n      if (e.offsetX > leftPanel.offsetWidth - 5) {\n        document.body.style.cursor = 'col-resize';\n      }\n    });\n    leftPanel.addEventListener('mouseleave', (e) => {\n      if (e.offsetX > leftPanel.offsetWidth - 10) {\n        document.body.style.cursor = 'auto';\n      }\n    });\n    leftPanel.addEventListener('mousedown', (e) => {\n      if (e.offsetX > leftPanel.offsetWidth - 10) {\n        isResizing = true;\n        document.body.style.cursor = 'col-resize';\n        document.body.style.userSelect = 'none';\n      }\n    });\n\n    document.addEventListener('mousemove', (e) => {\n      if (!isResizing) return;\n\n      const newWidth = e.clientX - leftPanel.getBoundingClientRect().left;\n      if (newWidth >= 250 && newWidth <= 600) {\n        leftPanel.style.width = newWidth + 'px';\n      }\n    });\n\n    document.addEventListener('mouseup', () => {\n      isResizing = false;\n      document.body.style.cursor = '';\n      document.body.style.userSelect = '';\n    });\n  }\n});"},"hasDupCid":0}]}]}]}]}