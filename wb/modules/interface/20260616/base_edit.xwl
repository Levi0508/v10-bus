l>\n                <div>{{formatDictMap('nationality_list',item.nationality)|| '-'}}</div>\n              </div>\n              <div class=\"info-row-flex\"><label>证件类型</label>\n                <div>{{formatDictMap('id_type_list',item.id_type)|| '-'}}</div>\n              </div>\n              <div class=\"info-row-flex\"><label>证件号码</label>\n                <div>{{item.id_no|| '-'}}</div>\n              </div>\n            </el-row>\n\n            <el-row :gutter=\"10\" class=\"info-row\">\n              <div class=\"info-row-flex\"><label>证件有效期起始</label>\n                <div>{{item.id_begindate|| '-'}}</div>\n              </div>\n              <div class=\"info-row-flex\"><label>证件有效期截止</label>\n                <div>{{item.id_enddate|| '-'}}</div>\n              </div>\n              <div class=\"info-row-flex\"><label>出生年月</label>\n                <div>{{item.birthday|| '-'}}</div>\n              </div>\n            </el-row>\n          </div>\n          <!-- 操作按钮 -->\n          <div class=\"attachment-footer\">\n            <el-button type=\"text\" @click=\"deleteRalated(item)\">删除</el-button>\n            <el-button type=\"text\" @click=\"showDialog('2',item,'4')\">编辑</el-button>\n          </div>\n        </el-card>\n        <!-- 附件信息表 -->\n        <div style=\"padding-top:10px;\">\n          <span>附件信息</span>\n          <el-tooltip class=\"item\" effect=\"dark\" content=\"请上传授权代表人身份证明文件的复印件、授权委托书（授权代表人非法代时适用）\" placement=\"right\">\n            <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n          </el-tooltip>\n          <el-table :data=\"attachmentList.authorizedRep\" border style=\"width: 100%;margin-top:10px;\"\n            :default-sort=\"{prop: 'date', order: 'descending'}\">\n            <el-table-column prop=\"name\" label=\"附件名称\" sortable>\n              <template slot-scope=\"scope\">\n                <el-button type=\"text\" @click=\"handlePreview(scope.row)\" class=\"attachment-btn\">\n                  {{ scope.row.name }}\n                </el-button>\n              </template>\n            </el-table-column>\n            <el-table-column prop=\"extension\" label=\"附件类型\" width=\"120\" />\n            <el-table-column prop=\"create_time\" label=\"上传时间\" width=\"160\" sortable />\n            <el-table-column prop=\"file_size\" label=\"附件大小\" width=\"120\" sortable>\n              <template slot-scope=\"scope\">\n                {{ formatSize(scope.row.file_size) }}\n              </template>\n            </el-table-column>\n            <el-table-column prop=\"create_by\" label=\"上传人\" width=\"120\" sortable />\n            <el-table-column label=\"操作\" width=\"150\" fixed=\"right\">\n              <template slot-scope=\"scope\">\n                <div class=\"operation-buttons\">\n                  <el-tooltip content=\"预览\">\n                    <el-button type=\"text\" class=\"el-icon-view\" @click=\"handlePreview(scope.row)\"></el-button>\n                  </el-tooltip>\n                  <el-tooltip content=\"下载\">\n                    <el-button type=\"text\" class=\"el-icon-download\" @click=\"handleDownload(scope.row)\"></el-button>\n                  </el-tooltip>\n                </div>\n              </template>\n            </el-table-column>\n          </el-table>\n          <!-- 上传按钮 -->\n          <div class=\"upload-add\">\n            <div class=\"upload-demo\">\n              <el-button type=\"text\" icon=\"el-icon-plus\" @click=\"openFileDialog(51)\">添加</el-button>\n            </div>\n          </div>\n        </div>\n      </el-card>\n      <!--受益所有人-->\n      <el-card class=\"box-card\" :name=\"'beneficialOwner'+this._uid\" v-if=\"organ_flag=='1'\">\n        <div slot=\"header\" class=\"clearfix\">\n          <span>客户受益所有人信息</span>\n          <el-button type=\"text\" icon=\"el-icon-plus\" class=\"add-btn\" @click=\"showDialog('1',{},'5')\">添加</el-button>\n        </div>\n        <div v-if=\"relatedInfo5.length==0\" style=\"color:#8d8b8b;text-align:center\">暂无数据</div>\n        <el-card v-for=\"item in relatedInfo5\" :key=\"item.related_id\" style=\"margin-bottom:10px;\">\n          <div class=\"client-info\">\n            <div class=\"client-title\">\n              <span>{{item.related_name|| '-'}}</span>\n              <el-tag type=\"success\" effect=\"dark\" size=\"mini\" style=\"margin-left: 10px;\" v-if=\"item.organ_flag!=='1'\">\n                自然人</el-tag>\n              <el-tag type=\"\" effect=\"dark\" size=\"mini\" style=\"margin-left: 10px;\" v-if=\"item.organ_flag==='1'\">法人\n              </el-tag>\n            </div>\n\n            <el-row :gutter=\"10\" class=\"info-row\">\n              <div class=\"info-row-flex\" v-if=\"item.organ_flag==='0'\"><label>性别</label>\n                <div>{{formatDictMap('benefit_gender_list',item.gender)|| '-'}}</div>\n              </div>\n              <div class=\"info-row-flex\" v-if=\"item.organ_flag==='1'\"><label>国家或地区</label>\n                <div>{{formatDictMap('nationality_list',item.nationality)|| '-'}}</div>\n              </div>\n              <div class=\"info-row-flex\" v-if=\"item.organ_flag==='0'\"><label>国籍</label>\n                <div>{{formatDictMap('nationality_list',item.nationality)|| '-'}}</div>\n              </div>\n              <div class=\"info-row-flex\"><label>出生年月</label>\n                <div>{{item.birthday|| '-'}}</div>\n              </div>\n            </el-row>\n\n            <el-row :gutter=\"10\" class=\"info-row\">\n              <div class=\"info-row-flex\"><label>证件类型</label>\n                <div>{{formatDictMap('id_type_list',item.id_type)|| '-'}}</div>\n              </div>\n              <div class=\"info-row-flex\"><label>证件号码</label>\n                <div>{{item.id_no|| '-'}}</div>\n              </div>\n              <div class=\"info-row-flex\"><label>证件有效期起始</label>\n                <div>{{item.id_begindate|| '-'}}</div>\n              </div>\n            </el-row>\n\n\n            <el-row :gutter=\"10\" class=\"info-row\">\n              <div class=\"info-row-flex\"><label>联系电话(手机)</label>\n                <div>{{item.mobno1|| '-'}}</div>\n              </div>\n              <div class=\"info-row-flex\"><label>联系电话(固定电话)</label>\n                <div>{{item.mobno2|| '-'}}</div>\n              </div>\n              <div class=\"info-row-flex\"><label>证件有效期截止</label>\n                <div>{{item.id_enddate|| '-'}}</div>\n              </div>\n            </el-row>\n\n            <el-row :gutter=\"10\" class=\"info-row\">\n              <div class=\"info-row-flex\" style=\"width: 100%;\"><label>联系地址</label>\n                <div>{{item.address|| '-'}}</div>\n              </div>\n            </el-row>\n\n\n            <el-row :gutter=\"10\" class=\"info-row\">\n              <div class=\"info-row-flex\" style=\"width: 100%;\"><label>受益所有人类型</label>\n                <div>{{formatMultipleDictMap('bnf_type_mix_list',item.bnf_type)|| '-'}}</div>\n              </div>\n            </el-row>\n\n            <el-row :gutter=\"10\" class=\"info-row\" v-show=\"(item.bnf_type || '').includes('NA1') || \n            (item.bnf_type || '').includes('NA2-1') || \n            (item.bnf_type || '').includes('NA2-2') || \n            (item.bnf_type || '').includes('NA2-1') ||\n            (item.bnf_type || '').includes('NB1') ||\n            (item.bnf_type || '').includes('NB2-1') ||\n            (item.bnf_type || '').includes('NB2-2') ||\n            (item.bnf_type || '').includes('ND1')\">\n              <div class=\"info-row-flex\"><label>持有股权、股份、合伙权益的比例(%)</label>\n                <div>{{item.acthdrat|| '-'}}</div>\n              </div>\n              <div class=\"info-row-flex\"><label>受益所有权形成日期(25%以上股权、股份)</label>\n                <div>{{item.shareratiostartdate|| '-'}}</div>\n              </div>\n              <div class=\"info-row-flex\"><label>受益所有权终止日期(25%以上股权、股份)</label>\n                <div>{{item.shareratioenddate|| '-'}}</div>\n              </div>\n            </el-row>\n\n\n            <el-row :gutter=\"10\" class=\"info-row\" v-show=\"(item.bnf_type || '').includes('A3') ||\n            (item.bnf_type || '').includes('NA3-1') ||\n            (item.bnf_type || '').includes('NA3-2') ||\n            (item.bnf_type || '').includes('NB3-1') ||\n            (item.bnf_type || '').includes('NB3-2') ||\n            (item.bnf_type || '').includes('NC4') ||\n            (item.bnf_type || '').includes('ND3')\">\n              <div class=\"info-row-flex\" style=\"width: 100%;\"><label>实际控制形式</label>\n                <div>{{formatMultipleDictMap('benefit_actctrlcpny_list', item.actctrlcpny)|| '-'}}</div>\n              </div>\n              <div class=\"info-row-flex\" style=\"width: 100%;\"><label>实施实际控制的内容/方式</label>\n                <div>{{formatMultipleDictMap('benefit_actctrltype_list', item.actctrltype)|| '-'}}</div>\n              </div>\n            </el-row>\n            <el-row :gutter=\"10\" class=\"info-row\" v-show=\"(item.bnf_type || '').includes('A3') ||\n            (item.bnf_type || '').includes('NA3-1') ||\n            (item.bnf_type || '').includes('NA3-2') ||\n            (item.bnf_type || '').includes('NB3-1') ||\n            (item.bnf_type || '').includes('NB3-2') ||\n            (item.bnf_type || '').includes('NC4') ||\n            (item.bnf_type || '').includes('ND3')\">\n              <div class=\"info-row-flex\"><label>受益所有权形成日期(实施实际控制)</label>\n                <div>{{item.obtainactdate|| '-'}}</div>\n              </div>\n              <div class=\"info-row-flex\"><label>受益所有权终止日期(实施实际控制)</label>\n                <div>{{item.terminationactdate|| '-'}}</div>\n              </div>\n              <div class=\"info-row-flex\" v-if=\"item.actctrlcpny === '3'\"><label>实际控制其他形式</label>\n                <div>{{item.actotherforms|| '-'}}</div>\n              </div>\n            </el-row>\n            <el-row :gutter=\"10\" class=\"info-row\" v-show=\"item.actctrlcpny === '2' && ((item.bnf_type || '').includes('A3') ||\n            (item.bnf_type || '').includes('NA3-1') ||\n            (item.bnf_type || '').includes('NA3-2') ||\n            (item.bnf_type || '').includes('NB3-1') ||\n            (item.bnf_type || '').includes('NB3-2') ||\n            (item.bnf_type || '').includes('NC4') ||\n            (item.bnf_type || '').includes('ND3'))\">\n              <div class=\"info-row-flex\"><label>是否存在上一层备案主体</label>\n                <div>{{ formatDictMap('benefit_yesno_list', item.actconuppermarket)|| '-'}}</div>\n              </div>\n              <div class=\"info-row-flex\" v-if=\"item.actconuppermarket === 'Y'\"><label>实际控制备案主体的上一层备案主体名称</label>\n                <div>{{item.actconupperentname|| '-'}}</div>\n              </div>\n              <div class=\"info-row-flex\" v-if=\"item.actconuppermarket === 'Y'\"><label>实际控制备案主体的统一社会信用代码</label>\n                <div>{{item.actconuniscid|| '-'}}</div>\n              </div>\n            </el-row>\n\n\n            <el-row :gutter=\"10\" class=\"info-row\" v-show=\"(item.bnf_type || '').includes('ND2-1') ||\n            (item.bnf_type || '').includes('ND2-2')\">\n              <div class=\"info-row-flex\"><label>收益权比例(%)</label>\n                <div>{{ item.actownerprofitratio || '-'}}</div>\n              </div>\n              <div class=\"info-row-flex\"><label>受益所有权形成日期(收益权)</label>\n                <div>{{item.profitratiostartdate|| '-'}}</div>\n              </div>\n              <div class=\"info-row-flex\"><label>受益所有权终止日期(收益权)</label>\n                <div>{{item.profitratioenddate|| '-'}}</div>\n              </div>\n            </el-row>\n            <el-row :gutter=\"10\" class=\"info-row\" v-show=\"(item.bnf_type || '').includes('ND2-1') ||\n            (item.bnf_type || '').includes('ND2-2')\">\n              <div class=\"info-row-flex\"><label>表决权比例(%)</label>\n                <div>{{ item.actownerprofitratiovote || '-'}}</div>\n              </div>\n              <div class=\"info-row-flex\"><label>受益所有权形成日期(表决权)</label>\n                <div>{{item.profitratiovotestartdate|| '-'}}</div>\n              </div>\n              <div class=\"info-row-flex\"><label>受益所有权终止日期(表决权)</label>\n                <div>{{item.profitratiovoteenddate|| '-'}}</div>\n              </div>\n            </el-row>\n\n            <el-row :gutter=\"10\" class=\"info-row\" v-show=\"(item.bnf_type || '').includes('NA4') ||\n            (item.bnf_type || '').includes('NB4') ||\n            (item.bnf_type || '').includes('NF') ||\n            (item.bnf_type || '').includes('NG') ||\n            (item.bnf_type || '').includes('NH') ||\n            (item.bnf_type || '').includes('NI')\">\n              <div class=\"info-row-flex\" style=\"width: 100%;\"><label>负责日常经营管理的(高级管理)人员的职位</label>\n                <div>{{ formatMultipleDictMap('benefit_seniormgrpos_list', item.seniormgrpos)|| '-' }}</div>\n              </div>\n            </el-row>\n\n            <el-row :gutter=\"10\" class=\"info-row\" v-show=\"(item.bnf_type || '').includes('NA4') ||\n            (item.bnf_type || '').includes('NB4') ||\n            (item.bnf_type || '').includes('NF') ||\n            (item.bnf_type || '').includes('NG') ||\n            (item.bnf_type || '').includes('NH') ||\n            (item.bnf_type || '').includes('NI')\">\n              <div class=\"info-row-flex\" v-show=\"(item.seniormgrpos || '').includes('15')\" style=\"width: 100%;\">\n                <label>公司章程规定的其他（高级管理）人员的具体职位</label>\n                <div>{{item.actdailymgmtpostother|| '-'}}</div>\n              </div>\n            </el-row>\n\n            <el-row :gutter=\"10\" class=\"info-row\" v-show=\"(item.bnf_type || '').includes('NA5')\">\n              <div class=\"info-row-flex\" style=\"width: 100%;\"><label>在华最高层级的高级管理人员职位</label>\n                <div>{{ formatMultipleDictMap('benefit_seniormgrposcn_list', item.seniormgrposcn)|| '-' }}</div>\n              </div>\n            </el-row>\n\n            <el-row :gutter=\"10\" class=\"info-row\" v-show=\"(item.bnf_type || '').includes('NA5')\">\n              <div class=\"info-row-flex\" v-show=\"(item.seniormgrposcn || '').includes('1')\" style=\"width: 100%;\">\n                <label>在华最高层级的高级管理其他职位</label>\n                <div>{{item.ownerrightmgmtpostother|| '-'}}</div>\n              </div>\n            </el-row>\n\n          </div>\n          <!-- 操作按钮 -->\n          <div class=\"attachment-footer\">\n            <el-button type=\"text\" @click=\"deleteRalated(item)\">删除</el-button>\n            <el-button type=\"text\" @click=\"showDialog('2',item,'5')\">编辑</el-button>\n          </div>\n        </el-card>\n        <!-- 附件信息表 -->\n        <div style=\"padding-top:10px;\">\n          <span>附件信息</span>\n          <el-tooltip class=\"item\" effect=\"dark\" placement=\"right\">\n            <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n            <div slot=\"content\">请上传受益所有人的身份证明文件的复印件、确认受益所有人的证明文件，包括但不限于股权架构图、公司章程、委托持股协议、<br/>一致行动协议、表决权差异安排协议等、关于股权比例计算的说明（受益所有人类型如为A1、A2、B1、D1）\n            </div>\n          </el-tooltip>\n          <el-table :data=\"attachmentList.beneficialOwner\" border style=\"width: 100%;margin-top:10px;\"\n            :default-sort=\"{prop: 'date', order: 'descending'}\">\n            <el-table-column prop=\"name\" label=\"附件名称\" sortable>\n              <template slot-scope=\"scope\">\n                <el-button type=\"text\" @click=\"handlePreview(scope.row)\" class=\"attachment-btn\">\n                  {{ scope.row.name }}\n                </el-button>\n              </template>\n            </el-table-column>\n            <el-table-column prop=\"extension\" label=\"附件类型\" width=\"120\" />\n            <el-table-column prop=\"create_time\" label=\"上传时间\" width=\"160\" sortable />\n            <el-table-column prop=\"file_size\" label=\"附件大小\" width=\"120\" sortable>\n              <template slot-scope=\"scope\">\n                {{ formatSize(scope.row.file_size) }}\n              </template>\n            </el-table-column>\n            <el-table-column prop=\"create_by\" label=\"上传人\" width=\"120\" sortable />\n            <el-table-column label=\"操作\" width=\"150\" fixed=\"right\">\n              <template slot-scope=\"scope\">\n                <div class=\"operation-buttons\">\n                  <el-tooltip content=\"预览\">\n                    <el-button type=\"text\" class=\"el-icon-view\" @click=\"handlePreview(scope.row)\"></el-button>\n                  </el-tooltip>\n                  <el-tooltip content=\"下载\">\n                    <el-button type=\"text\" class=\"el-icon-download\" @click=\"handleDownload(scope.row)\"></el-button>\n                  </el-tooltip>\n                </div>\n              </template>\n            </el-table-column>\n          </el-table>\n          <!-- 上传按钮 -->\n          <div class=\"upload-add\">\n            <div class=\"upload-demo\">\n              <el-button type=\"text\" icon=\"el-icon-plus\" @click=\"openFileDialog(61)\">添加</el-button>\n            </div>\n          </div>\n        </div>\n      </el-card>\n      <!--底部声明-->\n      <el-card>\n        <!-- 标题行 -->\n        <div slot=\"header\">\n          <span class=\"card-title\" v-if=\"organ_flag=='1'\">声明：本机构保证所提供资料的真实性、准确性、完整性、有效性，并对其承担责任；\n                如上述内容发生变更时将及时以书面方式通知贵公司，如因为不能及时完成变更由此产生的一切后果将由本机构承担。<br>\n            机构盖章：</span>\n          <span class=\"card-title\" v-if=\"organ_flag==='0'\">声明：本人保证前述所填信息以及所提供资料的真实性、准确性、完整性、有效性，并对其承担责任；\n            如上述内容发生变更时将及时以书面方式通知贵公司，如因为不能及时完成变更由此产生的一切后果将由本人承担。<br><br>\n            签名：<br></span>\n        </div>\n        <div>\n          <el-form label-width=\"140px\" v-if=\"organ_flag==='1'\">\n            <el-form-item label=\"建立业务关系日期\" prop=\"associated_date\">\n              <el-date-picker type=\"date\" placeholder=\"选择日期\" v-model=\"ruleForm1.associated_date\" disabled>\n              </el-date-picker>\n            </el-form-item>\n            <el-form-item label=\"备注\" prop=\"remark\">\n              <el-input type=\"textarea\" style=\"width:100%\" v-model=\"ruleForm1.remark\"></el-input>\n            </el-form-item>\n          </el-form>\n          <el-form label-width=\"140px\" v-if=\"organ_flag==='0'\">\n            <el-form-item label=\"建立业务关系日期\" prop=\"associated_date\">\n              <el-date-picker type=\"date\" placeholder=\"选择日期\" v-model=\"ruleForm2.associated_date\" disabled>\n              </el-date-picker>\n            </el-form-item>\n            <el-form-item label=\"备注\" prop=\"remark\">\n              <el-input type=\"textarea\" style=\"width:100%\" v-model=\"ruleForm2.remark\"></el-input>\n            </el-form-item>\n          </el-form>\n        </div>\n      </el-card>\n      <!--pdf导出 境内外区分-->\n      <el-card v-show=\"false\" class=\"box-card\">\n        <div :id=\"'pdf-container'+this._uid\" style=\"width:100%;font-size:24px;\">\n          <h2 class=\"pdf-section-title\">客户基本信息</h2>\n          <div class=\"info-div\" v-if=\"organ_flag=='1'\">\n            <div class=\"table-row\">\n              <div class=\"cell-label col-3\">客户名称</div>\n              <div class=\"cell-value col-5\">{{basicInfo.client_name || '-'}}</div>\n              <div class=\"cell-label col-3\">办公住所</div>\n              <div class=\"cell-value col-13 long-text\">\n                {{basicInfo.province || ''}}{{basicInfo.city || ''}}{{basicInfo.district ||\n                ''}}{{basicInfo.office_address || '-'}}\n              </div>\n            </div>\n            <div class=\"table-row\">\n              <div class=\"cell-label col-3\">国家或地区</div>\n              <div class=\"cell-value col-5\">{{ basicInfo.register_country ?\n                formatDictMap('nationality_list',basicInfo.register_country) : '-'}}</div>\n              <div class=\"cell-label col-3\">注册资本金币种</div>\n              <div class=\"cell-value col-5\">\n                {{basicInfo.register_money_type||'-'}}\n              </div>\n              <div class=\"cell-label col-3\">注册资本金</div>\n              <div class=\"cell-value col-5\">{{basicInfo.register_fund || '-'}}万元</div>\n            </div>\n\n            <!-- 第三行 -->\n            <div class=\"table-row\">\n              <div class=\"cell-label col-3\" v-if=\"basicInfo.industry_type!='26'\">行业分类</div>\n              <div class=\"cell-value col-5\" v-if=\"basicInfo.industry_type!='26'\">\n                {{basicInfo.industry_type?formatDictMap('industry_type_list',basicInfo.industry_type): '-'}}\n              </div>\n              <div class=\"cell-label col-2\" v-if=\"basicInfo.industry_type=='26'\">行业分类</div>\n              <div class=\"cell-value col-2\" v-if=\"basicInfo.industry_type=='26'\">\n                {{basicInfo.industry_type?formatDictMap('industry_type_list',basicInfo.industry_type): '-'}}\n              </div>\n              <div class=\"cell-label col-2\" v-if=\"basicInfo.industry_type=='26'\">请注明</div>\n              <div class=\"cell-value col-2\" v-if=\"basicInfo.industry_type=='26'\">\n                {{basicInfo.industry_name}}\n              </div>\n              <div class=\"cell-label col-3\">成立日期</div>\n              <div class=\"cell-value col-5\">{{basicInfo.setup_date || '-'}}</div>\n              <div class=\"cell-label col-3\">联系电话</div>\n              <div class=\"cell-value col-5\">{{basicInfo.tel || '-'}}</div>\n            </div>\n\n            <!-- 第四行 -->\n            <div class=\"table-row\">\n              <div class=\"cell-label col-3\">证件类型</div>\n              <div class=\"cell-value col-5\">{{basicInfo.id_type?formatDictMap('id_type_list',basicInfo.id_type):'-'}}\n              </div>\n              <div class=\"cell-label col-3\">证件号码</div>\n              <div class=\"cell-value col-5\">{{basicInfo.id_no || '-'}}</div>\n              <div class=\"cell-label col-3\">证件有效期</div>\n              <div class=\"cell-value col-5\">{{basicInfo.id_begindate || '-'}}至{{basicInfo.id_enddate || '-'}}</div>\n            </div>\n            <div class=\"table-row\">\n              <div class=\"cell-label col-3\">经营范围</div>\n              <div class=\"cell-value col-21 long-text\">{{basicInfo.busi_scope || '-'}}</div>\n            </div>\n          </div>\n\n          <div class=\"info-div\" v-if=\"organ_flag=='0'\">\n            <div class=\"table-row\">\n              <div class=\"cell-label col-3\">姓名</div>\n              <div class=\"cell-value col-5\">{{basicInfo.client_name || '-'}}</div>\n              <div class=\"cell-label col-3\">联系地址</div>\n              <div class=\"cell-value col-13\">{{basicInfo.province2 || ''}}{{basicInfo.city2 || ''}}{{basicInfo.district2\n                || ''}}{{basicInfo.address || '-'}}</div>\n            </div>\n            <div class=\"table-row\">\n              <div class=\"cell-label col-3\">国籍</div>\n              <div class=\"cell-value col-5\">\n                {{basicInfo.nationality?formatDictMap('nationality_list',basicInfo.nationality):'-'}}</div>\n              <div class=\"cell-label col-3\">性别</div>\n              <div class=\"cell-value col-5\">{{(basicInfo.gender=='1'?'男':basicInfo.gender=='2'?'女':'未知')|| '-'}}</div>\n              <div class=\"cell-label col-3\">出生年月</div>\n              <div class=\"cell-value col-5\">{{basicInfo.birthday || '-'}}</div>\n            </div>\n\n            <div class=\"table-row\">\n              <div class=\"cell-label col-3\">联系电话</div>\n              <div class=\"cell-value col-5\">{{basicInfo.tel || '-'}}</div>\n              <div class=\"cell-label col-3\">年收入</div>\n              <div class=\"cell-value col-5\">\n                {{basicInfo.income?formatDictMap('year_income_list',String(basicInfo.income)): '-'}}</div>\n              <div class=\"cell-label col-3\">职业分类</div>\n              <div class=\"cell-value col-5\">\n                {{basicInfo.profession_code?formatDictMap('profession_code_list',basicInfo.profession_code):'-'}}</div>\n            </div>\n            <div class=\"table-row\">\n              <div class=\"cell-label col-3\">证件类型</div>\n              <div class=\"cell-value col-5\">{{basicInfo.id_type?formatDictMap('id_type_list',basicInfo.id_type):'-'}}\n              </div>\n              <div class=\"cell-label col-3\">证件号码</div>\n              <div class=\"cell-value col-5\">{{basicInfo.id_no || '-'}}</div>\n              <div class=\"cell-label col-3\">证件有效期</div>\n              <div class=\"cell-value col-5\">{{basicInfo.id_begindate || '-'}}至{{basicInfo.id_enddate || '-'}}</div>\n            </div>\n            <div class=\"table-row\">\n              <div class=\"cell-label col-3\">证件地址</div>\n              <div class=\"cell-value col-13\">{{basicInfo.province1 || ''}}{{basicInfo.city1 || ''}}{{basicInfo.district1\n                || ''}}{{basicInfo.id_address || '-'}}</div>\n            </div>\n          </div>\n\n          <div v-if=\"organ_flag=='1'\">\n            <h2 class=\"pdf-section-sub-title\">法定代表人信息</h2>\n            <div class=\"info-div\">\n              <div v-for=\"(item, index) in relatedInfo1\" :key=\"item.related_id\" :class=\"{'person-divider': index > 0}\">\n                <div class=\"table-row\">\n                  <div class=\"cell-label col-3\">法定代表人姓名</div>\n                  <div class=\"cell-value col-5\">{{item.related_name || '-'}}</div>\n                  <div class=\"cell-label col-3\">出生年月</div>\n                  <div class=\"cell-value col-5\">{{item.birthday || '-'}}</div>\n                  <div class=\"cell-label col-3\">国籍</div>\n                  <div class=\"cell-value col-5\">\n                    {{item.nationality?formatDictMap('nationality_list',item.nationality):'-'}}</div>\n                </div>\n                <div class=\"table-row\">\n                  <div class=\"cell-label col-3\">身份证件类型</div>\n                  <div class=\"cell-value col-5\">{{item.id_type?formatDictMap('id_type_list',item.id_type):'-'}}</div>\n                  <div class=\"cell-label col-3\">身份证件号码</div>\n                  <div class=\"cell-value col-5\">{{item.id_no || '-'}}</div>\n                  <div class=\"cell-label col-3\">证件有效期</div>\n                  <div class=\"cell-value col-5\">{{item.id_begindate || '-'}}至{{item.id_enddate || '-'}}</div>\n                </div>\n              </div>\n              <div v-if=\"!relatedInfo1 || relatedInfo1.length === 0\" class=\"table-row\">\n                <div class=\"cell-label col-3\">法定代表人信息</div>\n                <div class=\"cell-value col-21 empty-data\">暂无数据</div>\n              </div>\n            </div>\n            <h2 class=\"pdf-section-sub-title\">控股股东信息</h2>\n            <div class=\"info-div\">\n              <div v-for=\"(item, index) in relatedInfo2\" :key=\"item.related_id\" :class=\"{'person-divider': index > 0}\">\n                <div class=\"table-row\">\n                  <div class=\"cell-label col-3\" v-if=\"item.organ_flag=='1'\">控股股东(法人)</div>\n                  <div class=\"cell-label col-3\" v-if=\"item.organ_flag=='0'\">控股股东(自然人)</div>\n                  <div class=\"cell-value col-5\">{{item.related_name || '-'}}</div>\n                  <div class=\"cell-label col-3\" v-if=\"item.organ_flag=='1'\">国家或地区</div>\n                  <div class=\"cell-label col-3\" v-if=\"item.organ_flag=='0'\">国籍</div>\n                  <div class=\"cell-value col-5\">\n                    {{item.nationality?formatDictMap('nationality_list',item.nationality):'-'}}\n                  </div>\n                  <div class=\"cell-label col-3\">证件类型</div>\n                  <div class=\"cell-value col-5\">{{item.id_type?formatDictMap('id_type_list',item.id_type):'-'}}</div>\n                </div>\n                <div class=\"table-row\">\n                  <div class=\"cell-label col-3\">证件号码</div>\n                  <div class=\"cell-value col-5\">{{item.id_no || '-'}}</div>\n                  <div class=\"cell-label col-3\">证件有效期期限</div>\n                  <div class=\"cell-value col-5\">{{item.id_begindate || '-'}}至{{item.id_enddate || '-'}}</div>\n                  <div class=\"cell-label col-3\" v-if=\"item.organ_flag=='1'\">是否政府部门</div>\n                  <div class=\"cell-value col-5\" v-if=\"item.organ_flag=='1'\">{{item.is_government_dept === '1' ? '是' :\n                    (item.is_government_dept === '0' ? '否' : '-')}}</div>\n                </div>\n              </div>\n              <div v-if=\"!relatedInfo2 || relatedInfo2.length === 0\" class=\"table-row\">\n                <div class=\"cell-label col-3\">控股股东信息</div>\n                <div class=\"cell-value col-21 empty-data\">暂无数据</div>\n              </div>\n            </div>\n            <h2 class=\"pdf-section-sub-title\">实际控制人信息</h2>\n            <div class=\"info-div\">\n              <div v-for=\"(item, index) in relatedInfo3\" :key=\"item.related_id\" :class=\"{'person-divider': index > 0}\">\n                <div class=\"table-row\">\n                  <div class=\"cell-label col-3\" v-if=\"item.organ_flag=='1'\">实际控制人(法人)</div>\n                  <div class=\"cell-label col-3\" v-if=\"item.organ_flag=='0'\">实际控制人(自然人)</div>\n                  <div class=\"cell-value col-5\">{{item.related_name || '-'}}</div>\n                  <div class=\"cell-label col-3\" v-if=\"item.organ_flag=='1'\">国家或地区</div>\n                  <div class=\"cell-label col-3\" v-if=\"item.organ_flag=='0'\">国籍</div>\n                  <div class=\"cell-value col-5\">\n                    {{item.nationality?formatDictMap('nationality_list',item.nationality):'-'}}\n                  </div>\n                  <div class=\"cell-label col-3\">证件类型</div>\n                  <div class=\"cell-value col-5\">{{item.id_type?formatDictMap('id_type_list',item.id_type):'-'}}</div>\n                </div>\n                <div class=\"table-row\">\n                  <div class=\"cell-label col-3\">证件号码</div>\n                  <div class=\"cell-value col-5\">{{item.id_no || '-'}}</div>\n                  <div class=\"cell-label col-3\">证件有效期期限</div>\n                  <div class=\"cell-value col-5\">{{item.id_begindate || '-'}}至{{item.id_enddate || '-'}}</div>\n                  <div class=\"cell-label col-3\" v-if=\"item.organ_flag=='1'\">是否政府部门</div>\n                  <div class=\"cell-value col-5\" v-if=\"item.organ_flag=='1'\">{{item.is_government_dept === '1' ? '是' :\n                    (item.is_government_dept === '0' ? '否' : '-')}}</div>\n                  <div class=\"cell-label col-3\" v-if=\"item.organ_flag=='0'\">出生年月</div>\n                  <div class=\"cell-value col-5\" v-if=\"item.organ_flag=='0'\">{{item.birthday || '-'}}</div>\n                </div>\n              </div>\n              <div v-if=\"!relatedInfo3 || relatedInfo3.length === 0\" class=\"table-row\">\n                <div class=\"cell-label col-3\">实际控制人信息</div>\n                <div class=\"cell-value col-21 empty-data\">暂无数据</div>\n              </div>\n            </div>\n            <h2 class=\"pdf-section-sub-title\">授权代表人信息</h2>\n            <div class=\"info-div\">\n              <div v-for=\"(item, index) in relatedInfo4\" :key=\"item.related_id\" :class=\"{'person-divider': index > 0}\">\n                <div class=\"table-row\">\n                  <div class=\"cell-label col-3\">授权代表人姓名</div>\n                  <div class=\"cell-value col-5\">{{item.related_name || '-'}}</div>\n                  <div class=\"cell-label col-3\" v-if=\"item.organ_flag=='1'\">国家或地区</div>\n                  <div class=\"cell-label col-3\" v-if=\"item.organ_flag!='1'\">国籍</div>\n                  <div class=\"cell-value col-5\">\n                    {{item.nationality?formatDictMap('nationality_list',item.nationality):'-'}}\n                  </div>\n                  <div class=\"cell-label col-3\">证件类型</div>\n                  <div class=\"cell-value col-5\">{{item.id_type?formatDictMap('id_type_list',item.id_type):'-'}}</div>\n                </div>\n                <div class=\"table-row\">\n                  <div class=\"cell-label col-3\">证件号码</div>\n                  <div class=\"cell-value col-5\">{{item.id_no || '-'}}</div>\n                  <div class=\"cell-label col-3\">证件有效期</div>\n                  <div class=\"cell-value col-5\">{{item.id_begindate || '-'}}至{{item.id_enddate || '-'}}</div>\n                  <div class=\"cell-label col-3\" v-if=\"item.organ_flag=='1'\">是否政府部门</div>\n                  <div class=\"cell-value col-5\" v-if=\"item.organ_flag=='1'\">{{item.is_government_dept === '1' ? '是' :\n                    (item.is_government_dept === '0' ? '否' : '-')}}</div>\n                  <div class=\"cell-label col-3\" v-if=\"item.organ_flag!='1'\">出生年月</div>\n                  <div class=\"cell-value col-5\" v-if=\"item.organ_flag!='1'\">{{item.birthday || '-'}}</div>\n                </div>\n              </div>\n              <div v-if=\"!relatedInfo4 || relatedInfo4.length === 0\" class=\"table-row\">\n                <div class=\"cell-label col-3\">授权代表人信息</div>\n                <div class=\"cell-value col-21 empty-data\">暂无数据</div>\n              </div>\n            </div>\n            <h2 class=\"pdf-section-sub-title\">受益所有人信息</h2>\n            <div class=\"info-div\">\n              <div v-for=\"(item, index) in relatedInfo5\" :key=\"item.related_id\" :class=\"{'person-divider': index > 0}\">\n                <div class=\"table-row\">\n                  <div class=\"cell-label col-3\">受益所有人姓名</div>\n                  <div class=\"cell-value col-5\">{{item.related_name || '-'}}</div>\n                  <div class=\"cell-label col-3\" v-if=\"item.organ_flag=='1'\">国家或地区</div>\n                  <div class=\"cell-label col-3\" v-if=\"item.organ_flag!='1'\">国籍</div>\n                  <div class=\"cell-value col-5\">\n                    {{item.nationality?formatDictMap('nationality_list',item.nationality):'-'}}\n                  </div>\n                  <div class=\"cell-label col-3\">证件类型</div>\n                  <div class=\"cell-value col-5\">{{item.id_type?formatDictMap('id_type_list',item.id_type):'-'}}</div>\n                </div>\n                <div class=\"table-row\">\n                  <div class=\"cell-label col-3\">证件号码</div>\n                  <div class=\"cell-value col-5\">{{item.id_no || '-'}}</div>\n                  <div class=\"cell-label col-3\">证件有效期期限</div>\n                  <div class=\"cell-value col-5\">{{item.id_begindate || '-'}}至{{item.id_enddate || '-'}}</div>\n                  <div class=\"cell-label col-3\">出生年月</div>\n                  <div class=\"cell-value col-5\">{{item.birthday || '-'}}</div>\n                </div>\n                <div class=\"table-row\">\n                  <div class=\"cell-label col-3\">股权/表决权比例</div>\n                  <div class=\"cell-value col-5\">{{item.shareholding_ratio ? (item.shareholding_ratio + '%') : '-'}}\n                  </div>\n                  <div class=\"cell-label col-3\">受益所有人类型</div>\n                  <div class=\"cell-value col-5\">{{item.beneficiary?formatDictMap('beneficiary_list',item.beneficiary) :\n                    '-'}}\n                  </div>\n                  <div class=\"cell-label col-3\">联系地址</div>\n                  <div class=\"cell-value col-5\">{{item.address || '-'}}</div>\n                </div>\n              </div>\n              <div v-if=\"!relatedInfo5 || relatedInfo5.length === 0\" class=\"table-row\">\n                <div class=\"cell-label col-3\">受益所有人信息</div>\n                <div class=\"cell-value col-21 empty-data\">暂无数据</div>\n              </div>\n            </div>\n          </div>\n\n          <div class=\"info-div\">\n            <div class=\"table-row\">\n              <div class=\"cell-value\" v-if=\"organ_flag=='1'\">声明：本机构保证所提供资料的真实性、准确性、完整性、有效性，并对其承担责任；\n                如上述内容发生变更时将及时以书面方式通知贵公司，如因为不能及时完成变更由此产生的一切后果将由本机构承担。<br><br>\n              </div>\n              <div class=\"cell-value\" v-if=\"organ_flag=='0'\">声明：本人保证前述所填信息以及所提供资料的真实性、准确性、完整性、有效性，并对其承担责任；\n                如上述内容发生变更时将及时以书面方式通知贵公司，如因为不能及时完成变更由此产生的一切后果将由本人承担。<br><br>\n                <div style=\"font-weight:bold;color:#303133\">签名：</div>\n              </div>\n            </div>\n            <div class=\"table-row\" v-if=\"organ_flag=='1'\">\n              <div class=\"cell-label col-3\" style=\"height:100px;\">机构盖章:</div>\n              <div class=\"cell-value col-21\"></div>\n            </div>\n            <div class=\"table-row\">\n              <div class=\"cell-label col-3\">建立业务关系日期</div>\n              <div class=\"cell-value col-5\">{{basicInfo.associated_date}}</div>\n            </div>\n          </div>\n        </div>\n      </el-card>\n    </div>\n  </div>\n  <!--弹窗-->\n  <el-dialog title=\"附件管理\" :visible.sync=\"fileDialogVisible\" :close-on-click-modal=\"false\" @close=\"closeDialog('3')\">\n    <el-form>\n      <el-form-item label=\"附件类型\">\n        <el-cascader v-model=\"selectedMenu\" :options=\"organ_flag==='0'?directoryConfig2:directoryConfig1\"\n          style=\"width:60%;margin-bottom:20px;\">\n      </el-form-item>\n      <el-form-item label=\"上传附件\">\n        <el-upload class=\"upload-demo\" ref=\"upload\"\n          action=\"m?xwl=aml_monitor/workflow/prs01/dataSource/files/upload_file1\" name=\"file1\"\n          header=\"{content-type:'text/html'}\" :data=\"uploadParams\" :file-list=\"fileList\" :auto-upload=\"false\"\n          :on-change=\"handleChange\" :on-remove=\"handleRemove\" multiple>\n          <el-button slot=\"trigger\" size=\"mini\" icon=\"el-icon-upload2\">上传文件</el-button>\n          <div slot=\"tip\" class=\"el-upload__tip\">支持扩展名 .zip .rar .xlsx .xls .doc .docx .pdf .jpg .jpeg .svg .gif .png\n            .txt .mp3 .mp4</div>\n        </el-upload>\n      </el-form-item>\n    </el-form>\n    <div slot=\"footer\" class=\"dialog-footer\">\n      <el-button @click=\"fileDialogVisible = false\">取消</el-button>\n      <el-button type=\"primary\" @click=\"submitUpload\">提交</el-button>\n    </div>\n  </el-dialog>\n  <!--3实际控制人、2控股股东（可以选择自然人/法人）-->\n  <el-dialog :title=\"editForm.title\" :visible.sync=\"dialogFormVisible\" width=\"60%\" :close-on-click-modal=\"false\">\n    <div>\n      <el-form :model=\"editForm\" ref=\"editForm\" :rules=\"rules1\" label-width=\"120px\" label-position=\"top\"\n        :class=\"['register-form', {'hide-required-mark': shouldHideRequiredMark}]\" :hide-required-asterisk=\"true\">\n        <el-row :gutter=\"20\">\n          <el-col :span=\"8\">\n            <el-form-item :label=\"editForm.title+'类型'\" prop=\"organ_flag\"\n              v-if=\"editForm.related_type=='2'||editForm.related_type=='3'\">\n              <el-radio-group v-model=\"editForm.organ_flag\" :disabled=\"!editForm.new_flag\"\n                @change=\"resetForm(editForm)\">\n                <el-radio label=\"1\">法人</el-radio>\n                <el-radio label=\"0\">自然人</el-radio>\n              </el-radio-group>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <el-form-item prop=\"related_name\" class=\"always-show-required\">\n              <template slot=\"label\">\n                <div style=\"display: flex; align-items: center;\">\n                  <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                    <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\">*</span>{{editForm.organ_flag=='1'?editForm.title+'（法人）':editForm.title+'（自然人）'}}\n                  </div>\n                </div>\n              </template>\n              <el-select clearable v-model=\"editForm.related_name\" allow-create filterable placeholder=\"请选择\"\n                @focus=\"selectRelaOptions(editForm.organ_flag)\" :disabled=\"editForm.new_flag ? false : true\"\n                @change=\"setRelaValue(editForm.related_name,'form')\" default-first-option>\n                <el-option v-for=\"item in curRelaOptions\" :key=\"item.related_id\" :label=\"item.related_name\"\n                  :value=\"item.related_name\">\n                </el-option>\n              </el-select>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <el-form-item label=\"\" v-if=\"editForm.organ_flag==='1'\" prop=\"is_government_dept\">\n              <template slot=\"label\">\n                <div style=\"display: flex; align-items: center;\">\n                  <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                    <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>是否政府部门\n                  </div>\n                </div>\n              </template>\n              <el-radio-group v-model=\"editForm.is_government_dept\">\n                <el-radio label=\"1\">是</el-radio>\n                <el-radio label=\"0\">否</el-radio>\n              </el-radio-group>\n            </el-form-item>\n            <el-form-item v-if=\"editForm.organ_flag==='0'\" prop=\"birthday\">\n              <template slot=\"label\">\n                <div style=\"display: flex; align-items: center;\">\n                  <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                    <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>出生年月\n                  </div>\n                  <el-tooltip class=\"item\" effect=\"dark\" content=\"如需手动填写，请按照“1990-01-01”的格式填写\" placement=\"top\">\n                    <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n                  </el-tooltip>\n                </div>\n              </template>\n              <el-date-picker v-model=\"editForm.birthday\" type=\"date\" placeholder=\"年-月-日\" style=\"flex:1;\"\n                format=\"yyyy-MM-dd\" clearable>\n            </el-form-item>\n          </el-col>\n        </el-row>\n        <el-row :gutter=\"20\">\n          <el-col :span=\"8\">\n            <el-form-item prop=\"id_type\">\n              <template slot=\"label\">\n                <div style=\"display: flex; align-items: center;\">\n                  <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                    <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"(ruleForm3.is_special==='0'&& (editForm.is_government_dept==='0'||!editForm.is_government_dept)&& editForm.organ_flag==='1')||(ruleForm3.is_special==='0'&& editForm.organ_flag==='0')\">*</span>证照类型\n                  </div>\n                </div>\n              </template>\n              <el-select v-model=\"editForm.id_type\" placeholder=\"请选择\" clearable @change=\"clearIdNoValidate('editForm')\">\n                <el-option\n                  v-for=\"item in (editForm.organ_flag=='1'?selectList.id_type_jg_list:selectList.id_type_gr_list)\"\n                  :key=\"item.k\" :label=\"item.v\" :value=\"item.k\">\n                </el-option>\n              </el-select>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <el-form-item prop=\"id_no\">\n              <template slot=\"label\">\n                <div style=\"display: flex; align-items: center;\">\n                  <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                    <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"(ruleForm3.is_special==='0'&& (editForm.is_government_dept==='0'||!editForm.is_government_dept)&& editForm.organ_flag==='1')||(ruleForm3.is_special==='0'&& editForm.organ_flag==='0')\">*</span>证照号码\n                  </div>\n                </div>\n              </template>\n              <el-input v-model=\"editForm.id_no\" placeholder=\"请输入\"></el-input>\n            </el-form-item>\n          </el-col>\n        </el-row>\n        <el-row :gutter=\"20\">\n          <el-col :span=\"16\">\n            <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n              <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right:4px;\"\n                v-if=\"(ruleForm3.is_special==='0'&& (editForm.is_government_dept==='0'||!editForm.is_government_dept)&& editForm.organ_flag==='1')||(ruleForm3.is_special==='0'&& editForm.organ_flag==='0')\">*\n              </span>证件有效期\n              <el-tooltip class=\"item\" effect=\"dark\" content=\"如需手动填写，请按照“1990-01-01”的格式填写\" placement=\"top\">\n                <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n              </el-tooltip>\n            </div>\n            <div style=\"display:flex;width:100%;gap:8px;\">\n              <el-form-item prop=\"id_begindate\">\n                <el-date-picker v-model=\"editForm.id_begindate\" type=\"date\" placeholder=\"开始日期\" style=\"flex:1;\"\n                  format=\"yyyy-MM-dd\" clearable>\n                </el-date-picker>\n              </el-form-item>\n              <div style=\"height:40px;line-height:40px;\">至</div>\n              <el-form-item prop=\"id_enddate\">\n                <el-date-picker v-model=\"editForm.id_enddate\" type=\"date\" placeholder=\"结束日期\" style=\"flex:1;\"\n                  format=\"yyyy-MM-dd\" align=\"right\" :picker-options=\"pickerOptions\" clearable>\n                </el-date-picker>\n              </el-form-item>\n            </div>\n          </el-col>\n          <el-col :span=\"8\">\n            <el-form-item prop=\"nationality\">\n              <template slot=\"label\">\n                <div style=\"display: flex; align-items: center;\">\n                  <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                    <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"(ruleForm3.is_special==='0'&& (editForm.is_government_dept==='0'||!editForm.is_government_dept)&& editForm.organ_flag==='1')||(ruleForm3.is_special==='0'&& editForm.organ_flag==='0')\">*</span>{{editForm.organ_flag=='1'?'国家或地区':'国籍'}}\n                  </div>\n                </div>\n              </template>\n              <el-select v-model=\"editForm.nationality\" filterable placeholder=\"请选择\" clearable>\n                <el-option v-for=\"item in selectList.nationality_list\" :key=\"item.k\" :label=\"item.v\" :value=\"item.k\">\n                </el-option>\n              </el-select>\n            </el-form-item>\n          </el-col>\n        </el-row>\n      </el-form>\n    </div>\n    <div slot=\"footer\" class=\"dialog-footer\">\n      <el-button @click=\"closeDialog('1')\">取消</el-button>\n      <el-button type=\"primary\" @click=\"saveEditForm('1','1')\"\n        v-if=\"editForm.related_type!=='1'&&editForm.related_type!=='4'\">提交并录入下一条</el-button>\n      <el-button type=\"primary\" @click=\"saveEditForm('2','1')\">提交</el-button>\n    </div>\n  </el-dialog>\n  <!--1法定代表人、4授权代表人、5受益所有人（只能是自然人）-->\n  <el-dialog :title=\"editForm1.title\" :visible.sync=\"dialogFormVisible1\" width=\"60%\" :close-on-click-modal=\"false\"\n    :custom-class=\"'related_dialog'\" @close=\"closeDialog('2')\">\n    <div>\n      <el-form :model=\"editForm1\" ref=\"editForm1\" :rules=\"rules1\" label-width=\"120px\" label-position=\"top\"\n        :class=\"['register-form', {'hide-required-mark': shouldHideRequiredMark}]\" :hide-required-asterisk=\"true\">\n        <el-row :gutter=\"20\">\n          <el-col :span=\"8\">\n            <el-form-item label=\"姓名\" prop=\"related_name\" class=\"always-show-required\">\n              <el-select clearable v-model=\"editForm1.related_name\" allow-create filterable placeholder=\"请选择\"\n                @focus=\"selectRelaOptions('0')\" :disabled=\"editForm1.new_flag ? false : true\"\n                @change=\"setRelaValue(editForm1.related_name,'form1')\" default-first-option>\n                <el-option v-for=\"item in curRelaOptions\" :key=\"item.related_id\" :label=\"item.related_name\"\n                  :value=\"item.related_name\">\n                </el-option>\n              </el-select>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <el-form-item prop=\"birthday\">\n              <template slot=\"label\">\n                <div style=\"display: flex; align-items: center;\">\n                  <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                    <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>出生年月\n                  </div>\n                  <el-tooltip class=\"item\" effect=\"dark\" content=\"如需手动填写，请按照“1990-01-01”的格式填写\" placement=\"top\">\n                    <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n                  </el-tooltip>\n                </div>\n              </template>\n              <el-date-picker v-model=\"editForm1.birthday\" type=\"date\" placeholder=\"年-月-日\" style=\"flex:1;\"\n                format=\"yyyy-MM-dd\" clearable>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <el-form-item prop=\"nationality\">\n              <template slot=\"label\">\n                <div style=\"display: flex; align-items: center;\">\n                  <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                    <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>国籍\n                  </div>\n                </div>\n              </template>\n              <el-select v-model=\"editForm1.nationality\" filterable placeholder=\"请选择\" clearable>\n                <el-option v-for=\"item in selectList.nationality_list\" :key=\"item.k\" :label=\"item.v\" :value=\"item.k\">\n                </el-option>\n              </el-select>\n            </el-form-item>\n          </el-col>\n        </el-row>\n        <el-row :gutter=\"20\">\n          <el-col :span=\"8\">\n            <el-form-item prop=\"id_type\">\n              <template slot=\"label\">\n                <div style=\"display: flex; align-items: center;\">\n                  <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                    <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>证照类型\n                  </div>\n                </div>\n              </template>\n              <el-select v-model=\"editForm1.id_type\" placeholder=\"请选择\" clearable\n                @change=\"clearIdNoValidate('editForm1')\">\n                <el-option v-for=\"item in selectList.id_type_gr_list\" :key=\"item.k\" :label=\"item.v\" :value=\"item.k\">\n                </el-option>\n              </el-select>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"8\">\n            <el-form-item prop=\"id_no\">\n              <template slot=\"label\">\n                <div style=\"display: flex; align-items: center;\">\n                  <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                    <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>证照号码\n                  </div>\n                </div>\n              </template>\n              <el-input v-model=\"editForm1.id_no\" placeholder=\"请输入\" clearable></el-input>\n            </el-form-item>\n          </el-col>\n        </el-row>\n        <el-row :gutter=\"20\">\n          <el-col :span=\"12\">\n            <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n              <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right:4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>\n              证件有效期\n              <el-tooltip class=\"item\" effect=\"dark\" content=\"如需手动填写，请按照“1990-01-01”的格式填写\" placement=\"top\">\n                <i class=\"el-icon-question\" style=\"margin-left: 4px; color: #909399; cursor: pointer;\"></i>\n              </el-tooltip>\n            </div>\n            <div style=\"display:flex;width:100%;gap:8px;\">\n              <el-form-item prop=\"id_begindate\">\n                <el-date-picker v-model=\"editForm1.id_begindate\" type=\"date\" placeholder=\"开始日期\" style=\"flex:1;\"\n                  format=\"yyyy-MM-dd\" clearable>\n                </el-date-picker>\n              </el-form-item>\n              <div style=\"height:40px;line-height:40px;\">至</div>\n              <el-form-item prop=\"id_enddate\">\n                <el-date-picker v-model=\"editForm1.id_enddate\" type=\"date\" placeholder=\"结束日期\" style=\"flex:1;\"\n                  format=\"yyyy-MM-dd\" align=\"right\" :picker-options=\"pickerOptions\" clearable>\n                </el-date-picker>\n              </el-form-item>\n            </div>\n          </el-col>\n          <el-col :span=\"12\" v-if=\"editForm1.related_type=='5'\">\n            <el-form-item prop=\"address\">\n              <template slot=\"label\">\n                <div style=\"display: flex; align-items: center;\">\n                  <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                    <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>联系地址\n                  </div>\n                </div>\n              </template>\n              <el-input v-model=\"editForm1.address\"></el-input>\n            </el-form-item>\n          </el-col>\n        </el-row>\n        <!--受益所有人-->\n        <el-row :gutter=\"20\" v-if=\"editForm1.related_type=='5'\">\n          <el-col :span=\"12\">\n            <el-form-item prop=\"gender\">\n              <template slot=\"label\">\n                <div style=\"display: flex; align-items: center;\">\n                  <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                    <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>性别\n                  </div>\n                </div>\n              </template>\n              <el-select v-model=\"editForm1.gender\" filterable placeholder=\"请选择\" clearable style=\"width:100%\">\n                <el-option v-for=\"item in selectList.benefit_gender_list\" :key=\"item.k\" :label=\"item.v\" :value=\"item.k\">\n                </el-option>\n              </el-select>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"12\">\n            <el-form-item prop=\"mobno1\"\n              v-if=\"editForm1.beneficiary=='A1'||editForm1.beneficiary=='A2'||editForm1.beneficiary=='B1'||editForm1.beneficiary=='D1'\">\n              <template slot=\"label\">\n                <div style=\"display: flex; align-items: center;\">\n                  <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                    <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>联系电话（手机）\n                  </div>\n                </div>\n              </template>\n              <el-input v-model.number=\"editForm1.mobno1\" type=\"number\" :max=\"100\" :min=\"0\">\n              </el-input>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"12\">\n            <el-form-item prop=\"mobno2\"\n              v-if=\"editForm1.beneficiary=='A1'||editForm1.beneficiary=='A2'||editForm1.beneficiary=='B1'||editForm1.beneficiary=='D1'\">\n              <template slot=\"label\">\n                <div style=\"display: flex; align-items: center;\">\n                  <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                    <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>联系电话（固定电话）\n                  </div>\n                </div>\n              </template>\n              <el-input v-model.number=\"editForm1.mobno2\" type=\"number\" :max=\"100\" :min=\"0\">\n              </el-input>\n            </el-form-item>\n          </el-col>\n          <!--\n          <el-col :span=\"12\">\n            <el-form-item prop=\"beneficiary\">\n              <template slot=\"label\">\n                <div style=\"display: flex; align-items: center;\">\n                  <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\"><span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>受益所有人类型</div>\n                </div>\n              </template>\n              <el-select v-model=\"editForm1.beneficiary\" filterable placeholder=\"请选择\" clearable style=\"width:100%\">\n                <el-option v-for=\"item in selectList.beneficiary_list\" :key=\"item.k\" :label=\"item.v\" :value=\"item.k\">\n                </el-option>\n              </el-select>\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"12\">\n            <el-form-item prop=\"shareholding_ratio\" v-if=\"editForm1.beneficiary=='A1'||editForm1.beneficiary=='A2'||editForm1.beneficiary=='B1'||editForm1.beneficiary=='D1'\">\n              <template slot=\"label\">\n                <div style=\"display: flex; align-items: center;\">\n                  <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\"><span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>股权/表决权比例</div>\n                </div>\n              </template>\n              <el-input v-model.number=\"editForm1.shareholding_ratio\" type=\"number\" :max=\"100\" :min=\"0\">\n                <template slot=\"append\">%</template>\n              </el-input>\n            </el-form-item>\n          </el-col>\n          -->\n        </el-row>\n        <el-row :gutter=\"20\" v-if=\"editForm1.related_type=='5'\">\n          <el-col :span=\"20\">\n            <el-form-item prop=\"bnf_type\">\n              <template slot=\"label\">\n                <div style=\"display: flex; align-items: center;\">\n                  <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                    <span style=\"color:#F56C6C;height:40px;line-height:40px;margin-right: 4px;\" v-if=\"ruleForm3.is_special==='0'\">*</span>受益所有人类型\n                  </div>\n                </div>\n              </template>\n              <el-select v-model=\"editForm1.bnf_type_array\" filterable multiple placeholder=\"请选择\" clearable style=\"width:100%\" :popper-append-to-body=\"false\" @change=\"(val) => editForm1.bnf_type = val.join(',')\">\n                <el-option v-for=\"item in selectList.bnf_type_mix_list\" :key=\"item.k\" :label=\"item.v\" :value=\"item.k\" :disabled=\"(item.k === 'A3' || item.k === 'B2' || item.k === 'D1') ? true : false\">\n                </el-option>\n              </el-select>\n            </el-form-item>\n          </el-col>\n        </el-row>\n        <el-row :gutter=\"24\" v-show=\"editForm1.related_type=='5' && ((editForm1.bnf_type || '').includes('NA1') || \n            (editForm1.bnf_type || '').includes('NA2-1') || \n            (editForm1.bnf_type || '').includes('NA2-2') || \n            (editForm1.bnf_type || '').includes('NA2-1') ||\n            (editForm1.bnf_type || '').includes('NB1') ||\n            (editForm1.bnf_type || '').includes('NB2-1') ||\n            (editForm1.bnf_type || '').includes('NB2-2') ||\n            (editForm1.bnf_type || '').includes('ND1'))\">\n          <el-col :span=\"8\">\n            <el-form-item prop=\"acthdrat\">\n              <template slot=\"label\">\n                <div style=\"display: flex; align-items: center;\">\n                  <div style=\"height:40px;line-height:40px;font-size:14px;color:#606266;\">\n                    <span style=\"color: