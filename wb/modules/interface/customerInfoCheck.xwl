{
  "title": "反洗钱用户信息检查",
  "icon": "",
  "img": "",
  "tags": "",
  "hideInMenu": "false",
  "text": "module",
  "cls": "Wb.Module",
  "properties": {
    "cid": "module",
    "serverScript": "let i_usercode = Wb.get('i_usercode'),// 接口传参\n  i_entname = Wb.get('i_entname'),\n  i_key = Wb.get('i_key'),\n  i_type = Wb.get('i_type'),\n  i_custtype = Wb.get('i_custtype');// 0机构 1个人\n\n\nif (i_usercode === null || i_entname === null || i_key === null || i_usercode === '' || i_entname === '' || i_key === '') {\n  Wb.invoke('m?xwl=interface/customerInfoCheck/error-page');\n  return;\n}\n\n\nlet data = Wb.sql({ sql: `{call THJS.p_fxq_cust_interface_q({*cursor|return*},{?i_entname?},{?i_usercode?},{*O_RETURN_MSG*},{*O_RETURN_CODE*})}`, contextParams: false, params: { i_entname: i_entname, i_usercode: i_usercode } });\n\n// 保存参数\nlet data1 = Wb.sql({ sql: `{call THJS.p_fxq_interface_log_s('0',{?i_entname?},{?i_key?},{?i_type?},{?i_usercode?},{*O_RETURN_MSG*},{*O_RETURN_CODE*})}`, contextParams: false, params: { i_entname: i_entname, i_key: i_key, i_type: i_type, i_usercode: i_usercode } });\n\nif (!data || data.return.items.length !== 1) {\n  Wb.invoke('m?xwl=interface/customerInfoCheck/error-page');\n  return;\n}\nif (data.return.items[0].user_flag === '0') {\n  Wb.invoke('m?xwl=interface/customerInfoCheck/error-page');\n  return;\n}\n\n// 不存在\nif (data.return.items[0].is_exists === '0') {\n  Wb.invoke('m?xwl=interface/togo', {\n    WHAT: 'insert',\n    USERCODE: i_usercode,\n    KEY: i_key,\n    ENTNAME: i_entname,\n    ITYPE: i_type,//标准化票据\n    CUST_TYPE: i_custtype || data.return.items[0].cust_type,\n    CUST_ID: data.return.items[0].cust_id\n  }, false);\n  return;\n}\n\n// 存在\nif (data.return.items[0].is_exists === '1') {\n  Wb.invoke('m?xwl=interface/togo', {\n    WHAT: 'update',\n    USERCODE: i_usercode,\n    KEY: i_key,\n    CUST_TYPE: data.return.items[0].cust_type,\n    CUST_ID: data.return.items[0].cust_id,\n    ENTNAME: data.return.items[0].cust_name\n  }, false);\n  return;\n}\n\n"
  },
  "_icon": "module",
  "_expanded": true
}