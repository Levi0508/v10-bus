{"title":"ceshi","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"var i_key = Wb.get('i_key');\nvar i_cert_no = Wb.get('i_cert_no');\nvar i_usercode = Wb.get('i_usercode');\nvar i_username = Wb.get('sys.username');\n\nlet sentence = \"进入了call_reback函数内部，i_key:\" + i_key + \";i_cert_no:\" + i_cert_no + \";i_usercode:\" + i_usercode + \";i_username:\" + i_username;\nvar data1 = Wb.sql({ sql: `insert into thjs.t_tmp_exec_log(opt_user,opt_url,opt_params,opt_response)values({?opt_user?},{?opt_url?},{?opt_params?},{?opt_response?})`, contextParams: false, params: { opt_user: i_usercode, opt_url: 'http://10.181.100.144:8097/micro/aml', opt_params: 'sentence', opt_response: sentence } });\n\nWb.log(\"进入了call_reback函数内部，i_key:\" + i_key + \";i_cert_no:\" + i_cert_no + \";i_usercode:\" + i_usercode + \";i_username:\" + i_username);\n\nvar targetUrl = \"http://10.181.100.144:8097/micro/aml\";\n\nvar paramsObj = {\n  eventRecordId: i_key,\n  status: 'Y',\n  updator: i_usercode,\n  updateTime: DateUtil.format(new java.util.Date())\n};\n\nvar jsonStr = JSON.stringify(paramsObj);\nvar paramsBytes = jsonStr.getBytes(\"utf-8\");\n\nvar data2 = Wb.sql({ sql: `{call THJS.p_fxq_interface_log_s('1',{?i_cert_no?},{?i_key?},{?i_proj_type?},{?i_usercode?},{?@O_RETURN_MSG?},{?@INTEGER.O_RETURN_CODE?})}`, contextParams: false, params: { i_cert_no: i_cert_no, i_key: i_key, i_proj_type: '', i_usercode: i_usercode } });\n\nWb.log(\"存储过程返回结果: \" + data2);\n\nvar httpPost = function (url, method, params, timeout, contentType) {\n  var conn = (new java.net.URL(url)).openConnection();\n  try {\n    // 设置超时时间\n    conn.setConnectTimeout(timeout);\n    conn.setReadTimeout(8000); // 读取超时固定为 8秒，也可以改为动态传参\n    conn.setUseCaches(false);\n    conn.setRequestMethod(method);\n\n    if (params !== null) {\n      conn.setDoOutput(true);\n      conn.setRequestProperty(\"Content-Type\", contentType);\n      var os = conn.getOutputStream();\n      try {\n        os.write(params);\n        os.flush();\n      } finally {\n        os.close();\n      }\n    }\n\n    // 获取响应流\n    var bos = new java.io.ByteArrayOutputStream();\n    var is = conn.getInputStream();\n    try {\n      // 使用 Commons IO 进行流拷贝 (WB8 环境通常自带 commons-io)\n      org.apache.commons.io.IOUtils.copy(is, bos);\n    } finally {\n      is.close();\n    }\n    return bos.toByteArray();\n  } finally {\n    conn.disconnect();\n  }\n};\n\nvar resultBytes;\nvar resultStr = \"\";\n\ntry {\n  // 调用封装好的函数\n  // 参数说明：URL, 方法, 字节流参数, 连接超时(500ms), 内容类型\n  resultBytes = httpPost(targetUrl, 'POST', paramsBytes, 500, 'application/json');\n\n  // 将返回的字节流解码为字符串\n  resultStr = Wb.decode(new JavaString(resultBytes, 'utf-8'));\n\n  Wb.log(\"接口调用成功: \" + resultStr);\n\n} catch (e) {\n  Wb.log(\"接口调用异常: \" + e);\n  resultStr = JSON.stringify({ code: 500, msg: \"调用AML接口失败: \" + e });\n} finally {\n  var data3 = Wb.sql({ sql: `insert into thjs.t_tmp_exec_log(opt_user,opt_url,opt_params,opt_response)values({?opt_user?},{?opt_url?},{?opt_params?},{?opt_response?})`, contextParams: false, params: { opt_user: i_usercode, opt_url: 'http://10.181.100.144:8097/micro/aml', opt_params: Wb.encode(paramsObj), opt_response: Wb.encode(resultStr) } });\n  Wb.send(resultStr);\n}"},"_icon":"module"}