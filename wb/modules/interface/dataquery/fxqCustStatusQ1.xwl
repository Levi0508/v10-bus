{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"Wb.apply(app, {\n  getUserInfo: function () {\n    var i_usercode = request.getParameter('creditCode');\n    var i_entname = request.getParameter('custName');\n    // var i_usercode = 'xxx';\n    // var i_entname = '中国资产经营管理公司';\n\n    Wb.info(\"i_usercode=\" + i_usercode);\n    Wb.info(\"i_entname=\" + i_entname);\n    var outInfo = new JSONObject();\n\n    if (i_usercode === null && i_entname === null) {\n      outInfo.put(\"code\", \"-2\");\n      outInfo.put(\"resultMsg\", \"传参不能为空\");\n      return outInfo.toString();\n    }\n\n    var rec = Wb.sql({ sql: `select status,proj_status,user_code,to_char(update_time,'YYYY-MM-DD HH24:MI:SS') as update_time,to_char(info_update_time,'YYYY-MM-DD HH24:MI:SS') as info_update_time from THJS.VW_FXQ_CUST_INFO_TH where cert_no = {?creditCode?} or cust_name = {?custName?}`, contextParams: false, params: { custName: i_entname, creditCode: i_usercode } });\n    // Wb.send(rec);\n    if (rec.items.length > 0) {\n      outInfo.put(\"code\", \"0\");\n      outInfo.put(\"resultMsg\", \"执行成功\");\n      outInfo.put(\"data\", {\n        \"status\": rec.items[0].status,\n        \"proj_status\": rec.items[0].proj_status,\n        \"op_user\": rec.items[0].user_code,\n        \"update_time\": rec.items[0].update_time,\n        \"info_update_time\": rec.items[0].info_update_time\n      });\n      return outInfo.toString();\n    } else {\n      outInfo.put(\"code\", \"-1\");\n      outInfo.put(\"resultMsg\", \"查询失败\");\n      outInfo.put(\"data\", {\n        \"status\": null,\n        \"proj_status\": null\n      });\n      outInfo.put(\"success\", false);\n      return outInfo;//.toString();返回JSON格式\n    }\n  }\n});\n\nresponse.setContentType(\"application/json; charset=UTF-8\");\nWebUtil.send(response, app.getUserInfo());"},"_icon":"module"}