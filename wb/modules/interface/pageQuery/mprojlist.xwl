{
  "title": "我管理的清单列表",
  "icon": "",
  "img": "",
  "tags": "",
  "hideInMenu": "false",
  "text": "module",
  "cls": "Wb.Module",
  "properties": {
    "cid": "module",
    "serverScript": "let i_projid = Wb.get('i_projid');\nlet i_usercode = Wb.get('i_usercode');\nlet sys_usercode = Wb.get('sys.username');\nlet sys_user_id = Wb.get('sys.userid');\n\n//保存访问日志\n\nlet data1 = Wb.sql({ sql: `{call THJS.p_projlist_interface_log_s('2','mprojlist',{?i_projid?},{?i_usercode?},{*O_RETURN_MSG*},{*O_RETURN_CODE*})}`, contextParams: false, params: { i_projid: i_projid, i_usercode: i_usercode } });\n\nif (i_usercode === null) {\n  Wb.invoke('m?xwl=interface/projlist_form/error-page', null, false);\n  return;\n}\n\n//查询菜单权限并保持访问日志\nlet data = Wb.sql({ sql: `{call THJS.p_projlist_interface_q({*cursor|return*},'1',{?sys_user_id?},{*O_RETURN_MSG*},{*O_RETURN_CODE*})}`, contextParams: false, params: { sys_user_id: sys_user_id } });\n\nif (!data || data.return.items.length !== 1) {\n  Wb.invoke('m?xwl=interface/projlist_form/error-page', null, false);\n  return;\n}\n\nif (data.return.items[0].user_flag === '1') {\n  let params = data.return.items[0];\n  params.i_projid = i_projid;\n  params.i_usercode = sys_user_id;\n  Wb.invoke('m?xwl=th_projlist/ADMIN_PROJLIST', params, false);\n  return;\n} else {\n  Wb.invoke('m?xwl=interface/projlist_form/error-page', null, false);\n  return;\n}\n",
    "loginRequired": "false"
  },
  "_icon": "module",
  "items": []
}