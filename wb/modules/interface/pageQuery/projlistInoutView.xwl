{
  "title": "项目清单填报",
  "icon": "",
  "img": "",
  "tags": "",
  "hideInMenu": "false",
  "text": "module",
  "cls": "Wb.Module",
  "properties": {
    "cid": "module",
    "serverScript": "let i_key = Wb.get('i_key');\nlet i_projid = Wb.get('i_projid');\nlet i_usercode = Wb.get('i_usercode');\nlet sys_usercode = Wb.get('sys.username');\nlet sys_user_id = Wb.get('sys.userid');\n\n//保存访问日志\nlet data1 = Wb.sql({ sql: `{call THJS.p_projlist_interface_log_s('2',{?i_key?},{?i_projid?},{?i_usercode?},{*O_RETURN_MSG*},{*O_RETURN_CODE*})}`, contextParams: false, params: { i_key: i_key, i_projid: i_projid, i_usercode: i_usercode } });\n\nif (i_usercode === null) {\n  Wb.invoke('m?xwl=interface/projlist_form/error-page', null, false);\n  return;\n}\n\n//查询菜单权限\nlet data = Wb.sql({ sql: `{call THJS.p_projlist_interface_op_q({*cursor|return*},{?i_projid?},{?sys_user_id?},{*O_RETURN_MSG*},{*O_RETURN_CODE*})}`, contextParams: false, params: { i_projid: i_projid, sys_user_id: sys_user_id } });\n\n\nif (!data || data.return.items.length !== 1) {\n  Wb.invoke('m?xwl=interface/projlist_form/error-page', null, false);\n  return;\n}\n\nif (data.return.items[0].user_flag === '1') {\n  let data2 = Wb.sql({ sql: `{call THJS.p_projlist_inout_q({*cursor|return*},{?i_projid?},{?sys_user_id?},{*O_RETURN_MSG*},{*O_RETURN_MSG*})}`, contextParams: false, params: { i_projid: i_projid, sys_user_id: sys_user_id } });\n  if (!data2 || data2.return.items.length !== 1) {\n    Wb.invoke('m?xwl=interface/projlist_form/error-page', null, false);\n    return;\n  } else {\n    let params1 = data2.return.items[0];\n    params1.i_key = i_key;\n    params1.state = 'info';\n    // Wb.invoke('m?xwl=inteface/projlist_form/projlist_form_tab_sumbit', params1, false);\n    Wb.invoke('m?xwl=info_query/projlist/projlist_form_container', params1, false);\n    return;\n  }\n} else {\n  Wb.invoke('m?xwl=interface/projlist_form/error-page', null, false);\n  return;\n}\n\n"
  },
  "_icon": "module",
  "items": []
}