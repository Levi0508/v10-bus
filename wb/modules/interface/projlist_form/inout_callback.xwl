  "properties": {
    "cid": "module",
    "serverScript": "// 老系统调用这个接口的逻辑全部被注释了 未实际使用\n\nvar i_key = Wb.get('i_key');\nvar i_projid = Wb.get('i_projid');\nvar i_usercode = Wb.get('i_usercode');\nvar sys_user_id = Wb.get('sys.userid') || '';\n\nlet sentence = \"进入了inout_callback函数内部，i_key:\" + i_key + \";i_projid:\" + i_projid + \";i_usercode:\" + i_usercode + \";i_username:\" + i_username;\n\ntry {\n  var data1 = Wb.sql({ sql: `insert into thjs.t_tmp_exec_log(opt_user,opt_url,opt_params,opt_response)values({?opt_user?},{?opt_url?},{?opt_params?},{?opt_response?})`, contextParams: false, params: { opt_user: i_usercode, opt_url: 'http://10.181.100.144:8097/micro/aml', opt_params: 'sentence', opt_response: sentence } });\n} catch (e) {\n  Wb.error(\"inout_callback日志记录报错：\", e)\n} finally {\n  Wb.log(\"inout_callback日志记录\")\n}\n\nWb.invoke('m?xwl=sys/service/interface/http-post');\n\nvar params;\n\nparams = {\n  eventRecordId: i_key,\n  status: 'Y',\n  updator: i_usercode,\n  updateTime: DateUtil.format(new java.util.Date())\n};\n\n// 保存回调日志\n// var data2 = Wb.decode(Wb.output('{call THJS.p_projlist_interface_log_s(\\'1\\',\\'' + i_key + '\\',\\'' + i_projid +  '\\',\\'' + i_usercode + '\\',{?@O_RETURN_MSG?},{?@INTEGER.O_RETURN_CODE?})}',null ,true));\nvar data2 = Wb.sql({ sql: `{call THJS.p_projlist_interface_log_s('1',{?i_key?},{?i_projid?},{?i_usercode?},{?@O_RETURN_MSG?},{?@INTEGER.O_RETURN_CODE?})}`, contextParams: false, params: { i_key: i_key, i_projid: i_projid, i_usercode: i_usercode } });\n\n\n//测试环境\n// result = Wb.httppost('http://10.187.176.40:8097/micro/aml', 'POST',\n// Wb.encode(params).getBytes(\"utf-8\"), 500, 'application/json');\n\n//生产环境\nresult = app.httppost('http://10.181.100.144:8097/micro/aml', 'POST',\n  Wb.encode(params).getBytes(\"utf-8\"), 500, 'application/json');\n\nresult = Wb.decode(new JavaString(result, 'utf-8'));\n\nvar data3 = Wb.sql({ sql: `insert into thjs.t_tmp_exec_log(opt_user,opt_url,opt_params,opt_response)values({?opt_user?},{?opt_url?},{?opt_params?},{?opt_response?})`, contextParams: false, params: { opt_user: i_usercode, opt_url: 'http://10.181.100.144:8097/micro/aml', opt_params: Wb.encode(params), opt_response: Wb.encode(result) } });\n\nWb.send(result);\n"
  },
  "_icon": "module"
}