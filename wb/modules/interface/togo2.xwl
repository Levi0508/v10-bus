{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module"},"_icon":"module","events":{"initialize":"var WHAT = '{#WHAT#}', USERCODE = '{#USERCODE#}', KEY = '{#KEY#}', ENTNAME = '{#ENTNAME#}',\n  ITYPE = '{#ITYPE#}', CUST_ID = '{#CUST_ID#}', IS_DEPOSITORY_CUS = '{#IS_DEPOSITORY_CUS#}', CUST_TYPE = '{#CUST_TYPE#}';\n\nif (WHAT == 'insert') {\n  //提示页面02\n  var html2 =\n    '<div style=\"background:rgb(22, 130, 185);color:#fff;text-align:center;height:40px;line-height:40px;\">系统中不存在该客户相关信息</div>' +\n    '<br>' +\n    '<p>请准确、完整填写客户信息，保存打印后，交客户签章确认，并留存工作底稿&nbsp;</p>' +\n    '<br>' +\n    '<div>你将成为该客户的最新维护人</div>' +\n    '<br>';\n\n  Wb.confirm(html2, function () {\n    if (ITYPE == '标准化票据') {\n      Wb.choose('是否同时担任存托机构且未贴现票据？', function (btn) {\n        console.log('btn', btn);\n        if (btn == 'yes') {\n          Wb.run({\n            url: 'm?xwl=inteface/customerInfoCheck/customer_new3',\n            title: '填写客户信息',\n            params: {\n              rzSearchRow: 1,\n              CUST_ID: CUST_ID,\n              WHAT: WHAT,\n              KEY: KEY,\n              CUST_NAME: ENTNAME,\n              isExcel: '1' //导入Excel表\n            },\n            success(scope) {\n              app.viewport1.add(scope.viewport1);\n            }\n          });\n        } else if (btn == 'no') {\n          Wb.run({\n            url: 'm?xwl=inteface/customerInfoCheck/customer_new3',\n            title: '填写客户信息',\n            params: {\n              rzSearchRow: 1,\n              CUST_ID: CUST_ID,\n              WHAT: WHAT,\n              KEY: KEY,\n              CUST_NAME: ENTNAME,\n              isExcel: '0'\n            },\n            success: function (scope) {\n              app.viewport1.add(scope.viewport1);\n            }\n          });\n        } else if (btn == 'cancel') {\n          Wb.close();\n\n        }\n      });\n    } else {\n      Wb.open({\n        url: 'm?xwl=inteface/customerInfoCheck/customer_new3',\n        title: '填写客户信息',\n        params: {\n          rzSearchRow: 1,\n          CUST_ID: CUST_ID,\n          WHAT: WHAT,\n          KEY: KEY,\n          CUST_NAME: ENTNAME,\n          isExcel: '0'\n        },\n        reload: true\n      });\n    }\n  });\n\n} else if (WHAT == 'update') {\n  //提示页面01\n  var html1 =\n    '<div style=\"background:rgb(85, 130, 53);color:#fff;text-align:center;height:40px;line-height:40px;\">【' + ENTNAME + '】已存在</div>' +\n    '<br>' +\n    '<p>点击【查看】以便阅知系统留存的客户反洗钱资料，系统将为你保存为该客户的最新更新人。</p>' +\n    '<p>在客户信息页，请核实已留存客户信息与底稿资料是否准确、完整。</p>' +\n    '<p>如遇更新或补充完善，请</p>' +\n    '<ul>' +\n    '<li style=\"list-style-type:none;\">（1）保存提交客户信息表并将打印版本交客户签章；</li>' +\n    '<li style=\"list-style-type:none;\">（2）签章版的客户信息表和补充的工作底稿上传到系统中。 </li>' +\n    '</ul>' +\n    '<br>' +\n    '<div>点击【取消】将退出本页面，反洗钱填报工作将不被记录。</div>' +\n    '<br>';\n  Wb.confirm(html1, function () {\n    // Ext.MessageBox.buttonText = {\n    //   ok: \"查看\",\n    //   cancel: \"取消\"\n    // };\n\n    Wb.ajax({\n      url: 'm?xwl=th_fxq/th_fxq_data/op_log_s',\n      params: {\n        i_op_type: '1',\n        i_cust_id: CUST_ID,\n        i_usercode: USERCODE\n      },\n      success(resp) {\n        Wb.open({\n          url: 'm?xwl=inteface/customerInfoCheck/customer_new3',\n          title: '填写客户信息',\n          params: {\n            rzSearchRow: 1,\n            CUST_ID: CUST_ID,\n            WHAT: WHAT,\n            KEY: KEY,\n            CUST_NAME: ENTNAME,\n            IS_DEPOSITORY_CUS: IS_DEPOSITORY_CUS\n          },\n          reload: true\n        });\n      }\n    });\n  });\n}\n"},"_expanded":true,"items":[{"_icon":"viewport","text":"viewport1","cls":"Wb.Viewport","properties":{"cid":"viewport1"}}]}