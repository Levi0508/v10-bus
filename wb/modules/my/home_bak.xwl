{"title":"","icon":"home","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"// Get desktop data\nfunction loadPageData() {\n  let data = Wb.getResource(['desktop', 'desktop'], [null, 'system']), items, url;\n\n  data = data[0] ?? data[1];\n  items = data?.portlets || [];\n  items.forEach(item => {\n    try {\n      url = item.moduleUrl;\n      item.script = Wb.permitx(url) && Wb.execute(url);\n    } catch (e) {\n      item.script = e?.toString();\n    }\n  });\n  Wb.set({ \n    items: Wb.encode(items),\n    loginusername: Wb.encode(Wb.username)\n  });\n}\nloadPageData();","remark":"My home page","links":"[\n  \"wb/gtht/home/css/flhgpt.css\"\n]"},"_icon":"module","_expanded":true,"events":{"initialize":"Wb.apply(app, {\n  loginusername: _$loginusername$_,\n  /**\n   * Execute after load.\n   */\n  mnufn() {\n\n  },\n  pickersearch(val, dom1, dom2) {\n    Wb.ajax({\n      url: xpath + '/../menu_active/get_gszd_nav',\n      params: {query: val},\n      success(res) {\n        dom1.data = Wb.decode(res);\n      }\n    }),\n    Wb.ajax({\n      url: xpath + '/../menu_active/get_gn_nav',\n      params: {query: val},\n      success(res) {\n        dom2.data = Wb.decode(res);\n      }\n    })\n  },\n  addQuickNav(par) {\n    Wb.ajax({\n      url: xpath + '/../menu_active/quick_nav_add',\n      params:{\n        menu_id: par.menu_id,\n        user_menu_type: 'Favorites',\n        create_time: Date.current().format('y-MM-dd HH:mm:ss')\n      },\n      mask:false,\n      success() {\n        Wb.tipSucc('成功添加到快捷导航');\n        app.tagListView.load({mask:false});\n        app.tagListView1.load({mask:false});\n      }\n    })\n  },\n  addHistoryNav(par) { \n    Wb.ajax({\n      url: xpath + '/../menu_active/history_nav_add',\n      params:{\n        menu_id: par.menu_id,\n        user_menu_type: 'Recent',\n        create_time: Date.current().format('y-MM-dd HH:mm:ss')\n      },\n      mask:false,\n      success() {\n        app.historyNavListView.load({mask:false});\n      }\n    })\n  },\n  delQuickNav(id) {\n    Wb.ajax({\n      url: xpath + '/../menu_active/quick_nav_del',\n      params:{\n        menu_id: id,\n        user_menu_type: 'Favorites',\n      },\n      mask:false,\n      success() {\n        app.tagListView.load({mask:false});\n        app.tagListView1.load({mask:false});\n      }\n    })\n  },\n  onLoad() {\n    let card = parentContainer;\n\n    app.restorePanels();\n    if (card?.app?.inHome) {\n      let tab = card.parent;\n      app.viewport1.homeTab = tab; // don't assign to app, prevent tab auto destroy\n      app.onCardChange.call(tab, card);\n      tab.on('cardchange', app.onCardChange)\n    }\n  },\n  // 全部这个模块下面的所有菜单就是由这个方法创建的\n  createMenu() {\n    Wb.ajax({\n      url: xpath + '/../menu_active/get_menu',\n      success(res) {\n        let data = Wb.decode(res), el = app.htmlComp.el, gtDhVItem, subEl, gtDhK, gtDhkItem, gtDhV, gtvitext, gtviicon;\n        gtDhK = el.addEl('w-grid1 gt-dhk');\n        gtDhV = el.addEl('w-grid1 gt-dhv w-scroll-true');\n        data.forEach(category => {\n          gtDhkItem = gtDhK.addEl(`gt-dhk-item dhkid-${category.module_id}`);\n          gtDhkItem.textContent = category.module_name;\n          gtDhVItem = gtDhV.addEl(`gtdvrow w-row w-grid6 category-${category.module_id}`);\n          console.log(category.items, \"对象\");\n          category.items.forEach(item => {\n            subEl = gtDhVItem.addEl(`w-row gtItem gt-${item.menu_id}`);\n            gtvitext = subEl.addEl('text');\n            gtvitext.textContent = item.menu_name;\n            gtvitext.addEventListener('click', () => {\n              app.addHistoryNav(item);\n              console.log(item, \"菜单对象\");\n              // Wb.openWin(item.menu_link);\n              Wb.openWin({url: item.menu_link, params: {menuName: item.menu_name}});\n            })\n            gtviicon = subEl.addEl('w-icon icon-add1');\n            gtviicon.addEventListener('click', () => {\n              app.addQuickNav(item)\n            })\n            // Wb.get(gtviicon).tip={\n            //   enterRetain: true, \n            //   html: '添加至快捷导航',\n            // };\n          });\n\n          gtDhkItem.addEventListener('mouseenter', (el) => {\n            document.querySelectorAll('.gtdvrow').forEach(item => {\n              item.classList.remove('gt-dhv-itembg')\n            });\n            document.querySelectorAll('.gt-dhk-item').forEach(item => {\n              item.classList.remove('gt-dhk-itembg')\n            });\n            const targetElement1 = document.querySelectorAll(`.dhkid-${category.module_id}`)[0];\n            if (targetElement1) {\n              targetElement1.classList.add('gt-dhk-itembg');\n            }\n            const targetElement = document.querySelectorAll(`.category-${category.module_id}`)[0];\n            if (targetElement) {\n              targetElement.classList.add('gt-dhv-itembg');\n              gtDhV.scrollTo({\n                top: targetElement.offsetTop - 20,\n                behavior: 'smooth'\n              });\n            }\n          });\n\n          gtDhVItem.addEventListener('mouseenter', (el) => {\n            document.querySelectorAll('.gt-dhk-item').forEach(item => {\n              item.classList.remove('gt-dhk-itembg')\n            });\n            document.querySelectorAll('.gtdvrow').forEach(item => {\n              item.classList.remove('gt-dhv-itembg')\n            });\n            const targetElement = document.querySelectorAll(`.dhkid-${category.module_id}`)[0];\n            if (targetElement) {\n              targetElement.classList.add('gt-dhk-itembg');\n            }\n          });\n        });\n      }\n    })\n  },\n  ready() {\n    app.createMenu();\n  },\n  /**\n   * Execute after tab card change. @priv\n   */\n  onCardChange(card) {\n    let tree = this.app.moduleTree, enabled = card == parentContainer;\n\n    tree.draggable = enabled ? {\n      acceptDrop() {\n        let data = this.source[0].data, tags = data.tags, panel;\n\n        if (tags) {\n          tags = Wb.parse(tags);\n          if (tags.frame || tags.newWin) {\n            Wb.tipWarn(Str.cannotOpenModule);\n            return;\n          }\n        }\n        panel = app.createPanel({\n          moduleUrl: 'm?xwl=' + data.path, icon: data._icon, img: data._img, tags,\n          strTitle: data.strTitle, title: data.text\n        });\n        panel.intoView();\n        panel.highlight();\n      }\n    } : false;\n    tree.setEvents(enabled, 'itemdrag', app.onItemDrag);\n  },\n  /**\n   * Module tree items drag. @priv\n   */\n  onItemDrag(data) {\n    let d = data.source[0].data;\n    data.allowDrop = d._leaf && d.path != 'my/home';\n    data.mode = 'append';\n  },\n  /**\n   * Create module panel. @priv\n   * @param {Object} data Module data.\n   * @return {Wb.Panel} The created panel.\n   */\n  createPanel(data) {\n    let panel, configs, moduleUrl, tags = data.tags, val, script;\n\n    moduleUrl = data.moduleUrl;\n    configs = {\n      cname: 'panel', layout: 'fit', plainTitle: true, roundBorder: true, closable: true, maximizable: true, titleBar: false, background: 'transparent', border: false,\n      moduleUrl, tags\n    };\n    val = data.col || 6;\n    configs.gridColValue = val;\n    configs.gridColumn = 'span ' + val;\n    val = data.row || 4;\n    configs.gridRowValue = val;\n    configs.gridRow = 'span ' + val;\n    if (data.icon)\n      configs.icon = data.icon;\n    else if (data.img)\n      configs.img = data.img;\n    if (data.strTitle) {\n      configs.strTitle = data.strTitle;\n      configs.title = Str[data.strTitle];\n    } else {\n      configs.title = data.title;\n    }\n    panel = app.viewport1.add(configs);\n    configs = {\n      container: panel, updateTitle: false, success(scope) {\n        let vp = panel.firstItem, tools;\n\n        if (vp instanceof Wb.Panel) {\n          vp.border = false;\n          tools = vp.tools?.filter(tool => tool.icon != 'close') ?? [];\n          if (vp.title)\n            panel.title = vp.title;\n          if (vp.icon)\n            panel.icon = vp.icon;\n          else if (vp.img)\n            panel.img = vp.img;\n        } else {\n          tools = [];\n        }\n        tools.push({\n          icon: 'menu', handler() {\n            let comp = this.up(p => p instanceof Wb.Panel);;\n            app.menuSetComp = comp;\n            app.colSlider.value = comp.gridColValue ?? 1;\n            app.rowSlider.value = comp.gridRowValue ?? 1;\n            app.mainMenu.showBy(this);\n          }\n        });\n        panel.tools = tools;\n        vp?.titleBar$?.destroy();\n        if (scope?.noTitlebar) {\n          panel.titleBar.hide();\n          panel.mon({\n            mouseenter() {\n              this.titleBar.show();\n            },\n            mouseleave() {\n              this.titleBar.hide();\n            }\n          })\n        }\n      }\n    };\n    script = data.script;\n    if (script)\n      configs.script = script;\n    else\n      configs.url = moduleUrl;\n    Wb.open(Wb.apply(configs, tags));\n    return panel;\n  },\n  /**\n   * Restore saved panels. @priv\n   */\n  restorePanels() {\n    let items = _$items$_;\n\n    items.forEach(item => {\n      // if (item.title != \"dome\")\n        app.createPanel(item);\n    });\n  }\n});"},"items":[{"_icon":"menu2","text":"mainMenu","cls":"Wb.Menu","properties":{"cid":"mainMenu","layout":"grid1","defaults":"({ labelWidth: '5em' })","minWidth":"18em","gap":"true","padding":"1em"},"_expanded":false,"items":[{"_icon":"slidebar","text":"colSlider","cls":"Wb.Slider","properties":{"cid":"colSlider","text":"@Str.column","maxValue":"12","minValue":"1","suffix":"true"},"events":{"change":"app.menuSetComp.gridColValue = value;\napp.menuSetComp.gridColumn = 'span ' + value;"}},{"_icon":"slidebar","text":"rowSlider","cls":"Wb.Slider","properties":{"cid":"rowSlider","text":"@Str.row","minValue":"1","maxValue":"12","suffix":"true"},"events":{"change":"app.menuSetComp.gridRowValue = value;\napp.menuSetComp.gridRow = 'span ' + value;"}}]},{"_icon":"container","text":"navbox","cls":"Wb.Container","properties":{"cid":"navbox","cls":"navbox","zIndex":"100"},"hasDupCid":0,"_expanded":false,"items":[{"_icon":"container","text":"box","cls":"Wb.Container","properties":{"cid":"box","width":"30%","background":"#ddd","cls":"box","height":"60%","visible":"false","zIndex":"100"},"hasDupCid":0},{"_icon":"container","text":"nav","cls":"Wb.Container","properties":{"cid":"nav","cls":"nav","border":"false","background":"none","zIndex":"99"},"hasDupCid":0,"_expanded":false,"items":[{"_icon":"list-view","text":"fixedView","cls":"Wb.View","properties":{"cid":"fixedView","itemTpl":"<div class=\"item\">\n  <div class=\"w-icon icon-{icon}\"></div>\n  <div class=\"title\">{text}</div>\n</div>","data":"[\n    { icon: 'file-admin', text: '事务中心', n: 'www'},\n    { icon: 'sms', text: '邮件'},\n    { icon: 'chart-line', text: '排行榜'},\n    { icon: 'preview', text: '通讯录'},\n    { icon: 'gear', text: '线上会议'},\n    { icon: 'truck', text: '智能交流'},\n    { icon: 'database', text: '超级助手'},\n    { icon: 'flow1', text: '千机char'},\n    { icon: 'flow1', text: '智能日历'},\n  ]","cls":"navlist","background":"none","border":"false","selectColor":"none","style":"box-shadow: none;"},"_expanded":true,"events":{"itemclick":"if (item.data?.n) {\n  Wb.open(item.data.n)\n} else {\n  // app.box.visible = !app.box.visible\n  app.leftDrawer ??= new Wb.Drawer({ dockPosition: 'left', width: '40vw', title: 'Left Drawer' });\n  app.leftDrawer.show();\n}\n"}},{"_icon":"button","text":"upBtn","cls":"Wb.Button","properties":{"cid":"upBtn","icon":"up","type":"primary","visible":"false","width":"4em"},"hasDupCid":0,"_expanded":true,"events":{"click":"app.fixedView.show();\napp.upBtn.hide();\napp.downBtn.show();"}},{"_icon":"button","text":"downBtn","cls":"Wb.Button","properties":{"cid":"downBtn","icon":"down","type":"primary","visible":"true","width":"4em"},"hasDupCid":0,"events":{"click":"app.fixedView.hide();\napp.upBtn.show();\napp.downBtn.hide();"}}]}]},{"_icon":"viewport","text":"viewport1","cls":"Wb.Viewport","properties":{"cid":"viewport1","layout":"grid12","padding":".5em 10em","gap":".5em","itemsSortable":"true","droppable":"wb.home","bodyCls":"w-home-body","cls":"flhgpt","autoScroll":"hide","border":"false"},"events":{"destroy":"app.viewport1.homeTab?.un('cardchange', app.onCardChange);\n","beforesort":"// only allow drag title bar\nif (!dragComp?.titleBar.el.contains(e.target))\n  return false;","ready":"app.ready();"},"_expanded":true,"items":[{"cls":"Wb.Toolbar","properties":{"cid":"tbar","isProperty":"true","height":"4em","background":"rgba(33,81,209,0.4)","cls":"tbar","justify":"space-between","padding":"0 10em"},"text":"tbar","_expanded":true,"_icon":"toolbar","hasDupCid":0,"items":[{"_icon":"container","text":"leftbox","cls":"Wb.Container","properties":{"cid":"leftbox","cls":"leftbox","layout":"row","gap":"true","align":"center","margin":"0 4em 0 0"},"hasDupCid":0,"_expanded":false,"items":[{"_icon":"picture","text":"picture1","cls":"Wb.Picture","properties":{"cid":"picture1","src":"wb/gtht/home/img/logo1.png","height":"2em"}},{"_icon":"divider","text":"divider1","cls":"Wb.Divider","properties":{"cid":"divider1","width":"2"},"hasDupCid":0},{"_icon":"label","text":"label1","cls":"Wb.Label","properties":{"cid":"label1","text":"法律合规平台","color":"#fff","cls":"title"},"hasDupCid":0}]},{"_icon":"item","text":"menuItem","cls":"Wb.Item","_expanded":true,"properties":{"cid":"menuItem","text":"全景导航","color":"#ffffff","fontSize":"1.2em","cls":"dh-btn","type":"light"},"events":{"ready":"this.mon(this.el,\"mouseenter\",() => {\n  this.menu.showBy(this.el, 'b', [100, 0])\n})\n","click":"this.menu.showMenu(this.el, 'b', [100, 0])"},"items":[{"_icon":"menu2","text":"menu","cls":"Wb.Menu","properties":{"cid":"menu","isProperty":"true","minWidth":"85%","cls":"qjdhMenu"},"_expanded":true,"hasDupCid":0,"events":{"ready":"this.mon(this.el,\"mouseleave\",() => {\n  this.hide();\n})\n"},"items":[{"_icon":"container","text":"container1","cls":"Wb.Container","properties":{"cid":"container1","cls":"zjylbox"},"hasDupCid":0,"_expanded":true,"items":[{"_icon":"title","text":"title2","cls":"Wb.Title","properties":{"cid":"title2","title":"最近预览","line":"false","marker":"false","margin":"false"},"hasDupCid":1,"_expanded":true},{"_icon":"list-view","text":"historyNavListView","cls":"Wb.View","properties":{"cid":"historyNavListView","border":"false","cls":"dh-zjyl","gap":"true","padding":".5em .5em 0 .5em","autoScroll":"false","background":"transparent","url":"@xpath + '/../menu_active/get_history_nav'","fontSize":".9em","itemTpl":"<div class=\"w-item w-padding w-align-center\">\n  <div class=\"rightbox\">\n    <div class=\"title\">{data.menu_name}</div>\n  </div>\n</div>","layout":"form"},"hasDupCid":0,"_expanded":true}]},{"_icon":"container","text":"container3","cls":"Wb.Container","properties":{"cid":"container3"},"hasDupCid":0,"_expanded":true,"items":[{"_icon":"title","text":"title2","cls":"Wb.Title","properties":{"cid":"title2","title":"快捷导航","line":"false","marker":"false","margin":"false","icon":"off","cls":"kjdh-title","iconColor":"#001c8c"},"hasDupCid":1,"_expanded":true,"events":{"click":"if (e.target.className.includes('w-icon')) {\n  // document.querySelectorAll('.gtht-close').forEach(item=>{\n  //   item.getStyle('display') == 'none' ? item.setStyle('display', 'block') : item.setStyle('display', 'none')\n  // });\n  if (e.target.className.includes('icon-off')) {\n    e.target.classList.remove('icon-off');\n    e.target.classList.add('icon-on');\n  } else {\n    e.target.classList.remove('icon-on');\n    e.target.classList.add('icon-off');\n  }\n\n  app.tagListSelect.visible = !app.tagListSelect.visible;\n  app.tagListView.visible = !app.tagListView.visible;\n  app.tagListView1.visible = !app.tagListView1.visible;\n  // document.querySelectorAll('.gtht-close').forEach(item=>{\n  //   app.tagListSelect.visible ? item.setStyle('display', 'block') : item.setStyle('display', 'none')\n  // });\n}"}},{"_icon":"combo","text":"tagListSelect","cls":"Wb.Select","properties":{"cid":"tagListSelect","visible":"false","url":"@xpath + '/../menu_active/get_quick_menu'","textField":"menu_name","valueField":"menu_id","width":"20em","padding":".5em 0 0 0","fontSize":".9em"},"events":{"select":"app.addQuickNav(data);\n"}},{"_icon":"list-view","text":"tagListView","cls":"Wb.View","properties":{"cid":"tagListView","itemTpl":"<div class=\"w-item w-row w-padding w-align-center w-gapd5\">\n  <div class=\"w-name\">{menu_name}</div>\n  <div class=\"w-btn w-close-btn w-btn-light gtht-close\" style=\"display: none\">\n    <div class=\"w-icon icon-close\"></div>\n  </div>\n</div>","url":"@xpath + '/../menu_active/get_quick_nav'","cls":"dh-kjdh","bodyCls":"w-form w-padding w-gapd5","border":"false","autoScroll":"false","captureClass":".w-close-btn","maxHeight":"6em","fontSize":".9em"},"_expanded":true,"events":{"itemclick":"console.log(item.data, item.data.menu_link, \"数据\")\nWb.openWin(item.data.menu_link)","captureclick":"app.delQuickNav(item.data.menu_id);"}},{"_icon":"list-view","text":"tagListView1","cls":"Wb.View","properties":{"cid":"tagListView1","itemTpl":"<div class=\"w-item w-row w-padding w-align-center w-gapd5\">\n  <div class=\"w-name\">{menu_name}</div>\n  <div class=\"w-btn w-close-btn w-btn-light gtht-close\">\n    <div class=\"w-icon icon-close\"></div>\n  </div>\n</div>","url":"@xpath + '/../menu_active/get_quick_nav'","cls":"dh-kjdh","bodyCls":"w-form w-padding w-gapd5","border":"false","autoScroll":"false","captureClass":".w-close-btn","maxHeight":"6em","visible":"false","fontSize":".9em"},"_expanded":true,"events":{"captureclick":"app.delQuickNav(item.data.menu_id);"}}]},{"_icon":"title","text":"title2","cls":"Wb.Title","properties":{"cid":"title2","title":"全部","line":"false","marker":"false","margin":"false"},"hasDupCid":1,"_expanded":true},{"_icon":"panel","text":"panel1","cls":"Wb.Panel","properties":{"cid":"panel1","layout":"fit"},"_expanded":true,"hasDupCid":0,"items":[{"_icon":"component","text":"htmlComp","cls":"Wb.Component","properties":{"cid":"htmlComp","cls":"w-row h-links-bos"}}]}]}]},{"_icon":"item","text":"item1","cls":"Wb.Item","_expanded":true,"properties":{"cid":"item1","text":"菜单跳转","color":"#ffffff","fontSize":"1.2em","type":"light","visible":"false"},"hasDupCid":1},{"_icon":"right1","text":"fill1","cls":"Wb.Fill","properties":{"cid":"fill1"},"_expanded":true},{"_icon":"container","text":"rightbox","cls":"Wb.Container","properties":{"cid":"rightbox","cls":"rightbox","layout":"row","gap":"true"},"_expanded":false,"items":[{"_icon":"picker","text":"picker1","cls":"Wb.Picker","properties":{"cid":"picker1","placeholder":"公司制度/功能","cls":"search","triggerIcon":"search","roundBorder":"true"},"events":{"change":"app.pickersearch(value, app.picker1.picker.items[1], app.picker1.picker.items[3]);\nthis.expanded = true;"},"_expanded":false,"items":[{"cls":"Wb.Array","properties":{"cid":"triggers"},"text":"triggers","_expanded":true,"_icon":"array","hasDupCid":0,"items":[{"cls":"Wb.Item","properties":{"cid":"searchBtn","icon":"search","tip":"@Str.search","iconColor":"#fff","visible":"false"},"text":"searchBtn","_expanded":true,"_icon":"item","hasDupCid":0},{"cls":"Wb.Item","properties":{"cid":"gearBtn","icon":"gear","tip":"@Str.set","iconColor":"#fff","visible":"false"},"text":"gearBtn","_expanded":true,"_icon":"item"}]},{"cls":"Wb.Container","properties":{"cid":"picker","isProperty":"true","padding":".5em","width":"30em","layout":"column"},"text":"picker","_expanded":true,"_icon":"container","hasDupCid":0,"items":[{"_icon":"title","text":"gszdtitle","cls":"Wb.Title","properties":{"cid":"gszdtitle","title":"公司制度","line":"false"}},{"_icon":"list-view","text":"gszdview","cls":"Wb.View","properties":{"cid":"gszdview","border":"false","minHeight":"5em","itemTpl":"<div class=\"w-padding\">\n  <div class=\"w-name\">{full_