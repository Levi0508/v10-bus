{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"let sql = 'select menu_id, menu_name, menu_name_py, menu_name_jp from wb_menu';\nif (Params.query) {\n  Wb.setLike('query');\n  sql += ' where menu_name like {?query?} or menu_name_py like {?query?} or menu_name_jp like {?query?}';\n}\nWb.sendRows(sql);"},"_icon":"module"}