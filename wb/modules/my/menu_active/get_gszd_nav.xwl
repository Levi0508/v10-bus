{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"// if (Params.query) {\n//   Wb.setLike('query');\n//   Wb.sendRows('select * from xxx where xx like {?query?}')\n// }\nlet sql = 'select code, full_name from wb_staff';\nif (Params.query) {\n  Wb.setLike('query');\n  sql += ' where full_name like {?query?}';\n}\nWb.sendRows(sql);"},"_icon":"module"}