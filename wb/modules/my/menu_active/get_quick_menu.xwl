{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"\n\nlet sql = 'select wb_menu.menu_id, wb_menu.menu_name from wb_menu where wb_menu.menu_id not in (select wb_user_menu.menu_id from wb_user_menu where wb_user_menu.user_menu_type = {?wb_user_menu?} and staff_id = {?staff_id?})';\n\nif (Params.query) {\n  Wb.setLike('query')\n  sql += ' and menu_name like {?query?} or menu_name_py like {?query?} or menu_name_jp like {?query?}'\n}\n\n// const data = Wb.sql({\n//   sql,\n//   params: {\n//     key: Params.query\n//   }\n// });\n// Wb.sendRows(sql)\n\nconst data = Wb.getRows({\n  sql: sql,\n  params: {wb_user_menu: 'Favorites', staff_id: Wb.userid}\n});\nWb.send(data);\n"},"_icon":"module"}