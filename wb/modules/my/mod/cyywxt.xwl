{"title":"常用业务系统","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","links":"[\n  \"wb/gtht/home/css/cyywxt.css\"\n]"},"_icon":"module","_expanded":true,"events":{"initialize":"Wb.apply(app, {\n  openWin(e) {\n    Wb.log(e)\n    win = app.editWin;\n    win.show();\n  }\n});"},"items":[{"_icon":"window","text":"editWin","cls":"Wb.Window","_expanded":true,"properties":{"cid":"editWin","layout":"grid1","resetDialog":"true","titleBar":"false","border":"false","resizable":"false","roundBorder":"true","labelUp":"true","width":"40em"},"items":[{"_icon":"title","text":"noLineTitle","cls":"Wb.Title","_expanded":true,"properties":{"cid":"noLineTitle","title":"添加常用业务","line":"false","marker":"false"}},{"_icon":"combo","text":"select1","cls":"Wb.Select","properties":{"cid":"select1","text":"业务"}}]},{"_icon":"viewport","text":"viewport1","cls":"Wb.Viewport","properties":{"cid":"viewport1","cls":"cyywxt","background":"rgba(255, 255, 255, .4)"},"_expanded":true,"items":[{"cls":"Wb.Toolbar","properties":{"cid":"tbar","isProperty":"true","padding":".5em 1em","background":"rgba(255, 255, 255, .4)"},"text":"tbar","_expanded":false,"_icon":"toolbar","hasDupCid":0,"items":[{"_icon":"title","text":"title1","cls":"Wb.Title","properties":{"cid":"title1","title":"常用业务系统","marker":"false"},"hasDupCid":0}]},{"_icon":"list-view","text":"view1","cls":"Wb.View","properties":{"cid":"view1","data":"[\n  {\n    a:'中央控制室',b:'简介及用户群体',c:'Frame1.png'\n  },\n  {\n    a:'交易所异常交易',b:'简介及用户群体',c:'Frame3.png'\n  },\n  {\n    a:'反洗钱监测分析',b:'简介及用户群体',c:'Frame5.png'\n  },\n  {\n    a:'合规大数据平台',b:'简介及用户群体',c:'Frame2.png'\n  },\n  {\n    a:'法规制度库',b:'简介及用户群体',c:'Frame4.png'\n  },\n  {\n    a:'新增',b:'自主添加',c:'Frame6.png'\n  }\n]","layout":"grid3","border":"false","background":"transparent","itemTpl":"<div class=\"w-item w-row item-box\">\n  <div class=\"item\">\n    <div class=\"leftbox\">\n      <img class=\"img\" src=\"wb/gtht/home/img/{data.c}\" />\n    </div>\n    <div class=\"rightbox\">\n     <div class=\"title\">{data.a}</div>\n     <div class=\"text\">{data.b}</div>\n    </div>\n  </div>\n  <div class=\"icon-box\" cid=\"menu-btn\" style=\"display: {data.a != '新增' ? 'black' : 'none'}\">\n    <div class=\"w-icon icon-delete\"></div>\n  </div>\n</div>","cls":"cyywxt-list","selectColor":"none","padding":"1em"},"events":{"itemclick":"let target = e.target;\n\nif(item.data.a != '新增') {\n\n\n  if (target.closest('[cid=menu-btn]')) {\n    // let menu;\n    // menu = app.viewContextMenu ??= new Wb.Menu({\n    //   items: [\n    //     // {\n    //     //   text: '修改', icon: 'edit', handler() {\n    //     //     app.openWin(item)\n    //     //   }\n    //     // },\n    //     {text: '删除', icon: 'delete1'}\n    //   ]\n    // });\n    // menu.showBy(target);\n    Wb.confirm('是否删除该业务系统?', f => Wb.tip('click OK'), f => Wb.tip('click Cancel'));\n  }\n\n} else {\n   app.openWin(item)\n}"}}]}]}