{"title":"轮播图","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","links":"[\n  \"wb/gtht/home/css/lbt.css\"\n]"},"_icon":"module","_expanded":true,"events":{"initialize":"Wb.apply(app, {\n  addCarousel(data) {\n    let ct = app.carousel, comp, el, boxs;\n    ct.destroyAll();\n    data.forEach(item => {\n      comp = ct.add({ cls: 'lbt-items' });\n      item.forEach(i => {\n        boxs = comp.addEl('lbt-item');\n        boxs.addEl('img','img').src = `wb/gtht/home/img/${i.img}`;\n        boxs.addEl('content').textContent = i.text;\n        el = boxs.addEl('datetime');\n        el.addTag('span').textContent = i.date; // item.data.dateText\n        el.addTag('span').textContent = i.time;// item.data.timeText\n      })\n    });\n    ct.activeIndex=0;\n  }\n});"},"items":[{"_icon":"viewport","text":"viewport1","cls":"Wb.Viewport","properties":{"cid":"viewport1","layout":"row","cls":"gtht-lbt","background":"transparent"},"_expanded":true,"items":[{"_icon":"container","text":"container1","cls":"Wb.Container","properties":{"cid":"container1","flex":"2","layout":"center"},"_expanded":true,"hasDupCid":0,"items":[{"_icon":"container","text":"labels","cls":"Wb.Container","properties":{"cid":"labels","layout":"column","cls":"labels","gap":"1em"},"hasDupCid":0,"_expanded":true,"items":[{"_icon":"label","text":"label1","cls":"Wb.Label","properties":{"cid":"label1","text":"专业诚信 合规经营","fontSize":"3.2em","style":"font-family:\"楷体\",\"KaiTi\",\"STKaiti\",\"STKaitiSC\",\"Kai\",\"serif\";"}},{"_icon":"label","text":"label2","cls":"Wb.Label","properties":{"cid":"label2","text":"科技赋能 数字转型","fontSize":"1.8em","style":"font-family:\"楷体\",\"KaiTi\",\"STKaiti\",\"STKaitiSC\",\"Kai\",\"serif\";margin-left:10px;"}}]}]},{"_icon":"container","text":"container2","cls":"Wb.Container","properties":{"cid":"container2","flex":"3","layout":"center","justify":"end"},"_expanded":true,"items":[{"_icon":"play1","text":"carousel","cls":"Wb.Carousel","properties":{"cid":"carousel","interval":"10000","cls":"carousel","flex":"1","maxHeight":"18em","maxWidth":"60em","minWidth":"60em","minHeight":"18em"},"_expanded":true,"events":{"ready":"app.addCarousel([\n  [{ img: '001.png', date: '06.08', time: '12:00:00', text: '无需担心伊以冲突?IEA最新预测:今年石油供应将大大超过需求心伊以冲突?IEA最新预测:今年石' },\n  { img: '002.png', date: '06.08', time: '12:00:00', text: '无需担心伊以冲突?IEA最新预测:今年石油供应将大大超过需求' },\n  { img: '003.png', date: '06.08', time: '12:00:00', text: '无需担心伊以冲突?IEA最新预测:今年石油供应将大大超过需求' }],\n  [{ img: '001.png', date: '06.08', time: '12:00:00', text: '无需担心伊以冲突?IEA最新预测:今年石油供应将大大超过需求' },\n  { img: '002.png', date: '06.08', time: '12:00:00', text: 'The text content of this item is too long and maybe overflowed' },\n  { img: '003.png', date: '06.08', time: '12:00:00', text: 'Database Management' }],\n  [{ img: '001.png', date: '06.08', time: '12:00:00', text: 'WorkFlow Design' },\n  { img: '002.png', date: '06.08', time: '12:00:00', text: 'WorkFlow Design' },\n  { img: '003.png', date: '06.08', time: '12:00:00', text: 'WorkFlow Design' }]\n]);"}}]}]}]}