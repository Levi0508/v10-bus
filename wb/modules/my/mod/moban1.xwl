enu","_expanded":false,"_icon":"menu2","hasDupCid":0,"items":[{"_icon":"item","text":"item1","cls":"Wb.Item","_expanded":true,"properties":{"cid":"item1","text":"登入"},"hasDupCid":0,"events":{"click":"Wb.login();"}},{"_icon":"item","text":"item2","cls":"Wb.Item","_expanded":true,"properties":{"cid":"item2","text":"退出"},"hasDupCid":0,"events":{"click":"Wb.ajax('logout');\nlocation.reload();"}},{"_icon":"item","text":"item3","cls":"Wb.Item","_expanded":true,"properties":{"cid":"item3","text":"恢复默认配置"},"hasDupCid":0}]}]}]}]},{"_icon":"container","text":"container1","cls":"Wb.Container","properties":{"cid":"container1","flex":"1","layout":"row"},"hasDupCid":0,"_expanded":false,"items":[{"_icon":"container","text":"conBox","cls":"Wb.Container","properties":{"cid":"conBox","flex":"1"},"hasDupCid":0}]}]}]}