{"title":"模板","icon":"","img":"","tags":"","hideInMenu":"true","text":"module","cls":"Wb.Module","properties":{"cid":"module","links":"[\n  \"wb/gtht/home/css/moban1.css\"\n]","serverScript":"if(Params.xurl) {\n  Wb.set({ xurl: Wb.encode(Params.xurl) });\n} else {\n  Wb.set({ xurl: Wb.encode('') });\n}\nWb.set({ \n  loginusername: Wb.encode(Wb.username)\n});"},"_icon":"module","events":{"initialize":"Wb.apply(app, {\n  loginusername: _$loginusername$_,\n  xurl: _$xurl$_,\n  pickersearch(val, dom1) {\n    Wb.ajax({\n      url: xpath + '/get_gn_nav',\n      params: {query: val},\n      success(res) {\n        dom1.data = Wb.decode(res);\n      }\n    })\n  },\n  createMenu() {\n    Wb.ajax({\n      url: xpath + '/select-tree',\n      success(res) {\n        let data = Wb.decode(res), el = app.htmlComp.el, gtDhVItem, subEl, gtDhK, gtDhkItem, gtDhV, gtvitext;\n        gtDhK = el.addEl('w-grid1 gt-dhk');\n        gtDhV = el.addEl('w-grid1 gt-dhv w-scroll-true');\n        data.forEach(category => {\n          gtDhkItem = gtDhK.addEl(`gt-dhk-item dhkid-${category.title}`);\n          gtDhkItem.textContent = category.title;\n          gtDhVItem = gtDhV.addEl(`gtdvrow w-row w-grid6 category-${category.title}`);\n          category.items.forEach(item => {\n            subEl = gtDhVItem.addEl(`w-row gtItem gt-${item.title}`);\n            gtvitext = subEl.addEl('text');\n            gtvitext.textContent = item.title;\n            gtvitext.addEventListener('click', () => {\n              // Wb.run({\n              //   url: 'm?xwl='+item.path,\n              //   success(scope) {\n              //     app.conBox.destroyAll();\n              //     app.conBox.add(scope.viewport1);\n              //   }\n              // });\n              //在新窗口中打开MDN\n              Wb.openWin({url: 'm?xwl=my/mod/moban1', params: {xurl: item.xpath}, method: 'POST'}); \n            })\n          });\n\n          gtDhkItem.addEventListener('mouseenter', (el) => {\n            document.querySelectorAll('.gtdvrow').forEach(item => {\n              item.classList.remove('gt-dhv-itembg')\n            });\n            document.querySelectorAll('.gt-dhk-item').forEach(item => {\n              item.classList.remove('gt-dhk-itembg')\n            });\n            const targetElement1 = document.querySelectorAll(`.dhkid-${category.title}`)[0];\n            if (targetElement1) {\n              targetElement1.classList.add('gt-dhk-itembg');\n            }\n            const targetElement = document.querySelectorAll(`.category-${category.title}`)[0];\n            if (targetElement) {\n              targetElement.classList.add('gt-dhv-itembg');\n              gtDhV.scrollTo({\n                top: targetElement.offsetTop - 20,\n                behavior: 'smooth'\n              });\n            }\n          });\n\n          gtDhVItem.addEventListener('mouseenter', (el) => {\n            document.querySelectorAll('.gt-dhk-item').forEach(item => {\n              item.classList.remove('gt-dhk-itembg')\n            });\n            document.querySelectorAll('.gtdvrow').forEach(item => {\n              item.classList.remove('gt-dhv-itembg')\n            });\n            const targetElement = document.querySelectorAll(`.dhkid-${category.title}`)[0];\n            if (targetElement) {\n              targetElement.classList.add('gt-dhk-itembg');\n            }\n          });\n        });\n      }\n    })\n  },\n  defaultWin() {\n    if (app.xurl) {\n      Wb.run({\n        url: 'm?xwl='+ app.xurl,\n        success(scope) {\n          app.conBox.destroyAll();\n          app.conBox.add(scope.viewport1);\n        }\n      });\n    }\n  },\n  ready() {\n    app.createMenu();\n    app.defaultWin();\n  },\n});"},"_expanded":true,"items":[{"_icon":"viewport","text":"viewport1","cls":"Wb.Viewport","properties":{"cid":"viewport1","layout":"fit","cls":"moban","border":"false"},"_expanded":true,"events":{"ready":"app.ready();"},"items":[{"cls":"Wb.Toolbar","properties":{"cid":"tbar","isProperty":"true","height":"4em","background":"rgb(33,81,209)","cls":"tbar","justify":"space-between","padding":"0 1em"},"text":"tbar","_expanded":true,"_icon":"toolbar","hasDupCid":0,"items":[{"_icon":"container","text":"leftbox","cls":"Wb.Container","properties":{"cid":"leftbox","cls":"leftbox","layout":"row","gap":"true","align":"center","margin":"0 4em 0 0"},"hasDupCid":0,"_expanded":false,"items":[{"_icon":"picture","text":"picture1","cls":"Wb.Picture","properties":{"cid":"picture1","src":"wb/gtht/home/img/logo1.png","height":"2em"}},{"_icon":"divider","text":"divider1","cls":"Wb.Divider","properties":{"cid":"divider1","width":"2"},"hasDupCid":0},{"_icon":"label","text":"label1","cls":"Wb.Label","properties":{"cid":"label1","text":"法律合规平台","color":"#fff","cls":"title"},"hasDupCid":0}]},{"_icon":"item","text":"menuItem","cls":"Wb.Item","_expanded":true,"properties":{"cid":"menuItem","text":"模块导航","color":"#ffffff","fontSize":"1.2em","cls":"dh-btn","type":"light"},"events":{"ready":"this.mon(this.el,\"mouseenter\",() => {\n  this.menu.showBy(this.el, 'b', [100, 0])\n})\n","click":"this.menu.showMenu(this.el, 'b', [100, 0])"},"items":[{"_icon":"menu2","text":"menu","cls":"Wb.Menu","properties":{"cid":"menu","isProperty":"true","minWidth":"85%","cls":"qjdhMenu"},"_expanded":true,"hasDupCid":0,"events":{"ready":"this.mon(this.el,\"mouseleave\",() => {\n  this.hide();\n})\n"},"items":[{"_icon":"panel","text":"panel1","cls":"Wb.Panel","properties":{"cid":"panel1","layout":"fit"},"_expanded":true,"hasDupCid":0,"items":[{"_icon":"component","text":"htmlComp","cls":"Wb.Component","properties":{"cid":"htmlComp","cls":"w-row h-links-bos"}}]}]}]},{"_icon":"right1","text":"fill1","cls":"Wb.Fill","properties":{"cid":"fill1"}},{"_icon":"container","text":"rightbox","cls":"Wb.Container","properties":{"cid":"rightbox","cls":"rightbox","layout":"row","gap":"true"},"_expanded":false,"items":[{"_icon":"picker","text":"picker1","cls":"Wb.Picker","properties":{"cid":"picker1","placeholder":