{"title":"查询列表数据","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"let sql=`SELECT  PK_ID,NOTICE_TITLE,NOTIC_CONTENT,TRUNC(CREATE_TIME,'D') AS CREATE_TIME,ORDER_INDEX  FROM  THJS.TB_HG_NOTICE\nWHERE STATUS=0\n ORDER BY ORDER_INDEX DESC ,\nCREATE_TIME DESC,\nNOTICE_TITLE\n ;`\nWb.sendRowx(sql);"},"_icon":"module"}