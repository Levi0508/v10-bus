{"title":"没有权限模板的接口","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"function treeFilter(tree, name) {\n  let data = [];\n  tree.each(item => {\n    if (item._leaf && item.menu_path.includes(name)) {\n      data.push(item);\n    } else {\n      if (item.menu_path.includes(name)) {\n        if (item.items) {\n          item._expanded = true;\n          item.items = xTree(item.items);\n        }\n        data.push(item);\n      } else {\n        if (item.items) {\n          data.push(...treeFilter(item.items, name));\n        }\n      }\n    }\n  })\n  return data;\n}\n\nfunction xTree(list) {\n  let data = [];\n  list.each(node => {\n    if (node._leaf) {\n      data.push(node);\n    } else {\n      data.push(node);\n      if (node.items) {\n        node.items = xTree(node.items);\n      }\n    }\n  })\n  return data;\n}\n\n// urlName是传递进来的要展示模块的文件名\nfunction convertFlatToTree(flatList, urlName) {\n  const nodeMap = {};\n  const processedList = flatList.map(item => {\n    const node = {\n      ...item,\n      title: item.menu_name ? item.menu_name : '',\n      xpath: item.menu_path,\n      items: []\n    };\n    const pathSegments = node.menu_path?.split('/');\n    node._pathSegments = pathSegments;\n    nodeMap[node.menu_path] = node;\n    return node;\n  });\n  // Wb.log(processedList)\n  // Wb.log(\"processedList\")\n  processedList.forEach(node => {\n    const { _pathSegments } = node;\n    if (_pathSegments?.length > 1) {\n      const parentPath = _pathSegments.slice(0, -1).join('/');\n      const parentNode = nodeMap[parentPath];\n      if (parentNode) {\n        parentNode.items.push(node);\n      }\n    }\n  });\n  Wb.log(processedList)\n  Wb.log(\"processedList\")\n  // 过滤只留下一级节点，_pathSegments路径段中最后一个元素如果是模块名就说明是一级，因为如果最后一个不是模块名说明是下级\n  // 为什么只留下一级，因为其它的节点都存放到了一级的items属性中了，要构造树型结构因此只取一级节点对象\n  // 例如：_pathSegments: ['HGPT', 'HG_BM', 'HG_BM_HGKH']一级。_pathSegments: ['HGPT', 'HG_BM', 'HG_BM_HGKH', 'HG_KH_LLRPZ']下级\n  const treeData = processedList.filter(node => {\n    if (node._pathSegments && node._pathSegments.length > 0) {\n      return node._pathSegments[node._pathSegments.length - 1] == urlName\n    }\n    return false;\n  });\n  // Wb.log(treeData)\n  // Wb.log(\"treeData\")\n  treeData.forEach(processTreeNodes);\n  return treeData;\n}\n\nfunction processTreeNodes(node) {\n  delete node._pathSegments;\n  if (node.items && node.items.length === 0) {\n    node._leaf = true;\n  } else if (node.items && node.items.length > 0) {\n    node.items.forEach(processTreeNodes);\n  }\n}\n\nfunction main() {\n  let item_root = ['HG_BM_HGKH'];\n  let items, itemsFilter, data;\n  // data = Wb.sql('select menu_id,module_id,menu_name,menu_path from wb_menu').items;\n  data = Wb.sql(\n    `select a.menu_id, a.module_id, a.menu_name, a.menu_path from wb_menu a\n     inner join \n     (select module_path from wb_perm where role_id = (select role_id from wb_user_role where user_id = '113658')) b\n     on a.menu_path = b.module_path`\n  ).items\n  // Wb.log(data)\n  // Wb.log(\"表数据\")\n  items = convertFlatToTree(data, item_root);\n  // Wb.log(items)\n  // Wb.log(\"树形结构\")\n  itemsFilter = treeFilter(items, item_root);\n  Wb.log(itemsFilter);\n  Wb.log(\"itemsFilter\")\n  Wb.send(itemsFilter)\n}\nmain();"},"_icon":"module"}