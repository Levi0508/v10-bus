{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","remark":"Select users","serverScript":"function main() {\n  let searchClause = '';\n\n  if (Params.query) {\n    Wb.setLike('query');\n    searchClause = 'and (user_name like {?query?} or display_name like {?query?})'\n  }\n  Wb.sendRows(`select sid,user_name,display_name from wb_user where status=1 ${searchClause} order by user_name`);\n}\nmain();"},"_icon":"module"}