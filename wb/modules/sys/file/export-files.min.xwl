{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"Wb.checkDemo();function main(){let e=Wb.getObject(\"files\"),t=new Wb.File(e[0]),i=Wb.getBool(\"zip\"),l=e.length;if(i||l>1||t.isFolder){let i;if(l==1)i=t.isFile?t.normalName:t.name;else i=t.parent.name||\"file\";e=e.map((e=>new File(e)));Wb.setContentType(i+\".zip\");ZipUtil.zip(e,response.getOutputStream())}else{Wb.exportData(t)}}main();","remark":"Export files in any path"},"_icon":"module"}