{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"function main(){let e,a,t=Params.path;e=UrlBuffer.getBuffer().get(\"/\"+t);if(e)a=Base.modulePathText+e;else{e=new Wb.File(Base.modulePath,t+\".xwl\");if(e.exists)a=e.path;else a=\"\"}Wb.send(a)}main();","remark":"Find file path of the specified URL shortcut"},"_icon":"module"}