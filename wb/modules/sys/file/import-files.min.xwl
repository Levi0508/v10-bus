{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"Wb.checkDemo();function main(){let e=Wb.load(\"./fs.mjs\"),a,s=Wb.getParams(\"files\"),t,i=new Wb.File(Params.path),l=Wb.getBool(\"unzip\"),r,f,m=[];t=Params.charset?SysUtil.getCharset(Params.charset):SysUtil.filenameCharset;s.forEach((e=>{f=e.name;if(l&&Wb.getFileExt(f).toLowerCase()==\"zip\"){r=ZipUtil.unzip(e.stream,i.file,t);m=m.concat(r);m.forEach((e=>{new Wb.File(i.file,e).cascadeSelf((e=>e.clearBuffer()))}))}else{m.push(f);a=new Wb.File(i,f);a.stream=e.stream;a.clearBuffer()}}));s=e.listFiles(i,Params.mode);Wb.send(s.filter((e=>m.includes(e.text))))}main();","remark":"Import files in any path"},"_icon":"module"}