{"title":"","icon":"","img":"","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"let fs = Wb.load('./fs.mjs'), renameOnly = Wb.getBool('rename'), file;\n\nfile = fs.setFileProperty(Params.path, Params.filename, renameOnly ? false : Params.title,\n  Params.icon, Params.img, Params.tags, Params.url, Params.hideInMenu);\nWb.send({ lastModified: file.lastModified, path: file.path });","remark":"Set file property in any path"},"_icon":"module"}