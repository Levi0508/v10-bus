{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","remark":"Save desktop","serverScript":"function main() {\n  let { value, asDefault } = Params;\n\n  if (!value.portlets) {\n    let data = Wb.getResource(['desktop', 'desktop'], [null, 'system']);\n\n    data = data[0] ?? data[1];\n    if (data?.portlets)\n      value.portlets = data.portlets;\n  }\n  if (asDefault)\n    Wb.permitx('set-resource-all') && Wb.run('set-resource-all');\n  else\n    Wb.permitx('set-resource') && Wb.run('set-resource');\n}\nmain();"},"_icon":"module"}