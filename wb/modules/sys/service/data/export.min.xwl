{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","remark":"Export accessible data","serverScript":"function doExport(e){let t,r,a,s,i,l=Wb.parseBool(e.tree),f=Params.itemsName,n=e.itemsPath;t=new JSONArray(e.columns);r=e.data;if(r){r=new JSONArray(r);r=l?flattenItems(r,f):new JSONArray(r)}else{let t,a,s=Wb.parseBool(e.allPages),i=e.localUrl,o=e.pageIndexName,u=Wb.decode(e.params??null),m=Wb.getConfig(\"sys.office.exportMaxRows\"),p,b,d,c,W=e.sortValue;if(s){p=0;b=m;d=m;c=0}else{p=parseInt(e.fromValue);b=Math.min(parseInt(e.toValue),m);d=Math.min(parseInt(e.pageSize),m);c=parseInt(e.pageIndex)}u[e.fromName]=p;u[e.toName]=b;u[e.pageSizeName]=d;if(o)u[o]=c;if(W)u[e.sortName]=W;if(i){i=Xwl.getXwlPath(i);if(i){Wb.permitx(i);try{if(s)Globals.maxRows=m;r=Wb.execute(i,Wb.apply({},Wb.decode(e.urlParams??null),u))}finally{if(s)Globals.maxRows=undefined}}}if(!r){r=Wb.submit({url:e.url,request:request,text:true,silent:true,all:true,params:u});if(r.code!=200){if(r.code==401){response.setStatus(401);Wb.send(r.result);return}else{Wb.raise(r.result)}}r=r.result}t=r.indexOf(\"{\");a=r.indexOf(\"[\");if(a!=-1&&(a<t||t==-1)){r=l?flattenItems(r,f):new JSONArray(r)}else{r=l?flattenItems(r,f,n):JsonUtil.findObject(new JSONObject(r),n)}}a=e.format??\"xlsx\";Wb.setContentType((e.filename||\"data\")+\".\"+a,true);s=Wb.getConfig(\"sys.office.gridBorderLine\");if(s==\"auto\")s=e.gridLine;if(e.summary)r.put(new JSONObject(e.summary));i=response.getOutputStream();a=a.toLowerCase();if(a.startsWith(\"xls\"))Java.type(\"com.wb.office.SheetWriter\").createExcel(i,t,r,Wb.getInt(\"freeze\")??0,e.title,s);else exportCSV(i,t,r);response.flushBuffer()}function flattenItems(e,t,r){e=Wb.decode(e);if(r)e=Wb.getNS(r,e);return new JSONArray(Java.to(Wb.flatItems(e,true,t)))}function exportCSV(e,t,r){let a,s,i,l,f,n,o=[],u=[],m;m=new java.io.BufferedWriter(new java.io.OutputStreamWriter(e,Wb.getConfig(\"sys.file.csvCharset\")||Base.osC