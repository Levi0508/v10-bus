{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"function main() {\n  switch (Params.type) {\n    case 'list':\n      Wb.send(Wb.ServerDict.getKVList(Params.name));\n      break;\n    case 'names':\n      Wb.send(Wb.ServerDict.getKeyNames());\n      break;\n  }\n}\nmain();","remark":"Get key value list"},"_icon":"module"}