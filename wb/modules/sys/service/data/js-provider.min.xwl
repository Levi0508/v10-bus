{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"const Class=Java.type(\"java.lang.Class\");const Modifier=Java.type(\"java.lang.reflect.Modifier\");function getPublicMembers(s){let e,a,t,i;try{e=Class.forName(s)}catch(a){e=Java.type(s).class.getClassLoader().loadClass(s)}a=e.getFields();t=e.getMethods();i=[];a.forEach((s=>{if(Modifier.isPublic(s.getModifiers())){i.push({label:s.getName(),kind:3})}}));t.forEach((s=>{if(Modifier.isPublic(s.getModifiers())){i.push({label:s.getName(),kind:1})}}));return i}function main(){let s;try{let e=Params.cls;if(e.startsWith(\"Packages.\"))e=e.substr(9);else if(e.startsWith(\"Classes.\"))e=Classes[e.substr(8)].class.getName();s=getPublicMembers(e)}catch(e){s=[]}Wb.send(s)}main();","remark":"Provide JS completion items"},"_icon":"module"}