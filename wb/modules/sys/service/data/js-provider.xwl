{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"const Class = Java.type('java.lang.Class');\nconst Modifier = Java.type('java.lang.reflect.Modifier');\n\n/**\n * Get public members.\n * @param {String/Class} className Qualified class name.\n * @returns {Array} Members list.\n */\nfunction getPublicMembers(className) {\n  let cls, fields, methods, members;\n\n  try {\n    cls = Class.forName(className);\n  } catch (e) {\n    cls = Java.type(className).class.getClassLoader().loadClass(className);\n  }\n  fields = cls.getFields();\n  methods = cls.getMethods();\n  members = [];\n  fields.forEach(field => {\n    if (Modifier.isPublic(field.getModifiers())) {\n      members.push({\n        label: field.getName(),\n        kind: 3\n      });\n    }\n  });\n  methods.forEach(method => {\n    if (Modifier.isPublic(method.getModifiers())) {\n      members.push({\n        label: method.getName(),\n        kind: 1\n      });\n    }\n  });\n  return members;\n}\nfunction main() {\n  let result;\n\n  try {\n    let cls = Params.cls;\n    if (cls.startsWith('Packages.'))\n      cls = cls.substr(9);\n    else if (cls.startsWith('Classes.'))\n      cls = Classes[cls.substr(8)].class.getName();\n    result = getPublicMembers(cls);\n  } catch (e) {\n    result = [];\n  }\n  Wb.send(result);\n}\nmain();","remark":"Provide JS completion items"},"_icon":"module"}