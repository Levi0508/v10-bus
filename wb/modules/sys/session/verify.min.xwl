{"text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"function main(){try{Wb.UserUtil.login(Params.username,Params.password,Params.verifyCode);Wb.send([Wb.username,Wb.dispname])}catch(a){if(a instanceof Java.type(\"java.lang.IllegalStateException\"))Wb.raise(Str.exceedUsersLimit);else Wb.raise(a)}}main();","loginRequired":"false","remark":"Verify user account and login to system"},"_icon":"module","title":"","icon":"","img":"","hideInMenu":"false"}