{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"let I_BUSI_TYPE = Wb.get('I_BUSI_TYPE');\nlet order = Wb.getOrderSql();\nlet i_busi_type1 = '', i_busi_type2 = '';\nif (I_BUSI_TYPE) {\n  i_busi_type1 = I_BUSI_TYPE.split('_')[0];\n  i_busi_type2 = I_BUSI_TYPE.split('_')[1];\n\n}\ntry {\n  let sql1 = '';\n  let rs = '', meta = '', row = null;\n  if (I_BUSI_TYPE) {\n    rs = Wb.sql({ sql: `SELECT T.BUSI_TYPE1, T.BUSI_TYPE2, DECODE(T.IS_ALLOW_REPORT, '0', '否', '1', '是',T.IS_ALLOW_REPORT) IS_ALLOW_REPORT，DECODE(T.IS_LIMIT_FXQ, '0', '否', '1', '是',T.IS_ALLOW_REPORT) IS_LIMIT_FXQ FROM THJS.TB_PROJLIST_BUSITYPE T WHERE T.BUSI_TYPE1 = {?i_busi_type1?} AND T.BUSI_TYPE2 = {?i_busi_type2?}` + Wb.getOrderSql(), contextParams: false, params: { i_busi_type1: i_busi_type1, i_busi_type2: i_busi_type2 } });\n    if (rs.items[0]) {\n      Wb.send(rs);\n    } else {\n      Wb.send('{\"success\":true,\"metaData\":{\"fields\":[]},\"columns\":[],\"rows\":[],\"total\":0,\"elapsed\":0}');\n    }\n  } else {\n    sql1 = \"SELECT T.BUSI_TYPE1, T.BUSI_TYPE2, DECODE(T.IS_ALLOW_REPORT, '0', '否', '1', '是',T.IS_ALLOW_REPORT) IS_ALLOW_REPORT，DECODE(T.IS_LIMIT_FXQ, '0', '否', '1', '是',T.IS_ALLOW_REPORT) IS_LIMIT_FXQ FROM THJS.TB_PROJLIST_BUSITYPE T\" + Wb.getOrderSql();\n    rs = Wb.sql(sql1);\n    Wb.info(rs);\n    Wb.info(meta)\n    if (rs.items[0]) {\n      Wb.send(rs);\n    } else {\n      Wb.send('{\"success\":true,\"metaData\":{\"fields\":[]},\"columns\":[],\"rows\":[],\"total\":0,\"elapsed\":0}');\n    }\n  }\n} catch (e) {\n  Wb.error(e);\n} finally { }"},"_icon":"module"}