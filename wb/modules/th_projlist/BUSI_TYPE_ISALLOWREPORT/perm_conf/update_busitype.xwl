{"title":"","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"Wb.sendRowx(`UPDATE THJS.TB_PROJLIST_BUSITYPE T \nSET T.IS_ALLOW_REPORT={?IS_ALLOW_REPORT?},T.IS_LIMIT_FXQ={?IS_LIMIT_FXQ?},T.UPDATE_TIME=SYSDATE,T.UPDATE_USER={?sys.username?}\nWHERE T.BUSI_TYPE1 = {?BUSI_TYPE1?} AND T.BUSI_TYPE2={?BUSI_TYPE2?}`);"},"_icon":"module"}