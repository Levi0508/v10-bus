{"title":"新增","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"Wb.sendRowx({\n  sql: `INSERT INTO thjs.tb_projlist_review_conf (\n    deptname,\n    sub_deptname,\n    manager,\n    manager_work_no,\n    create_user,\n    create_time,\n    update_user,\n    update_time,\n    manager_user_id,\n    sub_dept_code,\n    dept_code\n)\nSELECT\n    d.dept_name AS deptname,\n    d1.dept_name AS sub_deptname,\n    u.display_name AS manager,\n    u.staff_id AS manager_work_no,\n    {?I_CREATE_USER?} AS create_user,\n    SYSDATE AS create_time,\n    {?I_UPDATE_USER?} AS update_user,\n    SYSDATE AS update_time,\n    u.user_id AS manager_user_id,\n    d1.dept_id AS sub_dept_code, -- 这里添加了缺失的逗号\n    d.dept_id AS dept_code\nFROM\n    basic_thjs.wb_user u\n    LEFT JOIN basic_thjs.wb_dept d ON d.dept_id = {?I_DEPT_CODE?}\n    LEFT JOIN basic_thjs.wb_dept d1 ON d1.dept_id = {?I_SUB_DEPT_CODE?}\nWHERE\n    u.staff_id = {?I_STAFF_ID?}`})"},"_icon":"module"}