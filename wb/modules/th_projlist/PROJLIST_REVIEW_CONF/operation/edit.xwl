{"title":"编辑","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"Wb.sendRowx({sql:`UPDATE thjs.tb_projlist_review_conf t\n   SET (t.manager,\n        t.manager_work_no,\n        t.manager_user_id) = (SELECT u.display_name,\n                                     u.staff_id,\n                                     u.user_id\n                                FROM basic_thjs.wb_user u\n                               WHERE u.staff_id = {?I_STAFF_ID?}),\n       t.update_time = SYSDATE,\n       t.update_user = {?I_UPDATE_USER?}\n WHERE t.pk_id = {?I_PK_ID?};`})"},"_icon":"module"}