{"title":"查询投行部门","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"var result = Wb.sql(`{call THJS.P_DEPT_TREE_Q({*clob|O_SQL*},{*numeric|o_return_code*},{*varchar|o_return_msg*})}`);\nvar rawData = JSON.parse(result.O_SQL);\n\n// Wb.send(rawData)\n\nfunction transformData(nodes) {\n  if (!nodes || !Array.isArray(nodes)) return [];\n  return nodes.map(node => {\n    const newNode = {\n      text: node.text,\n      _icon: '',      // 示例目标格式中的固定值或默认值\n      myCheck: 0,          // 示例目标格式中的默认值\n      sid: node.filename,  // 假设用 filename 作为唯一标识 sid\n      remark: node.path,    // 如果原数据没有 remark，可能需要额外处理或留空\n      path: node.path,\n      filename:node.filename,\n      text:node.text\n      // area: 0,          // 原数据没有面积信息，按需删除\n      // percentage: 0,    // 原数据没有占比信息，按需删除\n    };\n\n    if (node.leaf !== undefined) {\n      newNode._leaf = node.leaf;\n    }\n\n    if (node.children && node.children.length > 0) {\n      newNode.items = transformData(node.children);\n    }\n\n    return newNode;\n  });\n}\n\nconst tree = transformData(rawData.children);\n\nif (result.o_return_code < 0)\n  Wb.error(result.o_return_msg);\nelse {\n  Wb.send(tree);\n}\n\n"},"_icon":"module"}