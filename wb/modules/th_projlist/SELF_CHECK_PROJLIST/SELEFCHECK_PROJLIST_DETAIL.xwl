{
  "title": "查看通知详情",
  "icon": "",
  "img": "",
  "tags": "",
  "hideInMenu": "false",
  "text": "module",
  "cls": "Wb.Module",
  "properties": {
    "cid": "module",
    "links": "[\"wb/custom-made/vue/vue.js\",\n\"wb/custom-made/vue/element.js\",\n\"wb/custom-made/vue/element.css\",\n\"wb/custom-made/css/self_check.css\",\n\"wb/custom-made/file/FileSaver.js\",\n\"wb/custom-made/file/jszip.js\",\n\"wb/custom-made/file/xlsx.full.js\",\n\"wb/libs/exportPdf/html2canvas.js\",\n\"wb/libs/exportPdf/jspdf.debug.js\",\n]",
    "serverScript": "Wb.set({\n  title: Wb.get('title'),\n  content: Wb.get('content'),\n  check_batch_id: Wb.get('check_batch_id')\n})"
  },
  "_icon": "module",
  "_expanded": true,
  "items": [
    {
      "_icon": "viewport",
      "text": "viewport1",
      "cls": "Wb.Viewport",
      "properties": {
        "cid": "viewport1",
        "layout": "fit"
      },
      "_expanded": true,
      "items": [
        {
          "_icon": "container",
          "text": "mainContainer",
          "cls": "Wb.Container",
          "properties": {
            "cid": "mainContainer",
            "full": "true",
            "layout": "fit",
            "autoScroll": "true"
          },
          "events": {
            "ready": "let comp = this;\n\n// 确保 ElementUI 组件已注册\nif (typeof Vue !== 'undefined' && typeof ElementUI !== 'undefined') {\n  Vue.use(ElementUI);\n}\n\ncomp.vue = new Vue({\n  el: comp.el.addEl(),\n  template: `\n<el-container>\n  <el-header style=\"width:100%;text-align:end;padding-top:20px;\"><el-button type=\"primary\" size=\"mini\" @click=\"exportAll\">导出全部</el-button></el-header>\n  <el-main style=\"width:100%\">\n    <div style=\"width:70%;margin:0 auto;\">\n      <!-- 通知正文 -->\n      <div id=\"notice-container\">\n        <div class=\"detail-row\">\n          <div style=\"font-size:18px;font-weight:bold;width:100%;text-align:center\">{{ title }}</div>\n        </div>\n        <div class=\"detail-row\">\n          <span v-html=\"content\"></span>\n        </div>\n      </div>\n      <!-- 项目列表 -->\n      <div>\n        <div style=\"font-size:18px;font-weight:bold;padding-bottom:10px;\">项目列表</div>\n        <el-table :data=\"batchTableData\" stripe max-height=\"500\" height=\"500\">\n          <el-table-column prop=\"\" label=\"\" width=\"120\" align=\"center\">\n            <template slot-scope=\"scope\">\n              <div class=\"operation-buttons\">\n                <el-tooltip content=\"查看详情\">\n                  <el-button type=\"text\" @click=\"gotoProjForm(scope.row)\">查看清单详情</el-button>\n                </el-tooltip>\n              </div>\n            </template>\n          </el-table-column>\n          <el-table-column prop=\"projcode\" label=\"项目编号\" width=\"120\"></el-table-column>\n          <el-table-column prop=\"khname\" label=\"公司全称\" min-width=\"150\"></el-table-column>\n          <el-table-column prop=\"staff_id\" label=\"项目负责人工号\" min-width=\"150\"></el-table-column>\n          <el-table-column prop=\"deptmananame\" label=\"项目负责人姓名\" min-width=\"150\"></el-table-column>\n          <el-table-column prop=\"dept_name\" label=\"部门名称\" width=\"250\"></el-table-column>\n        </el-table>\n        <!-- 分页 -->\n        <div class=\"pagination-wrapper\" style=\"height:60px\">\n          <el-pagination @size-change=\"handleSizeChange\" @current-change=\"handleCurrentChange\"\n            :current-page=\"pagination.pageNum\" :page-sizes=\"[50, 100, 500, 1000]\" :page-size=\"pagination.pageSize\"\n            layout=\"total, sizes, prev, pager, next, jumper\" :total=\"pagination.total\" background\n            style=\"text-align: left; margin-top: 15px;\">\n          </el-pagination>\n        </div>\n      </div>\n      <!-- 附件列表 -->\n      <div style=\"padding-bottom:20px;\">\n        <div style=\"font-size:18px;font-weight:bold;padding-bottom:10px;\">附件列表</div>\n        <el-table :data=\"fileData\" border style=\"max-height:500px;overflow-y:auto;\">\n          <el-table-column type=\"index\" width=\"50\"></el-table-column>\n          <el-table-column prop=\"name\" label=\"附件名称\" min-width=\"150\"></el-table-column>\n          <el-table-column prop=\"display_name\" label=\"上传人\" min-width=\"150\"></el-table-column>\n          <el-table-column prop=\"create_time\" label=\"上传时间\" width=\"250\"></el-table-column>\n          <el-table-column prop=\"id\" label=\"ID\" width=\"250\" v-show=\"false\"></el-table-column>\n          <el-table-column label=\"操作\" width=\"150\">\n              <template slot-scope=\"scope\">\n                <div class=\"operation-buttons\">\n                  <el-tooltip content=\"下载\">\n                    <el-button type=\"text\" class=\"el-icon-download\" @click=\"handleDownload(scope.row)\"></el-button>\n                  </el-tooltip>\n                </div>\n              </template>\n            </el-table-column>\n        </el-table>\n      </div>\n    </div>\n  </el-main>\n</el-container>\n  `,\n  data() {\n    return {\n      historyList: [],\n      dialogVisible: false,\n      title: '_$title$_',\n      content: '_$content$_',\n      check_batch_id: '_$check_batch_id$_',\n      tableData: [],\n      allData: [],\n      batchTableData: [],\n      fileData: [],\n      pagination: {\n        pageNum: 1,\n        pageSize: 100,\n        total: 0\n      }\n    };\n  },\n  computed: {\n  },\n  methods: {\n    formatYearMonth(row, column) {\n      const input = String(row.batch_month);\n      const year = input.substring(0, 4);\n      const month = parseInt(input.substring(4, 6), 10);\n      return `${year}年${month}月`;\n    },\n    queryBatchTableData(id) {\n      let that = this;\n      Wb.ajax({\n        url: xpath + '/../SELFCHECK_PROJLIST_HIS/select_selfchek_details',\n        params: {\n          check_batch_id: id\n        },\n        success(resp) {\n          let res = Wb.decode(resp).items;\n          if (res && res.length > 0) {\n            that.content = res[0].content;\n            that.allData = res;\n            that.pagination.total = res.length;\n            that.sliceData();\n          }\n        }\n      })\n    },\n    sliceData() {\n      const start = (this.pagination.pageNum - 1) * this.pagination.pageSize;\n      const end = start + this.pagination.pageSize;\n      this.batchTableData = this.allData.slice(start, end);\n    },\n    handleSizeChange(val) {\n      this.pagination.pageSize = val;\n      this.pagination.pageNum = 1;\n      this.sliceData();\n    },\n    handleCurrentChange(val) {\n      this.pagination.pageNum = val;\n      this.sliceData();\n    },\n    // 查看详情\n    gotoProjForm(row) {\n      console.log(\"row\", row);\n      let that = this;\n      Wb.ajax({\n        url: 'm?xwl=info_query/projlist_data/inout_q',\n        params: {\n          i_projid: row.projid,\n          i_usercode: '_$sys.username$_'\n        },\n        success(resp) {\n          var scope = Wb.decode(resp).items[0];\n          scope.deptname = row.dept_name;\n          var card, encodedParams = scope.projid;\n          scope.state = 'info';\n          if (window.destTabPanel) {\n            window.destTabPanel.items.each(function (item) {\n              if (item.detailParams == encodedParams) {\n                card = item;\n                return false;\n              }\n            });\n            if (card) {\n              destTabPanel.setActiveTab(card);\n              return;\n            }\n          }\n          card = Wb.open({\n            url: 'm?xwl=info_query/projlist/projlist_form_container',//yufang\n            params: scope,\n            title: '清单查看 - ' + scope.custname,\n            success(scope) {\n              that.dialogVisible = false;\n            }\n          });\n          if (card) {\n            card.detailParams = encodedParams;\n            window.destTabPanel = card.ownerCt;\n          }\n        }\n      });\n    },\n    selectFileList(check_batch_id) {\n      let that = this;\n      Wb.ajax({\n        url: xpath + '/../SELFCHECK_PROJLIST_HIS/select_selfcheck_file',\n        params: {\n          i_check_batch_id: check_batch_id\n        },\n        success(resp) {\n          console.log(\"附件列表查询结果：\", Wb.decode(resp));\n          let res = Wb.decode(resp);\n          if (res.items) {\n            that.fileData = res.items;\n          }\n        }\n      })\n    },\n    // 下载附件\n    handleDownload(row) {\n      Wb.download({\n        url: xpath + '/../operation/download_file',\n        params: {\n          id: row.id,\n          full_name: row.name + '.' + row.extension\n        }\n      })\n    },\n    // 附件预览\n    // handlePreview(file) {\n    //   let that = this;\n    //   let params_file = {\n    //     'id': file.id,\n    //     'clientId': file.client_id,\n    //     'fileTypeNo': this.organ_flag == '1' ? '1,2,21,22' : '1,2',\n    //     'fileName': file.name + '.' + file.extension,\n    //     'extension': file.extension\n    //   };\n    //   Wb.ajax({\n    //     url: 'm?xwl=aml_monitor/workflow/prs01/dataSource/files/preview_file',\n    //     params: {\n    //       id: file.id,\n    //       clientId: file.client_id,\n    //       fileTypeNo: this.organ_flag == '1' ? '1,2,21,22' : '1,2',\n    //       fileName: file.name + '.' + file.extension,\n    //       extension: file.extension\n    //     },\n    //     success(resp) {\n    //       console.log(\"resp\", resp);\n    //       let res = Wb.decode(resp);\n    //       let serverIp = '10.116.131.13';\n    //       if (res.code == '200') {\n    //         let previewUrl = res.data.previewUrl;\n    //         if (previewUrl.indexOf(serverIp) != -1) {\n    //           previewUrl = res.data.previewUrl.replace(/10\\.116\\.131\\.13:8090/g, '10.181.135.22:8080/ibcm_flow')\n    //         }\n    //         window.open(previewUrl, '_blank', 'width=800,height=600')\n    //       } else {\n    //         that.$message.error(\"当前文件类型不支持预览\")\n    //       }\n    //     }\n    //   });\n    // },\n    // 导出全部\n    exportAll: function () {\n      var that = this;\n      that.$message.info('正在导出...');\n\n      // 1. 导出表格为 Excel\n      var excelBlob = that.generateExcel();\n\n      // 2. 导出富文本为 PDF\n      that.generatePDF(function (pdfBlob) {\n        // 3. 下载所有附件\n        that.downloadAttachments(function (attachmentBlobs) {\n          // 4. 打包成 ZIP\n          that.createZipAndDownload(pdfBlob, excelBlob, attachmentBlobs);\n\n          that.$message.success('导出成功');\n        });\n      });\n    },\n\n    // 生成 PDF（参考 base_edit.js 实现）\n    generatePDF: function (callback) {\n      var that = this;\n      var htmlContent = document.getElementById('notice-container');\n      if (!htmlContent) {\n        alert('找不到富文本容器');\n        return;\n      }\n\n      var clone = htmlContent.cloneNode(true);\n      clone.style.backgroundColor = '#ffffff';\n      clone.style.padding = '20px';\n      clone.style.width = '1000px';\n      // clone.style.maxWidth = 'none';\n\n      document.body.appendChild(clone);\n\n      setTimeout(function () {\n        html2canvas(clone, {\n          scale: window.devicePixelRatio,\n          useCORS: true,\n          allowTaint: false,\n          backgroundColor: \"#ffffff\",\n          fontSize: '24px',\n          boxSizing: 'border-box'\n        }).then(function (canvas) {\n          var contentWidth = canvas.width;\n          var contentHeight = canvas.height;\n\n          var pageWidth = 595.28; // A4 pt 宽度\n          var pageHeight = 841.89; // A4 pt 高度\n          var imgWidth = pageWidth - 40; // 两边各留 20pt 边距\n          var imgHeight = (imgWidth / contentWidth) * contentHeight;\n\n          var pageData = canvas.toDataURL('image/jpeg', 1.0);\n          console.log(\"pageData.length\", pageData.length / (1024 * 1024) + \"MB\");\n          var pdf = new jsPDF('', 'pt', 'a4');\n\n          var leftHeight = imgHeight;\n          var position = 0;\n\n          if (leftHeight < pageHeight) {\n            pdf.addImage(pageData, 'JPEG', 20, 0, imgWidth, imgHeight);\n          } else {\n            while (leftHeight > 0) {\n              pdf.addImage(pageData, 'JPEG', 20, position, imgWidth, imgHeight);\n              leftHeight -= pageHeight;\n              position -= pageHeight;\n\n              if (leftHeight > 0) {\n                pdf.addPage();\n              }\n            }\n          }\n\n          // 生成 Blob 而不是直接保存\n          var blob = pdf.output('blob');\n\n          // 清理 DOM\n          document.body.removeChild(clone);\n\n          // 调用回调函数，传入 Blob\n          callback(blob);\n        }).catch(function (err) {\n          console.error('PDF 导出失败', err);\n          document.body.removeChild(clone);\n          alert('PDF 导出失败：' + err.message);\n        });\n      }, 500);\n    },\n\n    // 生成 Excel\n    generateExcel: function () {\n      var that = this;\n      // 转换表头显示名称\n      var displayData = [];\n      for (var i = 0; i < that.batchTableData.length; i++) {\n        var item = that.batchTableData[i];\n        displayData.push({\n          '项目名称': item.projname,\n          '项目编号': item.projcode,\n          '公司全称': item.khname,\n          '项目负责人': item.deptmananame,\n          '项目负责人工号': item.staff_id,\n          '部门名称': item.dept_name\n        });\n      }\n\n      var ws = XLSX.utils.json_to_sheet(displayData);\n      var wb = XLSX.utils.book_new();\n      XLSX.utils.book_append_sheet(wb, ws, '项目列表');\n      var wbout = XLSX.write(wb, { bookType: 'xlsx', type: 'base64' });\n\n      // base64 转 Blob\n      var binaryStr = atob(wbout);\n      var len = binaryStr.length;\n      var uInt8Array = new Uint8Array(len);\n      for (var i = 0; i < len; i++) {\n        uInt8Array[i] = binaryStr.charCodeAt(i);\n      }\n      return new Blob([uInt8Array], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });\n    },\n\n    // 下载所有附件（使用 Wb.ajax 调用新接口，不触发浏览器下载）\n    downloadAttachments: function (callback) {\n      var that = this;\n      var attachmentBlobs = [];\n      var completedCount = 0;\n      var totalFiles = that.fileData.length;\n\n      if (totalFiles === 0) {\n        callback(attachmentBlobs);\n        return;\n      }\n\n      for (var i = 0; i < totalFiles; i++) {\n        var file = that.fileData[i];\n        var fileId = file.id;\n        var fileName = file.name + '.' + file.extension;\n\n        // 使用 Wb.ajax 调用新的接口（返回 JSON 格式）\n        Wb.ajax({\n          url: xpath + '/../operation/download_file1',\n          params: {\n            id: fileId\n          },\n          success: function (resp) {\n            try {\n              var data = Wb.decode(resp);\n\n              // 检查响应状态码\n              if (data.code !== '0') {\n                console.error('下载附件失败 (' + fileName + '):', data.message);\n                attachmentBlobs.push(null);\n                completedCount++;\n                if (completedCount === totalFiles) {\n                  callback(attachmentBlobs);\n                }\n                return;\n              }\n\n              // 从 JSON 中获取 base64 内容\n              var base64Content = data.content;\n              if (!base64Content) {\n                console.error('附件内容为空 (' + fileName + ')');\n                attachmentBlobs.push(null);\n                completedCount++;\n                if (completedCount === totalFiles) {\n                  callback(attachmentBlobs);\n                }\n                return;\n              }\n\n              // 将 base64 转换为 Blob\n              var binaryStr = atob(base64Content);\n              var len = binaryStr.length;\n              var uInt8Array = new Uint8Array(len);\n              for (var j = 0; j < len; j++) {\n                uInt8Array[j] = binaryStr.charCodeAt(j);\n              }\n\n              // 使用接口返回的 MIME 类型\n              var mimeType = data.type || 'application/octet-stream';\n              attachmentBlobs.push(new Blob([uInt8Array], { type: mimeType }));\n\n            } catch (e) {\n              console.error('解析附件失败 (' + fileName + ')', e);\n              attachmentBlobs.push(null);\n            }\n\n            completedCount++;\n            if (completedCount === totalFiles) {\n              callback(attachmentBlobs);\n            }\n          },\n          error: function (err) {\n            console.error('附件下载请求失败 (' + fileName + ')', err);\n            attachmentBlobs.push(null);\n            completedCount++;\n            if (completedCount === totalFiles) {\n              callback(attachmentBlobs);\n            }\n          }\n        });\n      }\n    },\n\n    // 创建 ZIP 并下载\n    createZipAndDownload: function (pdfBlob, excelBlob, attachmentBlobs) {\n      var that = this;\n      var zip = new JSZip();\n      var excelDate = new Date().toISOString().split('T')[0];\n\n      // 添加 PDF\n      zip.file(\"通知正文_\" + that.title + \"_\" + excelDate + \".pdf\", pdfBlob);\n\n      // 添加项目列表 Excel\n      zip.file(\"项目列表_\" + excelDate + \".xlsx\", excelBlob);\n\n      // 添加附件\n      for (var i = 0; i < attachmentBlobs.length; i++) {\n        if (attachmentBlobs[i]) {\n          var fileName = that.fileData[i].name + '.' + that.fileData[i].extension;\n          zip.file(fileName, attachmentBlobs[i]);\n        }\n      }\n\n      zip.generateAsync({ type: 'blob' }).then(function (content) {\n        saveAs(content, \"自查报告_\" + excelDate + \".zip\");\n      });\n    }\n  },\n  created: function () {\n    // 页面加载时查询历史记录\n    this.queryBatchTableData(this.check_batch_id);\n    this.selectFileList('_$check_batch_id$_');\n  },\n  beforeDestroy: function () {\n    // 清理工作\n  }\n});"
          }
        }
      ]
    }
  ]
}