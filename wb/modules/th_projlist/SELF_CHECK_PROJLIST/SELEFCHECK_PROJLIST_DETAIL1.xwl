                {
                  "_icon": "column",
                  "text": "rownum1_Col",
                  "cls": "Wb.Column",
                  "properties": {
                    "cid": "rownum1_Col",
                    "rowNum": "true",
                    "width": "80",
                    "text": "序号"
                  },
                  "hasDupCid": 1
                },
                {
                  "_icon": "column",
                  "text": "FILENAME_col",
                  "cls": "Wb.Column",
