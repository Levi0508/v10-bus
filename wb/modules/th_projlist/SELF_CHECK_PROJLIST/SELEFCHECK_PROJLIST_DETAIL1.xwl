  "text": "module",
  "cls": "Wb.Module",
  "properties": {
    "cid": "module",
    "serverScript": "Wb.set({\n  title: Wb.get('title'),\n  content: Wb.get('content'),\n  check_batch_id: Wb.get('check_batch_id')\n})"
  },
  "_icon": "module",
  "_expanded": true,
  "items": [
    {
      "_icon": "viewport",
      "text": "viewport1",
      "cls": "Wb.Viewport",
      "properties": {
        "cid": "viewport1",
        "height": "100%",
        "autoScroll": "true"
      },
      "_expanded": true,
      "events": {
        "ready": "app.label1.html = '_$content$_'"
      },
      "items": [
        {
          "_icon": "panel",
          "text": "panel1",
          "cls": "Wb.Panel",
          "properties": {
            "cid": "panel1",
            "border": "false",
            "height": "400px"
          },
          "_expanded": true,
          "hasDupCid": 0,
          "items": [
            {
              "_icon": "label",
              "text": "label1",
              "cls": "Wb.Label",
              "properties": {
                "cid": "label1",
                "width": "70%",
                "height": "400px",
                "full": "true"
              }
            }
          ]
        },
        {
          "_icon": "grid",
          "text": "grid2",
          "cls": "Wb.Grid",
          "properties": {
            "cid": "grid2",
            "maxHeight": "600px",
            "emptyHint": "true",
            "height": "400px",
            "title": "附件列表"
          },
          "_expanded": true,
          "items": [
            {
              "_icon": "array",
              "text": "columns",
              "cls": "Wb.Array",
              "properties": {
                "cid": "columns"
              },
              "_expanded": true,
