{"title":"通知附件上传","icon":"","img":"","tags":"","hideInMenu":"false","text":"module","cls":"Wb.Module","properties":{"cid":"module","serverScript":"// 清单自查流程通知下发的附件上传 附件基础信息存储到t_proj_selfcheck_file中\nlet data = Wb.get();\nlet file1 = Wb.get('file1');\n\nlet rs = {};\n\nif (!data.checkBatchId) {\n  rs.O_RETURN_CODE = -1;\n  rs.O_RETURN_MSG = \"没有获取到批次编号\";\n} else {\n  let path = Base.path + '/wb/projSelfcheck/' + data.date;\n  let file = new File(path, file1.name);\n  let parent = file.getParentFile();\n  let userName = Wb.get('sys.username');\n  let id = SysUtil.getId();\n  let fileInfoSql = `insert into thjs.t_proj_selfcheck_file(check_batch_id, id, name, file_size, extension, create_by, create_time, file_path, status)\n  values(?,?,?,?,?,?,?,?,?)`;\n  var conn = DataSource.getConnection(), pstmt;\n  var content = file1.stream;\n\n  if (!parent.exists()) { parent.mkdirs(); }\n\n  let os = new java.io.FileOutputStream(new File(path, file1.name));\n  try {\n    pstmt = conn.prepareStatement(fileInfoSql);\n    pstmt.setString(1, data.checkBatchId);\n    pstmt.setString(2, id);\n    pstmt.setString(3, FileUtil.removeExtension(file1.name));\n    pstmt.setDouble(4, file1.size);\n    pstmt.setString(5, FileUtil.getFileExt(file1.name));\n    pstmt.setString(6, userName);\n    pstmt.setTimestamp(7, new java.sql.Timestamp(new java.util.Date().getTime()));\n    pstmt.setString(8, path + '/' + file1.name);\n    pstmt.setString(9, '0');\n    pstmt.executeUpdate();\n\n    IOUtils.copy(file1.stream, os); // 文件内容存磁盘\n    rs.O_RETURN_CODE = 0;\n    rs.O_RETURN_MSG = \"执行成功\"\n  } catch (e) {\n    rs.O_RETURN_CODE = -1;\n    rs.O_RETURN_MSG = \"上传失败：\" + e;\n    conn.rollback();\n    throw e;\n  } finally {\n    conn.commit();\n    conn.close();\n    os.close();\n  }\n}\n\nWb.send(Wb.encode(rs));\n\n// let data = Wb.get();\n// let file1 = Wb.get('file1')\n// // Wb.send(data);\n// if (!file1.name) return;\n// if (data.type == 2)\n//   Wb.error('这是一个异常测试。');\n\n// // let path = Base.path + '/projlistFile/' + data.date + '/' + data.user + '/' + data.projId;\n// let dateFile = new File(Base.path + '/projlistFile/' + data.date);\n// if (!dateFile.exists()) {\n//   dateFile.mkdirs();\n// }\n\n// let userFile = new File(dateFile + '/' + data.user + '/' + data.projId);\n// if (!userFile.exists()) {\n//   userFile.mkdirs();\n// }\n\n// let file = new File(userFile, file1.name);\n\n// Wb.log('file:' + file);\n// let os = new java.io.FileOutputStream(file);\n// try {\n//   //复制文件流内容至文件输出流，data.file1为上传文件内容的输入流，data.file1__name为文件名称，data.file1__size为文件大小，可以使用Wb.getFiles获取。\n//   IOUtils.copy(file1.stream, os);\n// } catch (e) {\n//   // e.printStackTrace();\n//   Wb.log(e);\n// } finally {\n//   os.close(); //关闭输出流\n// }\n// //前台上传的参数无论是什么类型，传到后台后都是字符串\n// let result = {\n//   name: file1.name,\n//   date: data.date,\n//   type: data.type,\n//   path: 'projlistFile/' + data.date + '/' + data.user + '/' + data.projId + '/' + file1.name\n// };\n// //立即输出至客户端。最后一个参数true表示采用json串封装的方式返回成功信息，此方式仅适用于文件上传模式下的数据返回。\n// Wb.send(result);"},"_icon":"module"}