{
  "title": "",
  "icon": "",
  "img": "",
  "tags": "",
  "hideInMenu": "false",
  "text": "module",
  "cls": "Wb.Module",
  "properties": {
    "cid": "module",
    "serverScript": "CREATE OR REPLACE PROCEDURE \"THJS\".\"P_PROJLIST_MAIN_MQ11\" (rt_cursor     out sys_refcursor, --返回游标结果集\n                                                    i_projid      in varchar2, --项目编号--接口指定编号查询\n                                                    i_khname      in varchar2, --客户名称\n                                                    i_projname    IN varchar2,\n                                                    i_stkcode     in varchar2, --证券代码\n                                                    i_stkname     in varchar2, --股票简称\n                                                    i_projtype    in varchar2, --业务类型\n                                                    i_director    in varchar2, --项目负责人\n                                                    i_deptname    in varchar2, --部门名称\n                                                    i_listtype    in varchar2, --清单类型：0 所有，1 观察清单，2 限制清单，3 静默期\n                                                    i_inouttype   in varchar2, --出入单类型：0 全部 1 入单 2 出单\n                                                    i_datetype    in varchar2, --日期类型：0 全部 1 发生日期 2 填报日期\n                                                    i_begindate   in varchar2, --起始日期\n                                                    i_enddate     in varchar2, --截止日期\n                                                    i_username    in varchar2, --登录人\n                                                    i_flag\t\t  in varchar2, --1-我管理的的清单列表  2-我管理的自查清单列表\n                                                    i_order \t  in char,\n                                                    i_check_result in varchar2, --自查结果\n                                                    o_return_msg  out varchar2,\n                                                    o_return_code out integer)\nAS\n  ----------------------------------------------------------------------------------\n  --版    权：GTJA\n  --版    本：1.0.0\n  --开发人员：CZC@GTJA\n  --创建日期：20191029\n  --模块编号：\n  --模块名称：清单管理 - 我管理的清单信息查询 更新\n  --功能名称：我管理的清单信息查询\n  ----------------------------------------------------------------------------------\n  --==============================================================================\n  --固定变量\n  v_userexp exception; -- 用户定义错\n  v_tradedate    varchar2(8); -- 任务执行时间(业务日期)\n  v_exec_func_id integer default '0'; -- 任务id\n  v_func_own     varchar2(20) default 'thjs'; -- 任务归属用户（schema）\n  v_func_name    varchar2(2000) default 'p_projlist_main_mq20260326'; -- 任务名称(存储过程的名字)\n  v_sqlerrm      varchar2(4000); -- 错误提示信息\n  v_sqlcode      number; -- 错误代码\n  v_sqlerrl      varchar2(4000); -- 错误行号\n  --==============================================================================\n  ---------------------------------------------------------------------------------------\n  --业务变量\n  v_superuser  integer default 0;\n  v_user_pcode varchar2(100);\n  v_pcode      varchar2(100);\n  v_role_flag        varchar2(200); --角色数据权限标识\n  v_po_flag          varchar2(4); --观察清单数据权限标识\n  v_pl_flag          varchar2(4); --限制清单数据权限标识\n  v_pq_flag          varchar2(4); --静默期数据权限标识\n  v_listtype_status  varchar2(4); --清单类型\n  v_inouttype_status varchar2(4); --出入单类型\n  v_projlist_status  varchar2(4); --出入单状态\n  v_date_flag       varchar2(4); --日期条件标识\n  v_begindate       varchar2(8); --起始日期YYYYMMDD\n  v_enddate         varchar2(8); --截止日期YYYYMMDD\n  v_listdate_flag   varchar2(4); --阶段日期类型\n  v_inoutdate_flag  varchar2(4); --出入日期类型\n  v_projstatus_flag varchar2(4); --阶段出入日期类型\n    --业务变量\n  v_page_num  number default 0;\n  v_page_size NUMBER DEFAULT 100;\n  --=============================================================\n  -- 业务处理过程\n  v_order\tvarchar2(500);\n  v_sql\t    varchar2(32767);\n  --=============================================================\n\nBEGIN\n  dbms_output.enable();\n\n  v_tradedate := to_char(sysdate, 'yyyyMMdd');\n  v_begindate := nvl(replace(i_begindate, '-', ''), '19000101');\n--  v_begindate := replace(i_begindate, '-', '');\n  v_enddate   := nvl(replace(i_enddate, '-', ''), '29991231');\n--  v_enddate   := replace(i_enddate, '-', '');\n\n  --判断是否超级用户\n--  select count(1)\n--    into v_superuser\n--    from table(kingstar.splitstr('admin', ',')) t\n--   where instr(',' || t.column_value || ',', ',' || i_username || ',') > 0;\n\n  --获取用户角色\n  --业务人员：本人所填项目\n  --团队/部门负责人：团队/本部门全部项目\n  --投行合规组人员：投行部门全部项目\n  --合规部专门人员：全部部门\n  --暂时展示所有数据，等待数据权限确认\n  --角色部分数据权限实现\n  --“观察清单管理角色”仅具有观察阶段数据权限\n  --“限制清单管理角色”仅具有限制阶段数据权限\n  --“静默期管理角色”仅具有静默阶段数据权限\n  --其余默认视为全部，由菜单本身控制查询权限\n  --权限标识区分：ALL，PO，PL，PQ\n\n  select to_char(wm_concat(decode(r.role_id,\n                                  'projlist_o',\n                                  'PO',\n                                  'projlist_l',\n                                  'PL',\n                                  'projlist_q',\n                                  'PQ',\n                                  'ALL'))) as role_flag\n    into v_role_flag\n    from basic_th.wb_user u\n    left join basic_thjs.wb_user_role ur\n      on ur.user_id = u.user_id\n    left join basic_thjs.wb_role r\n      on r.role_id = ur.role_id\n   where u.user_name = i_username;\n\n  --权限标识 含有上述三种其中一种权限配置的角色，查询时过滤\n  if instr(v_role_flag, 'PO') > 0 or instr(v_role_flag, 'PL') > 0 or\n     instr(v_role_flag, 'PQ') > 0 then\n\n    v_po_flag := case\n                   when instr(v_role_flag, 'PO') > 0 then\n                    '1'\n                   else\n                    '0'\n                 end;\n\n    v_pl_flag := case\n                   when instr(v_role_flag, 'PL') > 0 then\n                    '1'\n                   else\n                    '0'\n                 end;  \n\n    v_pq_flag := case\n                   when instr(v_role_flag, 'PQ') > 0 then\n                    '1'\n                   else\n                    '0'\n                 end;\n  else\n\n    v_po_flag := '2';\n    v_pl_flag := '2';\n    v_pq_flag := '2';\n\n  end if;\n\n  /**\n  清单类型，出入单类型，日期类型，起始截止日期  过滤逻辑\n  如选择了起始截止日期，清单类型、出入单类型、日期类型，优先作用于对应状态的发生或填报日期，如其中一项未选择，默认作用于所有日期\n  如未选择起始截止日期，清单类型、出入单类型直接作用于清单状态，日期类型无效\n  **/\n\n  --根据清单类型及出入单类型，确认查询的清单状态及比较日期\n  --ro,co,rl,cl,rq,cq\n  -- 支持多选：将逗号分隔的清单类型值转换为状态字符（如 '1,2' -> 'ol'）\n\tv_listtype_status := '0';\n    if i_listtype is not null and trim(i_listtype) <> '' and trim(i_listtype) <> '0' then\n      for rec in (select column_value from table(thjs.splitstr(trim(i_listtype), ','))) loop\n        if trim(rec.column_value) in ('1', '2', '3') then\n          -- 去重：避免 '1,1,2' 导致 'ool'\n          if instr(v_listtype_status, \n                    case trim(rec.column_value)\n                      when '1' then 'o' when '2' then 'l' when '3' then 'q'\n                    end) = 0 then\n            v_listtype_status := v_listtype_status || \n              case trim(rec.column_value)\n                when '1' then 'o' when '2' then 'l' when '3' then 'q'\n              end;\n          end if;\n        end if;\n      end loop;\n\tend if;\n\t\n  v_inouttype_status := case\n                          when i_inouttype = '1' then\n                           'r'\n                          when i_inouttype = '2' then\n                           'c'\n                          else\n                           '0'\n                        end;\n  v_projlist_status  := v_inouttype_status || v_listtype_status;\n  v_date_flag := case\n                   when v_begindate is null and v_enddate is null then\n                    '0'\n                   else\n                    '1'\n                 end;\n\n  --项目角色信息\n  execute immediate 'truncate table thjs.tmp_ib_v_finance_projmember_v2';\n\n  insert into thjs.tmp_ib_v_finance_projmember_v2\n    select fp.proj_id,\n           fp.projname,\n           fp.projrole,\n           fp.workno,\n           fp.empname,\n           fp.ground_time,\n           u.staff_id,\n           d.DEPT_NAME\n      from thjs.tb_ib_v_finance_projmember fp\n     inner join basic_th.wb_user u\n        on u.user_id = fp.workno\n     INNER JOIN EHR01.TCL_V_DEPT_INFO_HGFK d\n        ON u.dept_id=d.dept_id\n     where fp.projrole = '项目负责人'\n       and (u.user_name like '%' || i_director || '%' or\n           fp.empname like '%' || i_director || '%');\n  commit;\n  \n  if i_order is null or trim(i_order)='' then\n    v_order := ' order by update_time';\n  else\n    v_order := ' ' || i_order;\n  end if;\n\n  --条件判断复杂，插入临时表，根据不同条件，进行不同过滤返回\n  execute immediate 'truncate table thjs.tmp_projlist_main_mq_v2';\n\n  v_sql := 'insert into thjs.tmp_projlist_main_mq_v2\n  select t.projid,\n  \t\t t.projname,\n  \t\t t.projcode,\n  \t\t t.projtype,\n  \t\t t.dept_name,\n  \t\t t.deptmananame,\n  \t\t t.report_user,\n  \t\t t.custid,\n  \t\t t.custname,\n  \t\t t.stkcode,\n  \t\t t.stkname,\n  \t\t t.gtjarole,\n  \t\t t.projlist_status,\n  \t\t t.ro_inout_date,\n  \t\t t.ro_fill_date,\n  \t\t t.ro_inout_reason,\n  \t\t t.ro_check_result,\n  \t\t t.co_inout_date,\n  \t\t t.co_fill_date,\n  \t\t t.co_inout_reason,\n  \t\t t.co_check_result,\n  \t\t t.rl_inout_date,\n  \t\t t.rl_fill_date,\n  \t\t t.rl_inout_reason,\n  \t\t t.rl_check_result,\n  \t\t t.cl_inout_date,\n  \t\t t.cl_fill_date,\n  \t\t t.cl_inout_reason,\n  \t\t t.cl_check_result,\n  \t\t t.rq_inout_date,\n  \t\t t.rq_fill_date,\n  \t\t t.cq_inout_date,\n  \t\t t.cq_fill_date,\n  \t\t t.staff_id,\n         row_number() over(partition by null '|| v_order ||') as rn,\n         t.check_result,\n         t.check_date\n   from (\n    select p.projid, --项目编号           \n           p.projname, --项目名称\n           p.projcode,\n           p.projtype, --项目类型\n           --p.deptname, --部门名称\n           tt.dept_name,\n           p.deptmananame, --项目负责人\n           p.update_user as report_user, --填报人员\n           p.custid, --客户编号\n           p.custname, --客户名称\n           --p.multi_stkcode   as stkcode, --证券代码\n           P.multi_windcode as stkcode,\n           p.multi_stkname as stkname, --证券名称\n           p.gtjarole, --我司角色\n           decode(p.pro_is_valid,\n                  ''1'',\n                  p.projlist_status,\n                  ''失效项目-'' || p.projlist_status) as projlist_status, --清单状态\n           ro.inout_date as ro_inout_date, --入观察清单日期\n           ro.fill_date as ro_fill_date, --入观察清单填报日期           \n           ro.inout_reason as ro_inout_reason, --入观察清单事由\n           ro.check_result as ro_check_result, --入观察清单检查结果\n           co.inout_date as co_inout_date, --出观察清单日期\n           co.fill_date as co_fill_date, --出观察清单填报日期\n           co.inout_reason as co_inout_reason, --出观察清单事由\n           co.check_result as co_check_result, --出观察清单检查结果           \n           rl.inout_date as rl_inout_date, --入限制清单日期\n           rl.fill_date as rl_fill_date, --入限制清单填报日期\n           rl.inout_reason as rl_inout_reason, --入限制清单事由\n           rl.check_result as rl_check_result, --入限制清单检查结果           \n           cl.inout_date as cl_inout_date, --出限制清单日期\n           cl.fill_date as cl_fill_date, --出限制清单填报日期\n           cl.inout_reason as cl_inout_reason, --出限制清单事由\n           cl.check_result as cl_check_result, --出限制清单检查结果 \n           rq.inout_date as rq_inout_date, --静默期起始日期\n           rq.fill_date as rq_fill_date, --静默期起始日期\n           cq.inout_date as cq_inout_date, --静默期截止日期\n           cq.fill_date as cq_fill_date, --静默期截止日期\n           tt.staff_id AS staff_id,\n           p.update_time,\n           tt.dept_name as staff_dept_name,\n\t\t    case when rs.projid is null then ''2'' else\n               decode(rs.check_result_sum,0,''0'',''1'') end as check_result,\n\t\t   rr.check_date\n      from thjs.vw_projlist_main_all p\n      left join thjs.vw_projlist_inout ro\n        on ro.inout_id = p.robserve_id\n       and '||v_po_flag||' <> ''0'' --有观察清单权限\n      left join thjs.vw_projlist_inout co\n        on co.inout_id = p.cobserve_id\n       and '||v_po_flag||' <> ''0''\n      left join thjs.vw_projlist_inout rl\n        on rl.inout_id = p.rlimit_id\n       and '||v_pl_flag||' <> ''0'' --有限制清单权限\n      left join thjs.vw_projlist_inout cl\n        on cl.inout_id = p.climit_id\n       and '||v_pl_flag||' <> ''0''\n      left join thjs.vw_projlist_inout rq\n        on rq.inout_id = p.rquiet_id\n       and '||v_pq_flag||' <> ''0'' --有静默期权限\n      left join thjs.vw_projlist_inout cq\n        on cq.inout_id = p.cquiet_id\n       and '||v_pq_flag||' <> ''0''\n\t  left join (select r.projid,r.check_id, r.check_result,to_char(r.update_time,''yyyymmdd'') as check_date,\n\t\t\t\t\t    row_number() over(partition by r.projid order by r.update_time desc) as rn\n\t\t\t\t   from thjs.tb_projlist_check_result r) rr\n\t    on p.projid = rr.projid\n\t   and rr.rn = 1\n\t   left join (select b.projid,b.check_id,sum(decode(b.check_result,''0'',0,1)) as check_result_sum\n       from  thjs.TB_PROJLIST_CHECK_RESULT b\n        group by b.projid,b.check_id)rs\n       on p.projid=rs.projid\n       and rr.check_id=rs.check_id   \n     INNER JOIN (SELECT proj_id,LISTAGG(t.staff_id,'','') within group(order by t.staff_id) AS staff_id,LISTAGG(t.dept_name,'','') within group(order by t.staff_id) AS dept_name from thjs.tmp_ib_v_finance_projmember_V2 t GROUP BY t.PROJ_ID) tt ON p.projid=tt.proj_id\n     where ('''||i_projid||''' is null or p.projcode = '''||i_projid||''')\n       and ('''||i_khname||''' is null or instr(p.custname, '''||i_khname||''') > 0)\n       and ('''||i_projname||''' is null or instr(p.projname, '''||i_projname||''') > 0)\n       and ('''||i_stkcode||''' is null or instr(p.multi_stkcode, '''||i_stkcode||''') > 0)\n       and ('''||i_stkname||''' is null or instr(p.multi_stkname, '''||i_stkname||''') > 0)\n       and ('''||i_projtype||''' is null or instr('',''||'''||i_projtype||'''||'','', '',''||p.projtype ||'','')>0) \n       and ('''||i_deptname||''' is null or instr(p.deptname, '''||i_deptname||''') > 0)\n       and ('''||i_check_result||''' is null or case when rs.projid is null then ''2'' else\n               decode(rs.check_result_sum,0,''0'',''1'') end = '''||i_check_result||''')\n       and (('||v_po_flag||' = ''2'' or\n           ('||v_po_flag||' = ''1'' and p.robserve_id is not null)) or\n           ('||v_pl_flag||' = ''2'' or\n           ('||v_pl_flag||' = ''1'' and p.rlimit_id is not null)) or\n           ('||v_pq_flag||' = ''2'' or\n           ('||v_pq_flag||' = ''1'' and p.rquiet_id is not null)))\n       and (('''||i_flag||''' = ''2'' and p.projlist_status in (''ro'',''rl'') or '''||i_flag||''' = ''1'')) --我的自查清单列表自动查询项目状态为 入观察清单、入限制清单的项目\n     order by p.source_flag, p.update_time desc) t';\n  execute immediate v_sql;\n  commit;\n\n  if v_date_flag = '0' then\n    --无日期条件，日期类型条件无效\n    --清单类型、出入单类型作用于清单状态\n    open rt_cursor for\n       select t.*,t.DEPTNAME AS STAFF_DEPT_NAME from thjs.tmp_projlist_main_mq_v2 t \n       where (v_listtype_status = '0' or\n             instr(t.projlist_status, v_listtype_status) > 0) --无清单类型条件，或作用于状态过滤\n         and (v_inouttype_status = '0' or\n             instr(t.projlist_status, v_inouttype_status) > 0); --无出入单类型条件，或作用于状态过滤\n\n  else\n    --有日期条件，日期类型决定使用发生日期还是填报日期\n    --清单类型、出入单类型作用于具体日期\n\n    if v_listtype_status = '0' and v_inouttype_status = '0' then\n      --无清单类型、出入单类型作用于多日期\n      --根据日期类型决定，作用于那些日期\n      if i_datetype is null or i_datetype = '0' then\n        open rt_cursor for\n         select t.*,t.DEPTNAME AS STAFF_DEPT_NAME from thjs.tmp_projlist_main_mq_v2 t \n           where replace(t.ro_inout_date, '-', '') between v_begindate and\n                 v_enddate\n              or replace(t.ro_fill_date, '-', '') between v_begindate and\n                 v_enddate\n              or replace(t.co_inout_date, '-', '') between v_begindate and\n                 v_enddate\n              or replace(t.co_fill_date, '-', '') between v_begindate and\n                 v_enddate\n              or replace(t.rl_inout_date, '-', '') between v_begindate and\n                 v_enddate\n              or replace(t.rl_fill_date, '-', '') between v_begindate and\n                 v_enddate\n              or replace(t.cl_inout_date, '-', '') between v_begindate and\n                 v_enddate\n              or replace(t.cl_fill_date, '-', '') between v_begindate and\n                 v_enddate\n              or replace(t.rq_inout_date, '-', '') between v_begindate and\n                 v_enddate\n              or replace(t.rq_fill_date, '-', '') between v_begindate and\n                 v_enddate\n              or replace(t.cq_inout_date, '-', '') between v_begindate and\n                 v_enddate\n              or replace(t.cq_fill_date, '-', '') between v_begindate and\n                 v_enddate\n           order by t.rn;\n\n      else\n        open rt_cursor for\n          select t.*,t.DEPTNAME AS STAFF_DEPT_NAME from thjs.tmp_projlist_main_mq_v2 t \n           where replace(decode(i_datetype,\n                                '1',\n                                t.ro_inout_date,\n                                t.ro_fill_date),\n                         '-',\n                         '') between v_begindate and v_enddate\n              or replace(decode(i_datetype,\n                                '1',\n                                t.co_inout_date,\n                                t.co_fill_date),\n                         '-',\n                         '') between v_begindate and v_enddate\n              or replace(decode(i_datetype,\n                                '1',\n                                t.rl_inout_date,\n                                t.rl_fill_date),\n                         '-',\n                         '') between v_begindate and v_enddate\n              or replace(decode(i_datetype,\n                                '1',\n                                t.cl_inout_date,\n                                t.cl_fill_date),\n                         '-',\n                         '') between v_begindate and v_enddate\n              or replace(decode(i_datetype,\n                                '1',\n                                t.rq_inout_date,\n                                t.rq_fill_date),\n                         '-',\n                         '') between v_begindate and v_enddate\n              or replace(decode(i_datetype,\n                                '1',\n                                t.cq_inout_date,\n                                t.cq_fill_date),\n                         '-',\n                         '') between v_begindate and v_enddate\n           order by t.rn;\n      end if;\n    elsif v_listtype_status <> '0' and v_inouttype_status = '0' then\n      --有清单类型、无出入单类型作用于对应清单日期\n\n      --根据日期类型决定，作用于那些日期\n      if i_datetype is null or i_datetype = '0' then\n        open rt_cursor for\n          select t.*,t.DEPTNAME AS STAFF_DEPT_NAME from thjs.tmp_projlist_main_mq_v2 t \n           where (instr(v_listtype_status,'o')>0 and replace(t.ro_inout_date,'-','') between v_begindate and v_enddate)\n   or (instr(v_listtype_status,'l')>0 and replace(t.rl_inout_date,'-','') between v_begindate and v_enddate)\n   or (instr(v_listtype_status,'q')>0 and replace(t.rq_inout_date,'-','') between v_begindate and v_enddate)\n   or (instr(v_listtype_status,'o')>0 and replace(t.ro_fill_date,'-','') between v_begindate and v_enddate)\n   or (instr(v_listtype_status,'l')>0 and replace(t.rl_fill_date,'-','') between v_begindate and v_enddate)\n   or (instr(v_listtype_status,'q')>0 and replace(t.rq_fill_date,'-','') between v_begindate and v_enddate)\n   or (instr(v_listtype_status,'o')>0 and replace(t.co_inout_date,'-','') between v_begindate and v_enddate)\n   or (instr(v_listtype_status,'l')>0 and replace(t.cl_inout_date,'-','') between v_begindate and v_enddate)\n   or (instr(v_listtype_status,'q')>0 and replace(t.cq_inout_date,'-','') between v_begindate and v_enddate)\n   or (instr(v_listtype_status,'o')>0 and replace(t.co_fill_date,'-','') between v_begindate and v_enddate)\n   or (instr(v_listtype_status,'l')>0 and replace(t.cl_fill_date,'-','') between v_begindate and v_enddate)\n   or (instr(v_listtype_status,'q')>0 and replace(t.cq_fill_date,'-','') between v_begindate and v_enddate)\n           order by t.rn;\n      \n      else\n      \n        v_listdate_flag := v_listtype_status || case\n                             when i_datetype = '1' then\n                              'i'\n                             else\n                              'f'\n                           end;\n        open rt_cursor for\n          select t.*,t.DEPTNAME AS STAFF_DEPT_NAME from thjs.tmp_projlist_main_mq_v2 t \n           where (instr(v_listtype_status,'o')>0 and replace(decode(i_datetype,'1',t.ro_inout_date,t.ro_fill_date),'-','') between v_begindate and v_enddate)\nor (instr(v_listtype_status,'l')>0 and replace(decode(i_datetype,'1',t.rl_inout_date,t.rl_fill_date),'-','') between v_begindate and v_enddate)\nor (instr(v_listtype_status,'q')>0 and replace(decode(i_datetype,'1',t.rq_inout_date,t.rq_fill_date),'-','') between v_begindate and v_enddate)\nor (instr(v_listtype_status,'o')>0 and replace(decode(i_datetype,'1',t.co_inout_date,t.co_fill_date),'-','') between v_begindate and v_enddate)\nor (instr(v_listtype_status,'l')>0 and replace(decode(i_datetype,'1',t.cl_inout_date,t.cl_fill_date),'-','') between v_begindate and v_enddate)\nor (instr(v_listtype_status,'q')>0 and replace(decode(i_datetype,'1',t.cq_inout_date,t.cq_fill_date),'-','') between v_begindate and v_enddate)\n           order by t.rn;\n      \n      end if;\n    elsif v_listtype_status = '0' and v_inouttype_status <> '0' then\n      --无清单类型、有出入单类型作用于对应清单日期\n    \n      --根据日期类型决定，作用于那些日期\n      if i_datetype is null or i_datetype = '0' then\n        open rt_cursor for\n           select t.*,t.DEPTNAME AS STAFF_DEPT_NAME from thjs.tmp_projlist_main_mq_v2 t \n           where replace(decode(v_inouttype_status,\n                                'r',\n                                t.ro_inout_date,\n                                'c',\n                                t.co_inout_date),\n                         '-',\n                         '') between v_begindate and v_enddate\n              or replace(decode(v_inouttype_status,\n                                'r',\n                                t.ro_fill_date,\n                                'c',\n                                t.co_fill_date),\n                         '-',\n                         '') between v_begindate and v_enddate\n              or replace(decode(v_inouttype_status,\n                                'r',\n                                t.rl_inout_date,\n                                'c',\n                                t.cl_inout_date),\n                         '-',\n                         '') between v_begindate and v_enddate\n              or replace(decode(v_inouttype_status,\n                                'r',\n                                t.rl_fill_date,\n                                'c',\n                                t.cl_fill_date),\n                         '-',\n                         '') between v_begindate and v_enddate\n              or replace(decode(v_inouttype_status,\n                                'r',\n                                t.rq_inout_date,\n                                'c',\n                                t.cq_inout_date),\n                         '-',\n                         '') between v_begindate and v_enddate\n              or replace(decode(v_inouttype_status,\n                                'r',\n                                t.rq_fill_date,\n                                'c',\n                                t.cq_fill_date),\n                         '-',\n                         '') between v_begindate and v_enddate\n           order by t.rn;\n      \n      else\n      \n        v_inoutdate_flag := v_inouttype_status || case\n                              when i_datetype = '1' then\n                               'i'\n                              else\n                               'f'\n                            end;\n      \n        open rt_cursor for\n          select t.*,t.DEPTNAME AS STAFF_DEPT_NAME from thjs.tmp_projlist_main_mq_v2 t \n           where replace(decode(v_inoutdate_flag,\n                                'ri',\n                                t.ro_inout_date,\n                                'rf',\n                                t.ro_fill_date,\n                                'ci',\n                                t.co_inout_date,\n                                'cf',\n                                t.co_fill_date),\n                         '-',\n                         '') between v_begindate and v_enddate\n              or replace(decode(v_inoutdate_flag,\n                                'ri',\n                                t.rl_inout_date,\n                                'rf',\n                                t.rl_fill_date,\n                                'ci',\n                                t.cl_inout_date,\n                                'cf',\n                                t.cl_fill_date),\n                         '-',\n                         '') between v_begindate and v_enddate\n              or replace(decode(v_inoutdate_flag,\n                                'ri',\n                                t.rq_inout_date,\n                                'rf',\n                                t.rq_fill_date,\n                                'ci',\n                                t.cq_inout_date,\n                                'cf',\n                                t.cq_fill_date),\n                         '-',\n                         '') between v_begindate and v_enddate\n           order by t.rn;\n      \n      end if;\n    else\n      --有清单类型、有出入单类型作用于对应清单日期\n    \n      --根据日期类型决定，作用于那些日期\n      if i_datetype is null or i_datetype = '0' then\n        open rt_cursor for\n          select t.*,t.DEPTNAME AS STAFF_DEPT_NAME from thjs.tmp_projlist_main_mq_v2 t \n           where (instr(v_projlist_status,'ro')>0 and replace(t.ro_inout_date,'-','') between v_begindate and v_enddate)\nor (instr(v_projlist_status,'co')>0 and replace(t.co_inout_date,'-','') between v_begindate and v_enddate)\nor (instr(v_projlist_status,'rl')>0 and replace(t.rl_inout_date,'-','') between v_begindate and v_enddate)\nor (instr(v_projlist_status,'cl')>0 and replace(t.cl_inout_date,'-','') between v_begindate and v_enddate)\nor (instr(v_projlist_status,'rq')>0 and replace(t.rq_inout_date,'-','') between v_begindate and v_enddate)\nor (instr(v_projlist_status,'cq')>0 and replace(t.cq_inout_date,'-','') between v_begindate and v_enddate)\nor (instr(v_projlist_status,'ro')>0 and replace(t.ro_fill_date,'-','') between v_begindate and v_enddate)\nor (instr(v_projlist_status,'co')>0 and replace(t.co_fill_date,'-','') between v_begindate and v_enddate)\nor (instr(v_projlist_status,'rl')>0 and replace(t.rl_fill_date,'-','') between v_begindate and v_enddate)\nor (instr(v_projlist_status,'cl')>0 and replace(t.cl_fill_date,'-','') between v_begindate and v_enddate)\nor (instr(v_projlist_status,'rq')>0 and replace(t.rq_fill_date,'-','') between v_begindate and v_enddate)\nor (instr(v_projlist_status,'cq')>0 and replace(t.cq_fill_date,'-','') between v_begindate and v_enddate)\n           order by t.rn;\n      \n      else\n      \n        v_projstatus_flag := v_projlist_status || case\n                               when i_datetype = '1' then\n                                'i'\n                               else\n                                'f'\n                             end;\n      \n        open rt_cursor for\n          select t.*,t.DEPTNAME AS STAFF_DEPT_NAME from thjs.tmp_projlist_main_mq_v2 t \n           where (instr(v_listtype_status,'o')>0 and replace(decode(v_inouttype_status,'r',t.ro_inout_date,t.co_inout_date),'-','') between v_begindate and v_enddate)\nor (instr(v_listtype_status,'o')>0 and replace(decode(v_inouttype_status,'r',t.ro_fill_date,t.co_fill_date),'-','') between v_begindate and v_enddate)\nor (instr(v_listtype_status,'l')>0 and replace(decode(v_inouttype_status,'r',t.rl_inout_date,t.cl_inout_date),'-','') between v_begindate and v_enddate)\nor (instr(v_listtype_status,'l')>0 and replace(decode(v_inouttype_status,'r',t.rl_fill_date,t.cl_fill_date),'-','') between v_begindate and v_enddate)\nor (instr(v_listtype_status,'q')>0 and replace(decode(v_inouttype_status,'r',t.rq_inout_date,t.cq_inout_date),'-','') between v_begindate and v_enddate)\nor (instr(v_listtype_status,'q')>0 and replace(decode(v_inouttype_status,'r',t.rq_fill_date,t.cq_fill_date),'-','') between v_begindate and v_enddate)\n           order by t.rn;\n      \n      end if;\n    end if;\n  \n  end if;\n\n  commit;\n\n  o_return_msg  := '执行成功';\n  o_return_code := 0;\n\nexception\n  -- 非预定义异常处理\n  when v_userexp then\n    rollback;\n  \n    v_sqlerrm := sqlerrm;\n    v_sqlcode := sqlcode;\n    v_sqlerrl := dbms_utility.format_error_backtrace();\n  \n    thjs.p_write_error_log(i_tradedate    => v_tradedate,\n                            i_exec_func_id => v_exec_func_id,\n                            i_func_own     => v_func_own,\n                            i_func_name    => v_func_name,\n                            i_occur_time   => sysdate,\n                            i_sqlerrm      => v_sqlerrm,\n                            i_sqlcode      => v_sqlcode,\n                            i_sqlerrl      => v_sqlerrl);\n    commit;\n    raise;\n    -- 预定义异常处理\n  when others then\n    rollback;\n  \n    v_sqlerrm := sqlerrm;\n    v_sqlcode := sqlcode;\n    v_sqlerrl := dbms_utility.format_error_backtrace();\n  \n    thjs.p_write_error_log(i_tradedate    => v_tradedate,\n                            i_exec_func_id => v_exec_func_id,\n                            i_func_own     => v_func_own,\n                            i_func_name    => v_func_name,\n                            i_occur_time   => sysdate,\n                            i_sqlerrm      => v_sqlerrm,\n                            i_sqlcode      => v_sqlcode,\n                            i_sqlerrl      => v_sqlerrl);\n    commit;\n    raise;\nend;"
  },
  "_icon": "module",
  "events": {
    "initialize": "CREATE OR REPLACE FUNCTION \"THJS\".\"SPLITSTR\"(\"P_STRING\" IN VARCHAR2(32767),\"P_DELIMITER\" IN VARCHAR2(32767))\nRETURN STR_SPLIT\nAUTHID DEFINER\nPIPELINED\n\nAS\n    v_length   NUMBER := LENGTH(p_string);\n    v_start    NUMBER := 1;\n    v_index    NUMBER;\nBEGIN\n    WHILE(v_start <= v_length)\n    LOOP\n        v_index := INSTR(p_string, p_delimiter, v_start);\n\n        IF v_index = 0\n        THEN\n            PIPE ROW(SUBSTR(p_string, v_start));\n            v_start := v_length + 1;\n        ELSE\n            PIPE ROW(SUBSTR(p_string, v_start, v_index - v_start));\n            v_start := v_index + 1;\n        END IF;\n    END LOOP;\n\n    RETURN;\nEND splitstr;\n\n-- 1. 检查 STR_SPLIT 类型定义\nSELECT * FROM all_types WHERE type_name = 'STR_SPLIT';\n\n-- 2. 直接测试拆分函数\nSELECT column_value, LENGTH(column_value) AS len\nFROM table(kingstar.splitstr('2,3', ','));\n\n-- 3. 如果上一步报 COLUMN_VALUE 无效，尝试用 * 查看\nSELECT * FROM table(kingstar.splitstr('2,3', ','));\n\n\n-- 如果确认是 STR_SPLIT 类型未创建，执行：在 KINGSTAR  schema 下执行\nCREATE OR REPLACE TYPE STR_SPLIT AS TABLE OF VARCHAR2(4000);\n\n-- 如果类型已存在但定义不对（比如定义成了对象类型），需要重建：\nDROP TYPE STR_SPLIT;\nCREATE OR REPLACE TYPE STR_SPLIT AS TABLE OF VARCHAR2(4000);"
  }
}