{"title":"","icon":"","img":"","tags":"","hideInMenu":"true","text":"module","cls":"Wb.Module","properties":{"cid":"module","links":"[\"wb/custom-made/vue/vue.js\",\"wb/custom-made/vue/element.js\",\"wb/custom-made/vue/element.css\",\"wb/custom-made/css/myCss.css\"]","cls":"w-input-wrap"},"_icon":"module","_expanded":true,"events":{"initialize":"Wb.apply(app, {\n  /*\n  * 打开修改弹窗\n  */\n  updateBeneficialView: function () {\n    var rec = app.grid1.selection;\n    if (!rec) {\n      Wb.warn('请选择 1 条需要修改的记录。');\n      return;\n    }\n    var record = rec.data;\n    console.log(\"record\", record);\n    app.BUSI_TYPE1_BAK = record.busi_type1;\n    app.BUSI_TYPE2_BAK = record.busi_type2;\n    //打开弹窗\n    app.updateBeneficialWin.show();\n    app.isNew = true;\n    app.updateBeneficialWin.title = \"修改\";\n    //给对应的输入框添值\n    app.E_BUSI_TYPE1.setValue(record.busi_type1);\n    app.E_BUSI_TYPE2.setValue(record.busi_type2);\n    app.E_IS_ALLOW_REPORT.setValue(record.is_allow_report);\n    app.E_IS_LIMIT_FXQ.setValue(record.is_limit_fxq);\n  },\n  /*\n  * 修改信息  并保存\n  */\n  updateBeneficialSave: function () {\n    //if(Wb.verify(app.updateBeneficialWin)){//该判断用于用于在非空项是否填写，如果未填写为false\n    var BUSI_TYPE1 = app.E_BUSI_TYPE1.value;\n    var BUSI_TYPE2 = app.E_BUSI_TYPE2.value;\n    Wb.ajax({\n      url: xpath + '/perm_conf/update_busitype',\n      params: {\n        BUSI_TYPE1: app.E_BUSI_TYPE1.value,\n        BUSI_TYPE2: app.E_BUSI_TYPE2.value,\n        IS_ALLOW_REPORT: app.E_IS_ALLOW_REPORT.value == \"是\" ? 1 : 0,\n        IS_LIMIT_FXQ: app.E_IS_LIMIT_FXQ.value == \"是\" ? 1 : 0\n      },\n      success(resp) {\n        Wb.tip('修改成功！');\n        app.updateBeneficialWin.close();\n        // app.searchlist();\n        app.seekBtn.fireClick();\n      }\n    });\n  }\n});"},"items":[{"_icon":"viewport","text":"viewport1","cls":"Wb.Viewport","properties":{"cid":"viewport1"},"_expanded":true,"events":{"keydown":"if (e.keyCode == '13') {\n  app.seekBtn.fireClick()\n}"},"items":[{"_icon":"panel","text":"panel1","cls":"Wb.Panel","properties":{"cid":"panel1","border":"false","layout":"form","minWidth":"200","gap":"8"},"_expanded":true,"hasDupCid":0,"items":[{"_icon":"text","text":"DEPTNAME","cls":"Wb.Text","properties":{"cid":"DEPTNAME","text":"投行一级部门","clearButton":"true"}},{"_icon":"text","text":"SUB_DEPTNAME","cls":"Wb.Text","properties":{"cid":"SUB_DEPTNAME","text":"投行二级部门","clearButton":"true"}},{"_icon":"text","text":"MANAGER","cls":"Wb.Text","properties":{"cid":"MANAGER","text":"对应合规管理人员","clearButton":"true"}},{"_icon":"text","text":"OP_FLAG","cls":"Wb.Text","properties":{"cid":"OP_FLAG","visible":"false","text":"当前操作"}}]},{"_icon":"grid","text":"grid1","cls":"Wb.Grid","properties":{"cid":"grid1","pagingBar":"pageNums","pageSize":"100","full":"true","border":"false","emptyHint":"true","textSelectable":"true","url":"@xpath + '/perm_conf/select'","columnsSortable":"true"},"_expanded":true,"hasDupCid":0,"items":[{"_icon":"toolbar","text":"tbar","cls":"Wb.Toolbar","properties":{"cid":"tbar","gap":"true","layout":"form-compact","isProperty":"true","border":"false"},"_expanded":true,"hasDupCid":0,"items":[{"_icon":"button","text":"addBtn","cls":"Wb.Button","properties":{"cid":"addBtn","text":"新增","type":"primary","roundBorder":"true"},"events":{"click":"app.OP_FLAG.setValue('add');\napp.addWin.show();"}},{"_icon":"button","text":"delBtn","cls":"Wb.Button","properties":{"cid":"delBtn","text":"删除","roundBorder":"true"},"events":{"click":"if (app.grid1.selectionsData.length != 1) {\n  Wb.info(\"请选中 1 条数据\");\n  return;\n}\nlet rec = app.grid1.selectionData;\nconsole.log(\"rec----\", rec)\n\nWb.confirm(\"是否确认要删除该条数据？\", () => {\n  Wb.ajax({\n    url: xpath + '/operation/delete',\n    params: {\n      I_PK_ID: rec.pk_id\n    },\n    success(resp) {\n      Wb.tipSucc(\"删除成功\");\n      app.grid1.reload()\n    }\n  });\n})\n"}},{"_icon":"button","text":"editBtn","cls":"Wb.Button","properties":{"cid":"editBtn","text":"编辑","type":"primary","roundBorder":"true"},"events":{"click":"if (app.grid1.selectionsData.length != 1) {\n  Wb.info(\"请选中 1 条数据\");\n  return;\n}\nlet rec = app.grid1.selectionData;\nconsole.log(\"rec----\", rec)\napp.E_MANAGER.setValue(rec.manager);\napp.E_DEPTNAME.setValue(rec.deptname);\napp.E_PK_ID.setValue(rec.pk_id);\napp.OP_FLAG.setValue('edit');\n\napp.editWin.show();"}},{"_icon":"right1","text":"fill1","cls":"Wb.Fill","properties":{"cid":"fill1"}},{"_icon":"button","text":"seekBtn","cls":"Wb.Button","properties":{"cid":"seekBtn","text":"查询","type":"primary","roundBorder":"true"},"events":{"click":"let data = Wb.getValue(app.panel1)\nif(Wb.verify(app.panel1)){\n  app.grid1.load({\n    comps:app.panel1,\n    params:{},\n  })\n}\n"},"hasDupCid":0},{"_icon":"button","text":"resetBtn","cls":"Wb.Button","properties":{"cid":"resetBtn","text":"重置","roundBorder":"true"},"events":{"click":"Wb.reset(app.panel1)\napp.grid1.load()"},"hasDupCid":0}]},{"_icon":"array","text":"columns","cls":"Wb.Array","properties":{"cid":"columns"},"_expanded":true,"hasDupCid":1,"items":[{"_icon":"column","text":"rownum1_Col","cls":"Wb.Column","properties":{"cid":"rownum1_Col","rowNum":"true","width":"80"},"hasDupCid":0},{"_icon":"column","text":"DEPTNAME_col","cls":"Wb.Column","properties":{"cid":"DEPTNAME_col","text":"投行一级部门","fieldName":"deptname"}},{"_icon":"column","text":"SUB_DEPTNAME_col","cls":"Wb.Column","properties":{"cid":"SUB_DEPTNAME_col","text":"投行二级部门","fieldName":"sub_deptname","width":"300"}},{"_icon":"column","text":"MANAGER_col","cls":"Wb.Column","properties":{"cid":"MANAGER_col","text":"对应合规管理人员","fieldName":"manager","width":"300"},"hasDupCid":0},{"_icon":"column","text":"MANAGER_WORK_NO_col","cls":"Wb.Column","properties":{"cid":"MANAGER_WORK_NO_col","text":"对应合规管理人员工号","fieldName":"manager_work_no","width":"200"},"hasDupCid":0},{"_icon":"column","text":"PK_ID_col","cls":"Wb.Column","properties":{"cid":"PK_ID_col","text":"PK_ID","fieldName":"pk_id","width":"200","visible":"false"},"hasDupCid":0}]}]}]},{"_icon":"window","text":"addWin","cls":"Wb.Window","_expanded":true,"properties":{"cid":"addWin","layout":"form","labelAlign":"left","width":"500px","dialog":"true"},"events":{"ok":"if (!app.A_MANAGER.value) {\n  Wb.tipError(\"合规管理人员不能为空！\");\n  return;\n}\nif (!app.A_DEPTNAME.value) {\n  Wb.tipError(\"部门不能为空！\");\n  return;\n}\n\nWb.ajax({\n  url: xpath + '/operation/add',\n  params: {\n    I_STAFF_ID: app.A_MANAGER.value,\n    I_DEPT_CODE: app.A_DEPTNAME.value.split('/')[1],\n    I_SUB_DEPT_CODE: app.A_DEPTNAME.value.split('/')[2],\n    I_CREATE_USER: '_$sys.username$_',\n    I_UPDATE_USER: '_$sys.username$_'\n  },\n  success(resp) {\n    app.addWin.hide();\n    Wb.tipSucc(\"新增成功\");\n    app.grid1.reload();\n    app.OP_FLAG.setValue('');\n  }\n});\n\n"},"items":[{"_icon":"combo","text":"A_DEPTNAME","cls":"Wb.Select","properties":{"cid":"A_DEPTNAME","text":"部门","url":"@xpath + '/operation/select_dept'","treePicker":"true","textField":"text","valueField":"path"},"hasDupCid":0},{"_icon":"combo","text":"A_MANAGER","cls":"Wb.Select","properties":{"cid":"A_MANAGER","text":"合规管理人员","textField":"display_name","valueField":"staff_id"},"hasDupCid":0,"events":{"click":"app.userSelectWin.show();"}}]},{"_icon":"window","text":"editWin","cls":"Wb.Window","_expanded":true,"properties":{"cid":"editWin","dialog":"true","labelAlign":"left","layout":"form","width":"500px"},"events":{"ok":"if (!app.E_MANAGER.value) {\n  Wb.tipError(\"合规管理人员不能为空！\");\n  return;\n}\nif (!app.E_DEPTNAME.value) {\n  Wb.tipError(\"部门不能为空！\");\n  return;\n}\n\nWb.ajax({\n  url: xpath + '/operation/edit',\n  params: {\n    I_STAFF_ID: app.E_MANAGER.value,\n    I_UPDATE_USER: '_$sys.username$_',\n    I_PK_ID: app.E_PK_ID.value\n  },\n  success(resp) {\n    app.editWin.hide();\n    Wb.tipSucc(\"修改成功\");\n    app.grid1.reload();\n    app.OP_FLAG.setValue('');\n  }\n});"},"items":[{"_icon":"combo","text":"E_DEPTNAME","cls":"Wb.Select","properties":{"cid":"E_DEPTNAME","text":"部门","url":"@xpath + '/operation/select_dept'","treePicker":"true","textField":"text","valueField":"path","disabled":"true"},"hasDupCid":0},{"_icon":"combo","text":"E_MANAGER","cls":"Wb.Select","properties":{"cid":"E_MANAGER","text":"合规管理人员","valueField":"staff_id","textField":"display_name"},"hasDupCid":0,"events":{"click":"app.userSelectWin.show();"}},{"_icon":"combo","text":"E_PK_ID","cls":"Wb.Select","properties":{"cid":"E_PK_ID","text":"PK_ID","valueField":"pk_id","textField":"pk_id","visible":"false"},"hasDupCid":0}]},{"_icon":"window","text":"userSelectWin","cls":"Wb.Window","_expanded":true,"properties":{"cid":"userSelectWin","title":"查询合规管理人员","width":"600","height":"600"},"items":[{"_icon":"text","text":"query","cls":"Wb.Text","properties":{"cid":"query","placeholder":"用户ID或用户名"},"events":{"change":"app.grid2.load({params:{query:value}})"},"_expanded":false},{"_icon":"grid","text":"grid2","cls":"Wb.Grid","properties":{"cid":"grid2","url":"@xpath + '/operation/select_manager'","full":"true"},"events":{"itemdblclick":"app.userSelectWin.close();\n\nif (app.OP_FLAG.value == 'add') {\n  app.A_MANAGER.setValue(item.data.staff_id)\n} else if (app.OP_FLAG.value == 'edit') {\n  app.E_MANAGER.setValue(item.data.staff_id)\n}"},"hasDupCid":0,"_expanded":true,"items":[{"_icon":"array","text":"columns","cls":"Wb.Array","properties":{"cid":"columns"},"hasDupCid":1,"_expanded":true,"items":[{"_icon":"column","text":"rownum_Col","cls":"Wb.Column","properties":{"cid":"rownum_Col","rowNum":"true"},"hasDupCid":0},{"_icon":"column","text":"STAFF_ID_Col","cls":"Wb.Column","properties":{"cid":"STAFF_ID_Col","text":"工号","fieldName":"staff_id"},"hasDupCid":0},{"_icon":"column","text":"USER_NAME_Col","cls":"Wb.Column","properties":{"cid":"USER_NAME_Col","text":"用户名","fieldName":"user_name"}},{"_icon":"column","text":"DISPLAY_NAME_Col","cls":"Wb.Column","properties":{"cid":"DISPLAY_NAME_Col","text":"姓名","fieldName":"display_name"}}]}]}]}]}